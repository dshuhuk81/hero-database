{
  "buildCommand": "astro build",
  "devCommand": "astro dev",
  "installCommand": "npm install",
  "framework": "astro",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/heros",
      "destination": "/heroes/",
      "permanent": true
    },
    {
      "source": "/heros/",
      "destination": "/heroes/",
      "permanent": true
    },
    {
      "source": "/heroes/cashien",
      "destination": "/heroes/caishen/",
      "permanent": true
    },
    {
      "source": "/heroes/cashien/",
      "destination": "/heroes/caishen/",
      "permanent": true
    }
  ]
}
