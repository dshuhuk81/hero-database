{
  "name": "hero-database",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:api": "node api-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "node scripts/build-with-supported-node.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "tag-manager": "node scripts/tag-manager-server.js",
    "mergeHeroes": "node scripts/merge-heroes-db.js",
    "import-attack-rates": "node scripts/import-attack-rates.cjs",
    "import-investment": "node scripts/import-investment.cjs",
    "import-ratings": "node scripts/import-ratings.cjs",
    "db:merge": "node scripts/merge-heroes-db.js",
    "validate:tags": "node scripts/test-hero-tags.js",
    "validate:tag-rules": "node --test scripts/test-tag-rules.mjs",
    "validate:virtue-rules": "node --test scripts/test-virtue-rules.mjs",
    "validate:comp-rules": "node --test scripts/test-comp-rules.mjs",
    "validate:ratings": "node scripts/validate-ratings.mjs",
    "ratings:report": "node scripts/rating-report.mjs",
    "test:ratings": "node --test tests/rating-system.test.mjs",
    "suggest:tags": "node scripts/suggest-synergy-tags.mjs",
    "suggest:virtues": "node scripts/suggest-virtues.mjs",
    "suggest:comps": "node scripts/suggest-comps.mjs",
    "validate:all": "node scripts/validate-bosses.js && node scripts/test-hero-tags.js && node --test scripts/test-tag-rules.mjs && node --test scripts/test-virtue-rules.mjs && node --test scripts/test-comp-rules.mjs",
    "after:hero-edit": "node scripts/merge-heroes-db.js && node scripts/test-hero-tags.js",
    "after:tags": "node scripts/test-hero-tags.js && node scripts/merge-heroes-db.js",
    "after:boss-import": "node scripts/merge-heroes-db.js",
    "upload-assets": "node scripts/upload-to-r2.mjs",
    "upload-assets:force": "node scripts/upload-to-r2.mjs --force",
    "upload-hero-variants": "node scripts/upload-to-r2.mjs --prefix heroes/cards/ && node scripts/upload-to-r2.mjs --prefix heroes/thumbs/",
    "sync:r2-down": "node scripts/download-from-r2.mjs",
    "sync:r2-heroes-down": "node scripts/download-from-r2.mjs --heroes-only --dest public --skip-existing",
    "build:hero-variants": "node scripts/create-hero-image-variants.mjs",
    "prepare-hero-variants": "npm run sync:r2-heroes-down && npm run build:hero-variants",
    "build:game-balance": "node scripts/build-game-balance.mjs",
    "build:td-mythology-icons": "node scripts/build-td-mythology-icons.mjs",
    "test:td-mythology": "node scripts/test-td-mythology-groups.mjs",
    "test:td-squad-rows": "node scripts/test-td-squad-rows.mjs",
    "test:tower-defense": "node scripts/build-game-balance.mjs --check && npm run test:td-mythology && npm run test:td-squad-rows && node scripts/test-td-timeline.mjs && node scripts/test-td-timeline-targets.mjs && node scripts/test-td-stage-convert.mjs && node scripts/test-td-timeline-sim.mjs && node scripts/test-td-ui.mjs && node scripts/test-td-platform-tiles.mjs && node scripts/test-td-result-sequence.mjs && node scripts/test-td-favor.mjs && node scripts/test-td-difficulty.mjs && node scripts/test-td-skin.mjs && node scripts/test-td-save.mjs && node scripts/test-td-sim.mjs && node scripts/test-td-elites.mjs && node scripts/test-td-ultimate-upgrades.mjs && node scripts/test-td-lord-isis.mjs && node scripts/test-td-board-classes.mjs && node scripts/test-td-god-mode.mjs && node scripts/test-td-daily.mjs && node scripts/test-td-quests.mjs && node scripts/test-td-expedition.mjs && node scripts/test-td-campaign.mjs && node scripts/test-td-summon.mjs && node scripts/test-td-map-generator.mjs",
    "test:td-balance": "node scripts/test-td-balance.mjs",
    "test:td-environments": "node scripts/test-td-environments.mjs",
    "td:upgrade-sweep": "node scripts/td-upgrade-sweep.mjs",
    "td:scaling-editor": "node scripts/td-scaling-editor.mjs",
    "td:classes": "node scripts/td-classes.mjs",
    "td:progression": "node scripts/td-progression.mjs",
    "td:ch1-pacing": "node scripts/td-ch1-pacing.mjs",
    "td:pacing": "node scripts/td-pacing.mjs",
    "td:layout": "node scripts/td-layout-compare.mjs",
    "td:maps": "node scripts/report-td-maps.mjs",
    "td:campaign-load": "node scripts/td-campaign-load.mjs",
    "td:wor-compare": "node scripts/td-wor-compare.mjs",
    "td:wor-progression": "node scripts/td-wor-progression.mjs",
    "td:stage-lint": "node scripts/td-stage-lint.mjs",
    "td:generate-map": "node scripts/generate-td-map.mjs",
    "td:board": "node scripts/generate-td-board.mjs",
    "r2:cors": "node scripts/r2-cors.mjs",
    "check": "astro check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "cookie": "^2.0.1",
    "dotenv": "^18.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.1",
    "@aws-sdk/client-s3": "^3.1030.0",
    "typescript": "^6.0.3"
  }
}
