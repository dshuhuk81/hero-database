  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@astrojs/vercel": "^9.0.4",
    "@supabase/supabase-js": "^2.98.0",
    "@vercel/analytics": "^1.6.1",
    "astro": "^5.18.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "vercel": "^50.28.0"
  }
}
