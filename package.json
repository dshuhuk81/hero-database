{
  "name": "hero-database",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:api": "node api-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build:only": "npm run astro build",
    "build": "npm run build:only",
    "deploy:prod": "npm run build:only && npx vercel --prod --yes",
    "preview": "astro preview",
    "astro": "astro",
    "tag-manager": "node scripts/tag-manager-server.js"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@astrojs/vercel": "^7.6.0",
    "@supabase/supabase-js": "^2.98.0",
    "astro": "^4.16.19",
    "dotenv": "^17.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "vercel": "^50.25.4"
  }
}
