---
export interface AccordionItem {
  id: string;
  label: string;
  image: string;
  imgPos?: string;
  imgPosActive?: string;
  badge?: string;
}

interface Props {
  items: AccordionItem[];
  activeId?: string;
  instanceId?: string;
}

const { items, activeId, instanceId = "accordion" } = Astro.props;
const activeIndex = activeId ? items.findIndex(i => i.id === activeId) : 0;
---

<div class="accordion-strip" data-accordion-instance={instanceId}>
  {items.map((item, index) => (
    <button
      class={`accordion-panel${index === (activeIndex >= 0 ? activeIndex : 0) ? " is-active" : ""}`}
      data-accordion-tab
      data-tab={item.id}
      data-index={index}
      style={`--img-pos: ${item.imgPos ?? "center 20%"}; --img-pos-active: ${item.imgPosActive ?? item.imgPos ?? "center 20%"}`}
      type="button"
      aria-label={item.label}
    >
      <img
        src={item.image}
        alt={item.label}
        class="accordion-img"
        loading={index === 0 ? "eager" : "lazy"}
      />
      <div class="accordion-content">
        <span class="accordion-label-row">
          <span class="accordion-label">{item.label}</span>
          {item.badge && <span class="accordion-guide-badge">{item.badge}</span>}
        </span>
      </div>
    </button>
  ))}
</div>

<style>
  .accordion-strip {
    display: flex;
    width: 100%;
    height: 100%;
    gap: 0;
    overflow: hidden;
  }

  .accordion-panel {
    position: relative;
    flex: 0 0 95px;
    border: none;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    font-family: inherit;
    transition: flex 420ms cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;
    border-radius: 0;
    background: transparent;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }

  .accordion-panel:first-child {
    border-left: none;
  }

  .accordion-panel.is-active {
    flex: 1 1 0;
    cursor: default;
  }

  .accordion-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--img-pos, center 20%);
    transform: scale(1.05);
    filter: brightness(0.3) saturate(0.4);
    transition: transform 420ms cubic-bezier(0.4, 0, 0.2, 1),
                filter 420ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .accordion-panel.is-active .accordion-img {
    transform: scale(1);
    filter: brightness(0.85) saturate(1.1);
    object-position: var(--img-pos-active, var(--img-pos, center 20%));
  }

  .accordion-panel:not(.is-active):hover .accordion-img {
    filter: brightness(0.45) saturate(0.6);
  }

  .accordion-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.15) 30%,
      transparent 50%
    );
    transition: background 420ms ease;
  }

  .accordion-panel.is-active::before {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.1) 25%,
      transparent 45%
    );
  }

  .accordion-panel.is-active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-teal));
    z-index: 3;
  }

  .accordion-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    height: 100%;
    padding: var(--space-3);
    color: var(--text-bright);
    text-align: left;
  }

  .accordion-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9), 0 1px 3px rgba(0, 0, 0, 0.8);
    white-space: normal;
    word-break: break-word;
    transition: font-size var(--duration-normal) var(--ease-out);
  }

  .accordion-label-row {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .accordion-panel.is-active .accordion-label {
    font-size: var(--text-2xl);
  }

  .accordion-guide-badge {
    font-size: 0.6rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 99px;
    background: var(--accent-gold);
    color: #0a0a0a;
  }

  .accordion-panel.is-active .accordion-guide-badge {
    font-size: 0.65rem;
  }

  /* ── MOBILE: scroll strip ── */
  @media (max-width: 768px) {
    .accordion-strip {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .accordion-strip::-webkit-scrollbar {
      display: none;
    }

    .accordion-panel {
      flex: 0 0 72px;
      scroll-snap-align: start;
      border-left: 1px solid rgba(255, 255, 255, 0.08);
      transition: none;
    }

    .accordion-panel.is-active {
      flex: 0 0 72px;
      box-shadow: inset 0 0 0 2px var(--accent-gold);
      cursor: pointer;
    }

    .accordion-panel.is-active .accordion-img {
      filter: brightness(0.7) saturate(0.9);
    }

    .accordion-panel.is-active .accordion-label {
      font-size: var(--text-xs);
    }

    .accordion-panel.is-active::after {
      height: 3px;
    }

    .accordion-label {
      font-size: var(--text-xs);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .accordion-content {
      padding: var(--space-2);
      height: 100%;
    }
  }
</style>
