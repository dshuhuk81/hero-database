---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import PageHero from "../PageHero.astro";
import "../../styles/components.css";
import { defaultLocale, type Locale } from "../../i18n/config";
import { pickLang } from "../../i18n/helpers";
import { t } from "../../i18n/ui";
import data from "../../data/totems.json";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const totems = data?.totems ?? [];
const copy = {
  kicker: { en: "Team-wide power", de: "Teamweite Stärke", es: "Poder para todo el equipo", ru: "Сила всей команды", zh: "全队增益" },
  title: { en: "Choose by game plan", de: "Nach Spielplan wählen", es: "Elige según tu estrategia", ru: "Выбирай под стратегию", zh: "根据战术选择" },
  count: { en: `${totems.length} rated totems`, de: `${totems.length} bewertete Totems`, es: `${totems.length} tótems valorados`, ru: `${totems.length} тотемов с рейтингом`, zh: `${totems.length} 个已评级图腾` },
  effects: { en: "Upgrade effects", de: "Upgrade-Effekte", es: "Efectos de mejora", ru: "Эффекты улучшения", zh: "升级效果" },
};

function levelLabel(level: number) {
  return `Lv ${level}`;
}
---

<Base title={t(locale, "totems", "metaTitle")} description={t(locale, "totems", "metaDescription")} locale={locale}>
<PageHero
  tag={t(locale, "totems", "tag")}
  headline={t(locale, "totems", "headline")}
  subtitle={t(locale, "totems", "subtitle")}
  locale={locale}
/>

<div class="page-wrapper page-content">
  <div class="content-heading">
    <div class="content-heading-copy">
      <p class="content-heading-kicker">{pickLang(copy.kicker, locale)}</p>
      <h2 class="content-heading-title">{pickLang(copy.title, locale)}</h2>
      <p class="content-heading-description">{pickLang(data.description, locale)}</p>
    </div>
    <p class="totem-count">{pickLang(copy.count, locale)}</p>
  </div>

  <div class="totem-grid">
    {totems.map((totem) => (
      <article class="totem-card">
        <div class="totem-stage">
          <img src={totem.image} alt="" class="totem-image" loading="lazy" />
          {totem.rating ? (
            <div class="rating-badge" data-tier={totem.rating} aria-label={`Rating ${totem.rating}`}>
              {totem.rating}
            </div>
          ) : null}
        </div>

        <div class="totem-card-body">
          <div class="totem-identity">
            <h2>{pickLang(totem.name, locale)}</h2>
            <div class="totem-tags">
              {(totem.archetypes ?? []).map((tag) => (
                <span class="tag">{pickLang(tag, locale)}</span>
              ))}
            </div>
          </div>

          {totem.summary ? <p class="totem-summary">{pickLang(totem.summary, locale)}</p> : null}

          <div class="totem-effects">
            <p class="totem-effects-label">{pickLang(copy.effects, locale)}</p>
            {(totem.effects ?? []).map((e) => (
              <div class="totem-effect">
                <span class="upgrade-lv">{levelLabel(e.level)}</span>
                <span class="upgrade-text">{pickLang(e.description, locale)}</span>
              </div>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

</Base>

<style>
  .totem-count { margin: 0; color: var(--text-muted); font-size: var(--text-sm); white-space: nowrap; }

  .totem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: var(--space-6);
    padding-bottom: var(--space-20);
  }

  .totem-card {
    overflow: hidden;
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
  }

  .totem-stage {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    height: 190px;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border-faint);
    background:
      radial-gradient(circle at 50% 52%, var(--accent-purple-dim), transparent 48%),
      var(--bg-raised);
  }

  .totem-image {
    position: absolute;
    inset: var(--space-5);
    width: calc(100% - (var(--space-5) * 2));
    height: calc(100% - (var(--space-5) * 2));
    object-fit: contain;
    filter: drop-shadow(var(--shadow-md));
  }

  .rating-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
  }

  .totem-card-body { padding: var(--space-6); }
  .totem-identity { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }
  .totem-identity h2 { margin: 0; color: var(--text-bright); font-size: var(--text-xl); line-height: var(--leading-tight); }
  .totem-tags { display: flex; flex: 0 0 auto; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-1); }
  .tag {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--accent-purple-dim);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    text-transform: capitalize;
  }

  .totem-summary {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
  }

  .totem-effects {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-6);
    border-top: 1px solid var(--border-faint);
  }

  .totem-effects-label { margin: var(--space-4) 0 var(--space-2); color: var(--text-muted); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-widest); text-transform: uppercase; }
  .totem-effect { display: grid; grid-template-columns: 48px 1fr; gap: var(--space-3); padding: var(--space-3) 0; }
  .totem-effect + .totem-effect { border-top: 1px solid var(--border-faint); }
  .totem-effect .upgrade-lv { align-self: start; }
  .totem-effect .upgrade-text { color: var(--text-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); }

  @media (max-width: 600px) {
    .content-heading { align-items: flex-start; }
    .totem-stage { height: 160px; }
    .totem-card-body { padding: var(--space-5); }
    .totem-identity { flex-direction: column; gap: var(--space-3); }
    .totem-tags { justify-content: flex-start; }
  }
</style>
