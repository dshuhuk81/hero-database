---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import PageHero from "../PageHero.astro";
import "../../styles/components.css";
import { defaultLocale, type Locale } from "../../i18n/config";
import { getPageUpdate } from "../../utils/getPageUpdate";
import { pickLang } from "../../i18n/helpers";
import { t } from "../../i18n/ui";
import data from "../../data/totems.json";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const pageUpdate = getPageUpdate("totems");
const totems = data?.totems ?? [];

function levelLabel(level: number) {
  return `Lv ${level}`;
}
---

<Base title={t(locale, "totems", "metaTitle")} description={t(locale, "totems", "metaDescription")} locale={locale}>
<PageHero
  tag={t(locale, "totems", "tag")}
  headline={t(locale, "totems", "headline")}
  subtitle={t(locale, "totems", "subtitle")}
  pageUpdate={pageUpdate}
  locale={locale}
/>

<div class="page-wrapper">
  <div class="content-wrapper">
    <div class="resultcontent">
      <div class="totem-grid">
        {totems.map((totem) => (
          <article class="totem-card">
            <img src={totem.image} alt={pickLang(totem.name, locale)} class="totem-image" />

            <h2>{pickLang(totem.name, locale)}</h2>

            {totem.rating ? (
              <div class="rating-badge" data-tier={totem.rating}>
                {totem.rating}
              </div>
            ) : null}

            {totem.summary ? <p class="totem-summary">{pickLang(totem.summary, locale)}</p> : null}

            <div class="totem-effects">
              {(totem.effects ?? []).map((e) => (
                <div class="upgrade-row">
                  <span class="upgrade-lv">{levelLabel(e.level)}</span>
                  <span class="upgrade-text">{pickLang(e.description, locale)}</span>
                </div>
              ))}
            </div>

            <div class="totem-tags">
              {(totem.archetypes ?? []).map((tag) => (
                <span class="tag">{pickLang(tag, locale)}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>

</Base>

<style>
  .totem-header {
    height: 360px;
    background-image: url("https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/bg.jpg");
    background-size: cover;
    background-position: center 150%;
    background-attachment: fixed;
    position: relative;
  }

  .totem-header::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(0,0,0,0) 40%, rgba(0,0,0,0.35)),
      linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.45));
  }

  .title {
    text-align: center;
    margin: 32px 0;
    font-weight: 600;
  }

  .resultcontent {
    margin-bottom: 24px;
    margin-top: 40px;
  }

  .totem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    justify-content: center;
  }

  .totem-card {
    background: #111;
    padding: 18px;
    border-radius: var(--radius-lg);
    position: relative;
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .totem-image {
    width: 100%;
    height: 120px;
    object-fit: contain;
  }

  .rating-badge {
    position: absolute;
    top: 12px;
    right: 12px;
  }

  .tag {
    display: inline-block;
    background: rgba(168, 85, 247, 0.2);
    padding: 4px 8px;
    margin: 4px 4px 0 0;
    border-radius: 6px;
    font-size: 12px;
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .totem-summary {
    font-size: 14px;
    margin: 8px 0;
    color: #b0b0b0;
  }

  .totem-effects {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 10px 0;
  }
</style>
