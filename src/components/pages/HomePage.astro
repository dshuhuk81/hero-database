---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import { teaserEntries as teasers, defaultMaintenanceTooltip, activeBadge, type NavEntry } from "../../data/nav";
import { defaultLocale, localizePath, type Locale } from "../../i18n/config";
import { pickLang } from "../../i18n/helpers";
import { navLabel, t } from "../../i18n/ui";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props as Props;

const FEATURED_HREFS = ["/heroes", "/tierlist", "/guides"];
const featured = FEATURED_HREFS
  .map((href) => teasers.find((entry) => entry.href === href))
  .filter(Boolean) as NavEntry[];
const secondary = teasers.filter((entry) => !FEATURED_HREFS.includes(entry.href));
const tools = secondary.filter((entry) => entry.group === "tools");
const library = secondary
  .filter((entry) => entry.group !== "tools")
  .sort((a, b) => Number(b.href === "/tips") - Number(a.href === "/tips"));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Motto Immortal Database",
  url: new URL("/", Astro.site).href,
};

const hrefFor = (href: string) => localizePath(href, locale);
---

<Base
  title={t(locale, "home", "metaTitle")}
  description={t(locale, "home", "metaDescription")}
  locale={locale}
  jsonLd={jsonLd}
>
  <dialog
    class="language-notice"
    data-language-notice
    aria-labelledby="languageNoticeTitle"
    aria-describedby="languageNoticeBody"
  >
    <div class="language-notice-shell">
      <header class="language-notice-header">
        <span class="language-notice-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span>{t(locale, "home", "languageNoticeEyebrow")}</span>
        </span>
        <button class="language-notice-close" type="button" data-language-notice-close aria-label={t(locale, "common", "dismiss")}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </header>
      <h2 id="languageNoticeTitle">{t(locale, "home", "languageNoticeTitle")}</h2>
      <p id="languageNoticeBody">{t(locale, "home", "languageNoticeBody")}</p>
      <p class="language-notice-discord">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
        </svg>
        <span>{t(locale, "home", "languageNoticeDiscord")}</span>
      </p>
      <form method="dialog" class="language-notice-actions">
        <button class="language-notice-primary" type="submit" value="dismiss" data-language-notice-close>
          {t(locale, "home", "languageNoticeDismiss")}
        </button>
      </form>
    </div>
  </dialog>

  <div class="home-page">
    <section class="home-hero" aria-labelledby="homeTitle">
      <div class="home-hero-art" aria-hidden="true"></div>
      <div class="home-hero-veil" aria-hidden="true"></div>

      <div class="home-hero-inner">
        <p class="home-eyebrow">{t(locale, "home", "databaseEyebrow")}</p>
        <h1 id="homeTitle">{t(locale, "home", "heroHeadline")}</h1>
        <p class="home-lead">{t(locale, "home", "heroLead")}</p>
        <div class="home-actions">
          <a class="home-action home-action-primary" href={hrefFor("/heroes")}>
            {navLabel("/heroes", "Hero List", locale)}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="home-action home-action-secondary" href={hrefFor("/tierlist")}>
            {navLabel("/tierlist", "Tier List", locale)}
          </a>
        </div>
      </div>
    </section>

    <main class="home-main">
      <section class="home-section" aria-labelledby="startTitle">
        <header class="section-heading">
          <p class="section-kicker">{t(locale, "home", "exploreHeadline")}</p>
          <h2 id="startTitle">{t(locale, "home", "startHereHeadline")}</h2>
        </header>

        <div class="featured-grid">
          {featured.map((entry, index) => {
            const badge = activeBadge(entry);
            return (
              <a class={`featured-card featured-card-${index + 1}`} href={hrefFor(entry.href)}>
                <div class="featured-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
                </div>
                <div class="featured-copy">
                  <div class="featured-title-row">
                    <h3>{navLabel(entry.href, entry.label, locale)}</h3>
                    {badge && (
                      <span class="entry-badge" style={badge.color ? `--badge-color:${badge.color}` : ""}>
                        {pickLang(badge.text, locale)}
                      </span>
                    )}
                  </div>
                  <p>{pickLang(entry.description, locale)}</p>
                </div>
                <svg class="featured-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            );
          })}
        </div>
      </section>

      <aside id="support" class="support-card" aria-labelledby="supportTitle">
        <div>
          <p class="section-kicker">{t(locale, "home", "communityEyebrow")}</p>
          <h2 id="supportTitle">{t(locale, "home", "keepFreeHeadline")}</h2>
          <p>{t(locale, "home", "supportCompactBody")}</p>
        </div>
        <div class="support-actions">
          <a href="https://ko-fi.com/dsfrieren" target="_blank" rel="noopener noreferrer" class="support-primary">
            {t(locale, "home", "supportKofi")}
          </a>
          <a href="https://www.paypal.com/donate/?hosted_button_id=EEMDMAMUL8P8A" target="_blank" rel="noopener noreferrer" class="support-secondary">
            {t(locale, "home", "supportPaypal")}
          </a>
        </div>
      </aside>

      <section class="home-section home-directory" aria-labelledby="directoryTitle">
        <header class="section-heading">
          <p class="section-kicker">{t(locale, "home", "databaseEyebrow")}</p>
          <h2 id="directoryTitle">{t(locale, "home", "directoryHeadline")}</h2>
        </header>

        <div class="directory-layout">
          <div class="directory-group">
            <h3>{t(locale, "home", "libraryHeadline")}</h3>
            <div class="link-list">
              {library.map((entry) => {
                const isMaintenance = entry.status?.type === "maintenance";
                const badge = activeBadge(entry);
                const content = (
                  <>
                    <span class="link-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
                    </span>
                    <span class="link-copy">
                      <span class="link-title">
                        {navLabel(entry.href, entry.label, locale)}
                        {badge && (
                          <span class="entry-badge" style={badge.color ? `--badge-color:${badge.color}` : ""}>
                            {pickLang(badge.text, locale)}
                          </span>
                        )}
                      </span>
                      <span class="link-description">{pickLang(entry.description, locale)}</span>
                    </span>
                    <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </>
                );

                return isMaintenance ? (
                  <span class="directory-link is-disabled" title={entry.status?.tooltip ?? defaultMaintenanceTooltip} aria-disabled="true">
                    {content}
                  </span>
                ) : (
                  <a class="directory-link" href={hrefFor(entry.href)}>{content}</a>
                );
              })}
            </div>
          </div>

          <div class="directory-group directory-group-tools">
            <h3>{t(locale, "home", "toolsHeadline")}</h3>
            <div class="link-list">
              {tools.map((entry) => {
                const badge = activeBadge(entry);
                return (
                  <a class="directory-link" href={hrefFor(entry.href)}>
                    <span class="link-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
                    </span>
                    <span class="link-copy">
                      <span class="link-title">
                        {navLabel(entry.href, entry.label, locale)}
                        {badge && (
                          <span class="entry-badge" style={badge.color ? `--badge-color:${badge.color}` : ""}>
                            {pickLang(badge.text, locale)}
                          </span>
                        )}
                      </span>
                      <span class="link-description">{pickLang(entry.description, locale)}</span>
                    </span>
                    <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    (() => {
      const storageKey = "motto-language-notice-v1";
      const dialog = document.querySelector("[data-language-notice]");
      if (!(dialog instanceof HTMLDialogElement)) return;

      const rememberDismissed = () => {
        try { localStorage.setItem(storageKey, "dismissed"); } catch {}
      };
      const wasDismissed = () => {
        try { return localStorage.getItem(storageKey) === "dismissed"; } catch { return false; }
      };
      const dismissNotice = () => {
        rememberDismissed();
        if (dialog.open) dialog.close("dismiss");
      };

      dialog.addEventListener("close", rememberDismissed, { once: true });
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dismissNotice();
      });
      dialog.querySelectorAll("[data-language-notice-close]").forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          dismissNotice();
        });
      });
      window.setTimeout(() => {
        if (!wasDismissed() && !dialog.open) dialog.showModal();
      }, 650);
    })();
  </script>
</Base>

<style>
  .home-page {
    min-height: 100vh;
    color: var(--text-primary);
    background:
      radial-gradient(900px 520px at 85% 28%, var(--accent-purple-dim), transparent 72%),
      var(--bg-base);
  }

  .home-hero {
    position: relative;
    min-height: clamp(500px, 72vh, 720px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .home-hero-art {
    position: absolute;
    inset: 0;
    background-image: url("/features/home-hero-divine-citadel.webp");
    background-size: cover;
    background-position: 62% center;
    transform: scale(1.02);
  }

  .home-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7, 6, 12, 0.96) 0%, rgba(7, 6, 12, 0.74) 43%, rgba(7, 6, 12, 0.18) 78%),
      linear-gradient(0deg, var(--bg-base) 0%, transparent 36%),
      linear-gradient(180deg, rgba(7, 6, 12, 0.25), transparent 30%);
  }

  .home-hero-inner {
    position: relative;
    z-index: var(--z-raised);
    width: 100%;
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-20) var(--space-8) var(--space-16);
  }

  .home-eyebrow,
  .section-kicker {
    margin: 0 0 var(--space-3);
    color: var(--accent-gold);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 820px;
    margin: 0;
    color: var(--text-bright);
    font-size: clamp(54px, 8.5vw, 112px);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 0.9;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .home-lead {
    max-width: 600px;
    margin: var(--space-6) 0 0;
    color: var(--text-secondary);
    font-size: clamp(var(--text-md), 1.7vw, var(--text-xl));
    line-height: var(--leading-normal);
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .home-action {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0 var(--space-5);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    color: var(--text-bright);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
    transition: var(--transition-colors), var(--transition-transform);
  }

  .home-action svg {
    width: 18px;
    height: 18px;
  }

  .home-action-primary {
    border-color: var(--accent-gold);
    background: var(--accent-gold);
    color: var(--bg-base);
  }

  .home-action-secondary {
    background: color-mix(in srgb, var(--bg-base) 66%, transparent);
    backdrop-filter: blur(12px);
  }

  .home-action:hover {
    transform: translateY(-2px);
  }

  .home-action-primary:hover {
    background: var(--accent-gold-light);
  }

  .home-action-secondary:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold-light);
  }

  .home-main {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .home-section + .home-section {
    margin-top: var(--space-20);
  }

  .support-card + .home-section {
    margin-top: var(--space-20);
  }

  .section-heading {
    margin-bottom: var(--space-8);
  }

  .section-heading h2,
  .support-card h2 {
    margin: 0;
    color: var(--text-bright);
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .featured-card {
    position: relative;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    transition: var(--transition-colors), var(--transition-transform);
  }

  .featured-card::after {
    content: "";
    position: absolute;
    right: -25%;
    bottom: -45%;
    width: 270px;
    height: 270px;
    border-radius: var(--radius-full);
    background: var(--accent-purple-dim);
    filter: blur(20px);
    pointer-events: none;
  }

  .featured-card-1::after {
    background: var(--accent-gold-dim);
  }

  .featured-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-medium);
  }

  .featured-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    color: var(--accent-gold);
  }

  .featured-icon svg {
    width: 28px;
    height: 28px;
  }

  .featured-copy {
    position: relative;
    z-index: 1;
    max-width: 420px;
    margin-top: var(--space-10);
  }

  .featured-title-row,
  .link-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .featured-copy h3 {
    margin: 0;
    color: var(--text-bright);
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
  }

  .featured-copy p {
    margin: var(--space-2) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .featured-arrow {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    width: 24px;
    height: 24px;
    color: var(--text-muted);
    transition: var(--transition-transform), var(--transition-colors);
  }

  .featured-card:hover .featured-arrow {
    color: var(--accent-gold);
    transform: translateX(var(--space-1));
  }

  .entry-badge {
    --badge-color: var(--accent-purple);
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: 0 var(--space-2);
    border: 1px solid color-mix(in srgb, var(--badge-color) 50%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--badge-color) 16%, transparent);
    color: var(--text-bright);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-transform: uppercase;
  }

  .directory-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: var(--space-10);
  }

  .directory-group h3 {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .link-list {
    border-top: 1px solid var(--border-subtle);
  }

  .directory-link {
    min-height: 88px;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 20px;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
    color: inherit;
    text-decoration: none;
    transition: var(--transition-colors);
  }

  .directory-link:hover {
    background: var(--surface-tint);
  }

  .directory-link.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .link-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--bg-raised);
    color: var(--accent-gold);
  }

  .link-icon svg {
    width: 21px;
    height: 21px;
  }

  .link-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .link-title {
    color: var(--text-bright);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .link-description {
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-arrow {
    width: 18px;
    height: 18px;
    color: var(--text-disabled);
    transition: var(--transition-transform), var(--transition-colors);
  }

  .directory-link:hover .link-arrow {
    color: var(--accent-gold);
    transform: translateX(var(--space-1));
  }

  .support-card {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-top: var(--space-20);
    padding: var(--space-8);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(120deg, var(--accent-gold-dim), transparent 45%),
      var(--bg-raised);
  }

  .support-card > div:first-child {
    max-width: 680px;
  }

  .support-card p:not(.section-kicker) {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .support-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    flex: 0 0 auto;
  }

  .support-primary,
  .support-secondary {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .support-primary {
    padding: 0 var(--space-5);
    border-radius: var(--radius-md);
    background: var(--accent-gold);
    color: var(--bg-base);
  }

  .support-secondary {
    color: var(--accent-gold-light);
  }

  .language-notice {
    width: min(420px, calc(100vw - var(--space-8)));
    padding: 0;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--bg-overlay);
    color: var(--text-primary);
    box-shadow: var(--shadow-xl);
  }

  .language-notice::backdrop {
    background: color-mix(in srgb, var(--bg-base) 68%, transparent);
    backdrop-filter: blur(5px);
  }

  .language-notice-shell {
    padding: var(--space-5);
  }

  .language-notice-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .language-notice-badge,
  .language-notice-discord {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .language-notice-badge {
    min-height: 28px;
    padding: 0 var(--space-2);
    border: 1px solid var(--accent-gold-dim);
    border-radius: var(--radius-md);
    background: var(--accent-gold-dim);
    color: var(--accent-gold-light);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
  }

  .language-notice-badge svg {
    width: 15px;
    height: 15px;
  }

  .language-notice-close {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-subtle);
