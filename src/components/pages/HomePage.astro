<script>
  const bannerAge = document.querySelector<HTMLElement>("[data-banner-start]");
  if (bannerAge) {
    const startedAt = new Date(`${bannerAge.dataset.bannerStart}T00:00:00`);
    const days = Math.max(0, Math.floor((Date.now() - startedAt.getTime()) / 86400000));
    bannerAge.textContent = `· ${days} ${days === 1 ? "day" : "days"} ago`;
  }
