---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import { teaserEntries as teasers, defaultMaintenanceTooltip, activeBadge, type NavEntry } from "../../data/nav";
import { defaultLocale, localizePath, type Locale } from "../../i18n/config";
import { pickLang } from "../../i18n/helpers";
import { navLabel, t } from "../../i18n/ui";
import HeroCard from "../HeroCard.astro";
import { getHeroById } from "../../data/heroes/withRatings";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props as Props;

const FEATURED_HREFS = ["/heroes", "/tierlist", "/guides"];
const featured = FEATURED_HREFS
  .map((href) => teasers.find((entry) => entry.href === href))
  .filter(Boolean) as NavEntry[];
const secondary = teasers.filter((entry) => !FEATURED_HREFS.includes(entry.href));
const tools = secondary.filter((entry) => entry.group === "tools");
const library = secondary
  .filter((entry) => entry.group !== "tools")
  .sort((a, b) => Number(b.href === "/tips") - Number(a.href === "/tips"));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Motto Immortal Database",
  url: new URL("/", Astro.site).href,
};


const hrefFor = (href: string) => localizePath(href, locale);
const launchHero = getHeroById("heket");
const featuredImageFor = (href: string) => href === "/heroes"
  ? "/teaser/herolist.webp"
  : href === "/tierlist"
    ? "/teaser/tierlist.webp"
    : href === "/guides"
      ? "/teaser/guides.png"
      : undefined;
---

<Base
  title={t(locale, "home", "metaTitle")}
  description={t(locale, "home", "metaDescription")}
  locale={locale}
  jsonLd={jsonLd}
>
  <dialog
    class="language-notice"
    data-language-notice
    aria-labelledby="languageNoticeTitle"
    aria-describedby="languageNoticeBody"
  >
    <div class="language-notice-shell">
      <header class="language-notice-header">
        <span class="language-notice-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span>{t(locale, "home", "languageNoticeEyebrow")}</span>
        </span>
        <button class="language-notice-close" type="button" data-language-notice-close aria-label={t(locale, "common", "dismiss")}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </header>
      <h2 id="languageNoticeTitle">{t(locale, "home", "languageNoticeTitle")}</h2>
      <p id="languageNoticeBody">{t(locale, "home", "languageNoticeBody")}</p>
      <p class="language-notice-discord">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
        </svg>
        <span>{t(locale, "home", "languageNoticeDiscord")}</span>
      </p>
      <form method="dialog" class="language-notice-actions">
        <button class="language-notice-primary" type="submit" value="dismiss" data-language-notice-close>
          {t(locale, "home", "languageNoticeDismiss")}
        </button>
      </form>
    </div>
  </dialog>

  <div class="home-page">
    <section class="home-hero" aria-labelledby="homeTitle">
      <div class="home-hero-art" aria-hidden="true"></div>
      <div class="home-hero-veil" aria-hidden="true"></div>

      <div class="home-hero-inner">
        <p class="home-eyebrow">{t(locale, "home", "databaseEyebrow")}</p>
        <h1 id="homeTitle">{t(locale, "home", "heroHeadline")}</h1>
        <p class="home-lead">{t(locale, "home", "heroLead")}</p>
        <div class="home-actions">
          <a class="home-action home-action-primary" href={hrefFor("/heroes")}>
            {navLabel("/heroes", "Hero List", locale)}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="home-action home-action-secondary" href={hrefFor("/tierlist")}>
            {navLabel("/tierlist", "Tier List", locale)}
          </a>
        </div>
      </div>
    </section>

    <main class="home-main">
      <section class="launch-section" aria-labelledby="launchTitle">
        <header class="section-heading launch-heading">
          <h2 id="launchTitle">Latest Banner</h2>
        </header>

        <aside class="launch-card">
          <div class="launch-backdrop" aria-hidden="true"></div>
          <div class="launch-content">
            <div class="launch-character" aria-label="Heqet hero card">
              <div class="launch-character-icons" aria-label={`${launchHero?.role}, ${launchHero?.class}`}>
                <img src={`https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/roles/${launchHero?.role.toLowerCase()}.webp`} alt={launchHero?.role} width="20" height="20" />
                <img src={`https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/classes/${launchHero?.class.toLowerCase()}.webp`} alt={launchHero?.class} width="20" height="20" />
              </div>
              {launchHero && <HeroCard hero={launchHero} />}
            </div>
          </div>
          <div class="launch-meta">
            <strong class="launch-meta-name">Heqet</strong>
            <a class="launch-meta-action" href={hrefFor("/heroes/heket")}>
              Explore the hero
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <span class="launch-date"><span aria-hidden="true">◷</span> Aug 19 — Sep 2, 2026 <span class="launch-age" data-banner-start="2026-08-19">· 1 day ago</span></span>
          </div>
        </aside>
      </section>

      <section class="home-section" aria-labelledby="startTitle">
        <header class="section-heading">
          <p class="section-kicker">{t(locale, "home", "exploreHeadline")}</p>
          <h2 id="startTitle">{t(locale, "home", "startHereHeadline")}</h2>
        </header>

        <div class="featured-grid">
          {featured.map((entry, index) => {
            const badge = activeBadge(entry);
            const featuredImage = featuredImageFor(entry.href);
            return (
              <a class={`featured-card featured-card-${index + 1}${featuredImage ? " featured-card-image" : ""}`} href={hrefFor(entry.href)}>
                {featuredImage ? (
                  <div class="featured-image-wrap">
                    <img
                      class={`featured-image${entry.href === "/guides" ? " featured-image-centered" : ""}`}
                      src={featuredImage}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : (
                  <div class="featured-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
                  </div>
                )}
                <div class="featured-copy">
                  <div class="featured-title-row">
                    <h3>{navLabel(entry.href, entry.label, locale)}</h3>
                    {badge && (
                      <span class="entry-badge" style={badge.color ? `--badge-color:${badge.color}` : ""}>
                        {pickLang(badge.text, locale)}
                      </span>
                    )}
                  </div>
                  <p>{pickLang(entry.description, locale)}</p>
                </div>
                <svg class="featured-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            );
          })}
        </div>
      </section>

      <aside id="support" class="support-card" aria-labelledby="supportTitle">
        <div>
          <p class="section-kicker">{t(locale, "home", "communityEyebrow")}</p>
          <h2 id="supportTitle">{t(locale, "home", "keepFreeHeadline")}</h2>
          <p>{t(locale, "home", "supportCompactBody")}</p>
        </div>
        <div class="support-actions">
          <a href="https://buymeacoffee.com/dshuhuk1" target="_blank" rel="noopener noreferrer" class="support-primary">
            {t(locale, "home", "supportBuyMeCoffee")}
          </a>
          <a href="https://www.paypal.com/donate/?hosted_button_id=EEMDMAMUL8P8A" target="_blank" rel="noopener noreferrer" class="support-secondary">
            {t(locale, "home", "supportPaypal")}
          </a>
          <a href="https://ko-fi.com/dsfrieren" target="_blank" rel="noopener noreferrer" class="support-secondary">
            {t(locale, "home", "supportKofi")}
          </a>
        </div>
      </aside>

      <section class="home-section home-directory" aria-labelledby="directoryTitle">
        <header class="section-heading">
          <p class="section-kicker">{t(locale, "home", "databaseEyebrow")}</p>
          <h2 id="directoryTitle">{t(locale, "home", "directoryHeadline")}</h2>
        </header>

        <div class="directory-layout">
          <div class="directory-group">
            <h3>{t(locale, "home", "libraryHeadline")}</h3>
            <div class="link-list">
              {library.map((entry) => {
                const isMaintenance = entry.status?.type === "maintenance";
                const badge = activeBadge(entry);
                const content = (
                  <>
                    <span class="link-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
                    </span>
                    <span class="link-copy">
                      <span class="link-title">
                        {navLabel(entry.href, entry.label, locale)}
                        {badge && (
                          <span class="entry-badge" style={badge.color ? `--badge-color:${badge.color}` : ""}>
                            {pickLang(badge.text, locale)}
                          </span>
                        )}
                      </span>
                      <span class="link-description">{pickLang(entry.description, locale)}</span>
                    </span>
                    <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </>
                );

                return isMaintenance ? (
                  <span class="directory-link is-disabled" title={entry.status?.tooltip ?? defaultMaintenanceTooltip} aria-disabled="true">
                    {content}
                  </span>
                ) : (
                  <a class="directory-link" href={hrefFor(entry.href)}>{content}</a>
                );
              })}
            </div>
          </div>

          <div class="directory-group directory-group-tools">
            <h3>{t(locale, "home", "toolsHeadline")}</h3>
            <div class="link-list">
              {tools.map((entry) => {
                const badge = activeBadge(entry);
                return (
                  <a class="directory-link" href={hrefFor(entry.href)}>
                    <span class="link-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
                    </span>
                    <span class="link-copy">
                      <span class="link-title">
                        {navLabel(entry.href, entry.label, locale)}
                        {badge && (
                          <span class="entry-badge" style={badge.color ? `--badge-color:${badge.color}` : ""}>
                            {pickLang(badge.text, locale)}
                          </span>
                        )}
                      </span>
                      <span class="link-description">{pickLang(entry.description, locale)}</span>
                    </span>
                    <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    (() => {
      const storageKey = "motto-language-notice-v1";
      const dialog = document.querySelector("[data-language-notice]");
      if (!(dialog instanceof HTMLDialogElement)) return;

      const rememberDismissed = () => {
        try { localStorage.setItem(storageKey, "dismissed"); } catch {}
      };
      const wasDismissed = () => {
        try { return localStorage.getItem(storageKey) === "dismissed"; } catch { return false; }
      };
      const dismissNotice = () => {
        rememberDismissed();
        if (dialog.open) dialog.close("dismiss");
      };

      dialog.addEventListener("close", rememberDismissed, { once: true });
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dismissNotice();
      });
      dialog.querySelectorAll("[data-language-notice-close]").forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          dismissNotice();
        });
      });
      window.setTimeout(() => {
        if (!wasDismissed() && !dialog.open) dialog.showModal();
      }, 650);
    })();
  </script>
</Base>

<style>
  .home-page {
    min-height: 100vh;
    color: var(--text-primary);
    background:
      radial-gradient(900px 520px at 85% 28%, var(--accent-purple-dim), transparent 72%),
      var(--bg-base);
  }

  .home-hero {
    position: relative;
    min-height: clamp(500px, 72vh, 720px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .home-hero-art {
    position: absolute;
    inset: 0;
    background-image: url("https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/features/home-hero-divine-citadel.webp");
    background-size: cover;
    background-position: 62% center;
    transform: scale(1.02);
  }

  .home-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7, 6, 12, 0.96) 0%, rgba(7, 6, 12, 0.74) 43%, rgba(7, 6, 12, 0.18) 78%),
      linear-gradient(0deg, var(--bg-base) 0%, transparent 36%),
      linear-gradient(180deg, rgba(7, 6, 12, 0.25), transparent 30%);
  }

  .home-hero-inner {
    position: relative;
    z-index: var(--z-raised);
    width: 100%;
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-20) var(--space-8) var(--space-16);
  }

  .home-eyebrow,
  .section-kicker {
    margin: 0 0 var(--space-3);
    color: var(--accent-gold);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 820px;
    margin: 0;
    color: var(--text-bright);
    font-size: clamp(54px, 8.5vw, 112px);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 0.9;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .home-lead {
    max-width: 600px;
    margin: var(--space-6) 0 0;
    color: var(--text-secondary);
    font-size: clamp(var(--text-md), 1.7vw, var(--text-xl));
    line-height: var(--leading-normal);
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .home-action {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0 var(--space-5);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    color: var(--text-bright);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
    transition: var(--transition-colors), var(--transition-transform);
  }

  .home-action svg {
    width: 18px;
    height: 18px;
  }

  .home-action-primary {
    border-color: var(--accent-gold);
    background: var(--accent-gold);
    color: var(--bg-base);
  }

  .home-action-secondary {
    background: color-mix(in srgb, var(--bg-base) 66%, transparent);
    backdrop-filter: blur(12px);
  }

  .home-action:hover {
    transform: translateY(-2px);
  }

  .home-action-primary:hover {
    background: var(--accent-gold-light);
  }

  .home-action-secondary:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold-light);
  }

  .home-main {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-8) var(--space-24);
  }

  .home-section + .home-section {
    margin-top: var(--space-20);
  }

  .launch-section + .home-section {
    margin-top: var(--space-16);
  }

  .launch-heading {
    margin-bottom: var(--space-8);
  }

  .launch-card {
    position: relative;
    min-height: 390px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: #12101a;
    isolation: isolate;
  }

  .launch-backdrop {
    position: absolute;
    z-index: -2;
    inset: 0;
    background: linear-gradient(90deg, rgba(9, 8, 15, .5), rgba(13, 11, 22, .18) 60%, rgba(13, 11, 22, .3)), url('/banners/heqet2.png') top center / cover;
  }

  .launch-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(0deg, rgba(7, 6, 12, .92), transparent 38%);
    pointer-events: none;
  }

  .launch-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    padding: clamp(var(--space-8), 4vw, var(--space-12));
  }

  .launch-character {
    --launch-character-image-position: center top;
    position: relative;
    z-index: 1;
    width: 200px;
    height: 250px;
    overflow: hidden;
    border: 1px solid rgba(241, 185, 255, .42);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(28, 19, 40, .54), rgba(10, 8, 14, .92));
    box-shadow: 0 18px 40px rgba(0, 0, 0, .34);
  }

  .launch-character-icons {
    position: absolute;
    z-index: 4;
    top: 8px;
    left: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .launch-character-icons img {
    width: 20px;
    height: 20px;
    border-radius: var(--radius-sm);
    background: rgba(8, 7, 12, .72);
  }

  .launch-character :global(.hero-card) {
    height: 250px;
  }

  .launch-character :global(.hero-card-image) {
    object-position: var(--launch-character-image-position) !important;
  }

  .launch-meta-action {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent-gold-light);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .launch-meta-action svg {
    width: 18px;
    height: 18px;
    transition: var(--transition-transform);
  }

  .launch-meta-action:hover svg {
    transform: translateX(var(--space-1));
  }

  .launch-meta {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    align-items: center;
    gap: clamp(var(--space-5), 4vw, var(--space-10));
    margin-top: 8px;
    padding: 8px clamp(var(--space-5), 4vw, var(--space-10));
    color: var(--text-secondary);
    font-size: var(--text-xs);
    background: rgba(10, 8, 14, .7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .launch-meta-name {
    color: var(--text-bright);
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
  }

  .launch-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .launch-age {
    color: var(--text-bright);
  }

  .support-card + .home-section {
    margin-top: var(--space-20);
  }

  .section-heading {
    margin-bottom: var(--space-8);
  }

  .section-heading h2,
  .support-card h2 {
    margin: 0;
    color: var(--text-bright);
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .featured-card {
    position: relative;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    transition: var(--transition-colors), var(--transition-transform);
  }

  .featured-card::after {
    content: "";
    position: absolute;
    right: -25%;
    bottom: -45%;
    width: 270px;
    height: 270px;
    border-radius: var(--radius-full);
    background: var(--accent-purple-dim);
    filter: blur(20px);
    pointer-events: none;
  }

  .featured-card-1::after {
    background: var(--accent-gold-dim);
  }

  .featured-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-medium);
  }

  .featured-card-image {
    padding-top: 0;
  }

  .featured-image-wrap {
    position: relative;
    z-index: 1;
    width: calc(100% + (2 * var(--space-6)));
    height: 238px;
    margin: 0 calc(-1 * var(--space-6));
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .featured-image-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 68%, rgba(7, 6, 12, 0.42));
    pointer-events: none;
  }

  .featured-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: left center;
    transition: transform 280ms ease;
  }

  .featured-image-centered {
    object-position: 50% 50%;
  }

  .featured-card-image:hover .featured-image {
    transform: scale(1.025);
  }

  .featured-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-subtle);
