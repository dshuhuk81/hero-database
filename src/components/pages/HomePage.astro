<script type="application/json" id="live-data" set:html={liveData}></script>
<script type="application/json" id="live-copy" set:html={liveCopy}></script>

<script>
  import { pickRightNow } from "../../data/homeRightNow.js";
  import { renderRightNow } from "../../data/homeRightNowView.js";

  // The page is built once and deployed later, so "today" comes from the visitor's clock.
  const read = (id: string) => JSON.parse(document.getElementById(id)?.textContent || "null");
  const data = read("live-data");
  const ctx = read("live-copy");
  const slots = {
    feature: document.querySelector<HTMLElement>("[data-live-feature]"),
    running: document.querySelector<HTMLElement>("[data-live-running]"),
    coming: document.querySelector<HTMLElement>("[data-live-coming]"),
  };

  if (data && ctx && slots.feature && slots.running && slots.coming) {
    const today = new Date().toISOString().slice(0, 10);
    const html = renderRightNow(pickRightNow(data.items, data.banners, today), {
      ...ctx,
      today,
      heroHref: (id: string) => `${ctx.heroPrefix}${id}`,
    });
    slots.feature.innerHTML = html.feature;
    slots.running.innerHTML = html.running;
    slots.coming.innerHTML = html.coming;
  }
</script>
