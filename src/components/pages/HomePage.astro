---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import { teaserEntries as teasers, entriesByGroup, navGroupLabels, defaultMaintenanceTooltip, activeBadge, type NavEntry, type NavGroup } from "../../data/nav";
import { defaultLocale, localizePath, type Locale } from "../../i18n/config";
import { pickLang } from "../../i18n/helpers";
import { navLabel, t } from "../../i18n/ui";
import HeroCard from "../HeroCard.astro";
import { getHeroById } from "../../data/heroes/withRatings";
import "../../styles/home-live.css";
import { globalEvents } from "../../data/eventsGlobal";
import { buildBanners } from "../../data/banners";
import { siteIdForGameId, getHeroRelease } from "../../data/heroReleases";
import { summonSchedule } from "../../data/summonSchedule";
import { pickRightNow, recentReleases } from "../../data/homeRightNow.js";
import { renderRightNow } from "../../data/homeRightNowView.js";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props as Props;

const FEATURED_HREFS = ["/heroes", "/tierlist", "/guides"];
const featured = FEATURED_HREFS
  .map((href) => teasers.find((entry) => entry.href === href))
  .filter(Boolean) as NavEntry[];
const secondary = teasers.filter((entry) => !FEATURED_HREFS.includes(entry.href));
const directoryGroups = entriesByGroup(secondary);
// Two stacked columns (big sections left, small ones right) so short groups do not leave gaps in a shared grid row.
const directoryColumns = [
  directoryGroups.filter((bucket) => ["heroes", "tools"].includes(bucket.group)),
  directoryGroups.filter((bucket) => !["heroes", "tools"].includes(bucket.group)),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Motto Immortal Database",
  url: new URL("/", Astro.site).href,
};

const hrefFor = (href: string) => localizePath(href, locale);
const L = (en: string, de: string, es: string, ru: string, zh: string) => ({ en, de, es, ru, zh });
const R2 = "https://pub-e35e94828bf347ca93c3d2c6a50d06f6.r2.dev";
const IMG_VERSION = "2026-10-28-cutouts";
const copy = {
  rightNow: L("Right now", "Jetzt aktuell", "Ahora mismo", "Прямо сейчас", "当前动态"),
  running: L("Running", "Läuft gerade", "En curso", "Идёт сейчас", "进行中"),
  comingUp: L("Coming up", "Als Nächstes", "Próximamente", "Скоро", "即将开始"),
  lastDay: L("Last day", "Letzter Tag", "Último día", "Последний день", "最后一天"),
  daysLeft: L("days left", "Tage übrig", "días restantes", "дн. осталось", "天后结束"),
  dayLeft: L("day left", "Tag übrig", "día restante", "дн. остался", "天后结束"),
  inDays: L("in {n} days", "in {n} Tagen", "en {n} días", "через {n} дн.", "{n}天后"),
  tomorrow: L("tomorrow", "morgen", "mañana", "завтра", "明天"),
  nextBanner: L("Next banner", "Nächstes Banner", "Próximo banner", "Следующий баннер", "下一个卡池"),
  moreRunning: L("{n} more running", "{n} weitere laufen", "{n} más en curso", "ещё {n} идут", "另有{n}个进行中"),
  nothingRunning: L("Nothing is running right now.", "Gerade läuft nichts.", "No hay nada en curso.", "Сейчас ничего не идёт.", "目前没有进行中的活动。"),
  nothingComing: L("No upcoming events known yet.", "Noch keine kommenden Events bekannt.", "Aún no hay eventos próximos.", "Ближайших событий пока нет.", "暂无即将开始的活动。"),
  rerun: L("Rerun", "Wiederholung", "Repetición", "Повтор", "复刻"),
  allEvents: L("All events", "Alle Events", "Todos los eventos", "Все события", "全部活动"),
  allBanners: L("All banners", "Alle Banner", "Todos los banners", "Все баннеры", "全部卡池"),
  newArrivals: L("New arrivals", "Neue Helden", "Recién llegados", "Новые герои", "新英雄"),
  allHeroes: L("All heroes", "Alle Helden", "Todos los héroes", "Все герои", "全部英雄"),
  released: L("Released {date}", "Erschienen {date}", "Lanzado {date}", "Вышел {date}", "{date}上线"),
  pull: {
    pull: L("Pull", "Ziehen", "Invocar", "Брать", "建议抽"),
    optional: L("Optional", "Optional", "Opcional", "По желанию", "可选"),
    unsure: L("Unsure", "Unklar", "Dudoso", "Неясно", "待定"),
    "whales-only": L("Whales only", "Nur Whales", "Solo ballenas", "Только донатерам", "仅大佬"),
    skip: L("Skip", "Überspringen", "Omitir", "Пропустить", "跳过"),
  },
  categories: {
    banners: L("Banner", "Banner", "Banner", "Баннер", "卡池"),
    events: L("Event", "Event", "Evento", "Событие", "活动"),
    leaderboards: L("Leaderboard", "Rangliste", "Clasificación", "Рейтинг", "排行榜"),
    recurring: L("Recurring", "Wiederkehrend", "Recurrente", "Регулярное", "周期活动"),
    offers: L("Offer", "Angebot", "Oferta", "Предложение", "礼包"),
  },
};
const pickDeep = (value: any): any =>
  "en" in value ? pickLang(value, locale) : Object.fromEntries(Object.entries(value).map(([key, inner]) => [key, pickDeep(inner)]));
const copyForScript = pickDeep(copy);

const buildDate = new Date().toISOString().slice(0, 10);
const heroThumb = (siteId?: string) => (siteId ? `${R2}/heroes/thumbs/${encodeURIComponent(siteId)}-96.webp?v=${IMG_VERSION}` : undefined);
const banners = buildBanners(buildDate)
  .filter((banner) => banner.start && (banner.end ?? "9999") >= buildDate)
  .map((banner) => ({
    id: banner.id, kind: banner.kind, start: banner.start, end: banner.end, heroName: banner.heroName, heroSiteId: banner.heroSiteId,
    image: banner.heroSiteId ? `${R2}/heroes/cards/${encodeURIComponent(banner.heroSiteId)}-480.webp?v=${IMG_VERSION}` : undefined,
  }));
// Events and rerun banners for the lists; hero banners themselves are the featured tile and the "next banner" line.
const liveItems = [
  ...globalEvents
    .filter((event) => event.category !== "banners" && event.end >= buildDate)
    .map((event) => ({ id: String(event.id), label: event.label, category: event.category, start: event.start, end: event.end, heroImage: heroThumb(event.heroGameId === undefined ? undefined : siteIdForGameId(event.heroGameId)) })),
  ...banners
    .filter((banner) => banner.kind === "rerun")
    .map((banner) => ({ id: banner.id, label: `${banner.heroName ?? pickLang(copy.rerun, locale)} · ${pickLang(copy.rerun, locale)}`, category: "banners", start: banner.start, end: banner.end, heroImage: heroThumb(banner.heroSiteId) })),
];
const rightNowCtx = {
  locale, copy: copyForScript, today: buildDate,
  eventsHref: localizePath("/events", locale), bannersHref: localizePath("/banners", locale), heroPrefix: localizePath("/heroes/", locale),
};
const rightNow = pickRightNow(liveItems, banners, buildDate);
const rightNowHtml = renderRightNow(rightNow, { ...rightNowCtx, heroHref: (id: string) => `${rightNowCtx.heroPrefix}${id}` });
const liveData = JSON.stringify({ items: liveItems, banners }).replace(/</g, "\\u003c");
const liveCopy = JSON.stringify({ ...rightNowCtx, today: undefined }).replace(/</g, "\\u003c");

const scheduleById = new Map(summonSchedule.map((entry) => [entry.id, entry]));
const releaseDate = (iso: string) => new Intl.DateTimeFormat(locale, { timeZone: "UTC", day: "numeric", month: "short" }).format(new Date(`${iso}T00:00:00Z`));
const arrivals = recentReleases(
  summonSchedule.map((entry) => ({ id: entry.id, date: getHeroRelease(entry.id)?.globalRelease ?? null })).filter((entry) => getHeroById(entry.id) && entry.id !== rightNow.featured?.heroSiteId), // the featured hero is already shown above
  buildDate,
  6,
).map((entry) => ({ hero: getHeroById(entry.id)!, date: entry.date!, pull: scheduleById.get(entry.id)?.pullQuality }));
const featuredImageFor = (href: string) => href === "/heroes"
  ? "/teaser/herolist.webp"
  : href === "/tierlist"
    ? "/teaser/tierlist.webp"
    : href === "/guides"
      ? "/teaser/guides.png"
      : undefined;
---

<Base
  title={t(locale, "home", "metaTitle")}
  description={t(locale, "home", "metaDescription")}
  locale={locale}
  jsonLd={jsonLd}
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="homeTitle">
      <div class="home-hero-art" aria-hidden="true"></div>
      <div class="home-hero-veil" aria-hidden="true"></div>

      <div class="home-hero-inner">
        <p class="home-eyebrow">{t(locale, "home", "databaseEyebrow")}</p>
        <h1 id="homeTitle">{t(locale, "home", "heroHeadline")}</h1>
        <p class="home-lead">{t(locale, "home", "heroLead")}</p>
        <div class="home-actions">
          <a class="home-action home-action-primary" href={hrefFor("/heroes")}>
            {navLabel("/heroes", "Hero List", locale)}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="home-action home-action-secondary" href={hrefFor("/tierlist")}>
            {navLabel("/tierlist", "Tier List", locale)}
          </a>
          <a class="home-action home-action-secondary" href={hrefFor("/relic-investment")}>
            {t(locale, "home", "heroInvestmentCta")}
          </a>
        </div>
      </div>
    </section>

    <main class="home-main">
      <section class="home-section hl-section" aria-labelledby="rightNowTitle" data-live>
        <header class="hl-head">
          <h2 id="rightNowTitle">{pickLang(copy.rightNow, locale)}</h2>
          <nav class="hl-links" aria-label={pickLang(copy.rightNow, locale)}>
            <a href={hrefFor("/events")}>{pickLang(copy.allEvents, locale)}</a>
            <a href={hrefFor("/banners")}>{pickLang(copy.allBanners, locale)}</a>
          </nav>
        </header>
        <div class="hl-panel">
          <div class="hl-slot-feature" data-live-feature set:html={rightNowHtml.feature}></div>
          <div class="hl-col">
            <h3>{pickLang(copy.running, locale)}</h3>
            <div data-live-running set:html={rightNowHtml.running}></div>
          </div>
          <div class="hl-col">
            <h3>{pickLang(copy.comingUp, locale)}</h3>
            <div data-live-coming set:html={rightNowHtml.coming}></div>
          </div>
        </div>
      </section>

      {arrivals.length > 0 && (
        <section class="home-section hl-section" aria-labelledby="arrivalsTitle">
          <header class="hl-head">
            <h2 id="arrivalsTitle">{pickLang(copy.newArrivals, locale)}</h2>
            <nav class="hl-links"><a href={hrefFor("/heroes")}>{pickLang(copy.allHeroes, locale)}</a></nav>
          </header>
          <ul class="hl-arrivals">
            {arrivals.map(({ hero, date, pull }) => (
              <li class="hl-arrival">
                <HeroCard hero={hero} showNewBadge={false} />
                <div class="hl-arrival-meta">
                  <strong>{hero.name}</strong>
                  <small>{[hero.class, hero.role].filter(Boolean).join(" · ")}</small>
                  <span class="hl-arrival-foot">
                    <time datetime={date}>{pickLang(copy.released, locale).replace("{date}", releaseDate(date))}</time>
                    {pull && <span class={`hl-pull hl-pull--${pull}`}>{pickLang(copy.pull[pull], locale)}</span>}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="home-section" aria-labelledby="startTitle">
        <header class="section-heading">
          <p class="section-kicker">{t(locale, "home", "exploreHeadline")}</p>
          <h2 id="startTitle">{t(locale, "home", "startHereHeadline")}</h2>
        </header>

        <div class="featured-grid">
          {featured.map((entry, index) => {
            const badge = activeBadge(entry);
            const featuredImage = featuredImageFor(entry.href);
            return (
              <a class={`featured-card featured-card-${index + 1}${featuredImage ? " featured-card-image" : ""}`} href={hrefFor(entry.href)}>
                {featuredImage ? (
                  <div class="featured-image-wrap">
                    <img
                      class={`featured-image${entry.href === "/guides" ? " featured-image-centered" : ""}`}
                      src={featuredImage}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : (
                  <div class="featured-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
                  </div>
                )}
                <div class="featured-copy">
                  <div class="featured-title-row">
                    <h3>{navLabel(entry.href, entry.label, locale)}</h3>
                    {badge && (
                      <span class="entry-badge" style={badge.color ? `--badge-color:${badge.color}` : ""}>
                        {pickLang(badge.text, locale)}
                      </span>
                    )}
                  </div>
                  <p>{pickLang(entry.description, locale)}</p>
                </div>
                <svg class="featured-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            );
          })}
        </div>
      </section>

      <div class="home-promo">
        <section class="launch-section" aria-label="Tower Defense">
          <a class="game-card" href="https://tower.motto-immortal-db.com/">
            <img
              class="game-card-art"
              src="https://tower-assets.motto-immortal-db.com/td/ui/camp-home.webp"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <div class="game-card-content">
              <span class="entry-badge" style="--badge-color: var(--accent-gold)">Alpha</span>
              <h3>The Last Crossing</h3>
              <p>Hold the line with gods of Greek and Norse myth. A free tower defense game, right in your browser.</p>
              <span class="game-card-cta">
                Play now
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
          </a>
        </section>
      <aside id="support" class="support-card" aria-labelledby="supportTitle">
        <div>
          <p class="section-kicker">{t(locale, "home", "communityEyebrow")}</p>
          <h2 id="supportTitle">{t(locale, "home", "keepFreeHeadline")}</h2>
          <p>{t(locale, "home", "supportCompactBody")}</p>
        </div>
        <div class="support-actions">
          <a href="https://buymeacoffee.com/dshuhuk1" target="_blank" rel="noopener noreferrer" class="support-primary">
            {t(locale, "home", "supportBuyMeCoffee")}
          </a>
          <a href="https://www.paypal.com/donate/?hosted_button_id=EEMDMAMUL8P8A" target="_blank" rel="noopener noreferrer" class="support-secondary">
            {t(locale, "home", "supportPaypal")}
          </a>
          <a href="https://ko-fi.com/dsfrieren" target="_blank" rel="noopener noreferrer" class="support-secondary">
            {t(locale, "home", "supportKofi")}
          </a>
        </div>
      </aside>
      </div>

      <section class="home-section home-directory" aria-labelledby="directoryTitle">
        <header class="section-heading">
          <p class="section-kicker">{t(locale, "home", "databaseEyebrow")}</p>
          <h2 id="directoryTitle">{t(locale, "home", "directoryHeadline")}</h2>
        </header>

        <div class="directory-layout">
          {directoryColumns.map((column) => (
          <div class="directory-column">
          {column.map((bucket) => (
            <div class="directory-group">
              <h3>{navGroupLabels[bucket.group as NavGroup] ? pickLang(navGroupLabels[bucket.group as NavGroup]!, locale) : ""}</h3>
              <div class="link-list">
                {bucket.entries.map((entry) => {
                  const isMaintenance = entry.status?.type === "maintenance";
                  const badge = activeBadge(entry);
                  const content = (
                    <>
                      <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
                      </span>
                      <span class="link-copy">
                        <span class="link-title">
                          {navLabel(entry.href, entry.label, locale)}
                          {badge && (
                            <span class="entry-badge" style={badge.color ? `--badge-color:${badge.color}` : ""}>
                              {pickLang(badge.text, locale)}
                            </span>
                          )}
                        </span>
                        <span class="link-description">{pickLang(entry.description, locale)}</span>
                      </span>
                      <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="m9 18 6-6-6-6" />
                      </svg>
                    </>
                  );

                  return isMaintenance ? (
                    <span class="directory-link is-disabled" title={entry.status?.tooltip ?? defaultMaintenanceTooltip} aria-disabled="true">
                      {content}
                    </span>
                  ) : (
                    <a class="directory-link" href={hrefFor(entry.href)}>{content}</a>
                  );
                })}
              </div>
            </div>
          ))}
          </div>
          ))}
        </div>
      </section>
    </main>
  </div>
</Base>

<style>
  .home-page {
    min-height: 100vh;
    color: var(--text-primary);
    background:
      radial-gradient(900px 520px at 85% 28%, var(--accent-purple-dim), transparent 72%),
      var(--bg-base);
  }

  .home-hero {
    position: relative;
    min-height: clamp(500px, 72vh, 720px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .home-hero-art {
    position: absolute;
    inset: 0;
    background-image: url("/features/home-hero-divine-citadel.webp");
    background-size: cover;
    background-position: 62% center;
    transform: scale(1.02);
  }

  .home-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7, 6, 12, 0.96) 0%, rgba(7, 6, 12, 0.74) 43%, rgba(7, 6, 12, 0.18) 78%),
      linear-gradient(0deg, var(--bg-base) 0%, transparent 36%),
      linear-gradient(180deg, rgba(7, 6, 12, 0.25), transparent 30%);
  }

  .home-hero-inner {
    position: relative;
    z-index: var(--z-raised);
    width: 100%;
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-20) var(--space-8) var(--space-16);
  }

  .home-eyebrow,
  .section-kicker {
    margin: 0 0 var(--space-3);
    color: var(--accent-gold);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 820px;
    margin: 0;
    color: var(--text-bright);
    font-size: clamp(54px, 8.5vw, 112px);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 0.9;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .home-lead {
    max-width: 600px;
    margin: var(--space-6) 0 0;
    color: var(--text-secondary);
    font-size: clamp(var(--text-md), 1.7vw, var(--text-xl));
    line-height: var(--leading-normal);
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .home-action {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0 var(--space-5);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    color: var(--text-bright);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: none;
    transition: var(--transition-colors), var(--transition-transform);
  }

  .home-action svg {
    width: 18px;
    height: 18px;
  }

  .home-action-primary {
    border-color: var(--accent-gold);
    background: var(--accent-gold);
    color: var(--bg-base);
  }

  .home-action-secondary {
    background: color-mix(in srgb, var(--bg-base) 66%, transparent);
    backdrop-filter: blur(12px);
  }

  .home-action:hover {
    transform: translateY(-2px);
  }

  .home-action-primary:hover {
    background: var(--accent-gold-light);
  }

  .home-action-secondary:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold-light);
  }

  .home-main {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-8) var(--space-24);

  }

  .home-section + .home-section {
    margin-top: var(--space-20);
  }

  .launch-section + .home-section {
    margin-top: var(--space-16);
  }

  .support-card + .home-section,
  .home-promo + .home-section {
    margin-top: var(--space-20);
  }

  .home-promo {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-20);
  }

  .home-promo .launch-section {
    display: flex;
    flex-direction: column;
  }

  .home-promo .game-card {
    flex: 1;
  }

  .home-promo .support-card {
    margin-top: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
  }

  .game-card {
    position: relative;
    min-height: 390px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    isolation: isolate;
    transition: var(--transition-colors);
  }

  .game-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(0deg, rgba(7, 6, 12, .94) 8%, rgba(7, 6, 12, .55) 42%, transparent 72%);
    pointer-events: none;
  }

  .game-card-art {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    transition: transform 280ms ease;
  }

  .game-card:hover {
    border-color: var(--border-medium);
  }

  .game-card:hover .game-card-art {
    transform: scale(1.025);
  }

  .game-card:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .game-card-content {
    max-width: 440px;
    padding: clamp(var(--space-5), 3vw, var(--space-8));
  }

