---
import TdLobby from "../td/TdLobby.astro";
import TdPlayScreen from "../td/TdPlayScreen.astro";
import TdPanels from "../td/TdPanels.astro";
interface Props { assetBase: string; heroes: any[]; tuning: any; maps: any[]; bosses: Record<string, any>; }
const { assetBase, heroes, tuning, maps, bosses } = Astro.props;
const isDev = import.meta.env.DEV; // local dev builds always ship the debug tools
// Debug tools ship in every build; the page removes them unless isDev or ?debug=1 (R6b).
const payload = { assetBase, heroes, tuning, maps, bosses, isDev };
const bossNames = Object.fromEntries(maps.map((map: any) => [map.id, bosses[map.boss ?? "baphomet"]?.name ?? "Baphomet"]));
---

<div class="td-shell" data-td-root data-screen="home">
  <TdLobby assetBase={assetBase} />
  <TdPlayScreen />
  <TdPanels maps={maps} bossNames={bossNames} heroes={heroes} />
  <dialog class="td-orient-gate" data-td-orient-gate aria-labelledby="td-orient-title" aria-describedby="td-orient-text">
    <div class="td-orient-body">
      <svg class="td-orient-icon" viewBox="0 0 64 64" aria-hidden="true"><rect x="20" y="8" width="24" height="44" rx="4" /><line x1="29" y1="46" x2="35" y2="46" /></svg>
      <h2 id="td-orient-title">Rotate your phone</h2>
      <p id="td-orient-text">The battlefield only fits in landscape. The game is paused and continues when you turn your phone sideways.</p>
      <button class="action-button action-button--primary" type="button" data-td-orient-fullscreen hidden>Enter fullscreen</button>
    </div>
  </dialog>
</div>

<script type="application/json" id="td-data" set:html={JSON.stringify(payload)}></script>

<script>
  // Tower defense page controller: builds the shared context and wires the page
  // modules in src/game/td/page/. Menu screen rendering and audio settings live here;
  // screen switching is page/nav.ts.
  import { createAudio, createMusic } from "../../game/td/audio";
  import { setAssetBase } from "../../game/td/assets.js";
  import { createPauseController } from "../../game/td/ui.js";
  import type { PageActions, PageContext, PageState } from "../../game/td/page/context";
  import { createSavePanel, createSaveStore } from "../../game/td/page/save";
  import { createBuffBar } from "../../game/td/page/boons";
  import { createResults } from "../../game/td/page/results";
  import { createDaily } from "../../game/td/page/daily";
  import { createExpedition } from "../../game/td/page/expedition";
  import { createCampaign } from "../../game/td/page/campaign";
  import { createDebugPanel } from "../../game/td/page/debug";
  import { createHud } from "../../game/td/page/hud";
  import { createPowers } from "../../game/td/page/powers";
  import { createPopover } from "../../game/td/page/popover";
  import { createRecruit } from "../../game/td/page/recruit";
  import { createPanels } from "../../game/td/page/panels";
  import { createSessionController } from "../../game/td/page/session";
  import { createNav } from "../../game/td/page/nav";
  import { createQuests } from "../../game/td/page/quests";
  import { createOrientGate } from "../../game/td/page/orient";
  import { createMenuFrame } from "../../game/td/page/frame";
  import { createWallet } from "../../game/td/page/wallet";
  import { createHome } from "../../game/td/page/home";

  const root = document.querySelector<HTMLElement>("[data-td-root]");
  if (!root) throw new Error("Tower defense root missing");
  const q = <T extends HTMLElement = HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
  const data = JSON.parse(document.getElementById("td-data")?.textContent || "{}");
  // Debug tools (R6b): always in local dev; in production only with an explicit ?debug=1.
  const debugAllowed = data.isDev || new URLSearchParams(location.search).get("debug") === "1";
  if (!debugAllowed) root.querySelectorAll("[data-td-debug-gate]").forEach((el) => el.remove());
  setAssetBase(data.assetBase);
  const heroById = new Map<string, any>(data.heroes.map((hero: any) => [hero.id, hero]));
  const maps: any[] = data.maps;

  // ------------------------------------------------------------------
  // Saved progress (td:v1; see page/save.ts) and shared page state
  // ------------------------------------------------------------------
  const store = createSaveStore({ heroIds: new Set(heroById.keys()), mapIds: new Set(maps.map((map) => map.id)), relicIds: new Set(Object.keys(data.tuning.runBoons?.list ?? {})) });
  const state: PageState = { session: null, selectedEntityId: null, deployHeroId: "", relocateEntityId: null, pendingSlot: null };

  const pause = createPauseController((paused: boolean) => {
    if (state.session) state.session.game.paused = paused;
  });

  const noticeEl = q("[data-td-notice]");
  const menuNoticeEl = q("[data-td-menu-notice]");
  let noticeTimer = 0;
  // Battle notices show on the battlefield; menu actions (no run) use the menu's own region.
  function notice(text: string) {
    const el = state.session ? noticeEl : menuNoticeEl;
    (el === noticeEl ? menuNoticeEl : noticeEl).classList.remove("is-visible");
    el.textContent = text;
    el.classList.add("is-visible");
    window.clearTimeout(noticeTimer);
    noticeTimer = window.setTimeout(() => el.classList.remove("is-visible"), 3800);
  }

  // Filled below once every module exists; modules only call actions at runtime.
  const actions = {} as PageActions;
  const ctx: PageContext = {
    root, q, data, heroById,
    bossFor: (map: any) => data.bosses?.[map?.boss ?? "baphomet"] ?? { name: "Baphomet" },
    store, state, pause,
    getSession: () => state.session,
    notice,
    actions,
  };
  store.onPersistError = () => notice("Progress could not be saved in this browser. Open Save data and export a save code to keep it.");

  // ------------------------------------------------------------------
  // Audio (one instance for the page lifetime)
  // ------------------------------------------------------------------
  const audio = createAudio(Object.fromEntries(data.heroes.map((hero: any) => [hero.id, hero.sounds])));
  // Sound controls exist twice (pause menu and Settings); every copy stays in sync.
  const all = <T extends HTMLElement>(selector: string) => [...root.querySelectorAll<T>(selector)];
  const muteButtons = all<HTMLButtonElement>("[data-td-mute]");
  const volumeSliders = all<HTMLInputElement>("[data-td-volume]");
  function playEffect(effect: any) {
    if (effect.type === "place") audio.play("voice", effect.heroId);
    else if (effect.type === "hit") audio.play("attack", effect.heroId);
    else if (effect.type === "ult") { audio.play("attack", effect.heroId); audio.play("ultimate", effect.heroId); }
    else if (effect.type === "boss") hud.bossIntro();
    else if (effect.type === "awaken") audio.play("upgrade");
    else if (effect.type === "baseHit" && effect.damage > 0) audio.play("heavy");
    // Divine Interventions (R5): Odin's lightning ultimate doubles as the thunder.
    else if (effect.type === "thunderStrike") { audio.play("ultimate", "odin"); audio.play("heavy"); }
    else if (effect.type === "shieldUp") audio.play("upgrade");
    else if (effect.type === "shieldBlock") audio.play("blocked");
  }
  function syncAudioUi() {
    muteButtons.forEach((button) => {
      button.textContent = audio.muted ? "Sound off" : "Sound on";
      button.setAttribute("aria-pressed", String(audio.muted));
    });
    volumeSliders.forEach((slider) => { slider.value = String(Math.round(audio.volume * 100)); });
  }
  muteButtons.forEach((button) => button.addEventListener("click", () => { audio.toggleMute(); syncAudioUi(); }));
  volumeSliders.forEach((slider) => slider.addEventListener("input", () => { audio.setVolume(Number(slider.value) / 100); syncAudioUi(); }));
  syncAudioUi();

  const music = createMusic();
  const musicMuteButtons = all<HTMLButtonElement>("[data-td-music-mute]");
  const musicVolumeSliders = all<HTMLInputElement>("[data-td-music-volume]");
  const syncMusicUi = () => {
    musicMuteButtons.forEach((button) => {
      button.textContent = music.muted ? "Music off" : "Music on";
      button.setAttribute("aria-pressed", String(music.muted));
    });
    musicVolumeSliders.forEach((slider) => { slider.value = String(Math.round(music.volume * 100)); });
  };
  musicMuteButtons.forEach((button) => button.addEventListener("click", () => { music.toggleMute(); syncMusicUi(); }));
  musicVolumeSliders.forEach((slider) => slider.addEventListener("input", () => { music.setVolume(Number(slider.value) / 100); syncMusicUi(); }));
  syncMusicUi();

  // ------------------------------------------------------------------
  // Menu screens (the home screen is page/home.ts)
  // ------------------------------------------------------------------
  function renderLobby() {
    wallet.render();
    dailyTrial.render();
    expedition.render();
    campaignScreens.render();
    quests.render();
    home.render();
  }

  // ------------------------------------------------------------------
  // Page modules
  // ------------------------------------------------------------------
  const wallet = createWallet(ctx);
  store.onPersist = wallet.render;
  const savePanel = createSavePanel(ctx);
  const buffBar = createBuffBar(ctx);
  const results = createResults(ctx);
  const dailyTrial = createDaily(ctx);
  const expedition = createExpedition(ctx);
  const campaignScreens = createCampaign(ctx);
  const quests = createQuests(ctx);
  const home = createHome(ctx, { campaign: campaignScreens, daily: dailyTrial, expedition });
  const debugPanel = createDebugPanel(ctx);
  const hud = createHud(ctx);
  const powers = createPowers(ctx);
  const popover = createPopover(ctx);
  const recruit = createRecruit(ctx);
  const panels = createPanels(ctx, { renderSavePanel: savePanel.render });
  const controller = createSessionController(ctx, { music, speed: hud.speed, hudTick: (now: number) => { hud.tick(now); powers.render(); }, buffBar, results, debugPanel, popover, recruit });
  const nav = createNav(ctx, {
    onShow(id) {
      wallet.close();
      wallet.place(id === "home");
      if (id === "play") return;
      renderLobby();
      // The squad screen needs a picked stage; after a reload there is none, so back to the stages.
      if (id === "squad" && !campaignScreens.renderSquad()) nav.go("stages");
      if (id === "heroes") campaignScreens.renderHeroes();
      if (id === "summon") campaignScreens.renderSummon(true);
      if (id === "quests") quests.render();
      if (id === "blessings" || id === "help" || id === "save") panels.embed(id, q(`[data-td-screen-host="${id}"]`));
    },
    // Browser Back during a run: close what is open, else open the menu; a finished run leaves.
    onGameBack() {
      if (panels.active()) panels.close();
      else if (recruit.isOpen()) actions.closeSheet();
      else if (popover.isOpen()) actions.closePopover();
      else if (!state.session || state.session.game.complete) controller.toLobby();
      else panels.open("menu");
    },
  });

  Object.assign(actions, {
    startSession: controller.start,
    selectCampaignStage: campaignScreens.selectStage,
    toLobby: controller.toLobby,
    handleChange: controller.handleChange,
    spaceBelowMap: controller.spaceBelowMap,
    updateHud: hud.update,
    startStage: hud.startStage,
    renderPreview: hud.renderPreview,
    playSound: (kind: string) => audio.play(kind),
    renderDeck: hud.renderDeck,
    cancelDeploy: hud.cancelDeploy,
    syncPauseButton: hud.syncPauseButton,
    selectUnit: popover.select,
    closePopover: popover.close,
    refreshSelection: popover.refresh,
    positionPopover: popover.position,
    closeSheet: recruit.close,
    updateSheet: recruit.update,
    bindCanvas: recruit.bindCanvas,
    beginRelocation: recruit.beginRelocation,
    consumeDragClick: recruit.consumeDragClick,
    aimPower: powers.aimAt,
    resetPowers: powers.reset,
    hoverPower: powers.hover,
    openPanel: panels.open,
    closePanel: panels.close,
    activePanel: panels.active,
    selectBlessingsTab: panels.selectTab,
    renderRunTab: panels.renderRunTab,
    syncSpendButton: panels.syncSpendButton,
    showScreen: nav.go,
    exitPlay: nav.exitPlay,
    renderLobby,
    syncAudioUi,
    playEffect,
  } satisfies PageActions);

  nav.init();
  controller.run();

  // Phones in portrait: blocking rotate gate above every screen (page/orient.ts).
  createOrientGate(ctx);
  // Menus: one phone-landscape layout, zoomed to fit (page/frame.ts).
  createMenuFrame(q("[data-td-lobby]"));
</script>
