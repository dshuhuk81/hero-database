---
import TdLobby from "../td/TdLobby.astro";
import TdPlayScreen from "../td/TdPlayScreen.astro";
import TdPanels from "../td/TdPanels.astro";
interface Props { assetBase: string; heroes: any[]; tuning: any; maps: any[]; waves: any[]; bosses: Record<string, any>; }
const { assetBase, heroes, tuning, maps, waves, bosses } = Astro.props;
const payload = { assetBase, heroes, tuning, maps, waves, bosses };
const bossNames = Object.fromEntries(maps.map((map: any) => [map.id, bosses[map.boss ?? "baphomet"]?.name ?? "Baphomet"]));
const isDev = import.meta.env.DEV; // debug panel exists only in local dev builds
---

<div class="td-shell" data-td-root data-screen="lobby">
  <TdLobby maps={maps} waveCount={waves.length} bossNames={bossNames} />
  <TdPlayScreen waveCount={waves.length} isDev={isDev} />
  <TdPanels maps={maps} bossNames={bossNames} waveCount={waves.length} />
</div>

<script type="application/json" id="td-data" set:html={JSON.stringify(payload)}></script>

<script>
  // Tower defense page controller: builds the shared context and wires the page
  // modules in src/game/td/page/. Lobby and audio settings live here.
  import { createAudio, createMusic } from "../../game/td/audio";
  import { setAssetBase } from "../../game/td/assets.js";
  import { createPauseController } from "../../game/td/ui.js";
  import type { PageActions, PageContext, PageState } from "../../game/td/page/context";
  import { availableFavor, createSavePanel, createSaveStore, isRunTier, runKey, RUN_TIERS, type RunMode } from "../../game/td/page/save";
  import { isRunMode } from "../../game/td/waves.js";
  import { createBuffBar, createRunOffer } from "../../game/td/page/boons";
  import { createResults } from "../../game/td/page/results";
  import { createDebugPanel } from "../../game/td/page/debug";
  import { createHud } from "../../game/td/page/hud";
  import { createPopover } from "../../game/td/page/popover";
  import { createRecruit } from "../../game/td/page/recruit";
  import { createPanels } from "../../game/td/page/panels";
  import { createSessionController } from "../../game/td/page/session";

  const root = document.querySelector<HTMLElement>("[data-td-root]");
  if (!root) throw new Error("Tower defense root missing");
  const q = <T extends HTMLElement = HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
  const data = JSON.parse(document.getElementById("td-data")?.textContent || "{}");
  setAssetBase(data.assetBase);
  const heroById = new Map<string, any>(data.heroes.map((hero: any) => [hero.id, hero]));
  const maps: any[] = data.maps;

  // ------------------------------------------------------------------
  // Saved progress (td:v1; see page/save.ts) and shared page state
  // ------------------------------------------------------------------
  const store = createSaveStore({ heroIds: new Set(heroById.keys()) });
  const state: PageState = { session: null, selectedMap: maps[0], selectedMode: "classic", selectedTier: "normal", selectedEntityId: null, deployHeroId: "", pendingSlot: null };
  try {
    const savedMapId = localStorage.getItem("td:map");
    state.selectedMap = maps.find((entry) => entry.id === savedMapId) ?? maps[0];
    const savedMode = localStorage.getItem("td:mode");
    if (isRunMode(savedMode)) state.selectedMode = savedMode as RunMode;
    const savedTier = localStorage.getItem("td:tier");
    if (isRunTier(savedTier)) state.selectedTier = savedTier;
  } catch {}

  const pause = createPauseController((paused: boolean) => {
    if (state.session) state.session.game.paused = paused;
  });

  const noticeEl = q("[data-td-notice]");
  let noticeTimer = 0;
  function notice(text: string) {
    noticeEl.textContent = text;
    noticeEl.classList.add("is-visible");
    window.clearTimeout(noticeTimer);
    noticeTimer = window.setTimeout(() => noticeEl.classList.remove("is-visible"), 3800);
  }

  // Filled below once every module exists; modules only call actions at runtime.
  const actions = {} as PageActions;
  const ctx: PageContext = {
    root, q, data, heroById,
    maxLevel: data.tuning.upgrades?.maxLevel ?? 4,
    bossFor: (map: any) => data.bosses?.[map?.boss ?? "baphomet"] ?? { name: "Baphomet" },
    blessingNames: data.tuning.virtueBlessings || {},
    store, state, pause,
    getSession: () => state.session,
    notice,
    actions,
  };

  // ------------------------------------------------------------------
  // Audio (one instance for the page lifetime)
  // ------------------------------------------------------------------
  const audio = createAudio();
  const muteButton = q<HTMLButtonElement>("[data-td-mute]");
  const volumeSlider = q<HTMLInputElement>("[data-td-volume]");
  function playEffect(effect: any) {
    if (effect.type === "place") audio.play("voice", effect.heroId);
    else if (effect.type === "hit") audio.play("attack", effect.heroId);
    else if (effect.type === "ult") { audio.play("attack", effect.heroId); audio.play("ultimate", effect.heroId); }
    else if (effect.type === "boss") hud.bossIntro();
    else if (effect.type === "awaken") audio.play("upgrade");
    else if (effect.type === "baseHit" && effect.damage > 0) audio.play("heavy");
  }
  volumeSlider.value = String(Math.round(audio.volume * 100));
  function syncAudioUi() {
    muteButton.textContent = audio.muted ? "Sound off" : "Sound on";
    muteButton.setAttribute("aria-pressed", String(audio.muted));
  }
  muteButton.addEventListener("click", () => { audio.toggleMute(); syncAudioUi(); });
  volumeSlider.addEventListener("input", () => { audio.setVolume(Number(volumeSlider.value) / 100); syncAudioUi(); });
  syncAudioUi();

  const music = createMusic();
  const musicMuteButton = q<HTMLButtonElement>("[data-td-music-mute]");
  const musicVolumeSlider = q<HTMLInputElement>("[data-td-music-volume]");
  musicVolumeSlider.value = String(Math.round(music.volume * 100));
  const syncMusicUi = () => {
    musicMuteButton.textContent = music.muted ? "Music off" : "Music on";
    musicMuteButton.setAttribute("aria-pressed", String(music.muted));
  };
  musicMuteButton.addEventListener("click", () => { music.toggleMute(); syncMusicUi(); });
  musicVolumeSlider.addEventListener("input", () => { music.setVolume(Number(musicVolumeSlider.value) / 100); syncMusicUi(); });
  syncMusicUi();

  // ------------------------------------------------------------------
  // Lobby
  // ------------------------------------------------------------------
  function renderLobby() {
    root!.querySelectorAll<HTMLButtonElement>("[data-map-id]").forEach((button) => {
      const active = button.dataset.mapId === state.selectedMap.id;
      button.classList.toggle("is-selected", active);
      button.setAttribute("aria-pressed", String(active));
    });
    root!.querySelectorAll<HTMLElement>("[data-map-best]").forEach((el) => {
      const top = store.data.mapTop[el.dataset.mapBest!];
      el.textContent = top ? `Best ${top.score.toLocaleString()} - wave ${top.wave}` : "No runs yet";
    });
    q("[data-td-best]").textContent = store.data.bestScore.toLocaleString();
    q("[data-td-perfect]").hidden = !store.data.perfectDefense;
    const boost = store.data.nextRunBoost;
    const boostEl = q("[data-td-next-boost]");
    boostEl.hidden = !boost;
    if (boost) boostEl.textContent = boost.type === "gold" ? `Next run: +${boost.gold} gold` : `Next run: ${ctx.blessingNames[boost.virtue] ?? boost.virtue}`;
    q("[data-td-favor-count]").textContent = `(${availableFavor(store.data)})`;
  }

  q("[data-td-maps]").addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-map-id]");
    const map = button && maps.find((entry) => entry.id === button.dataset.mapId);
    if (!map) return;
    state.selectedMap = map;
    try { localStorage.setItem("td:map", map.id); } catch {}
    renderLobby();
  });
  // Run length step: Play opens it for the selected map; picking a length starts the run.
  function renderTiers() {
    root!.querySelectorAll<HTMLButtonElement>("[data-tier-id]").forEach((button) => {
      const on = button.dataset.tierId === state.selectedTier;
      button.setAttribute("aria-checked", String(on));
      button.tabIndex = on ? 0 : -1;
    });
  }
  function renderModeBests() {
    const map = state.selectedMap;
    root!.querySelectorAll<HTMLButtonElement>("[data-mode-id]").forEach((button) => {
      const mode = button.dataset.modeId as RunMode;
      const top = store.data.mapTop[runKey(map.id, mode, state.selectedTier)];
      button.querySelector<HTMLElement>("[data-mode-best]")!.textContent = top ? `Best ${top.score.toLocaleString()} - wave ${top.wave}` : "No runs yet";
    });
  }
  q("[data-td-tiers]").addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-tier-id]");
    if (!button || !isRunTier(button.dataset.tierId)) return;
    state.selectedTier = button.dataset.tierId;
    try { localStorage.setItem("td:tier", state.selectedTier); } catch {}
    renderTiers();
    renderModeBests();
  });
  // Radio group keys: arrows move and select.
  q("[data-td-tiers]").addEventListener("keydown", (event) => {
    if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) return;
    event.preventDefault();
    const index = RUN_TIERS.indexOf(state.selectedTier);
    const next = RUN_TIERS[(index + (event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : RUN_TIERS.length - 1)) % RUN_TIERS.length];
    state.selectedTier = next;
    try { localStorage.setItem("td:tier", next); } catch {}
    renderTiers();
    renderModeBests();
    root!.querySelector<HTMLButtonElement>(`[data-tier-id="${next}"]`)?.focus();
  });
  function openModePicker(opener: HTMLElement) {
    const map = state.selectedMap;
    q("[data-td-mode-map]").textContent = `${map.name} - Boss: ${ctx.bossFor(map).name}`;
    renderTiers();
    let last: HTMLButtonElement | null = null;
    root!.querySelectorAll<HTMLButtonElement>("[data-mode-id]").forEach((button) => {
      const mode = button.dataset.modeId as RunMode;
      const isLast = mode === state.selectedMode;
      button.classList.toggle("is-selected", isLast);
      if (isLast) last = button;
    });
    renderModeBests();
    actions.openPanel("mode", opener);
    (last as HTMLButtonElement | null)?.focus({ preventScroll: true });
  }
  q("[data-td-modes]").addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-mode-id]");
    if (!button || !isRunMode(button.dataset.modeId)) return;
    state.selectedMode = button.dataset.modeId as RunMode;
    try { localStorage.setItem("td:mode", state.selectedMode); } catch {}
    actions.closePanel(false);
    actions.startSession(state.selectedMap);
  });
  q("[data-td-play-start]").addEventListener("click", (event) => { openModePicker(event.currentTarget as HTMLElement); });

  // ------------------------------------------------------------------
  // Page modules
  // ------------------------------------------------------------------
  const savePanel = createSavePanel(ctx);
  const buffBar = createBuffBar(ctx);
  const runOffer = createRunOffer(ctx);
  const results = createResults(ctx);
  const debugPanel = createDebugPanel(ctx);
  const hud = createHud(ctx);
  const popover = createPopover(ctx);
  const recruit = createRecruit(ctx);
  const panels = createPanels(ctx, { renderSavePanel: savePanel.render });
  const controller = createSessionController(ctx, { music, speed: hud.speed, hudTick: hud.tick, buffBar, runOffer, results, debugPanel, popover, recruit });

  Object.assign(actions, {
    startSession: controller.start,
    toLobby: controller.toLobby,
    handleChange: controller.handleChange,
    spaceBelowMap: controller.spaceBelowMap,
    updateHud: hud.update,
    syncMainAction: hud.syncMainAction,
    renderPreview: hud.renderPreview,
    playSound: (kind: string) => audio.play(kind),
    questName: hud.questName,
    renderDeck: hud.renderDeck,
    cancelDeploy: hud.cancelDeploy,
    syncPauseButton: hud.syncPauseButton,
    selectUnit: popover.select,
    closePopover: popover.close,
    refreshSelection: popover.refresh,
    positionPopover: popover.position,
    closeSheet: recruit.close,
    updateSheet: recruit.update,
    bindCanvas: recruit.bindCanvas,
    openPanel: panels.open,
    closePanel: panels.close,
    activePanel: panels.active,
    selectBlessingsTab: panels.selectTab,
    renderRunTab: panels.renderRunTab,
    syncSpendButton: panels.syncSpendButton,
    renderLobby,
    syncAudioUi,
    playEffect,
  } satisfies PageActions);

  controller.run();
</script>
