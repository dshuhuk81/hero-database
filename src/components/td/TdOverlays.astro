---
// Stage overlays: hero panel, recruit sheet, blessing offer and results.
// The default slot sits between the popover and the sheet (debug panel position).
---

<!-- Hero panel (M22): full-height side panel or a sheet below the map, laid out by popover.ts. -->
<aside class="td-popover" data-td-popover role="dialog" aria-labelledby="td-popover-name" hidden>
  <div class="td-popover-head">
    <div class="td-popover-title">
      <span class="td-pop-portrait">
        <img data-pop-portrait alt="" width="52" height="52" decoding="async">
        <span class="td-pop-class" data-pop-class-icon aria-hidden="true"></span>
      </span>
      <div class="td-popover-title-text">
        <strong id="td-popover-name" data-pop-name></strong>
        <span data-pop-level></span>
        <span class="td-pop-badges" data-pop-badges hidden></span>
      </div>
    </div>
    <button class="td-icon-button td-icon-button--small" type="button" data-pop-close aria-label="Close hero actions">
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <div class="td-popover-body">
    <section class="td-pop-section" aria-label="Health and stats">
      <div class="td-popover-hp">
        <progress class="td-hp" data-pop-hp-bar max="1" value="1"></progress>
        <small data-pop-hp></small>
      </div>
      <dl class="td-pop-stats">
        <div><dt>Attack</dt><dd data-pop-atk></dd></div>
        <div><dt>Speed</dt><dd data-pop-aps></dd></div>
        <div><dt data-pop-range-label>Range</dt><dd data-pop-range></dd></div>
        <div><dt>Crit</dt><dd data-pop-crit></dd></div>
      </dl>
    </section>
    <!-- Target priority: class rule by default; overrides stay folded away (audit, September 2026). -->
    <details class="td-pop-section td-pop-target" data-pop-target-box>
    <summary class="td-pop-target-head"><span>Target</span><strong data-pop-target-label></strong><svg class="td-pop-target-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg></summary>
    <div class="td-pop-target-row" data-pop-target role="group" aria-label="Target priority">
      <button type="button" data-target="auto"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="1.5" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4" /></svg><span>Class rule</span></button>
      <button type="button" data-target="first"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6l6 6-6 6M11 6l6 6-6 6M20 5v14" /></svg><span>First enemy</span></button>
      <button type="button" data-target="last"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 6l-6 6 6 6M13 6l-6 6 6 6M4 5v14" /></svg><span>Last enemy</span></button>
      <button type="button" data-target="strongest"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0112 7.3 4.3 4.3 0 0119.5 10c0 5.4-7.5 10-7.5 10z" /><path d="M12 10v6M9 13h6" /></svg><span>Highest health</span></button>
      <button type="button" data-target="weakest"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0112 7.3 4.3 4.3 0 0119.5 10c0 5.4-7.5 10-7.5 10z" /><path d="M12 8l-2 4 3 2-1 3" /></svg><span>Lowest health</span></button>
      <button type="button" data-target="fastest"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 8h8M2 12h10M3 16h8M14 6l6 6-6 6" /></svg><span>Fastest enemy</span></button>
      <button type="button" data-target="ground"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 19h18M5 19l4-7 3 4 3-5 4 8" /></svg><span>Ground first</span></button>
      <button type="button" data-target="flying"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 8c3.5 0 6.5 2 9 6 2.5-4 5.5-6 9-6" /><path d="M9 19h6" /></svg><span>Flyers first</span></button>
      <button type="button" data-target="boss"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 18h16M4 18L3 8l5 4 4-6 4 6 5-4-1 10" /></svg><span>Boss first</span></button>
    </div>
    </details>
    <!-- Details starts collapsed on every selection. -->
    <section class="td-pop-section">
      <button class="td-pop-details-toggle" type="button" data-pop-details aria-expanded="false" aria-controls="td-pop-details">
        <span>Details</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
      </button>
      <div class="td-pop-details" id="td-pop-details" data-pop-details-body hidden></div>
    </section>
  </div>
  <!-- Pinned footer (R4): permanent progress from the collection, then Relocate and Sell.
       Relocation moves a placed hero for free, with a short cooldown per hero. -->
  <div class="td-pop-actions">
    <p class="td-pop-progress td-pop-action-row" data-pop-progress></p>
    <p class="td-pop-preview td-pop-action-row" data-pop-preview></p>
    <button class="action-button action-button--primary td-pop-relocate" type="button" data-pop-relocate>
      <span>Relocate</span>
      <span class="td-pop-cost" data-pop-relocate-cost></span>
    </button>
    <button class="action-button action-button--quiet" type="button" data-pop-sell>Sell</button>
  </div>
</aside>

<slot />

<div class="td-sheet" data-td-sheet role="dialog" aria-labelledby="td-sheet-title" tabindex="-1" hidden>
  <div class="td-sheet-head">
    <div>
      <span class="td-label" data-td-sheet-kicker>Road tile</span>
      <strong id="td-sheet-title">Recruit a hero</strong>
    </div>
    <button class="td-icon-button td-icon-button--small" type="button" data-td-sheet-close aria-label="Close recruitment">
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <div class="td-sheet-inspect" data-td-sheet-preview hidden>
    <div class="td-sheet-preview">
      <div class="td-anim" data-td-anim></div>
      <div class="td-sheet-preview-copy">
        <strong data-td-preview-name></strong>
        <small data-td-preview-sub></small>
        <small class="td-sheet-preview-role" data-td-preview-role></small>
      </div>
    </div>
    <p class="td-inspect-facts" data-td-preview-facts></p>
    <p class="td-sheet-preview-ult" data-td-preview-ult></p>
    <details class="td-inspect-details" data-td-preview-details>
      <summary>Details</summary>
      <div data-td-preview-details-body></div>
    </details>
  </div>
  <p class="td-sheet-note" data-td-sheet-note></p>
  <div class="td-sheet-list" data-td-sheet-list aria-label="Heroes"></div>
  <div class="td-sheet-foot">
    <small class="td-inspect-reason" data-td-preview-reason aria-live="polite"></small>
    <button class="action-button action-button--primary td-inspect-deploy" type="button" data-td-deploy-selected>Deploy</button>
  </div>
</div>

<div class="td-blessing-modal" data-td-blessing-modal role="dialog" aria-labelledby="td-blessing-title" hidden>
  <div class="td-blessing-modal-inner">
    <h2 class="td-boon-title" id="td-blessing-title">Choose a blessing</h2>
    <p class="td-blessing-modal-note">Lasts for this run. The stage waits while you choose.</p>
    <div class="td-boon-row" data-td-blessing-grid></div>
    <div class="td-mutator-skip"><button type="button" class="action-button action-button--quiet" data-td-blessing-skip>Skip this offer</button></div>
  </div>
</div>

<!-- Results: a won stage plays Victory, Hero contribution and Rewards (data-view="clear").
     A loss plays Defeat, then blends to its advice/statistics page (data-view="loss"). The
     footer actions are shared by the final views. Sequences are controlled by stage-clear.ts. -->
<div class="td-result" data-td-result data-view="report" role="dialog" aria-modal="true" aria-labelledby="td-result-title" tabindex="-1" hidden>
  <div class="td-clear" data-td-clear aria-live="polite">
    <section class="td-clear-scene td-clear-rewards" data-clear-scene="rewards" aria-labelledby="td-clear-rewards-title">
      <div class="td-clear-panel">
        <div class="td-clear-head">
          <div>
            <span class="td-label" data-clear-rewards-kicker>Victory</span>
            <h2 id="td-clear-rewards-title">Rewards received</h2>
          </div>
          <span class="td-clear-chip">Clear reward</span>
        </div>
        <div class="td-clear-reward-list" data-clear-rewards></div>
        <p class="td-clear-note" data-clear-note hidden></p>
      </div>
    </section>

    <section class="td-clear-scene td-clear-victory" data-clear-scene="victory" aria-labelledby="td-clear-victory-title">
      <div class="td-clear-outcome">
        <div class="td-clear-kicker"><span class="td-clear-kicker-mark" aria-hidden="true">✦</span> Victory</div>
        <h2 id="td-clear-victory-title" data-clear-title>Stage secured</h2>
        <p class="td-clear-context" data-clear-context></p>
        <div class="td-clear-score-row">
          <div class="td-clear-score">
            <span>Final score</span>
            <strong data-clear-score>0</strong>
            <small data-clear-best hidden>New personal best</small>
          </div>
          <dl class="td-clear-facts" aria-label="Run outcome">
            <div><dt>Lives left</dt><dd data-clear-lives>0</dd></div>
            <div><dt>Leaks</dt><dd data-clear-leaks>0</dd></div>
            <div><dt>Duration</dt><dd data-clear-duration>0s</dd></div>
          </dl>
        </div>
        <div class="td-clear-laurels" data-clear-laurels role="img"></div>
      </div>
      <div class="td-clear-mvp" data-clear-mvp hidden>
        <div class="td-clear-mvp-glow" aria-hidden="true"></div>
        <img data-clear-mvp-art alt="" decoding="async" />
        <div class="td-clear-mvp-copy">
          <span>MVP</span>
          <strong data-clear-mvp-name></strong>
          <small data-clear-mvp-stats></small>
        </div>
      </div>
    </section>

    <section class="td-clear-scene td-clear-performance" data-clear-scene="performance" aria-labelledby="td-clear-performance-title">
      <div class="td-clear-panel">
        <div class="td-clear-head">
          <div>
            <span class="td-label" data-clear-performance-kicker>Victory</span>
            <h2 id="td-clear-performance-title">Hero contribution</h2>
          </div>
          <span class="td-clear-total" data-clear-total></span>
        </div>
        <div class="td-clear-legend" aria-hidden="true"><span>Hero</span><span>Damage</span><span>Boss</span><span>Kills</span></div>
        <ol class="td-clear-rankings" data-clear-rankings></ol>
        <p class="td-clear-note" data-clear-rankings-empty hidden>No hero dealt damage this run.</p>
      </div>
    </section>
  </div>

  <section class="td-defeat" aria-labelledby="td-defeat-title">
    <div class="td-defeat-emblem" aria-hidden="true"><span></span></div>
    <span class="td-defeat-kicker">Defense broken</span>
    <h2 id="td-defeat-title">Defeat</h2>
    <p class="td-defeat-map" data-td-defeat-map>Stage fell</p>
    <p class="td-defeat-context" data-td-defeat-context></p>
  </section>

  <section class="td-loss" aria-labelledby="td-loss-title">
    <div class="td-loss-panel td-loss-advice" data-td-loss-panel="advice">
      <header class="td-loss-head">
        <span class="td-loss-kicker">Defense broken</span>
        <h2 id="td-loss-title">Defeat</h2>
        <p>Develop your heroes regularly to make your team stronger.</p>
      </header>
      <div class="td-loss-recommendations">
        <article class="td-loss-recommendation">
          <div class="td-loss-recommendation-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M14 6h20M14 42h20M16 7c0 9 16 9 16 17s-16 8-16 17M32 7c0 9-16 9-16 17s16 8 16 17" /></svg>
          </div>
          <div class="td-loss-recommendation-copy">
            <h3>Run Daily Trials</h3>
            <p>Earn rewards.</p>
          </div>
          <button class="action-button action-button--primary" type="button" data-td-to-lobby="daily">Go</button>
        </article>
        <article class="td-loss-recommendation">
          <div class="td-loss-recommendation-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M16 36V18l8-8 8 8v18M11 39h26M20 25h8M24 25V14" /></svg>
          </div>
          <div class="td-loss-recommendation-copy">
            <h3>Strengthen your heroes</h3>
            <p>This will help improve them dramatically.</p>
          </div>
          <button class="action-button action-button--primary" type="button" data-td-to-lobby="heroes">Go</button>
        </article>
      </div>
    </div>
    <div class="td-loss-panel td-loss-stat-screen" id="td-loss-stats" data-td-loss-panel="stats">
      <header class="td-loss-stats-head">
        <span class="td-loss-kicker">Battle report</span>
        <h2 id="td-loss-stats-title">Run statistics</h2>
        <p>Review the run, strengthen your company, and try again.</p>
      </header>
      <div class="td-result-stats td-loss-stats" data-td-loss-stats></div>
    </div>
  </section>

  <div class="td-result-inner">
    <header class="td-result-head">
      <span class="td-result-kicker" data-td-result-kicker>Run complete</span>
      <strong class="td-result-title" id="td-result-title" data-td-result-title>Battlefield secured</strong>
      <p class="td-result-meta" data-td-result-meta></p>
      <p class="td-result-score"><strong data-td-result-score></strong> <span data-td-result-copy></span></p>
      <p class="td-result-daily" data-td-result-daily hidden></p>
    </header>
    <div class="td-result-tabs" role="tablist" aria-label="Run result">
      <button class="td-result-tab" type="button" role="tab" id="td-result-tab-summary" aria-controls="td-result-summary" aria-selected="true" data-td-result-tab="summary">Summary</button>
      <button class="td-result-tab" type="button" role="tab" id="td-result-tab-battle" aria-controls="td-result-battle" aria-selected="false" tabindex="-1" data-td-result-tab="battle">Battle</button>
    </div>
    <div class="td-result-body">
      <section class="td-result-panel is-active" id="td-result-summary" role="tabpanel" aria-labelledby="td-result-tab-summary" data-td-result-panel="summary">
        <h3 class="td-result-section-title">Rewards</h3>
        <div class="td-result-favor" data-td-result-favor hidden></div>
        <div class="td-result-shards" data-td-result-shards hidden></div>
        <div class="td-result-achievements" data-td-result-achievements hidden></div>
        <p class="td-result-compare" data-td-result-compare hidden></p>
        <h3 class="td-result-section-title">Run</h3>
        <div class="td-result-stats" data-td-result-stats hidden></div>
      </section>
      <section class="td-result-panel" id="td-result-battle" role="tabpanel" aria-labelledby="td-result-tab-battle" data-td-result-panel="battle">
        <h3 class="td-result-section-title">Battle</h3>
        <div class="td-result-analysis" data-td-result-analysis hidden></div>
        <div class="td-result-damage" data-td-result-damage hidden></div>
        <p class="td-result-empty" data-td-result-battle-empty hidden>No hero dealt damage this run.</p>
      </section>
    </div>
  </div>

  <div class="td-result-actions">
    <button class="action-button action-button--quiet td-loss-nav-action" type="button" data-loss-action data-td-loss-stats-toggle aria-controls="td-loss-stats" aria-pressed="false"><span class="td-loss-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 19V11M12 19V5M19 19v-9M3 21h18" /></svg></span><span>Stats</span></button>
    <button class="action-button action-button--quiet td-loss-nav-action" type="button" data-loss-action data-td-to-lobby="heroes"><span class="td-loss-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 5 7v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V7l-7-4Zm-3 9h6M12 9v6" /></svg></span><span>Heroes</span></button>
    <button class="action-button action-button--quiet td-loss-nav-action td-loss-camp" type="button" data-loss-action data-td-to-lobby="home"><span class="td-loss-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8M5 10v10h14V10M9 20v-6h6v6" /></svg></span><span>Camp</span></button>
    <button class="action-button action-button--quiet td-loss-retry" type="button" data-loss-action data-td-loss-retry data-td-retry>Try Again</button>
    <button class="action-button action-button--primary" type="button" data-loss-action data-td-loss-close data-td-to-lobby="stages">Close</button>
    <button class="action-button action-button--quiet td-result-menu" type="button" data-td-to-lobby="home" data-td-result-menu>Back to Camp</button>
    <button class="action-button action-button--quiet" type="button" data-td-result-stats-toggle aria-pressed="false" hidden>Stats</button>
    <button class="action-button action-button--quiet td-spend-button" type="button" data-td-open="blessings" data-td-spend>Spend Favor <span class="td-favor-count" data-td-spend-count></span></button>
    <button class="action-button action-button--primary" type="button" data-td-to-lobby="expedition" data-td-result-continue hidden>Continue</button>
    <button class="action-button action-button--primary" type="button" data-td-result-retry data-td-retry>Retry</button>
  </div>
</div>
