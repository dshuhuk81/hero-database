---
// Stage overlays: hero popover, recruit sheet, blessing offer and results.
// The default slot sits between the popover and the sheet (debug panel position).
---

<div class="td-popover" data-td-popover role="dialog" aria-labelledby="td-popover-name" hidden>
  <div class="td-popover-head">
    <div class="td-popover-title">
      <strong id="td-popover-name" data-pop-name></strong>
      <span data-pop-level></span>
    </div>
    <button class="td-icon-button td-icon-button--small" type="button" data-pop-close aria-label="Close hero actions">
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <div class="td-popover-hp">
    <progress class="td-hp" data-pop-hp-bar max="1" value="1"></progress>
    <small data-pop-hp></small>
  </div>
  <dl class="td-pop-stats">
    <div><dt>Attack</dt><dd data-pop-atk></dd></div>
    <div><dt>Speed</dt><dd data-pop-aps></dd></div>
    <div><dt>Range</dt><dd data-pop-range></dd></div>
    <div><dt>Crit</dt><dd data-pop-crit></dd></div>
  </dl>
  <button class="action-button action-button--primary td-pop-upgrade" type="button" data-pop-upgrade aria-controls="td-pop-focus">
    <span data-pop-upgrade-label>Upgrade</span>
    <span class="td-pop-cost" data-pop-cost></span>
  </button>
  <div class="td-pop-focus" id="td-pop-focus" data-pop-focus role="group" aria-label="Choose a focus" hidden>
    <button class="td-pop-focus-option" type="button" data-focus="attack"><strong>Attack <span data-focus-bonus="attack"></span></strong><small data-focus-text="attack"></small></button>
    <button class="td-pop-focus-option" type="button" data-focus="health"><strong>Health <span data-focus-bonus="health"></span></strong><small data-focus-text="health"></small></button>
    <button class="td-pop-focus-option" type="button" data-focus="range"><strong>Range <span data-focus-bonus="range"></span></strong><small data-focus-text="range"></small></button>
  </div>
  <p class="td-pop-preview" data-pop-preview></p>
  <div class="td-pop-actions">
    <button class="action-button action-button--quiet" type="button" data-pop-rotate>Rotate</button>
    <button class="action-button action-button--quiet" type="button" data-pop-details aria-expanded="false" aria-controls="td-pop-details">Details</button>
    <button class="action-button action-button--quiet" type="button" data-pop-sell>Sell</button>
  </div>
  <div class="td-pop-details" id="td-pop-details" data-pop-details-body hidden></div>
</div>

<slot />

<div class="td-sheet" data-td-sheet role="dialog" aria-labelledby="td-sheet-title" tabindex="-1" hidden>
  <div class="td-sheet-head">
    <div>
      <span class="td-label" data-td-sheet-kicker>Road ring 1</span>
      <strong id="td-sheet-title">Recruit a hero</strong>
    </div>
    <button class="td-icon-button td-icon-button--small" type="button" data-td-sheet-close aria-label="Close recruitment">
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <div class="td-sheet-preview" data-td-sheet-preview aria-hidden="true" hidden>
    <div class="td-anim" data-td-anim></div>
    <div class="td-sheet-preview-copy">
      <strong data-td-preview-name></strong>
      <small data-td-preview-sub></small>
      <small class="td-sheet-preview-ult" data-td-preview-ult></small>
    </div>
  </div>
  <p class="td-sheet-note" data-td-sheet-note></p>
  <div class="td-sheet-list" data-td-sheet-list></div>
</div>

<div class="td-blessing-modal" data-td-blessing-modal role="dialog" aria-labelledby="td-blessing-title" hidden>
  <div class="td-blessing-modal-inner">
    <h2 class="td-boon-title" id="td-blessing-title">Choose a blessing</h2>
    <p class="td-blessing-modal-note">Lasts for this run. Starting the next wave without choosing forfeits the offer.</p>
    <div class="td-boon-row" data-td-blessing-grid></div>
  </div>
</div>

<div class="td-result" data-td-result role="dialog" aria-modal="true" aria-labelledby="td-result-title" hidden>
  <div class="td-result-inner">
    <span data-td-result-kicker>Run complete</span>
    <strong id="td-result-title" data-td-result-title>Battlefield secured</strong>
    <p data-td-result-copy></p>
    <div class="td-result-stats" data-td-result-stats hidden></div>
    <p class="td-result-compare" data-td-result-compare hidden></p>
    <div class="td-result-achievements" data-td-result-achievements hidden></div>
    <p class="td-result-favor" data-td-result-favor hidden></p>
    <div class="td-result-shards" data-td-result-shards hidden></div>
    <div class="td-result-actions">
      <button class="action-button action-button--primary" type="button" data-td-retry>Retry</button>
      <button class="action-button action-button--quiet td-spend-button" type="button" data-td-open="blessings" data-td-spend>Spend Favor <span class="td-favor-count" data-td-spend-count></span></button>
      <button class="action-button action-button--quiet" type="button" data-td-to-lobby>Choose map</button>
    </div>
  </div>
</div>
