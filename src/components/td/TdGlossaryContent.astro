---
// Tower Defense glossary content: tabs (Heroes / Enemies) with every hero, enemy,
// class, status effect and boss. No page title, back link or disclaimer; those
// belong to the wrapper (TdGlossary.astro for the standalone page, a Glossary
// screen in the game shell). Static; numbers come from the same data the game
// runs on (gameBalance + tuning, tdCampaign timelines, tdMaps, bosses, skills.js).
//
// Props:
//   assetBase     R2 base URL, no trailing slash (class icons, enemy sprites).
//   embedded      false (default): standalone page, tabs sync with #heroes / #enemies
//                 in the URL. true: mounted inside another page; no hash reading or
//                 writing, all ids prefixed "tdg-", tab bar sticky at the top of the
//                 nearest scroll container (the shell gives it height + overflow:auto).
//   headingLevel  Level of the section headings (default 2). Card names use +1,
//                 skill names +2, so under a screen title with an h1 keep 2.
//
// Several instances on one page are fine: the script scopes to each [data-td-glossary] root.
import rawHeroes from "../../data/gameBalance.json";
import rawTuning from "../../data/gameBalance.tuning.json";
import { skinHeroes, skinTuning } from "../../game/td/skin.js";
import maps from "../../data/tdMaps.json";
import bosses from "../../data/bosses.json";
import tdBosses from "../../data/tdBosses.json";
import campaign from "../../data/tdCampaign.json";
import { CLASS_ROLES } from "../../game/td/ui.js";
import { patternLabel } from "../../game/td/board.js";
import { SKILL_TEXT, AWAKEN_TEXT, CLASS_ULT_TEXT, ENEMY_INFO, STATUS_INFO, REACTION_INFO, BOSS_RULES } from "../../game/td/skills.js";
import { ENEMY_ART, bossSpriteFile, classGlyph, enemySpriteVersion } from "../../game/td/assets.js";
import EnemyCard from "./TdEnemyCard.astro";

interface Props { assetBase: string; embedded?: boolean; headingLevel?: 2 | 3 | 4; }
const { assetBase, embedded = false, headingLevel = 2 } = Astro.props;
// Hero skin (M24): the game's own names, portraits and ultimate names.
const heroes = skinHeroes(rawHeroes as any[], assetBase);
const tuning = skinTuning(rawTuning);

// Ids: the standalone page keeps its public anchors (#heroes, #enemies, #hero-<id>);
// embedded, everything is prefixed so nothing clashes with the host page.
const pid = embedded ? "tdg-" : "";
const id = (name: string) => `tdg-${name}`;
const Section = `h${headingLevel}` as "h2";
const Title = `h${headingLevel + 1}` as "h3";
const SkillTitle = `h${headingLevel + 2}` as "h4";

const t: any = tuning;
const K = 260; // armor constant in sim.js mitigation()
const reduction = (value: number) => Math.round((value / (value + K)) * 100);
const pct = (value: number) => `${Math.round(value * 100)}%`;
const enemySprite = (file: string, version = enemySpriteVersion(file)) => `${assetBase}/td/enemies/sprites/${file}-${version}.webp`;
const tagLabel = (tag: string) => tag.toLowerCase().replace(/_/g, " ").replace(/^\w/, (c) => c.toUpperCase());

// Material Symbols (Rounded), loaded as a subset: only the icons named here. Every icon the
// glossary shows must come from these maps so the subset URL stays complete.
const STAT_ICON: Record<string, string> = {
  "Health": "favorite", "Attack": "swords", "Attacks / s": "speed", "Reach": "radar",
  "Armor": "shield", "Magic res": "shield_moon", "Crit": "crisis_alert",
  "Ult charge": "hourglass_top", "Ult power": "bolt", "Speed": "directions_run",
  "Attack range": "radar", "Shield": "security", "Lives lost": "heart_broken", "Gold": "paid",
};
const STATUS_ICON: Record<string, string> = { wet: "water_drop", burn: "local_fire_department", poison: "science", chill: "ac_unit" };
const REACTION_ICON: Record<string, string> = { conduct: "electric_bolt", steam: "cloud", blight: "coronavirus", freeze: "severe_cold", harvest: "cyclone" };
const UI_ICON = {
  heroes: "groups", enemies: "skull", attributes: "menu_book", classes: "category", status: "science",
  reactions: "join", bosses: "crown", ultimate: "bolt", awakened: "auto_awesome", synergy: "hub",
  first: "flag", note: "info", cost: "paid",
};

const CLASS_ORDER = ["Tank", "Warrior", "Assassin", "Mage", "Archer", "Support"];
const classes = CLASS_ORDER.map((name) => {
  const kit = t.classes[name];
  return {
    name,
    slot: kit.slot === "road" ? "Road" : "Platform",
    role: (CLASS_ROLES as Record<string, string>)[name],
    block: t.blocking?.blockLimit?.[name],
  };
});

// Status effects (M13): which heroes apply each status (tuning.statuses.sources).
const heroName = new Map((heroes as any[]).map((hero) => [hero.id, hero.name]));
const statusCards = Object.entries(STATUS_INFO).map(([id, info]) => ({
  ...info,
  id,
  sources: [...Object.entries(t.statuses?.sources ?? {}).filter(([, kind]) => kind === id).map(([hero]) => heroName.get(hero) ?? hero), "class Infusion blessings"].join(", "),
}));
const reactionCards = Object.entries(REACTION_INFO).map(([id, info]) => ({ ...info, id }));

const heroCards = [...(heroes as any[])]
  .sort((a, b) => CLASS_ORDER.indexOf(a.class) - CLASS_ORDER.indexOf(b.class) || a.name.localeCompare(b.name))
  .map((hero) => {
    const skill = t.heroSkills?.[hero.id] ?? {};
    return {
      ...hero,
      slotLabel: hero.slot === "road" ? "Road" : "Platform",
      damageLabel: hero.damageType === "magical" ? "Magic" : "Physical",
      skillName: skill.skillName ?? "Ultimate",
      skillText: SKILL_TEXT[skill.variant] ?? "",
      awakenText: AWAKEN_TEXT[skill.variant] ?? "",
      classUltText: CLASS_ULT_TEXT[hero.class] ?? "",
      status: t.statuses?.sources?.[hero.id] ? STATUS_INFO[t.statuses.sources[hero.id]]?.name : null,
      stats: [
        ["Health", hero.hp],
        ["Attack", hero.atk],
        ["Attacks / s", hero.aps],
        ["Reach", patternLabel((rawTuning as any).board?.heroPatterns?.[hero.id] ?? (rawTuning as any).board?.patterns?.[hero.class])],
        ["Armor", hero.armor],
        ["Magic res", hero.magicRes],
        ["Crit", pct(hero.critChance)],
        ["Ult charge", `${hero.ultCooldown}s`],
        ["Ult power", `x${hero.ultPower}`],
      ].map(([label, value]) => [label, value, STAT_ICON[label as string]]) as [string, string | number, string][],
    };
  });

// Enemies: base health (difficulty applied in sim.js spawnEnemy).
const hpScale = t.difficulty?.enemyHp ?? 1;
const firstStage = (kind: string) => (campaign as any).chapters.flatMap((chapter: any) => chapter.stages).find((stage: any) => stage.timeline.some((group: any) => group.kind === kind))?.id;
const bossById = new Map([...(bosses as any).bosses, ...tdBosses.bosses].map((boss: any) => [boss.id, boss]));
const stageBossIds = (campaign as any).chapters.flatMap((chapter: any) => chapter.stages.map((stage: any) => stage.boss).filter(Boolean));
const bossMaps = (id: string) => [...new Set([
  ...(maps as any[]).filter((map) => !map.campaignOnly && (map.boss ?? "baphomet") === id).map((map) => map.name),
  ...(campaign as any).chapters.flatMap((chapter: any) => chapter.stages.filter((stage: any) => stage.boss === id).map((stage: any) => stage.name)),
])];

// Stage enemies on boards are converted (tuning.board.enemyShape: fewer, stronger enemies);
// bosses and summoned enemies are not. Cards show the converted values.
const SHAPE = (rawTuning as any).board?.enemyShape ?? {};
const shapeFor = (kind: string) => {
  const cfg = { ...SHAPE, ...(SHAPE.kinds?.[kind] ?? {}) };
  const power = cfg.power ?? 1;
  return { hp: cfg.hp ?? power, attack: cfg.attack ?? power, reward: cfg.reward ?? power };
};
function enemyCard(kind: string, overrides: any = {}) {
  const unshaped = !SHAPE.enabled || ["boss", "imp", "brood"].includes(kind);
  const shape = unshaped ? { hp: 1, attack: 1, reward: 1 } : shapeFor(kind);
  const raw = { ...t.enemies[kind], ...(overrides.stats ?? {}) };
  const base = { ...raw, hp: raw.hp * shape.hp, attack: raw.attack ? Math.round(raw.attack * shape.attack) : raw.attack, reward: Math.round(raw.reward * shape.reward) };
  const magicRes = base.magicRes ?? base.armor * 0.8;
  const stageId = overrides.stage ?? firstStage(kind);
  return {
    kind,
    name: overrides.name ?? ENEMY_INFO[kind].name,
    text: overrides.text ?? ENEMY_INFO[kind].text,
    image: overrides.image ?? (ENEMY_ART[kind] ? enemySprite(ENEMY_ART[kind].file, ENEMY_ART[kind].version) : enemySprite(kind)),
    meta: overrides.meta ?? (stageId ? `First seen in stage ${stageId}` : ""),
    tags: [base.flying ? "Flying" : "Ground", base.attackRange ? "Ranged" : base.attack ? "Melee" : "Does not attack"],
    stats: [
      ["Health", Math.round(base.hp * hpScale)],
      ["Speed", base.speed],
      ["Armor", `${base.armor} (-${reduction(base.armor)}%)`],
      ["Magic res", `${Math.round(magicRes)} (-${reduction(magicRes)}%)`],
      ["Attack", base.attack ? `${base.attack} / ${base.attackPeriod}s` : "-"],
      ...(base.attackRange ? [["Attack range", base.attackRange]] : []),
      ...(base.shield ? [["Shield", Math.round(base.hp * hpScale * base.shield.hp)]] : []),
      // Shown lives (board.js shownLives): stage enemies are converted so a leak costs their
      // damage in shown lives; bosses and summoned enemies are not, so they cost a fraction.
      ["Lives lost", unshaped ? +(base.damage / ((rawTuning as any).board?.lifeUnit ?? 1)).toFixed(1) : base.damage],
    ],
  };
}

// Enemy stat rows carry their icon too (TdEnemyCard renders it).
const withIcons = (card: any) => ({ ...card, stats: card.stats.map(([label, value]: any[]) => [label, value, STAT_ICON[label]]) });

const enemyCards = ["grunt", "runner", "flyer", "archer", "brute", "mender", "shieldbearer", "hexer", "broodcaller"].map((kind) => enemyCard(kind));
{
  const caller = enemyCards.findIndex((card) => card.kind === "broodcaller");
  enemyCards.splice(caller + 1, 0, enemyCard("imp", { meta: "Summoned by the Broodcaller" }));
}
const bossCards = [...new Set([...(maps as any[]).map((map) => map.boss ?? "baphomet"), ...stageBossIds])].flatMap((id) => {
  const boss: any = bossById.get(id);
  const bossTuning = t.bosses?.[id];
  const summon = bossTuning?.summon;
  const cards = [enemyCard("boss", {
    name: boss?.name ?? id,
    stats: bossTuning?.stats,
    image: enemySprite(bossSpriteFile(id)),
    meta: `Final boss on ${bossMaps(id).join(" and ")}`,
    text: (summon
      ? `${ENEMY_INFO.boss.text} Summons ${summon.count} children around herself and cannot be hit while any of them stand.`
      : ENEMY_INFO.boss.text) + (BOSS_RULES[id] ? ` ${BOSS_RULES[id]}` : ""),
  })];
  if (summon) cards.push(enemyCard(summon.kind, { image: enemySprite(summon.kind), meta: `Summoned by ${boss?.name ?? id}` }));
  return cards;
});
const enemyCardsView = enemyCards.map(withIcons);
const bossCardsView = bossCards.map(withIcons);

const heroAttrs: [string, string, string][] = [
  ["add_road", "Road / Platform", "Where the hero stands. Road heroes (tiles on the road) block ground enemies and can fall. Platform heroes (tiles beside the road) are never attacked and are the only ones that reach flyers."],
  ["paid", "Placement cost", "Placement points needed to put the hero on the field. Selling returns all of it, so you can swap heroes freely."],
  ["favorite", "Health", "Damage a hero takes before it falls. A fallen hero can be recruited again."],
  ["swords", "Attack", "Damage per basic hit before the enemy's armor or magic resistance. Auras, synergy and blessings raise it."],
  ["speed", "Attacks / s", "Basic attacks per second."],
  ["radar", "Reach", "The tiles around its own tile that a hero's basic attack covers. Selecting or placing a hero lights them up green. High ground adds one step while the hero stands there; stars add steps outside battle. Range is never upgraded in battle."],
  ["auto_fix_high", "Damage type", "Physical damage is reduced by armor, magic damage by magic resistance. 260 points halve the damage."],
  ["shield", "Armor / Magic res", "Reduce physical and magic damage the hero takes. Enemies only deal physical damage."],
  ["crisis_alert", "Crit", "Chance for a basic hit to deal 1.5x damage."],
  ["hourglass_top", "Ult charge", "Seconds until the ultimate is ready. It fires on its own at the current target."],
  ["bolt", "Ult power", "Multiplier on ultimate damage. An ultimate hits for 250% of attack times this power, unless its text says otherwise."],
  ["hub", "Synergy tags", `Each tag shared with a hero within ${t.synergy?.range}px adds ${pct(t.synergy?.bonusPerTag ?? 0)} attack, up to ${pct(t.synergy?.cap ?? 0)}.`],
  ["auto_awesome", "Awakened ultimate", "Evolution V on the Heroes screen unlocks a stronger ultimate. Each hero card lists what changes."],
  ["military_tech", "Hero collection", "Heroes are unlocked in the Campaign and summoned with Divine Seals. Campaign stages, Free Play and Expeditions use only the heroes you own; the Daily Trial gives everyone the same squad. Level, Stars, Evolution and Skills from the Heroes screen apply in every mode; Free Play and Expeditions add Divine Blessings on top."],
  ["star", "Divine Blessings", "Apply in Free Play and Expeditions, not in Campaign stages or the Daily Trial."],
  ["bolt", "Divine Interventions", `Two powers in the bottom bar that charge during the stage (one point per second, one per kill). Thunderfall (after stage ${t.interventions?.thunderfall?.unlockAfter}): tap the map, a bolt strikes those tiles for ${pct(t.interventions?.thunderfall?.share ?? 0)} of every enemy's health (${pct(t.interventions?.thunderfall?.bossShare ?? 0)} for bosses). Shield (after stage ${t.interventions?.shield?.unlockAfter}): for ${t.interventions?.shield?.seconds}s leaks cost no lives, once per wave. Not in the Daily Trial.`],
  ["diversity_3", "Pantheon bonds", "Norse heroes on the field together: 2 give +6% attack, 4 give +12% attack and 10% faster ultimates. Greek heroes: 2 take 7% less damage, 4 take 13% less and heal 15% more. Each recruit counts for the pantheon with more heroes on the field."],
  ["savings", "Placement points", `Every battle starts with ${t.run?.startingPlacement ?? 0} placement points and gains ${t.run?.placementPerSecond ?? 1} per second of battle. Heroes cost placement points to deploy; gold is only used to level heroes.`],
];
const enemyAttrs: [string, string, string][] = [
  ["favorite", "Health", "Base health. Each stage scales it with its own health scale, and harder difficulties add more."],
  ["directions_run", "Speed", "Map pixels per second. Slows and blockers hold it back."],
  ["shield", "Armor / Magic res", "Reduce physical and magic damage taken; the percentage is how much. Archers pierce part of the armor."],
  ["swords", "Attack", "Damage per hit to the road hero holding it, and the time between hits."],
  ["flight", "Ground / Flying", "Ground enemies are stopped by road heroes. Flyers pass over them and can only be hit from platforms."],
  ["heart_broken", "Lives lost", "Lives you lose when it reaches your base."],
];
const iconNames = [...new Set([
  ...Object.values(STAT_ICON), ...Object.values(STATUS_ICON), ...Object.values(REACTION_ICON), ...Object.values(UI_ICON),
  ...heroAttrs.map(([icon]) => icon), ...enemyAttrs.map(([icon]) => icon),
])].sort();
const iconFont = `https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,500,0..1,0&icon_names=${iconNames.join(",")}&display=block`;
const reactionIds = Object.keys(REACTION_INFO);
// Section jump chips under the tabs (per panel).
const heroJumps = [["hero-attrs", "Attributes"], ["classes", "Classes"], ["status", "Status effects"], ["hero-list", "Heroes"]];
const enemyJumps = [["enemy-attrs", "Attributes"], ["enemy-list", "Enemies"], ["bosses", "Bosses"]];
---

<link rel="stylesheet" href={iconFont} />
<div class:list={["td-glossary-body", { "td-glossary-body--embedded": embedded }]} data-td-glossary data-hash={embedded ? undefined : "true"}>
  <div class="td-glossary-bar">
    <div class="td-tabs" role="tablist" aria-label="Glossary sections">
      <button class="td-tab" type="button" role="tab" id={id("tab-heroes")} aria-controls={`${pid}heroes`} aria-selected="true" data-glossary-tab="heroes"><span class="td-msym" aria-hidden="true">{UI_ICON.heroes}</span>Heroes</button>
      <button class="td-tab" type="button" role="tab" id={id("tab-enemies")} aria-controls={`${pid}enemies`} aria-selected="false" tabindex="-1" data-glossary-tab="enemies"><span class="td-msym" aria-hidden="true">{UI_ICON.enemies}</span>Enemies</button>
    </div>
    <nav class="td-glossary-jumps" aria-label="Jump to section" data-glossary-jumps="heroes">
      {heroJumps.map(([target, label]) => <a href={`#${id(target)}`} data-glossary-jump={id(target)}>{label}</a>)}
    </nav>
    <nav class="td-glossary-jumps" aria-label="Jump to section" data-glossary-jumps="enemies" hidden>
      {enemyJumps.map(([target, label]) => <a href={`#${id(target)}`} data-glossary-jump={id(target)}>{label}</a>)}
    </nav>
  </div>

  <div id={`${pid}heroes`} class="td-glossary-panel" role="tabpanel" aria-labelledby={id("tab-heroes")} data-glossary-panel="heroes">
    <section aria-labelledby={id("hero-attrs")}>
      <Section class="td-glossary-heading" id={id("hero-attrs")}><span class="td-msym" aria-hidden="true">{UI_ICON.attributes}</span>Attributes</Section>
      <dl class="td-glossary-terms">
        {heroAttrs.map(([icon, term, text]) => (
          <div><span class="td-msym td-glossary-term-icon" aria-hidden="true">{icon}</span><dt>{term}</dt><dd>{text}</dd></div>
        ))}
      </dl>
    </section>

    <section aria-labelledby={id("classes")}>
      <Section class="td-glossary-heading" id={id("classes")}><span class="td-msym" aria-hidden="true">{UI_ICON.classes}</span>Classes</Section>
      <div class="td-glossary-classes">
        {classes.map((cls) => (
          <article class="td-glossary-class">
            <header class="td-glossary-class-head">
              <span class="td-glossary-glyph"><Fragment set:html={classGlyph(cls.name, 28)} /></span>
              <div>
                <Title class="td-glossary-title">{cls.name}</Title>
                <p class="td-glossary-meta">{cls.slot}{cls.block ? ` - holds ${cls.block} ${cls.block === 1 ? "enemy" : "enemies"}` : ""}</p>
              </div>
            </header>
            <p>{cls.role}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby={id("status")}>
      <Section class="td-glossary-heading" id={id("status")}><span class="td-msym" aria-hidden="true">{UI_ICON.status}</span>Status effects</Section>
      <div class="td-glossary-effects">
        {statusCards.map((status) => (
          <article class={`td-glossary-effect td-glossary-effect--${status.id}`}>
            <span class="td-msym td-glossary-effect-icon" aria-hidden="true">{STATUS_ICON[status.id]}</span>
            <div>
              <Title class="td-glossary-title">{status.name}</Title>
              <p>{status.text}</p>
              <p class="td-glossary-meta">From: {status.sources}</p>
            </div>
          </article>
        ))}
      </div>
      <Title class="td-glossary-subhead"><span class="td-msym" aria-hidden="true">{UI_ICON.reactions}</span>Reactions</Title>
      <div class="td-glossary-effects">
        {reactionCards.map((reaction) => (
          <article class={`td-glossary-effect td-glossary-effect--${reaction.id}`}>
            <span class="td-msym td-glossary-effect-icon" aria-hidden="true">{REACTION_ICON[reaction.id]}</span>
            <div>
              <SkillTitle class="td-glossary-title">{reaction.name}</SkillTitle>
              <p class="td-glossary-needs">{reaction.needs}</p>
              <p>{reaction.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby={id("hero-list")}>
      <Section class="td-glossary-heading" id={id("hero-list")}><span class="td-msym" aria-hidden="true">{UI_ICON.heroes}</span>Heroes</Section>
      <div class="td-glossary-grid">
        {heroCards.map((hero) => (
          <article class="td-glossary-card" id={`${pid}hero-${hero.id}`}>
            <header class="td-glossary-card-head">
              <img class="td-glossary-portrait" src={hero.image} alt="" width="80" height="80" loading="lazy" decoding="async" />
              <div>
                <Title class="td-glossary-title">{hero.name}</Title>
                <p class="td-glossary-meta">
                  <Fragment set:html={classGlyph(hero.class, 14)} />
                  {hero.class} - {hero.slotLabel} - {hero.damageLabel}
                </p>
                <p class="td-glossary-cost"><span class="td-msym" aria-hidden="true">{UI_ICON.cost}</span>{hero.cost} placement</p>
              </div>
            </header>
            <dl class="td-glossary-stats">
              {hero.stats.map(([label, value, icon]: [string, string | number, string]) => <div><dt><span class="td-msym" aria-hidden="true">{icon}</span>{label}</dt><dd>{value}</dd></div>)}
            </dl>
            <div class="td-glossary-skill">
              <p class="td-label"><span class="td-msym" aria-hidden="true">{UI_ICON.ultimate}</span>Ultimate</p>
              <SkillTitle class="td-glossary-skill-name">{hero.skillName}</SkillTitle>
              {hero.skillText && <p>{hero.skillText}</p>}
              {hero.classUltText && <p class="td-glossary-note">{hero.classUltText}</p>}
              {hero.awakenText && <p class="td-glossary-note td-glossary-note--awaken"><span class="td-msym" aria-hidden="true">{UI_ICON.awakened}</span><span>Awakened: {hero.awakenText}.</span></p>}
            </div>
            {hero.status && <p class="td-glossary-note"><span class="td-msym" aria-hidden="true">{UI_ICON.note}</span><span>Basic attacks apply {hero.status} (see Status effects).</span></p>}
            {hero.synergies?.length > 0 && (
              <ul class="td-glossary-tags" aria-label="Synergy tags">
                <li class="td-glossary-tags-icon" aria-hidden="true"><span class="td-msym">{UI_ICON.synergy}</span></li>
                {hero.synergies.map((tag: string) => <li>{tagLabel(tag)}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>
  </div>

  <div id={`${pid}enemies`} class="td-glossary-panel" role="tabpanel" aria-labelledby={id("tab-enemies")} data-glossary-panel="enemies" hidden>
    <section aria-labelledby={id("enemy-attrs")}>
      <Section class="td-glossary-heading" id={id("enemy-attrs")}><span class="td-msym" aria-hidden="true">{UI_ICON.attributes}</span>Attributes</Section>
      <dl class="td-glossary-terms">
        {enemyAttrs.map(([icon, term, text]) => (
          <div><span class="td-msym td-glossary-term-icon" aria-hidden="true">{icon}</span><dt>{term}</dt><dd>{text}</dd></div>
        ))}
      </dl>
    </section>

    <section aria-labelledby={id("enemy-list")}>
      <Section class="td-glossary-heading" id={id("enemy-list")}><span class="td-msym" aria-hidden="true">{UI_ICON.enemies}</span>Enemies</Section>
      <div class="td-glossary-grid">
        {enemyCardsView.map((enemy) => <EnemyCard enemy={enemy} headingLevel={headingLevel + 1} />)}
      </div>
    </section>

    <section aria-labelledby={id("bosses")}>
      <Section class="td-glossary-heading" id={id("bosses")}><span class="td-msym" aria-hidden="true">{UI_ICON.bosses}</span>Bosses</Section>
      <p class="td-glossary-lead">A boss closes a stage: it steps onto the road once the other enemies are down, or after a short wait. Health is shown at base strength.</p>
      <div class="td-glossary-grid">
        {bossCardsView.map((enemy) => <EnemyCard enemy={enemy} headingLevel={headingLevel + 1} />)}
      </div>
    </section>
  </div>
</div>

<script>
  // Tabs and section jump chips, scoped per glossary root: click and arrow keys. Only the standalone page
  // (data-hash) reads and writes #heroes / #enemies in the URL.
  document.querySelectorAll<HTMLElement>("[data-td-glossary]").forEach((root) => {
    const useHash = root.dataset.hash === "true";
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-glossary-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-glossary-panel]")];
    const jumps = [...root.querySelectorAll<HTMLElement>("[data-glossary-jumps]")];
    // Jump chips scroll their section under the sticky bar; the URL hash stays the tab's.
    root.querySelectorAll<HTMLAnchorElement>("[data-glossary-jump]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        root.querySelector(`#${link.dataset.glossaryJump}`)?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
    function show(name: string, focus = false) {
      tabs.forEach((tab) => {
        const on = tab.dataset.glossaryTab === name;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.glossaryPanel !== name; });
      jumps.forEach((nav) => { nav.hidden = nav.dataset.glossaryJumps !== name; });
      if (useHash) history.replaceState(history.state, "", `#${name}`);
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => show(tab.dataset.glossaryTab!));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        const next = tabs[(index + (event.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        show(next.dataset.glossaryTab!, true);
      });
    });
    if (useHash) {
      const fromHash = location.hash.slice(1);
      if (tabs.some((tab) => tab.dataset.glossaryTab === fromHash)) show(fromHash);
    }
  });
</script>
