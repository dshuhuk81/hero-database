---
// One enemy or boss entry on the glossary page (TdGlossary.astro builds the data).
interface Props { enemy: { kind: string; name: string; text: string; image: string; meta: string; tags: string[]; stats: (string | number)[][] }; }
const { enemy } = Astro.props;
---

<article class="td-glossary-card">
  <header class="td-glossary-card-head">
    <img class="td-glossary-portrait td-glossary-portrait--enemy" src={enemy.image} alt="" width="56" height="56" loading="lazy" decoding="async" />
    <div>
      <h3>{enemy.name}</h3>
      <p class="td-glossary-meta">{enemy.tags.join(" - ")}</p>
    </div>
  </header>
  <p>{enemy.text}</p>
  <dl class="td-glossary-stats">
    {enemy.stats.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
  </dl>
  {enemy.meta && <p class="td-glossary-note">{enemy.meta}</p>}
</article>
