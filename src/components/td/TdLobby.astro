---
// Menu screens (M22 app shell): app bar plus one visible screen at a time. Screen ids
// match data-td-screen; src/game/td/page/nav.ts switches them and keeps browser history
// in step. Blessings, help and save data are hosts: panels.ts moves those panels in.
import { mapSceneFor } from "../../game/td/map-scene.js";
import { mapLanes, routeStrokes } from "../../game/td/lanes.js";
import { CHALLENGES } from "../../game/td/challenges.js"; // M20 badges, filled by renderChallengeBadges
import tuning from "../../data/gameBalance.tuning.json";
import TdSoundControls from "./TdSoundControls.astro";
import TdGlossaryContent from "./TdGlossaryContent.astro";
interface Props { maps: any[]; waveCount: number; bossNames: Record<string, string>; assetBase: string; }
const { maps, waveCount, bossNames, assetBase } = Astro.props;
const previews = maps.map((entry: any) => ({
  id: entry.id,
  name: entry.name,
  bossName: bossNames[entry.id],
  art: mapSceneFor(entry)?.assets ?? null,
  spawns: mapLanes(entry).map((lane: any) => lane.spawn),
  base: entry.base,
  routes: routeStrokes(entry).map((points: number[][]) => points.map(([x, y]) => `${x},${y}`).join(" ")),
}));
// Difficulty tiers (M3) for 10 and 20 waves; numbers from tuning.tiers.
const pct = (mult: number) => `${Math.round((mult - 1) * 100)}%`;
const tiers = Object.entries((tuning as any).tiers ?? {}).map(([id, t]: [string, any], rank) => ({
  id,
  rank,
  label: t.label,
  copy: t.enemyHp === 1 && t.enemyAttack === 1 ? "The standard run." : `Enemies +${pct(t.enemyHp)} health, +${pct(t.enemyAttack)} attack.`,
  favor: t.favor,
}));
const modes = [
  { id: "classic", glyph: String(waveCount), label: `${waveCount} waves`, copy: `The original run with its boss on wave ${waveCount}.` },
  { id: "long", glyph: "20", label: "20 waves", copy: "A boss every 5th wave, at full strength on wave 20." },
  { id: "endless", glyph: "∞", label: "Endless", copy: "A boss every 5th wave. Waves keep growing until the last life is lost. Always Normal difficulty." },
];
---

<section class="td-app" data-td-lobby aria-label="Tower defense menu">
  <header class="td-appbar">
    <button class="td-icon-button td-appbar-back" type="button" data-td-nav-back aria-label="Back" hidden>
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" /></svg>
    </button>
    <h1 class="td-appbar-title" data-td-appbar-title tabindex="-1">Tower Defense</h1>
    <button class="td-favor-chip" type="button" data-td-go="blessings" data-td-favor-chip-button aria-label="Divine Blessings">
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l2.2 6.3L20.5 12l-6.3 2.7L12 21l-2.2-6.3L3.5 12l6.3-2.7z" /></svg>
      <strong data-td-favor-chip>0</strong><span>Favor</span>
    </button>
    <button class="td-icon-button td-appbar-settings" type="button" data-td-go="settings" aria-label="Settings">
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h9M17 7h3M4 17h3M11 17h9" fill="none" /><circle cx="15" cy="7" r="2" fill="none" /><circle cx="9" cy="17" r="2" fill="none" /></svg>
    </button>
  </header>

  <div class="td-screens">
    <!-- 1. Main menu: Free Play as the large lead panel, the other three modes stacked
         beside it, each with its own read of progress (stage route, today's trial, the
         expedition route). Every mode stays one button; the page modules fill the
         data-td-*-summary* hooks (campaign.ts, daily.ts, expedition.ts, renderLobby). -->
    <section class="td-screen td-screen--home" data-td-screen="home" data-title="Tower Defense" aria-label="Main menu">
      <div class="td-screen-body td-home">
        <div class="td-home-modes">
          <button class="td-hmode td-hmode--free" type="button" data-td-go="maps" data-td-autofocus>
            <span class="td-hmode-head">
              <svg class="td-hmode-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4l10 10M14 14l-2 2M14 14l2-2M16.5 16.5l3 3M20 4L10 14M10 14l2 2M10 14l-2-2M7.5 16.5l-3 3" fill="none" /></svg>
              <span class="td-label">Free Play</span>
              <span class="td-hmode-chip" data-td-free-map></span>
            </span>
            <span class="td-free-score">
              <small>Personal best</small>
              <strong data-td-best>0</strong>
              <span class="td-hmode-badge" data-td-perfect hidden>Perfect defense</span>
            </span>
            <span class="action-button action-button--primary td-hmode-cta td-hmode-cta--main">Play</span>
            <small class="td-free-boost" data-td-next-boost hidden></small>
          </button>

          <div class="td-home-side">
            <button class="td-hmode td-hmode--campaign" type="button" data-td-go="campaign">
              <span class="td-hmode-head">
                <svg class="td-hmode-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 21V3M6 4h11l-2.5 4L17 12H6" fill="none" /></svg>
                <span class="td-label">Campaign</span>
                <span class="td-hmode-sub" data-td-camp-summary-chapter></span>
              </span>
              <strong class="td-hmode-title" data-td-camp-summary-title>Stage 1-1</strong>
              <span class="td-route td-route--stages" data-td-camp-summary-route aria-hidden="true"></span>
              <span class="td-hmode-foot">
                <small data-td-camp-summary></small>
                <span class="action-button action-button--quiet td-hmode-cta" data-td-camp-summary-cta>Continue</span>
              </span>
            </button>

            <button class="td-hmode td-hmode--daily" type="button" data-td-go="daily">
              <span class="td-hmode-head">
                <svg class="td-hmode-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h12M6 21h12M7 3c0 5 10 5 10 9s-10 4-10 9M17 3c0 5-10 5-10 9s10 4 10 9" fill="none" /></svg>
                <span class="td-label">Daily Trial</span>
                <span class="td-hmode-tag">Today<span class="td-hmode-tag-time" data-td-daily-summary-reset></span></span>
              </span>
              <strong class="td-hmode-title" data-td-daily-summary-map>Today's battlefield</strong>
              <span class="td-mutator-chips" data-td-daily-summary-mutators></span>
              <span class="td-hmode-foot">
                <span class="td-daily-goal">
                  <small data-td-daily-summary></small>
                  <span class="td-daily-prize" data-td-daily-summary-reward></span>
                </span>
                <span class="action-button action-button--quiet td-hmode-cta">Enter</span>
              </span>
            </button>

            <button class="td-hmode td-hmode--expedition" type="button" data-td-go="expedition">
              <span class="td-hmode-head">
                <svg class="td-hmode-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" /><path d="M15.5 8.5l-2 5-5 2 2-5z" fill="none" /></svg>
                <span class="td-label">Expedition</span>
                <span class="td-hmode-sub" data-td-exp-summary-title>Start</span>
              </span>
              <span class="td-route td-route--journey" data-td-exp-summary-route aria-hidden="true"></span>
              <span class="td-hmode-foot">
                <small data-td-exp-summary></small>
                <span class="action-button action-button--quiet td-hmode-cta" data-td-exp-summary-cta>Start</span>
              </span>
            </button>
          </div>
        </div>

        <nav class="td-home-links" aria-label="More">
          <button class="td-home-link" type="button" data-td-go="blessings">
            <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l2.2 6.3L20.5 12l-6.3 2.7L12 21l-2.2-6.3L3.5 12l6.3-2.7z" /></svg>
            Divine Blessings <span class="td-favor-count" data-td-favor-count></span>
          </button>
          <button class="td-home-link" type="button" data-td-go="glossary">
            <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h10a3 3 0 013 3v13H8a3 3 0 01-3-3zM5 17a3 3 0 013-3h10" fill="none" /></svg>
            Glossary
          </button>
          <button class="td-home-link" type="button" data-td-go="help">
            <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" /><path d="M9.5 9.5a2.5 2.5 0 114 2c-1 .7-1.5 1.2-1.5 2.5M12 17h.01" fill="none" /></svg>
            How to play
          </button>
          <button class="td-home-link" type="button" data-td-go="settings">
            <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h9M17 7h3M4 17h3M11 17h9" fill="none" /><circle cx="15" cy="7" r="2" fill="none" /><circle cx="9" cy="17" r="2" fill="none" /></svg>
            Settings
          </button>
          <a class="td-home-link td-home-link--exit" href="/">
            <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9" fill="none" /></svg>
            Exit to database
          </a>
        </nav>
      </div>
    </section>

    <!-- Campaign home: resources and activities, with stages one level deeper. -->
    <section class="td-screen" data-td-screen="campaign" data-title="Campaign" aria-label="Campaign camp" hidden>
      <div class="td-screen-body td-camp-screen td-camp-home">
        <div class="td-camp-campfire">
          <div class="td-camp-welcome">
            <div class="td-camp-welcome-top">
              <span class="td-label">Your campaign headquarters</span>
              <div class="td-camp-resources" aria-label="Campaign resources" data-td-camp-resources></div>
            </div>
            <h2>Campaign camp</h2>
            <p>Gather your heroes. Strengthen your ranks.<br />Prepare for the road ahead.</p>
          </div>
          <div class="td-camp-party">
            <div class="td-collection-head"><h3 class="td-label">Your company</h3><span data-td-camp-company-note></span></div>
            <div class="td-camp-company" data-td-camp-company></div>
          </div>
        </div>
        <div class="td-camp-activities">
          <button class="td-camp-activity td-camp-activity--journey" type="button" data-td-go="stages" data-td-autofocus>
            <span class="td-label">The journey</span><h3 data-td-camp-home-chapter></h3>
            <span data-td-camp-home-progress></span>
            <progress data-td-camp-home-meter aria-label="Campaign stages cleared"></progress>
            <strong class="td-camp-activity-cta">Venture forth <span aria-hidden="true">→</span></strong>
          </button>
          <button class="td-camp-activity" type="button" data-td-go="heroes">
            <span class="td-camp-activity-icon" aria-hidden="true">♜</span><h3>Heroes</h3>
            <span>Manage your collection and level up your defenders.</span>
            <small data-td-camp-home-heroes></small><strong class="td-camp-activity-cta">Visit heroes <span aria-hidden="true">→</span></strong>
          </button>
          <button class="td-camp-activity td-camp-activity--summon" type="button" data-td-go="summon">
            <span class="td-camp-activity-icon" aria-hidden="true">✧</span><h3>Summoning</h3>
            <span>Spend Divine Seals to welcome a new hero to camp.</span>
            <small data-td-camp-home-summon></small><strong class="td-camp-activity-cta">Visit summoning <span aria-hidden="true">→</span></strong>
          </button>
        </div>
      </div>
    </section>

    <!-- 1b. Campaign (M26): src/game/td/page/campaign.ts, stages in src/data/tdCampaign.json -->
    <section class="td-screen" data-td-screen="stages" data-title="Campaign stages" aria-label="Campaign stages" hidden>
      <div class="td-screen-body td-camp-screen">
        <div class="td-camp-head">
          <h2 class="td-camp-chapter" data-td-camp-chapter>Chapter 1</h2>
          <p class="td-camp-progress" data-td-camp-progress></p>
          <p class="td-camp-wallet" data-td-camp-wallet></p>
        </div>
        <div data-td-camp-feature></div>
        <h3 class="td-label">Chapter route</h3>
        <div class="td-route td-route--stages" aria-hidden="true" data-td-camp-route></div>
        <div class="td-camp-stages" role="group" aria-label="Stages" data-td-camp-stages></div>
      </div>
    </section>

    <!-- 1e. Summon (M26 sprint 9): one banner, Divine Seals buy one or ten heroes; owned heroes return as spare copies;
         banner in src/data/tdSummon.json, screen in src/game/td/page/campaign.ts,
         reveal stage (dialog below) in src/game/td/page/summon-reveal.ts -->
    <section class="td-screen" data-td-screen="summon" data-title="Summon" aria-label="Summon" hidden>
      <div class="td-screen-body td-camp-screen td-summon-screen">
        <article class="td-summon-banner">
          <div class="td-summon-feature-art"><img data-td-summon-feature-art alt="" /></div>
          <div class="td-summon-feature-copy">
            <div class="td-summon-feature-top"><span class="td-label">Featured hero</span><span data-td-summon-rotation></span></div>
            <h2 data-td-summon-feature-name></h2>
            <p class="td-summon-feature-title" data-td-summon-feature-title></p>
            <p class="td-camp-progress" data-td-summon-copy></p>
            <div class="td-summon-rate"><strong data-td-summon-feature-rate></strong><span>Featured chance</span></div>
            <div class="td-summon-terms"><span>Owned heroes return as copies</span><span data-td-summon-pool-count></span></div>
            <div class="td-summon-action">
              <div><span data-td-summon-wallet></span><small data-td-summon-note></small></div>
              <div class="td-summon-buttons">
                <button class="action-button action-button--quiet" type="button" data-td-summon-button data-td-autofocus>Summon x1</button>
                <button class="action-button action-button--primary" type="button" data-td-summon-multi>Summon x10</button>
                <label class="td-summon-skip"><input type="checkbox" data-td-summon-skip /> Skip animation</label>
              </div>
            </div>
          </div>
          <span class="sr-only" data-td-summon-banner></span>
          <span class="sr-only" data-td-summon-price></span>
        </article>
        <details class="td-summon-arrivals">
          <summary>Possible arrivals<svg class="td-summon-arrivals-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
          <div class="td-summon-arrivals-content">
            <div class="td-summon-pool-head"><h3>Other heroes in this call</h3><p>Every non-featured hero has the same chance.</p></div>
            <div class="td-summon-pool" data-td-summon-pool></div>
          </div>
        </details>
        <div class="td-dust">
          <div><span class="td-label">Seal Dust</span><strong data-td-dust-wallet></strong><small>Turn spare copies into Seal Dust on the Heroes screen (Evolution tab).</small></div>
          <div class="td-dust-actions">
            <button class="action-button action-button--quiet" type="button" data-td-dust-seals></button>
            <button class="action-button action-button--quiet" type="button" data-td-dust-essence></button>
          </div>
        </div>
        <p class="td-camp-progress" data-td-summon-source></p>
      </div>
      <dialog class="td-summon-stage" data-td-summon-stage aria-labelledby="td-summon-stage-title">
        <div class="td-summon-stage-inner">
          <header class="td-summon-stage-head">
            <h2 id="td-summon-stage-title" data-td-summon-stage-title>Summon</h2>
            <p data-td-summon-stage-hint></p>
          </header>
          <div class="td-summon-cards" data-td-summon-cards></div>
          <p class="sr-only" aria-live="polite" data-td-summon-live></p>
          <div class="td-summon-stage-actions">
            <button class="action-button action-button--primary" type="button" data-td-summon-reveal-all>Reveal all</button>
            <div class="td-summon-done" data-td-summon-done hidden>
              <button class="action-button action-button--primary" type="button" data-td-summon-again></button>
              <button class="action-button action-button--quiet" type="button" data-td-go="stages">Build squad</button>
              <button class="action-button action-button--quiet" type="button" data-td-summon-close>Close</button>
            </div>
          </div>
        </div>
      </dialog>
    </section>

    <!-- 1d. Campaign heroes: levels (M26) -->
    <section class="td-screen" data-td-screen="heroes" data-title="Heroes" aria-label="Heroes" hidden>
      <div class="td-screen-body td-heroes-screen">
        <div class="td-heroes-head">
          <div>
            <span class="td-label">Your company</span>
            <h2 class="td-camp-chapter">Heroes</h2>
            <p class="td-camp-progress td-heroes-copy" data-td-heroes-copy></p>
          </div>
          <p class="td-camp-wallet" data-td-camp-wallet></p>
        </div>
        <div class="td-heroes-workspace">
          <aside class="td-heroes-browser" aria-label="Hero collection">
            <div class="td-collection-head"><h3 class="td-label">Collection</h3><span data-td-heroes-count></span></div>
            <div class="td-camp-heroes" data-td-camp-heroes></div>
          </aside>
          <div class="td-hero-detail" data-td-hero-detail aria-live="polite"></div>
        </div>
      </div>
    </section>

    <!-- 1c. Squad for a campaign stage (M26) -->
    <section class="td-screen" data-td-screen="squad" data-title="Choose your squad" aria-label="Choose your squad" hidden>
      <div class="td-screen-body td-squad-screen">
        <div class="td-camp-head">
          <h2 class="td-camp-chapter" data-td-squad-stage>Stage</h2>
          <p class="td-camp-progress" data-td-squad-copy></p>
          <p class="td-camp-feature-reward" data-td-squad-rewards></p>
        </div>
        <div class="td-squad-prep">
          <div class="td-squad-lineup" aria-label="Selected squad" data-td-squad-lineup></div>
          <div class="td-squad-tools"><p data-td-squad-coverage></p><button class="action-button action-button--quiet" type="button" data-td-squad-preset>Quick pick</button></div>
          <p class="td-squad-feedback" role="status" data-td-squad-feedback></p>
        </div>
        <p class="td-camp-progress">Choose up to 4 heroes. Campaign levels apply; Divine Blessings do not.</p>
        <div class="td-squad-list" role="group" aria-label="Owned heroes" data-td-squad-list></div>
        <details class="td-squad-locked"><summary data-td-squad-locked-label>Heroes to discover</summary><div class="td-squad-list" data-td-squad-locked></div></details>
      </div>
      <div class="td-screen-footer">
        <p class="td-screen-footer-note" data-td-squad-count></p>
        <p class="td-squad-power" data-td-squad-power hidden></p>
        <button class="action-button action-button--primary" type="button" data-td-squad-start data-td-autofocus>Start</button>
      </div>
    </section>

    <!-- 2. Map select -->
    <section class="td-screen" data-td-screen="maps" data-title="Choose battlefield" aria-label="Choose battlefield" hidden>
      <div class="td-screen-body td-screen-body--center td-maps-screen">
        <div class="td-map-cards" role="group" aria-label="Battlefields" data-td-maps>
          {previews.map((preview: any) => (
            <button type="button" class="td-map-card" data-map-id={preview.id} aria-pressed="false">
              <svg class="td-map-preview" viewBox="0 0 960 540" aria-hidden="true" focusable="false">
                {preview.art && <image href={preview.art.terrain} width="960" height="540" opacity="0.9" preserveAspectRatio="none" />}
                {preview.routes.map((points: string) => <polyline class="td-map-preview-path" points={points} />)}
                {preview.art && <>
                  {preview.spawns.map((spawn: any) => <image href={preview.art.spawn} x={spawn.x - 48} y={spawn.y - 55} width="96" height="110" />)}
                  <image href={preview.art.base} x={preview.base.x - 59} y={preview.base.y - 62} width="118" height="125" />
                </>}
              </svg>
              <span class="td-map-card-copy">
                <strong>{preview.name}</strong>
                <small class="td-map-card-boss">Boss: {preview.bossName}</small>
                <small data-map-best={preview.id}>No runs yet</small>
                <span class="td-map-challenges" data-map-challenges={preview.id}>
                  {CHALLENGES.map((challenge: any) => (
                    <span class="td-map-challenge" data-challenge={challenge.id}>
                      <svg class="td-challenge-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={challenge.icon} /></svg>
                    </span>
                  ))}
                  <span class="sr-only" data-challenge-summary></span>
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>
      <div class="td-screen-footer">
        <p class="td-screen-footer-note" data-td-map-pick></p>
        <button class="action-button action-button--primary" type="button" data-td-go="mode">Next</button>
      </div>
    </section>

    <!-- 3. Difficulty and run length: picking a length starts the run -->
    <section class="td-screen" data-td-screen="mode" data-title="Difficulty and run length" aria-label="Difficulty and run length" hidden>
      <div class="td-screen-body td-mode-screen">
        <header class="td-mode-banner">
          <img class="td-mode-banner-art" data-td-mode-art alt="" decoding="async">
          <img class="td-mode-banner-boss" data-td-mode-boss-art alt="" decoding="async">
          <div class="td-mode-banner-copy">
            <span class="td-label">Battlefield</span>
            <h2 data-td-mode-map></h2>
            <p class="td-trial-boss">Boss <strong data-td-mode-boss></strong></p>
          </div>
          <button class="action-button action-button--quiet td-mode-change" type="button" data-td-go="maps">Change</button>
        </header>
        <div class="td-mode-group">
          <span class="td-label" id="td-tier-label">Difficulty</span>
          <div class="td-tiers" role="radiogroup" aria-labelledby="td-tier-label" data-td-tiers>
            {tiers.map((tier) => (
              <button type="button" class={`td-tier-option td-tier-option--${tier.id}`} role="radio" aria-checked="false" data-tier-id={tier.id}>
                <span class="td-tier-pips" aria-hidden="true">{Array.from({ length: tiers.length }, (_, i) => <i class={i <= tier.rank ? "is-on" : ""}></i>)}</span>
                <strong>{tier.label}</strong>
                <small>{tier.copy}</small>
                <span class="td-tier-favor">{tier.favor}x Favor</span>
              </button>
            ))}
          </div>
        </div>
        <div class="td-mode-group">
          <span class="td-label">Run length - tap to start</span>
          <div class="td-modes" data-td-modes>
            {modes.map((mode) => (
              <button type="button" class={`td-mode td-mode--${mode.id}`} data-mode-id={mode.id}>
                <span class="td-mode-glyph" aria-hidden="true">{mode.glyph}</span>
