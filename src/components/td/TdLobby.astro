---
// Menu screens (M22 app shell): app bar plus one visible screen at a time. Screen ids
// match data-td-screen; src/game/td/page/nav.ts switches them and keeps browser history
// in step. Blessings, help and save data are hosts: panels.ts moves those panels in.
import TdSoundControls from "./TdSoundControls.astro";
import TdGlossaryContent from "./TdGlossaryContent.astro";
import TdHome from "./TdHome.astro";
interface Props { assetBase: string; }
const { assetBase } = Astro.props;
---

<section class="td-app" data-td-lobby aria-label="Tower defense menu">
  <header class="td-appbar">
    <button class="td-icon-button td-appbar-back" type="button" data-td-nav-back aria-label="Back" hidden>
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" /></svg>
    </button>
    <h1 class="td-appbar-title" data-td-appbar-title tabindex="-1">Tower Defense</h1>
    <!-- Global wallet: the chips shown depend on the screen (td.css, .td-wallet-chip), the
         button opens the full inventory. src/game/td/page/wallet.ts fills both. -->
    <div class="td-wallet" data-td-wallet>
      <button class="td-wallet-button" type="button" data-td-wallet-button aria-expanded="false" aria-controls="td-wallet-panel" aria-label="Inventory">
        <span class="td-wallet-chips" data-td-wallet-chips></span>
        <svg class="td-icon td-wallet-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" /></svg>
      </button>
      <div class="td-wallet-panel" id="td-wallet-panel" data-td-wallet-panel role="region" aria-label="Inventory" hidden></div>
    </div>
    <button class="td-icon-button td-debug-toggle td-camp-debug-toggle" type="button" data-td-camp-debug-toggle data-td-debug-gate aria-label="Toggle campaign debug panel" aria-pressed="false">DBG</button>
    <button class="td-icon-button td-appbar-settings" type="button" data-td-go="settings" aria-label="Settings">
      <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h9M17 7h3M4 17h3M11 17h9" fill="none" /><circle cx="15" cy="7" r="2" fill="none" /><circle cx="9" cy="17" r="2" fill="none" /></svg>
    </button>
  </header>

  <section class="td-debug td-camp-debug" data-td-camp-debug data-td-debug-gate aria-label="Campaign debug panel" hidden>
    <div class="td-debug-head">
      <strong>Debug</strong>
      <span>Campaign testing tools.</span>
    </div>
    <label class="td-debug-check"><input type="checkbox" data-camp-debug-stages /> All stages playable</label>
    <div class="td-debug-actions">
      <button type="button" data-camp-debug="gold">+10,000 Gold</button>
      <button type="button" data-camp-debug="heroXp">+10,000 Hero XP</button>
      <button type="button" data-camp-debug="divineSeals">+600 Divine Seals</button>
      <button type="button" data-camp-debug="sealDust">+1,000 Seal Dust</button>
      <button type="button" data-camp-debug="all">Give all</button>
      <button type="button" data-camp-debug="maxAllHeroes">All heroes max</button>
      <button type="button" data-camp-debug="hero:isis">Add hero Isis</button>
      <button type="button" data-camp-debug="resetAccount">RESET ACCOUNT</button>
    </div>
  </section>

  <div class="td-screens">
    <!-- 1. Home screen (War Camp): TdHome.astro, filled by src/game/td/page/home.ts -->
    <TdHome />

    <!-- 1b. Campaign stages (M26): src/game/td/page/campaign.ts, stages in src/data/tdCampaign.json -->
    <section class="td-screen" data-td-screen="stages" data-title="Campaign stages" aria-label="Campaign stages" hidden>
      <div class="td-screen-body td-camp-screen">
        <div class="td-camp-head">
          <h2 class="td-camp-chapter" data-td-camp-chapter>Chapter 1</h2>
          <p class="td-camp-progress" data-td-camp-progress></p>
        </div>
        <div class="td-camp-stages" role="group" aria-label="Stages" data-td-camp-stages></div>
        <section class="td-camp-laurels" aria-label="Chapter rating rewards" data-td-camp-laurels hidden></section>
        <nav class="td-camp-chapters" aria-label="Chapters" data-td-camp-chapters></nav>
      </div>
      <!-- Stage details: tapping a stage card slides this in from the right. -->
      <dialog class="td-camp-drawer" data-td-camp-drawer aria-labelledby="td-camp-drawer-title">
        <div class="td-camp-drawer-inner" data-td-camp-drawer-body></div>
      </dialog>
    </section>

    <!-- 1e. Summon (M26 sprint 9): one banner, Divine Seals buy one or ten heroes; owned heroes return as spare copies;
         banner in src/data/tdSummon.json, screen in src/game/td/page/campaign.ts,
         reveal stage (dialog below) in src/game/td/page/summon-reveal.ts -->
    <section class="td-screen" data-td-screen="summon" data-title="Summon" aria-label="Summon" hidden>
      <div class="td-screen-body td-camp-screen td-summon-screen td-sm">
        <nav class="td-sm-tabs" aria-label="Summon banners">
          <h2 class="td-sm-tabs-title">Hero Summon</h2>
          <div class="td-sm-tablist" role="tablist" aria-orientation="vertical" data-td-summon-tabs></div>
          <div class="td-dust">
            <div><span class="td-label">Seal Dust</span><strong data-td-dust-wallet></strong></div>
            <div class="td-dust-actions">
              <button class="action-button action-button--quiet" type="button" data-td-dust-seals></button>
              <select class="td-dust-copy-select" data-td-dust-copy-hero aria-label="Hero for dust copies"></select>
              <button class="action-button action-button--quiet" type="button" data-td-dust-copy></button>
            </div>
            <small>Turn spare copies into Seal Dust on the Heroes screen (Evolution tab).</small>
          </div>
        </nav>
        <article class="td-sm-stage">
          <div class="td-sm-art"><img data-td-summon-feature-art alt="" /></div>
          <div class="td-sm-nameplate">
            <span class="td-sm-class" data-td-summon-feature-class></span>
            <div>
              <h3 data-td-summon-feature-name></h3>
              <p data-td-summon-feature-title></p>
            </div>
          </div>
          <div class="td-sm-actions">
            <div class="td-sm-buttons">
              <button class="td-sm-buy td-sm-buy--one" type="button" data-td-summon-button>Summon x1</button>
              <button class="td-sm-buy td-sm-buy--multi" type="button" data-td-summon-multi>Summon x10</button>
            </div>
            <label class="td-summon-skip"><input type="checkbox" data-td-summon-skip /> Skip animation</label>
            <label class="td-summon-auto" title="Spare copies of common heroes turn into Seal Dust right after a summon."><input type="checkbox" data-td-summon-auto-dust /> Auto-dust commons</label>
          </div>
        </article>
        <aside class="td-sm-side">
          <section class="td-sm-featured" aria-label="Featured heroes">
            <header><h3>Featured hero</h3><span data-td-summon-rotation></span></header>
            <div class="td-sm-feat-list" data-td-summon-rotation-list></div>
          </section>
          <button class="td-sm-info" type="button" popovertarget="td-summon-odds" aria-label="Summon chances and details" title="Summon chances and details"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg></button>
        </aside>
        <div class="td-summon-odds" id="td-summon-odds" popover>
          <h3 data-td-summon-banner-name></h3>
          <p class="td-camp-progress" data-td-summon-copy></p>
          <h4>Chances</h4>
          <p class="td-sm-rate"><strong data-td-summon-feature-rate></strong><span>for the featured hero per summon</span></p>
          <div class="td-sm-rate-chips" data-td-summon-rates></div>
          <div class="td-summon-terms"><span data-td-summon-pool-count></span><span data-td-summon-pity></span><span>Owned heroes return as spare copies.</span></div>
          <h4>Heroes in this call</h4>
          <div class="td-summon-pool" data-td-summon-pool></div>
          <p class="td-camp-progress" data-td-summon-source></p>
        </div>
        <span class="sr-only" data-td-summon-banner></span>
        <span class="sr-only" data-td-summon-price></span>
      </div>
      <dialog class="td-summon-stage" data-td-summon-stage aria-labelledby="td-summon-stage-title">
        <div class="td-summon-stage-inner">
          <header class="td-summon-stage-head">
            <h2 class="sr-only" id="td-summon-stage-title" data-td-summon-stage-title>Summon</h2>
            <p data-td-summon-stage-hint></p>
            <span class="td-summon-stage-wallet" data-td-summon-stage-wallet></span>
          </header>
          <div class="td-summon-cards" data-td-summon-cards></div>
          <div class="td-summon-detail" data-td-summon-detail hidden></div>
          <p class="sr-only" aria-live="polite" data-td-summon-live></p>
          <div class="td-summon-stage-actions">
            <button class="action-button action-button--primary" type="button" data-td-summon-reveal-all>Reveal all</button>
            <div class="td-summon-done" data-td-summon-done hidden>
              <button class="action-button action-button--primary" type="button" data-td-summon-again></button>
              <button class="action-button action-button--quiet" type="button" data-td-summon-close>Close</button>
            </div>
          </div>
        </div>
        <dialog class="td-summon-intro" data-td-summon-intro aria-label="New hero">
          <div class="td-summon-intro-body" data-td-summon-intro-body></div>
          <button class="action-button action-button--primary" type="button" data-td-summon-intro-continue>Continue</button>
        </dialog>
      </dialog>
    </section>

    <!-- 1d. Campaign heroes: levels (M26) -->
    <section class="td-screen" data-td-screen="heroes" data-title="Heroes" aria-label="Heroes" hidden>
      <div class="td-screen-body td-heroes-screen">
        <div class="td-heroes-head">
          <div>
            <span class="td-label">Your company</span>
            <h2 class="td-camp-chapter">Heroes</h2>
            <p class="td-camp-progress td-heroes-copy" data-td-heroes-copy></p>
          </div>
        </div>
        <div class="td-heroes-workspace">
          <aside class="td-heroes-browser" aria-label="Hero collection">
            <div class="td-collection-head"><h3 class="td-label">Collection</h3><span data-td-heroes-count></span></div>
            <div class="td-camp-heroes" data-td-camp-heroes></div>
          </aside>
          <div class="td-hero-detail" data-td-hero-detail aria-live="polite"></div>
        </div>
      </div>
    </section>

    <!-- 1c. Squad for a campaign stage (M26) -->
    <section class="td-screen" data-td-screen="squad" data-title="Choose your squad" aria-label="Choose your squad" hidden>
      <div class="td-screen-body td-squad-screen">
        <div class="td-squad-roster" role="group" aria-label="Heroes" data-td-squad-list></div>
        <div class="td-squad-prep">
          <div class="td-squad-rows" role="group" aria-label="Selected squad rows" data-td-squad-rows></div>
          <p class="td-squad-feedback" role="status" data-td-squad-feedback></p>
          <p class="td-squad-bonds" data-td-squad-bonds hidden></p>
          <p class="td-squad-reactions" data-td-squad-reactions aria-label="Reactions this squad can trigger"></p>
          <div class="td-squad-go">
            <p class="td-squad-power" data-td-squad-power hidden></p>
            <button class="action-button action-button--primary" type="button" data-td-squad-start data-td-autofocus>Start</button>
          </div>
        </div>
      </div>
    </section>

    <!-- 4a. Daily Trial (M19): filled for today's UTC date by src/game/td/page/daily.ts -->
    <section class="td-screen" data-td-screen="daily" data-title="Daily Trial" aria-label="Daily Trial" hidden>
      <div class="td-screen-body td-screen-body--center">
        <section class="td-trial td-trial--daily" aria-labelledby="td-daily-title" data-td-daily>
          <!-- Calm banner (October 2026): emblem, title, one meta line, rules as plain text, chest reward. -->
          <header class="td-trial-banner">
            <img class="td-trial-boss-art" data-td-daily-boss-art alt="" loading="lazy" decoding="async">
            <img class="td-trial-emblem" data-td-daily-emblem alt="" width="128" height="128" decoding="async">
            <div class="td-trial-intro">
              <p class="td-kicker">Daily Trial <span class="td-daily-date" data-td-daily-date></span></p>
              <h2 id="td-daily-title" data-td-daily-map>Today's battlefield</h2>
              <p class="td-trial-meta"><span>Boss <strong data-td-daily-boss></strong></span><span data-td-daily-goal></span></p>
              <p class="td-trial-rules-line">Normal · No Divine Blessings · No shard boosts</p>
            </div>
            <div class="td-trial-reward" data-td-daily-reward>
              <img class="td-trial-reward-chest" data-td-daily-chest alt="" width="128" height="128" decoding="async">
              <div class="td-trial-reward-copy">
                <span class="td-label">First clear today</span>
                <strong><span data-td-daily-reward-amount></span> <small>Favor</small></strong>
                <small class="td-trial-reward-extra" data-td-daily-reward-seals></small>
                <span class="td-trial-reward-state" data-td-daily-reward-state></span>
              </div>
            </div>
          </header>
          <div class="td-trial-section">
            <div class="td-trial-section-head"><span class="td-label">Mutators</span></div>
            <ul class="td-trial-mutators" data-td-daily-mutators></ul>
          </div>
          <div class="td-trial-section">
            <div class="td-trial-section-head"><span class="td-label">Trial squad</span><small data-td-daily-squad-count></small></div>
            <ul class="td-trial-squad" data-td-daily-heroes></ul>
          </div>
        </section>
      </div>
      <div class="td-screen-footer">
        <p class="td-screen-footer-note td-daily-best" data-td-daily-best></p>
        <button class="action-button action-button--primary" type="button" data-td-daily-start data-td-autofocus>Start trial</button>
      </div>
    </section>

    <!-- 4b. God Challenge: god tabs left, full-bleed backdrop, score ladder + start right; filled by src/game/td/page/god.ts -->
    <section class="td-screen td-screen--god" data-td-screen="god" data-title="God Challenge" aria-label="God Challenge" hidden>
      <div class="td-god" data-td-god>
        <div class="td-god-backdrop" data-td-god-backdrop aria-hidden="true"></div>
        <div class="td-god-tabs" role="tablist" aria-label="Gods" data-td-god-tabs></div>
        <div class="td-god-title">
          <h2 id="td-god-title" data-td-god-name>Cronus</h2>
          <p data-td-god-subtitle></p>
          <p class="td-god-goal" data-td-god-goal></p>
        </div>
        <aside class="td-god-side" aria-label="Score">
          <p class="td-label">Highscore</p>
          <p class="td-god-best" data-td-god-best-value>0</p>
          <ol class="td-god-ladder" data-td-god-ladder></ol>
          <ul class="td-god-rules" aria-label="Challenge rules" data-td-god-rules></ul>
          <button class="action-button action-button--primary" type="button" data-td-god-start data-td-autofocus>Choose squad</button>
        </aside>
      </div>
    </section>

    <!-- 4c. Daily Quests (R10): fixed activities per UTC day, filled by src/game/td/page/quests.ts -->
    <section class="td-screen" data-td-screen="quests" data-title="Daily Quests" aria-label="Daily Quests" hidden>
      <div class="td-screen-body td-screen-body--center td-quests-screen">
        <section class="td-quests-panel" aria-labelledby="td-quests-title">
          <header class="td-quests-head">
            <div class="td-quests-intro">
              <p class="td-kicker"><span>Daily Quests</span><span class="td-daily-date" data-td-quests-date></span></p>
              <h2 id="td-quests-title">Today's duties</h2>
              <p class="td-quests-progress-copy">Complete duties, gather activity, and open today's reward chests.</p>
            </div>
            <div class="td-quests-activity">
              <img class="td-quests-activity-star" data-td-quests-coin alt="" width="64" height="64" decoding="async">
              <strong data-td-quest-activity>0 / 100</strong>
              <small>Daily activity</small>
            </div>
          </header>
          <div class="td-quest-bar" data-td-quest-bar role="group" aria-label="Activity chests"></div>
          <ul class="td-quest-list" data-td-quest-list></ul>
        </section>
      </div>
      <div class="td-screen-footer">
        <p class="td-screen-footer-note" data-td-quests-reset></p>
      </div>
    </section>

    <!-- 4b. Expedition (M21): src/game/td/page/expedition.ts -->
    <section class="td-screen" data-td-screen="expedition" data-title="Expedition" aria-label="Expedition" hidden>
      <div class="td-screen-body td-screen-body--center">
        <section class="td-trial td-exp" aria-labelledby="td-exp-title" data-td-expedition>
          <header class="td-trial-banner td-exp-banner">
            <img class="td-trial-boss-art" data-td-exp-boss-art alt="" loading="lazy" decoding="async" hidden>
            <div class="td-trial-intro">
              <p class="td-kicker">Expedition <span class="td-daily-date" data-td-exp-stage></span></p>
              <h2 id="td-exp-title" data-td-exp-title>Three battlefields, one squad</h2>
              <p class="td-trial-goal" data-td-exp-copy></p>
              <ul class="td-trial-rules" aria-label="Expedition rules" data-td-exp-rules></ul>
            </div>
            <div class="td-trial-reward td-exp-status" data-td-exp-status></div>
          </header>
          <div class="td-trial-section">
            <div class="td-trial-section-head"><span class="td-label">Route</span><small data-td-exp-route-note></small></div>
            <ol class="td-exp-route" data-td-exp-route></ol>
          </div>
          <div class="td-trial-section td-exp-camp-box" data-td-exp-camp hidden>
            <div class="td-trial-section-head"><span class="td-label">Camp: take one reward</span><small>Then continue to the next battlefield</small></div>
            <div class="td-exp-choices" data-td-exp-cards></div>
          </div>
          <div class="td-trial-section" data-td-exp-details hidden>
            <div class="td-trial-section-head"><span class="td-label">Squad</span><small data-td-exp-roster-count></small></div>
            <ul class="td-trial-squad td-exp-squad" data-td-exp-roster></ul>
          </div>
          <div class="td-trial-section" data-td-exp-relics-box hidden>
            <div class="td-trial-section-head"><span class="td-label">Relics</span><small>Active from the start of every stage</small></div>
            <ul class="td-trial-mutators td-exp-relics" data-td-exp-relics></ul>
          </div>
          <div class="td-trial-section" data-td-exp-steps>
            <div class="td-trial-section-head"><span class="td-label">How it works</span></div>
            <ol class="td-exp-steps">
              <li><svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 8a3 3 0 106 0a3 3 0 10-6 0M3 20c0-4 3-6 7-6s7 2 7 6M15 5a3 3 0 010 6M17 14c2.5.5 4 2.5 4 6" fill="none" /></svg><strong>Random squad</strong><small data-td-exp-step-squad></small></li>
              <li><svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z" fill="none" /></svg><strong>Lives carry over</strong><small>Gold resets every stage, lives do not. Each battlefield is tougher than the last.</small></li>
              <li><svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 20l9-15 9 15zM9 20l3-5 3 5" fill="none" /></svg><strong>Make camp</strong><small>After each win, take a new hero, a pair of relics or a drill.</small></li>
            </ol>
          </div>
        </section>
      </div>
      <div class="td-screen-footer">
        <p class="td-screen-footer-note td-daily-best" data-td-exp-best></p>
        <button class="action-button action-button--quiet" type="button" data-td-exp-abandon hidden>Abandon</button>
        <button class="action-button action-button--primary" type="button" data-td-exp-start data-td-autofocus>Start expedition</button>
      </div>
    </section>

    <!-- 5. Panel hosts (panels.embed) -->
    <section class="td-screen td-screen--host" data-td-screen="blessings" data-title="Divine Blessings" aria-label="Divine Blessings" hidden>
      <div class="td-screen-host" data-td-screen-host="blessings"></div>
    </section>
    <section class="td-screen td-screen--host" data-td-screen="save" data-title="Save data" aria-label="Save data" hidden>
      <div class="td-screen-host" data-td-screen-host="save"></div>
    </section>

    <!-- 6. Settings: sound, save data, about -->
    <section class="td-screen" data-td-screen="settings" data-title="Settings" aria-label="Settings" hidden>
      <div class="td-screen-body td-settings">
        <section class="td-settings-group" aria-labelledby="td-settings-sound">
          <h2 class="td-label" id="td-settings-sound">Sound</h2>
          <TdSoundControls />
          <div class="td-settings-display" data-td-fullscreen-row hidden>
            <h2 class="td-label" id="td-settings-display">Display</h2>
            <button class="action-button action-button--quiet td-fullscreen-button td-settings-link" type="button" data-td-fullscreen aria-label="Enter full screen" aria-pressed="false">
              <svg class="td-icon td-icon-expand" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" /></svg>
              <svg class="td-icon td-icon-compress" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" fill="none" /></svg>
              <span data-td-fullscreen-label>Full screen</span>
            </button>
          </div>
        </section>
        <section class="td-settings-group" aria-labelledby="td-settings-progress">
          <h2 class="td-label" id="td-settings-progress">Progress</h2>
          <p class="td-favor-note">Progress is stored in this browser only. A save code moves it to another device or keeps a backup.</p>
          <button class="action-button action-button--quiet td-settings-link" type="button" data-td-go="save">Save data</button>
        </section>
        <section class="td-settings-group" aria-labelledby="td-settings-about">
          <h2 class="td-label" id="td-settings-about">About</h2>
          <p class="td-favor-note">The Last Crossing: a free tower defense game with heroes from Greek and Norse myth, hosted on the Motto Immortal Database fan site.</p>
          <p class="td-disclaimer">Not affiliated with GOAT Games or Motto Immortal. Heroes, art and text are original; music and sounds are CC0.</p>
          <a class="action-button action-button--quiet td-settings-link" href="/">Exit to database</a>
        </section>
      </div>
    </section>

    <!-- 7. Glossary (same content as /games/tower-defense/glossary) -->
    <section class="td-screen" data-td-screen="glossary" data-title="Glossary" aria-label="Glossary" hidden>
      <div class="td-screen-body td-glossary-screen">
        <TdGlossaryContent assetBase={assetBase} embedded headingLevel={2} />
