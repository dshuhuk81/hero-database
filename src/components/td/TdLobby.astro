---
// Lobby screen: map cards with path previews, personal bests, play and panel buttons.
import { mapSceneFor } from "../../game/td/map-scene.js";
import { mapLanes, routeStrokes } from "../../game/td/lanes.js";
import { CHALLENGES } from "../../game/td/challenges.js"; // M20 badges, filled by renderChallengeBadges
interface Props { maps: any[]; waveCount: number; bossNames: Record<string, string>; }
const { maps, waveCount, bossNames } = Astro.props;
const previews = maps.map((entry: any) => ({
  id: entry.id,
  name: entry.name,
  bossName: bossNames[entry.id],
  art: mapSceneFor(entry)?.assets ?? null,
  spawns: mapLanes(entry).map((lane: any) => lane.spawn),
  base: entry.base,
  routes: routeStrokes(entry).map((points: number[][]) => points.map(([x, y]) => `${x},${y}`).join(" ")),
  road: entry.roadSlots.map(([x, y]: number[]) => ({ x, y })),
  platform: entry.platformSlots.map(([x, y]: number[]) => ({ x, y })),
}));
---

<section class="td-lobby" data-td-lobby aria-labelledby="td-lobby-title">
  <div class="td-lobby-inner">
    <header class="td-lobby-head">
      <a class="action-button action-button--quiet td-back" href="/">Back to database</a>
      <div class="td-best" aria-label="Personal best">
        <span>Personal best</span>
        <strong data-td-best>0</strong>
        <span class="td-perfect" data-td-perfect hidden>Perfect defense</span>
        <span class="td-next-boost" data-td-next-boost hidden></span>
      </div>
    </header>

    <div class="td-lobby-copy">
      <p class="td-kicker">Motto Immortal - Field exercise</p>
      <h1 id="td-lobby-title">Tower Defense</h1>
      <p>Fill the rings with heroes and hold the line. Each battlefield has its own boss.</p>
    </div>

    <div class="td-map-cards" role="group" aria-label="Choose battlefield" data-td-maps>
      {previews.map((preview: any) => (
        <button type="button" class="td-map-card" data-map-id={preview.id} aria-pressed="false">
          <svg class="td-map-preview" viewBox="0 0 960 540" aria-hidden="true" focusable="false">
            {preview.art && <image href={preview.art.terrain} width="960" height="540" opacity="0.55" preserveAspectRatio="none" />}
            {preview.routes.map((points: string) => <polyline class="td-map-preview-path" points={points} />)}
            {preview.road.map((ring: any) => <circle class="td-map-preview-road" cx={ring.x} cy={ring.y} r="20" />)}
            {preview.platform.map((ring: any) => <circle class="td-map-preview-platform" cx={ring.x} cy={ring.y} r="20" />)}
            {preview.art && <>
              {preview.spawns.map((spawn: any) => <image href={preview.art.spawn} x={spawn.x - 48} y={spawn.y - 55} width="96" height="110" />)}
              <image href={preview.art.base} x={preview.base.x - 59} y={preview.base.y - 62} width="118" height="125" />
            </>}
          </svg>
          <span class="td-map-card-copy">
            <strong>{preview.name}</strong>
            <small class="td-map-card-boss">Boss: {preview.bossName}</small>
            <small data-map-best={preview.id}>No runs yet</small>
            <span class="td-map-challenges" data-map-challenges={preview.id}>
              {CHALLENGES.map((challenge: any) => (
                <span class="td-map-challenge" data-challenge={challenge.id}>
                  <svg class="td-challenge-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={challenge.icon} /></svg>
                </span>
              ))}
              <span class="sr-only" data-challenge-summary></span>
            </span>
          </span>
        </button>
      ))}
    </div>

    <div class="td-lobby-actions">
      <button class="action-button action-button--primary td-play-button" type="button" data-td-play-start>Play</button>
      <button class="action-button action-button--quiet" type="button" data-td-open="blessings">Divine Blessings <span class="td-favor-count" data-td-favor-count></span></button>
      <button class="action-button action-button--quiet" type="button" data-td-open="help">How to play</button>
      <a class="action-button action-button--quiet" href="/games/tower-defense/glossary">Glossary</a>
      <button class="action-button action-button--quiet" type="button" data-td-open="save">Save data</button>
    </div>

    <!-- Daily Trial (M19): filled for today's UTC date by src/game/td/page/daily.ts -->
    <section class="td-daily" aria-labelledby="td-daily-title" data-td-daily>
      <div class="td-daily-head">
        <div>
          <p class="td-kicker">Daily Trial <span class="td-daily-date" data-td-daily-date></span></p>
          <h2 id="td-daily-title" data-td-daily-map>Today's battlefield</h2>
        </div>
        <button class="action-button action-button--primary" type="button" data-td-daily-start>Start trial</button>
      </div>
      <p class="td-daily-goal" data-td-daily-goal></p>
      <div class="td-daily-grid">
        <div>
          <span class="td-label">Heroes</span>
          <ul class="td-daily-list" data-td-daily-heroes></ul>
        </div>
        <div>
          <span class="td-label">Mutators from wave 1</span>
          <ul class="td-daily-list" data-td-daily-mutators></ul>
        </div>
      </div>
      <p class="td-daily-best" data-td-daily-best></p>
    </section>

    <p class="td-disclaimer">Motto Immortal and all game contents are the property of GOAT Games. All rights reserved.</p>
  </div>
</section>
