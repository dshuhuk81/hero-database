---
// Panels: the in-game pause menu (modal only) and Blessings, help and save data. The
// last three open as modals during a run and are moved into their menu screens
// otherwise (panels.embed). Controlled by src/game/td/page/panels.ts and save.ts.
interface Props { maps: any[]; bossNames: Record<string, string>; }
import TdSoundControls from "./TdSoundControls.astro";
import { DAILY } from "../../game/td/daily.js";
const { maps, bossNames } = Astro.props;
const bossList = maps.map((map: any) => `${bossNames[map.id]} on ${map.name}`).join(", ");
---

<div class="td-panel-layer" data-td-panel-layer hidden>
  <section class="td-panel" data-td-panel="menu" role="dialog" aria-modal="true" aria-labelledby="td-menu-title" tabindex="-1" hidden>
    <div class="td-panel-head">
      <h2 id="td-menu-title">Paused</h2>
      <button class="td-icon-button td-icon-button--small" type="button" data-td-close-panel aria-label="Close menu">
        <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="td-panel-body">
      <div class="td-menu-stats">
        <div class="td-stat"><span>Score</span><strong data-td-score>0</strong></div>
        <div class="td-stat"><span>Synergies</span><strong data-td-synergy-count>0</strong></div>
        <div class="td-stat"><span>Best</span><strong data-td-menu-best>0</strong></div>
      </div>
      <TdSoundControls />
      <div class="td-menu-actions">
        <button class="action-button action-button--primary" type="button" data-td-close-panel>Resume</button>
        <button class="action-button action-button--quiet" type="button" data-td-open="help">How to play</button>
        <button class="action-button action-button--quiet" type="button" data-td-restart>Restart run</button>
        <button class="action-button action-button--quiet" type="button" data-td-to-lobby="home">Main menu</button>
        <a class="action-button action-button--quiet" href="/">Exit to database</a>
      </div>
    </div>
  </section>

  <section class="td-panel td-panel--wide td-panel--blessings" data-td-panel="blessings" role="dialog" aria-modal="true" aria-labelledby="td-blessings-title" tabindex="-1" hidden>
    <div class="td-panel-head">
      <h2 id="td-blessings-title">Blessings</h2>
      <button class="td-icon-button td-icon-button--small" type="button" data-td-close-panel aria-label="Close blessings">
        <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="td-tabs" role="tablist" aria-label="Blessing types">
      <button class="td-tab" type="button" role="tab" id="td-tab-favor" aria-controls="td-tabpanel-favor" aria-selected="true" data-td-tab="favor">Divine Blessings</button>
      <button class="td-tab" type="button" role="tab" id="td-tab-run" aria-controls="td-tabpanel-run" aria-selected="false" tabindex="-1" data-td-tab="run">This run</button>
    </div>
    <div class="td-panel-body">
      <div id="td-tabpanel-favor" role="tabpanel" aria-labelledby="td-tab-favor" data-td-tabpanel="favor">
        <p class="td-favor-note" data-td-favor-note></p>
        <div data-td-favor-tree></div>
      </div>
      <div id="td-tabpanel-run" role="tabpanel" aria-labelledby="td-tab-run" data-td-tabpanel="run" hidden></div>
    </div>
  </section>

  <section class="td-panel td-panel--wide" data-td-panel="help" role="dialog" aria-modal="true" aria-labelledby="td-help-title" tabindex="-1" hidden>
    <div class="td-panel-head">
      <h2 id="td-help-title">How to play</h2>
      <button class="td-icon-button td-icon-button--small" type="button" data-td-close-panel aria-label="Close help">
        <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="td-panel-body td-help">
      <article><strong>Deploy</strong><p>Tap an empty ring to recruit a hero there. Every ring can hold a hero; gold is the only limit. You can start wave 1 as soon as one hero is on the field.</p></article>
      <article><strong>Road</strong><p>Gold rings accept Tanks, Warriors, and Assassins. They stop ground enemies and can fall in battle. A Tank holds up to 3 enemies at once, a Warrior 2 and an Assassin 1; the rest walk past to the next blocker, slowed for a moment as they squeeze by.</p></article>
      <article><strong>Platforms</strong><p>Purple rings accept Mages, Archers, and Supports. Flyers ignore blockers and road heroes (ultimates included), so ranged coverage matters.</p></article>
      <article><strong>Special rings</strong><p>Some rings carry a marker. High ground (gold triangle) gives +20% range, a Shrine (cyan diamond) charges the hero's ultimate 30% faster, and a Cursed ring (red cross) gives +30% damage but 20% slower attacks. The recruit sheet names the ring before you place a hero there.</p></article>
      <article><strong>Classes</strong><p>Every class fights its own way. Tanks shrug off part of every hit, and their ultimate pins every ground enemy nearby in place. Warriors cleave the enemies next to their target. Assassins dash to enemies that slip past the line and hit fast Runners hardest; their ultimate makes them untouchable for a moment while they strike an extra enemy. Mages fire slow magic blasts that splash around the target (Zeus chains instead), best against packs and armored Brutes. Archers fire slow, heavy shots at the toughest enemy in range, pierce armor and hit flyers twice as hard. Supports heal the most injured ally in range and raise the attack of allies inside their ring, but barely attack. Enemy Archers shoot from range for a few seconds, then close in.</p></article>
      <article><strong>Upgrade</strong><p>Tap a deployed hero to upgrade, rotate or sell it. Selling works anytime, frees the ring and returns half of the gold spent on that hero (deploy, upgrades and Awakening); tap Sell twice to confirm. Levels belong to the deployed unit - a fallen hero re-enters at level 1. Level 3 asks for a focus: +10% attack, +25% health or +20% range; it stays with that unit until it falls. At level 4 a hero can Awaken for 220 gold: more attack and health and a stronger ultimate (Details shows what changes). Awakening is lost when the hero falls. Level 4 also picks one of three class paths that change how the hero fights (the Glossary lists them all), for example Frost or Wildfire for Mages; the path is lost when the hero falls. Awakened heroes can then keep training attack, health or range; every training costs more than the last, and range can be trained 3 times.</p></article>
      <article><strong>Targeting</strong><p>The Target icons in a hero's popup choose who it attacks first: its class rule (Archers the toughest, Assassins loose and weak enemies, everyone else the enemy furthest along), first or last enemy, highest or lowest health, fastest, ground, flyers or the boss. Ground, flyers and boss fall back to other enemies when none are in range. Road heroes still cannot hit flyers, and Supports always heal first. The choice stays with the unit, also through a revive.</p></article>
      <article><strong>Auto</strong><p>Turn on Auto in the top bar to start the next wave 10 seconds after a wave is cleared. The countdown waits while you choose a blessing, recruit a hero, pause or have a menu open.</p></article>
      <article><strong>Quests</strong><p>Each wave except the last has a quest, shown at the top of the map: let no enemy through, keep every hero alive, clear the wave quickly after the last enemy spawns, or have a named hero land a set number of kills. Complete it for bonus gold when the wave ends.</p></article>
      <article><strong>Divine Blessings</strong><p>Every finished run earns Favor for the Divine trunk. Each hero class also has its own branch, paid with that class's Insight: the heroes you deploy earn it for their class, per wave on the field and per kills. Most blessings have several levels, deeper stages open once enough levels are bought in that tree, and Surge and Wrath exclude each other. Drag or pinch to move and zoom the tree. A reset refunds everything for a Favor fee. Purchases made during a run apply from your next run. Runs that reach wave 3 also let you pick a shard: extra Favor, or extra gold or a blessing for your next run.</p></article>
      <article><strong>Difficulty</strong><p>Before a 10 or 20 wave run, pick Normal, Heroic or Mythic. Heroic and Mythic send tougher enemies and pay more Favor; each difficulty keeps its own records. Normal is where a new account starts; as your Divine Blessings grow, Heroic and then Mythic become the real test. Endless always runs at Normal because it keeps getting harder on its own.</p></article>
      <article><strong>Challenges</strong><p>Every battlefield has six optional challenges for 10 and 20 wave runs: Perfect Defense (lose no life), Trio (deploy at most 3 different heroes), One Class (every deployed hero from one class), Unrefined (buy no level, Awakening or training), Swift (win within a battle time limit) and Hoarder (win with a lot of gold left). They are checked when you win; nothing changes how the run plays. Each first clear pays Favor once per battlefield and run length, more on Heroic and Mythic, and clearing it later on a higher difficulty pays the difference. The badges on each battlefield card show what you have done; the difficulty and run length screen lists the exact conditions.</p></article>
      <article><strong>Expedition</strong><p>A run across all three battlefields with one squad. You start with three random heroes; only your expedition roster can be recruited. Each stage is a 10-wave run, tougher than the last; lives carry over, gold does not, and a stage cannot be retried. After a won stage the camp on the Expedition screen offers a new hero (costs lives), a pair of relics (rare and epic blessings active from wave 1) or a drill (your current heroes enter every stage at level 2). Your progress is saved between stages. Challenges and records do not count during an expedition.</p></article>
      <article><strong>Mutators</strong><p>In endless, every 10th cleared wave offers three mutators, for example Fortified (tougher enemies) or Elites. Pick one to make the rest of the run harder: every wave you clear afterwards pays extra Favor. Mutators stack and last until the run ends; you can also skip. Your best endless run on each battlefield remembers which mutators it had.</p></article>
      <article><strong>Daily Trial</strong><p>Every day brings one fixed trial, the same for every player: a battlefield, five heroes (at least two for the road and two for platforms), and two mutators that are active from wave 1. It is an endless run at Normal without Divine Blessings or shard boosts, so only your play decides the score. Clear the goal wave for {DAILY.rewardFavor} bonus Favor once per day; the run's normal Favor counts as usual. The Daily Trial screen shows today's trial and your best of the day. A new trial starts at midnight UTC.</p></article>
      <article><strong>Run length</strong><p>Pick a run length after choosing a battlefield. 10 waves is the original run. 20 waves brings a boss every 5th wave; the earlier ones are weaker and the one on wave 20 fights at full strength. Endless also brings a boss every 5th wave and keeps making waves bigger until your last life is lost; past wave 20 enemies get stronger with every wave, so going deeper takes Divine Blessings. Each length keeps its own best score per battlefield.</p></article>
      <article><strong>Rare and Epic blessings</strong><p>Some cards in the between-wave blessing offer are Rare (blue) or Epic (purple). Instead of a stat bonus they change how the fight works, for example Tidal Pull slows Wet enemies and Soul Reaper pays gold on every 10th kill. They are only offered when your deployed heroes can use them, so what you field shapes what you are offered.</p></article>
      <article><strong>Status effects</strong><p>Some heroes mark enemies with their basic attacks: Poseidon makes them Wet, Phoenix and Prometheus set them on Burn, Medusa and Jormungandr Poison them. Small colored dots above an enemy's health bar show its statuses. Statuses combine into reactions, for example Wet plus Zeus's chain lightning (Conduct) or Wet plus Burn (Steam). The first time a reaction happens in a run, the game names it; the Glossary lists all of them.</p></article>
      <article><strong>Special enemies</strong><p>From wave 5 some enemies change what your line needs. Menders heal enemies around them (splash damage or Last enemy targeting reaches them). Shieldbearers carry a shield that breaks faster to many quick hits. Hexers stop the nearest hero for a moment, so don't rely on one hero per spot; Archers outrange them. Broodcallers call Imps until they fall, so kill them early. The Glossary has the numbers.</p></article>
      <article><strong>Bosses</strong><p>Each battlefield has its own boss ({bossList}), arriving with an escort. Boss health and speed are tuned for this mode. Lilith summons her children around her and cannot be hit while they stand; damage they take also hurts her, and she summons them again, weaker, when all have fallen.</p></article>
      <article><strong>Keyboard</strong><p>Focus the battlefield, use the left and right arrow keys to choose a ring, and press Enter to use it. R rotates the selected hero, F toggles full screen, Escape closes panels and goes back one screen in the menus.</p></article>
    </div>
  </section>

  <section class="td-panel" data-td-panel="save" role="dialog" aria-modal="true" aria-labelledby="td-save-title" tabindex="-1" hidden>
    <div class="td-panel-head">
      <h2 id="td-save-title">Save data</h2>
      <button class="td-icon-button td-icon-button--small" type="button" data-td-close-panel aria-label="Close save data">
        <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="td-panel-body">
      <p class="td-favor-note">Progress is stored in this browser only. Copy your code to move it to another device or keep a backup. Sound settings are not included.</p>
      <div class="td-save-block">
        <label class="td-label" for="td-save-export">Your save code</label>
        <textarea class="td-save-code" id="td-save-export" rows="3" readonly data-td-save-export></textarea>
        <div class="td-save-actions">
          <button class="action-button action-button--quiet" type="button" data-td-save-copy>Copy code</button>
          <button class="action-button action-button--quiet" type="button" data-td-save-download>Download file</button>
        </div>
      </div>
      <div class="td-save-block">
        <label class="td-label" for="td-save-import">Load a save</label>
        <textarea class="td-save-code" id="td-save-import" rows="3" placeholder="Paste a save code" data-td-save-import></textarea>
        <div class="td-save-actions">
          <button class="action-button action-button--primary" type="button" data-td-save-load>Load code</button>
          <button class="action-button action-button--quiet" type="button" data-td-save-file>Load file</button>
          <input class="td-save-file-input" type="file" accept=".json,application/json" data-td-save-file-input />
        </div>
        <p class="td-favor-note">Loading replaces your current progress on this device.</p>
      </div>
      <p class="td-save-status" role="status" data-td-save-status></p>
    </div>
  </section>
</div>
