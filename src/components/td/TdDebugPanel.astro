---
// Debug panel (local dev, or production with ?debug=1): difficulty knobs and shortcuts. Controlled by
// src/game/td/page/debug.ts; the page removes it unless debug is allowed (data-td-debug-gate).
---

<section class="td-debug" data-td-debug data-td-debug-gate aria-label="Debug panel" hidden>
  <div class="td-debug-head">
    <strong>Debug</strong>
    <span>Runs with debug changes are not recorded.</span>
  </div>
  <label class="td-debug-row">Enemy HP <output data-debug-out="enemyHp">x1.00</output>
    <input type="range" min="0.25" max="3" step="0.05" value="1" data-debug-knob="enemyHp" />
  </label>
  <label class="td-debug-row">Enemy speed <output data-debug-out="enemySpeed">x1.00</output>
    <input type="range" min="0.5" max="2" step="0.05" value="1" data-debug-knob="enemySpeed" />
  </label>
  <label class="td-debug-check"><input type="checkbox" data-debug-invincible /> Invincible lives</label>
  <dl class="td-debug-stats" data-debug-stats></dl>
  <div class="td-debug-actions">
    <button type="button" data-debug-action="gold">+50 Nectar</button>
    <button type="button" data-debug-action="favor">+500 Favor</button>
    <button type="button" data-debug-action="win">Win now</button>
    <button type="button" data-debug-action="lose">Lose now</button>
    <button type="button" data-debug-action="reset">Reset knobs</button>
    <button type="button" data-debug-action="copy">Copy values</button>
  </div>
  <output class="td-debug-copy" data-debug-copy></output>
</section>
