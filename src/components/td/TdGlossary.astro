---
// Tower Defense glossary, standalone page (/games/tower-defense/glossary, kept for
// search engines): title, back link and disclaimer around TdGlossaryContent, which
// the game also mounts in its in-app Glossary screen.
import GlossaryContent from "./TdGlossaryContent.astro";

interface Props { assetBase: string; }
const { assetBase } = Astro.props;
---

<section class="td-lobby td-glossary" aria-labelledby="td-glossary-title">
  <div class="td-lobby-inner">
    <header class="td-lobby-head">
      <a class="action-button action-button--quiet td-back" href="/games/tower-defense">Back to game</a>
    </header>

    <div class="td-lobby-copy">
      <p class="td-kicker">Tower Defense</p>
      <h1 id="td-glossary-title">Glossary</h1>
      <p>Every hero and enemy you meet on the battlefield: what they do, their attributes and their skills. Values are at level 1 and wave 1.</p>
    </div>

    <GlossaryContent assetBase={assetBase} />

    <p class="td-disclaimer">Motto Immortal and all game contents are the property of GOAT Games. All rights reserved.</p>
  </div>
</section>
