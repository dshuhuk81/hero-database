---
// Play screen: top bar (stats, speed, pause, menu), stage with the canvas and
// overlays, bottom bar (Blessings, deck, wave button).
import TdOverlays from "./TdOverlays.astro";
import TdDebugPanel from "./TdDebugPanel.astro";
interface Props { waveCount: number; isDev: boolean; }
const { waveCount, isDev } = Astro.props;
---

<section class="td-play" data-td-play aria-label="Tower defense game" hidden>
  <div class="td-topbar">
    <div class="td-stats">
      <div class="td-stat td-stat--gold"><span>Gold</span><strong data-td-gold>0</strong><em class="td-gold-float" data-td-gold-float aria-hidden="true"></em></div>
      <div class="td-stat"><span>Lives</span><strong data-td-lives>0</strong></div>
      <div class="td-stat"><span>Wave</span><strong><span data-td-wave>0</span>/<span data-td-wave-total>{waveCount}</span></strong></div>
    </div>
    <div class="td-top-actions">
      <button class="td-icon-button td-auto-button" type="button" data-td-auto aria-pressed="false" aria-label="Auto-start next wave">Auto</button>
      <button class="td-icon-button" type="button" data-td-speed aria-label="Game speed 1x">1x</button>
      <button class="td-icon-button" type="button" data-td-pause aria-label="Pause game" aria-pressed="false">
        <svg class="td-icon td-icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
        <svg class="td-icon td-icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5l11 7-11 7z" /></svg>
      </button>
      <button class="td-icon-button td-fullscreen-button" type="button" data-td-fullscreen aria-label="Enter full screen" aria-pressed="false" hidden>
        <svg class="td-icon td-icon-expand" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" /></svg>
        <svg class="td-icon td-icon-compress" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" fill="none" /></svg>
      </button>
      {isDev && <button class="td-icon-button td-debug-toggle" type="button" data-td-debug-toggle aria-label="Toggle debug panel" aria-pressed="false">DBG</button>}
      <button class="td-icon-button" type="button" data-td-open="menu" aria-label="Open menu">
        <svg class="td-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="6" width="16" height="2" rx="1" /><rect x="4" y="11" width="16" height="2" rx="1" /><rect x="4" y="16" width="16" height="2" rx="1" /></svg>
      </button>
    </div>
  </div>

  <div class="td-stage" data-td-stage>
    <p class="td-stage-loading" data-td-loading hidden>Preparing battlefield</p>
    <div class="td-wave-preview" data-td-preview hidden></div>
    <div class="td-buffs" data-td-buffs role="group" aria-label="Active run blessings" hidden></div>
    <p class="td-notice" data-td-notice role="status" aria-live="polite"></p>
    <div class="td-boss-plate" data-td-boss-plate aria-hidden="true" hidden>
      <img class="td-boss-plate-art" data-td-boss-art alt="" decoding="async" />
      <div class="td-boss-plate-text">
        <span>Final wave</span>
        <strong data-td-boss-name></strong>
        <small data-td-boss-sub></small>
      </div>
    </div>


    <TdOverlays>
      {isDev && <TdDebugPanel />}
    </TdOverlays>
  </div>

  <div class="td-bottombar">
    <button class="action-button action-button--quiet td-blessings-button" type="button" data-td-open="blessings">Blessings</button>
    <div class="td-deck" data-td-deck role="group" aria-label="Your heroes"></div>
    <button class="action-button action-button--primary td-main-action" type="button" data-td-main-action disabled>Deploy a hero</button>
  </div>
</section>
