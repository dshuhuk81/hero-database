<script define:vars={{ lvPressing: LV_PRESSING_DATA }}>
	    class DamageCalculatorAlpha {
	      constructor() {
	        this.alpha = 1.2;
	        this.safeZone = 15;
	        this.maxReduction = 90; // floor at 10%
	      }

	      calculateOutgoingPercent(playerLv, enemyLv) {
	        const gap = enemyLv - playerLv;
	        if (gap <= this.safeZone) return 100;
	        const ratio = gap / playerLv;
	        const damage = 100 / (1 + this.alpha * ratio);
	        return Math.max(10, damage);
	      }

	      getSeverity(damagePercent) {
	        if (damagePercent >= 90) return "safe";
	        if (damagePercent >= 75) return "minor";
	        if (damagePercent >= 50) return "moderate";
	        if (damagePercent >= 25) return "severe";
	        if (damagePercent >= 10) return "critical";
	        return "impossible";
	      }
	    }

	    const LV_PRESSING = /** @type {null | { base: number, maxDiff: number, rows: Record<string, any> }} */ (
	      lvPressing || null
	    );

	    const MECHANICS = /** @type {const} */ ({
	      lvpress: "lvpress",
	      alpha: "alpha",
	      none: "none",
	    });

	    const clampInt = (value, min, max) => {
	      const n = Number.parseInt(String(value), 10);
	      if (!Number.isFinite(n)) return min;
	      return Math.min(max, Math.max(min, n));
	    };

	    const formatSigned = (n) => `${n >= 0 ? "+" : ""}${n}`;
	    const formatPct = (n, digits = 1) => `${n >= 0 ? "+" : ""}${n.toFixed(digits)}%`;

	    const severityMeta = {
	      safe: { label: "Safe Zone", pill: "Safe", color: "var(--dc-safe)" },
	      minor: { label: "Minor Penalty", pill: "Minor", color: "var(--dc-minor)" },
	      moderate: { label: "Moderate Penalty", pill: "Moderate", color: "var(--dc-moderate)" },
	      severe: { label: "Severe Penalty", pill: "Severe", color: "var(--dc-severe)" },
	      critical: { label: "Critical", pill: "Critical", color: "var(--dc-critical)" },
	      impossible: { label: "Impossible", pill: "Impossible", color: "var(--dc-impossible)" },
	    };

	    const calcAlpha = new DamageCalculatorAlpha();
	    const GAP_ROWS = [0, 5, 10, 15, 20, 30, 50, 75, 100, 150, 200];

	    const root = document.querySelector(".dc-shell");
	    if (!root) throw new Error("Damage calculator root not found");

	    const els = {
	      tabButtons: /** @type {NodeListOf<HTMLButtonElement>} */ (root.querySelectorAll("[data-dc-tab]")),
	      panels: /** @type {NodeListOf<HTMLElement>} */ (root.querySelectorAll("[data-dc-panel]")),
	      mechanic: /** @type {HTMLSelectElement} */ (root.querySelector("#dc-mechanic")),
	      mechanicHelp: /** @type {HTMLElement} */ (root.querySelector("#dc-mechanic-help")),
	      hint: /** @type {HTMLElement} */ (root.querySelector("#dc-hint")),
	      playerRange: /** @type {HTMLInputElement} */ (root.querySelector("#dc-player-range")),
	      playerNumber: /** @type {HTMLInputElement} */ (root.querySelector("#dc-player-number")),
	      enemyRange: /** @type {HTMLInputElement} */ (root.querySelector("#dc-enemy-range")),
	      enemyNumber: /** @type {HTMLInputElement} */ (root.querySelector("#dc-enemy-number")),
	      presetEqual: /** @type {HTMLButtonElement} */ (root.querySelector("#dc-preset-equal")),
	      damage: /** @type {HTMLElement} */ (root.querySelector("#dc-damage")),
	      incoming: /** @type {HTMLElement} */ (root.querySelector("#dc-incoming")),
	      gap: /** @type {HTMLElement} */ (root.querySelector("#dc-gap")),
	      ratio: /** @type {HTMLElement} */ (root.querySelector("#dc-ratio")),
	      severityBadge: /** @type {HTMLElement} */ (root.querySelector("#dc-severity-badge")),
	      outputCard: /** @type {HTMLElement} */ (root.querySelector("#dc-output-card")),
	      progressFill: /** @type {HTMLElement} */ (root.querySelector("#dc-progress-fill")),
	      progressText: /** @type {HTMLElement} */ (root.querySelector("#dc-progress-text")),
	      modelTag: /** @type {HTMLElement} */ (root.querySelector("#dc-model-tag")),
	      toast: /** @type {HTMLElement} */ (root.querySelector("#dc-toast")),

	      tablePlayer: /** @type {HTMLSelectElement} */ (root.querySelector("#dc-table-player")),
	      tableMechanic: /** @type {HTMLSelectElement} */ (root.querySelector("#dc-table-mechanic")),
	      tableBody: /** @type {HTMLElement} */ (root.querySelector("#dc-table-body")),
	    };

		    let toastTimer = 0;
		    const setToast = (message) => {
	      els.toast.textContent = message;
	      els.toast.classList.add("is-on");
	      window.clearTimeout(toastTimer);
	      toastTimer = window.setTimeout(() => els.toast.classList.remove("is-on"), 1700);
	    };

	    const lvPressingForDiff = (diff) => {
	      if (!LV_PRESSING || !LV_PRESSING.rows) return null;
	      const maxDiff = Number(LV_PRESSING.maxDiff || 0);
	      const d = Math.max(0, Math.min(maxDiff, diff));
	      return LV_PRESSING.rows[String(d)] || LV_PRESSING.rows[String(maxDiff)] || null;
	    };

	    const computeValues = (playerLv, enemyLv, mechanic) => {
	      const gap = enemyLv - playerLv;
	      const ratio = playerLv > 0 ? gap / playerLv : 0;

	      if (mechanic === MECHANICS.none) {
	        return { outgoingPct: 100, incomingMult: 1, gap, ratio, modelTag: "None" };
	      }

	      if (mechanic === MECHANICS.alpha) {
	        const outgoing = calcAlpha.calculateOutgoingPercent(playerLv, enemyLv);
	        return { outgoingPct: outgoing, incomingMult: null, gap, ratio, modelTag: "α=1.2" };
	      }

	      const diff = Math.max(0, enemyLv - playerLv);
	      const row = lvPressingForDiff(diff);
	      if (!row) return { outgoingPct: 100, incomingMult: 1, gap, ratio, modelTag: "LvPress" };

	      const outgoingPct = Math.max(0, Math.min(100, (Number(row.outMult) || 1) * 100));
	      const incomingMult = Math.max(0, Number(row.inMult) || 1);
	      return { outgoingPct, incomingMult, gap, ratio, modelTag: "LvPress" };
	    };

	    const applySeverity = (damagePercent) => {
	      const key = calcAlpha.getSeverity(damagePercent);
	      const meta = severityMeta[key] || severityMeta.safe;
	      els.outputCard.dataset.severity = key;
	      els.outputCard.style.setProperty("--dc-accent", meta.color);
	      els.severityBadge.textContent = meta.pill;
	      els.severityBadge.style.background = meta.color;
	      els.severityBadge.title = meta.label;
	      return meta;
	    };

		    const setMechanicHelp = (mechanic) => {
		      if (!els.mechanicHelp) return;
		      if (mechanic === MECHANICS.lvpress) {
		        els.mechanicHelp.textContent =
		          "Spire (Tower): Outgoing damage can go down and damage taken can go up when you are under-leveled. (Real fights still vary due to skills/crit/defense.)";
		        if (els.hint) els.hint.innerHTML = "Tip: This mode is <strong>bidirectional</strong> -- both your damage output and the damage you take change based on the level gap.";
		        return;
		      }
			      if (mechanic === MECHANICS.alpha) {
			        els.mechanicHelp.textContent =
			          "Odyssey (Campaign): Rough outgoing-damage sandbox (+15 safe zone). Live captures show incoming damage can change too, but not with a stable formula yet — so Damage Taken stays n/a here.";
			        if (els.hint) els.hint.innerHTML = "Tip: Treat this as an <strong>experimental estimate</strong>. The live Odyssey captures below are better evidence than this formula for now.";
			        return;
			      }
	      els.mechanicHelp.textContent =
	        "No level scaling: shows 100% outgoing damage and 1.00× damage taken (useful for PvP-like modes/events).";
	      if (els.hint) els.hint.textContent = "Tip: Use this when the mode ignores level gaps.";
	    };

	    const getState = () => {
	      const playerLv = clampInt(els.playerNumber.value, 1, 999);
	      const enemyLv = clampInt(els.enemyNumber.value, 1, 999);
	      const mechanic = (els.mechanic?.value || MECHANICS.lvpress);
	      return { playerLv, enemyLv, mechanic };
	    };

	    const syncInputs = () => {
	      const playerLv = clampInt(els.playerNumber.value, 1, 999);
	      const enemyLv = clampInt(els.enemyNumber.value, 1, 999);
	      els.playerNumber.value = String(playerLv);
	      els.playerRange.value = String(playerLv);
	      els.enemyNumber.value = String(enemyLv);
	      els.enemyRange.value = String(enemyLv);
	    };

	    const renderTable = () => {
	      const playerLv = clampInt(els.tablePlayer.value || els.playerNumber.value, 1, 999);
	      const mechanic = (els.tableMechanic?.value || els.mechanic?.value || MECHANICS.lvpress);

	      const rows = GAP_ROWS.map((gapWanted) => {
	        const enemyLv = Math.min(999, playerLv + gapWanted);
	        const gap = enemyLv - playerLv;
	        const ratio = playerLv > 0 ? gap / playerLv : 0;

	        const { outgoingPct, incomingMult } = computeValues(playerLv, enemyLv, mechanic);
	        const outgoingRounded = Math.round(outgoingPct);
	        const sevKey = calcAlpha.getSeverity(outgoingPct);
	        const sev = severityMeta[sevKey] || severityMeta.safe;

	        const capNote = playerLv + gapWanted > 999 ? " (capped)" : "";
	        const incomingText = mechanic === MECHANICS.alpha ? "n/a" : `${(incomingMult ?? 1).toFixed(2)}×`;

	        return `
	          <tr data-severity="${sevKey}">
	            <td>L${enemyLv}${capNote}</td>
	            <td>${formatSigned(gap)}</td>
	            <td>${(ratio * 100).toFixed(1)}%</td>
	            <td><span class="dc-cell-pill" style="background:${sev.color}">${outgoingRounded}%</span></td>
	            <td>${incomingText}</td>
	            <td>${sev.pill}</td>
	          </tr>
	        `;
	      }).join("");

	      els.tableBody.innerHTML = rows;
	    };

	    const updateCalculator = () => {
	      syncInputs();
	      const { playerLv, enemyLv, mechanic } = getState();
	      setMechanicHelp(mechanic);

	      // Keep table mechanic select in sync (and vice versa)
	      if (els.tableMechanic && els.tableMechanic.value !== mechanic) {
	        els.tableMechanic.value = mechanic;
	      }

	      const { outgoingPct, incomingMult, gap, ratio, modelTag } = computeValues(playerLv, enemyLv, mechanic);
	      const outgoingRounded = Math.round(outgoingPct);

	      els.damage.textContent = `${outgoingRounded}%`;
	      els.modelTag.textContent = modelTag;

	      els.progressFill.style.width = `${Math.max(0, Math.min(100, outgoingPct))}%`;
	      els.gap.textContent = `${formatSigned(gap)} levels`;
	      els.ratio.textContent = formatPct(ratio * 100, 1);

	      if (mechanic === MECHANICS.alpha) {
	        els.progressText.textContent = `${outgoingRounded}% outgoing damage (engine approx.)`;
	        els.incoming.textContent = "n/a";
	        els.incoming.title = "Incoming damage is also affected in-game but is not yet modeled for this engine-approximation mode.";
	      } else if (mechanic === MECHANICS.none) {
	        els.progressText.textContent = "No level scaling → 100% outgoing";
	        els.incoming.textContent = "1.00×";
	        els.incoming.title = "No incoming scaling in this mode.";
	      } else {
	        els.progressText.textContent = `${outgoingRounded}% outgoing damage (config)`;
	        els.incoming.textContent = `${(incomingMult ?? 1).toFixed(2)}×`;
	        const takenPct = ((incomingMult ?? 1) * 100).toFixed(0);
	        els.incoming.title = `Incoming damage taken ≈ ${takenPct}% (config-derived)`;
	      }

	      applySeverity(outgoingPct);

	      // Keep table player control in sync
	      if (els.tablePlayer && els.tablePlayer.value !== String(playerLv)) {
	        els.tablePlayer.value = String(playerLv);
	      }

	      renderTable();
	    };

	    const setTab = (tabKey) => {
	      els.tabButtons.forEach((btn) => {
	        const active = btn.dataset.dcTab === tabKey;
	        btn.classList.toggle("is-active", active);
	        btn.setAttribute("aria-selected", active ? "true" : "false");
	        btn.tabIndex = active ? 0 : -1;
	      });

	      els.panels.forEach((panel) => {
	        const active = panel.dataset.dcPanel === tabKey;
	        panel.classList.toggle("is-hidden", !active);
	        panel.hidden = !active;
	      });
	    };

	    // Populate table player dropdown
	    const options = [];
	    for (let i = 1; i <= 999; i++) options.push(`<option value="${i}">${i}</option>`);
	    els.tablePlayer.innerHTML = options.join("");
	    els.tablePlayer.value = String(clampInt(els.playerNumber.value, 1, 999));
	    els.tableMechanic.value = els.mechanic.value || MECHANICS.lvpress;

	    // Events: tabs
	    els.tabButtons.forEach((btn) => {
	      btn.addEventListener("click", () => setTab(btn.dataset.dcTab || "calculator"));
	      btn.addEventListener("keydown", (e) => {
	        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
	        e.preventDefault();
	        const list = Array.from(els.tabButtons);
	        const idx = list.indexOf(btn);
	        const nextIdx = e.key === "ArrowRight" ? (idx + 1) % list.length : (idx - 1 + list.length) % list.length;
	        list[nextIdx]?.focus();
	        list[nextIdx]?.click();
	      });
	    });

	    // Events: calculator inputs
	    els.playerRange.addEventListener("input", () => {
	      els.playerNumber.value = els.playerRange.value;
	      updateCalculator();
	    });
	    els.enemyRange.addEventListener("input", () => {
	      els.enemyNumber.value = els.enemyRange.value;
	      updateCalculator();
	    });
	    els.playerNumber.addEventListener("input", () => updateCalculator());
	    els.enemyNumber.addEventListener("input", () => updateCalculator());
	    els.mechanic.addEventListener("change", () => updateCalculator());

	    els.presetEqual.addEventListener("click", () => {
	      syncInputs();
	      els.enemyNumber.value = els.playerNumber.value;
	      updateCalculator();
	      setToast("Set to equal level");
	    });

	    // Events: table controls
	    els.tablePlayer.addEventListener("change", () => {
	      els.playerNumber.value = els.tablePlayer.value;
	      updateCalculator();
	    });
	    els.tableMechanic.addEventListener("change", () => {
	      els.mechanic.value = els.tableMechanic.value;
	      updateCalculator();
	    });

		    // Initial paint
		    updateCalculator();
