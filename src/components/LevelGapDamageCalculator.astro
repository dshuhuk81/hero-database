---
import { readFileSync } from "node:fs";

type LvPressingRow = {
  outMult: number;
  inMult: number;
  realOutMult: number;
  reduceFix: number;
  increaseFix: number;
  realReduceFix: number;
};

type LvPressingData = {
  base: number;
  maxDiff: number;
  rows: Record<number, LvPressingRow>;
};

function parseLvPressingLua(): LvPressingData | null {
  try {
    const fileUrl = new URL(
      "../../leak/game_extracted/region_754c000000/NewConfig/battle/lv_pressing.lua",
      import.meta.url,
    );
    const src = readFileSync(fileUrl, "utf-8");

    const blocks = new Map<number, Record<string, number>>();
    const blockRe = /t\[(\d+)\]\s*=\s*\{([\s\S]*?)\n\}/g;
    let m: RegExpExecArray | null;
    while ((m = blockRe.exec(src))) {
      const idx = Number.parseInt(m[1] || "0", 10);
      const body = m[2] || "";
      const row: Record<string, number> = {};
      for (const line of body.split("\n")) {
        const trimmed = line.trim().replace(/,$/, "");
        if (!trimmed || !trimmed.includes("=")) continue;
        const [kRaw, vRaw] = trimmed.split("=", 2).map((s) => s.trim());
        if (!kRaw || !vRaw) continue;
        const num = Number(vRaw);
        if (Number.isFinite(num)) row[kRaw] = num;
      }
      if (Number.isFinite(idx)) blocks.set(idx, row);
    }

    const diffToBlock = new Map<number, number>();
    const mapRe = /\[(\d+)\]\s*=\s*t\[(\d+)\]/g;
    while ((m = mapRe.exec(src))) {
      const diff = Number.parseInt(m[1] || "0", 10);
      const block = Number.parseInt(m[2] || "0", 10);
      if (Number.isFinite(diff) && Number.isFinite(block)) diffToBlock.set(diff, block);
    }

    const base = 1024;
    const defaults = blocks.get(403) || {};
    const maxDiff = Math.max(0, ...Array.from(diffToBlock.keys()));

    const rows: Record<number, LvPressingRow> = {};
    rows[0] = { outMult: 1, inMult: 1, realOutMult: 1, reduceFix: 0, increaseFix: 0, realReduceFix: 0 };

    for (let diff = 1; diff <= maxDiff; diff++) {
      const blockId = diffToBlock.get(diff);
      const baseRow = blockId ? blocks.get(blockId) || {} : {};
      const merged = { ...defaults, ...baseRow };

      const reduceFix = Math.max(0, Math.round(Number(merged.reduce_damage_fix ?? 0)));
      const increaseFix = Math.max(0, Math.round(Number(merged.increase_damage_fix ?? 0)));
      const realReduceFix = Math.max(0, Math.round(Number(merged.real_reduce_damage_fix ?? 0)));

      const outMult = (base - reduceFix) / base;
      const inMult = (base + increaseFix) / base;
      const realOutMult = (base - realReduceFix) / base;

      rows[diff] = { outMult, inMult, realOutMult, reduceFix, increaseFix, realReduceFix };
    }

    return { base, maxDiff, rows };
  } catch {
    return null;
  }
}

const LV_PRESSING_DATA = parseLvPressingLua();
