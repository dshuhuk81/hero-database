---
import {
  getLocaleFromPathname,
  isLocalizedRoute,
  localeLabels,
  localeNames,
  locales,
  localizePath,
} from "../i18n/config";
import { t } from "../i18n/ui";

const locale = getLocaleFromPathname(Astro.url.pathname);
const showSwitcher = isLocalizedRoute(Astro.url.pathname);
---

{showSwitcher && (
  <nav class="language-switcher" aria-label={t(locale, "language", "label")}>
    {locales.map((entry) => (
      <a
        href={localizePath(Astro.url.pathname, entry)}
        class={`language-switcher-link ${entry === locale ? "is-active" : ""}`}
        aria-current={entry === locale ? "page" : undefined}
        title={localeNames[entry]}
      >
        {localeLabels[entry]}
      </a>
    ))}
  </nav>
)}

<style is:global>
  .language-switcher {
    position: fixed;
    z-index: var(--z-nav);
    top: var(--space-4);
    right: var(--space-4);
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: rgba(7, 6, 12, 0.82);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(14px);
  }

  .language-switcher-link {
    min-width: 34px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .language-switcher-link:hover,
  .language-switcher-link.is-active {
    color: var(--text-bright);
    background: var(--bg-raised);
  }

  @media (max-width: 768px) {
    .language-switcher {
      top: var(--space-3);
      right: var(--space-3);
    }
  }
</style>
