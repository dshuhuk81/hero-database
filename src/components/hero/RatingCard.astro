---
// src/components/hero/RatingCard.astro
interface Props {
  ratings: {
    overall?: string;
    grimSurge?: string;
    delusionsDen?: string;
    torrentRift?: string;
    pvp?: string;
    pve?: string;
  };
}

const { ratings } = Astro.props;

const ratingCategories = [
  { key: 'overall', label: 'Overall', icon: '' },
  { key: 'pve', label: 'PvE', icon: '' },
  { key: 'pvp', label: 'PvP', icon: ''},
  { key: 'grimSurge', label: 'Grim Surge', icon: '' },
  { key: 'delusionsDen', label: 'Delusions Den', icon: '' },
  { key: 'torrentRift', label: 'Torrent Rift', icon: '' },

];
---
<div class="ratings-section">
  <h2>Ratings</h2>
  
  <div class="ratings-grid">
    {ratingCategories.map(category => {
      const value = ratings[category.key] || 'N/A';
      return (
        <div class="rating-card">
          <div class="rating-content">
            <span class="rating-label">{category.label}</span>
            <span class={`rating-value rating-${value.toLowerCase()}`}>
              {value}
            </span>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  /* ===============================
     RATINGS SECTION
     =============================== */
  .ratings-section {
    margin-top: 64px;
  }

  .ratings-section h2 {
    margin-bottom: 24px;
    font-size: 1.75rem;
    font-weight: 600;
  }

  /* RATINGS GRID */
  .ratings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }

  /* RATING CARD */
  .rating-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .rating-card:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  /* CONTENT */
  .rating-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .rating-label {
    font-size: 0.875rem;
    color: rgba(230, 230, 235, 0.7);
    font-weight: 500;
    padding-bottom: 8px;
  }

  /* RATING VALUE */
  .rating-value {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1.125rem;
    text-align: center;
    width: fit-content;
  }

  /* RATING COLORS (unified with HeroCard via tokens) */
  .rating-value.rating-sss {
    background: linear-gradient(135deg, var(--tier-sss-from), var(--tier-sss-to));
    color: var(--tier-sss-text);
    box-shadow: 0 0 12px var(--tier-sss-glow);
  }

  .rating-value.rating-ss {
    background: linear-gradient(135deg, var(--tier-ss-from), var(--tier-ss-to));
    color: var(--tier-ss-text);
    box-shadow: 0 0 12px var(--tier-ss-glow);
  }

  .rating-value.rating-s {
    background: linear-gradient(135deg, var(--tier-s-from), var(--tier-s-to));
    color: var(--tier-s-text);
    box-shadow: 0 0 12px var(--tier-s-glow);
  }

  .rating-value.rating-a {
    background: linear-gradient(135deg, var(--tier-a-from), var(--tier-a-to));
    color: var(--tier-a-text);
  }

  .rating-value.rating-b {
    background: linear-gradient(135deg, var(--tier-b-from), var(--tier-b-to));
    color: var(--tier-b-text);
  }

  .rating-value.rating-c {
    background: linear-gradient(135deg, var(--tier-c-from), var(--tier-c-to));
    color: var(--tier-c-text);
  }

  .rating-value.rating-n\/a {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(230, 230, 235, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ===============================
     RESPONSIVE
     =============================== */
  @media (max-width: 768px) {
    .ratings-grid {
      grid-template-columns: 1fr;
    }

    .rating-card {
      padding: 16px;
    }

    .rating-value {
      font-size: 1rem;
      padding: 4px 12px;
    }
  }
</style>