---
// src/components/hero/RatingCard.astro
interface MetaSources {
  excelTier?: string;
  cnTier?: string;
  egTier?: string;
  consensus?: string;
  lastVerified?: string;
}

interface Props {
  ratings: {
    overall?: string;
    grimSurge?: string;
    delusionsDen?: string;
    torrentRift?: string;
    forgottenLabyrinth?: string;
    pvp?: string;
    pve?: string;
  };
  metaSources?: MetaSources;
}

const { ratings, metaSources } = Astro.props;

// Cast needed to allow string-key indexing in the template
const ratingsMap: Record<string, string | undefined> = ratings;

const ratingCategories = [
  { key: 'overall', label: 'Overall', icon: '' },
  { key: 'pve', label: 'PvE', icon: '' },
  { key: 'pvp', label: 'PvP', icon: ''},
  { key: 'grimSurge', label: 'Grim Surge', icon: '' },
  { key: 'delusionsDen', label: 'Delusions Den', icon: '' },
  { key: 'torrentRift', label: 'Torrent Rift', icon: '' },
  { key: 'forgottenLabyrinth', label: 'Forgotten Labyrinth', icon: '' }
];

const communitySources = metaSources ? [
  metaSources.excelTier ? { label: 'Excel Tier List', value: metaSources.excelTier } : null,
  metaSources.cnTier    ? { label: 'CN Community',   value: metaSources.cnTier }    : null,
  metaSources.egTier    ? { label: 'EG Community',   value: metaSources.egTier }    : null,
].filter(Boolean) : [];
---
<div class="ratings-section">
  <h2>Ratings</h2>

  <div class="ratings-grid">
    {ratingCategories.map(category => {
      const value = ratingsMap[category.key] || 'N/A';
      return (
        <div class="rating-card">
          <div class="rating-content">
            <span class="community-source-name">{category.label}</span>
            <span class={`rating-value rating-${value.toLowerCase()}`}>
              {value}
            </span>
          </div>
        </div>
      );
    })}
  </div>

  {metaSources && (
    <div class="community-sources">
      <div class="community-sources-header">
        <span class="community-sources-label">Community Sources</span>
        {metaSources.lastVerified && (
          <span class="community-sources-verified">Verified: {metaSources.lastVerified}</span>
        )}
      </div>
      <div class="community-sources-grid">
        {communitySources.map((src: any) => (
          <div class="community-source-item">
            <span class="community-source-name">{src.label}</span>
            <span class="community-source-tier">{src.value}</span>
          </div>
        ))}
        {metaSources.consensus && (
          <div class="community-source-item">
            <span class="community-source-name">Consensus</span>
            <span class={`community-consensus-badge consensus-${metaSources.consensus}`}>
              {metaSources.consensus}
            </span>
          </div>
        )}
      </div>
      <p class="community-sources-note">
        Community tiers use T0/T1/T2 notation -- independent of site ratings above.
      </p>
    </div>
  )}
</div>

<style>
  /* ===============================
     RATINGS SECTION
     =============================== */
  .ratings-section {
    margin-top: 64px;
  }

  .ratings-section h2 {
    margin-bottom: 24px;
    font-size: 1.75rem;
    font-weight: 600;
  }

  /* RATINGS GRID */
  .ratings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }

  /* RATING CARD */
  .rating-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .rating-card:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  /* CONTENT */
  .rating-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .rating-label {
    font-size: 0.875rem;
    color: rgba(230, 230, 235, 0.7);
    font-weight: 500;
    padding-bottom: 8px;
  }

  /* RATING VALUE */
  .rating-value {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1.125rem;
    text-align: center;
    width: fit-content;
  }

  /* RATING COLORS (unified with HeroCard via tokens) */
  .rating-value.rating-sss {
    background: linear-gradient(135deg, var(--tier-sss-from), var(--tier-sss-to));
    color: var(--tier-sss-text);
    box-shadow: 0 0 12px var(--tier-sss-glow);
  }

  .rating-value.rating-ss {
    background: linear-gradient(135deg, var(--tier-ss-from), var(--tier-ss-to));
    color: var(--tier-ss-text);
    box-shadow: 0 0 12px var(--tier-ss-glow);
  }

  .rating-value.rating-s {
    background: linear-gradient(135deg, var(--tier-s-from), var(--tier-s-to));
    color: var(--tier-s-text);
    box-shadow: 0 0 12px var(--tier-s-glow);
  }

  .rating-value.rating-a {
    background: linear-gradient(135deg, var(--tier-a-from), var(--tier-a-to));
    color: var(--tier-a-text);
  }

  .rating-value.rating-b {
    background: linear-gradient(135deg, var(--tier-b-from), var(--tier-b-to));
    color: var(--tier-b-text);
  }

  .rating-value.rating-c {
    background: linear-gradient(135deg, var(--tier-c-from), var(--tier-c-to));
    color: var(--tier-c-text);
  }

  .rating-value.rating-n\/a {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(230, 230, 235, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ===============================
     COMMUNITY SOURCES SUBSECTION
     =============================== */
  .community-sources {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .community-sources-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
  }

  .community-sources-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255, 255, 255, 0.45);
  }

  .community-sources-verified {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.3);
    font-style: italic;
  }

  .community-sources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
  }

  .community-source-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
  }

  .community-source-name {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.45);
  }

  .community-source-tier {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-bright);
    font-variant-numeric: tabular-nums;
  }

  .community-consensus-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    width: fit-content;
  }

  .consensus-full {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.35);
    color: #86efac;
  }

  .consensus-partial {
    background: rgba(234, 179, 8, 0.12);
    border: 1px solid rgba(234, 179, 8, 0.35);
    color: #fde68a;
  }

  .consensus-contested {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #fca5a5;
  }

  .community-sources-note {
    margin: 10px 0 0 0;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.3);
    font-style: italic;
  }

  /* ===============================
     RESPONSIVE
     =============================== */
  @media (max-width: 768px) {
    .ratings-grid {
      grid-template-columns: 1fr;
    }

    .rating-card {
      padding: 16px;
    }

    .rating-value {
      font-size: 1rem;
      padding: 4px 12px;
    }

    .community-sources-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
