  targetStandardNoRateUp: { en: "Standard: Wishlist hero, no Rate Up", de: "Standard: Wish-List-Held, ohne Rate Up", es: "Estándar: héroe de la lista, sin Rate Up", ru: "Стандарт: герой Wish List, без Rate Up" },
  targetStandardRateUp: { en: "Standard: Wishlist hero + Rate Up", de: "Standard: Wish-List-Held + Rate Up", es: "Estándar: héroe de la lista + Rate Up", ru: "Стандарт: герой Wish List + Rate Up" },
  targetSuitNoRateUp: { en: "Suit: Wishlist hero, no Rate Up", de: "Suit: Wish-List-Held, ohne Rate Up", es: "Traje: héroe de la lista, sin Rate Up", ru: "Suit: герой Wish List, без Rate Up" },
  targetSuitRateUp: { en: "Suit: Wishlist hero + Rate Up", de: "Suit: Wish-List-Held + Rate Up", es: "Traje: héroe de la lista + Rate Up", ru: "Suit: герой Wish List + Rate Up" },
  what100Title: { en: "What 100 Pulls Look Like", de: "So sehen 100 Pulls aus", es: "Cómo se ven 100 tiradas", ru: "Как выглядят 100 призывов" },
  amityCardTitle: { en: "Amity", de: "Amity", es: "Amity", ru: "Amity" },
  amityCardRate: { en: "3% for any Epic", de: "3 % für irgendein Epic", es: "3% por cualquier Épica", ru: "3% за любой Epic" },
  amityExpected: { en: "Expected: 3 Epics", de: "Erwartet: 3 Epics", es: "Esperado: 3 Épicas", ru: "Ожидается: 3 Epic" },
  amityNormalRange: { en: "Normal range: 1-5 Epics for 87% of players", de: "Normalbereich: 1-5 Epics für 87 % der Spieler", es: "Rango normal: 1-5 Épicas para el 87% de los jugadores", ru: "Обычный диапазон: 1-5 Epic у 87% игроков" },
  amityNoEpic: { en: "No Epic: 4.8%", de: "Kein Epic: 4,8 %", es: "Sin Épica: 4,8%", ru: "Без Epic: 4,8%" },
  standardNoRateTitle: { en: "Standard without Rate Up", de: "Standard ohne Rate Up", es: "Estándar sin Rate Up", ru: "Стандарт без Rate Up" },
  standardNoRateRate: { en: "0.29% for one Wishlist hero", de: "0,29 % für einen Wish-List-Helden", es: "0,29% para un héroe de la lista", ru: "0,29% на одного героя Wish List" },
  standardNoRateExpected: { en: "Expected: 0.29 copies", de: "Erwartet: 0,29 Kopien", es: "Esperado: 0,29 copias", ru: "Ожидается: 0,29 копии" },
  standardNoRateMiss: { en: "No target copy: 75%", de: "Keine Zielkopie: 75 %", es: "Sin copia objetivo: 75%", ru: "Без нужной копии: 75%" },
  standardNoRateAtLeast: { en: "At least one copy: only 25%", de: "Mindestens eine Kopie: nur 25 %", es: "Al menos una copia: solo 25%", ru: "Хотя бы одна копия: только 25%" },
  standardRateTitle: { en: "Standard + Rate Up", de: "Standard + Rate Up", es: "Estándar + Rate Up", ru: "Стандарт + Rate Up" },
  standardRateRate: { en: "2.0% for the target hero", de: "2,0 % für den Zielhelden", es: "2,0% para el héroe objetivo", ru: "2,0% на целевого героя" },
  standardRateExpected: { en: "Expected: 2 copies", de: "Erwartet: 2 Kopien", es: "Esperado: 2 copias", ru: "Ожидается: 2 копии" },
  standardRateNormal: { en: "Normal range: 0-4 copies for 95% of players", de: "Normalbereich: 0-4 Kopien für 95 % der Spieler", es: "Rango normal: 0-4 copias para el 95% de los jugadores", ru: "Обычный диапазон: 0-4 копии у 95% игроков" },
  standardRateMiss: { en: "No target copy: 13.3%", de: "Keine Zielkopie: 13,3 %", es: "Sin copia objetivo: 13,3%", ru: "Без нужной копии: 13,3%" },
  suitNoRateTitle: { en: "Suit without Rate Up", de: "Suit ohne Rate Up", es: "Traje sin Rate Up", ru: "Suit без Rate Up" },
  suitNoRateRate: { en: "1.875% for one Wishlist hero", de: "1,875 % für einen Wish-List-Helden", es: "1,875% para un héroe de la lista", ru: "1,875% на одного героя Wish List" },
  suitNoRateExpected: { en: "Expected: 1-2 copies", de: "Erwartet: 1-2 Kopien", es: "Esperado: 1-2 copias", ru: "Ожидается: 1-2 копии" },
  suitNoRateNormal: { en: "Normal range: 0-4 copies for 96% of players", de: "Normalbereich: 0-4 Kopien für 96 % der Spieler", es: "Rango normal: 0-4 copias para el 96% de los jugadores", ru: "Обычный диапазон: 0-4 копии у 96% игроков" },
  suitNoRateMiss: { en: "No target copy: 15%", de: "Keine Zielkopie: 15 %", es: "Sin copia objetivo: 15%", ru: "Без нужной копии: 15%" },
  suitRateTitle: { en: "Suit + Rate Up", de: "Suit + Rate Up", es: "Traje + Rate Up", ru: "Suit + Rate Up" },
  suitRateRate: { en: "3.6% for the target hero", de: "3,6 % für den Zielhelden", es: "3,6% para el héroe objetivo", ru: "3,6% на целевого героя" },
  suitRateExpected: { en: "Expected: 3-4 copies", de: "Erwartet: 3-4 Kopien", es: "Esperado: 3-4 copias", ru: "Ожидается: 3-4 копии" },
  suitRateNormal: { en: "Normal range: 1-6 copies for 90% of players", de: "Normalbereich: 1-6 Kopien für 90 % der Spieler", es: "Rango normal: 1-6 copias para el 90% de los jugadores", ru: "Обычный диапазон: 1-6 копий у 90% игроков" },
  suitRateAtLeast: { en: "At least one copy: 97.4%", de: "Mindestens eine Kopie: 97,4 %", es: "Al menos una copia: 97,4%", ru: "Хотя бы одна копия: 97,4%" },
  noTargetTitle: { en: "What does “no target copy” mean?", de: "Was bedeutet „keine Zielkopie“?", es: "¿Qué significa “sin copia objetivo”?", ru: "Что значит «без нужной копии»?" },
  noTargetBody: { en: "It does not mean that all 100 pulls give you nothing. It means that none of those pulls contains the one specific hero you are targeting. Every other hero pulled is irrelevant to this calculation.", de: "Das bedeutet nicht, dass dir alle 100 Pulls nichts geben. Es bedeutet, dass keiner dieser Pulls den einen bestimmten Helden enthält, auf den du zielst. Jeder andere gezogene Held ist für diese Rechnung egal.", es: "No significa que las 100 tiradas no te den nada. Significa que ninguna de esas tiradas contiene al héroe específico que estás buscando. Cualquier otro héroe obtenido no cuenta para este cálculo.", ru: "Это не значит, что все 100 призывов дадут ничего. Это значит, что ни один из них не содержит именно того героя, которого ты ищешь. Любой другой герой в расчёт не идёт." },
  whyRateUpTitle: { en: "Why Rate Up Helps Standard More", de: "Warum Rate Up Standard stärker hilft", es: "Por qué Rate Up ayuda más a Estándar", ru: "Почему Rate Up сильнее помогает стандарту" },
  whyRateUpBody: { en: "Standard spreads its 4.6% Wishlist chance across 16 heroes, so one hero starts at only about 0.29%. Suit summons split 7.5% between only 4 heroes and therefore already start at 1.875% per hero.", de: "Standard verteilt seine 4,6 %-Wish-List-Chance auf 16 Helden, daher startet ein Held nur bei etwa 0,29 %. Suit-Beschwörungen teilen 7,5 % auf nur 4 Helden auf und starten daher schon bei 1,875 % pro Held.", es: "Estándar reparte su 4,6% de probabilidad de la lista entre 16 héroes, así que un héroe empieza con solo alrededor de 0,29%. Las invocaciones de traje dividen el 7,5% entre solo 4 héroes y por eso ya empiezan en 1,875% por héroe.", ru: "Стандарт делит шанс Wish List 4,6% между 16 героями, поэтому один герой стартует лишь с ~0,29%. Призывы Suit делят 7,5% только между 4 героями и потому стартуют с 1,875% на героя." },
  boostSummon: { en: "Summon", de: "Beschwörung", es: "Invocación", ru: "Призыв" },
  withoutRateUp: { en: "Without Rate Up", de: "Ohne Rate Up", es: "Sin Rate Up", ru: "Без Rate Up" },
  withRateUp: { en: "With Rate Up", de: "Mit Rate Up", es: "Con Rate Up", ru: "С Rate Up" },
  relativeBoost: { en: "Relative boost", de: "Relative Verstärkung", es: "Mejora relativa", ru: "Относительный буст" },
  rateUpFootnote: { en: "Rate Up gives Standard the larger relative improvement because its starting chance is so low. Suit + Rate Up still has the better absolute target chance: 3.6% instead of 2.0%.", de: "Rate Up bringt bei Standard die größere relative Verbesserung, weil die Ausgangschance so niedrig ist. Suit + Rate Up hat trotzdem die bessere absolute Zielchance: 3,6 % statt 2,0 %.", es: "Rate Up da a Estándar una mejora relativa mayor porque su probabilidad inicial es muy baja. Aun así, Traje + Rate Up sigue teniendo la mejor probabilidad absoluta: 3,6% en lugar de 2,0%.", ru: "Rate Up даёт стандарту больший относительный прирост, потому что начальный шанс очень низкий. Но Suit + Rate Up всё равно даёт лучший абсолютный шанс: 3,6% вместо 2,0%." },
  bestStrategyTitle: { en: "Best Strategy for a Specific New Hero", de: "Beste Strategie für einen bestimmten neuen Helden", es: "Mejor estrategia para un héroe nuevo concreto", ru: "Лучшая стратегия для конкретного нового героя" },
  bestStrategy1: { en: "Wait for Rate Up.", de: "Warte auf Rate Up.", es: "Espera al Rate Up.", ru: "Жди Rate Up." },
  bestStrategy2: { en: "Put the hero on the Wishlist for the matching Suit.", de: "Setze den Helden auf die Wish List für den passenden Suit.", es: "Pon al héroe en la lista para el traje correspondiente.", ru: "Поставь героя в Wish List для подходящего Suit." },
  bestStrategy3: { en: "Use Suit summons during Rate Up: 100 pulls yield 3-4 copies on average, with a 97.4% chance of at least one copy.", de: "Nutze Suit-Beschwörungen während Rate Up: 100 Pulls ergeben im Schnitt 3-4 Kopien, mit 97,4 % Chance auf mindestens eine Kopie.", es: "Usa invocaciones de traje durante Rate Up: 100 tiradas dan 3-4 copias de media, con un 97,4% de probabilidad de obtener al menos una copia.", ru: "Используй Suit-призывы во время Rate Up: 100 призывов в среднем дают 3-4 копии, с шансом 97,4% получить хотя бы одну." },
  bestStrategy4: { en: "Avoid Standard summons without Rate Up when targeting one hero: the chance of missing that hero after 100 pulls is about 75%.", de: "Vermeide Standard-Beschwörungen ohne Rate Up, wenn du auf einen Helden zielst: Die Chance, diesen Helden nach 100 Pulls zu verpassen, liegt bei etwa 75 %.", es: "Evita las invocaciones estándar sin Rate Up cuando busques un héroe: la probabilidad de no conseguirlo tras 100 tiradas es de aproximadamente 75%.", ru: "Избегай стандартных призывов без Rate Up, если целишься в одного героя: шанс не получить его после 100 призывов около 75%." },
  shopPriorityTitle: { en: "Shop Priority", de: "Shop-Priorität", es: "Prioridad de tienda", ru: "Приоритет магазина" },
  shopItem: { en: "Item", de: "Gegenstand", es: "Objeto", ru: "Предмет" },
  shopAction: { en: "Action", de: "Aktion", es: "Acción", ru: "Действие" },
  regularStore: { en: "Regular Store - 30% off", de: "Normale Laden - 30 % Rabatt", es: "Tienda normal - 30% de descuento", ru: "Обычный магазин - скидка 30%" },
  reversionShop: { en: "Reversion Shop", de: "Reversion-Shop", es: "Tienda de Reversión", ru: "Магазин Reversion" },
  randomGear: { en: "Random Gear", de: "Zufalls-Equipment", es: "Equipo aleatorio", ru: "Случайный экип" },
  oneCopyTitle: { en: "One-Copy Wonders", de: "Ein-Kopie-Wunder", es: "Maravillas de una copia", ru: "Чудеса одной копии" },
  oneCopyIntro: { en: "These are deities that can fulfill their role at Elite rarity in the Early Game. Get a copy early - most are supports. The order depends on which heroes you summon more of.", de: "Das sind Gottheiten, die ihre Rolle im Early Game schon auf Elite-Rarität erfüllen können. Hol dir früh eine Kopie - die meisten sind Supports. Die Reihenfolge hängt davon ab, welche Helden du häufiger ziehst.", es: "Estas son deidades que pueden cumplir su función en rareza Élite en la fase temprana. Consigue una copia pronto: la mayoría son supports. El orden depende de qué héroes obtengas más.", ru: "Это божества, которые могут выполнять свою роль на редкости Elite уже в ранней игре. Получи копию пораньше - большинство из них саппорты. Порядок зависит от того, кого ты чаще призываешь." },
  oneCopyNote: { en: "Most support heroes also qualify as one-copy wonders. Focus on heroes you have the most copies of.", de: "Die meisten Support-Helden zählen ebenfalls dazu. Konzentriere dich auf Helden, von denen du die meisten Kopien hast.", es: "La mayoría de los héroes de support también cuentan como maravillas de una copia. Céntrate en los héroes de los que tengas más copias.", ru: "Большинство саппортов тоже сюда подходят. Делай упор на тех героев, копий которых у тебя больше всего." },
  ascensionTipsTitle: { en: "Ascension Tips", de: "Aufstiegs-Tipps", es: "Consejos de ascensión", ru: "Советы по возвышению" },
  ascension1: { en: "Avoid using regular ascended-grade deities as fodder. Only use Zodiac deities as fodder.", de: "Verwende gewöhnliche Ascended-Gottheiten nicht als Futter. Nutze nur Zodiac-Gottheiten als Futter.", es: "Evita usar deidades ascendidas normales como material. Usa solo deidades Zodiac como material.", ru: "Не используй обычных божеств ascended-уровня как корм. Используй только Zodiac-божеств как корм." },
  ascension2: { en: "Focus on building one hero per faction at a time to avoid spreading fodder too thin.", de: "Konzentriere dich darauf, pro Fraktion jeweils nur einen Helden zu bauen, damit sich das Futter nicht zu sehr verteilt.", es: "Céntrate en construir un héroe por facción a la vez para no repartir el material demasiado.", ru: "Сосредоточься на одном герое на фракцию, чтобы не распылять корм слишком сильно." },
  ascension3: { en: "You can start building a deity once you have 2 Elite+ copies (Zodiacs) - that is enough to reach Mythic.", de: "Du kannst mit dem Aufbau einer Gottheit beginnen, sobald du 2 Elite+-Kopien (Zodiacs) hast - das reicht bis Mythic.", es: "Puedes empezar a construir una deidad cuando tengas 2 copias Élite+ (Zodiacs): eso basta para llegar a Mythic.", ru: "Можно начинать собирать божество, когда у тебя есть 2 копии Elite+ (Zodiac) - этого хватит, чтобы дойти до Mythic." },
  ascension4: { en: "Some deities do not perform well until they reach Divine, so wait for four copies to ascend them right away.", de: "Einige Gottheiten funktionieren erst ab Divine wirklich gut, also warte auf vier Kopien, um sie direkt weiter aufzusteigen.", es: "Algunas deidades no rinden bien hasta llegar a Divine, así que espera cuatro copias para ascenderlas de una vez.", ru: "Некоторые божества плохо работают до Divine, так что жди четырёх копий, чтобы сразу поднять их дальше." },
  ascension5: { en: "Once a deity reaches Mythic, they no longer require fodder (only the deity itself).", de: "Sobald eine Gottheit Mythic erreicht, braucht sie kein Futter mehr (nur noch die Gottheit selbst).", es: "Una vez que una deidad llega a Mythic, ya no necesita material (solo la propia deidad).", ru: "После Mythic божеству больше не нужен корм (только само божество)." },
  ascension6: { en: "Zodiac deities cap at Legendary+. Only ascend a Zodiac to Legendary if you have 2 extra copies to use as fodder.", de: "Zodiac-Gottheiten enden bei Legendary+. Steige einen Zodiac nur bis Legendary auf, wenn du 2 zusätzliche Kopien als Futter hast.", es: "Las deidades Zodiac llegan hasta Legendary+. Solo asciende un Zodiac a Legendary si tienes 2 copias extra para usar como material.", ru: "Zodiac-божества упираются в Legendary+. Поднимай Zodiac до Legendary только если у тебя есть 2 лишние копии на корм." },
  factionSummonsTitle: { en: "Faction Summons", de: "Fraktions-Beschwörungen", es: "Invocaciones de facción", ru: "Призывы фракции" },
  factionSummonsIntro: { en: "In the early phase your main carry and good supports are your primary targets. Spend your feathers on heroes you are missing or that you need to level up for progression.", de: "In der frühen Phase sind dein Haupt-Carry und gute Supports deine wichtigsten Ziele. Gib deine Federn für Helden aus, die dir fehlen oder die du für den Fortschritt hochleveln musst.", es: "En la fase temprana tu carry principal y buenos supports son tus objetivos principales. Gasta tus plumas en héroes que te faltan o que necesitas subir para progresar.", ru: "В ранней фазе твой главный керри и хорошие саппорты — основные цели. Трать перья на тех героев, которых тебе не хватает или кого нужно прокачать для прогресса." },
  factionSummonsPriority: { en: "Priority order: Carry > Support > Tank", de: "Priorität: Carry > Support > Tank", es: "Orden de prioridad: Carry > Support > Tank", ru: "Приоритет: Carry > Support > Tank" },
  factionSummonsPity: { en: "Suit Pity guarantees an Epic deity by pull 20. Its counter resets when a Suit Epic appears and does not transfer to Standard summons or another summon type.", de: "Suit-Pity garantiert eine Epic-Gottheit bis Pull 20. Der Zähler setzt sich zurück, wenn ein Suit-Epic erscheint, und wird nicht auf Standard- oder andere Beschwörungsarten übertragen.", es: "El pity de traje garantiza una deidad Épica antes de la tirada 20. El contador se reinicia cuando aparece una Épica de traje y no se transfiere a invocaciones estándar ni a otro tipo.", ru: "Suit pity гарантирует Epic-божество к 20-му призыву. Счётчик сбрасывается, когда выпадает Suit Epic, и не переносится на стандартные или другие типы." },
  factionSummonsCallout: { en: "The Wish List also applies to Faction summons. It is recommended to save faction feathers for the upcoming banner event - this happens every 2 weeks.", de: "Die Wish List gilt auch für Fraktions-Beschwörungen. Es wird empfohlen, Fraktionsfedern für das kommende Banner-Event aufzuheben - das passiert alle 2 Wochen.", es: "La Wish List también se aplica a las invocaciones de facción. Se recomienda guardar plumas de facción para el próximo evento de banner, que ocurre cada 2 semanas.", ru: "Wish List действует и на призывы фракции. Рекомендуется копить фракционные перья к следующему баннер-ивенту - он бывает каждые 2 недели." },
  chronosTitle: { en: "Chronos Chamber", de: "Chronos-Kammer", es: "Cámara de Chronos", ru: "Камера Хроноса" },
  chronosIntro: { en: "Unlocks after a total of 750 summons. Within the Chronos Chamber you can summon Starglint Deities using Star Tracer currency. You can specify which deity you want to summon.", de: "Schaltet sich nach insgesamt 750 Beschwörungen frei. In der Chronos-Kammer kannst du Starglint-Gottheiten mit der Währung Star Tracer beschwören. Du kannst auswählen, welche Gottheit du beschwören willst.", es: "Se desbloquea tras un total de 750 invocaciones. Dentro de la Cámara de Chronos puedes invocar deidades Starglint usando la moneda Star Tracer. Puedes especificar qué deidad quieres invocar.", ru: "Открывается после 750 призывов в сумме. В Камере Хроноса можно призывать Starglint-божеств за валюту Star Tracer. Ты можешь выбрать, какого бога призывать." },
  chronosRecommendationTitle: { en: "Recommended Order", de: "Empfohlene Reihenfolge", es: "Orden recomendado", ru: "Рекомендуемый порядок" },
  chronosRecommendationBody: { en: "Go for Nyx first - after that go for Zeus all the way. Zeus is the best damage-dealing hero for all modes, but needs Divine ascension and Relic Level 30 to be fully upgraded.", de: "Nimm zuerst Nyx - danach dann durchgehend Zeus. Zeus ist in allen Modi der beste Schadensheld, braucht aber Divine-Aufstieg und Relic Level 30, um voll ausgebaut zu sein.", es: "Ve primero por Nyx y después sigue con Zeus hasta el final. Zeus es el mejor héroe de daño para todos los modos, pero necesita ascensión Divine y Reliquia nivel 30 para estar totalmente mejorado.", ru: "Сначала бери Nyx, а потом целенаправленно Zeus. Зевс — лучший дамагер для всех режимов, но ему нужны Divine-возвышение и Relic Level 30 для полного раскрытия." },
  chronosPityTitle: { en: "Pity System", de: "Pity-System", es: "Sistema de pity", ru: "Система pity" },
  chronosPity1: { en: "You will get the Starglint deity every 40 summons guaranteed.", de: "Alle 40 Beschwörungen erhältst du garantiert eine Starglint-Gottheit.", es: "Obtendrás garantizada una deidad Starglint cada 40 invocaciones.", ru: "Каждые 40 призывов ты гарантированно получаешь Starglint-божество." },
  chronosPity2: { en: "After doing 30 summons you can switch to single pulls to save resources until getting the deity.", de: "Nach 30 Beschwörungen kannst du auf Einzelpulls wechseln, um Ressourcen zu sparen, bis du die Gottheit bekommst.", es: "Después de 30 invocaciones puedes cambiar a tiradas individuales para ahorrar recursos hasta obtener la deidad.", ru: "После 30 призывов можно переключиться на одиночные, чтобы экономить ресурсы, пока не выпадет божество." },
  starglintTitle: { en: "Starglint and Mindsea", de: "Starglint und Mindsea", es: "Starglint y Mindsea", ru: "Starglint и Mindsea" },
  starglintIntro: { en: "The Starglint faction has the most rare heroes. They can only be obtained through their special currency \"Star Tracer\", regular summons (0.2% drop chance) or in the Mindsea shop.", de: "Die Starglint-Fraktion hat die seltensten Helden. Sie sind nur über die Spezialwährung \"Star Tracer\", normale Beschwörungen (0,2 % Dropchance) oder im Mindsea-Shop erhältlich.", es: "La facción Starglint tiene los héroes más raros. Solo se pueden obtener mediante su moneda especial \"Star Tracer\", invocaciones normales (0,2% de probabilidad) o en la tienda de Mindsea.", ru: "Во фракции Starglint самые редкие герои. Их можно получить только за специальную валюту \"Star Tracer\", из обычных призывов (0,2% шанс) или в магазине Mindsea." },
  mindseaJoinTitle: { en: "Join a Mindsea as Early as Possible", de: "Tritt so früh wie möglich einer Mindsea bei", es: "Únete a una Mindsea lo antes posible", ru: "Вступи в Mindsea как можно раньше" },
  mindseaJoinBody: { en: "After completing Stage 3-9 you can join a Mindsea. Open the list and search for an open Mindsea with a high activity rate. Collect \"Dream Conch\" rewards within the Mindsea Currents of Thought. Then you can buy a Starglint deity in the Mindsea shop.", de: "Nach Abschluss von Stage 3-9 kannst du einer Mindsea beitreten. Öffne die Liste und suche nach einer offenen Mindsea mit hoher Aktivität. Sammle \"Dream Conch\"-Belohnungen in den Mindsea Currents of Thought. Danach kannst du eine Starglint-Gottheit im Mindsea-Shop kaufen.", es: "Tras completar la etapa 3-9 puedes unirte a una Mindsea. Abre la lista y busca una Mindsea abierta con una alta tasa de actividad. Recoge recompensas \"Dream Conch\" dentro de Mindsea Currents of Thought. Luego puedes comprar una deidad Starglint en la tienda de Mindsea.", ru: "После прохождения Stage 3-9 можно вступить в Mindsea. Открой список и ищи открытую Mindsea с высокой активностью. Собирай награды \"Dream Conch\" в Mindsea Currents of Thought. Затем можно купить Starglint-божество в магазине Mindsea." },
  starglintPicksTitle: { en: "Get One of These", de: "Hol dir einen davon", es: "Consigue uno de estos", ru: "Возьми одного из этих" },
  coreRuleTitle: { en: "The Core Rule of the Game", de: "Die Grundregel des Spiels", es: "La regla básica del juego", ru: "Базовое правило игры" },
  coreRuleBody: { en: "You are not building 5 equal heroes.", de: "Du baust nicht 5 gleich starke Helden.", es: "No estás construyendo 5 héroes iguales.", ru: "Ты не собираешь 5 равных героев." },
  carryLabel: { en: "1-2 Carries", de: "1-2 Carries", es: "1-2 carries", ru: "1-2 керри" },
  carryDesc: { en: "Deal the damage. Get the gear, the relics, the investment.", de: "Sie machen den Schaden. Sie bekommen das Gear, die Relikte und die Investition.", es: "Hacen el daño. Reciben el equipo, las reliquias y la inversión.", ru: "Они наносят урон. Им достаются экипировка, реликвии и инвестиции." },
  supportLabel: { en: "3-4 Supports", de: "3-4 Supports", es: "3-4 supports", ru: "3-4 саппорта" },
  supportDesc: { en: "Give the carry energy, buffs, and uptime. They exist to enable the carry.", de: "Sie geben dem Carry Energie, Buffs und Uptime. Sie sind dafür da, den Carry zu ermöglichen.", es: "Dan energía, buffs y presencia al carry. Existen para habilitar al carry.", ru: "Они дают керри энергию, бафы и время действия. Их задача - раскрывать керри." },
  coreExample: { en: "Example: if Isis is your carry, you need supports to give her energy, healing and buffs to deal faster damage and use her ultimate more often than the enemy team does.", de: "Beispiel: Wenn Isis dein Carry ist, brauchst du Supports, die ihr Energie, Heilung und Buffs geben, damit sie schneller Schaden macht und ihre Ultimate öfter einsetzen kann als das Gegnerteam.", es: "Ejemplo: si Isis es tu carry, necesitas supports que le den energía, curación y buffs para infligir daño más rápido y usar su ultimate más veces que el equipo enemigo.", ru: "Пример: если Исида твой керри, нужны саппорты, которые дают ей энергию, лечение и бафы, чтобы она наносила урон быстрее и чаще ультила, чем команда противника." },
  wishListTitle: { en: "Wish List - Your Free Early Picks", de: "Wish List - Deine kostenlosen frühen Picks", es: "Wish List - tus picks gratuitos iniciales", ru: "Wish List - твои бесплатные ранние выборы" },
  wishListIntro: { en: "The Wish List lets you influence which hero you pull in each faction. Pick wrong and your gold pinions feed the wrong hero. These are the recommended F2P picks per faction:", de: "Mit der Wish List kannst du beeinflussen, welchen Helden du pro Fraktion ziehst. Wählst du falsch, füttern deine goldenen Federn den falschen Helden. Das sind die empfohlenen F2P-Picks pro Fraktion:", es: "La Wish List te permite influir en qué héroe obtienes en cada facción. Si eliges mal, tus plumas doradas alimentan al héroe equivocado. Estas son las opciones F2P recomendadas por facción:", ru: "Wish List позволяет влиять на то, какого героя ты получишь в каждой фракции. Выберешь неправильно - золотые перья уйдут не тому герою. Вот рекомендованные F2P-выборы по фракциям:" },
  wishListHeaderTitle: { en: "Wishlist", de: "Wish List", es: "Lista de deseos", ru: "Wish List" },
  wishListHeaderSubtitle: { en: "Have a higher chance to get Deities in the Wishlist while summoning Epic Deities.", de: "Du hast eine höhere Chance, Gottheiten aus der Wish List zu bekommen, während du Epic-Gottheiten beschwörst.", es: "Tienes más probabilidad de obtener deidades en la lista mientras invocas deidades Épicas.", ru: "У тебя выше шанс получить божеств из Wish List при призыве Epic-божеств." },
  wishListHeaderNote: { en: "Does not change Epic Deities overall drop rate.", de: "Ändert nicht die Gesamt-Dropchance für Epic-Gottheiten.", es: "No cambia la tasa global de aparición de deidades Épicas.", ru: "Не меняет общий шанс выпадения Epic-божеств." },
  wishListFooter: { en: "Fengyi can be swapped with Wenshen later. Also Phoenix with Set.", de: "Fengyi kann später gegen Wenshen getauscht werden. Ebenso Phoenix gegen Set.", es: "Fengyi puede cambiarse más adelante por Wenshen. También Phoenix por Set.", ru: "Фэнъи позже можно заменить на Вэньшэня. А также Феникса на Сета." },
} satisfies Record<string, LocalizedString>;
---
    <!-- SUB-TAB: EARLY GAME -->
    <div id="subtab-early" class="tips-panel" role="tabpanel" tabindex="0" aria-labelledby="subtab-btn-early" hidden>
      <main class="eg-main-content">

      <!-- JUMPBAR -->
      <nav class="tips-jumpbar" aria-label={pickLang(c.jumpLabel, locale)}>
        <span class="tips-jump-label">{pickLang(c.jumpLabel, locale)}</span>
        <a href="#section-f2p" class="tips-jump-link">{pickLang(c.jumpF2p, locale)}</a>
        <a href="#section-first" class="tips-jump-link">{pickLang(c.jumpFirst, locale)}</a>
        <a href="#section-odyssey" class="tips-jump-link">{pickLang(c.jumpOdyssey, locale)}</a>
        <a href="#section-summons" class="tips-jump-link">{pickLang(c.jumpSummons, locale)}</a>
        <a href="#section-chronos" class="tips-jump-link">{pickLang(c.jumpChronos, locale)}</a>
        <a href="#section-mindsea" class="tips-jump-link">{pickLang(c.jumpMindsea, locale)}</a>
        <a href="#section-wishlist" class="tips-jump-link">{pickLang(c.jumpWishlist, locale)}</a>
      </nav>

      <!-- F2P NOTE -->
      <div id="section-f2p" class="tips-f2p-note">
        <p>{pickLang(c.f2pNote, locale)}</p>
      </div>

      <!-- WHAT SHOULD I DO FIRST -->
      <div id="section-first" class="eg-content-card tips-anchor">
        <h2>{pickLang(c.firstTitle, locale)}</h2>
        <p>{pickLang(c.firstIntro, locale)}</p>
        <div class="eg-priority-matrix">
          <div class="eg-priority-col eg-priority-now">
            <div class="eg-priority-col-title">{pickLang(c.doNow, locale)}</div>
            <ul>
              <li>{pickLang(c.finishTutorial, locale)}</li>
              <li>{pickLang(c.pushUntilStuck, locale)}</li>
              <li>{pickLang(c.claimMail, locale)}</li>
              <li>{pickLang(c.setWishlist, locale)}</li>
              <li>{pickLang(c.buySummons, locale)}</li>
              <li>{pickLang(c.spendGems, locale)}</li>
              <li>{pickLang(c.finishDailies, locale)}</li>
              <li>{pickLang(c.checkDiscord, locale)}</li>
            </ul>
          </div>
          <div class="eg-priority-col eg-priority-soon">
            <div class="eg-priority-col-title">{pickLang(c.doSoon, locale)}</div>
            <ul>
              <li>{pickLang(c.pushUntilStuck, locale)}</li>
              <li>{pickLang(c.buildTeam, locale)}</li>
              <li>{pickLang(c.gear2dps, locale)}</li>
              <li>{pickLang(c.weeklyRift, locale)}</li>
              <li>{pickLang(c.carryBreakpoints, locale)}</li>
              <li>{pickLang(c.wishlistCleanup, locale)}</li>
            </ul>
          </div>
          <div class="eg-priority-col eg-priority-ignore">
            <div class="eg-priority-col-title">{pickLang(c.ignoreNow, locale)}</div>
            <ul>
              <li>{pickLang(c.deepPvp, locale)}</li>
              <li>{pickLang(c.secondTeam, locale)}</li>
              <li>{pickLang(c.luxuryBuys, locale)}</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- ODYSSEY MILESTONES -->
      <div id="section-odyssey" class="eg-content-card tips-anchor">
        <h2>{pickLang(c.odysseyTitle, locale)}</h2>
        <p>{pickLang(c.odysseyIntro, locale)}</p>
        <div class="milestone-table">
          <div class="milestone-row milestone-header">
            <div class="milestone-chapter">{pickLang(c.stageLabel, locale)}</div>
            <div class="milestone-unlock">{pickLang(c.unlockLabel, locale)}</div>
            <div class="milestone-why">{pickLang(c.whyLabel, locale)}</div>
          </div>
          <div class="milestone-row">
            <div class="milestone-chapter">Prologue 4</div>
            <div class="milestone-unlock">Godcall Grove</div>
            <div class="milestone-why">{locale === "de" ? "Frühe Beschwörungsfunktion" : locale === "es" ? "Función de invocación temprana" : locale === "ru" ? "Ранняя функция призыва" : "Early summon feature"}</div>
          </div>
          <div class="milestone-row">
            <div class="milestone-chapter">1-6</div>
            <div class="milestone-unlock">AFK Mode &amp; Sanctum</div>
            <div class="milestone-why">{locale === "de" ? "Passive Ressourcengenerierung beginnt" : locale === "es" ? "Comienza la generación pasiva de recursos" : locale === "ru" ? "Начинается пассивная генерация ресурсов" : "Passive resource generation begins"}</div>
          </div>
          <div class="milestone-row">
            <div class="milestone-chapter">2-1</div>
            <div class="milestone-unlock">Delusion's Den</div>
            <div class="milestone-why">{locale === "de" ? "Zusätzlicher PvE-Inhalt und Belohnungen" : locale === "es" ? "Contenido PvE extra y recompensas" : locale === "ru" ? "Дополнительный PvE-контент и награды" : "Extra PvE content and rewards"}</div>
          </div>
          <div class="milestone-row">
            <div class="milestone-chapter">2-12</div>
