  deepPvp: { en: "Deep PvP pushes", de: "Tiefes PvP pushen", es: "Empujes profundos de PvP", ru: "Глубокий пуш PvP" },
  secondTeam: { en: "Second team", de: "Zweites Team", es: "Segundo equipo", ru: "Вторая команда" },
  luxuryBuys: { en: "Luxury shop buys", de: "Luxus-Shop-Käufe", es: "Compras de la tienda de lujo", ru: "Покупки в люкс-магазине" },
  odysseyTitle: { en: "Odyssey (Campaign) Milestones", de: "Odyssey-(Kampagnen-)Meilensteine", es: "Hitos de Odyssey (campaña)", ru: "Вехи Odyssey (кампания)" },
  odysseyIntro: { en: "Keep pushing to unlock stages and events. The two most impactful early targets are Stage 3-18 (Shrine) and Stage 8-3 (Beacon Tree).", de: "Bleib dran, um Stufen und Events freizuschalten. Die zwei wichtigsten frühen Ziele sind Stage 3-18 (Shrine) und Stage 8-3 (Beacon Tree).", es: "Sigue avanzando para desbloquear etapas y eventos. Los dos objetivos iniciales más importantes son Stage 3-18 (Santuario) y Stage 8-3 (Beacon Tree).", ru: "Продолжай продвигаться, чтобы открывать этапы и события. Две самые важные ранние цели — Stage 3-18 (Shrine) и Stage 8-3 (Beacon Tree)." },
  stageLabel: { en: "Stage", de: "Stufe", es: "Etapa", ru: "Этап" },
  unlockLabel: { en: "What It Unlocks", de: "Was es freischaltet", es: "Qué desbloquea", ru: "Что открывает" },
  whyLabel: { en: "Why It Matters", de: "Warum es wichtig ist", es: "Por qué importa", ru: "Почему это важно" },
  odysseyCallout: { en: "Push to Stage 3-18 first to unlock the Shrine, then aim for Stage 8-3 to activate the Beacon Tree. Both give account-wide buffs that help every hero in every mode.", de: "Arbeite dich zuerst bis Stage 3-18 vor, um den Shrine freizuschalten, und dann bis Stage 8-3, um den Beacon Tree zu aktivieren. Beide geben accountweite Buffs, die jedem Helden in jedem Modus helfen.", es: "Avanza primero hasta Stage 3-18 para desbloquear el Santuario y luego apunta a Stage 8-3 para activar el Beacon Tree. Ambos dan buffs para toda la cuenta que ayudan a todos los héroes en todos los modos.", ru: "Сначала дойди до Stage 3-18, чтобы открыть Shrine, затем стремись к Stage 8-3, чтобы активировать Beacon Tree. Оба дают бафы на весь аккаунт, которые помогают каждому герою в любом режиме." },
  summonsTitle: { en: "Normal Summons and Wish List", de: "Normale Beschwörungen und Wish List", es: "Invocaciones normales y Wish List", ru: "Обычные призывы и Wish List" },
  summoningTips: { en: "Summoning Tips", de: "Beschwörungstipps", es: "Consejos de invocación", ru: "Советы по призыву" },
  wishUnlock: { en: "The Wish List unlocks after 30 regular summons.", de: "Die Wish List schaltet sich nach 30 normalen Beschwörungen frei.", es: "La Wish List se desbloquea tras 30 invocaciones normales.", ru: "Wish List открывается после 30 обычных призывов." },
  wishSwap: { en: "Once you have finished ascending one of the left-side deities on the wish list, swap them for one on the right.", de: "Sobald du eine der linken Gottheiten auf der Wish List fertig aufgestiegen hast, tausche sie gegen eine rechts aus.", es: "Cuando termines de ascender a una de las deidades del lado izquierdo en la Wish List, cámbiala por una de la derecha.", ru: "Когда закончишь возвышать одного из левых богов в Wish List, замени его на кого-то справа." },
  standardPity: { en: "Standard Pity: an Epic deity is guaranteed by pull 50. The counter resets when an Epic appears and is separate from other summon types.", de: "Standard-Pity: Eine Epic-Gottheit ist bis Pull 50 garantiert. Der Zähler setzt sich zurück, wenn ein Epic erscheint, und ist von anderen Beschwörungsarten getrennt.", es: "Pity estándar: se garantiza una deidad Épica antes de la tirada 50. El contador se reinicia cuando aparece una Épica y es independiente de otros tipos de invocación.", ru: "Стандартный pity: Epic-божество гарантируется к 50-му призыву. Счётчик сбрасывается, когда выпадает Epic, и не связан с другими типами призывов." },
  gemsTip: { en: "It is not recommended to spend Elysian Gems on regular summons - except for the first 1-2 days to get some units into your roster.", de: "Es wird nicht empfohlen, Elysian Gems für normale Beschwörungen auszugeben - außer in den ersten 1-2 Tagen, um ein paar Einheiten ins Roster zu bekommen.", es: "No se recomienda gastar Gemas Elíseas en invocaciones normales, salvo durante los primeros 1-2 días para conseguir algunas unidades en tu plantel.", ru: "Не рекомендуется тратить Elysian Gems на обычные призывы — кроме первых 1-2 дней, чтобы набрать немного юнитов в ростер." },
  summonProbTitle: { en: "Summon Probabilities", de: "Beschwörungswahrscheinlichkeiten", es: "Probabilidades de invocación", ru: "Вероятности призыва" },
  summonProbIntro: { en: "This breakdown shows how likely you are to pull one specific target hero. The base rates come from the summon tooltips shown in the game.", de: "Diese Aufschlüsselung zeigt, wie wahrscheinlich es ist, genau einen bestimmten Zielhelden zu ziehen. Die Basisraten stammen aus den Beschwörungs-Tooltips im Spiel.", es: "Este desglose muestra la probabilidad de obtener exactamente un héroe objetivo específico. Las tasas base provienen de los tooltips de invocación del juego.", ru: "Этот разбор показывает, насколько вероятно получить конкретного целевого героя. Базовые шансы взяты из подсказок призыва в игре." },
  summonTableSummon: { en: "Summon", de: "Beschwörung", es: "Invocación", ru: "Призыв" },
  summonTableEpicTotal: { en: "Epic total", de: "Epic gesamt", es: "Épica total", ru: "Epic всего" },
  summonTableWishlist: { en: "Wishlist", de: "Wish List", es: "Lista de deseos", ru: "Wish List" },
  summonTableCelestial: { en: "Celestial", de: "Celestial", es: "Celestial", ru: "Celestial" },
  summonTableNoWishlist: { en: "No Wishlist", de: "Ohne Wish List", es: "Sin lista", ru: "Без Wish List" },
  standardWishlistNote: { en: "Standard Wishlist: 4 factions x 4 slots = 16 heroes sharing 4.6%, or about 0.29% per hero.", de: "Standard Wish List: 4 Fraktionen x 4 Plätze = 16 Helden teilen sich 4,6 %, also etwa 0,29 % pro Held.", es: "Lista de deseos estándar: 4 facciones x 4 huecos = 16 héroes compartiendo 4,6%, o alrededor de 0,29% por héroe.", ru: "Стандартный Wish List: 4 фракции x 4 слота = 16 героев делят 4,6%, или около 0,29% на героя." },
  suitWishlistNote: { en: "Suit Wishlist: 4 faction-specific heroes sharing 7.5%, or 1.875% per hero.", de: "Suit Wish List: 4 fraktionsspezifische Helden teilen sich 7,5 %, also 1,875 % pro Held.", es: "Lista de deseos de traje: 4 héroes específicos de la facción comparten 7,5%, o 1,875% por héroe.", ru: "Suit Wish List: 4 героя одной фракции делят 7,5%, или 1,875% на героя." },
  chancePerPullTitle: { en: "Chance per Pull", de: "Chance pro Pull", es: "Probabilidad por tirada", ru: "Шанс за призыв" },
