  jumpOdyssey: { en: "Odyssey", de: "Odyssey", es: "Odyssey", ru: "Odyssey" },
  jumpSummons: { en: "Summons", de: "Beschwörungen", es: "Invocaciones", ru: "Призывы" },
  jumpChronos: { en: "Chronos", de: "Chronos", es: "Chronos", ru: "Хронос" },
  jumpMindsea: { en: "Mindsea", de: "Mindsea", es: "Mindsea", ru: "Mindsea" },
  jumpWishlist: { en: "Wishlist", de: "Wish List", es: "Lista de deseos", ru: "Wish List" },
  f2pNote: { en: "This guide is written from a F2P and low-spender perspective. If you are a whale or have heavily starred heroes, you can replace the suggested heroes below with your own star picks.", de: "Dieser Guide ist aus F2P- und Low-Spender-Sicht geschrieben. Wenn du ein Whale bist oder stark aufgewertete Helden hast, kannst du die vorgeschlagenen Helden unten durch deine eigenen Stern-Auswahlen ersetzen.", es: "Esta guía está escrita desde una perspectiva F2P y de bajo gasto. Si eres un whale o tienes héroes muy estrelados, puedes sustituir los héroes sugeridos por tus propias elecciones.", ru: "Этот гайд написан с точки зрения F2P и низких трат. Если ты whale или у тебя сильно прокачанные герои, можешь заменить предложенных героев на своих звёздных кандидатов." },
  firstTitle: { en: "What Should I Do First?", de: "Was sollte ich zuerst tun?", es: "¿Qué debo hacer primero?", ru: "Что делать сначала?" },
  firstIntro: { en: "Focus on pushing Odyssey, Torment Rift and building your first team. Summon to get a good roster (1-2 damage dealers, 2 supports, 1-2 tanks).", de: "Konzentriere dich darauf, Odyssey und Torment Rift voranzutreiben und dein erstes Team aufzubauen. Beschwöre, um ein gutes Roster zu bekommen (1-2 Schadensausteiler, 2 Supports, 1-2 Tanks).", es: "Concéntrate en avanzar Odyssey, Torment Rift y construir tu primer equipo. Invoca para conseguir un buen plantel (1-2 causantes de daño, 2 supports, 1-2 tanques).", ru: "Сосредоточься на продвижении Odyssey, Torment Rift и сборке первой команды. Призывай, чтобы собрать хороший ростер (1-2 дамагера, 2 саппорта, 1-2 танка)." },
  doNow: { en: "Do Now", de: "Jetzt tun", es: "Haz ahora", ru: "Сделать сейчас" },
  doSoon: { en: "Do Soon", de: "Bald tun", es: "Haz pronto", ru: "Сделать вскоре" },
  ignoreNow: { en: "Ignore for Now", de: "Vorerst ignorieren", es: "Ignorar por ahora", ru: "Пока игнорировать" },
