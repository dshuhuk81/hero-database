  pushUntilStuck: { en: "Push Odyssey until stuck", de: "Odyssey vorantreiben bis du festhängst", es: "Avanza en Odyssey hasta atascarte", ru: "Продвигай Odyssey, пока не упрёшься" },
  claimMail: { en: "Claim all mail and login rewards", de: "Alle Post und Login-Belohnungen abholen", es: "Reclama todo el correo y las recompensas de inicio de sesión", ru: "Забери всю почту и награды за вход" },
  setWishlist: { en: "Set your Wish List (summon 30x to unlock)", de: "Wish List setzen (30x beschwören zum Freischalten)", es: "Configura tu Wish List (se desbloquea al invocar 30 veces)", ru: "Настрой Wish List (открывается после 30 призывов)" },
  buySummons: { en: "Buy the daily 30% off regular summons", de: "Tägliche normale Beschwörungen mit 30 % Rabatt kaufen", es: "Compra las invocaciones normales diarias con 30% de descuento", ru: "Покупай ежедневные обычные призывы со скидкой 30%" },
  spendGems: { en: "Spend early gems on roster building", de: "Frühe Juwelen in den Aufbau des Rosters investieren", es: "Gasta las gemas tempranas en construir tu plantel", ru: "Трать ранние гемы на сбор ростера" },
  finishDailies: { en: "Finish daily missions", de: "Tägliche Missionen abschließen", es: "Completa las misiones diarias", ru: "Закрывай ежедневные задания" },
  checkDiscord: { en: "Check official discord for codes", de: "Offiziellen Discord nach Codes prüfen", es: "Revisa el Discord oficial por códigos", ru: "Проверь официальный Discord на коды" },
  buildTeam: { en: "Build 1 team", de: "1 Team bauen", es: "Construye 1 equipo", ru: "Собери 1 команду" },
  gear2dps: { en: "Gear 2 DPS", de: "2 DPS ausrüsten", es: "Equipa a 2 DPS", ru: "Экипируй 2 DPS" },
