---
import { getLocaleFromPathname, type Locale } from "../i18n/config";
import { t } from "../i18n/ui";

type Ratings = {
  overall?: string | null;
  pvp?: string | null;
  pve?: string | null;
};

interface Props {
  ratings?: Ratings | null;
  locale?: Locale;
}

const { ratings = {}, locale = getLocaleFromPathname(Astro.url.pathname) } = Astro.props as Props;
const singleCategories = [
  { key: "overall", label: t(locale, "hero", "overall") },
  { key: "pvp", label: t(locale, "hero", "pvp") },
  { key: "pve", label: t(locale, "hero", "pve") },
] as const;

function tierClass(value: string) {
  return value ? value.toLowerCase().replace(/\+/g, "plus") : "na";
}
---

<div class="big-rating-tiles">
  {singleCategories.map((cat, index) => {
    const val = ratings?.[cat.key] || "";
    return (
      <div class={`big-rating-tile ${index === 0 ? "is-overall" : "is-mode"} rating-tile-${tierClass(val)}`}>
        {index === 0 && <span class="big-rating-eyebrow">{t(locale, "hero", "metaRatings")}</span>}
        <span class="big-rating-val">{val || "N/A"}</span>
        <span class="big-rating-label">{cat.label}</span>
      </div>
    );
  })}
</div>

<style>
  .big-rating-tiles {
    display: grid;
    grid-template-columns: minmax(220px, 1.35fr) repeat(2, minmax(150px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  /* Two deterministic rows: value (flexible, centered) + label (fixed).
     Equal tile heights -> equal value rows -> values align across tiles. */
  .big-rating-tile {
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-4);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-raised);
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .big-rating-tile.is-overall {
    position: relative;
    padding-block: var(--space-9);
    border-width: 2px;
    box-shadow: 0 16px 36px rgba(0,0,0,0.18);
  }

  .big-rating-tile.is-mode {
    align-self: center;
    min-height: 78%;
  }

  .big-rating-eyebrow {
    position: absolute;
    top: var(--space-4);
    font-size: 0.58rem;
    font-weight: var(--weight-black);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-disabled);
  }

  .big-rating-tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(0,0,0,0.24);
  }

  /* value row */
  .big-rating-val {
    align-self: center;
    font-size: 3rem;
    font-weight: var(--weight-black);
    line-height: 1;
    letter-spacing: 0;
  }
  .is-overall .big-rating-val { font-size: 4rem; }

  /* label row */
  .big-rating-label {
    text-align: center;
    font-size: 0.72rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-muted);
  }

  .big-rating-tile.rating-tile-sss,
  .big-rating-tile.rating-tile-splus {
    background: linear-gradient(135deg, rgba(185, 28, 28, 0.2), rgba(127, 0, 0, 0.1));
    border-color: rgba(185, 28, 28, 0.4);
  }

  .rating-tile-sss .big-rating-val,
  .rating-tile-splus .big-rating-val {
    background: linear-gradient(135deg, #ff6b6b, #dc2626);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .big-rating-tile.rating-tile-ss {
    background: linear-gradient(135deg, rgba(250, 204, 21, 0.15), rgba(245, 158, 11, 0.08));
    border-color: rgba(250, 204, 21, 0.35);
  }

  .rating-tile-ss .big-rating-val {
    background: linear-gradient(135deg, #ffe066, #facc15);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .big-rating-tile.rating-tile-s {
    background: linear-gradient(135deg, rgba(253, 230, 138, 0.12), rgba(251, 191, 36, 0.06));
    border-color: rgba(253, 230, 138, 0.3);
  }

  .rating-tile-s .big-rating-val {
    background: linear-gradient(135deg, #fde68a, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .rating-tile-a .big-rating-val,
  .rating-tile-aplus .big-rating-val {
    color: #fdba74;
  }

  .rating-tile-b .big-rating-val,
  .rating-tile-bplus .big-rating-val {
    color: #c4b5fd;
  }

  .rating-tile-c .big-rating-val {
    color: #93c5fd;
  }

  .rating-tile-d .big-rating-val {
    color: var(--text-muted);
  }

  .rating-tile-na .big-rating-val {
    color: var(--text-disabled);
    font-size: 1.8rem;
  }

  @media (max-width: 768px) {
    .big-rating-tiles {
      grid-template-columns: 1.25fr repeat(2, 1fr);
      gap: var(--space-2);
    }

    .big-rating-tile {
      padding: var(--space-6) var(--space-2);
      gap: var(--space-3);
    }

    .big-rating-val {
      font-size: 2rem;
    }
    .is-overall .big-rating-val { font-size: 2.8rem; }

    .big-rating-label {
      font-size: 0.58rem;
      letter-spacing: var(--tracking-wide);
    }
  }

  @media (max-width: 480px) {
    .big-rating-tiles {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2);
    }

    .big-rating-tile.is-overall { grid-column: 1 / -1; }
    .big-rating-tile.is-mode { min-height: auto; }
    .big-rating-label {
      font-size: 0.5rem;
    }
  }
</style>
