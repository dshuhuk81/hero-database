---
type Ratings = {
  overall?: string | null;
  pvp?: string | null;
  pve?: string | null;
};

interface Props {
  ratings?: Ratings | null;
}

const { ratings = {} } = Astro.props;
const ratingCategories = [
  { key: "overall", label: "Overall" },
  { key: "pvp", label: "PvP" },
  { key: "pve", label: "PvE" },
] as const;

function tierClass(value: string) {
  return value ? value.toLowerCase().replace(/\+/g, "plus") : "na";
}
---

<div class="big-rating-tiles">
  {ratingCategories.map((cat) => {
    const val = ratings?.[cat.key] || "";
    return (
      <div class={`big-rating-tile rating-tile-${tierClass(val)}`}>
        <span class="big-rating-val">{val || "N/A"}</span>
        <span class="big-rating-label">{cat.label}</span>
      </div>
    );
  })}
</div>

<style>
  .big-rating-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .big-rating-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-7) var(--space-4);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-raised);
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .big-rating-tile:hover {
    transform: translateY(-3px);
  }

  .big-rating-val {
    font-size: 3rem;
    font-weight: var(--weight-black);
    line-height: 1;
    letter-spacing: 0;
  }

  .big-rating-label {
    font-size: 0.72rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-muted);
  }

  .rating-tile-sss,
  .rating-tile-splus {
    background: linear-gradient(135deg, rgba(185, 28, 28, 0.2), rgba(127, 0, 0, 0.1));
    border-color: rgba(185, 28, 28, 0.4);
  }

  .rating-tile-sss .big-rating-val,
  .rating-tile-splus .big-rating-val {
    background: linear-gradient(135deg, #ff6b6b, #dc2626);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .rating-tile-ss {
    background: linear-gradient(135deg, rgba(250, 204, 21, 0.15), rgba(245, 158, 11, 0.08));
    border-color: rgba(250, 204, 21, 0.35);
  }

  .rating-tile-ss .big-rating-val {
    background: linear-gradient(135deg, #ffe066, #facc15);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .rating-tile-s {
    background: linear-gradient(135deg, rgba(253, 230, 138, 0.12), rgba(251, 191, 36, 0.06));
    border-color: rgba(253, 230, 138, 0.3);
  }

  .rating-tile-s .big-rating-val {
    background: linear-gradient(135deg, #fde68a, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .rating-tile-a .big-rating-val,
  .rating-tile-aplus .big-rating-val {
    color: #fdba74;
  }

  .rating-tile-b .big-rating-val,
  .rating-tile-bplus .big-rating-val {
    color: #c4b5fd;
  }

  .rating-tile-c .big-rating-val {
    color: #93c5fd;
  }

  .rating-tile-d .big-rating-val {
    color: var(--text-muted);
  }

  .rating-tile-na .big-rating-val {
    color: var(--text-disabled);
    font-size: 1.8rem;
  }

  @media (max-width: 768px) {
    .big-rating-tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2);
    }

    .big-rating-val {
      font-size: 2rem;
    }
  }

  @media (max-width: 480px) {
    .big-rating-tiles {
      gap: var(--space-2);
    }
  }
</style>
