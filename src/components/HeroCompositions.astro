---
import { getHeroById } from "../data/heroes";
import { localizeHeroData } from "../data/heroes/localize";
import totemData from "../data/totems.json";
import { getLocaleFromPathname, localizePath, type Locale } from "../i18n/config";
import { pickLang } from "../i18n/helpers";
import { t } from "../i18n/ui";

const { heroId } = Astro.props;
const mode = Astro.props.mode ?? "general";
const locale: Locale = Astro.props.locale ?? getLocaleFromPathname(Astro.url.pathname);

const heroData = localizeHeroData(getHeroById(heroId) as any, locale);
const comps = (heroData?.teamComps as Record<string, any[]>)?.[mode] ?? [];

const totemById: Record<string, any> = Object.fromEntries(
  (totemData?.totems ?? []).map((t: any) => [t.id, t])
);

function totemName(id: string): string { return pickLang(totemById[id]?.name, locale) || id; }
function totemImg(id: string): string { return totemById[id]?.image ?? ""; }

function hero(hid: string) { return localizeHeroData(getHeroById(hid) as any, locale); }
function heroName(hid: string): string { return hero(hid)?.name ?? hid; }
function heroImg(hid: string): string {
  const img = hero(hid)?.image;
  if (typeof img !== "string" || img.length === 0) return "";
  if (img.startsWith("http://") || img.startsWith("https://")) return img;
  return img.startsWith("/") ? img : `/${img}`;
}
---

<section class="comp-card">
  <div class="top">
    <h3>{t(locale, "common", "compositions")}</h3>
  </div>

  {comps.length === 0 ? (
    <p>{t(locale, "common", "noCompositions")}</p>
  ) : (
    <div class="comp-list">
      {comps.map((c, idx) => (
        <article class="comp">
          <div class="header">
            <strong>
              {c.label || `${t(locale, "hero", "teamNumber")}${idx + 1}`}
            </strong>
            {c.stars != null && (
              <span class="curated-stars" title={`${t(locale, "hero", "cnCommunityRating")}: ${c.stars}/5`}>
                {Array.from({ length: c.stars }).map(() => "*").join("")}/5
              </span>
            )}
          </div>

          {c.targets && (
            <div class="bonus">
              <span class="pill curated-pill">{t(locale, "hero", "vs")}: {c.targets}</span>
            </div>
          )}

          <div class="formation-grid">
            {(['front', 'back'] as const).map((position) => {
              const slots: string[] = Array.isArray(c[position]) ? c[position] : [];
              if (slots.length === 0) return null;
              return (
                <div class={`formation-row ${position}-row`}>
                  {slots.map((hid) => {
                    const h = hero(hid);
                    if (!h) return <div class="hero-card-slot empty"></div>;
                    const isCurrentHero = h.id === heroId;

                    return (
                      <a class={`hero-card ${isCurrentHero ? 'current-hero' : ''}`} href={localizePath(`/heroes/${hid}`, locale)}>
                        <div class="hero-card-inner">
                          <div class="hero-image-wrapper">
                            <img src={heroImg(hid)} alt={heroName(hid)} class="hero-image" loading="lazy" decoding="async" />
                            {isCurrentHero && (
                              <div class="current-hero-badge" title={t(locale, "common", "currentHero")}>
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                  <path d="M8 0L9.796 5.528H15.708L10.956 8.944L12.752 14.472L8 11.056L3.248 14.472L5.044 8.944L0.292 5.528H6.204L8 0Z" fill="currentColor"/>
                                </svg>
                              </div>
                            )}
                          </div>

                          <div class="hero-info">
                            <h4 class="hero-name">{heroName(hid)}</h4>
                            <div class="hero-meta">
                              <img
                                src={`https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/${String(h.faction ?? "").toLowerCase()}.webp`}
                                alt={h.faction}
                                class="faction-icon-small"
                                title={h.faction}
                                loading="lazy"
                                decoding="async"
                              />
                            </div>
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              );
            })}
          </div>

          {c.description && (
            <div class="curated-description">
              <p>{c.description}</p>
            </div>
          )}

          {Array.isArray(c.totems) && c.totems.length > 0 && (
            <div class="curated-totems">
              <span class="totem-label">{t(locale, "common", "totem")}:</span>
              {c.totems.map((tid) => (
                <span class="totem-chip" title={totemName(tid)}>
                  {totemImg(tid) && (
                    <img src={totemImg(tid)} alt={totemName(tid)} class="totem-icon" loading="lazy" decoding="async" />
                  )}
                  {totemName(tid)}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  )}
</section>

<style>

  .badge.unknown {
  background: rgba(148,163,184,.12);
  border-color: rgba(148,163,184,.28);
  opacity: .9;
}
  .comp-card { padding: 1rem;}
  .top { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; }
  .comp-list { display: grid; gap: 1rem; margin-top: .75rem; }
  .comp { padding: 1rem; border: 1px solid rgba(255,255,255,.08); border-radius: 12px; background: rgba(0,0,0,.18); position: relative; }
  .header { display:flex; justify-content: space-between; gap: 1rem; align-items: baseline; }

  .curated-stars { font-size: .85rem; color: #f4c542; opacity: .9; }
  .curated-pill { border-color: rgba(244,197,66,.3); background: rgba(244,197,66,.07); color: #f4c542; }
  .curated-description { margin: .5rem 0 .75rem; font-size: .88rem; color: rgba(255,255,255,.65); font-style: italic; padding: .5rem .75rem; border-left: 2px solid rgba(244,197,66,.4); }
  .curated-totems { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: .5rem 0 .25rem; }
  .totem-label { font-size: .78rem; color: rgba(255,255,255,.45); text-transform: uppercase; letter-spacing: .05em; margin-right: .2rem; }
  .totem-chip { display: inline-flex; align-items: center; gap: .3rem; padding: .2rem .55rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.15); background: rgba(255,255,255,.05); font-size: .8rem; color: rgba(255,255,255,.8); }
  .totem-icon { width: 18px; height: 18px; object-fit: contain; }

  .bonus { margin-top: .5rem; }
  .pill {
    display:inline-block;
    padding:.35rem .6rem;
    border-radius:999px;
    border:1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.06);
    font-size:.85rem;
    opacity:.95;
  }

  /* === Formation Grid === */
  .formation-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding: 2rem;
    border-radius: 1rem;
  }

  .formation-row {
    display: grid;
    gap: 1.5rem;
    justify-content: center;
  }

  .formation-row.back-row {
    grid-template-columns: repeat(3, minmax(140px, 200px));
  }

  .formation-row.front-row {
    grid-template-columns: repeat(2, minmax(140px, 200px));
  }

  /* Hero Card */
  .hero-card,
  .hero-card-slot {
    position: relative;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));
    border-radius: 0.75rem;
    border: 2px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .hero-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(139, 92, 246, 0.3);
  }

  .hero-card-slot.empty {
    background: rgba(15, 23, 42, 0.4);
    border: 2px dashed rgba(255, 255, 255, 0.1);
    min-height: 240px;
    cursor: default;
  }

  /* Current Hero Highlight */
  .hero-card.current-hero {
    border-color: #f59e0b;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.1));
    box-shadow:
      0 0 0 1px rgba(245, 158, 11, 0.5),
      0 0 20px rgba(245, 158, 11, 0.3);
  }

  .hero-card.current-hero:hover {
    border-color: #fbbf24;
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(245, 158, 11, 0.5);
  }

  .hero-card-inner {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 0.5rem;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6));
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.3s ease;
  }

  .hero-card:hover .hero-image {
    transform: scale(1.05);
  }

  .current-hero-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4); }
    50% { box-shadow: 0 4px 20px rgba(245, 158, 11, 0.6); }
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-name {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .faction-icon-small {
    width: 24px;
    height: 24px;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  /* Neutral badges */
  .badge {
    padding: .18rem .45rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.06);
    font-size: .75rem;
    opacity: .95;
  }

  /* Colored badges */
  .badge.heal { background: rgba(16,185,129,.18); border-color: rgba(16,185,129,.35); }
  .badge.antiheal { background: rgba(239,68,68,.18); border-color: rgba(239,68,68,.35); }
  .badge.shield { background: rgba(59,130,246,.18); border-color: rgba(59,130,246,.35); }
  .badge.cleanse { background: rgba(34,197,94,.16); border-color: rgba(34,197,94,.32); }
  .badge.control { background: rgba(168,85,247,.18); border-color: rgba(168,85,247,.35); }
  .badge.aoe { background: rgba(245,158,11,.18); border-color: rgba(245,158,11,.35); }
  .badge.energy { background: rgba(250,204,21,.18); border-color: rgba(250,204,21,.35); }
  .badge.cooldown { background: rgba(99,102,241,.18); border-color: rgba(99,102,241,.35); }
  .badge.backline { background: rgba(244,63,94,.18); border-color: rgba(244,63,94,.35); }
  .badge.shred { background: rgba(148,163,184,.18); border-color: rgba(148,163,184,.35); }

  /* Responsive */
  @media (max-width: 1024px) {
    .formation-row.back-row,
    .formation-row.front-row {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .formation-grid {
      padding: 1.5rem;
      gap: 1rem;
    }

    .formation-row {
      gap: 1rem;
    }

    .formation-row.back-row,
    .formation-row.front-row {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }

    .hero-card-inner {
      padding: 0.75rem;
    }

    .hero-name {
      font-size: 0.875rem;
    }

    .faction-icon-small {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 480px) {
    .formation-row.back-row,
    .formation-row.front-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-name {
      font-size: 0.8125rem;
    }
  }
</style>
