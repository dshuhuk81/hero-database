---
// Navigation is derived from the single source of truth in src/data/nav.ts.
// Do NOT define nav items here - add/edit/remove them in that file and both
// this sidebar and the index.astro teaser grid update automatically.
import { navEntries, defaultMaintenanceTooltip, type NavEntry } from "../data/nav";
import { getLocaleFromPathname, localizePath, stripLocaleFromPathname } from "../i18n/config";
import { navLabel, t } from "../i18n/ui";

// Entries reachable from another hub page (e.g. /guides game-mode section) are
// hidden from the sidebar entirely via `sidebar: false`.
const sidebarEntries = navEntries.filter(i => i.sidebar !== false);

// Mobile bottom bar: entries flagged `mobile` (max 4) + "More".
// Falls back to the first 4 nav entries if nothing is flagged.
const flaggedMobile = sidebarEntries.filter(i => i.mobile).slice(0, 4);
const mobileItems = flaggedMobile.length > 0 ? flaggedMobile : sidebarEntries.slice(0, 4);
const mobileOverflowItems = sidebarEntries.filter(i => !mobileItems.includes(i));

const normalize = (p: string) => (p.replace(/\/+$/, "") || "/");
const locale = getLocaleFromPathname(Astro.url.pathname);
const currentPath = normalize(stripLocaleFromPathname(Astro.url.pathname));
const isActive = (href: string) => {
  const target = normalize(href);
  if (target === currentPath) return true;
  // Section match: /heroes highlights on /heroes/anubis, /guides on /guides/nut.
  return target !== "/" && currentPath.startsWith(target + "/");
};

const primaryItems = sidebarEntries.filter(i => i.group === "primary");
const contentItems = sidebarEntries.filter(i => i.group === "content");
const toolsItems   = sidebarEntries.filter(i => i.group === "tools");
const metaItems    = sidebarEntries.filter(i => i.group === "meta");

function getIcon(item: NavEntry) {
  return item.icon;
}

function isMaintenance(item: NavEntry) {
  return item.status?.type === "maintenance";
}

function getTooltip(item: NavEntry) {
  return item.status?.tooltip ?? defaultMaintenanceTooltip;
}

function getHref(item: NavEntry) {
  return localizePath(item.href, locale);
}

function getLabel(item: NavEntry) {
  return navLabel(item.href, item.label, locale);
}
---

<!-- Desktop Rail -->
<aside class="rail">
  <nav class="rail-nav">
    {primaryItems.map((item) => {
      const disabled = isMaintenance(item);
      const label = getLabel(item);
      const tooltip = disabled ? getTooltip(item) : label;
      const itemClass = `rail-item ${isActive(item.href) && !disabled ? "active" : ""} ${disabled ? "nav-disabled" : ""}`;
      const itemContent = (
        <>
          <div class="rail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item)} />
            {isActive(item.href) && !disabled && <span class="active-pill" />}
          </div>
          <span class="rail-label">{label}</span>
        </>
      );

      return disabled ? (
        <span class={itemClass} data-tooltip={tooltip} title={tooltip} aria-disabled="true" role="link">
          {itemContent}
        </span>
      ) : (
        <a href={getHref(item)} class={itemClass} data-tooltip={tooltip}>
          {itemContent}
        </a>
      );
    })}

    <div class="rail-divider" />

    {contentItems.map((item) => {
      const disabled = isMaintenance(item);
      const label = getLabel(item);
      const tooltip = disabled ? getTooltip(item) : label;
      const itemClass = `rail-item ${isActive(item.href) && !disabled ? "active" : ""} ${disabled ? "nav-disabled" : ""}`;
      const itemContent = (
        <>
          <div class="rail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item)} />
            {isActive(item.href) && !disabled && <span class="active-pill" />}
          </div>
          <span class="rail-label">{label}</span>
        </>
      );

      return disabled ? (
        <span class={itemClass} data-tooltip={tooltip} title={tooltip} aria-disabled="true" role="link">
          {itemContent}
        </span>
      ) : (
        <a href={getHref(item)} class={itemClass} data-tooltip={tooltip}>
          {itemContent}
        </a>
      );
    })}

    <div class="rail-divider" />

    {toolsItems.map((item) => {
      const disabled = isMaintenance(item);
      const label = getLabel(item);
      const tooltip = disabled ? getTooltip(item) : label;
      const itemClass = `rail-item ${isActive(item.href) && !disabled ? "active" : ""} ${disabled ? "nav-disabled" : ""}`;
      const itemContent = (
        <>
          <div class="rail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item)} />
            {isActive(item.href) && !disabled && <span class="active-pill" />}
          </div>
          <span class="rail-label">{label}</span>
        </>
      );

      return disabled ? (
        <span class={itemClass} data-tooltip={tooltip} title={tooltip} aria-disabled="true" role="link">
          {itemContent}
        </span>
      ) : (
        <a href={getHref(item)} class={itemClass} data-tooltip={tooltip}>
          {itemContent}
        </a>
      );
    })}

    <div class="rail-divider" />

    {metaItems.map((item) => {
      const disabled = isMaintenance(item);
      const label = getLabel(item);
      const tooltip = disabled ? getTooltip(item) : label;
      const itemClass = `rail-item ${isActive(item.href) && !disabled ? "active" : ""} ${disabled ? "nav-disabled" : ""}`;
      const itemContent = (
        <>
          <div class="rail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item)} />
            {isActive(item.href) && !disabled && <span class="active-pill" />}
          </div>
          <span class="rail-label">{label}</span>
        </>
      );

      return disabled ? (
        <span class={itemClass} data-tooltip={tooltip} title={tooltip} aria-disabled="true" role="link">
          {itemContent}
        </span>
      ) : (
        <a href={getHref(item)} class={itemClass} data-tooltip={tooltip}>
          {itemContent}
        </a>
      );
    })}
  </nav>
  

  <div class="rail-support-wrap">
    <div class="rail-divider" />
    <a href="/#support" class="rail-item rail-support" data-tooltip={t(locale, "common", "support")}>
      <div class="rail-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <span class="rail-label">{t(locale, "common", "support")}</span>
    </a>
  </div>
</aside>

<!-- Mobile Bottom Bar -->
<nav class="mobile-bar">
  {mobileItems.map((item) => {
    const disabled = isMaintenance(item);
    const label = getLabel(item);
    const tooltip = getTooltip(item);
    const itemClass = `mobile-item ${isActive(item.href) && !disabled ? "active" : ""} ${disabled ? "nav-disabled" : ""}`;
    const itemContent = (
      <>
        <div class="mobile-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item)} />
        </div>
        <span class="mobile-label">{label}</span>
      </>
    );

    return disabled ? (
      <span class={itemClass} title={tooltip} aria-disabled="true" role="link">
        {itemContent}
      </span>
    ) : (
      <a href={getHref(item)} class={itemClass}>
        {itemContent}
      </a>
    );
  })}
  <button class="mobile-item mobile-more-btn" id="mobileMoreBtn" type="button">
    <div class="mobile-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
      </svg>
    </div>
    <span class="mobile-label">{t(locale, "common", "more")}</span>
  </button>
</nav>

<!-- Floating Donate Button -->
<div class="float-donate" id="floatDonate" aria-hidden="true">
  <a href="/#support" class="float-donate-btn" tabindex="-1" id="floatDonateLink">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
    <span>{t(locale, "common", "support")}</span>
  </a>
  <button class="float-donate-close" id="floatDonateClose" aria-label={t(locale, "common", "dismiss")} tabindex="-1">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<!-- Mobile "More" Sheet -->
<div class="more-sheet-backdrop" id="moreSheetBackdrop">
  <div class="more-sheet" id="moreSheet">
    <div class="more-sheet-handle"></div>
    {mobileOverflowItems.map((item) => {
      const disabled = isMaintenance(item);
      const label = getLabel(item);
      const tooltip = getTooltip(item);
      const itemClass = `more-sheet-item ${isActive(item.href) && !disabled ? "active" : ""} ${disabled ? "nav-disabled" : ""}`;
      const itemContent = (
        <>
          <div class="more-sheet-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item)} />
          </div>
          <span class="more-sheet-label">{label}</span>
        </>
      );

      return disabled ? (
        <span class={itemClass} title={tooltip} aria-disabled="true" role="link">
          {itemContent}
        </span>
      ) : (
        <a href={getHref(item)} class={itemClass}>
          {itemContent}
        </a>
      );
    })}
    <div class="more-sheet-divider" />
    <a href="/#support" class="more-sheet-item more-sheet-support">
      <div class="more-sheet-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <span class="more-sheet-label">{t(locale, "footer", "supportProject")}</span>
    </a>
  </div>
</div>

<script>
  // Mobile "More" sheet
  const moreBtn = document.getElementById('mobileMoreBtn');
  const moreBackdrop = document.getElementById('moreSheetBackdrop');
  const moreSheet = document.getElementById('moreSheet');

  if (moreBtn && moreBackdrop && moreSheet) {
    moreBtn.addEventListener('click', () => {
      moreBackdrop.classList.add('open');
      requestAnimationFrame(() => moreSheet.classList.add('open'));
    });
    moreBackdrop.addEventListener('click', (e) => {
      if (e.target === moreBackdrop) {
        moreSheet.classList.remove('open');
        setTimeout(() => moreBackdrop.classList.remove('open'), 250);
      }
    });
  }

  // Floating donate button
  const floatDonate = document.getElementById('floatDonate');
  const floatDonateClose = document.getElementById('floatDonateClose');
  const floatDonateLink = document.getElementById('floatDonateLink');

  if (floatDonate && floatDonateClose && floatDonateLink) {
    const DISMISSED_KEY = 'floatDonateDismissed';

    if (!sessionStorage.getItem(DISMISSED_KEY)) {
      const onScroll = () => {
        if (window.scrollY > 300) {
          floatDonate.classList.add('visible');
          floatDonate.removeAttribute('aria-hidden');
          floatDonateLink.removeAttribute('tabindex');
          floatDonateClose.removeAttribute('tabindex');
        } else {
          floatDonate.classList.remove('visible');
          floatDonate.setAttribute('aria-hidden', 'true');
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    floatDonateClose.addEventListener('click', () => {
      floatDonate.classList.remove('visible');
      floatDonate.setAttribute('aria-hidden', 'true');
      sessionStorage.setItem('floatDonateDismissed', '1');
    });
  }
</script>

