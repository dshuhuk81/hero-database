---

interface NavItem {
  label: string;
  href: string;
  group?: "primary" | "content" | "meta";
  badge?: {
    text: string;
    color?: string;
  };
}

const navItems: NavItem[] = [
  { label: "Home",      href: "/",          group: "primary" },
  { label: "Heros",     href: "/heros",     group: "primary" },
  { label: "Hero Guides", href: "/guides",   group: "content" },
  { label: "Tips",      href: "/tips",      group: "content" },
  { label: "Boss Encounters", href: "/bosses", group: "content" },
  { label: "Events",    href: "/events",    group: "content", },
  { label: "Tower",     href: "/tower",     group: "content"},
  { label: "Delusions Den", href: "/delusions-den", group: "content"},
  { label: "Totems",    href: "/totems",    group: "content"},
  { label: "Virtues",   href: "/virtues",   group: "content",  },
    { label: "Summon Calendar", href: "/summon-calendar", group: "content" },

  { label: "Changes",   href: "/changelog", group: "meta" },
  { label: "About",     href: "/about",     group: "meta" },
];

// SVG icon paths (24x24 viewBox, stroke-based, Lucide-style)
const icons: Record<string, string> = {
  "Home": `<path d="M3 10.5L12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>`,
  "Heros": `<path d="M14.5 17.5L3 6V3h3l11.5 11.5"/><path d="M13 19l6-6"/><path d="M16 16l4 4"/><path d="M19.5 6.5L21 3l-3.5 1.5"/><path d="M9.5 17.5L21 6V3h-3L6.5 14.5"/><path d="M11 19l-6-6"/><path d="M8 16l-4 4"/><path d="M4.5 6.5L3 3l3.5 1.5"/>`,
  "Hero Guides": `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  "Summon Calendar": `<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="8" cy="16" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="16" r="1" fill="currentColor" stroke="none"/><circle cx="16" cy="16" r="1" fill="currentColor" stroke="none"/>`,
  "Tips": `<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><circle cx="12" cy="12" r="10"/><line x1="12" y1="17" x2="12.01" y2="17"/>`,
  "Boss Encounters": `<circle cx="9" cy="12" r="1"/><circle cx="15" cy="12" r="1"/><path d="M8 20v-4a8 8 0 1 1 8 0v4"/><path d="M12 20v-2"/><path d="M8 20h8"/>`,
  "Events": `<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
  "Tower": `<path d="M6 22V8l6-6 6 6v14"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-2"/><path d="M12 17v5"/><path d="M10 10h4"/>`,
  "Totems": `<path d="M12 2L8 6v3l-2 2v4l2 2v3l4 2 4-2v-3l2-2v-4l-2-2V6z"/><line x1="12" y1="2" x2="12" y2="22"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="6" y1="15" x2="18" y2="15"/>`,
  "Tools": `<rect x="4" y="2" width="16" height="20" rx="2"/><rect x="8" y="6" width="8" height="4" rx="1"/><circle cx="8" cy="14" r=".75"/><circle cx="12" cy="14" r=".75"/><circle cx="16" cy="14" r=".75"/><circle cx="8" cy="18" r=".75"/><circle cx="12" cy="18" r=".75"/><line x1="16" y1="16" x2="16" y2="20"/>`,
  "Virtues": `<rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/>`,
  "Delusions Den": `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`,
  "Changes": `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><circle cx="12" cy="15" r="3"/><path d="M12 13.5V15l1 1"/>`,
  "About":   `<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>`,
};

// Mobile bottom bar: first 4 items + "More"
const mobileItems = navItems.slice(0, 4);
const mobileOverflowItems = navItems.filter(i => !mobileItems.includes(i));

const normalize = (p: string) => (p.replace(/\/+$/, "") || "/");
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) => normalize(href) === currentPath;

const primaryItems = navItems.filter(i => i.group === "primary");
const contentItems = navItems.filter(i => i.group === "content");
const metaItems    = navItems.filter(i => i.group === "meta");

function getIcon(label: string) {
  return icons[label] || icons["Home"];
}
---

<!-- Desktop Rail -->
<aside class="rail">
  <nav class="rail-nav">
    {primaryItems.map((item) => (
      <a
        href={item.href}
        class={`rail-item ${isActive(item.href) ? "active" : ""}`}
        data-tooltip={item.label}

      >
        <div class="rail-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item.label)} />
          {isActive(item.href) && <span class="active-pill" />}
        </div>
        {item.badge && (
          <span
            class="alpha-chip"
            style={item.badge.color ? `background-color: ${item.badge.color};` : ''}
          >
            {item.badge.text}
          </span>
        )}
      </a>
    ))}

    <div class="rail-divider" />

    {contentItems.map((item) => (
      <a
        href={item.href}
        class={`rail-item ${isActive(item.href) ? "active" : ""}`}
        data-tooltip={item.label}

      >
        <div class="rail-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item.label)} />
          {isActive(item.href) && <span class="active-pill" />}
        </div>
        {item.badge && (
          <span
            class="alpha-chip"
            style={item.badge.color ? `background-color: ${item.badge.color};` : ''}
          >
            {item.badge.text}
          </span>
        )}
      </a>
    ))}

    <div class="rail-divider" />

    {metaItems.map((item) => (
      <a
        href={item.href}
        class={`rail-item ${isActive(item.href) ? "active" : ""}`}
        data-tooltip={item.label}

      >
        <div class="rail-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item.label)} />
          {isActive(item.href) && <span class="active-pill" />}
        </div>
        {item.badge && (
          <span
            class="alpha-chip"
            style={item.badge.color ? `background-color: ${item.badge.color};` : ''}
          >
            {item.badge.text}
          </span>
        )}
      </a>
    ))}
  </nav>
  

  <div class="rail-support-wrap">
    <div class="rail-divider" />
    <div class="lang-toggle" title="Language / Язык">
      <button class="lang-btn active" data-lang-set="en">EN</button>
      <button class="lang-btn" data-lang-set="ru">RU</button>
    </div>
    <div class="rail-divider" />
    <a href="/#support" class="rail-item rail-support" data-tooltip="Support">
      <div class="rail-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
    </a>
  </div>
</aside>

<!-- Mobile Bottom Bar -->
<nav class="mobile-bar">
  {mobileItems.map((item) => (
    <a
      href={item.href}
      class={`mobile-item ${isActive(item.href) ? "active" : ""}`}
    >
      <div class="mobile-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item.label)} />
      </div>
      <span class="mobile-label">{item.label}</span>
    </a>
  ))}
  <button class="mobile-item mobile-more-btn" id="mobileMoreBtn" type="button">
    <div class="mobile-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
      </svg>
    </div>
    <span class="mobile-label">More</span>
  </button>
</nav>

<!-- Floating Donate Button -->
<div class="float-donate" id="floatDonate" aria-hidden="true">
  <a href="/#support" class="float-donate-btn" tabindex="-1" id="floatDonateLink">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
    <span>Support</span>
  </a>
  <button class="float-donate-close" id="floatDonateClose" aria-label="Dismiss" tabindex="-1">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<!-- Mobile "More" Sheet -->
<div class="more-sheet-backdrop" id="moreSheetBackdrop">
  <div class="more-sheet" id="moreSheet">
    <div class="more-sheet-handle"></div>
    {mobileOverflowItems.map((item) => (
      <a
        href={item.href}
        class={`more-sheet-item ${isActive(item.href) ? "active" : ""}`}

      >
        <div class="more-sheet-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={getIcon(item.label)} />
        </div>
        <span class="more-sheet-label">{item.label}</span>
        {item.badge && (
          <span
            class="alpha-chip-inline"
            style={item.badge.color ? `background-color: ${item.badge.color};` : ''}
          >
            {item.badge.text}
          </span>
        )}
      </a>
    ))}
    <div class="more-sheet-divider" />
    <a href="/#support" class="more-sheet-item more-sheet-support">
      <div class="more-sheet-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <span class="more-sheet-label">Support the project</span>
    </a>
  </div>
</div>

<script>
  // Mobile "More" sheet
  const moreBtn = document.getElementById('mobileMoreBtn');
  const moreBackdrop = document.getElementById('moreSheetBackdrop');
  const moreSheet = document.getElementById('moreSheet');

  if (moreBtn && moreBackdrop && moreSheet) {
    moreBtn.addEventListener('click', () => {
      moreBackdrop.classList.add('open');
      requestAnimationFrame(() => moreSheet.classList.add('open'));
    });
    moreBackdrop.addEventListener('click', (e) => {
      if (e.target === moreBackdrop) {
        moreSheet.classList.remove('open');
        setTimeout(() => moreBackdrop.classList.remove('open'), 250);
      }
    });
  }

  // Floating donate button
  const floatDonate = document.getElementById('floatDonate');
  const floatDonateClose = document.getElementById('floatDonateClose');
  const floatDonateLink = document.getElementById('floatDonateLink');

  if (floatDonate && floatDonateClose && floatDonateLink) {
    const DISMISSED_KEY = 'floatDonateDismissed';

    if (!sessionStorage.getItem(DISMISSED_KEY)) {
      const onScroll = () => {
        if (window.scrollY > 300) {
          floatDonate.classList.add('visible');
          floatDonate.removeAttribute('aria-hidden');
          floatDonateLink.removeAttribute('tabindex');
          floatDonateClose.removeAttribute('tabindex');
        } else {
          floatDonate.classList.remove('visible');
          floatDonate.setAttribute('aria-hidden', 'true');
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    floatDonateClose.addEventListener('click', () => {
      floatDonate.classList.remove('visible');
      floatDonate.setAttribute('aria-hidden', 'true');
      sessionStorage.setItem('floatDonateDismissed', '1');
    });
  }
</script>

<style is:global>
  @import '../styles/tokens.css';

  .page-updated {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: var(--space-xs) 0 var(--space-md);
    font-style: italic;
    text-align: left;
  }

  .tldr-box {
    background: rgba(250, 204, 21, 0.06);
    border: 1px solid rgba(250, 204, 21, 0.2);
    border-radius: 12px;
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    margin-left: auto;
    margin-right: auto;
  }

  .tldr-title {
    color: var(--accent-gold);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm);
  }

  .tldr-list {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .tldr-list li {
    font-size: 0.85rem;
    color: rgba(230, 230, 235, 0.8);
    line-height: 1.5;
  }
</style>

<style>
  /* ─── Desktop Rail ─── */
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 48px;
    background: rgba(5, 5, 8, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-right: 1px solid rgba(255, 255, 255, 0.09);
    z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .rail-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  /* ─── Rail Item ─── */
  .rail-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    text-decoration: none;
    color: rgba(230, 230, 235, 0.45);
    transition: background 0.15s ease, color 0.15s ease;
    contain: layout style;
  }

  .rail-item:hover:not(.active) {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(230, 230, 235, 0.85);
  }

  .rail-item.active {
    color: #facc15;
  }

  /* ─── Tooltip on hover ─── */
  .rail-item::after {
    content: attr(data-tooltip);
    position: absolute;
    left: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    padding: 6px 10px;
    background: rgba(18, 16, 26, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #e6e6eb;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 200;
  }

  .rail-item:hover::after {
    opacity: 1;
  }

  /* ─── Icon (SVG) ─── */
  .rail-icon {
    position: relative;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .rail-icon svg {
    width: 20px;
    height: 20px;
    transition: filter 0.15s ease;
  }

  .rail-item.active .rail-icon svg {
    filter: drop-shadow(0 0 6px rgba(250, 204, 21, 0.4));
  }

  /* ─── Active pill indicator ─── */
  .active-pill {
    position: absolute;
    inset: -5px;
    border-radius: 8px;
    background: rgba(250, 204, 21, 0.1);
    z-index: -1;
  }

  /* ─── Section dividers ─── */
  .rail-divider {
    width: 20px;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 6px auto;
  }

  /* ─── Badge ─── */
  .alpha-chip {
    position: absolute;
    top: 2px;
    right: -2px;
    font-size: 7px;
    color: white;
    background-color: red;
    border-radius: 3px;
    padding: 1px 3px;
    opacity: 0.9;
    line-height: 1;
  }

  .alpha-chip-inline {
    font-size: 9px;
    color: white;
    background-color: red;
    border-radius: 3px;
    padding: 2px 5px;
    opacity: 0.9;
    margin-left: auto;
  }

  /* ─── Language Toggle ─── */
  .lang-toggle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 0;
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: rgba(230, 230, 235, 0.35);
    padding: 3px 4px;
    border-radius: 4px;
    line-height: 1;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .lang-btn:hover {
    color: rgba(230, 230, 235, 0.75);
    background: rgba(255, 255, 255, 0.06);
  }

  .lang-btn.active {
    color: #facc15;
    background: rgba(250, 204, 21, 0.1);
  }

  /* ─── Support link ─── */
  .rail-support-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 8px;
  }

  .rail-support {
    color: rgba(250, 204, 21, 0.35);
  }

  .rail-support:hover:not(.active) {
    background: rgba(250, 204, 21, 0.07);
    color: rgba(250, 204, 21, 0.8);
  }

  .more-sheet-support {
    color: rgba(250, 204, 21, 0.7);
  }

  .more-sheet-support svg {
    stroke: rgba(250, 204, 21, 0.7);
  }

  .more-sheet-support:hover {
    background: rgba(250, 204, 21, 0.06);
  }

  /* ─── Mobile Bottom Bar ─── */
  .mobile-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 56px;
    background: rgba(7, 6, 12, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    z-index: 100;
    justify-content: space-around;
    align-items: center;
    padding: 0 8px;
    -webkit-font-smoothing: antialiased;
  }

  .mobile-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 6px 12px;
    text-decoration: none;
    color: rgba(230, 230, 235, 0.45);
    border: none;
    background: none;
    cursor: pointer;
    position: relative;
    transition: color 0.15s ease;
  }

  .mobile-item.active {
    color: #facc15;
  }

  .mobile-item.active::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 2px;
    background: linear-gradient(90deg, #facc15, #f59e0b);
    border-radius: 0 0 2px 2px;
    box-shadow: 0 0 8px rgba(250, 204, 21, 0.4);
  }

  .mobile-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-icon svg {
    width: 20px;
    height: 20px;
  }

  .mobile-label {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  /* ─── More Sheet (mobile overlay) ─── */
  .more-sheet-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 200;
  }

  .more-sheet-backdrop.open {
    display: block;
  }

  .more-sheet {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(18, 16, 26, 0.98);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px 16px 0 0;
    padding: 12px 16px 32px;
    transform: translateY(100%);
    transition: transform 0.25s ease;
  }

  .more-sheet.open {
    transform: translateY(0);
  }

  .more-sheet-handle {
    width: 36px;
    height: 4px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    margin: 0 auto 16px;
  }

  .more-sheet-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 8px;
    border-radius: 8px;
    text-decoration: none;
    color: rgba(230, 230, 235, 0.78);
    border: none;
    background: none;
    width: 100%;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.12s ease;
  }

  .more-sheet-item:hover {
    background: rgba(255, 255, 255, 0.04);
  }

