    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow: hidden;
    transition: width var(--duration-normal) var(--ease-out);
  }

  .rail:hover,
  .rail:focus-within {
    width: 224px;
    box-shadow: 18px 0 36px rgba(0, 0, 0, 0.28);
  }

  .rail-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  /* ─── Rail Item ─── */
  .rail-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    width: calc(100% - 12px);
    height: 36px;
    margin-inline: 6px;
    padding-inline: 8px;
    border-radius: 8px;
    text-decoration: none;
    color: rgba(230, 230, 235, 0.45);
    transition: background 0.15s ease, color 0.15s ease;
    overflow: hidden;
  }

  .rail-item:hover:not(.active) {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(230, 230, 235, 0.85);
  }

  .rail-item.active {
    color: #facc15;
  }

  .rail-item.nav-disabled,
  .rail-item.nav-disabled:hover:not(.active),
  .rail-item.nav-disabled:hover {
    cursor: not-allowed;
    color: var(--text-disabled);
    background: transparent;
    opacity: 0.55;
  }

  .rail-label {
    min-width: 0;
    color: currentColor;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
