---
const { hero } = Astro.props;
---

<a
  class="hero-card"
  href={`/heroes/${hero.id}`}
  style={`--hero-image: url(/heroes/${hero.id}.webp);`}
>
  {hero.rating && (
    <div class={`rating-badge rating-${hero.rating.toLowerCase()}`}>
      {hero.rating}
    </div>
  )}

  <div class="name-overlay">
    <span class="hero-name">{hero.name}</span>
  </div>
</a>

<style>
/* ================================
   HERO CARD – STABLE VERSION
   ================================ */

.hero-card {
  display: block;
  width: 100%;
  height: 320px;

  position: relative;
  border-radius: 12px;

  background: #222;
  color: #fff;
  text-decoration: none;

  overflow: hidden; /* NUR HIER */
}

/* Bild-Layer */
.hero-card::before {
  content: "";
  position: absolute;
  inset: 0;

  background-image: var(--hero-image);
  background-size: cover;
  background-position: center;

  transition:
    transform 0.45s cubic-bezier(.2,.8,.2,1),
    background-position 0.45s cubic-bezier(.2,.8,.2,1);

  will-change: transform;
  z-index: 0;
}

/* Hover Zoom */
.hero-card:hover::before {
  transform: scale(1.12);
  background-position: center 35%;
}

/* UI über dem Bild */
.hero-card > * {
  position: absolute;
  z-index: 2;
}

/* ================================
   NAME OVERLAY
   ================================ */

.name-overlay {
  bottom: 0;
  left: 0;
  right: 0;

  padding: 10px 8px;
  text-align: center;

  background:
    linear-gradient(
      to top,
      rgba(10,10,16,0.9),
      rgba(10,10,16,0.55),
      rgba(10,10,16,0.15)
    );

  backdrop-filter: blur(16px) saturate(1.25);
}

.hero-name {
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.3px;
}

/* ================================
   RATING BADGE – EXTENDED TIERS
   ================================ */

.rating-badge {
  position: absolute;
  top: 8px;
  right: 8px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 28px;
  height: 22px;
  padding: 0 8px;

  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;

  border-radius: 999px;
  white-space: nowrap;

  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);

  box-shadow:
    0 2px 8px rgba(0,0,0,0.45),
    inset 0 1px 0 rgba(255,255,255,0.25);

  z-index: 4;
}

/* SSS – GOD TIER */
.rating-sss {
  background: linear-gradient(135deg, var(--tier-sss-from), var(--tier-sss-to));
  color: var(--tier-sss-text);
  box-shadow:
    0 0 12px var(--tier-sss-glow),
    inset 0 1px 0 rgba(255,255,255,0.35);
}

/* SS – TOP TIER */
.rating-ss {
  background: linear-gradient(135deg, var(--tier-ss-from), var(--tier-ss-to));
  color: var(--tier-ss-text);
}

/* S – HIGH TIER */
.rating-s {
  background: linear-gradient(135deg, var(--tier-s-from), var(--tier-s-to));
  color: var(--tier-s-text);
}

/* A – STRONG */
.rating-a {
  background: linear-gradient(135deg, var(--tier-a-from), var(--tier-a-to));
  color: var(--tier-a-text);
}

/* B – SOLID */
.rating-b {
  background: linear-gradient(135deg, var(--tier-b-from), var(--tier-b-to));
  color: var(--tier-b-text);
}

/* C – NICHE */
.rating-c {
  background: linear-gradient(135deg, var(--tier-c-from), var(--tier-c-to));
  color: var(--tier-c-text);
}

/* D – WEAK */
.rating-d {
  background: linear-gradient(135deg, var(--tier-d-from), var(--tier-d-to));
  color: var(--tier-d-text);
}

</style>
