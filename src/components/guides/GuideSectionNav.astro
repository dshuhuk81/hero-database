<nav class="guide-section-nav" data-guide-section-nav aria-label="On this page">
  <span class="guide-section-nav-label">On this page</span>
  <div class="guide-section-nav-links"></div>
</nav>

<script>
  const slugify = (value: string) =>
    value
      .toLowerCase()
      .trim()
      .replace(/&/g, " and ")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  document.querySelectorAll<HTMLElement>("[data-guide-section-nav]").forEach((nav) => {
    const body = nav.closest(".guide-body");
    const linksHost = nav.querySelector<HTMLElement>(".guide-section-nav-links");
    if (!body || !linksHost) return;

    const usedIds = new Set<string>();
    const entries = Array.from(body.querySelectorAll<HTMLElement>(":scope > .guide-section"))
      .map((section, index) => {
        const heading = section.querySelector<HTMLElement>(":scope > .guide-section-title");
        if (!heading) return null;

        const base = section.id || slugify(heading.textContent || "") || `section-${index + 1}`;
        let id = base;
        let duplicate = 2;
        while (usedIds.has(id)) id = `${base}-${duplicate++}`;
        usedIds.add(id);
        section.id = id;

        const link = document.createElement("a");
        link.className = "guide-section-nav-link";
        link.href = `#${id}`;
        link.textContent = heading.textContent?.trim() || `Section ${index + 1}`;
        linksHost.appendChild(link);
        return { section, link };
      })
      .filter((entry): entry is { section: HTMLElement; link: HTMLAnchorElement } => Boolean(entry));

    if (!entries.length) {
      nav.hidden = true;
      return;
    }

    let queued = false;
    const sync = () => {
      queued = false;
      const line = window.scrollY + nav.offsetHeight + 120;
      let current = entries[0];
      for (const entry of entries) {
        const sectionTop = entry.section.getBoundingClientRect().top + window.scrollY;
        if (sectionTop <= line) current = entry;
      }
      for (const entry of entries) {
        entry.link.classList.toggle("is-active", entry === current);
        if (entry === current) entry.link.setAttribute("aria-current", "location");
        else entry.link.removeAttribute("aria-current");
      }
    };

    window.addEventListener("scroll", () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(sync);
    }, { passive: true });

    if (location.hash) {
      requestAnimationFrame(() => document.getElementById(location.hash.slice(1))?.scrollIntoView());
    }
    sync();
  });
</script>

<style is:global>
  .guide-section-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    display: flex;
    align-items: stretch;
    width: 100%;
    margin-top: 0;
    border-top: 1px solid var(--border-faint);
    border-bottom: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-surface) 90%, transparent);
    backdrop-filter: blur(20px);
  }

  .guide-section-nav-label {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 0 var(--space-4);
    border-right: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .guide-section-nav-links {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .guide-section-nav-links::-webkit-scrollbar {
    display: none;
  }

  .guide-section-nav-link {
    flex: 0 0 auto;
    padding: var(--space-4) var(--space-5) calc(var(--space-4) - 2px);
    border-bottom: 2px solid transparent;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .guide-section-nav-link:hover {
    color: var(--text-bright);
  }

  .guide-section-nav-link.is-active {
    border-bottom-color: var(--guide-accent, var(--accent-gold));
    color: var(--guide-accent, var(--accent-gold-light));
  }

  .guide-section {
    scroll-margin-top: 88px;
  }

  @media (max-width: 720px) {
    .guide-section-nav {
      margin-right: calc(var(--space-4) * -1);
      margin-left: calc(var(--space-4) * -1);
      width: calc(100% + (var(--space-4) * 2));
    }

    .guide-section-nav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .guide-section-nav-link {
      min-height: 44px;
      padding-right: var(--space-4);
      padding-left: var(--space-4);
    }
  }
</style>
