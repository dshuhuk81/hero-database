---
import EvidenceBadge from "./EvidenceBadge.astro";
const rows = [
  { status: "confirmed", text: "Stated in game data, skill text or game code." },
  { status: "observed", text: "Seen in our own recorded fights. One account, not guaranteed." },
  { status: "community", text: "Third-party statement, with source and date." },
  { status: "interpretation", text: "Our reading of the evidence. Plausible, not proven." },
  { status: "untested", text: "Nobody has checked it yet." },
] as const;
---
<div class="gx-acc gx-legend">
  <details>
    <summary><span class="gx-sum"><strong>How sure is each claim?</strong><small>What the badges mean</small></span></summary>
    <ul class="gx-legend-list">
      {rows.map((r) => <li><EvidenceBadge status={r.status} /><span>{r.text}</span></li>)}
    </ul>
  </details>
</div>
