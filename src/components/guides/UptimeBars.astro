---
// Horizontal bars for observed durations. openEnded = lasted until the fight ended.
interface Item {
  label: string;
  value: string;
  seconds: number;
  openEnded?: boolean;
}
interface Props {
  items: Item[];
  max: number;
  unit?: string;
}
const { items, max, unit = "s" } = Astro.props;
---
<div class="gx-bars">
  {items.map((item) => (
    <div class="gx-bar-row">
      <div class="gx-bar-head"><strong>{item.label}</strong><span>{item.value}</span></div>
      <div class="gx-bar-track" role="img" aria-label={`${item.label}: ${item.value}`}>
        <div class={`gx-bar-fill${item.openEnded ? " gx-bar-fill--open" : ""}`} style={`width:${Math.min(100, Math.round((item.seconds / max) * 100))}%`}></div>
      </div>
    </div>
  ))}
  <p class="gx-bars-foot"><span>0 {unit}</span><span>{max} {unit}</span></p>
</div>
