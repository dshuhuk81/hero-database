<!-- ═══════════════════════════════════
     FILTER BAR (styled like newer variant)
     Keeps all functional hooks (ids/classes/data-*)
════════════════════════════════════ -->
<section class="filters filter-bar" id="filterBar">

  <!-- Mobile overlay header (only visible when overlay is open) -->
  <div class="filter-mobile-header" id="filterMobileHeader">
    <span class="filter-overlay-title">Filter Heroes</span>
    <button class="filter-overlay-close" id="filterOverlayClose" type="button" aria-label="Close filters">&#x2715;</button>
  </div>

  <!-- ROW 1: Class · Role · Rarity · Search · Reset -->
  <div class="filter-row filter-row--main">

    <!-- CLASS FILTER -->
    <div class="filter-group">
      <span class="filter-label">Class</span>
      <div class="chip-row">
        <button class="chip class-chip" data-class="tank" title="Tank">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/classes/tank.webp" alt="Tank" />
        </button>

        <button class="chip class-chip" data-class="warrior" title="Warrior">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/classes/warrior.webp" alt="Warrior" />
        </button>

        <button class="chip class-chip" data-class="archer" title="Archer">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/classes/archer.webp" alt="Archer" />
        </button>

        <button class="chip class-chip" data-class="mage" title="Mage">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/classes/mage.webp" alt="Mage" />
        </button>

        <button class="chip class-chip" data-class="support" title="Support">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/classes/support.webp" alt="Support" />
        </button>

        <button class="chip class-chip" data-class="assassin" title="Assassin">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/classes/assassin.webp" alt="Assassin" />
        </button>
      </div>
    </div>

    <div class="filter-divider"></div>

    <!-- ROLE FILTER -->
    <div class="filter-group">
      <span class="filter-label">Role</span>
      <div class="chip-row">
        <button class="chip role-chip" data-role="nimble" title="Nimble">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/roles/nimble.webp" alt="Nimble" />
        </button>

        <button class="chip role-chip" data-role="arcane" title="Arcane">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/roles/arcane.webp" alt="Arcane" />
        </button>

        <button class="chip role-chip" data-role="hefty" title="Hefty">
          <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/roles/hefty.webp" alt="Hefty" />
        </button>
      </div>
    </div>

    <div class="filter-divider"></div>

    <!-- RARITY FILTER -->
    <div class="filter-group">
      <span class="filter-label">Rarity</span>
      <div class="chip-row">
        <button class="chip rarity-chip common" data-rarity="common" title="Common">
          <svg viewBox="0 0 24 24" class="rarity-star">
            <path d="M12 2l2.9 6.1 6.7.6-5 4.5 1.5 6.6L12 16.8 5.9 19.8 7.4 13.2 2.4 8.7l6.7-.6L12 2z"/>
          </svg>
          <span class="rarity-name">Common</span>
        </button>

        <button class="chip rarity-chip epic" data-rarity="epic" title="Epic">
          <svg viewBox="0 0 24 24" class="rarity-star">
            <path d="M12 2l2.9 6.1 6.7.6-5 4.5 1.5 6.6L12 16.8 5.9 19.8 7.4 13.2 2.4 8.7l6.7-.6L12 2z"/>
          </svg>
          <span class="rarity-name">Epic</span>
        </button>

        <button class="chip rarity-chip legendary" data-rarity="legendary" title="Legendary">
          <svg viewBox="0 0 24 24" class="rarity-star">
            <path d="M12 2l2.9 6.1 6.7.6-5 4.5 1.5 6.6L12 16.8 5.9 19.8 7.4 13.2 2.4 8.7l6.7-.6L12 2z"/>
          </svg>
          <span class="rarity-name">Legendary</span>
        </button>
      </div>
    </div>

    <div class="filter-divider"></div>

    <!-- SEARCH -->
    <div class="filter-group filter-group--search">
      <span class="filter-label">Search</span>
      <div class="search-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          type="text"
          id="searchInput"
          placeholder="Search hero..."
          class="search-input"
        />
        <!-- optional: falls dein JS das nutzt (stört sonst nicht) -->
        <button class="search-clear" id="searchClear" aria-label="Clear search" type="button">×</button>
      </div>
    </div>

    <!-- RESET -->
    <div class="filter-group filter-group--reset">
      <span class="filter-label">&nbsp;</span>
      <button id="resetFilters" class="reset-button" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
        </svg>
        Reset Filters
      </button>
    </div>

  </div>

  <!-- ROW 2: Faction -->
  <div class="filter-row filter-row--faction">
    <div class="filter-group">
      <span class="filter-label">Faction</span>
        <div class="chip-row">
          <button class="chip faction-chip" data-faction="hearts" title="hearts">
            <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/hearts.webp" alt="hearts" />
            <span class="faction-name">Hearts</span>
          </button>

          <button class="chip faction-chip" data-faction="clubs" title="clubs">
            <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/clubs.webp" alt="clubs" />
            <span class="faction-name">Clubs</span>
          </button>

          <button class="chip faction-chip" data-faction="diamonds" title="diamonds">
            <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/diamonds.webp" alt="diamonds" />
            <span class="faction-name">Diamonds</span>
          </button>

          <button class="chip faction-chip" data-faction="spades" title="spades">
            <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/spades.webp" alt="spades" />
            <span class="faction-name">Spades</span>
          </button>

          <button class="chip faction-chip" data-faction="starglint" title="starglint">
            <img src="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/starglint.webp" alt="starglint" />
            <span class="faction-name">Starglint</span>
          </button>
        </div>
        </div>
  </div>

</section>

<style>

/* ── FILTER BAR ───────────────────────────────────────── */
.filter-bar {
  --filter-option-icon-size: 26px;
  position: relative;
  background: var(--bg-raised);
  padding: var(--space-5);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  z-index: var(--z-dropdown);
  margin-top: var(--space-6);
}

.filter-row {
  display: flex;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 4px 16px;
  overflow: visible;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

.filter-row--faction {
  display: flex;
  flex-wrap: nowrap;          /* verhindert Umbruch */
  align-items: flex-start;
  gap: 16px;
  margin-top: var(--space-4);
  overflow: visible;
}

.filter-row--faction > .filter-group {
  flex: 0 0 auto;             /* keine 100%-Basis */
  min-width: 0;               /* wichtig für overflow children */
}

/* ── GROUPS ───────────────────────────────────────────── */
.filter-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.filter-group--search {
  flex: 1;
  min-width: 180px;
}

.filter-group--reset {
  flex-shrink: 0;
}

.filter-group--wide {
  width: 100%;
}

.filter-label {
  font-size: var(--text-sm);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.55;
  padding-left: 2px;
  line-height: 1;
}

.chip-row {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}

.filter-divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.08);
  align-self: flex-end;
  margin-bottom: 4px;
  flex-shrink: 0;
}

/* ── BASE CHIP ────────────────────────────────────────── */
.chip {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 8px;
  padding: 5px;
  cursor: pointer;
  color: #e6e6eb;
  opacity: 0.65;
  transition: opacity 0.18s, transform 0.15s, border-color 0.18s, box-shadow 0.18s, background 0.18s;
  display: flex;
  align-items: center;
  gap: 5px;
}

.chip:hover {
  opacity: 0.85;
  border-color: rgba(255,255,255,0.2);
}

.chip.active {
  opacity: 1;
  border-color: rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.09);
  box-shadow: 0 0 0 1px rgba(255,255,255,0.12), 0 4px 12px rgba(0,0,0,0.4);
}

/* ── CLASS & ROLE CHIPS ───────────────────────────────── */
.class-chip img,
.role-chip img {
  width: var(--filter-option-icon-size);
  height: var(--filter-option-icon-size);
  object-fit: contain;
  filter: grayscale(100%) brightness(1.1);
  transition: filter 0.18s;
}

.class-chip:hover img, .class-chip.active img,
.role-chip:hover img,  .role-chip.active img {
  filter: brightness(1.4);
}

/* ── FACTION CHIPS ────────────────────────────────────── */
.faction-chip {
  border-radius: 20px;
  padding: 4px 10px 4px 5px;
}

.faction-chip img {
  width: var(--filter-option-icon-size);
  height: var(--filter-option-icon-size);
  object-fit: contain;
  filter: grayscale(60%) brightness(1.1);
  transition: filter 0.18s;
  border-radius: 50%;
}

.faction-chip:hover img,
.faction-chip.active img {
  filter: brightness(1.3) saturate(1.2);
}

.faction-name {
  font-size: var(--text-sm);
  font-weight: 500;
  letter-spacing: 0.03em;
  color: #e6e6eb;
  opacity: 0.9;
  white-space: nowrap;
}

/* ── RARITY CHIPS ─────────────────────────────────────── */
.rarity-star {
  width: var(--filter-option-icon-size);
  height: var(--filter-option-icon-size);
  fill: none;
  stroke: currentColor;
  stroke-width: 1.2;
  transition: fill 0.2s, filter 0.2s;
}

.rarity-chip {
  min-height: 32px;
  padding: var(--space-1) var(--space-2);
}

.rarity-name {
  color: currentColor;
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  letter-spacing: var(--tracking-wide);
  white-space: nowrap;
}

.rarity-chip.common    { color: #4ade80; }
.rarity-chip.epic      { color: #a855f7; }
.rarity-chip.legendary { color: #facc15; }

.rarity-chip.active .rarity-star,
.rarity-chip:hover .rarity-star {
  fill: currentColor;
}

.rarity-chip.active .rarity-star { filter: drop-shadow(0 0 6px currentColor); }
.rarity-chip:hover .rarity-star  { opacity: 0.6; }
.rarity-chip.active:hover .rarity-star { opacity: 1; }

/* ── SEARCH ───────────────────────────────────────────── */
.search-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.search-icon {
  position: absolute;
  left: 9px;
  width: 14px;
  height: 14px;
  color: rgba(230,230,235,0.45);
  pointer-events: none;
}

.search-input {
  width: 100%;
  height: 36px;
  padding: 0 30px 0 30px;
  border-radius: 8px;
  color: #e6e6eb;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  font-size: 0.85rem;
  transition: border-color 0.18s, background 0.18s;
  outline: none;
}

.search-input:focus {
  border-color: rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.08);
}

.search-input::placeholder { color: rgba(230,230,235,0.35); }

.search-clear {
  position: absolute;
  right: 8px;
  background: none;
  border: none;
  color: rgba(255,255,255,0.3);
  cursor: pointer;
  font-size: 0.7rem;
  padding: 2px;
  display: none; /* can be toggled by your existing JS (if any) */
  line-height: 1;
}

.search-clear.visible { display: block; }
.search-clear:hover   { color: rgba(255,255,255,0.7); }

/* ── RESET BUTTON ─────────────────────────────────────── */
.reset-button {
  height: 36px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8rem;
  font-weight: 500;
  color: rgba(230,230,235,0.6);
  background: transparent;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.18s;
  white-space: nowrap;
}

.reset-button:hover {
  color: #e6e6eb;
  border-color: rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.06);
}

/* If your JS toggles something like .has-active, keep this hook */
.reset-button.has-active {
  color: #e6e6eb;
  border-color: rgba(255,255,255,0.25);
}

/* ── RESPONSIVE ───────────────────────────────────────── */
@media (max-width: 900px) {
  .filter-divider        { display: none; }
  .filter-row--main      { gap: 10px 12px; }
  .filter-group--search  { max-width: 100%; }
}

/* Mobile overlay header: hidden by default, shown when overlay is active */
.filter-mobile-header {
  display: none;
}

@media (max-width: 768px) {
  /* Hide filter bar on mobile by default */
  .filter-bar {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 201;
    border-radius: 0;
    margin: 0;
    max-height: 100dvh;
    overflow-y: auto;
    padding: var(--space-5) var(--space-4) 100px;
    border: none;
    transform: translateY(100%);
    transition: transform 0.3s var(--ease-out, cubic-bezier(0.25,0.46,0.45,0.94));
  }

  /* When overlay is open */
  .filter-bar.filter-overlay-open {
    display: flex;
    transform: translateY(0);
  }

  .filter-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
    flex-shrink: 0;
  }

  .filter-row {
    overflow: visible;
    gap: 12px;
    align-items: stretch;
  }

  .filter-row--main,
  .filter-row--faction {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
  }

  .filter-row--main > .filter-group,
  .filter-row--faction > .filter-group,
  .filter-group--search,
  .filter-group--reset {
    flex: 0 0 auto;
    width: 100%;
    min-width: 0;
  }

  .filter-group--search {
    max-width: 100%;
  }

  .search-input {
    width: 100%;
  }

  .filter-group--reset .filter-label {
    display: none;
  }

  .reset-button {
    width: 100%;
    justify-content: center;
  }

  .filter-row--faction > .filter-group {
    flex: 0 0 auto;
    min-width: 0;
  }

  .filter-row--faction {
    flex-wrap: nowrap;
  }

  /* Faction row: allow wrapping so all chips show */
  .filter-row--faction {
    flex-wrap: nowrap;
    overflow: visible;
  }
}
</style>
