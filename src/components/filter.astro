  </div>

  <!-- ROW 2: Faction & Tags -->
  <div class="filter-row filter-row--faction">
    <div class="filter-group">
      <span class="filter-label">Faction</span>
        <div class="chip-row">
          <button class="chip faction-chip" data-faction="hearts" title="hearts">
            <img src="/icons/factions/hearts.webp" alt="hearts" />
            <span class="faction-name">Hearts</span>
          </button>

          <button class="chip faction-chip" data-faction="clubs" title="clubs">
            <img src="/icons/factions/clubs.webp" alt="clubs" />
            <span class="faction-name">Clubs</span>
          </button>

          <button class="chip faction-chip" data-faction="diamonds" title="diamonds">
            <img src="/icons/factions/diamonds.webp" alt="diamonds" />
            <span class="faction-name">Diamonds</span>
          </button>

          <button class="chip faction-chip" data-faction="spades" title="spades">
            <img src="/icons/factions/spades.webp" alt="spades" />
            <span class="faction-name">Spades</span>
          </button>

          <button class="chip faction-chip" data-faction="starglint" title="starglint">
            <img src="/icons/factions/starglint.webp" alt="starglint" />
            <span class="faction-name">Starglint</span>
          </button>
        </div>
        </div>
    <!-- ROW 3: Tags (Index-only filter) -->
    <!-- TAG FILTER (Index only) -->
    <div class="filter-group filter-group--tags">
      <span class="filter-label">Tags</span>

      <div class="tag-scroll-wrap">
        <button class="tag-scroll-btn tag-scroll-btn--left" type="button" aria-label="Scroll tags left" data-tag-scroll-left>
          <svg viewBox="0 0 20 20" aria-hidden="true" class="tag-scroll-icon">
            <path d="M12.5 4.5L7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button class="tag-scroll-btn tag-scroll-btn--right" type="button" aria-label="Scroll tags right" data-tag-scroll-right>
          <svg viewBox="0 0 20 20" aria-hidden="true" class="tag-scroll-icon">
            <path d="M7.5 4.5L13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="tag-scroll" data-tag-scroll>
          <div class="chip-row chip-row--tags" data-tag-scroll-row>
            {tags.map((tag) => (
              <button class="chip tag-chip" data-tag={tag} type="button">
                {formatTagLabel(tag)}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const scrollWrap = document.querySelector("[data-tag-scroll]");
  const scrollRow = document.querySelector("[data-tag-scroll-row]");
  const scrollLeftBtn = document.querySelector("[data-tag-scroll-left]");
  const scrollRightBtn = document.querySelector("[data-tag-scroll-right]");

  if (!scrollWrap || !scrollRow || !scrollLeftBtn || !scrollRightBtn) return;

  const getScrollStep = () => Math.max(180, Math.floor(scrollWrap.clientWidth * 0.6));

  const updateButtons = () => {
    const maxScroll = scrollRow.scrollWidth - scrollWrap.clientWidth;
    const current = scrollWrap.scrollLeft;
    scrollLeftBtn.disabled = current <= 0;
    scrollRightBtn.disabled = current >= maxScroll - 1;
  };

  scrollLeftBtn.addEventListener("click", () => {
    scrollWrap.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
  });

  scrollRightBtn.addEventListener("click", () => {
    scrollWrap.scrollBy({ left: getScrollStep(), behavior: "smooth" });
  });

  scrollWrap.addEventListener("scroll", updateButtons, { passive: true });
  window.addEventListener("resize", updateButtons);
  updateButtons();
});
</script>

<style>

/* ── TAG CHIPS (Index-only visuals) ───────────────────── */
/* Wrapper für den Scroll-Fade */
.tag-scroll-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.tag-scroll {
  width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  max-width: 100%;
  padding: 0 0 0 0;
  flex-wrap: nowrap;
  scrollbar-width: none; /* Firefox */
}

.tag-scroll::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}
/* Default: darf auf großen Screens gern wrappen */
.chip-row--tags {
  flex-wrap: nowrap;
}

/* Scrollen auf allen Screen-Größen */
.chip-row--tags {
  padding-bottom: 0px;
  scroll-snap-type: x proximity;
}

/* Chips sollen nicht schrumpfen, damit der Scroll Sinn macht */
.chip-row--tags .tag-chip {
  flex: 0 0 auto;
  white-space: nowrap;
  scroll-snap-align: start;
}

/* Scrollbar möglichst unauffällig */
.chip-row--tags::-webkit-scrollbar { height: 8px; }
.chip-row--tags::-webkit-scrollbar-track { background: transparent; }
.chip-row--tags::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.12);
  border-radius: 999px;
}
.chip-row--tags:hover::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.20);
}

.tag-scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 26px;
  height: 26px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.2);
  background: rgba(12,10,18,0.7);
  color: #e6e6eb;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0.8;
  transition: opacity 0.2s, transform 0.2s, border-color 0.2s, background 0.2s;
  z-index: 3;
}

.tag-scroll-icon {
  width: 14px;
  height: 14px;
}

.tag-scroll-btn:hover {
  opacity: 1;
  border-color: rgba(255,255,255,0.35);
  background: rgba(20,18,30,0.85);
}

.tag-scroll-btn:disabled {
  opacity: 0;
  cursor: default;
  pointer-events: none;
}

.tag-scroll-btn--left { left: 4px; }
.tag-scroll-btn--right { right: 4px; }

/* Fade links/rechts (damit “abgeschnitten” edel wirkt) */
.tag-scroll::before,
.tag-scroll::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 6px; /* passt zur padding-bottom der row */
  width: 28px;
  pointer-events: none;
  z-index: 2;
}




/* Basis: bleibt kompatibel zu .chip */
.tag-chip {
  opacity: 0.85; /* etwas sichtbarer als normale chips */
  height: 32px;
}

/* Active darf NICHT die Tag-Farbe verlieren */
.tag-chip.active {
  opacity: 1;
  box-shadow: 0 0 0 1px rgba(255,255,255,0.14), 0 4px 12px rgba(0,0,0,0.35);
}



/* ── FILTER BAR ───────────────────────────────────────── */
.filter-bar {
  position: relative;
  background: rgba(13, 12, 18, 0.94);
  padding: 16px 24px 24px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,0.12);
  border-top-color: rgba(255,255,255,0.16);
  display: flex;
  flex-direction: column;
  gap: 4px;
  z-index: 100;
    margin-top: 24px;
}

/* Blur on ::before to avoid stacking-context surprises */
.filter-bar::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 18px;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: -1;
  pointer-events: none;

}

.filter-row {
  display: flex;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 4px 16px;
  overflow: hidden;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

.filter-row--faction {
  display: flex;
  flex-wrap: nowrap;          /* verhindert Umbruch */
  align-items: flex-start;
  gap: 16px;
  margin-top: 8px;
  overflow: visible;
}

.filter-row--faction > .filter-group {
  flex: 0 0 auto;             /* keine 100%-Basis */
