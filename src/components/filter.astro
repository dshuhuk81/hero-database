---
const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";

const CLASSES = [
  { id: "tank", label: "Tank" },
  { id: "warrior", label: "Warrior" },
  { id: "archer", label: "Archer" },
  { id: "mage", label: "Mage" },
  { id: "support", label: "Support" },
  { id: "assassin", label: "Assassin" },
];

const ROLES = [
  { id: "nimble", label: "Nimble" },
  { id: "arcane", label: "Arcane" },
  { id: "hefty", label: "Hefty" },
];

const FACTIONS = [
  { id: "hearts", label: "Hearts" },
  { id: "clubs", label: "Clubs" },
  { id: "diamonds", label: "Diamonds" },
  { id: "spades", label: "Spades" },
  { id: "starglint", label: "Starglint" },
];

const RARITIES = [
  { id: "common", label: "Common" },
  { id: "epic", label: "Epic" },
  { id: "legendary", label: "Legendary" },
];

const STAR_PATH = "M12 2l2.9 6.1 6.7.6-5 4.5 1.5 6.6L12 16.8 5.9 19.8 7.4 13.2 2.4 8.7l6.7-.6L12 2z";
---

<!-- Mobile filter FAB (visible only on mobile, opens overlay) -->
<button class="filter-fab" id="filterFab" type="button" aria-label="Open filters">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
    <line x1="4" y1="6" x2="20" y2="6"/>
    <line x1="8" y1="12" x2="16" y2="12"/>
    <line x1="11" y1="18" x2="13" y2="18"/>
  </svg>
  Filter
  <span class="filter-fab-badge" id="filterFabBadge"></span>
</button>

<!-- Mobile filter overlay backdrop -->
<div class="filter-overlay-backdrop" id="filterOverlayBackdrop"></div>

<!-- ═══════════════════════════════════
     FILTER BAR (single-row, Prydwen style)
     Keeps all functional hooks (ids/classes/data-*)
════════════════════════════════════ -->
<section class="filters filter-bar" id="filterBar">

  <!-- Mobile overlay header (only visible when overlay is open) -->
  <div class="filter-mobile-header" id="filterMobileHeader">
    <span class="filter-overlay-title">Filter Heroes</span>
    <button class="filter-overlay-close" id="filterOverlayClose" type="button" aria-label="Close filters">&#x2715;</button>
  </div>

  <div class="filter-row">

    <!-- SEARCH -->
    <div class="filter-group filter-group--search">
      <div class="search-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          type="text"
          id="searchInput"
          placeholder="Search heroes..."
          class="search-input"
          aria-label="Search heroes"
        />
        <button class="search-clear" id="searchClear" aria-label="Clear search" type="button">&#x2715;</button>
      </div>
    </div>

    <div class="filter-divider" aria-hidden="true"></div>

    <!-- CLASS -->
    <div class="filter-group">
      <span class="filter-label" id="filterLabelClass">Class</span>
      <div class="chip-row" role="group" aria-labelledby="filterLabelClass">
        <button class="chip all-chip" data-group="class" title="All classes" aria-label="All classes" type="button">
          <svg viewBox="0 0 24 24" class="all-star" aria-hidden="true"><path d={STAR_PATH}/></svg>
        </button>
        {CLASSES.map(c => (
          <button class="chip class-chip" data-class={c.id} title={c.label} aria-label={c.label} type="button">
            <img src={`${R2_BASE}/icons/classes/${c.id}.webp`} alt="" width="22" height="22" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>

    <div class="filter-divider" aria-hidden="true"></div>

    <!-- ROLE -->
    <div class="filter-group">
      <span class="filter-label" id="filterLabelRole">Role</span>
      <div class="chip-row" role="group" aria-labelledby="filterLabelRole">
        <button class="chip all-chip" data-group="role" title="All roles" aria-label="All roles" type="button">
          <svg viewBox="0 0 24 24" class="all-star" aria-hidden="true"><path d={STAR_PATH}/></svg>
        </button>
        {ROLES.map(r => (
          <button class="chip role-chip" data-role={r.id} title={r.label} aria-label={r.label} type="button">
            <img src={`${R2_BASE}/icons/roles/${r.id}.webp`} alt="" width="22" height="22" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>

    <div class="filter-divider" aria-hidden="true"></div>

    <!-- FACTION -->
    <div class="filter-group">
      <span class="filter-label" id="filterLabelFaction">Faction</span>
      <div class="chip-row" role="group" aria-labelledby="filterLabelFaction">
        <button class="chip all-chip" data-group="faction" title="All factions" aria-label="All factions" type="button">
          <svg viewBox="0 0 24 24" class="all-star" aria-hidden="true"><path d={STAR_PATH}/></svg>
        </button>
        {FACTIONS.map(f => (
          <button class="chip faction-chip" data-faction={f.id} title={f.label} aria-label={f.label} type="button">
            <img src={`${R2_BASE}/icons/factions/${f.id}.webp`} alt="" width="22" height="22" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>

    <div class="filter-divider" aria-hidden="true"></div>

    <!-- RARITY -->
    <div class="filter-group">
      <span class="filter-label" id="filterLabelRarity">Rarity</span>
      <div class="chip-row" role="group" aria-labelledby="filterLabelRarity">
        <button class="chip all-chip" data-group="rarity" title="All rarities" aria-label="All rarities" type="button">
          <svg viewBox="0 0 24 24" class="all-star" aria-hidden="true"><path d={STAR_PATH}/></svg>
        </button>
        {RARITIES.map(r => (
          <button class={`chip rarity-chip ${r.id}`} data-rarity={r.id} title={r.label} aria-label={r.label} type="button">
            <svg viewBox="0 0 24 24" class="rarity-star" aria-hidden="true"><path d={STAR_PATH}/></svg>
          </button>
        ))}
      </div>
    </div>

    <div class="filter-spacer" aria-hidden="true"></div>

    <!-- RESET -->
    <div class="filter-group filter-group--reset">
      <button id="resetFilters" class="reset-button" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
        Reset
      </button>
    </div>

  </div>

</section>

<style>
/* ── FILTER BAR ───────────────────────────────────────── */
.filter-bar {
  --filter-option-icon-size: 22px;
  --filter-accent: #4c8dff;
  position: relative;
  background: var(--bg-raised);
  padding: 10px var(--space-4);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  z-index: var(--z-dropdown);
  margin-top: var(--space-6);
}

.filter-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 10px;
}

/* ── GROUPS ───────────────────────────────────────────── */
.filter-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.filter-group--search {
  flex: 1 1 200px;
  min-width: 170px;
  max-width: 300px;
}

.filter-group--reset {
  flex-shrink: 0;
}

.filter-label {
  display: none; /* labels only shown in the mobile overlay */
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.55;
  padding-left: 2px;
  line-height: 1;
}

.chip-row {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: nowrap;
}

.filter-divider {
  width: 1px;
  height: 26px;
  background: rgba(255,255,255,0.08);
  flex-shrink: 0;
}

.filter-spacer {
  flex: 1 1 auto;
  min-width: 4px;
}

/* ── BASE CHIP ────────────────────────────────────────── */
.chip {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 8px;
  padding: 0;
  cursor: pointer;
  color: #e6e6eb;
  opacity: 1;
  transition: transform 0.15s, border-color 0.18s, box-shadow 0.18s, background 0.18s;
  flex-shrink: 0;
}

.chip:hover {
  border-color: rgba(255,255,255,0.22);
}

.chip.active {
  border-color: rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.09);
  box-shadow: 0 0 0 1px rgba(255,255,255,0.12), 0 4px 12px rgba(0,0,0,0.4);
}

.chip:active { transform: scale(0.94); }

/* ── ALL CHIP (Prydwen "All" star) ────────────────────── */
.all-star {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.4;
  transition: fill 0.18s, stroke 0.18s;
}

.all-chip.active {
  background: var(--filter-accent);
  border-color: var(--filter-accent);
  color: #fff;
  box-shadow: 0 2px 10px rgba(76,141,255,0.35);
}

.all-chip.active .all-star {
  fill: #fff;
  stroke: #fff;
}

/* ── CLASS / ROLE / FACTION ICON CHIPS ────────────────── */
.class-chip img,
.role-chip img,
.faction-chip img {
  width: var(--filter-option-icon-size);
  height: var(--filter-option-icon-size);
  object-fit: contain;
  transition: filter 0.18s;
  pointer-events: none;
}

.chip.active img { filter: brightness(1.2); }

.faction-chip img { border-radius: 50%; }

/* ── RARITY CHIPS ─────────────────────────────────────── */
.rarity-star {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.3;
  transition: fill 0.2s, filter 0.2s;
}

.rarity-chip.common    { color: #4ade80; }
.rarity-chip.epic      { color: #a855f7; }
.rarity-chip.legendary { color: #facc15; }

.rarity-chip.active .rarity-star {
  fill: currentColor;
  filter: drop-shadow(0 0 6px currentColor);
}

/* ── SEARCH ───────────────────────────────────────────── */
.search-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.search-icon {
  position: absolute;
  left: 10px;
  width: 14px;
  height: 14px;
  color: rgba(230,230,235,0.45);
  pointer-events: none;
}

.search-input {
  width: 100%;
  height: 36px;
  padding: 0 30px 0 32px;
  border-radius: 8px;
  color: #e6e6eb;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  font-size: 0.85rem;
  transition: border-color 0.18s, background 0.18s;
  outline: none;
}

.search-input:focus {
  border-color: rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.08);
}

.search-input::placeholder { color: rgba(230,230,235,0.35); }

.search-clear {
  position: absolute;
  right: 8px;
  background: none;
  border: none;
  color: rgba(255,255,255,0.3);
  cursor: pointer;
  font-size: 0.7rem;
  padding: 2px;
  display: none;
  line-height: 1;
}

.search-clear.visible { display: block; }
.search-clear:hover   { color: rgba(255,255,255,0.7); }

/* ── RESET BUTTON ─────────────────────────────────────── */
.reset-button {
  height: 36px;
  padding: 0 12px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8rem;
  font-weight: 500;
  color: rgba(230,230,235,0.6);
  background: transparent;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.18s;
  white-space: nowrap;
}

.reset-button svg {
  width: 12px;
  height: 12px;
}

.reset-button:hover {
  color: #e6e6eb;
  border-color: rgba(255,255,255,0.28);
  background: rgba(255,255,255,0.06);
}

/* ── RESPONSIVE (tablet) ──────────────────────────────── */
@media (max-width: 1100px) {
  .filter-group--search { max-width: 100%; }
  .filter-spacer { display: none; }
}

/* ── MOBILE FILTER OVERLAY ────────────────────────────── */
.filter-mobile-header {
  display: none;
}

@media (max-width: 768px) {
  /* Hide filter bar on mobile by default; shown as full-screen overlay */
  .filter-bar {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 201;
    border-radius: 0;
    margin: 0;
    overflow-y: auto;
    padding: var(--space-5) var(--space-4) 100px;
    border: none;
    transform: translateY(100%);
    transition: transform 0.3s var(--ease-out, cubic-bezier(0.25,0.46,0.45,0.94));
  }

  .filter-bar.filter-overlay-open {
    display: flex;
    transform: translateY(0);
  }

  .filter-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
    flex-shrink: 0;
  }

  .filter-row {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-5);
  }

  .filter-row > .filter-group,
  .filter-group--search,
  .filter-group--reset {
    flex: 0 0 auto;
    width: 100%;
    min-width: 0;
  }

  .filter-label {
    display: block;
  }

  .filter-divider,
  .filter-spacer {
    display: none;
  }

  .chip-row {
    flex-wrap: wrap;
  }

  .chip {
    width: 40px;
    height: 40px;
  }

  .reset-button {
    width: 100%;
    justify-content: center;
  }
}
</style>

<script>
  // Mobile filter overlay: open/close wiring (works on every page using <Filter />)
  document.addEventListener("DOMContentLoaded", () => {
    const filterFab = document.getElementById("filterFab");
    const filterBar = document.getElementById("filterBar");
    const filterOverlayBackdrop = document.getElementById("filterOverlayBackdrop");
    const filterOverlayClose = document.getElementById("filterOverlayClose");

    function openFilterOverlay() {
      filterBar?.classList.add("filter-overlay-open");
      filterOverlayBackdrop?.classList.add("is-open");
      document.body.style.overflow = "hidden";
    }

    function closeFilterOverlay() {
      filterBar?.classList.remove("filter-overlay-open");
      filterOverlayBackdrop?.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    filterFab?.addEventListener("click", openFilterOverlay);
    filterOverlayClose?.addEventListener("click", closeFilterOverlay);
    filterOverlayBackdrop?.addEventListener("click", closeFilterOverlay);
  });
</script>
