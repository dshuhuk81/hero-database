---
interface Props {
  title: string;
  kicker?: string;
  description?: string;
  id?: string;
  level?: 2 | 3;
  centered?: boolean;
  class?: string;
}

const {
  title,
  kicker,
  description,
  id,
  level = 2,
  centered = false,
  class: className,
} = Astro.props;

const Heading = level === 3 ? "h3" : "h2";
const hasActions = Astro.slots.has("actions");
---

<header class:list={["content-heading", centered && "content-heading--centered", className]}>
  <div class="content-heading-copy">
    {kicker && <p class="content-heading-kicker">{kicker}</p>}
    <Heading class="content-heading-title" id={id}>{title}</Heading>
    {description && <p class="content-heading-description">{description}</p>}
  </div>
  {hasActions && <div class="content-heading-actions"><slot name="actions" /></div>}
</header>

