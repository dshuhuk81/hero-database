---
// Line icon per mechanic category (see MECHANIC_CATEGORIES in src/utils/bossRewards.js).
interface Props {
  category: string;
}

const { category } = Astro.props;
const paths: Record<string, string> = {
  energy: 'M13 2 4 14h7l-1 8 9-12h-7l1-8z',
  defense: 'M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3z',
  control: 'M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5zM12 15v2',
  targeting: 'M12 3v4M12 17v4M3 12h4M17 12h4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
  ramp: 'M3 17l6-6 4 4 8-8M15 7h6v6',
  adds: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5.5a3 3 0 0 1 0 5.5M18 14.5c1.8.9 3 2.9 3 5.5',
  other: 'M5 12h.01M12 12h.01M19 12h.01',
};
---

<svg class="boss-mechanic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[category] ?? paths.other} />
</svg>
