---
// src/components/Footer.astro
import { getLocaleFromPathname } from "../i18n/config";
import { interpolate } from "../i18n/helpers";
import { navLabel, t } from "../i18n/ui";

const locale = getLocaleFromPathname(Astro.url.pathname);
const footerClaim = t(locale, "footer", "claim").split("\n");
const copyright = interpolate(t(locale, "footer", "copyright"), {
  year: new Date().getFullYear(),
});
---
<head>
  <meta charset="utf-8" />
</head>
<footer class="site-footer">
  <div class="footer-content">
    <!-- CLAIM -->
    <div class="footer-titles">
      <h2 class="footer-claim">{footerClaim[0]}<br />{footerClaim[1]}</h2>
    </div>

    <!-- LINKS -->
    <div class="footer-links">
      <a href="/changelog" class="footer-link">{navLabel("/changelog", "Changes", locale)}</a>
      <a href="/about" class="footer-link">{navLabel("/about", "About", locale)}</a>
      <a href="/privacy" class="footer-link">{t(locale, "footer", "privacyPolicy")}</a>
    </div>

    <!-- COPYRIGHT -->
    <p class="footer-copyright">
      {copyright}
    </p>
  </div>
</footer>

<style>

  /* ===============================
     FOOTER
     =============================== */
     .footer-titles {
    margin: 0 0 48px;

     }
  .site-footer {
    margin-top: 120px;
    padding: 64px 24px 32px;
    background: linear-gradient(
      to bottom,
      rgba(10, 10, 16, 0.5),
      rgba(7, 6, 12, 0.95)
    );
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  /* CLAIM */
  .footer-claim {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 16px;
    color: #fff;
    text-align: center;
  }

  /* LINKS */
  .footer-links {
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    color: rgba(230, 230, 235, 0.7);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: #facc15;
  }

  .footer-link:visited {
    text-decoration: none;;
  }

  /* COPYRIGHT */
  .footer-copyright {
    font-size: 0.85rem;
    color: rgba(230, 230, 235, 0.5);
    margin: 0;
  }

  /* ===============================
     RESPONSIVE
     =============================== */
  @media (max-width: 768px) {
    .footer-claim {
      font-size: 1.5rem;
      margin-bottom: 32px;
    }
  }
</style>
