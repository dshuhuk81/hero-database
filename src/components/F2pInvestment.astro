---
import { getLocaleFromPathname, type Locale } from "../i18n/config";
import { pickLang, type LocalizedString } from "../i18n/helpers";
import { t } from "../i18n/ui";

interface Props {
  f2pInvestment: LocalizedString;
  locale?: Locale;
}
const { f2pInvestment, locale = getLocaleFromPathname(Astro.url.pathname) } = Astro.props as Props;
const pick = (value: LocalizedString) => pickLang(value, locale);
---

<div class="f2p-invest-card">
  <div class="fi-header">{t(locale, "common", "f2pInvestment")}</div>
  <div class="fi-body">
    <div class="fi-row">
      <span class="fi-label">{t(locale, "common", "recommendation")}</span>
      <span class="fi-value">{pick(f2pInvestment)}</span>
    </div>
  </div>
</div>

<style>
.f2p-invest-card {
  background: var(--bg-raised);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  height: 100%;
}
.fi-header {
  padding: var(--space-3) var(--space-4);
  background: var(--chip-bg);
  border-bottom: 1px solid var(--border-faint);
  font-size: 0.68rem;
  font-weight: var(--weight-black);
  text-transform: uppercase;
  letter-spacing: var(--tracking-widest);
  color: var(--text-disabled);
}
.fi-body {
  padding: var(--space-4);
}
.fi-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}
.fi-label {
  font-size: 0.7rem;
  font-weight: var(--weight-bold);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
  color: var(--text-muted);
  flex-shrink: 0;
  min-width: 110px;
}
.fi-value {
  font-size: 0.9rem;
  font-weight: var(--weight-black);
  color: var(--faction-a);
  line-height: 1.4;
}
</style>
