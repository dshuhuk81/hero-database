---
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Analytics from '@vercel/analytics/astro';
import { getAlternateLinks, getLocaleFromPathname, type Locale } from '../i18n/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
}

const {
  title = "Motto Immortal Database",
  description = "The complete hero database for Motto Immortal. Stats, skills, tier lists, team comps and boss guides for all heroes.",
  image = "/og-default.png",
  locale = getLocaleFromPathname(Astro.url.pathname)
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateLinks = getAlternateLinks(Astro.url.pathname, Astro.site);
const defaultAlternate = alternateLinks.find((entry) => entry.locale === "en");
---

<!DOCTYPE html>
<html lang={locale} data-lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="google-site-verification" content="t6k7HFdRY9c1Q_Rb80K63Aguqwr8zctSXQ28Oa2W9s4" />
  <link rel="canonical" href={canonicalURL} />
  {alternateLinks.map((entry) => (
    <link rel="alternate" hreflang={entry.locale} href={entry.href} />
  ))}
  {defaultAlternate && (
    <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
  )}
  <link rel="preconnect" href="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev" crossorigin />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site)} />

  <title>{title}</title>
  <!-- Google AdSense -->
  <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1272647850363446" crossorigin="anonymous"></script>
  <Analytics />
  <slot name="head" />
</head>
<body>
  <LanguageSwitcher />
  <Sidebar />
  <slot />
  <Footer />
</body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");
  @import '../styles/tokens.css';
  @import '../styles/reset.css';
  @import '../styles/base.css';
  @import '../styles/components.css';
</style>
