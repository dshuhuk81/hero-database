      "id": "skill_2",
      "name": "Lurking Sting",
      "description": "Serket locks onto the farthest enemy and burrows to tunnel forward, dealing 150% ATK as DMG to enemies in her path and knocking down surrounding enemies upon emerging.",
      "upgrades": {
        "level2": "Increases DMG dealt to 200% ATK.",
        "level3": "Gains a shield equal to 200% ATK upon emerging.",
        "level4": "Increases DMG dealt to 250% ATK."
      },
      "damageType": "Physical"
    },
    {
      "id": "skill_3",
      "name": "Venom Burst",
      "description": "When a summoned scorpion falls or disappears, it self-destructs, dealing DMG equal to 200% ATK to enemies within a 3-meter radius and reducing their ATK by 10% for 10s.",
      "upgrades": {
        "level2": "Increases DMG dealt to 240% ATK.",
        "level3": "Reduces enemies' ATK by 15%.",
        "level4": "Increases DMG dealt to 280% ATK."
      },
      "damageType": "Physical"
    },
    {
      "id": "skill_4",
      "name": "Sand Rebirth",
      "description": "When her HP drops below 40% for the first time, Serket immediately dives into the sand for 3s and permanently increases her max HP by 30%. While burrowing, she restores HP equal to 60% ATK per sec (Passive).",
