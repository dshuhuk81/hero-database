  "skills": [
    {
      "id": "skill_1",
      "name": "Evernight Raid",
      "description": "Nyx blinks behind the symmetrically opposite enemy at combat start, dealing DMG equal to 200% of ATK. She also prevents the target from recovering Energy for 8s and stuns them for 3s.",
      "upgrades": {
        "level2": "Increases DMG dealt to 220%.",
        "level3": "Stuns last for 4s.",
        "level4": "Increases DMG dealt to 250%."
      },
      "damageType": "Physical",
      "isUltimate": true
    },
    {
      "id": "skill_2",
      "name": "Nocturnal Judgment",
      "description": "Performs a 4-hit combo on the nearest enemy, each hit dealing DMG equal to 180% of ATK. Nyx is untargetable and continuously controls the enemy during this. The final hit stuns the target for 2s.",
      "upgrades": {
        "level2": "The last hit deals bonus DMG equal to 10% of the target's lost HP (up to 200% of Nyx's ATK).",
        "level3": "Increases DMG per hit to 200% ATK.",
        "level4": "The last hit deals bonus DMG equal to 15% of the target's lost HP (up to 300% of Nyx's ATK). (Unlocks at Lv.261)"
      },
      "damageType": "Physical"
    },
    {
      "id": "skill_3",
      "name": "Encroaching Nightfall",
      "description": "Nyx creates a Dark Domain in an enemy-clustered area and becomes untargetable for the duration. She strikes enemies in Dark Domain 3 times, each dealing DMG equal to 150% of ATK. She emerges in the end and deals DMG equal to 250% of ATK to all enemies in Dark Domain.",
      "upgrades": {
        "level2": "Strikes enemies in Dark Domain 3 times, each dealing DMG equal to 180% of ATK.",
        "level3": "Increases the final hit's DMG to 280%.",
        "level4": "The final hit is guaranteed to be a CRIT hit."
      },
      "damageType": "Physical"
    },
    {
      "id": "skill_4",
      "name": "Domain of Night",
      "description": "For each surviving ally (excluding minions) on the battlefield, Nyx gains 5% Dodge Rate and a 4% ATK boost.",
      "upgrades": {
        "level2": "For each surviving ally on the field (excluding summons), Nyx gains 10% Dodge Rate and a 5% ATK boost.",
        "level3": "During the first 10s of the battle, this skill's bonus is doubled.",
        "level4": "For each surviving ally on the field (excluding summons), Nyx gains 20% Dodge Rate and a 6% ATK boost. (Unlocks at Lv.281)"
      },
      "damageType": ""
    }
  ],
