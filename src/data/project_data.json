  "lookupRules": {
    "heroProfile": {
      "sourcePattern": "src/data/heroes/{heroId}.json",
      "aggregateCopy": "src/data/all_heroes_db.json",
      "runtimeAdapter": "src/data/heroes/index.js",
      "notes": "Hero JSON files no longer contain ratings. Runtime hero data is assembled in src/data/heroes/index.js; pages that need ratings should additionally merge src/data/ratings/hero-ratings.json (see src/data/heroes/withRatings.js)."
    },
    "heroRatings": {
      "path": "src/data/ratings/hero-ratings.json",
      "key": "heroId"
    },
    "heroInvestment": {
      "path": "src/data/ratings/invest.json",
      "key": "heroId"
    },
    "heroGuideDetail": {
      "sourcePattern": "src/data/guides/{heroId}.json",
      "listingFile": "src/data/hero-guides.json"
    },
    "cnComparison": {
      "storedAt": "src/data/heroes/{heroId}.json under optional `cn` block",
      "ingestionInput": "data-mine/cn/{heroId}.json (per-hero CN skill text)",
      "manifest": "data-mine/cn/_manifest.json",
      "engine": "src/utils/cnDiff.js",
      "pages": ["src/pages/cn-preview.astro (/cn-preview hub)", "src/pages/heroes/[id].astro (#section-cn block)"],
      "runtimeAdapter": "src/data/heroes/index.js (passes `cn` field through adaptHero)",
      "notes": "CN is the canonical base. `change` describes GLOBAL relative to CN: buff = Global better, nerf = Global worse, diff = non-numeric/ambiguous, neutral = equal. Map CN skills to Global by CONTENT, not by id or en-name. Only English skill names render. See .claude/CLAUDE.md `CN vs Global Comparison System` for the authoritative spec."
    }
  },
