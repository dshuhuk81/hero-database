{
  "_doc": {
    "purpose": "Deterministic synergy-tag detection rules. Consumed by scripts/suggest-synergy-tags.mjs. NEVER auto-writes to hero files - only produces evidence-backed suggestions for human review.",
    "ruleShape": {
      "scope": "team | enemy | self | any - which target the effect applies to, gated per sentence",
      "confidence": "strong | medium | weak - drives review priority and auto-accept eligibility",
      "patterns": "array of case-insensitive regex fragments; a sentence matches the tag if ANY pattern hits AND scope passes"
    },
    "scopeGate": {
      "ally": "\\b(all(?:y|ies)|teammates?|friendly|team|party)\\b",
      "enemy": "\\b(enem(?:y|ies)|target|foe|opponent)\\b",
      "self": "self pronoun (himself/herself/itself/self) OR hero name OR (no ally word AND no enemy word)"
    },
    "globalSuppressors": {
      "antiHeal": "sentence with 'cannot be healed' / 'healing reduced' / 'reduce healing' suppresses SELF_HEAL and TEAM_HEAL for that sentence",
      "noNormals": "hero text containing 'no longer performs normal attacks' suppresses PLAYSTYLE_BASIC_ATTACK_SCALER entirely"
    }
  },
  "rules": {
    "TEAM_ATK_SPD_UP": {
      "scope": "team",
      "confidence": "strong",
      "patterns": [
        "\\bgain\\w* .*ATK SPD",
        "ATK SPD \\+\\d",
        "grants? .*ATK SPD",
        "increases? .*ATK SPD",
        "attack speed"
      ]
    },
    "TEAM_BUFF": {
      "scope": "team",
      "confidence": "medium",
      "patterns": [
        "\\+\\d+% ATK",
        "increases? .*ATK",
        "ATK by \\d",
        "CRIT Rate",
        "CRIT DMG",
        "increases? .*DMG dealt",
        "DMG bonus",
        "grants? .*\\d+% ATK"
      ]
    },
    "TEAM_CC_IMMUNITY": {
      "scope": "team",
      "confidence": "medium",
      "patterns": [
        "immune to (?:control|CC|crowd control)",
        "control(?:-| )immun",
        "CC immun",
        "cannot be (?:controlled|stunned|frozen)",
        "Super Armor"
      ]
    },
    "TEAM_CDR": {
      "scope": "team",
      "confidence": "medium",
      "patterns": [
        "cooldown",
        "\\bCD\\b",
        "cooldown haste",
        "reduc\\w* .*cooldown"
      ]
    },
    "TEAM_DAMAGE_REDUCTION": {
      "scope": "team",
      "confidence": "strong",
      "patterns": [
        "DMG RED",
        "reduc\\w* (?:the )?DMG taken",
        "damage reduction",
        "reduc\\w* damage taken",
        "take\\w* \\d+% less DMG"
      ]
    },
    "TEAM_DEBUFF_CLEANSE": {
      "scope": "team",
      "confidence": "strong",
      "patterns": [
        "cleans\\w*",
        "remove\\w* (?:one |a |all )?(?:debuff|negative effect|control effect)",
        "dispel\\w* (?:debuff|negative)",
        "clears? (?:debuff|negative)",
        "purif\\w*"
      ]
    },
    "TEAM_ENERGY_RESTORE": {
      "scope": "team",
      "confidence": "strong",
      "patterns": [
        "restore\\w* \\d+ Energy",
        "Energy Regen",
        "restore\\w* Energy",
        "grants? .*Energy",
        "\\d+ Energy per sec"
      ]
    },
    "TEAM_HEAL": {
      "scope": "team",
      "confidence": "strong",
      "patterns": [
        "restor(?:e|es|ed|ing) HP",
        "heal\\w*",
        "recover\\w* HP",
        "restor(?:e|es|ed|ing) .*max HP"
      ]
    },
    "TEAM_SHIELD": {
      "scope": "team",
      "confidence": "strong",
      "patterns": [
        "shield"
      ]
    },
    "ENEMY_ATK_DOWN": {
      "scope": "enemy",
      "confidence": "strong",
      "patterns": [
        "ATK (?:is )?reduced",
        "reduc\\w* (?:their |the )?ATK",
        "lower\\w* .*ATK",
        "ATK down",
        "-\\d+% ATK"
      ]
    },
    "ENEMY_ATK_SPD_DOWN": {
      "scope": "enemy",
      "confidence": "medium",
      "patterns": [
        "ATK SPD reduced",
        "reduc\\w* .*ATK SPD",
        "slow\\w* .*attack",
        "attack speed reduced"
      ]
    },
    "ENEMY_BUFF_DISPEL": {
      "scope": "enemy",
      "confidence": "medium",
      "patterns": [
        "dispel\\w* .*(?:buff|positive|beneficial)",
        "remove\\w* (?:buff|positive|beneficial)",
        "strip\\w* .*buff",
        "purg\\w*"
      ]
    },
    "ENEMY_CROWD_CONTROL": {
      "scope": "enemy",
      "confidence": "strong",
      "patterns": [
        "stun",
        "freez\\w*",
        "frozen",
        "\\broot",
        "sleep",
        "charm",
        "silenc\\w*",
        "knock(?:s|ed|ing)?(?: down| back| up| airborne)?",
        "knockback",
        "knockdown",
        "petrif\\w*",
        "immobiliz\\w*",
        "suppress\\w*",
        "\\bfear(?:ed|s|ing)?\\b",
        "pull\\w* (?:in|\\d|the|all|nearby|nearest|toward)",
        "push\\w* \\d",
        "ensnar\\w*",
        "snare",
        "entangl\\w*",
        "banish\\w*",
        "interrupt\\w*",
        "airborne",
        "\\bnet\\b"
      ]
    },
    "ENEMY_VULNERABILITY": {
      "scope": "enemy",
      "confidence": "strong",
      "patterns": [
        "take\\w* .*?(?:more|increased) DMG",
        "(?:more|increased) DMG (?:from|for|taken|during)",
        "increases? DMG taken",
        "DMG taken (?:is |by )",
        "vulnerab",
        "amplif\\w* DMG",
        "\\d+% (?:more|increased) DMG"
      ]
    },
    "ENEMY_ENERGY_DRAIN": {
      "scope": "enemy",
      "confidence": "medium",
      "patterns": [
        "drain\\w* .*Energy",
        "reduc\\w* .*Energy",
        "remove\\w* .*Energy",
        "Energy (?:is )?reduced",
        "lose\\w* .*Energy"
      ]
    },
    "ENEMY_DAMAGE_DEALT_DOWN": {
      "scope": "enemy",
      "confidence": "strong",
      "patterns": [
        "deal\\w* \\d+% less DMG",
        "reduc\\w* .*DMG dealt by enem",
        "decreas\\w* .*DMG dealt by enem",
        "enemy damage dealt (?:is )?reduced"
      ]
    },
    "ENEMY_ATTRIBUTE_REDUCTION": {
      "scope": "enemy",
      "confidence": "medium",
      "patterns": [
        "reduc\\w* .*(?:M-RES|Armor|DEF|stats|attributes|Crit)",
        "lower\\w* .*(?:M-RES|Armor|DEF|stats|attributes)",
        "-\\d+% (?:M-RES|Armor|DEF)"
      ]
    },
    "ENEMY_ARMOR_REDUCTION": {
      "scope": "enemy",
      "confidence": "strong",
      "patterns": [
        "reduc\\w* .*Armor",
        "Armor (?:is )?reduced",
        "ignore\\w* .*Armor",
        "Armor reduction",
        "-\\d+% Armor",
        "remove\\w* .*Armor",
        "armor pen"
      ]
    },
    "ENEMY_TAUNT": {
      "scope": "enemy",
      "confidence": "strong",
      "patterns": [
        "taunt"
      ]
    },
    "PLAYSTYLE_AREA_DAMAGE": {
      "scope": "any",
      "confidence": "strong",
      "patterns": [
        "enemies (?:within|in|along)",
        "all enemies",
        "nearby enemies",
        "\\bAoE\\b",
        "enemies along the path",
        "enemies in a",
        "all units"
      ]
    },
    "PLAYSTYLE_BASIC_ATTACK_SCALER": {
      "scope": "any",
      "confidence": "strong",
      "patterns": [
        "normal attack",
        "basic attack"
      ]
    },
    "SELF_ATK_SPEED": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "\\bgain\\w* .*ATK SPD",
        "ATK SPD \\+\\d",
        "increases? .*ATK SPD",
        "attack speed"
      ]
    },
    "SELF_ATK_UP": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "gains? .*\\d+% ATK",
        "ATK \\+",
        "increases? .*own ATK",
        "increases? ATK by"
      ]
    },
    "SELF_CC_RESISTANCE": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "control res",
        "CC res",
        "resist\\w* .*(?:control|CC|stun)",
        "Super Armor",
        "tenacity",
        "control resistance"
      ]
    },
    "SELF_DAMAGE_REDUCTION": {
      "scope": "self",
      "confidence": "strong",
      "patterns": [
        "DMG RED",
        "reduc\\w* (?:the )?DMG taken",
        "damage reduction",
        "take\\w* \\d+% less DMG"
      ]
    },
    "SELF_DODGE": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "gains? .*Dodge Rate",
        "increases? .*Dodge Rate",
        "Dodge Rate \\+",
        "evasion",
        "evade"
      ]
    },
    "SELF_ENERGY_RESTORE": {
      "scope": "self",
      "confidence": "strong",
      "patterns": [
        "restore\\w* \\d+ Energy",
        "gains? \\d+ Energy",
        "Energy Regen",
        "restore\\w* .*Energy to himself",
        "restore\\w* .*Energy to herself",
        "\\d+ bonus Energy"
      ]
    },
    "SELF_DEF_IGNORE": {
      "scope": "self",
      "confidence": "strong",
      "patterns": [
        "ignor\\w* .*DEF",
        "DEF (?:is )?ignored",
        "DEF ignore"
      ]
    },
    "SELF_ARMOR_UP": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "\\d+%? Armor\\b",
        "Armor \\+\\d",
        "increases? .*own Armor",
        "increases? Armor by"
      ]
    },
    "SELF_HEAL": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "restor(?:e|es|ed|ing) HP",
        "heal\\w*",
        "recover\\w* HP"
      ]
    },
    "SELF_HEAL_EFFECT_UP": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "increases? healing (?:effect|received)",
        "healing (?:is )?increased",
        "heal\\w* effect (?:is )?increased",
        "healing effect is increased"
      ]
    },
    "SELF_HIT_AVOID": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "invincib",
        "immune to (?:the )?DMG",
        "cannot be (?:hit|targeted)",
        "untargetable",
        "block\\w* (?:the )?(?:next )?attack",
        "becomes immune"
      ]
    },
    "SELF_HP_UP": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "max HP \\+",
        "increases? .*max HP",
        "\\+\\d+% max HP",
        "increases? HP by",
        "gains? .*max HP"
      ]
    },
    "SELF_LIFESTEAL_UP": {
      "scope": "self",
      "confidence": "strong",
      "patterns": [
        "lifesteal",
        "life steal",
        "leech"
      ]
    },
    "SELF_SHIELD": {
      "scope": "self",
      "confidence": "strong",
      "patterns": [
        "shield"
      ]
    },
    "DEATH_PREVENTION": {
      "scope": "any",
      "confidence": "strong",
      "patterns": [
        "about to fall.*rewind",
        "rewinds? .*optimal state",
        "prevents? (?:their |his |her )?death",
        "cannot (?:fall|die)",
        "surviv\\w* lethal"
      ]
    },
    "REVIVE": {
      "scope": "any",
      "confidence": "strong",
      "patterns": [
        "reviv\\w*",
        "resurrect\\w*",
        "return\\w* to (?:battle|life)",
        "brought back to life",
        "back to battle"
      ]
    },
    "SUMMON": {
      "scope": "any",
      "confidence": "medium",
      "patterns": [
        "summon\\w* (?:a |an |the |two |\\d+ )?(?:minion|ingot|clone|spirit|sentry|turret|totem|puppet|projection|echo|figurine|scorpion|device|castor)",
        "conjur\\w*",
        "creates? (?:a |two |\\d+ )?(?:minion|ingot|clone|spirit|sentry|turret|totem|puppet|projection|echo|figurine|scorpion|device|castor)",
        "surrounded by \\d"
      ]
    },
    "SELF_SUSTAIN": {
      "scope": "self",
      "confidence": "medium",
      "patterns": [
        "lifesteal",
        "life steal",
        "restor(?:e|es|ed|ing) HP",
        "heal\\w* (?:himself|herself|itself|self)",
        "invincib",
        "recover\\w* HP"
      ]
    }
  }
}
