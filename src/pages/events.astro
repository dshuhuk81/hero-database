---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import "../styles/compositions.css";
import "../styles/events.css";
import "../styles/components.css";
import { getPageUpdate } from "../utils/getPageUpdate";
import allHeroes from "../data/all_heroes_db.json";
import eventsData from "../data/events.json";

const pageUpdate = getPageUpdate("events");

function getHero(heroId: string) {
  return allHeroes[heroId as keyof typeof allHeroes];
}

function campaignFactionIcon(faction: string) {
  return `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/${String(faction || "").toLowerCase()}.webp`;
}

const campaigns = eventsData.campaigns.map((campaign) => {
  const campaignHero = getHero(campaign.hero);

  return {
    ...campaign,
    heroId: campaignHero?.id ?? campaign.hero,
    stages: campaign.stages.map((stage) => ({
      ...stage,
      frontHeroes: stage.composition.front.map(id => getHero(id)).filter(Boolean),
      backHeroes: stage.composition.back.map(id => getHero(id)).filter(Boolean),
    })),
  };
});
---

<Base title="Event Guides | Motto Immortal">
<PageHero
  tag="PvE"
  headline="Event Guides"
  subtitle="Campaign stages & event team compositions"
  pageUpdate={pageUpdate}
/>

<div class="page-wrapper">
  <div class="content-wrapper">

    <!-- Campaign sub-tabs -->
    <div class="main-tabs">
      {campaigns.map((campaign, index) => (
        <button
          class={`main-tab ${index === 0 ? "is-active" : ""}`}
          data-campaign-tab={campaign.id}
          data-hero-id={campaign.heroId}
          data-campaign-name={campaign.name}
          data-campaign-description={campaign.description}
        >
          {campaign.name}
        </button>
      ))}
    </div>

    <!-- Campaign slides -->
    <main class="events-main">
      {campaigns.map((campaign, index) => (
        <div class={`event-slide ${index === 0 ? "is-active" : ""}`} id={campaign.id}>
          <!-- STAGES LIST -->
          <div class="stages-container">
            {campaign.stages.map((stage) => (
              <div class="stage-card">
                <div class="stage-header">
                  <h3 class="stage-title">{stage.name}</h3>
                </div>

                <!-- TEAM COMPOSITION -->
                <div class="formation-grid">
                  <!-- SINGLE ROW: 2 FRONT + 3 BACK -->
                  <div class="formation-row full-team">
                    {/* Front heroes */}
                    {stage.frontHeroes.map((hero) => (
                      <a class="hero-card" href={`/heroes/${hero.id}`}>
                        <div class="position-badge front">Front</div>
                        <div class="hero-card-inner">
                          <div class="hero-image-wrapper">
                            <img
                              src={hero.image}
                              alt={hero.name}
                              class="hero-image"
                              loading="lazy"
                              decoding="async"
                            />
                          </div>
                          <div class="hero-info">
                            <h4 class="hero-name">{hero.name}</h4>
                            <div class="hero-meta">
                              <img
                                src={campaignFactionIcon(hero.faction)}
                                alt={hero.faction}
                                class="faction-icon-small"
                                title={hero.faction}
                                loading="lazy"
                                decoding="async"
                              />
                            </div>
                          </div>
                        </div>
                      </a>
                    ))}
                    {/* Fill empty front slots if less than 2 */}
                    {Array.from({ length: 2 - stage.frontHeroes.length }).map(() => (
                      <div class="hero-card-slot empty"></div>
                    ))}

                    {/* Back heroes */}
                    {stage.backHeroes.map((hero) => (
                      <a class="hero-card" href={`/heroes/${hero.id}`}>
                        <div class="position-badge back">Back</div>
                        <div class="hero-card-inner">
                          <div class="hero-image-wrapper">
                            <img
                              src={hero.image}
                              alt={hero.name}
                              class="hero-image"
                              loading="lazy"
                              decoding="async"
                            />
                          </div>
                          <div class="hero-info">
                            <h4 class="hero-name">{hero.name}</h4>
                            <div class="hero-meta">
                              <img
                                src={campaignFactionIcon(hero.faction)}
                                alt={hero.faction}
                                class="faction-icon-small"
                                title={hero.faction}
                                loading="lazy"
                                decoding="async"
                              />
                            </div>
                          </div>
                        </div>
                      </a>
                    ))}
                    {/* Fill empty back slots if less than 3 */}
                    {Array.from({ length: 3 - stage.backHeroes.length }).map(() => (
                      <div class="hero-card-slot empty"></div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </main>

  </div>
</div>

</Base>

<script>
  const campaignTabs = document.querySelectorAll('[data-campaign-tab]');
  const campaignSlides = document.querySelectorAll('.event-slide');

  campaignTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const tabId = tab.getAttribute('data-campaign-tab');
      if (!tabId) return;

      campaignTabs.forEach(t => t.classList.remove('is-active'));
      campaignSlides.forEach(s => s.classList.remove('is-active'));

      tab.classList.add('is-active');
      const slide = document.getElementById(tabId);
      if (slide) {
        slide.classList.add('is-active');
      }
    });
  });
</script>
