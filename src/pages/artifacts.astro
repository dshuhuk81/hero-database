    goalOut: document.getElementById("goalOut"),
    note: document.getElementById("simNote"),
    stoneLabel: document.getElementById("stoneTierLabel"),
    qualLabel: document.getElementById("qualLabel")
  };

  const pool = () => D.POOLS[state.slot];
  const openSlots = () => Math.max(0, state.tier - state.locked.length);

  /* fodder families that the game would actually offer for this slot */
  const offeredFams = () => {
    const p = new Set(pool());
    return D.FAM.filter(f => [...f.p2, ...f.p1].some(id => p.has(id)));
  };

  /* smallest stone count per target that pins every goal at 100 % */
  function minStonesToPin(goals, tier, k){
    if (!goals.length || k <= 0) return null;
    for (let n = 1; n <= 400; n++){
      const stones = {};
      goals.forEach(g => stones[g] = n);
      const probs = calcPool(pool(), buildDeltas(stones, tier, {}, 13), state.locked, k);
      if (goals.every(g => (probs.get(g) ?? 0) >= 1 - 1e-12)) return n;
    }
    return null;
  }

  function draw(){
    /* --- controls --- */
    segment(el.slot, [1,2,3,4].map(s => ({ label: "Slot " + s, value: s })),
      state.slot, v => { state.slot = v; state.stones = {}; state.locked = []; state.goals = []; draw(); });
    segment(el.tier, [1,2,3,4].map(t => ({ label: t + (t === 1 ? " effect" : " effects"), value: t })),
      state.tier, v => { state.tier = v; state.locked = state.locked.slice(0, v - 1); draw(); });
    const stoneFrames = ["△ T1", "◇ T2", "⬠ T3", "★ T4", "✦ T5"];
    segment(el.stone, [1,2,3,4,5].map(t => ({ label: stoneFrames[t - 1], value: t })),
      state.stoneTier, v => { state.stoneTier = v; draw(); });
    segment(el.qual, [8,10,12,13].map(q => ({ label: "q" + q, value: q })),
      state.quality, v => { state.quality = v; draw(); });

    el.stoneLabel.textContent = "· T" + state.stoneTier + " (+" +
      D.STONE_ADD[state.stoneTier].toLocaleString("en-US") + " each)";
    el.qualLabel.textContent = "· quality " + state.quality + " (±" + D.QS[state.quality][0] + ")";

    /* --- maths --- */
    const ids = pool();
    const deltas = buildDeltas(state.stones, state.stoneTier, state.fodder, state.quality);
    const weights = weightsOf(ids, deltas);
    const k = openSlots();
    const probs = calcPool(ids, deltas, state.locked, k);
    const boosted = new Set(Object.keys(state.stones).filter(i => state.stones[i] > 0).map(Number));

    renderPan(el.pan, ids, weights, probs, {
      locked: state.locked,
      boosted,
      onLock: a => {
        const i = state.locked.indexOf(a);
        if (i >= 0) state.locked.splice(i, 1);
        else if (state.locked.length < state.tier) state.locked.push(a);
        draw();
      }
    });

    /* --- readout --- */
    const stoneCount = Object.values(state.stones).reduce((x, y) => x + y, 0);
    const fodderCount = Object.values(state.fodder).reduce((x, y) => x + y, 0);
    const pinned = ids.filter(a => (probs.get(a) ?? 0) >= 1 && !state.locked.includes(a)).length;
    const dropped = ids.filter(a => !probs.has(a) && !state.locked.includes(a)).length;
    const rows = [
      ["Open slots", k + " of " + state.tier],
      ["Guaranteed this roll", pinned],
      ["Below the 1 % floor", dropped],
      ["Total weight", Object.values(weights).reduce((x, y) => x + y, 0).toLocaleString("en-US")],
      ["Cost", "1 Refining Stone · " + stoneCount + " stones · " + fodderCount + " artifacts"]
    ];
    el.readout.textContent = "";
    rows.forEach(([kk, vv]) => {
      const d = document.createElement("div");
      d.innerHTML = '<span class="k">' + kk + '</span><span class="v">' + vv + "</span>";
      el.readout.appendChild(d);
    });
    el.note.textContent = k === 0
      ? "every effect is locked — nothing can be refined"
      : k + (k === 1 ? " effect will re-roll" : " effects will re-roll together");

    /* --- stone tray --- */
    el.stoneTbl.textContent = "";
    ids.forEach(a => {
      const s = D.STAT[a];
      const tr = document.createElement("tr");
      const c1 = document.createElement("td");
      c1.innerHTML = '<span class="art"><img class="ico ico-sm" src="' + ICON.refine + '" alt="">' +
        "<span>" + s.n + "</span></span>";
      const c2 = document.createElement("td");
      c2.style.textAlign = "right";
      c2.appendChild(stepper(state.stones[a] || 0, v => { state.stones[a] = v; draw(); }, 400));
      tr.append(c1, c2);
      el.stoneTbl.appendChild(tr);
    });

    /* --- fodder tray --- */
    el.fodderTbl.textContent = "";
    offeredFams().forEach(f => {
      const inPool = id => ids.includes(id);
      const up = f.p2.filter(inPool).map(i => D.STAT[i].n);
      const mid = f.p1.filter(inPool).map(i => D.STAT[i].n);
      const dn = f.m2.filter(inPool).map(i => D.STAT[i].n);
      const tr = document.createElement("tr");
      const c1 = document.createElement("td");
      c1.innerHTML = '<span class="art"><img class="ico" src="' + ICON[f.k] + '" alt="">' +
        "<span><b>" + f.t + " · Slot " + f.s + "</b><br>" +
        (up.length ? '<span class="chip up">↑↑ ' + up.join(", ") + "</span> " : "") +
        (mid.length ? '<span class="chip mut">↑ ' + mid.join(", ") + "</span> " : "") +
        (dn.length ? '<span class="chip dn">↓↓ ' + dn.join(", ") + "</span>" : "") +
        "</span></span>";
      const c2 = document.createElement("td");
      c2.style.textAlign = "right";
      c2.appendChild(stepper(state.fodder[f.k] || 0, v => { state.fodder[f.k] = v; draw(); }, 99));
      tr.append(c1, c2);
      el.fodderTbl.appendChild(tr);
    });

    /* --- goal planner --- */
    el.goalPick.textContent = "";
    ids.forEach(a => {
      const on = state.goals.includes(a);
      const b = document.createElement("button");
      b.type = "button";
      b.className = "chip " + (on ? "br" : "mut");
      b.style.cssText = "cursor:pointer;background:" + (on ? "var(--brass-wash)" : "transparent") +
        ";padding:.3rem .55rem;font-size:.72rem";
      b.setAttribute("aria-pressed", String(on));
      b.textContent = D.STAT[a].n;
      b.addEventListener("click", () => {
        const i = state.goals.indexOf(a);
        if (i >= 0) state.goals.splice(i, 1);
        else if (state.goals.length < 4) state.goals.push(a);
        draw();
      });
      el.goalPick.appendChild(b);
    });

    el.goalOut.textContent = "";
    if (!state.goals.length){
      el.goalOut.innerHTML = '<p style="color:var(--ink-faint);font-size:.9rem">' +
        "Pick up to four stats above. The planner works out the cheapest guaranteed route " +
        "and the shortcut that beats it.</p>";
    } else if (state.goals.length > k){
      el.goalOut.innerHTML = '<div class="callout warn">You picked <b>' + state.goals.length +
        "</b> stats but only <b>" + k + "</b> " + (k === 1 ? "slot is" : "slots are") +
        " open. Raise the Tier, or unlock an effect.</div>";
    } else {
      const tier = state.stoneTier, label = "T" + tier;
      const allAtOnce = minStonesToPin(state.goals, tier, k);
      const g = state.goals;
      let html = "";

      if (allAtOnce === null){
        html += '<div class="callout warn">No number of ' + label +
          " stones pins all of these at once with " + k + " open slots. Use a higher tier, " +
          "or stage it as below.</div>";
      } else {
        html += '<div class="callout"><b>All in one refine:</b> ' + allAtOnce + "× " + label +
          " stone on <em>each</em> of the " + g.length + " targets — <b>" + (allAtOnce * g.length) +
          " stones</b> total, plus 1 Refining Stone.</div>";
      }

      if (g.length === k && k > 1){
        const first = minStonesToPin(g.slice(0, k - 1), tier, k);
        const last = minStonesToPin(g.slice(k - 1), tier, 1);
        if (first !== null && last !== null){
          const staged = first * (k - 1) + last;
          html += '<div class="callout good" style="margin-top:var(--s2)"><b>Staged — usually far cheaper:</b>' +
            "<br>Refine once with " + first + "× " + label + " on each of the first " + (k - 1) +
            " (<b>" + first * (k - 1) + " stones</b>), Fate-lock those " + (k - 1) +
            ", then refine again for the last with <b>" + last + " stones</b>." +
            "<br><b>Total " + staged + " stones</b>, 2 Refining Stones, " + (k - 1) + " Fate locks" +
            (allAtOnce !== null && staged < allAtOnce * g.length
              ? " — saves " + (allAtOnce * g.length - staged) + " stones."
              : ".") + "</div>";
        }
      }
      html += '<p style="font-size:.86rem;color:var(--ink-faint);margin-top:var(--s2)">' +
        "Counts are exact, not estimates — each is the smallest number at which the game's own " +
        "calculator returns 100 %.</p>";
      el.goalOut.innerHTML = html;
    }
  }

  el.reset.addEventListener("click", () => {
    state.stones = {}; state.fodder = {}; state.locked = []; state.goals = []; draw();
  });
  draw();
})();

  </script>
</Base>

<style is:global>

.artifacts-page{
