.zeus-stage-copy{position:relative;z-index:1;align-self:center;padding:var(--space-12)}
.zeus-stage-copy h3{font-size:clamp(2rem,4vw,3.4rem);line-height:1;margin-top:var(--space-4)}
.zeus-stage-copy p{max-width:48ch;color:var(--ink-soft);font-size:1.05rem;margin-top:var(--space-5)}
.unlock-path{display:grid;grid-template-columns:minmax(240px,.8fr) minmax(0,1.2fr);gap:var(--space-10);align-items:center;padding-block:var(--space-8);border-block:1px solid var(--rule)}
.unlock-path p{max-width:55ch;color:var(--ink-soft);margin-top:var(--space-3)}
