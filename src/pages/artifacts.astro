  --oxide:var(--tier-splus-from);--oxide-wash:var(--rarity-legendary-glow);
  --bar:var(--border-strong);--bar-hi:var(--accent-gold);--focus:var(--accent-purple);--shadow:none;
  --display:var(--font-base);--sans:var(--font-base);--mono:var(--font-mono);
