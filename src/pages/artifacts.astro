(function simulator(){
  const state = { slot: 1, tier: 4, stoneTier: 3, quality: 13, stones: {}, fodder: {}, locked: [], goals: [] };

  const el = {
    slot: document.getElementById("simSlot"),
    tier: document.getElementById("simTier"),
