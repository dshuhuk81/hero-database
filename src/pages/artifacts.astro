@media(max-width:620px){.pan-row{grid-template-columns:1.5rem 1fr 3.4rem; }
  .pan-row .track{grid-column:1/-1} .pan-row .wt{display:none}}
.pan-row .nm{font-size:.83rem; line-height:1.25}
