  .tw-bug-card {
    border-top: 3px solid #ef4444;
    background: rgba(239, 68, 68, 0.04);
    border-color: rgba(239, 68, 68, 0.25);
  }

  .tw-bug-card:hover {
    border-color: rgba(239, 68, 68, 0.4);
  }

  .tw-bug-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(239, 68, 68, 0.2);
  }

  .tw-bug-badge {
    display: inline-block;
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.5);
    color: #fca5a5;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .tw-bug-impact {
    background: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    margin-top: 16px;
  }

  .tw-bug-impact-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fca5a5;
    margin-bottom: 10px;
  }

  .tw-bug-impact ul {
    margin: 0;
    padding-left: 18px;
  }

  .tw-bug-impact li {
    font-size: 0.88rem;
    line-height: 1.75;
    color: #d1d1db;
    margin-bottom: 5px;
  }

  /* ================================================================
     INTRO FLOOR BREAKDOWN
     ================================================================ */
  .floor-breakdown {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 20px 0;
  }

  .floor-range {
    border-radius: var(--radius-md);
    padding: 16px 18px;
    border: 1px solid;
  }

  .floor-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .floor-desc {
    font-size: 0.87rem;
    color: #d1d1db;
    line-height: 1.65;
    margin: 0;
  }

  .floor-early { background: rgba(74, 222, 128, 0.06); border-color: rgba(74, 222, 128, 0.25); }
  .floor-early .floor-label { color: #86efac; }
  .floor-mid   { background: rgba(250, 204, 21, 0.07); border-color: rgba(250, 204, 21, 0.28); }
  .floor-mid   .floor-label { color: #fcd34d; }
  .floor-hard  { background: rgba(239, 68, 68, 0.07);  border-color: rgba(239, 68, 68, 0.3); }
  .floor-hard  .floor-label { color: #fca5a5; }

  /* ================================================================
     CALLOUT / KEYBOX
     ================================================================ */
  .tw-callout {
    background: rgba(168, 85, 247, 0.08);
    border-left: 3px solid rgba(168, 85, 247, 0.5);
    padding: 14px 18px;
    margin: 18px 0 0;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    line-height: 1.75;
    color: #d1d1db;
  }

  .tw-keybox {
    background: rgba(250, 204, 21, 0.06);
    border: 1px solid rgba(250, 204, 21, 0.25);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    margin-top: 20px;
  }

  .tw-keybox-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fcd34d;
    margin-bottom: 12px;
  }

  .tw-keybox ul { margin: 0; padding-left: 18px; }
  .tw-keybox li { color: #d1d1db; font-size: 0.9rem; line-height: 1.75; margin-bottom: 6px; }

  /* ================================================================
     FACTION OVERVIEW GRID
     ================================================================ */
  .faction-overview-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 20px;
  }

  .faction-tile {
    border-radius: var(--radius-md);
    padding: 18px 20px;
    border: 1px solid;
    position: relative;
  }

  .faction-tile-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .faction-tile-icon { width: 28px; height: 28px; object-fit: contain; }
  .faction-tile-name { font-size: 1.05rem; font-weight: 700; color: var(--text-bright); }

  .faction-tile-difficulty {
    margin-left: auto;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: var(--radius-full);
  }

  .diff-stable      { background: rgba(99, 102, 241, 0.2);  color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.4); }
  .diff-strict      { background: rgba(239, 68, 68, 0.15);  color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.35); }
  .diff-volatile    { background: rgba(251, 146, 60, 0.15); color: #fdba74; border: 1px solid rgba(251, 146, 60, 0.35); }
  .diff-compromised { background: rgba(239, 68, 68, 0.22);  color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.5); }

  .faction-tile-stats {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .faction-tile-stats li {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    margin: 0;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .stat-label { color: rgba(209, 209, 219, 0.55); }
  .stat-val   { color: #e2e2e9; font-weight: 500; }

  .faction-tile-summary {
    font-size: 0.86rem;
    line-height: 1.65;
    color: rgba(209, 209, 219, 0.8);
    margin: 0;
  }

  .faction-tile-spades   { background: rgba(99, 102, 241, 0.06);  border-color: rgba(99, 102, 241, 0.22); }
  .faction-tile-hearts   { background: rgba(239, 68, 68, 0.06);   border-color: rgba(239, 68, 68, 0.22); }
  .faction-tile-diamonds { background: rgba(251, 146, 60, 0.06);  border-color: rgba(251, 146, 60, 0.22); }
  .faction-tile-clubs-warn { background: rgba(239, 68, 68, 0.05); border-color: rgba(239, 68, 68, 0.3); }

  /* ================================================================
     FACTION SECTION HEADERS
     ================================================================ */
  .faction-section { border-top-width: 3px; border-top-style: solid; }
  .faction-section-spades   { border-top-color: #6366f1; }
  .faction-section-hearts   { border-top-color: #ef4444; }
  .faction-section-diamonds { border-top-color: #f97316; }
  .faction-section-clubs    { border-top-color: #22c55e; }
  .faction-section-clubs-compromised { border-top-color: #ef4444; background: rgba(239, 68, 68, 0.02); }

  .faction-section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .faction-section-icon { width: 44px; height: 44px; object-fit: contain; flex-shrink: 0; }

  .faction-section-name {
    margin: 0 0 4px;
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--text-bright);
    padding-bottom: 0;
    border-bottom: none;
  }

  .faction-section-tagline {
    margin: 0;
    font-size: 0.88rem;
    color: rgba(209, 209, 219, 0.6);
    line-height: 1.4;
  }

  .faction-compromised-badge {
    margin-left: auto;
    flex-shrink: 0;
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.45);
    color: #fca5a5;
  }

  /* ================================================================
     WESTERN STATUS TAG
     ================================================================ */
  .tw-west-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 5px 14px;
    border-radius: var(--radius-full);
    margin-bottom: 20px;
  }

  .tw-west-tag-good    { background: rgba(74, 222, 128, 0.12); border: 1px solid rgba(74, 222, 128, 0.3); color: #86efac; }
  .tw-west-tag-caution { background: rgba(251, 146, 60, 0.12); border: 1px solid rgba(251, 146, 60, 0.3); color: #fdba74; }
  .tw-west-tag-danger  { background: rgba(239, 68, 68, 0.12);  border: 1px solid rgba(239, 68, 68, 0.35); color: #fca5a5; }

  /* ================================================================
     MISSING HERO NOTE
     ================================================================ */
  .tw-missing-note {
    background: rgba(250, 204, 21, 0.05);
    border: 1px solid rgba(250, 204, 21, 0.2);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    margin: 8px 0 20px;
    font-size: 0.86rem;
    line-height: 1.7;
    color: #d1d1db;
  }

  .tw-missing-note.tw-missing-warn {
    background: rgba(251, 146, 60, 0.05);
    border-color: rgba(251, 146, 60, 0.25);
  }

  .tw-missing-note.tw-missing-critical {
    background: rgba(239, 68, 68, 0.05);
    border-color: rgba(239, 68, 68, 0.25);
  }

  .missing-label {
    font-weight: 700;
    color: #fcd34d;
    margin-right: 6px;
  }

  .tw-missing-warn .missing-label { color: #fdba74; }
  .tw-missing-critical .missing-label { color: #fca5a5; }

  /* ================================================================
     CORE TEAM DISPLAY
     ================================================================ */
  .core-team-display {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 14px 0 8px;
  }

  .core-team-display-compromised .core-hero-card {
    opacity: 0.75;
  }

  .core-hero-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: inherit;
    width: 88px;
    flex-shrink: 0;
  }

  .core-hero-card-dim .core-hero-portrait {
    filter: saturate(0.6);
  }

  .core-hero-portrait {
    width: 88px;
    height: 88px;
    border-radius: var(--radius-md);
    background-size: cover;
    background-position: center top 20%;
    border: 2px solid rgba(255, 255, 255, 0.14);
    flex-shrink: 0;
  }

  .core-hero-card:hover .core-hero-portrait {
    border-color: rgba(168, 85, 247, 0.65);
    box-shadow: 0 0 14px rgba(168, 85, 247, 0.3);
    filter: none;
  }

  .core-hero-role {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(168, 85, 247, 0.9);
    background: rgba(168, 85, 247, 0.12);
    padding: 2px 7px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .hero-role-bugged {
    color: rgba(239, 68, 68, 0.9);
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .core-hero-name {
    font-size: 0.75rem;
    text-align: center;
    color: rgba(209, 209, 219, 0.85);
    font-weight: 600;
    line-height: 1.3;
    max-width: 88px;
  }

  .team-flex-note {
    font-size: 0.85rem;
    color: rgba(209, 209, 219, 0.6);
    margin: 6px 0 0;
    font-style: italic;
    line-height: 1.6;
  }

  /* ================================================================
     CLUBS STOPGAP
     ================================================================ */
  .clubs-stopgap-disclaimer {
    background: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.22);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 0.86rem;
    line-height: 1.7;
    color: #fca5a5;
    margin: 0 0 14px;
  }

  .tw-bug-inline {
    background: rgba(239, 68, 68, 0.06);
    border-left: 3px solid rgba(239, 68, 68, 0.5);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    margin-bottom: 20px;
    font-size: 0.88rem;
    line-height: 1.75;
    color: #d1d1db;
  }

  .tw-bug-link {
    color: #fca5a5;
    text-decoration: none;
    border-bottom: 1px solid rgba(239, 68, 68, 0.4);
    margin-left: 4px;
  }

  .tw-bug-link:hover { border-bottom-color: rgba(239, 68, 68, 0.8); }

  /* ================================================================
     SYNERGY GRID
     ================================================================ */
  .synergy-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 12px 0;
  }

  .synergy-block {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 14px 18px;
  }

  .synergy-block-warn {
    background: rgba(239, 68, 68, 0.04);
    border-color: rgba(239, 68, 68, 0.15);
  }

  .synergy-block-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fcd34d;
    margin-bottom: 8px;
  }

  .synergy-block-warn .synergy-block-title { color: #fca5a5; }

  .synergy-block p { margin: 0; font-size: 0.9rem; line-height: 1.75; color: #d1d1db; }

  /* ================================================================
     RELIC TABLE
     ================================================================ */
  .relic-table { display: flex; flex-direction: column; gap: 6px; margin: 12px 0; }

  .relic-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid;
    font-size: 0.87rem;
  }

  .relic-hero { font-weight: 600; color: var(--text-bright); min-width: 120px; flex-shrink: 0; }
  .relic-level { color: #d1d1db; flex: 1; }

  .relic-priority {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .relic-mandatory { background: rgba(239, 68, 68, 0.07); border-color: rgba(239, 68, 68, 0.25); }
  .relic-mandatory .relic-priority { background: rgba(239, 68, 68, 0.18); color: #fca5a5; }

  .relic-high { background: rgba(251, 146, 60, 0.06); border-color: rgba(251, 146, 60, 0.22); }
  .relic-high .relic-priority { background: rgba(251, 146, 60, 0.16); color: #fdba74; }

  .relic-low { background: rgba(255, 255, 255, 0.025); border-color: rgba(255, 255, 255, 0.1); }
  .relic-low .relic-priority { background: rgba(255, 255, 255, 0.08); color: rgba(209, 209, 219, 0.65); }

  .relic-flex { background: rgba(255, 255, 255, 0.015); border-color: rgba(255, 255, 255, 0.07); opacity: 0.8; }
  .relic-flex .relic-priority { background: rgba(255, 255, 255, 0.06); color: rgba(209, 209, 219, 0.5); }

  /* ================================================================
     REPLACEMENT LIST
     ================================================================ */
  .replacement-list { display: flex; flex-direction: column; gap: 10px; margin: 12px 0; }

  .replacement-entry {
    display: flex;
    gap: 14px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1px solid;
    align-items: flex-start;
  }

  .replacement-hero { font-weight: 700; color: var(--text-bright); font-size: 0.92rem; min-width: 110px; flex-shrink: 0; padding-top: 2px; }

  .replacement-sub { font-size: 0.87rem; color: #d1d1db; line-height: 1.7; display: flex; flex-direction: column; gap: 6px; }

  .replacement-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 9px;
    border-radius: var(--radius-full);
    align-self: flex-start;
  }

  .badge-none { background: rgba(239, 68, 68, 0.18); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.35); }
  .badge-weak { background: rgba(251, 146, 60, 0.15); color: #fdba74; border: 1px solid rgba(251, 146, 60, 0.3); }
  .badge-flex { background: rgba(74, 222, 128, 0.12); color: #86efac; border: 1px solid rgba(74, 222, 128, 0.3); }

  .replacement-none { background: rgba(239, 68, 68, 0.04); border-color: rgba(239, 68, 68, 0.2); }
  .replacement-weak { background: rgba(251, 146, 60, 0.04); border-color: rgba(251, 146, 60, 0.18); }
  .replacement-flex { background: rgba(74, 222, 128, 0.04); border-color: rgba(74, 222, 128, 0.16); }

  /* ================================================================
     FLOOR PROGRESSION
     ================================================================ */
  .floor-progression { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 12px 0; }

  .floor-prog-block { border-radius: var(--radius-md); padding: 14px 16px; border: 1px solid; }

  .floor-prog-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }

  .floor-prog-block p { font-size: 0.85rem; line-height: 1.65; color: #d1d1db; margin: 0; }

  .floor-prog-400 { background: rgba(74, 222, 128, 0.05); border-color: rgba(74, 222, 128, 0.2); }
  .floor-prog-400 .floor-prog-label { color: #86efac; }
  .floor-prog-450 { background: rgba(250, 204, 21, 0.06); border-color: rgba(250, 204, 21, 0.24); }
  .floor-prog-450 .floor-prog-label { color: #fcd34d; }
  .floor-prog-500 { background: rgba(239, 68, 68, 0.06); border-color: rgba(239, 68, 68, 0.22); }
  .floor-prog-500 .floor-prog-label { color: #fca5a5; }

  /* ================================================================
     VARIANT GRID
     ================================================================ */
  .variant-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 12px 0; }

  .variant-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-md);
    padding: 14px 16px;
  }

  .variant-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    display: inline-block;
  }

  .variant-early   { background: rgba(74, 222, 128, 0.12); color: #86efac; }
  .variant-mid     { background: rgba(250, 204, 21, 0.12); color: #fcd34d; }
  .variant-endgame { background: rgba(168, 85, 247, 0.15); color: #c4b5fd; }

  .variant-note { font-size: 0.82rem; color: rgba(209, 209, 219, 0.6); line-height: 1.6; margin: 8px 0 0; font-style: italic; }

  /* hero-pic grid - same as tips.astro / tower.astro */
  .hero-pic-grid { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0; align-items: flex-start; }

  .hero-pic { display: flex; flex-direction: column; align-items: center; gap: 4px; text-decoration: none; color: inherit; width: 56px; flex-shrink: 0; }

  .hero-pic-img { width: 56px; height: 56px; border-radius: 7px; background-size: cover; background-position: center top 25%; border: 1px solid rgba(255, 255, 255, 0.12); flex-shrink: 0; }

  .hero-pic:hover .hero-pic-img { border-color: rgba(168, 85, 247, 0.6); box-shadow: 0 0 10px rgba(168, 85, 247, 0.25); }
  .hero-pic.pic-highlight .hero-pic-img { border-color: rgba(168, 85, 247, 0.5); box-shadow: 0 0 6px rgba(168, 85, 247, 0.18); }

  .hero-pic-name { font-size: 0.62rem; text-align: center; color: rgba(209, 209, 219, 0.72); font-weight: 500; line-height: 1.3; max-width: 56px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* ================================================================
     WARNING BOXES
     ================================================================ */
  .tw-warning-box {
    background: rgba(220, 38, 38, 0.07);
    border-left: 3px solid rgba(220, 38, 38, 0.5);
    border-radius: var(--radius-sm);
    padding: 16px 20px;
    margin-top: 24px;
  }

  .tw-warning-hearts   { border-left-color: rgba(239, 68, 68, 0.6); }
  .tw-warning-diamonds { border-left-color: rgba(251, 146, 60, 0.55); background: rgba(251, 146, 60, 0.05); }
  .tw-warning-clubs-critical { border-left-color: rgba(239, 68, 68, 0.7); background: rgba(239, 68, 68, 0.07); }
  .tw-warning-invest { border-left-color: rgba(251, 146, 60, 0.5); background: rgba(251, 146, 60, 0.04); margin-top: 14px; }

  .tw-warning-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fca5a5;
    margin-bottom: 10px;
  }

  .tw-warning-diamonds .tw-warning-title { color: #fdba74; }
  .tw-warning-invest   .tw-warning-title { color: #fdba74; }

  .tw-warning-box ul { margin: 0; padding-left: 18px; }
  .tw-warning-box li { font-size: 0.88rem; line-height: 1.75; color: #d1d1db; margin-bottom: 6px; }

  /* ================================================================
     WESTERN VS CN GRID
     ================================================================ */
  .west-vs-cn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 18px;
  }

  .west-vs-cn-block {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-md);
    padding: 18px 20px;
  }

  .west-vs-cn-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fcd34d;
    margin-bottom: 14px;
  }

  .missing-hero-list { display: flex; flex-direction: column; gap: 8px; }

  .missing-hero-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.02);
    flex-wrap: wrap;
    font-size: 0.83rem;
