---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

function hp(id: string) { return `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/${id}.webp`; }
function fi(faction: string) { return `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/${faction}.webp`; }

const SPADES_CORE = [
  { id: "skadi",    name: "Skadi",    note: "Core" },
  { id: "poseidon", name: "Poseidon", note: "Core" },
  { id: "momus",    name: "Momus",    note: "Core" },
  { id: "khepri",   name: "Khepri",   note: "Core" },
  { id: "iris",     name: "Iris",     note: "Flex" },
];
const HEARTS_CORE = [
  { id: "hladgunnr", name: "Hladgunnr", note: "Carry" },
  { id: "mengpo",    name: "Mengpo",    note: "Core" },
  { id: "cashien",   name: "Caishen",   note: "Core" },
  { id: "yuelao",    name: "Yuelao",    note: "Core" },
  { id: "cancer",    name: "Cancer",    note: "Core" },
];
const DIAMONDS_CORE = [
  { id: "heracles", name: "Heracles", note: "Carry" },
  { id: "bastet",   name: "Bastet",   note: "Core" },
  { id: "phoenix",  name: "Phoenix",  note: "Core" },
  { id: "set",      name: "Set",      note: "Core" },
  { id: "athena",   name: "Athena",   note: "Core" },
];
const CLUBS_MAIN = [
  { id: "jormungandr", name: "Jormungandr", note: "Carry (Bugged)" },
  { id: "wenshen",     name: "Wenshen",     note: "Chain Dmg" },
  { id: "anubis",      name: "Anubis",      note: "Pick/Threat" },
  { id: "pan",         name: "Pan",         note: "Control" },
  { id: "nuba",        name: "Nuba",        note: "Frontline" },
];
const CLUBS_ALT = [
  { id: "jormungandr", name: "Jormungandr", note: "Carry (Bugged)" },
  { id: "wenshen",     name: "Wenshen",     note: "Chain Dmg" },
  { id: "anubis",      name: "Anubis",      note: "Pick/Threat" },
  { id: "pan",         name: "Pan",         note: "Control" },
  { id: "diana",       name: "Diana",       note: "Support" },
];
const CLUBS_FALLBACK = [
  { id: "jormungandr", name: "Jormungandr", note: "Carry (Bugged)" },
  { id: "pan",         name: "Pan",         note: "Control" },
  { id: "anubis",      name: "Anubis",      note: "Pick/Threat" },
  { id: "nuba",        name: "Nuba",        note: "Frontline" },
  { id: "diana",       name: "Diana",       note: "Support" },
];
---

<Base
  title="Western Tower Guide | Motto Immortal"
  description="Western client Faction Tower guide for Motto Immortal. Best available teams, missing heroes explained, Jormungandr bug warning, and floor breakpoints for 400+ and 500+."
>

  <PageHero
    tag="Tower - Western Client"
    headline="Western Tower Guide"
    subtitle="Current best teams for the Western client - missing heroes, known bugs, and honest investment advice"
    bgImage="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/towerBG.webp"
  />

  <div class="page-wrapper">
    <main class="tower-main">

      <!-- ================================================================
           WESTERN CLIENT NOTICE
           ================================================================ -->
      <div class="tw-west-notice">
        <div class="tw-west-notice-title">Western Client Edition</div>
        <p>
          This guide reflects the current state of the <strong>Western client</strong> specifically.
          Several top CN Tower heroes are not yet available here, and one major hero has a confirmed
          gameplay issue. If you copy teams directly from CN sources or the standard Tower guide,
          you will be building around heroes you cannot use or mechanics that do not work correctly.
        </p>
        <p style="margin-bottom:0">
          Use this page if you want guidance that reflects what Western players can actually build today.
        </p>
      </div>

      <!-- ================================================================
           SECTION 1: INTRO
           ================================================================ -->
      <div class="tw-card tw-intro-card">
        <h2>What Is the Faction Tower?</h2>
        <p>
          The Faction Tower is a vertical progression mode where you fight through floors using a
          locked faction team. Each faction has its own separate tower. Progress is decided by
          how well your roster is built for that specific faction - not just raw hero power.
        </p>

        <div class="floor-breakdown">
          <div class="floor-range floor-early">
            <div class="floor-label">Floor 1 - 399</div>
            <div class="floor-desc">
              Progression noise. Almost any functional team gets through this range. Do not over-invest
              around this bracket.
            </div>
          </div>
          <div class="floor-range floor-mid">
            <div class="floor-label">Floor 400 - 499</div>
            <div class="floor-desc">
              The real build check begins. Team quality, relic levels, and synergy start mattering.
              Missing core pieces becomes visible here.
            </div>
          </div>
          <div class="floor-range floor-hard">
            <div class="floor-label">Floor 500+</div>
            <div class="floor-desc">
              Endgame territory. Relic gates, roster depth, and synergy quality decide everything.
              In the Western client, missing heroes make this significantly harder than CN.
            </div>
          </div>
        </div>

        <div class="tw-callout">
          <strong>Tower is not primarily a skill mode.</strong> It is a relic check, a synergy check,
          an investment check, and a roster depth check. In the Western client, it is also a
          availability check - some of the best Tower heroes are simply not here yet.
        </div>
      </div>

      <!-- ================================================================
           SECTION 2: TOWER PHILOSOPHY
           ================================================================ -->
      <div class="tw-card">
        <h2>Tower Philosophy</h2>
        <p>
          Tower rewards specialized faction synergy above raw hero power. A T0 hero in the wrong
          shell underperforms a weaker hero in the correct shell. This is especially important
          in the Western client, where the correct shell for some factions is missing pieces.
        </p>

        <h3>Why the Western Meta Differs</h3>
        <ul>
          <li>Several heroes that anchor CN endgame Tower teams are not yet released in the West.</li>
          <li>One significant hero (Jormungandr) has a confirmed bug that materially reduces his value.</li>
          <li>Blindly following CN Tower recommendations will lead to investing in unavailable or underperforming pieces.</li>
          <li>Some factions are meaningfully weaker in the West, not just slightly weaker.</li>
        </ul>

        <div class="tw-keybox">
          <div class="tw-keybox-title">Key Takeaways</div>
          <ul>
            <li>Spades is currently the best Western Tower faction. Invest here first.</li>
            <li>Hearts is still excellent but remains heavily core-dependent.</li>
            <li>Diamonds is playable but incomplete without Meret and Serket.</li>
            <li>Clubs is currently the weakest Western Tower faction. It is still viable for pushing floors - build it, but keep shell investment at functional levels.</li>
            <li>Do not copy CN Tower teams directly. This guide exists for a reason.</li>
          </ul>
        </div>
      </div>

      <!-- ================================================================
           SECTION 3: JORMUNGANDR BUG WARNING
           ================================================================ -->
      <div class="tw-card tw-bug-card" id="jormungandr-bug">
        <div class="tw-bug-header">
          <span class="tw-bug-badge">Known Issue</span>
          <h2 style="margin:0; border:none; padding:0; color: #fca5a5;">Jormungandr - True Damage Bug</h2>
        </div>
        <p>
          Jormungandr currently has a confirmed problem in the Western client. His True Damage
          is not functioning correctly - it is either not being applied at all or not calculating
          as intended. True Damage is a core part of his damage output and the reason he anchors
          Clubs Tower teams in CN.
        </p>
        <p>
          <strong>This materially lowers his Tower value in the Western client.</strong> He still
          functions as a hero, but not at the level CN guides assume. Clubs Tower teams built around
          him will underperform expectations set by CN content.
        </p>
        <div class="tw-bug-impact">
          <div class="tw-bug-impact-title">Impact on This Guide</div>
          <ul>
            <li>The Clubs section of this guide reflects the current Western state honestly.</li>
            <li>Clubs can still be pushed and invested in - the ceiling is just lower than CN.</li>
            <li>Jormungandr is still the only viable Clubs carry despite the bug.</li>
            <li>This section will be updated when the bug is resolved or CN heroes arrive.</li>
          </ul>
        </div>
      </div>

      <!-- ================================================================
           SECTION 4: FACTION DIFFICULTY OVERVIEW (WESTERN)
           ================================================================ -->
      <div class="tw-card">
        <h2>Western Faction Difficulty Overview</h2>
        <p>
          This overview reflects the current Western client, not the CN meta. The faction rankings
          and assessments here will differ from CN-based resources.
        </p>

        <div class="faction-overview-grid">

          <div class="faction-tile faction-tile-spades">
            <div class="faction-tile-header">
              <img src={fi("spades")} alt="Spades" class="faction-tile-icon" />
              <span class="faction-tile-name">Spades</span>
              <span class="faction-tile-difficulty diff-stable">Best in West</span>
            </div>
            <ul class="faction-tile-stats">
              <li><span class="stat-label">Consistency</span><span class="stat-val">Very High</span></li>
              <li><span class="stat-label">CN Impact</span><span class="stat-val">Low - loses Nut only</span></li>
              <li><span class="stat-label">Availability</span><span class="stat-val">Core intact</span></li>
              <li><span class="stat-label">Recommended</span><span class="stat-val">Yes - priority investment</span></li>
            </ul>
            <p class="faction-tile-summary">
              The most stable Western Tower faction. Missing Nut lowers the ceiling slightly but
              does not break the team. Iris fills the flex slot well. This faction loses the least
              from the Western content gap.
            </p>
          </div>

          <div class="faction-tile faction-tile-hearts">
            <div class="faction-tile-header">
              <img src={fi("hearts")} alt="Hearts" class="faction-tile-icon" />
              <span class="faction-tile-name">Hearts</span>
              <span class="faction-tile-difficulty diff-strict">Strong, Core-Dependent</span>
            </div>
            <ul class="faction-tile-stats">
              <li><span class="stat-label">Consistency</span><span class="stat-val">High with core</span></li>
              <li><span class="stat-label">CN Impact</span><span class="stat-val">Low - Eden missing only</span></li>
              <li><span class="stat-label">Availability</span><span class="stat-val">Core intact</span></li>
              <li><span class="stat-label">Recommended</span><span class="stat-val">Yes - strong second pick</span></li>
            </ul>
            <p class="faction-tile-summary">
              Hearts core team is almost identical to CN. Eden is missing but does not break the
              faction. Mengpo and Caishen remain mandatory. This faction is still top-tier in the
              Western client.
            </p>
          </div>

          <div class="faction-tile faction-tile-diamonds">
            <div class="faction-tile-header">
              <img src={fi("diamonds")} alt="Diamonds" class="faction-tile-icon" />
              <span class="faction-tile-name">Diamonds</span>
              <span class="faction-tile-difficulty diff-volatile">Playable but Incomplete</span>
            </div>
            <ul class="faction-tile-stats">
              <li><span class="stat-label">Consistency</span><span class="stat-val">Variable</span></li>
              <li><span class="stat-label">CN Impact</span><span class="stat-val">Medium - Meret and Serket missing</span></li>
              <li><span class="stat-label">Availability</span><span class="stat-val">Core intact, shell weaker</span></li>
              <li><span class="stat-label">Recommended</span><span class="stat-val">With caution</span></li>
            </ul>
            <p class="faction-tile-summary">
              Heracles is available and still the core carry. But without Meret the team loses
              significant tempo and safety. Athena fills in but is a clear downgrade.
              More volatile than CN Diamonds.
            </p>
          </div>

          <div class="faction-tile faction-tile-clubs faction-tile-clubs-warn">
            <div class="faction-tile-header">
              <img src={fi("clubs")} alt="Clubs" class="faction-tile-icon" />
              <span class="faction-tile-name">Clubs</span>
              <span class="faction-tile-difficulty diff-compromised">Compromised</span>
            </div>
            <ul class="faction-tile-stats">
              <li><span class="stat-label">Consistency</span><span class="stat-val">Low to moderate</span></li>
              <li><span class="stat-label">CN Impact</span><span class="stat-val">High - Xuannv, Eris missing + Jorm bug</span></li>
              <li><span class="stat-label">Availability</span><span class="stat-val">Core hero bugged</span></li>
              <li><span class="stat-label">Recommended</span><span class="stat-val">Build for push, but 3rd priority</span></li>
            </ul>
            <p class="faction-tile-summary">
              Currently the weakest Western Tower faction. Jormungandr's True Damage bug plus
              the absence of Xuannv and Eris lowers the ceiling noticeably. Still viable for
              pushing Clubs floors - just not at the level CN teams achieve.
            </p>
          </div>

        </div>
      </div>

      <!-- ================================================================
           SECTION 5: SPADES
           ================================================================ -->
      <div class="tw-card faction-section faction-section-spades" id="spades">

        <div class="faction-section-header">
          <img src={fi("spades")} alt="Spades" class="faction-section-icon" />
          <div>
            <h2 class="faction-section-name">Spades</h2>
            <p class="faction-section-tagline">The most stable Western Tower faction</p>
          </div>
        </div>

        <div class="tw-west-tag tw-west-tag-good">Western Status: Recommended - priority investment</div>

        <h3 class="subsection-title">Best Western Team (500+)</h3>
        <div class="core-team-display">
          {SPADES_CORE.map(hero => (
            <a href={`/heroes/${hero.id}`} class="core-hero-card">
              <div class="core-hero-portrait" style={`background-image:url('${hp(hero.id)}')`}></div>
              <span class="core-hero-role">{hero.note}</span>
              <span class="core-hero-name">{hero.name}</span>
            </a>
          ))}
        </div>
        <div class="tw-missing-note">
          <span class="missing-label">Missing vs CN:</span>
          Nut is not yet available in the Western client. Iris fills the fifth slot as the best
          available substitute. The ceiling is slightly lower than CN but the team is still fully
          functional.
        </div>

        <h3 class="subsection-title">Why This Team Works</h3>
        <div class="synergy-grid">
          <div class="synergy-block">
            <div class="synergy-block-title">The Control Engine</div>
            <p>
              Skadi remains the structural backbone. Every CC applied to an enemy triggers her passive,
              generating bonus damage and energy. Poseidon opens with broad AoE control, Momus extends
              the disruption window, and Khepri applies frontline pressure. The loop fires with or
              without Nut.
            </p>
          </div>
          <div class="synergy-block">
            <div class="synergy-block-title">Iris as the Western Fifth</div>
            <p>
              Iris fills the Nut slot with support utility and additional sustain. She does not
              replicate Nut's scaling ceiling but she keeps the team functional at high floors.
              For pure Khepri-vs-Iris decisions, use Khepri when frontline setup matters more
              and Iris when sustained utility is the priority.
            </p>
          </div>
          <div class="synergy-block">
            <div class="synergy-block-title">Why Spades Survives the Content Gap</div>
            <p>
              Spades loses only Nut from its CN roster. The core engine - Skadi, Poseidon, Momus -
              is fully intact. This is why Spades is the best Western Tower investment: it loses
              less than every other faction from the current hero availability gap.
            </p>
          </div>
        </div>

        <h3 class="subsection-title">Relic Requirements</h3>
        <div class="relic-table">
          <div class="relic-row relic-mandatory">
            <span class="relic-hero">Skadi</span>
            <span class="relic-level">30+ mandatory for serious 500+, 40 preferred for endgame</span>
            <span class="relic-priority">Priority 1</span>
          </div>
          <div class="relic-row relic-high">
            <span class="relic-hero">Poseidon</span>
            <span class="relic-level">10-20 baseline</span>
            <span class="relic-priority">Priority 2</span>
          </div>
          <div class="relic-row relic-high">
            <span class="relic-hero">Momus</span>
            <span class="relic-level">10-20</span>
            <span class="relic-priority">Priority 2</span>
          </div>
          <div class="relic-row relic-low">
            <span class="relic-hero">Khepri</span>
            <span class="relic-level">1 early, 10-20 later</span>
            <span class="relic-priority">Priority 3</span>
          </div>
          <div class="relic-row relic-flex">
            <span class="relic-hero">Iris</span>
            <span class="relic-level">1+ functional, scales later</span>
            <span class="relic-priority">Flex slot</span>
          </div>
        </div>

        <h3 class="subsection-title">Replacements and Fallbacks</h3>
        <div class="replacement-list">
          <div class="replacement-entry replacement-none">
            <div class="replacement-hero">Skadi</div>
            <div class="replacement-sub">
              <span class="replacement-badge badge-none">No replacement</span>
              Skadi has no viable replacement. Without her the control loop does not exist and
              Spades Tower at 450+ is not viable regardless of what else you run.
            </div>
          </div>
          <div class="replacement-entry replacement-flex">
            <div class="replacement-hero">Khepri / Iris</div>
            <div class="replacement-sub">
              <span class="replacement-badge badge-flex">Interchangeable</span>
              These two flex based on the floor. Neither is strictly mandatory. In Western play
              Iris often sits in the fifth slot by default since Nut is unavailable.
            </div>
          </div>
          <div class="replacement-entry replacement-weak">
            <div class="replacement-hero">Poseidon</div>
            <div class="replacement-sub">
              <span class="replacement-badge badge-weak">Weaker substitute</span>
              Hecate can replace Poseidon only as a non-equivalent option. The AoE CC that feeds
              the Skadi loop is not replicated by Hecate. Use this only if Poseidon is completely
              unavailable.
            </div>
          </div>
        </div>

        <h3 class="subsection-title">Floor Progression</h3>
        <div class="floor-progression">
          <div class="floor-prog-block floor-prog-400">
            <div class="floor-prog-label">400+</div>
            <p>The Skadi loop starts making sense here. Western Spades is already competitive
               at this range. Relic investment on Skadi is the main variable separating runs.</p>
          </div>
          <div class="floor-prog-block floor-prog-450">
            <div class="floor-prog-label">450+</div>
            <p>Setup quality matters. Skadi relic 20-30 becomes the threshold for reliable
               clearing. The missing Nut slot becomes more noticeable here but is manageable
               with correct positioning.</p>
          </div>
          <div class="floor-prog-block floor-prog-500">
            <div class="floor-prog-label">500+</div>
            <p>Skadi relic 30 is the minimum expectation. The team remains among the most stable
               at this range even without Nut. Proper formation and setup discipline is critical.</p>
          </div>
        </div>

        <div class="variant-grid">
          <div class="variant-card">
            <div class="variant-label variant-early">Early / Low Invest</div>
            <div class="hero-pic-grid">
              <a href="/heroes/skadi" class="hero-pic pic-highlight">
                <div class="hero-pic-img" style={`background-image:url('${hp("skadi")}')`}></div>
                <span class="hero-pic-name">Skadi</span>
              </a>
              <a href="/heroes/poseidon" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("poseidon")}')`}></div>
                <span class="hero-pic-name">Poseidon</span>
              </a>
              <a href="/heroes/momus" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("momus")}')`}></div>
                <span class="hero-pic-name">Momus</span>
              </a>
              <a href="/heroes/khepri" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("khepri")}')`}></div>
                <span class="hero-pic-name">Khepri</span>
              </a>
              <a href="/heroes/hecate" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("hecate")}')`}></div>
                <span class="hero-pic-name">Hecate</span>
              </a>
            </div>
            <p class="variant-note">Hecate fills the fifth slot early. Functional through 420-440.</p>
          </div>
          <div class="variant-card">
            <div class="variant-label variant-mid">Midgame</div>
            <div class="hero-pic-grid">
              <a href="/heroes/skadi" class="hero-pic pic-highlight">
                <div class="hero-pic-img" style={`background-image:url('${hp("skadi")}')`}></div>
                <span class="hero-pic-name">Skadi</span>
              </a>
              <a href="/heroes/poseidon" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("poseidon")}')`}></div>
                <span class="hero-pic-name">Poseidon</span>
              </a>
              <a href="/heroes/momus" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("momus")}')`}></div>
                <span class="hero-pic-name">Momus</span>
              </a>
              <a href="/heroes/khepri" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("khepri")}')`}></div>
                <span class="hero-pic-name">Khepri</span>
              </a>
              <a href="/heroes/iris" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("iris")}')`}></div>
                <span class="hero-pic-name">Iris</span>
              </a>
            </div>
            <p class="variant-note">Iris enters the fifth slot for stronger support. Solid through 460-470.</p>
          </div>
          <div class="variant-card">
            <div class="variant-label variant-endgame">Endgame 500+</div>
            <div class="hero-pic-grid">
              <a href="/heroes/skadi" class="hero-pic pic-highlight">
                <div class="hero-pic-img" style={`background-image:url('${hp("skadi")}')`}></div>
                <span class="hero-pic-name">Skadi</span>
              </a>
              <a href="/heroes/poseidon" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("poseidon")}')`}></div>
                <span class="hero-pic-name">Poseidon</span>
              </a>
              <a href="/heroes/momus" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("momus")}')`}></div>
                <span class="hero-pic-name">Momus</span>
              </a>
              <a href="/heroes/khepri" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("khepri")}')`}></div>
                <span class="hero-pic-name">Khepri</span>
              </a>
              <a href="/heroes/iris" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("iris")}')`}></div>
                <span class="hero-pic-name">Iris</span>
              </a>
            </div>
            <p class="variant-note">Western endgame shell. Skadi relic 30+ mandatory, 40 preferred. Iris holds the Nut slot until she releases.</p>
          </div>
        </div>

        <div class="tw-warning-box">
          <div class="tw-warning-title">Warnings</div>
          <ul>
            <li><strong>Skadi has no replacement.</strong> This is true in both CN and the Western client. Without her, Spades is not viable past floor 450.</li>
            <li><strong>Western Spades is strong precisely because it loses so little.</strong> Do not underestimate this faction just because it lacks Nut.</li>
            <li><strong>Wrong positioning still breaks this team.</strong> The CC loop must fire. Misconfigured formations look like hero failure but are setup failure.</li>
          </ul>
        </div>

      </div>

      <!-- ================================================================
           SECTION 6: HEARTS
           ================================================================ -->
      <div class="tw-card faction-section faction-section-hearts" id="hearts">

        <div class="faction-section-header">
          <img src={fi("hearts")} alt="Hearts" class="faction-section-icon" />
          <div>
            <h2 class="faction-section-name">Hearts</h2>
            <p class="faction-section-tagline">Strong and nearly complete in the Western client</p>
          </div>
        </div>

        <div class="tw-west-tag tw-west-tag-good">Western Status: Recommended - strong second faction</div>

        <h3 class="subsection-title">Best Western Team (500+)</h3>
        <div class="core-team-display">
          {HEARTS_CORE.map(hero => (
            <a href={`/heroes/${hero.id}`} class="core-hero-card">
