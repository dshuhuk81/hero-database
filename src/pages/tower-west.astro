---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

function hp(id: string) { return `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/${id}.webp`; }
function fi(faction: string) { return `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/${faction}.webp`; }

const SPADES_CORE = [
  { id: "skadi",    name: "Skadi",    note: "Core" },
  { id: "poseidon", name: "Poseidon", note: "Core" },
  { id: "momus",    name: "Momus",    note: "Core" },
  { id: "khepri",   name: "Khepri",   note: "Core" },
  { id: "iris",     name: "Iris",     note: "Flex" },
];
const HEARTS_CORE = [
  { id: "hladgunnr", name: "Hladgunnr", note: "Carry" },
  { id: "mengpo",    name: "Mengpo",    note: "Core" },
  { id: "caishen",   name: "Caishen",   note: "Core" },
  { id: "yuelao",    name: "Yuelao",    note: "Core" },
  { id: "cancer",    name: "Cancer",    note: "Core" },
];
const DIAMONDS_CORE = [
  { id: "heracles", name: "Heracles", note: "Carry" },
  { id: "bastet",   name: "Bastet",   note: "Core" },
  { id: "phoenix",  name: "Phoenix",  note: "Core" },
  { id: "set",      name: "Set",      note: "Core" },
  { id: "athena",   name: "Athena",   note: "Core" },
];
const CLUBS_MAIN = [
  { id: "jormungandr", name: "Jormungandr", note: "Carry" },
  { id: "wenshen",     name: "Wenshen",     note: "Chain Dmg" },
  { id: "anubis",      name: "Anubis",      note: "Pick/Threat" },
  { id: "pan",         name: "Pan",         note: "Control" },
  { id: "nuba",        name: "Nuba",        note: "Frontline" },
];
const CLUBS_ALT = [
  { id: "jormungandr", name: "Jormungandr", note: "Carry" },
  { id: "wenshen",     name: "Wenshen",     note: "Chain Dmg" },
  { id: "anubis",      name: "Anubis",      note: "Pick/Threat" },
  { id: "pan",         name: "Pan",         note: "Control" },
  { id: "diana",       name: "Diana",       note: "Support" },
];
const CLUBS_FALLBACK = [
  { id: "jormungandr", name: "Jormungandr", note: "Carry" },
  { id: "pan",         name: "Pan",         note: "Control" },
  { id: "anubis",      name: "Anubis",      note: "Pick/Threat" },
  { id: "nuba",        name: "Nuba",        note: "Frontline" },
  { id: "diana",       name: "Diana",       note: "Support" },
];
---

<Base
  title="Celestial Spire Guide | Motto Immortal"
  description="Celestial Spire guide for Motto Immortal. Best faction teams, Level Suppression explained, and floor breakpoints for 400+ and 500+."
>

  <PageHero
    tag="Celestial Spire"
    headline="Celestial Spire Guide"
    subtitle="Best faction teams, Level Suppression explained, and investment advice for 400+ and 500+"
    bgImage="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/towerBG.webp"
  />

  <div class="page-wrapper">
    <main class="tower-main">

      <!-- ================================================================
           SECTION 1: INTRO
           ================================================================ -->
      <div class="tw-card tw-intro-card">
        <h2>What Is the Celestial Spire?</h2>
        <p>
          The Celestial Spire is a vertical progression mode where you fight through floors using a
          locked faction team. Each faction has its own separate Spire. Progress is decided by
          how well your roster is built for that specific faction - not just raw hero power.
        </p>

        <div class="floor-breakdown">
          <div class="floor-range floor-early">
            <div class="floor-label">Floor 1 - 399</div>
            <div class="floor-desc">
              Progression noise. Almost any functional team gets through this range. Do not over-invest
              around this bracket.
            </div>
          </div>
          <div class="floor-range floor-mid">
            <div class="floor-label">Floor 400 - 499</div>
            <div class="floor-desc">
              The real build check begins. Team quality, relic levels, and synergy start mattering.
              Missing core pieces becomes visible here.
            </div>
          </div>
          <div class="floor-range floor-hard">
            <div class="floor-label">Floor 500+</div>
            <div class="floor-desc">
              Endgame territory. Relic gates, roster depth, and synergy quality decide everything.
              Some factions are significantly harder to push here than others.
            </div>
          </div>
        </div>

        <div class="tw-callout">
          <strong>Celestial Spire is not primarily a skill mode.</strong> It is a relic check, a synergy check,
          an investment check, and a roster depth check.
        </div>
      </div>

      <!-- ================================================================
           SECTION 2: TOWER PHILOSOPHY
           ================================================================ -->
      <div class="tw-card">
        <h2>Celestial Spire Philosophy</h2>
        <p>
          Celestial Spire rewards specialized faction synergy above raw hero power. A T0 hero in the wrong
          squad underperforms a weaker hero in the correct squad.
        </p>
        <ul>
          <li>Level Suppression is a one-sided damage penalty that affects all deities, including True Damage. Understanding this mechanic is essential for high floors.</li>
          <li>Several deities are not yet available - some factions are missing key pieces and play differently as a result.</li>
          <li>Some factions are meaningfully harder to push than others at the same investment level.</li>
        </ul>

        <div class="tw-keybox">
          <div class="tw-keybox-title">Key Takeaways</div>
          <ul>
            <li>Spades is currently the strongest Celestial Spire faction. Invest here first.</li>
            <li>Hearts is excellent but heavily core-dependent.</li>
            <li>Diamonds is the most volatile faction. Higher variance, burst-dependent.</li>
            <li>Clubs is the weakest faction currently. Viable for pushing floors but keep squad investment at functional levels.</li>
          </ul>
        </div>
      </div>

      <!-- ================================================================
           SECTION 3: LEVEL SUPPRESSION
           ================================================================ -->
      <div class="tw-card tw-mechanic-card" id="level-suppression">
        <div class="tw-bug-header">
          <span class="tw-mechanic-badge">Game Mechanic</span>
          <h2 style="margin:0; border:none; padding:0;">Level Suppression - What It Is and Why It Matters</h2>
        </div>
        <p>
          Level Suppression is a damage reduction system that applies exclusively in the
          Celestial Spire (and Odyssey). It is not present in PvP or other modes.
        </p>
        <p>
          <strong>How it works:</strong> If your deity's level is lower than the enemy's level,
          your damage is reduced. The system is one-sided - there is no bonus for being higher
          level, only a penalty for being lower. The penalty works as follows:
        </p>
        <ul>
          <li><strong>15 levels or less behind:</strong> No reduction. Damage is unaffected.</li>
          <li><strong>More than 15 levels behind:</strong> Damage begins decreasing.</li>
          <li><strong>Large gap:</strong> Reduction can reach up to 90% at extreme differences.</li>
        </ul>
        <p>
          <strong>True Damage is also affected.</strong> True Damage bypasses armor - but it does
          not bypass Level Suppression. If your level is far below the floor's enemies, even True Damage can be reduced significantly.
        </p>
        <div class="tw-bug-impact">
          <div class="tw-bug-impact-title">What This Means for Your Progression</div>
          <ul>
            <li>Relic investment only matters after you are within 15 levels of the floor's enemies. If the level gap is too large, even relic 50 deities deal nearly nothing.</li>
            <li>Level up before pushing. When runs suddenly start failing for no clear reason, check the level gap first.</li>
            <li>Sustained-damage carries like Hladgunnr are hit harder than burst carries. Every skill rotation is suppressed, compounding the loss over a long fight.</li>
            <li>Burst carries like Jormungandr and Heracles also suffer - but a burst failure at least ends the fight quickly rather than dragging out a losing attrition match.</li>
          </ul>
        </div>
        <div class="tw-bug-impact" style="margin-top:12px">
          <div class="tw-bug-impact-title">Jormungandr and True Damage</div>
          <p style="margin:0">
            True Damage bypasses armor but is still subject to Level Suppression like all other
            damage. If your level is far below the floor's enemies, his True Damage is reduced
            significantly. Closing the level gap restores his output.
          </p>
        </div>
      </div>

      <!-- ================================================================
           SECTION 4: FACTION DIFFICULTY OVERVIEW
           ================================================================ -->
      <div class="tw-card">
        <h2>Faction Overview</h2>

        <div class="faction-overview-grid">

          <div class="faction-tile faction-tile-spades">
            <div class="faction-tile-header">
              <img src={fi("spades")} alt="Spades" class="faction-tile-icon" />
              <span class="faction-tile-name">Spades</span>
              <span class="faction-tile-difficulty diff-stable">Top Faction</span>
            </div>
            <ul class="faction-tile-stats">
              <li><span class="stat-label">Consistency</span><span class="stat-val">Very High</span></li>
              <li><span class="stat-label">Availability</span><span class="stat-val">Core intact</span></li>
              <li><span class="stat-label">Recommended</span><span class="stat-val">Yes - priority investment</span></li>
            </ul>
            <p class="faction-tile-summary">
              The most stable Celestial Spire faction. Strong control engine built around Skadi.
              Consistent, forgiving, and reliable across all floor ranges.
            </p>
          </div>

          <div class="faction-tile faction-tile-hearts">
            <div class="faction-tile-header">
              <img src={fi("hearts")} alt="Hearts" class="faction-tile-icon" />
              <span class="faction-tile-name">Hearts</span>
              <span class="faction-tile-difficulty diff-strict">Strong, Core-Dependent</span>
            </div>
            <ul class="faction-tile-stats">
              <li><span class="stat-label">Consistency</span><span class="stat-val">High with core</span></li>
              <li><span class="stat-label">Availability</span><span class="stat-val">Core intact</span></li>
              <li><span class="stat-label">Recommended</span><span class="stat-val">Yes - strong second pick</span></li>
            </ul>
            <p class="faction-tile-summary">
              Top-tier sustain faction. Mengpo and Caishen are mandatory. Strong triple-sustain
              architecture that outlasts opponents at high floors.
            </p>
          </div>

          <div class="faction-tile faction-tile-diamonds">
            <div class="faction-tile-header">
              <img src={fi("diamonds")} alt="Diamonds" class="faction-tile-icon" />
              <span class="faction-tile-name">Diamonds</span>
              <span class="faction-tile-difficulty diff-volatile">Playable but Incomplete</span>
            </div>
            <ul class="faction-tile-stats">
              <li><span class="stat-label">Consistency</span><span class="stat-val">Variable</span></li>
              <li><span class="stat-label">Availability</span><span class="stat-val">Core intact</span></li>
              <li><span class="stat-label">Recommended</span><span class="stat-val">With caution</span></li>
            </ul>
            <p class="faction-tile-summary">
              Heracles-anchored burst faction. Higher variance than other factions. Runs succeed
              or fail based heavily on burst execution. Investment in Heracles directly reduces variance.
            </p>
          </div>

          <div class="faction-tile faction-tile-clubs faction-tile-clubs-warn">
            <div class="faction-tile-header">
              <img src={fi("clubs")} alt="Clubs" class="faction-tile-icon" />
              <span class="faction-tile-name">Clubs</span>
              <span class="faction-tile-difficulty diff-compromised">Incomplete</span>
            </div>
            <ul class="faction-tile-stats">
              <li><span class="stat-label">Consistency</span><span class="stat-val">Low to moderate</span></li>
              <li><span class="stat-label">Availability</span><span class="stat-val">Core intact</span></li>
              <li><span class="stat-label">Recommended</span><span class="stat-val">Build for push, 3rd priority</span></li>
            </ul>
            <p class="faction-tile-summary">
              Currently the weakest Celestial Spire faction. Jormungandr anchors the team but
              Level Suppression hits hard at high floors. Still viable for pushing - set realistic
              expectations on the ceiling.
            </p>
          </div>

        </div>
      </div>

      <!-- ================================================================
           SECTION 5: SPADES
           ================================================================ -->
      <div class="tw-card faction-section faction-section-spades" id="spades">

        <div class="faction-section-header">
          <img src={fi("spades")} alt="Spades" class="faction-section-icon" />
          <div>
            <h2 class="faction-section-name">Spades</h2>
            <p class="faction-section-tagline">The most stable Celestial Spire faction</p>
          </div>
        </div>

        <h3 class="subsection-title">Best Team (500+)</h3>
        <div class="core-team-display">
          {SPADES_CORE.map(hero => (
            <a href={`/heroes/${hero.id}`} class="core-hero-card">
              <div class="core-hero-portrait" style={`background-image:url('${hp(hero.id)}')`}></div>
              <span class="core-hero-role">{hero.note}</span>
              <span class="core-hero-name">{hero.name}</span>
            </a>
          ))}
        </div>
        <h3 class="subsection-title">Why This Team Works</h3>
        <div class="synergy-grid">
          <div class="synergy-block">
            <div class="synergy-block-title">The Control Engine</div>
            <p>
              Skadi is the structural backbone. Every CC applied to an enemy triggers her passive,
              generating bonus damage and energy. Poseidon opens with broad AoE control, Momus extends
              the disruption window, and Khepri applies frontline pressure.
            </p>
          </div>
          <div class="synergy-block">
            <div class="synergy-block-title">Iris in the Fifth Slot</div>
            <p>
              Iris provides support utility and additional sustain. She keeps the team functional
              at high floors. For Khepri-vs-Iris decisions, use Khepri when frontline setup matters
              more and Iris when sustained utility is the priority.
            </p>
          </div>
          <div class="synergy-block">
            <div class="synergy-block-title">Why Spades Is the Top Investment</div>
            <p>
              The core engine - Skadi, Poseidon, Momus - is fully intact and highly consistent.
              This faction has the strongest and most forgiving identity in the current Celestial Spire.
            </p>
          </div>
        </div>

        <h3 class="subsection-title">Relic Requirements</h3>
        <div class="relic-table">
          <div class="relic-row relic-mandatory">
            <span class="relic-hero">Skadi</span>
            <span class="relic-level">30+ mandatory for serious 500+, 40 preferred for endgame</span>
            <span class="relic-priority">Priority 1</span>
          </div>
          <div class="relic-row relic-high">
            <span class="relic-hero">Poseidon</span>
            <span class="relic-level">10-20 baseline</span>
            <span class="relic-priority">Priority 2</span>
          </div>
          <div class="relic-row relic-high">
            <span class="relic-hero">Momus</span>
            <span class="relic-level">10-20</span>
            <span class="relic-priority">Priority 2</span>
          </div>
          <div class="relic-row relic-low">
            <span class="relic-hero">Khepri</span>
            <span class="relic-level">1 early, 10-20 later</span>
            <span class="relic-priority">Priority 3</span>
          </div>
          <div class="relic-row relic-flex">
            <span class="relic-hero">Iris</span>
            <span class="relic-level">1+ functional, scales later</span>
            <span class="relic-priority">Flex slot</span>
          </div>
        </div>

        <h3 class="subsection-title">Replacements and Fallbacks</h3>
        <div class="replacement-list">
          <div class="replacement-entry replacement-none">
            <div class="replacement-hero">Skadi</div>
            <div class="replacement-sub">
              <span class="replacement-badge badge-none">No replacement</span>
              Skadi has no viable replacement. Without her the control loop does not exist and
              Spades Celestial Spire at 450+ is not viable regardless of what else you run.
            </div>
          </div>
          <div class="replacement-entry replacement-flex">
            <div class="replacement-hero">Khepri / Iris</div>
            <div class="replacement-sub">
              <span class="replacement-badge badge-flex">Interchangeable</span>
              These two flex based on the floor. Neither is strictly mandatory. Use Khepri
              when frontline pressure matters more and Iris for sustained utility.
            </div>
          </div>
          <div class="replacement-entry replacement-weak">
            <div class="replacement-hero">Poseidon</div>
            <div class="replacement-sub">
              <span class="replacement-badge badge-weak">Weaker substitute</span>
              Hecate can replace Poseidon only as a non-equivalent option. The AoE CC that feeds
              the Skadi loop is not replicated by Hecate. Use this only if Poseidon is completely
              unavailable.
            </div>
          </div>
        </div>

        <h3 class="subsection-title">Floor Progression</h3>
        <div class="floor-progression">
          <div class="floor-prog-block floor-prog-400">
            <div class="floor-prog-label">400+</div>
            <p>The Skadi loop starts making sense here. Relic investment on Skadi is the main variable separating runs.</p>
          </div>
          <div class="floor-prog-block floor-prog-450">
            <div class="floor-prog-label">450+</div>
            <p>Setup quality matters. Skadi relic 20-30 becomes the threshold for reliable
               clearing. Correct positioning becomes increasingly important.</p>
          </div>
          <div class="floor-prog-block floor-prog-500">
            <div class="floor-prog-label">500+</div>
            <p>Skadi relic 30 is the minimum expectation. The team is among the most stable
               at this range. Correct positioning and squad discipline is critical.</p>
          </div>
        </div>

        <div class="variant-grid">
          <div class="variant-card">
            <div class="variant-label variant-early">Early / Low Invest</div>
            <div class="hero-pic-grid">
              <a href="/heroes/skadi" class="hero-pic pic-highlight">
                <div class="hero-pic-img" style={`background-image:url('${hp("skadi")}')`}></div>
                <span class="hero-pic-name">Skadi</span>
              </a>
              <a href="/heroes/poseidon" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("poseidon")}')`}></div>
                <span class="hero-pic-name">Poseidon</span>
              </a>
              <a href="/heroes/momus" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("momus")}')`}></div>
                <span class="hero-pic-name">Momus</span>
              </a>
              <a href="/heroes/khepri" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("khepri")}')`}></div>
                <span class="hero-pic-name">Khepri</span>
              </a>
              <a href="/heroes/hecate" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("hecate")}')`}></div>
                <span class="hero-pic-name">Hecate</span>
              </a>
            </div>
            <p class="variant-note">Hecate fills the fifth slot early. Functional through 420-440.</p>
          </div>
          <div class="variant-card">
            <div class="variant-label variant-mid">Midgame</div>
            <div class="hero-pic-grid">
              <a href="/heroes/skadi" class="hero-pic pic-highlight">
                <div class="hero-pic-img" style={`background-image:url('${hp("skadi")}')`}></div>
                <span class="hero-pic-name">Skadi</span>
              </a>
              <a href="/heroes/poseidon" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("poseidon")}')`}></div>
                <span class="hero-pic-name">Poseidon</span>
              </a>
              <a href="/heroes/momus" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("momus")}')`}></div>
                <span class="hero-pic-name">Momus</span>
              </a>
              <a href="/heroes/khepri" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("khepri")}')`}></div>
                <span class="hero-pic-name">Khepri</span>
              </a>
              <a href="/heroes/iris" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("iris")}')`}></div>
                <span class="hero-pic-name">Iris</span>
              </a>
            </div>
            <p class="variant-note">Iris enters the fifth slot for stronger support. Solid through 460-470.</p>
          </div>
          <div class="variant-card">
            <div class="variant-label variant-endgame">Endgame 500+</div>
            <div class="hero-pic-grid">
              <a href="/heroes/skadi" class="hero-pic pic-highlight">
                <div class="hero-pic-img" style={`background-image:url('${hp("skadi")}')`}></div>
                <span class="hero-pic-name">Skadi</span>
              </a>
              <a href="/heroes/poseidon" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("poseidon")}')`}></div>
                <span class="hero-pic-name">Poseidon</span>
              </a>
              <a href="/heroes/momus" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("momus")}')`}></div>
                <span class="hero-pic-name">Momus</span>
              </a>
              <a href="/heroes/khepri" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("khepri")}')`}></div>
                <span class="hero-pic-name">Khepri</span>
              </a>
              <a href="/heroes/iris" class="hero-pic">
                <div class="hero-pic-img" style={`background-image:url('${hp("iris")}')`}></div>
                <span class="hero-pic-name">Iris</span>
              </a>
            </div>
            <p class="variant-note">Endgame squad. Skadi relic 30+ mandatory, 40 preferred.</p>
          </div>
        </div>

        <div class="tw-warning-box">
          <div class="tw-warning-title">Warnings</div>
          <ul>
            <li><strong>Skadi has no replacement.</strong> Without her, Spades is not viable past floor 450 in the Celestial Spire.</li>
            <li><strong>Do not underestimate Spades.</strong> The core engine is strong and the faction is the most forgiving to play.</li>
            <li><strong>Wrong positioning still breaks this team.</strong> The CC loop must fire. Wrong squad setup looks like hero failure but is setup failure.</li>
          </ul>
        </div>

      </div>

      <!-- ================================================================
           SECTION 6: HEARTS
           ================================================================ -->
      <div class="tw-card faction-section faction-section-hearts" id="hearts">

        <div class="faction-section-header">
          <img src={fi("hearts")} alt="Hearts" class="faction-section-icon" />
          <div>
            <h2 class="faction-section-name">Hearts</h2>
            <p class="faction-section-tagline">Strong, sustain-focused faction</p>
          </div>
        </div>

        <h3 class="subsection-title">Best Team (500+)</h3>
        <div class="core-team-display">
          {HEARTS_CORE.map(hero => (
            <a href={`/heroes/${hero.id}`} class="core-hero-card">
              <div class="core-hero-portrait" style={`background-image:url('${hp(hero.id)}')`}></div>
              <span class="core-hero-role">{hero.note}</span>
              <span class="core-hero-name">{hero.name}</span>
            </a>
          ))}
        </div>
        <h3 class="subsection-title">Why This Team Works</h3>
        <div class="synergy-grid">
          <div class="synergy-block">
            <div class="synergy-block-title">The Revive Loop</div>
            <p>
              Mengpo is the structural core. Her revive mechanism gives the team a second life on
              critical heroes, changing how attrition fights play out at 500+. This mechanic is
              fully intact - Mengpo is available and her kit works correctly.
            </p>
          </div>
          <div class="synergy-block">
            <div class="synergy-block-title">Layered Survival</div>
            <p>
              Caishen adds energy acceleration and a second sustain layer on top of Mengpo. Yuelao
              contributes healing and damage amplification. Cancer provides major protective utility.
              This triple-sustain architecture is what makes the team viable at high floors and it
              is fully available.
            </p>
          </div>
          <div class="synergy-block">
            <div class="synergy-block-title">Hladgunnr as Carry</div>
            <p>
              Hladgunnr delivers frontline pressure while the support structure keeps her alive.
              The team wins by outlasting and outscaling - not by bursting. This identity is
              This identity remains one of the most effective Celestial Spire strategies available.
            </p>
            <p>
              Note: Hladgunnr's sustained damage model is particularly sensitive to Level
