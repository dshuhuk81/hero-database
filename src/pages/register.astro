---
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Hero Database</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            font-family: "Spectral", "Roboto", system-ui, sans-serif;
            background:
                radial-gradient(ellipse at 30% -10%, rgba(120,90,200,0.15), transparent 60%),
                radial-gradient(ellipse at 80% 20%, rgba(255,215,100,0.08), transparent 55%),
                linear-gradient(to bottom, #0d0b10, #07060c);
            color: #e6e6eb;
            min-height: 100vh;
        }

        .page-wrapper {
            margin-left: 64px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 32px 16px;
        }

        .container {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        }

        .brand-title {
            text-align: center;
            color: #facc15;
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
            opacity: 0.8;
        }

        h1 {
            text-align: center;
            color: #e6e6eb;
            margin-bottom: 28px;
            font-size: 2rem;
            font-weight: 600;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: rgba(230, 230, 235, 0.7);
            font-weight: 600;
            font-size: 0.9rem;
        }

        input {
            width: 100%;
            padding: 12px 14px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            font-size: 1rem;
            color: #e6e6eb;
            font-family: inherit;
            transition: border-color 0.25s, box-shadow 0.25s;
            box-sizing: border-box;
        }

        input:focus {
            outline: none;
            border-color: rgba(250, 204, 21, 0.5);
            box-shadow: 0 0 8px rgba(250, 204, 21, 0.15);
        }

        input::placeholder {
            color: rgba(230, 230, 235, 0.3);
        }

        button {
            width: 100%;
            padding: 12px;
            background: rgba(250, 204, 21, 0.15);
            border: 1px solid rgba(250, 204, 21, 0.4);
            color: #facc15;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            transition: background 0.25s, transform 0.2s, box-shadow 0.25s;
        }

        button:hover {
            background: rgba(250, 204, 21, 0.25);
            box-shadow: 0 4px 16px rgba(250, 204, 21, 0.15);
            transform: translateY(-1px);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .message {
            margin-top: 20px;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            font-size: 0.9rem;
            display: none;
        }

        .message.success {
            background: rgba(74, 222, 128, 0.1);
            border: 1px solid rgba(74, 222, 128, 0.3);
            color: rgba(74, 222, 128, 0.95);
            display: block;
        }

        .message.error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: rgba(239, 68, 68, 0.95);
            display: block;
        }

        .link {
            text-align: center;
            margin-top: 20px;
            color: rgba(230, 230, 235, 0.5);
            font-size: 0.9rem;
        }

        .link a {
            color: #facc15;
            text-decoration: none;
            font-weight: 600;
            border-bottom: 1px dashed rgba(250, 204, 21, 0.4);
            transition: opacity 0.2s;
        }

        .link a:hover {
            opacity: 0.8;
        }

        @media (max-width: 768px) {
            .page-wrapper {
                margin-left: 0;
                margin-bottom: 56px;
            }
            .container {
                padding: 28px 20px;
            }
        }
    </style>
</head>
<body>
    <Sidebar />
    <div class="page-wrapper">
        <div class="container">
            <div class="brand-title">Motto Immortal DB</div>
            <h1>Register</h1>
            
            <form id="registerForm">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" required>
                </div>
                
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Choose a password" required>
                </div>
                
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat your password" required>
                </div>
                
                <button type="submit" id="submitBtn">Create Account</button>
            </form>

            <div id="message" class="message"></div>

            <div class="link">
                Already have an account? <a href="/login">Sign in</a>
            </div>
        </div>
    </div>

    <Footer />

    <script>
        const form = document.getElementById('registerForm');
        const messageEl = document.getElementById('message');
        const submitBtn = document.getElementById('submitBtn');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            submitBtn.disabled = true;
            messageEl.className = 'message';
            messageEl.textContent = '';

            try {
                const response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email, password, confirmPassword }),
                });

                const data = await response.json();

                if (response.ok) {
                    messageEl.className = 'message success';
                    messageEl.textContent = 'Registration successful! Redirecting to login...';
                    
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 2000);
                } else {
                    messageEl.className = 'message error';
                    messageEl.textContent = data.error || 'Registration failed';
                }
            } catch (error) {
                messageEl.className = 'message error';
                messageEl.textContent = 'Connection error: ' + error.message;
            } finally {
                submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
