---
export const prerender = true;
import HeroEvolutionPage from "../../components/pages/HeroEvolutionPage.astro";
import { locales, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return locales.filter((locale) => locale !== "en").map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props { locale: Locale; }
const { locale } = Astro.props as Props;
---

<HeroEvolutionPage locale={locale} />
