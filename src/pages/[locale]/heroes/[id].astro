---
export const prerender = true;

import HeroPage from "../../heroes/[id].astro";
import { heroes } from "../../../data/heroes/withRatings";
import { defaultLocale, locales, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((locale) =>
      heroes
        .filter((hero) => import.meta.env.DEV || (hero as any).release !== false)
        .map((hero) => ({
          params: { locale, id: hero.id },
          props: { locale },
        }))
    );
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const { id } = Astro.params;
---

<HeroPage id={id} locale={locale} />
