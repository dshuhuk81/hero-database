---
export const prerender = true;
import WishlistPage from "../../components/WishlistPage.astro";
import { defaultLocale, locales, type Locale } from "../../i18n/config";
export function getStaticPaths() { return locales.filter((locale) => locale !== defaultLocale).map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
---
<WishlistPage locale={locale} />
