        </div>
      </div>
      <div class="picker-grid" id="picker-grid"></div>
    </div>
  </div>

  <script define:vars={{ heroesData: heroes }}>
    // ── Constants ──────────────────────────────────────────────
    const CLASS_WEIGHTS = {
      Tank:     { hp: 1.2, atk: 0.9,  def: 1.2  },
      Warrior:  { hp: 1.1, atk: 1.2,  def: 1.0  },
      Mage:     { hp: 0.85,atk: 1.2,  def: 0.9  },
      Archer:   { hp: 0.9, atk: 1.25, def: 0.85 },
      Assassin: { hp: 0.85,atk: 1.25, def: 0.8  },
      Support:  { hp: 1.0, atk: 0.95, def: 1.05 },
    };

    // CLASS_COUNTERS[attackerClass][defenderClass] = multiplier bonus (0 = no bonus)
    const CLASS_COUNTERS = {
      Assassin: { Support: 0.30, Mage: 0.20, Archer: 0.10, Warrior: -0.05, Tank: -0.15 },
      Warrior:  { Assassin: 0.20, Tank: 0.10, Archer: -0.05 },
      Tank:     { Warrior: 0.10, Archer: 0.15, Assassin: -0.10 },
      Archer:   { Mage: 0.20, Warrior: 0.10, Tank: -0.15, Assassin: -0.10 },
      Mage:     { Tank: 0.25, Archer: 0.15, Assassin: 0.10 },
      Support:  {},
    };

    // Tag counters: if enemy has key tag, player heroes with value tags get a bonus
    const TAG_COUNTER_MAP = {
      HEAL_TEAM:           ["BUFF_DISPEL", "CROWD_CONTROL", "REDUCES_ATTRIBUTES"],
      SHIELD_TEAM:         ["REMOVES_ARMOR", "ENEMY_VULNERABILITY"],
      CROWD_CONTROL:       ["CC_IMMUNITY_TEAM", "CC_RESISTANCE"],
      BUFF_TEAM:           ["BUFF_DISPEL", "ATK_DOWN"],
      ATK_SPD_UP:          ["CC_IMMUNITY_TEAM", "CROWD_CONTROL", "ATK_SPD_DOWN"],
      REMOVES_ARMOR:       ["SHIELD_TEAM", "DMG_RED", "DAMAGE_REDUCTION_TEAM"],
      ENERGY_DRAIN:        ["ENERGY_RESTORE_TEAM", "ENERGY_RESTORE"],
      TAUNT:               ["CROWD_CONTROL", "BUFF_DISPEL", "ATK_UP"],
      ENEMY_VULNERABILITY: ["SHIELD_TEAM", "DAMAGE_REDUCTION_TEAM"],
      ATK_DOWN:            ["ATK_UP", "BUFF_TEAM"],
    };

    const RATING_SCORE_MAP = { SSS: 100, SS: 85, S: 70, A: 55, B: 40, C: 25 };

    // ── State ───────────────────────────────────────────────────
    // slots: e0-e4 = enemy (e0-e2 back, e3-e4 front), p0-p4 = player (p0-p1 front, p2-p4 back)
    const state = {
      slots: {},        // slotId -> hero object or null
      pickerTarget: null, // slotId being filled
      filterClass: "",
      filterFaction: "",
      searchQ: "",
      bpEnabled: true,
      bpEnemy: 0,
      bpPlayer: 0,
    };

    const HERO_MAP = {};
    for (const h of heroesData) HERO_MAP[h.id] = h;

    const allHeroes = heroesData;

    // ── DOM refs ────────────────────────────────────────────────
    const pickerOverlay = document.getElementById("picker-overlay");
    const pickerTitle   = document.getElementById("picker-title");
    const pickerClose   = document.getElementById("picker-close-btn");
    const pickerGrid    = document.getElementById("picker-grid");
    const pickerBottomBar = document.getElementById("picker-bottom-bar");
    const pickerCollapseBtn = document.getElementById("picker-collapse-btn");
    const bpEnableInput = document.getElementById("bp-enable");
    const bpEnemyInput = document.getElementById("bp-enemy");
    const bpPlayerInput = document.getElementById("bp-player");

    function setPickerCollapsed(collapsed) {
      if (!pickerBottomBar || !pickerCollapseBtn) return;
      pickerBottomBar.classList.toggle("collapsed", collapsed);
      pickerCollapseBtn.textContent = collapsed ? "↑" : "↓";
      pickerCollapseBtn.title = collapsed ? "Show picker" : "Hide picker";
      pickerCollapseBtn.setAttribute("aria-label", collapsed ? "Show picker" : "Hide picker");
      try {
        localStorage.setItem("battleSimPickerCollapsed", collapsed ? "1" : "0");
      } catch (_) {}
    }

    if (pickerCollapseBtn) {
      pickerCollapseBtn.addEventListener("click", () => {
        const collapsed = pickerBottomBar?.classList.contains("collapsed") || false;
        setPickerCollapsed(!collapsed);
      });
    }

    try {
      const stored = localStorage.getItem("battleSimPickerCollapsed") === "1";
      setPickerCollapsed(stored);
    } catch (_) {}

    function parseBattlePower(raw) {
      const clean = String(raw || "").replace(/[^0-9]/g, "");
      if (!clean) return 0;
      const value = Number(clean);
      return Number.isFinite(value) ? Math.max(0, Math.round(value)) : 0;
    }

    function formatBattlePower(value) {
      const n = Number(value || 0);
      if (!Number.isFinite(n) || n <= 0) return "";
      return Math.round(n).toLocaleString("en-US");
    }

    function syncBattlePowerState() {
      state.bpEnabled = !!bpEnableInput?.checked;
      state.bpEnemy = parseBattlePower(bpEnemyInput?.value || "");
      state.bpPlayer = parseBattlePower(bpPlayerInput?.value || "");
    }

    if (bpEnableInput) {
      bpEnableInput.addEventListener("change", () => {
        syncBattlePowerState();
        updateAnalysis();
      });
    }

    if (bpEnemyInput) {
      bpEnemyInput.addEventListener("input", () => {
        syncBattlePowerState();
        updateAnalysis();
      });
      bpEnemyInput.addEventListener("blur", () => {
        syncBattlePowerState();
        bpEnemyInput.value = formatBattlePower(state.bpEnemy);
      });
    }

    if (bpPlayerInput) {
      bpPlayerInput.addEventListener("input", () => {
        syncBattlePowerState();
        updateAnalysis();
      });
      bpPlayerInput.addEventListener("blur", () => {
        syncBattlePowerState();
        bpPlayerInput.value = formatBattlePower(state.bpPlayer);
      });
    }

    // ── Slot click handlers ─────────────────────────────────────
    document.querySelectorAll(".slot").forEach(slot => {
      slot.addEventListener("click", e => {
        if (e.target.closest(".slot-remove")) return;
        const slotId = slot.dataset.slot;
        openPicker(slotId, slot.classList.contains("enemy-slot"));
      });
    });

    document.querySelectorAll(".slot-remove").forEach(btn => {
      btn.addEventListener("click", e => {
        e.stopPropagation();
        const slot = btn.closest(".slot");
        clearSlot(slot.dataset.slot);
      });
    });

    // ── Picker open/close ───────────────────────────────────────
    function openPicker(slotId, isEnemy) {
      state.pickerTarget = slotId;
      pickerTitle.textContent = isEnemy ? "Select Enemy Hero" : "Select Your Hero";
      if (window.innerWidth > 768) {
        if (pickerBottomBar) pickerBottomBar.classList.add("visible");
        setPickerCollapsed(false);
        if (pickerBottomBar) {
          pickerBottomBar.classList.remove("collapsed");
          pickerBottomBar.scrollIntoView({ behavior: "smooth", block: "end" });
        }
      }
      renderPickerGrid();
      // Only show modal on mobile (screen < 768px)
      if (window.innerWidth <= 768) {
        pickerOverlay.classList.add("open");
      }
    }

    pickerClose.addEventListener("click", closePicker);
    pickerOverlay.addEventListener("click", e => { if (e.target === pickerOverlay) closePicker(); });

    function closePicker() {
      pickerOverlay.classList.remove("open");
      state.pickerTarget = null;
    }

    // ── Picker filters ──────────────────────────────────────────
    document.getElementById("filter-class").addEventListener("click", e => {
      const chip = e.target.closest(".chip");
      if (!chip) return;
      document.querySelectorAll("#filter-class .chip").forEach(c => c.classList.remove("active"));
      chip.classList.add("active");
      state.filterClass = chip.dataset.val;
      renderPickerGrid();
    });

    document.getElementById("filter-faction").addEventListener("click", e => {
      const chip = e.target.closest(".chip");
      if (!chip) return;
      document.querySelectorAll("#filter-faction .chip").forEach(c => c.classList.remove("active"));
      chip.classList.add("active");
      state.filterFaction = chip.dataset.val;
      renderPickerGrid();
    });

    // Desktop filter listeners
    document.getElementById("filter-class-desktop").addEventListener("click", e => {
      const chip = e.target.closest(".chip");
      if (!chip) return;
      document.querySelectorAll("#filter-class-desktop .chip").forEach(c => c.classList.remove("active"));
      chip.classList.add("active");
      state.filterClass = chip.dataset.val;
      document.querySelectorAll("#filter-class .chip").forEach(c => c.classList.remove("active"));
      document.querySelector(`#filter-class [data-val="${chip.dataset.val}"]`).classList.add("active");
      renderPickerGrid();
    });

    document.getElementById("filter-faction-desktop").addEventListener("click", e => {
      const chip = e.target.closest(".chip");
      if (!chip) return;
      document.querySelectorAll("#filter-faction-desktop .chip").forEach(c => c.classList.remove("active"));
      chip.classList.add("active");
      state.filterFaction = chip.dataset.val;
      document.querySelectorAll("#filter-faction .chip").forEach(c => c.classList.remove("active"));
      document.querySelector(`#filter-faction [data-val="${chip.dataset.val}"]`).classList.add("active");
      renderPickerGrid();
    });

    // ── Picker grid render ──────────────────────────────────────
    function renderPickerGrid() {
      const targetIsEnemy = (state.pickerTarget || "").startsWith("e");
      const sidePrefix = targetIsEnemy ? "e" : "p";
      const placedIds = new Set(
        Object.entries(state.slots)
          .filter(([slotId, hero]) => slotId.startsWith(sidePrefix) && !!hero)
          .map(([, hero]) => hero.id)
      );

      const filtered = allHeroes.filter(h => {
        if (state.filterClass && h.class !== state.filterClass) return false;
        if (state.filterFaction && h.faction !== state.filterFaction) return false;
        return true;
      });

      const classColorMap = {
        Tank: "cls-tank", Warrior: "cls-warrior", Mage: "cls-mage",
        Archer: "cls-archer", Assassin: "cls-assassin", Support: "cls-support"
      };

      const html = filtered.map(h => {
        const url = h.image || "/heroes/" + h.id + ".webp";
        return `
        <div class="picker-hero ${placedIds.has(h.id) ? "already-placed" : ""}" data-id="${h.id}">
          <div class="picker-hero-portrait" data-image="${url}"></div>
          <div class="picker-hero-name">${h.name}</div>
          <!--<div class="picker-hero-class ${classColorMap[h.class] || ""}">${h.class}</div>-->
        </div>`;
      }).join("");

      // Render to both mobile modal picker and desktop bottom bar
      pickerGrid.innerHTML = html;
      const bottomGrid = document.getElementById("picker-bottom-grid");
      if (bottomGrid) bottomGrid.innerHTML = html;

      // Apply portrait backgrounds after insertion (more reliable than inline style strings)
      document.querySelectorAll(".picker-hero-portrait").forEach(el => {
        const image = el.getAttribute("data-image") || "";
        if (!image) return;
        el.style.backgroundImage = `url("${encodeURI(image)}")`;
      });

      // Add click handlers to both grids
      const allPickerCards = document.querySelectorAll(".picker-hero");
      allPickerCards.forEach(card => {
        card.addEventListener("click", () => {
          const hero = HERO_MAP[card.dataset.id];
          if (hero) assignHeroToSlot(state.pickerTarget, hero);
        });
      });
    }

    // ── Assign / clear hero in slot ─────────────────────────────
    function assignHeroToSlot(slotId, hero) {
      state.slots[slotId] = hero;
      renderSlot(slotId);
      if (window.innerWidth > 768) {
        setPickerCollapsed(true);
        if (pickerBottomBar) pickerBottomBar.classList.remove("visible");
      }
      closePicker();
      updateAnalysis();
    }

    function clearSlot(slotId) {
      state.slots[slotId] = null;
      renderSlot(slotId);
      updateAnalysis();
    }

    function renderSlot(slotId) {
      const slotEl = document.querySelector(`.slot[data-slot="${slotId}"]`);
      if (!slotEl) return;
      const hero = state.slots[slotId];

      if (hero) {
        slotEl.classList.add("filled");
        const url = hero.image || "/heroes/" + hero.id + ".webp";
        slotEl.querySelector(".slot-hero-portrait").style.backgroundImage = "url('" + url + "')";
        slotEl.querySelector(".slot-hero-name").textContent = hero.name;
        slotEl.querySelector(".slot-hero-class").textContent = hero.class;
      } else {
        slotEl.classList.remove("filled");
        slotEl.querySelector(".slot-hero-portrait").style.backgroundImage = "";
        slotEl.querySelector(".slot-hero-name").textContent = "";
        slotEl.querySelector(".slot-hero-class").textContent = "";
      }
    }

    // ── Analysis engine ─────────────────────────────────────────
    function getTeamHeroes(side) {
      const prefix = side === "enemy" ? "e" : "p";
      return [0,1,2,3,4].map(i => state.slots[prefix + i]).filter(Boolean);
    }

    function heroStatScore(hero) {
      const s = hero.stats || {};
      const w = CLASS_WEIGHTS[hero.class] || { hp: 1, atk: 1, def: 1 };
      const hp   = (Number(s.hp   || 0)) * 0.000003;
      const atk  = (Number(s.atk  || 0)) * 0.00008;
      const def  = ((Number(s.armor || 0)) + (Number(s.magicRes || 0))) * 0.002;
      const pct  = ["dodgeRate","hitBonus","critRate","critDmgBonus","cooldownHaste","atkSpdBonus","pDmgBonus","mDmgBonus"]
                      .reduce((sum, k) => sum + Number(s[k] || 0), 0) * 0.5;
      return hp * w.hp + atk * w.atk + def * w.def + pct;
    }

    function factionBonus(heroes) {
      if (heroes.length === 0) return 1;
      const counts = {};
      for (const h of heroes) counts[h.faction] = (counts[h.faction] || 0) + 1;
      const max = Math.max(...Object.values(counts));
      if (max >= 5) return 1.25;
      if (max >= 3) return 1.15;
      if (max >= 2) return 1.05;
      return 1.0;
    }

    function dominantFaction(heroes) {
      if (!heroes.length) return null;
      const counts = {};
      for (const h of heroes) counts[h.faction] = (counts[h.faction] || 0) + 1;
      const sorted = Object.entries(counts).sort((a,b) => b[1]-a[1]);
      return { faction: sorted[0][0], count: sorted[0][1] };
    }

    function synergyScore(heroes) {
      if (!heroes.length) return 0;
      const tagCounts = {};
      for (const h of heroes) {
        for (const tag of (h.synergies || [])) {
          tagCounts[tag] = (tagCounts[tag] || 0) + 1;
        }
      }
      let score = 0;
      for (const [, count] of Object.entries(tagCounts)) {
        score += count * 4; // each tag adds 4, duplicates stack
      }
      return score;
    }

    function classCounterScore(attackers, defenders) {
      // How strongly attackers counter the defenders
      let bonus = 0;
      for (const att of attackers) {
        const counters = CLASS_COUNTERS[att.class] || {};
        for (const def of defenders) {
          bonus += (counters[def.class] || 0);
        }
      }
      return bonus * 10; // scale
    }

    function tagCounterScore(myHeroes, enemyHeroes) {
      // Score how well myHeroes' tags counter enemyHeroes' tags
      const enemyTags = new Set();
      for (const h of enemyHeroes) for (const t of (h.synergies || [])) enemyTags.add(t);

      let score = 0;
      const myTags = new Set();
      for (const h of myHeroes) for (const t of (h.synergies || [])) myTags.add(t);

      for (const [enemyTag, counterTags] of Object.entries(TAG_COUNTER_MAP)) {
        if (enemyTags.has(enemyTag)) {
          for (const ct of counterTags) {
            if (myTags.has(ct)) score += 8;
          }
        }
      }
      return score;
    }

    function ratingScore(heroes) {
      if (!heroes.length) return 0;
      return heroes.reduce((sum, h) => {
        const r = h.ratings || {};
        const overall = RATING_SCORE_MAP[r.overall] || 50;
        const pvp = RATING_SCORE_MAP[r.pvp] || 50;
        return sum + (overall * 0.5 + pvp * 0.5);
      }, 0);
    }

    function computeTeamScore(heroes) {
      if (!heroes.length) return { total: 0, stat: 0, faction: 1, synergy: 0, counter: 0, rating: 0 };

      const rawStat  = heroes.reduce((s, h) => s + heroStatScore(h), 0);
      const facMult  = factionBonus(heroes);
      const stat     = rawStat * facMult;
      const synergy  = synergyScore(heroes);
      const rating   = ratingScore(heroes);

      return { total: stat + synergy + rating, stat, faction: facMult, synergy, rating };
    }

    function computeWinRate(playerHeroes, enemyHeroes) {
      if (!playerHeroes.length && !enemyHeroes.length) return null;

      const pScore = computeTeamScore(playerHeroes);
      const eScore = computeTeamScore(enemyHeroes);

      const pCounter = classCounterScore(playerHeroes, enemyHeroes) + tagCounterScore(playerHeroes, enemyHeroes);
      const eCounter = classCounterScore(enemyHeroes, playerHeroes) + tagCounterScore(enemyHeroes, playerHeroes);

      const pTotal = pScore.total + pCounter;
      const eTotal = eScore.total + eCounter;

      const sum = pTotal + eTotal;
      if (sum === 0) return 50;
      const raw = (pTotal / sum) * 100;
      return Math.max(5, Math.min(95, raw));
    }

    function applyBattlePowerAdjustment(basePct) {
      if (!state.bpEnabled) {
        return { pct: basePct, note: "BP adjustment off." };
      }

      if (state.bpEnemy <= 0 || state.bpPlayer <= 0) {
        return { pct: basePct, note: "Set both BP values to apply investment adjustment." };
      }

      const ratio = state.bpPlayer / state.bpEnemy;
      const multiplier = Math.max(0.85, Math.min(1.15, Math.pow(ratio, 0.25)));

      const safeBase = Math.max(1, Math.min(99, basePct));
      const baseOdds = safeBase / (100 - safeBase);
      const adjustedOdds = baseOdds * multiplier;
      const adjustedPct = Math.max(5, Math.min(95, (adjustedOdds / (1 + adjustedOdds)) * 100));

      const note =
        "BP impact: x" + multiplier.toFixed(2) +
        " (You " + formatBattlePower(state.bpPlayer) +
        " vs Enemy " + formatBattlePower(state.bpEnemy) + ").";

      return { pct: adjustedPct, note };
    }

    // ── Update Analysis ──────────────────────────────────────────
    function updateAnalysis() {
      const playerHeroes = getTeamHeroes("player");
      const enemyHeroes  = getTeamHeroes("enemy");

      updatePostFightCardVisibility();

      const totalFilled = playerHeroes.length + enemyHeroes.length;

      // Win rate
      if (totalFilled === 0) {
        setWinRateEmpty();
      } else {
        const basePct = computeWinRate(playerHeroes, enemyHeroes);
        const adjusted = applyBattlePowerAdjustment(basePct);
        renderWinRate(adjusted.pct, playerHeroes, enemyHeroes, adjusted.note);
      }

      // Breakdown
      renderBreakdown(playerHeroes, enemyHeroes);

      // Insights
      renderInsights(playerHeroes, enemyHeroes);

      // Suggestions (need 2+ enemy heroes)
      if (enemyHeroes.length >= 2) {
        renderSuggestions(enemyHeroes, playerHeroes);
      } else {
        document.getElementById("suggestions-list").innerHTML =
          '<div class="suggestions-empty">Add at least 2 enemy heroes to get suggestions.</div>';
      }
    }

    function setWinRateEmpty() {
      document.getElementById("winrate-pct").textContent = "--";
      document.getElementById("winrate-pct").style.color = "rgba(230,230,235,0.3)";
      document.getElementById("winrate-verdict").textContent = "--";
      document.getElementById("winrate-confidence").textContent = "add heroes to calculate";
      document.getElementById("winrate-bar").style.width = "50%";
      document.getElementById("winrate-bar").style.background = "linear-gradient(90deg, #4a9ec2, #59c4a0)";
      document.getElementById("winrate-bp-impact").textContent = state.bpEnabled
        ? "Set both BP values to apply investment adjustment."
        : "BP adjustment off.";
    }

    function renderWinRate(pct, playerHeroes, enemyHeroes, bpNote) {
      const pctEl    = document.getElementById("winrate-pct");
      const verdictEl = document.getElementById("winrate-verdict");
      const confEl   = document.getElementById("winrate-confidence");
      const barEl    = document.getElementById("winrate-bar");
      const bpEl     = document.getElementById("winrate-bp-impact");

      const total = playerHeroes.length + enemyHeroes.length;
      const maxSlots = 10;
      const confidence = Math.round((total / maxSlots) * 100);

      if (playerHeroes.length === 0) {
        pctEl.textContent = "--";
        pctEl.style.color = "#8a9aaa";
        verdictEl.textContent = "Enemy only";
        confEl.textContent = "add your heroes";
        barEl.style.width = "50%";
        bpEl.textContent = bpNote || "";
        return;
      }

      pctEl.textContent = Math.round(pct) + "%";

      // Colour + verdict
      if (pct >= 70) {
        pctEl.style.color = "#86efac";
        verdictEl.textContent = "Strong Advantage";
        verdictEl.style.color = "#86efac";
      } else if (pct >= 58) {
        pctEl.style.color = "#facc15";
        verdictEl.textContent = "Slight Advantage";
        verdictEl.style.color = "#facc15";
      } else if (pct >= 42) {
        pctEl.style.color = "#e6e6eb";
        verdictEl.textContent = "Even Match";
        verdictEl.style.color = "#e6e6eb";
      } else if (pct >= 30) {
        pctEl.style.color = "#fb923c";
        verdictEl.textContent = "Slight Disadvantage";
        verdictEl.style.color = "#fb923c";
      } else {
        pctEl.style.color = "#f87171";
        verdictEl.textContent = "Heavy Disadvantage";
        verdictEl.style.color = "#f87171";
      }

      confEl.textContent = confidence + "% confidence (" + total + "/10 slots)";
      bpEl.textContent = bpNote || "";
      barEl.style.width = Math.round(pct) + "%";

      if (pct >= 58)      barEl.style.background = "linear-gradient(90deg, rgba(134,239,172,0.8), #86efac)";
      else if (pct >= 42) barEl.style.background = "linear-gradient(90deg, rgba(250,204,21,0.7), #facc15)";
      else                barEl.style.background = "linear-gradient(90deg, rgba(251,146,60,0.8), #f87171)";
    }

    function renderBreakdown(playerHeroes, enemyHeroes) {
      const pScore = computeTeamScore(playerHeroes);
      const eScore = computeTeamScore(enemyHeroes);
      const pCounter = classCounterScore(playerHeroes, enemyHeroes) + tagCounterScore(playerHeroes, enemyHeroes);
      const eCounter = classCounterScore(enemyHeroes, playerHeroes) + tagCounterScore(enemyHeroes, playerHeroes);

      const fmt = (v, dec = 0) => v === 0 ? "--" : (dec === 0 ? Math.round(v).toString() : v.toFixed(dec) + "x");

      document.getElementById("bd-stat-e").textContent  = fmt(eScore.stat);
      document.getElementById("bd-stat-p").textContent  = fmt(pScore.stat);
      document.getElementById("bd-fac-e").textContent   = eScore.faction === 1 ? "--" : fmt(eScore.faction, 2);
      document.getElementById("bd-fac-p").textContent   = pScore.faction === 1 ? "--" : fmt(pScore.faction, 2);
      document.getElementById("bd-syn-e").textContent   = fmt(eScore.synergy);
      document.getElementById("bd-syn-p").textContent   = fmt(pScore.synergy);
      document.getElementById("bd-cnt-e").textContent   = eCounter === 0 ? "--" : "+" + Math.round(eCounter);
      document.getElementById("bd-cnt-p").textContent   = pCounter === 0 ? "--" : "+" + Math.round(pCounter);
      document.getElementById("bd-rat-e").textContent   = fmt(eScore.rating);
      document.getElementById("bd-rat-p").textContent   = fmt(pScore.rating);
    }

    function renderInsights(playerHeroes, enemyHeroes) {
      const container = document.getElementById("factor-list");
      const factors = [];

      if (!playerHeroes.length && !enemyHeroes.length) {
        container.innerHTML = '<div class="hint-empty">Place heroes on the battlefield to see matchup analysis.</div>';
        return;
      }

      // Faction bonuses
      const eFac = dominantFaction(enemyHeroes);
      const pFac = dominantFaction(playerHeroes);
      if (eFac && eFac.count >= 3) {
        factors.push({ icon: "[F]", text: "Enemy has " + eFac.count + "x " + eFac.faction + " -- faction bonus active.", type: "negative" });
      }
      if (pFac && pFac.count >= 3) {
        factors.push({ icon: "[F]", text: "Your team has " + pFac.count + "x " + pFac.faction + " -- faction bonus active.", type: "positive" });
      }

      // Class counter highlights
      for (const att of playerHeroes) {
        const counters = CLASS_COUNTERS[att.class] || {};
        for (const def of enemyHeroes) {
          const bonus = counters[def.class] || 0;
          if (bonus >= 0.2) {
            factors.push({ icon: "[+]", text: att.name + " (" + att.class + ") counters " + def.name + " (" + def.class + ").", type: "positive" });
          }
        }
      }
      for (const att of enemyHeroes) {
        const counters = CLASS_COUNTERS[att.class] || {};
        for (const def of playerHeroes) {
          const bonus = counters[def.class] || 0;
          if (bonus >= 0.2) {
            factors.push({ icon: "[-]", text: "Enemy " + att.name + " (" + att.class + ") counters your " + def.name + " (" + def.class + ").", type: "negative" });
          }
        }
      }

      // Tag dangers
      const enemyTags = new Set();
      for (const h of enemyHeroes) for (const t of (h.synergies || [])) enemyTags.add(t);
      const playerTags = new Set();
      for (const h of playerHeroes) for (const t of (h.synergies || [])) playerTags.add(t);

      if (enemyTags.has("HEAL_TEAM") && !playerTags.has("BUFF_DISPEL") && !playerTags.has("CROWD_CONTROL")) {
        factors.push({ icon: "[!]", text: "Enemy has healing. Consider a hero with BUFF_DISPEL or CROWD_CONTROL.", type: "negative" });
      }
      if (enemyTags.has("CROWD_CONTROL") && !playerTags.has("CC_IMMUNITY_TEAM")) {
        factors.push({ icon: "[!]", text: "Enemy has CC. A CC_IMMUNITY support could protect your team.", type: "negative" });
      }
      if (enemyTags.has("REMOVES_ARMOR") && !playerTags.has("SHIELD_TEAM") && !playerTags.has("DAMAGE_REDUCTION_TEAM")) {
        factors.push({ icon: "[!]", text: "Enemy strips armor. Add a shield or damage reduction source.", type: "negative" });
      }
      if (playerTags.has("BUFF_DISPEL") && enemyTags.has("BUFF_TEAM")) {
        factors.push({ icon: "[+]", text: "Your team can dispel enemy buffs -- good matchup.", type: "positive" });
      }
      if (playerTags.has("CROWD_CONTROL") && enemyTags.has("HEAL_TEAM")) {
        factors.push({ icon: "[+]", text: "Your CC can interrupt enemy healing rotations.", type: "positive" });
      }

      // Composition gaps
      const playerClasses = playerHeroes.map(h => h.class);
      if (playerHeroes.length >= 2 && !playerClasses.includes("Support") && !playerClasses.includes("Tank")) {
        factors.push({ icon: "[?]", text: "Your team has no Tank or Support -- may lack sustain.", type: "neutral" });
      }
      if (enemyHeroes.length >= 3) {
        const enemyAtk = enemyHeroes.reduce((s,h) => s + Number((h.stats || {}).atk || 0), 0);
        const playerHp = playerHeroes.reduce((s,h) => s + Number((h.stats || {}).hp || 0), 0);
        if (playerHeroes.length > 0 && enemyAtk > playerHp * 0.15) {
          factors.push({ icon: "[!]", text: "Enemy ATK is high relative to your total HP pool.", type: "negative" });
        }
      }

      if (!factors.length) {
        factors.push({ icon: "[=]", text: "No critical matchup issues detected. Looks balanced.", type: "neutral" });
      }

      container.innerHTML = factors.slice(0, 7).map(f => `
        <div class="factor-item factor-${f.type}">
          <span class="factor-icon">${f.icon}</span>
          <span class="factor-text">${f.text}</span>
        </div>
      `).join("");
    }

    // ── Hero Suggestions ─────────────────────────────────────────
    function computeCounterScore(hero, enemyHeroes, playerHeroes) {
      const reasons = [];
      let score = 0;

      // Base hero rating
      const r = hero.ratings || {};
      score += (RATING_SCORE_MAP[r.pvp] || 50) * 0.3;
      score += (RATING_SCORE_MAP[r.overall] || 50) * 0.2;

      // Class counters
      const counters = CLASS_COUNTERS[hero.class] || {};
      let ccBonus = 0;
      for (const def of enemyHeroes) {
        ccBonus += (counters[def.class] || 0);
      }
      if (ccBonus > 0) {
        score += ccBonus * 30;
        const topped = enemyHeroes.filter(def => (counters[def.class] || 0) >= 0.2).map(d => d.class);
        if (topped.length) reasons.push("Counters " + [...new Set(topped)].join("/"));
      }

      // Tag counters
      const enemyTags = new Set();
      for (const h of enemyHeroes) for (const t of (h.synergies || [])) enemyTags.add(t);

      const heroTags = new Set(hero.synergies || []);
      let tagBonus = 0;
      const matchedReasons = [];
      for (const [enemyTag, counterTags] of Object.entries(TAG_COUNTER_MAP)) {
        if (enemyTags.has(enemyTag)) {
          for (const ct of counterTags) {
            if (heroTags.has(ct)) {
              tagBonus += 12;
              matchedReasons.push(ct.replace(/_/g, " "));
            }
          }
        }
      }
      if (tagBonus > 0) {
        score += tagBonus;
        reasons.push(matchedReasons.slice(0, 2).join(", "));
      }

      // Stat advantage
      score += heroStatScore(hero) * 0.5;

      // Penalize already placed (handled by exclusion), but also check team composition
      const presentClasses = playerHeroes.map(h => h.class);
      if (!presentClasses.includes(hero.class)) {
        score += 5; // small diversity bonus
      }

      const reason = reasons.length ? reasons.slice(0, 2).join(" | ") : "High overall rating";

      return { score, reason };
    }

    function renderSuggestions(enemyHeroes, playerHeroes) {
      const container = document.getElementById("suggestions-list");

      const placedIds = new Set([...playerHeroes, ...enemyHeroes].map(h => h.id));

      const candidates = allHeroes
        .filter(h => !placedIds.has(h.id))
        .map(h => {
          const { score, reason } = computeCounterScore(h, enemyHeroes, playerHeroes);
          return { hero: h, score, reason };
        })
        .sort((a, b) => b.score - a.score)
        .slice(0, 6);

      if (!candidates.length) {
        container.innerHTML = '<div class="suggestions-empty">No suggestions available.</div>';
        return;
      }

      container.innerHTML = candidates.map(({ hero, reason, score }) => {
        const url = hero.image || "/heroes/" + hero.id + ".webp";
        return `
        <div class="suggestion-hero" data-id="${hero.id}" title="Click to place in next empty player slot">
          <div class="suggestion-portrait" style="background-image:url('${url}')"></div>
          <div class="suggestion-info">
            <div class="suggestion-name">${hero.name}</div>
            <div class="suggestion-reason">${reason}</div>
          </div>
          <div class="suggestion-score">${Math.round(score)}</div>
        </div>`;
      }).join("");

      // Click-to-place in next empty player slot
      container.querySelectorAll(".suggestion-hero").forEach(card => {
        card.addEventListener("click", () => {
          const hero = HERO_MAP[card.dataset.id];
          if (!hero) return;
          const emptySlot = ["p0","p1","p2","p3","p4"].find(s => !state.slots[s]);
          if (emptySlot) {
            assignHeroToSlot(emptySlot, hero);
          } else {
            // All slots full, prompt picker so user can choose where
            openPicker("p0", false);
          }
        });
      });
    }

    // ── Post-Fight Outcome Submission ────────────────────────────
    let selectedOutcome = null;

    const outcomeWinBtn = document.getElementById("outcome-win");
    const outcomeLossBtn = document.getElementById("outcome-loss");
    const submitBtn = document.getElementById("submit-outcome");

    if (outcomeWinBtn) {
      outcomeWinBtn.addEventListener("click", () => {
        console.log("Outcome: Won selected");
        selectedOutcome = "player";
        outcomeWinBtn.classList.add("selected");
        outcomeLossBtn.classList.remove("selected");
      });
    } else {
      console.warn("outcome-win button not found");
    }

    if (outcomeLossBtn) {
      outcomeLossBtn.addEventListener("click", () => {
        console.log("Outcome: Lost selected");
        selectedOutcome = "enemy";
        outcomeLossBtn.classList.add("selected");
        outcomeWinBtn.classList.remove("selected");
      });
    }

    if (submitBtn) {
      submitBtn.addEventListener("click", async () => {
        const playerHeroes = getTeamHeroes("player");
        const enemyHeroes = getTeamHeroes("enemy");
        const authToken = localStorage.getItem("authToken");

        console.log("Submit clicked. selectedOutcome:", selectedOutcome, "authToken:", authToken ? "SET" : "NOT SET");

        if (!selectedOutcome) {
          showOutcomeStatus("Please select an outcome (Won or Lost)", "error");
          return;
        }

        if (!authToken) {
          showOutcomeStatus("Please log in to submit outcomes", "error");
          return;
        }

        submitBtn.disabled = true;

        const winRate = computeWinRate(playerHeroes, enemyHeroes) || 50;
        const teamData = {
          teamPlayer: playerHeroes.map(h => ({ hero_id: h.id })),
          teamEnemy: enemyHeroes.map(h => ({ hero_id: h.id })),
          bpPlayer: parseInt(state.bpPlayer) || 0,
          bpEnemy: parseInt(state.bpEnemy) || 0,
          winner: selectedOutcome,
          predictedWinRate: winRate,
          mode: "pvp",
          notes: document.getElementById("outcome-notes").value || null,
        };

        try {
           const response = await fetch("/api/user/battles", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + authToken,
            },
            body: JSON.stringify(teamData),
          });

          if (response.ok) {
            showOutcomeStatus("Fight outcome recorded. Data will help improve predictions.", "success");
            selectedOutcome = null;
            document.getElementById("outcome-notes").value = "";
            outcomeWinBtn.classList.remove("selected");
            outcomeLossBtn.classList.remove("selected");
            setTimeout(() => {
              document.getElementById("outcome-status").style.display = "none";
            }, 4000);
          } else {
            const data = await response.json();
            showOutcomeStatus(data.error || "Failed to record fight", "error");
          }
        } catch (error) {
          console.error("Error submitting outcome:", error);
          showOutcomeStatus("Network error: " + error.message, "error");
        } finally {
          submitBtn.disabled = false;
        }
      });
    } else {
      console.warn("submit-outcome button not found");
    }

    function showOutcomeStatus(message, type) {
      const statusEl = document.getElementById("outcome-status");
      statusEl.textContent = message;
      statusEl.className = "form-status " + type;
      statusEl.style.display = "block";
    }

    function updatePostFightCardVisibility() {
      const playerHeroes = getTeamHeroes("player");
      const enemyHeroes = getTeamHeroes("enemy");
      const card = document.getElementById("post-fight-card");

      if (playerHeroes.length > 0 && enemyHeroes.length > 0) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }
    }

    // ── Init ─────────────────────────────────────────────────────
    renderPickerGrid();
    updateAnalysis();
  </script>
</body>
</html>
