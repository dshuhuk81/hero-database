---
export const prerender = true;
import Sidebar from "../components/Sidebar.astro";
import allHeroesDb from "../data/all_heroes_db.json";

const heroes = Object.values(allHeroesDb).sort((a: any, b: any) =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base" })
);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Battle Simulator</title>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      font-family: "Spectral", "Roboto", system-ui, sans-serif;
      background:
        radial-gradient(ellipse at 30% -10%, rgba(120,90,200,0.15), transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(255,215,100,0.08), transparent 55%),
        linear-gradient(to bottom, #0d0b10, #07060c);
      color: #e6e6eb;
      min-height: 100vh;
    }

    body { margin-left: 48px; }

    .main-content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 32px 80px;
    }

    @media (max-width: 768px) {
      body { margin-left: 0; margin-bottom: 56px; }
      .main-content { padding: 20px 16px 80px; }
    }

    /* ── Page Header ── */
    .page-header { margin-bottom: 28px; }
    .page-title { font-size: 2rem; font-weight: 700; color: #e6e6eb; letter-spacing: 0.01em; }
    .separator { width: 100%; height: 2px; background: rgba(250,204,21,0.4); margin: 10px 0 20px; }
    .page-subtitle { color: rgba(230,230,235,0.5); font-size: 0.875rem; margin-top: 4px; }

    /* ── Layout ── */
    .sim-layout {
      display: grid;
      grid-template-columns: 1fr 310px;
      gap: 20px;
      align-items: start;
    }

    @media (max-width: 900px) {
      .sim-layout { grid-template-columns: 1fr; }
    }

    /* ── Battlefield ── */
    .battlefield {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(168,85,247,0.25);
      border-radius: 16px;
      padding: 24px 20px;
      position: relative;
      overflow: hidden;
    }

    .battlefield::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 70% 30% at 50% 50%, rgba(168,85,247,0.06) 0%, transparent 70%);
      pointer-events: none;
    }

    .team-label {
      text-align: center;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .team-label.enemy  { color: #f87171; }
    .team-label.player { color: #facc15; }

    .row {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    /* ── Hero Slot ── */
    .slot {
      width: 88px;
      height: 108px;
      border-radius: 10px;
      border: 2px dashed rgba(168,85,247,0.2);
      background: rgba(255,255,255,0.025);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
      flex-shrink: 0;
    }

    .slot:hover {
      border-color: rgba(250,204,21,0.5);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(250,204,21,0.12);
    }

    .slot.filled { border-style: solid; border-color: rgba(168,85,247,0.4); }
    .slot.filled:hover {
      border-color: rgba(250,204,21,0.6);
      box-shadow: 0 6px 24px rgba(250,204,21,0.18);
    }

    .slot.enemy-slot { border-color: rgba(248,113,113,0.2); }
    .slot.enemy-slot:hover {
      border-color: rgba(248,113,113,0.6);
      box-shadow: 0 6px 20px rgba(248,113,113,0.15);
    }
    .slot.enemy-slot.filled { border-color: rgba(248,113,113,0.45); }

    .slot-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      gap: 4px;
      color: rgba(168,85,247,0.3);
      font-size: 0.58rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      user-select: none;
    }

    .slot-empty svg { width: 20px; height: 20px; opacity: 0.6; }

    .slot-hero {
      display: none;
      flex-direction: column;
      height: 100%;
    }

    .slot-hero-portrait {
      width: 100%;
      height: 76px;
      background-size: cover;
      background-position: top center;
      background-repeat: no-repeat;
      background-color: rgba(168,85,247,0.08);
      flex-shrink: 0;
    }

    .slot-hero-info {
      padding: 3px 5px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: rgba(0,0,0,0.35);
    }

    .slot-hero-name {
      font-size: 0.6rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: #e6e6eb;
      line-height: 1.2;
    }

    .slot-hero-class {
      font-size: 0.52rem;
      color: rgba(250,204,21,0.6);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .slot-remove {
      position: absolute;
      top: 3px;
      right: 3px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(220,40,40,0.85);
      border: none;
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 10px;
      line-height: 1;
      z-index: 2;
      transition: background 0.15s;
    }

    .slot-remove:hover { background: rgba(248,50,50,1); }
    .slot.filled .slot-remove { display: flex; }
    .slot.filled .slot-empty { display: none; }
    .slot.filled .slot-hero { display: flex; }

    /* ── VS Divider ── */
    .vs-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 14px 0;
    }

    .vs-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(250,204,21,0.25), transparent);
    }

    .vs-badge {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid rgba(250,204,21,0.35);
      background: rgba(250,204,21,0.06);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.65rem;
      font-weight: 800;
      color: rgba(250,204,21,0.75);
      letter-spacing: 0.05em;
    }

    /* ── Right Panel ── */
    .analysis-panel { display: flex; flex-direction: column; gap: 14px; }

    .panel-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(168,85,247,0.25);
      border-radius: 12px;
      padding: 14px 16px;
      transition: border-color 0.2s;
    }

    .panel-card:hover { border-color: rgba(168,85,247,0.4); }

    .panel-card h3 {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(250,204,21,0.6);
      margin-bottom: 12px;
    }

    /* ── Win Rate Display ── */
    .winrate-display {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .winrate-pct {
      font-size: 2.4rem;
      font-weight: 800;
      line-height: 1;
    }

    .winrate-label { font-size: 0.68rem; color: rgba(230,230,235,0.4); margin-top: 3px; }

    .winrate-bar-track {
      width: 100%;
      height: 7px;
      background: rgba(248,113,113,0.2);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 5px;
    }

    .winrate-bar-fill {
      height: 100%;
      border-radius: 4px;
      background: linear-gradient(90deg, rgba(250,204,21,0.8), rgba(250,204,21,1));
      transition: width 0.5s ease;
      width: 50%;
    }

    .winrate-sides {
      display: flex;
      justify-content: space-between;
      font-size: 0.62rem;
      color: rgba(230,230,235,0.4);
    }

    .bp-controls {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid rgba(168,85,247,0.12);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .bp-toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.63rem;
      color: rgba(230,230,235,0.75);
    }

    .bp-toggle-row label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      user-select: none;
    }

    .bp-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .bp-field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .bp-field label {
      font-size: 0.58rem;
      color: rgba(230,230,235,0.45);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .bp-input {
      width: 100%;
      height: 28px;
      border-radius: 7px;
      border: 1px solid rgba(168,85,247,0.25);
      background: rgba(255,255,255,0.03);
      color: #e6e6eb;
      padding: 0 8px;
      font-size: 0.72rem;
      outline: none;
    }

    .bp-input:focus {
      border-color: rgba(250,204,21,0.5);
      box-shadow: 0 0 0 1px rgba(250,204,21,0.18) inset;
    }

    .bp-note {
      font-size: 0.6rem;
      color: rgba(230,230,235,0.45);
      line-height: 1.35;
    }

    /* ── Score Breakdown ── */
    .score-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 0;
      border-bottom: 1px solid rgba(168,85,247,0.1);
      font-size: 0.73rem;
    }

    .score-row:last-child { border-bottom: none; }
    .score-row-label { color: rgba(230,230,235,0.5); }

    .score-vals {
      display: flex;
      gap: 10px;
      font-weight: 600;
      font-size: 0.72rem;
    }

    .val-enemy  { color: #f87171; }
    .val-player { color: #facc15; }

    /* ── Suggestions ── */
    .suggestions-empty {
      color: rgba(230,230,235,0.3);
      font-size: 0.73rem;
      text-align: center;
      padding: 12px 0;
    }

    .suggestion-hero {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 8px;
      border-radius: 8px;
      background: rgba(255,255,255,0.025);
      border: 1px solid rgba(168,85,247,0.15);
      cursor: pointer;
      transition: all 0.15s;
      margin-bottom: 6px;
    }

    .suggestion-hero:last-child { margin-bottom: 0; }

    .suggestion-hero:hover {
      background: rgba(250,204,21,0.06);
      border-color: rgba(250,204,21,0.35);
      transform: translateX(2px);
    }

    .suggestion-portrait {
      width: 38px;
      height: 38px;
      border-radius: 6px;
      background-size: cover;
      background-position: top center;
      background-repeat: no-repeat;
      background-color: rgba(168,85,247,0.08);
      flex-shrink: 0;
      border: 1px solid rgba(168,85,247,0.25);
    }

    .suggestion-info { flex: 1; min-width: 0; }

    .suggestion-name {
      font-size: 0.78rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: #e6e6eb;
    }

    .suggestion-reason {
      font-size: 0.63rem;
      color: rgba(230,230,235,0.45);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-top: 1px;
    }

    .suggestion-score {
      font-size: 0.68rem;
      font-weight: 700;
      color: rgba(250,204,21,0.8);
      flex-shrink: 0;
    }

    /* ── Factor Hints ── */
    .hint-empty {
      color: rgba(230,230,235,0.3);
      font-size: 0.63rem;
      text-align: center;
      padding: 8px 0;
    }

    .factor-item {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      padding: 5px 0;
      border-bottom: 1px solid rgba(168,85,247,0.08);
      font-size: 0.71rem;
    }

    .factor-item:last-child { border-bottom: none; }
    .factor-icon { flex-shrink: 0; width: 14px; text-align: center; }
    .factor-text { line-height: 1.45; color: rgba(230,230,235,0.6); }
    .factor-positive .factor-text { color: #86efac; }
    .factor-negative .factor-text { color: #fca5a5; }
    .factor-neutral  .factor-text { color: rgba(230,230,235,0.5); }

    /* ── Hero Picker Modal ── */
    .picker-overlay {
      position: relative;
      bottom: 0;
      left: 0;
      right: 0;
      top: 0;
      background: rgba(7,6,12,0.8);
      z-index: 100;
      display: none;
      align-items: flex-end;
      justify-content: center;
    }

    .picker-bottom-bar {
      display: none;
      position: absolute;
      bottom:0;
      left: 0;
      right: 0;
      max-height: 0;
      opacity: 0;
 /*     transform: translateY(8px); */
      overflow: hidden;
      pointer-events: none;
      background: #0d0b10;
      border-top: 1px solid transparent;
      z-index: 999;
      flex-direction: column;
    }

    .picker-bottom-bar.visible {
      max-height: 340px;
      opacity: 1;
     /* transform: translateY(-340px); */
      pointer-events: auto;
      border-top-color: rgba(168,85,247,0.35);
    }

    .picker-bottom-header {
      padding: 10px 14px;
      border-bottom: 1px solid rgba(168,85,247,0.15);
      flex-shrink: 0;
    }

    .picker-bottom-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }

    .picker-bottom-title {
      font-size: 0.81rem;
      font-weight: 700;
      color: #e6e6eb;
    }

    .picker-collapse-btn {
      width: 24px;
      height: 24px;
      border-radius: 6px;
      border: 1px solid rgba(168,85,247,0.28);
      background: rgba(255,255,255,0.04);
      color: rgba(230,230,235,0.85);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      line-height: 1;
    }

    .picker-collapse-btn:hover {
      border-color: rgba(250,204,21,0.45);
      background: rgba(250,204,21,0.08);
    }

    .picker-bottom-grid {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 8px 12px 12px;
      display: grid;
      grid-template-columns: repeat(auto-fill, 96px);
      justify-content: start;
      gap: 8px;
      align-content: start;
    }

    .picker-bottom-bar.visible.collapsed {
      max-height: 48px;
    }

    .picker-bottom-bar.collapsed .picker-filters,
    .picker-bottom-bar.collapsed .picker-bottom-grid {
      display: none;
    }

    .picker-overlay.open { display: flex; }

    .picker-sheet {
      width: 100%;
      max-width: 920px;
      max-height: 75vh;
      background: #0d0b10;
      border: 1px solid rgba(168,85,247,0.35);
      border-bottom: none;
      border-radius: 20px 20px 0 0;
      display: flex;
      flex-direction: column;
      animation: slideUp 0.2s ease;
    }

    @keyframes slideUp {
      from { transform: translateY(40px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }

    .picker-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px 12px;
      border-bottom: 1px solid rgba(168,85,247,0.15);
      flex-shrink: 0;
    }

    .picker-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: #e6e6eb;
    }

    .picker-close {
      width: 28px; height: 28px;
      border-radius: 50%;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(168,85,247,0.2);
      cursor: pointer;
      color: rgba(230,230,235,0.6);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px;
      transition: all 0.15s;
    }

    .picker-close:hover {
      background: rgba(250,204,21,0.08);
      border-color: rgba(250,204,21,0.4);
      color: #e6e6eb;
    }

    .picker-filters {
      padding: 0;
      display: flex;
      flex-direction: row;
      flex-shrink: 0;
      gap: 48px; 
      margin-top:6px; 
      flex-wrap: wrap;
    }

    .filter-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }

    .chip {
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 0.558rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      border: 1px solid rgba(168,85,247,0.2);
      background: rgba(255,255,255,0.03);
      color: rgba(230,230,235,0.45);
      transition: all 0.15s;
      user-select: none;
    }

    .chip:hover { border-color: rgba(250,204,21,0.35); color: rgba(230,230,235,0.8); }
    .chip.active {
      background: rgba(250,204,21,0.1);
      border-color: rgba(250,204,21,0.5);
      color: #facc15;
    }

    /* ── Picker grid -- fixed card size so images never stretch ── */
    .picker-grid {
      flex: 1;
      overflow-y: auto;
      padding: 8px 16px 12px;
      display: grid;
      grid-template-columns: repeat(auto-fill, 96px);
      justify-content: start;
      gap: 16px;
      align-content: start;
    }

    .picker-hero {
      width: 96px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      border-radius: 8px;
      padding: 6px 4px;
      border: 1px solid transparent;
      transition: all 0.15s;
      text-align: center;
    }

    .picker-hero:hover {
      background: rgba(250,204,21,0.06);
      border-color: rgba(250,204,21,0.3);
    }

    .picker-hero.already-placed { opacity: 0.22; pointer-events: none; }

    .picker-hero-portrait {
      width: 96px;
      height: 96px;
      border-radius: 8px;
      background-size: cover;
      background-position: top 30% center;
      background-repeat: no-repeat;
      background-color: rgba(168,85,247,0.08);
      border: 1px solid rgba(168,85,247,0.2);
      display: block;
      flex-shrink: 0;
    }

    .picker-hero-name {
      font-size: 0.7rem;
      color: #e6e6eb;
      font-weight: 400;
      line-height: 1.2;
      word-break: break-word;
    }

    .picker-hero-class {
      font-size: 0.486rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: rgba(250,204,21,0.55);
    }

    /* Class colour accents */
    .cls-tank     { color: #fb923c; }
    .cls-warrior  { color: #fbbf24; }
    .cls-mage     { color: #a78bfa; }
    .cls-archer   { color: #4ade80; }
    .cls-assassin { color: #f87171; }
    .cls-support  { color: #38bdf8; }

    /* ── Desktop: show bottom bar ── */
    @media (min-width: 769px) {
      .picker-overlay { display: none !important; }
      .picker-bottom-bar {
        display: flex;
      }
      .main-content { padding-bottom: 80px; }
    }

    /* ── Post-Fight Form ── */
    .outcome-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .form-label {
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(230,230,235,0.5);
    }

    .form-input, .form-select {
      width: 100%;
      height: 28px;
      border-radius: 6px;
      border: 1px solid rgba(168,85,247,0.25);
      background: rgba(255,255,255,0.03);
      color: #e6e6eb;
      padding: 0 8px;
      font-size: 0.7rem;
      outline: none;
    }

    .form-input:focus, .form-select:focus {
      border-color: rgba(250,204,21,0.5);
      box-shadow: 0 0 0 1px rgba(250,204,21,0.18) inset;
    }

    .form-buttons {
      display: flex;
      gap: 6px;
    }

    .btn-outcome {
      flex: 1;
      padding: 8px 12px;
      border-radius: 6px;
      border: 1px solid transparent;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outcome.win {
      background: rgba(134,239,172,0.12);
      color: #86efac;
      border-color: rgba(134,239,172,0.35);
    }

    .btn-outcome.win:hover {
      background: rgba(134,239,172,0.18);
      border-color: rgba(134,239,172,0.5);
    }

    .btn-outcome.win.selected {
      background: rgba(134,239,172,0.25);
      border-color: rgba(134,239,172,0.6);
    }

    .btn-outcome.loss {
      background: rgba(248,113,113,0.12);
      color: #f87171;
      border-color: rgba(248,113,113,0.35);
    }

    .btn-outcome.loss:hover {
      background: rgba(248,113,113,0.18);
      border-color: rgba(248,113,113,0.5);
    }

    .btn-outcome.loss.selected {
      background: rgba(248,113,113,0.25);
      border-color: rgba(248,113,113,0.6);
    }

    .btn-submit {
      width: 100%;
      padding: 8px;
      border-radius: 6px;
      border: 1px solid rgba(250,204,21,0.35);
      background: rgba(250,204,21,0.12);
      color: #facc15;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-submit:hover {
      background: rgba(250,204,21,0.18);
