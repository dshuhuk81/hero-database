---
export const prerender = true;
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { heroes } from "../data/heroes";
import accountBonusesData from "../data/accountBonuses.json";
import { getPageUpdate } from "../utils/getPageUpdate";

const pageUpdate = getPageUpdate("stats");

/* ── Reference hero: Hladgunnr ────────────────────── */
const hladgunnr = heroes.find((h) => h.id === "hladgunnr");
const bonusStats: Record<string, number> = {};
const exampleStats = (accountBonusesData as any).presets.example.stats as Record<string, number>;
const hladStats = hladgunnr?.stats ?? {};

const STAT_KEYS = [
  "might","hp","atk","armor","magicRes",
  "dodgeRate","hitBonus","critRate","critRes","critDmgBonus","critDmgRed",
  "energy","cooldownHaste","atkSpdBonus",
  "pDmgBonus","pDmgRed","mDmgBonus","mDmgRed",
  "healEff","rechargeEff","lifestealEff","reflectEff",
  "effectRes","effectHit","controlRes","controlBonus",
  "normalSkillPWR","ultimatePWR",
] as const;

/* Compute account bonus = example account stats - hladgunnr base stats */
for (const key of STAT_KEYS) {
  const exVal = exampleStats[key] ?? 0;
  const hlVal = (hladStats as any)[key] ?? 0;
  bonusStats[key] = exVal - hlVal;
}

/* Human-friendly labels */
const STAT_LABELS: Record<string, string> = {
  might: "Might",
  hp: "HP",
  atk: "ATK",
  armor: "Armor",
  magicRes: "M-Res",
  dodgeRate: "Dodge",
  hitBonus: "Hit",
  critRate: "Crit%",
  critRes: "Crit Res",
  critDmgBonus: "Crit DMG",
  critDmgRed: "Crit DMG Red",
  energy: "Energy",
  cooldownHaste: "CD Haste",
  atkSpdBonus: "ATK Spd",
  pDmgBonus: "P-DMG+",
  pDmgRed: "P-DMG Red",
  mDmgBonus: "M-DMG+",
  mDmgRed: "M-DMG Red",
  healEff: "Heal Eff",
  rechargeEff: "Recharge",
  lifestealEff: "Lifesteal",
  reflectEff: "Reflect",
  effectRes: "Effect Res",
  effectHit: "Effect Hit",
  controlRes: "Control Res",
  controlBonus: "Control+",
  normalSkillPWR: "Skill PWR",
  ultimatePWR: "Ult PWR",
};

/* Percent-type stats (displayed with %) */
const PCT_STATS = new Set([
  "dodgeRate","hitBonus","critRate","critRes","critDmgBonus","critDmgRed",
  "cooldownHaste","atkSpdBonus",
  "pDmgBonus","pDmgRed","mDmgBonus","mDmgRed",
  "healEff","rechargeEff","lifestealEff","reflectEff",
  "effectRes","effectHit","controlRes","controlBonus",
  "normalSkillPWR","ultimatePWR",
]);

/* Build rows at build time */
const rows = [...heroes]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((hero) => {
    const s = hero.stats ?? {};
    const raw: Record<string, number> = {};
    const withBonus: Record<string, number> = {};
    for (const key of STAT_KEYS) {
      const base = (s as any)[key] ?? 0;
      raw[key] = base;
      withBonus[key] = base + (bonusStats[key] ?? 0);
    }
    return { hero, raw, withBonus };
  });

/* Format helpers (used in data attributes as JSON) */
function fmtVal(val: number, key: string): string {
  if (PCT_STATS.has(key)) return val % 1 === 0 ? `${val}%` : `${val.toFixed(1)}%`;
  if (val >= 1_000_000) return `${(val / 1_000_000).toFixed(2)}M`;
  if (val >= 1_000) return `${(val / 1_000).toFixed(1)}K`;
  return val % 1 === 0 ? String(val) : val.toFixed(1);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hero Stats - Hero Database</title>
  </head>

  <body>
    <Sidebar />

    <div class="page-wrapper">
      <h1 class="title">Hero Stats</h1>
      {pageUpdate && <p class="page-updated">Last updated: {pageUpdate.formatted} (v{pageUpdate.version})</p>}
      <p class="subtitle">All heroes with their full stat breakdown. Toggle account bonuses to see adjusted values.</p>

      <div class="content-wrapper">

        <!-- Bonus Toggle -->
        <div class="bonus-toggle-wrapper">
          <label class="toggle-label" for="bonusToggle">
            <span class="toggle-text">Use Bonus</span>
            <div class="toggle-switch">
              <input type="checkbox" id="bonusToggle" />
              <span class="toggle-slider"></span>
            </div>
          </label>
          <span class="bonus-info">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span class="bonus-tooltip">Account bonus derived from the difference between a reference account (Hladgunnr with full account buffs) and Hladgunnr base stats. This bonus is then applied equally to every hero.</span>
          </span>
        </div>

        <p id="heroCounter" class="hero-counter">0 Heroes shown</p>

        <div class="table-wrapper">

          <!-- STICKY HEADER -->
          <div class="table-scroll">
            <div class="table-header-sticky" id="tableHeaderSticky">
              <table class="stats-table stats-table--header" id="headerTable">
              <thead>
                <tr>
                  <th class="sortable col-rank sticky-col" data-sort="rank">
                    # <span class="sort-indicator"></span>
                  </th>
                  <th class="sortable col-hero sticky-col sticky-col-hero" data-sort="name">
                    Hero <span class="sort-indicator"></span>
                  </th>
                  <th class="sortable col-meta" data-sort="class">
                    Class <span class="sort-indicator"></span>
                  </th>
                  <th class="sortable col-meta" data-sort="faction">
                    Faction <span class="sort-indicator"></span>
                  </th>
                  {STAT_KEYS.map((key) => (
                    <th class="sortable col-stat" data-sort={key} title={STAT_LABELS[key]}>
                      {STAT_LABELS[key]} <span class="sort-indicator"></span>
                    </th>
                  ))}
                </tr>
              </thead>
            </table>
          </div>

          <!-- SCROLLABLE BODY -->
          <div class="table-scroll" id="tableScroll">
            <table class="stats-table stats-table--body" id="statsTable">
              <tbody id="statsTableBody">
                {rows.map((r, idx) => (
                    <tr
                      class="hero-row"
                      data-id={r.hero.id}
                      data-rank={String(idx + 1)}
                      data-name={r.hero.name.toLowerCase()}
                      data-class={r.hero.class.toLowerCase()}
                      data-faction={r.hero.faction.toLowerCase()}
                      data-rarity={r.hero.rarity.toLowerCase()}
                      data-raw={JSON.stringify(r.raw)}
                      data-bonus={JSON.stringify(r.withBonus)}
                    >
                      <td class="rank-cell col-rank sticky-col">{idx + 1}</td>
                      <td class="hero-cell col-hero sticky-col sticky-col-hero">
                        <a href={`/heroes/${r.hero.id}`} class="hero-link">
                          <img src={r.hero.image} alt={r.hero.name} class="hero-avatar" width="40" height="40" />
                          <span class="hero-name">{r.hero.name}</span>
                        </a>
                      </td>
                      <td class="meta-cell col-meta">
                        <img class="meta-icon" src={`/icons/classes/${r.hero.class.toLowerCase()}.webp`} title={r.hero.class} />
                      </td>
                      <td class="meta-cell col-meta">
                        <img class="meta-icon" src={`/icons/factions/${r.hero.faction.toLowerCase()}.webp`} title={r.hero.faction} />
                      </td>
                      {STAT_KEYS.map((key) => (
                        <td class="stat-cell col-stat" data-stat={key}>
                          {fmtVal(r.raw[key], key)}
                        </td>
                      ))}
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>

        </div>
      </div>

      <Footer />
    </div>

    <style>
      html, body {
        margin: 0;
        padding: 0;
        font-family: "Spectral", "Roboto", system-ui, sans-serif;
        background:
          radial-gradient(ellipse at 30% -10%, rgba(120,90,200,0.15), transparent 60%),
          radial-gradient(ellipse at 80% 20%, rgba(255,215,100,0.08), transparent 55%),
          linear-gradient(to bottom, #0d0b10, #07060c);
        color: #e6e6eb;
      }

      .page-wrapper {
        margin-left: 64px;
      }

      .title {
        text-align: center;
        margin: 32px 0 10px;
        font-weight: 600;
        font-size: 2.5rem;
      }

      .subtitle {
        margin: 0 0 18px;
        text-align: center;
        opacity: 0.85;
        font-size: 1rem;
      }

      .content-wrapper {
        max-width: 1800px;
        margin: 0 auto;
        padding: 0 16px 48px;
      }

      .hero-counter {
        margin: 0 0 10px;
        text-align: center;
        font-size: 1.125rem;
      }

      /* ── BONUS TOGGLE ──────────────────────────────── */
      .bonus-toggle-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 16px;
      }

      .toggle-label {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        user-select: none;
      }

      .toggle-text {
        font-weight: 600;
        font-size: 1rem;
      }

      .toggle-switch {
        position: relative;
        width: 48px;
        height: 26px;
      }

      .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }

      .toggle-slider {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.12);
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.2);
        transition: background 0.25s, border-color 0.25s;
      }

      .toggle-slider::before {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        left: 3px;
        top: 50%;
        transform: translateY(-50%);
        border-radius: 50%;
        background: #e6e6eb;
        transition: transform 0.25s;
      }

      .toggle-switch input:checked + .toggle-slider {
        background: rgba(250, 204, 21, 0.35);
        border-color: rgba(250, 204, 21, 0.6);
      }

      .toggle-switch input:checked + .toggle-slider::before {
        transform: translateY(-50%) translateX(22px);
        background: #facc15;
      }

      .bonus-info {
        position: relative;
        opacity: 0.5;
        cursor: help;
      }
      .bonus-info:hover { opacity: 0.8; }

      .bonus-tooltip {
        display: none;
        position: absolute;
        bottom: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%);
        width: 300px;
        padding: 12px 14px;
        background: rgba(30, 25, 50, 0.95);
        border: 1px solid rgba(250, 204, 21, 0.3);
        border-radius: 8px;
        color: #e6e6eb;
        font-size: 0.85rem;
        line-height: 1.5;
        text-align: left;
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
        z-index: 100;
        pointer-events: none;
      }

      .bonus-tooltip::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border: 6px solid transparent;
        border-top-color: rgba(250, 204, 21, 0.3);
      }

      .bonus-info:hover .bonus-tooltip {
        display: block;
      }

      /* ── TABLE ──────────────────────────────────────── */
      .table-wrapper {
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        overflow: visible;
        position: relative;
      }

      .table-header-sticky {
        position: sticky;
        top: 0;
        z-index: 20;
        overflow-x: hidden;
        background: #1a1720;
      }

      .table-scroll {
        overflow-x: auto;
      }

      .stats-table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
      }

      .col-rank  { min-width: 50px; width: 50px; text-align: center; }
      .col-hero  { min-width: 180px; width: 180px; text-align: left; }
      .col-meta  { min-width: 60px; width: 60px; text-align: center; }
      .col-stat  { min-width: 90px; width: 90px; text-align: right; }

      /* Sticky first two columns */
      .sticky-col {
        position: sticky;
        z-index: 10;
        background: inherit;
      }
      .sticky-col:first-child,
      td.sticky-col:first-child {
        left: 0;
      }
      .sticky-col-hero {
        left: 50px;
      }
      th.sticky-col {
        background: #1a1720;
      }
      td.sticky-col {
        background: #100e14;
      }
      .hero-row:hover td.sticky-col {
        background: rgba(30, 27, 38, 1);
      }

      .stats-table--header thead th {
        background: #1a1720;
        padding: 14px 10px;
        text-align: left;
        font-weight: 600;
        font-size: 0.82rem;
        border-bottom: 2px solid rgba(255, 255, 255, 0.15);
        white-space: nowrap;
      }

      .stats-table--header thead th.col-stat {
        text-align: right;
      }

      .stats-table--header thead th.col-rank,
      .stats-table--header thead th.col-meta {
        text-align: center;
      }

      .stats-table--header thead th.sortable {
        cursor: pointer;
        user-select: none;
        transition: background 0.2s ease;
      }
      .stats-table--header thead th.sortable:hover {
        background: rgba(255, 255, 255, 0.05);
      }

      .stats-table--body {
        background: rgba(0, 0, 0, 0.2);
      }

      .sort-indicator {
        display: inline-block;
        margin-left: 8px;
        opacity: 0.3;
      }
      .sort-indicator::after { content: "\21C5"; }
      th.sort-asc .sort-indicator { opacity: 1; color: #facc15; }
      th.sort-asc .sort-indicator::after { content: "\2191"; }
      th.sort-desc .sort-indicator { opacity: 1; color: #facc15; }
      th.sort-desc .sort-indicator::after { content: "\2193"; }

      .hero-row {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: background 0.2s ease;
      }
      .hero-row:hover {
        background: rgba(255, 255, 255, 0.03);
      }

      .rank-cell {
        padding: 10px;
        text-align: center;
        font-weight: 700;
        opacity: 0.9;
      }

      .hero-cell { padding: 10px; }
      .meta-cell { padding: 10px; text-align: center; }
      .stat-cell {
        padding: 10px;
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        font-size: 0.9rem;
      }

      .hero-link {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: inherit;
        transition: color 0.2s ease;
      }
      .hero-link:hover { color: #facc15; }

      .hero-avatar {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        object-fit: cover;
        object-position: center 20%;
        border: 2px solid rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
        flex-shrink: 0;
      }

      .hero-name {
        font-weight: 500;
        font-size: 0.92rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .meta-icon {
        width: 22px;
        height: 22px;
      }

      /* RARITY BORDERS */
      [data-rarity="common"] .hero-avatar    { border-color: rgba(74, 222, 128, 0.55); }
      [data-rarity="epic"] .hero-avatar      { border-color: rgba(168, 85, 247, 0.6); }
      [data-rarity="legendary"] .hero-avatar { border-color: rgba(250, 204, 21, 0.75); }

      .hero-row:hover .hero-avatar { box-shadow: 0 0 16px currentColor; transform: scale(1.05); }
      [data-rarity="common"]:hover .hero-avatar    { box-shadow: 0 0 16px rgba(74, 222, 128, 0.6); }
      [data-rarity="epic"]:hover .hero-avatar      { box-shadow: 0 0 16px rgba(168, 85, 247, 0.6); }
      [data-rarity="legendary"]:hover .hero-avatar { box-shadow: 0 0 20px rgba(250, 204, 21, 0.8); }

      /* Stat highlight on bonus active */
      .stat-cell.has-bonus {
        color: #facc15;
      }

      /* RESPONSIVE */
      @media (max-width: 768px) {
        .page-wrapper { margin-left: 0; margin-bottom: 56px; }
        .title { font-size: 1.75rem; }
        .col-hero { min-width: 140px; width: 140px; }
        .col-stat { min-width: 75px; width: 75px; }
        .hero-avatar { width: 32px; height: 32px; }
        .stats-table--header thead th { padding: 10px 6px; font-size: 0.75rem; }
        .stat-cell { padding: 8px 6px; font-size: 0.8rem; }
        .sticky-col-hero { left: 50px; }
      }
    </style>

    <script define:vars={{ STAT_KEYS, PCT_STATS: [...PCT_STATS] }}>
      document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.getElementById("bonusToggle");
        const tableBody = document.getElementById("statsTableBody");
        const heroCounter = document.getElementById("heroCounter");
        const headerScroll = document.getElementById("tableHeaderSticky");
        const bodyScroll = document.getElementById("tableScroll");
        const sortableHeaders = document.querySelectorAll(".sortable");

        const pctSet = new Set(PCT_STATS);

        /* Sync horizontal scroll */
        bodyScroll?.addEventListener("scroll", () => {
          if (headerScroll) headerScroll.scrollLeft = bodyScroll.scrollLeft;
        });

        let bonusOn = false;
        let currentSort = { column: "name", direction: "asc" };

        function fmtVal(val, key) {
          if (pctSet.has(key)) return val % 1 === 0 ? val + "%" : val.toFixed(1) + "%";
          if (val >= 1000000) return (val / 1000000).toFixed(2) + "M";
          if (val >= 1000) return (val / 1000).toFixed(1) + "K";
          return val % 1 === 0 ? String(val) : val.toFixed(1);
        }

        /* Parse JSON data once per row, cache it */
        function getRowData(row) {
          if (!row._parsedRaw) {
            row._parsedRaw = JSON.parse(row.getAttribute("data-raw") || "{}");
            row._parsedBonus = JSON.parse(row.getAttribute("data-bonus") || "{}");
          }
          return { raw: row._parsedRaw, bonus: row._parsedBonus };
        }

        function updateCells() {
          const rows = tableBody.querySelectorAll(".hero-row");
          rows.forEach((row) => {
            const d = getRowData(row);
            const cells = row.querySelectorAll("td.stat-cell");
            cells.forEach((cell) => {
              const key = cell.getAttribute("data-stat");
              const val = bonusOn ? (d.bonus[key] ?? 0) : (d.raw[key] ?? 0);
              cell.textContent = fmtVal(val, key);
              cell.classList.toggle("has-bonus", bonusOn && (d.bonus[key] ?? 0) !== (d.raw[key] ?? 0));
            });
          });
        }

        function updateCounter() {
          const rows = tableBody.querySelectorAll(".hero-row");
          const count = rows.length;
          heroCounter.textContent = count === 1 ? "1 Hero shown" : count + " Heroes shown";
        }

        function getSortValue(row, column) {
          if (column === "name") return row.dataset.name || "";
          if (column === "class") return row.dataset.class || "";
          if (column === "faction") return row.dataset.faction || "";
          if (column === "rank") return parseInt(row.dataset.rank, 10) || 0;

          /* Stat columns - read from parsed JSON cache */
          const d = getRowData(row);
          const src = bonusOn ? d.bonus : d.raw;
          return src[column] ?? 0;
        }

        function sortTable(column) {
          const rows = Array.from(tableBody.querySelectorAll(".hero-row"));

          if (currentSort.column === column) {
            currentSort.direction = currentSort.direction === "asc" ? "desc" : "asc";
          } else {
            currentSort.column = column;
            /* Text columns default asc, number columns default desc */
            currentSort.direction = (column === "name" || column === "class" || column === "faction") ? "asc" : "desc";
          }

          const isText = column === "name" || column === "class" || column === "faction";

          rows.sort((a, b) => {
            const aVal = getSortValue(a, column);
            const bVal = getSortValue(b, column);
            let cmp;
            if (isText) {
              cmp = String(aVal).localeCompare(String(bVal));
            } else {
              cmp = aVal - bVal;
            }
            return currentSort.direction === "asc" ? cmp : -cmp;
          });

          rows.forEach((row, idx) => {
            tableBody.appendChild(row);
            row.querySelector(".rank-cell").textContent = String(idx + 1);
          });

          sortableHeaders.forEach((th) => {
            th.classList.remove("sort-asc", "sort-desc");
            if (th.getAttribute("data-sort") === column) {
              th.classList.add(currentSort.direction === "asc" ? "sort-asc" : "sort-desc");
            }
          });
        }

        /* Sort handlers */
        sortableHeaders.forEach((th) => {
          th.addEventListener("click", () => {
            const col = th.getAttribute("data-sort");
            if (col) sortTable(col);
          });
        });

        /* Toggle handler */
        toggle?.addEventListener("change", () => {
          bonusOn = toggle.checked;
          updateCells();
          /* Re-sort with current column to respect new values */
          if (STAT_KEYS.includes(currentSort.column)) {
            const dir = currentSort.direction;
            /* Force re-sort in same direction */
            currentSort.direction = dir === "asc" ? "desc" : "asc";
            sortTable(currentSort.column);
          }
        });

        /* Initial state */
        updateCounter();
        sortTable("name");
      });
    </script>
  </body>
</html>
