---
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import allHeroesData from '../data/all_heroes_db.json';
---

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Heroes - Hero Database</title>
    <style is:global>
        body {
            font-family: "Spectral", "Roboto", system-ui, sans-serif;
            background:
                radial-gradient(ellipse at 30% -10%, rgba(120,90,200,0.15), transparent 60%),
                radial-gradient(ellipse at 80% 20%, rgba(255,215,100,0.08), transparent 55%),
                linear-gradient(to bottom, #0d0b10, #07060c);
            color: #e6e6eb;
            margin-left: 80px;
            min-height: 100vh;
        }

        @media (max-width: 768px) {
            body {
                margin-left: 0;
                margin-bottom: 60px;
            }
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        h1 {
            color: #e6e6eb;
            margin-bottom: 30px;
            font-size: 32px;
            text-align: center;
            font-weight: 600;
        }

        h2 {
            color: #e6e6eb;
            margin-top: 40px;
            margin-bottom: 20px;
            font-size: 24px;
            border-bottom: 2px solid rgba(250, 204, 21, 0.4);
            padding-bottom: 10px;
            font-weight: 500;
        }

        .auth-warning {
            background: rgba(255, 193, 7, 0.1);
            border: 1px solid rgba(255, 193, 7, 0.3);
            color: #ffc107;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            text-align: center;
        }

        .auth-warning a {
            color: #facc15;
            font-weight: bold;
            text-decoration: none;
        }

        .faction-section {
            margin-bottom: 40px;
        }

        .faction-title {
            color: #facc15;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            padding-left: 10px;
            border-left: 4px solid #facc15;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .faction-icon {
            width: 28px;
            height: 28px;
            object-fit: contain;
            filter: drop-shadow(0 0 6px rgba(250, 204, 21, 0.3));
        }

        .heroes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 120px));
            gap: 15px;
            margin-bottom: 20px;
        }

        .hero-card {
            position: relative;
            cursor: pointer;
            border-radius: 8px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(168, 85, 247, 0.3);
            transition: all 0.3s ease;
            width: 120px;
            height: 120px;
            max-width: 120px;
            max-height: 120px;
            background-size: cover;
            background-position: var(--hero-bg-position, 50% 10%);
            opacity: 0.5;
        }

        .hero-card::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: rgba(250, 204, 21, 0.2);
            border-radius: 8px;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: -1;
        }

        .hero-card:hover {
            transform: translateY(-4px);
            border-color: rgba(250, 204, 21, 0.6);
            box-shadow: 0 8px 24px rgba(168, 85, 247, 0.3);
        }

        .hero-card:hover::before {
            opacity: 0.2;
        }

        .hero-card.selected {
            border: 2px solid #facc15;
            box-shadow: 0 0 15px rgba(250, 204, 21, 0.4);
            opacity: 1;
        }

        .hero-image {
            display: none;
        }

        .hero-info {
            padding: 6px;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.9));
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            gap: 4px;
        }

        .hero-name {
            font-weight: 600;
            color: #e6e6eb;
            font-size: 10px;
            text-align: center;
        }

        .hero-evolution {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 4px;
            padding: 3px 6px;
            font-size: 9px;
            min-width: 80px;
            color: #facc15;
            font-weight: 600;
        }

        .hero-evolution.hidden {
            display: none;
        }

        .evo-btn {
            cursor: pointer;
            color: #facc15;
            font-size: 12px;
            line-height: 1;
            padding: 0 2px;
            user-select: none;
            transition: transform 0.1s;
        }

        .evo-btn:hover {
            transform: scale(1.3);
        }

        .evo-number {
            min-width: 50px;
            white-space: nowrap;
            text-align: center;
        }

        .empty-message {
            text-align: center;
            color: #999;
            padding: 40px;
            font-size: 18px;
        }

        .loading {
            text-align: center;
            padding: 40px;
            font-size: 18px;
            color: #facc15;
        }

        .error-message {
            background: rgba(220, 53, 69, 0.1);
            border: 1px solid rgba(220, 53, 69, 0.3);
            color: #ff6b6b;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .share-section {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
            margin-top: -10px;
        }

        .share-btn {
            background: linear-gradient(135deg, rgba(250, 204, 21, 0.2), rgba(168, 85, 247, 0.2));
            border: 1px solid rgba(250, 204, 21, 0.5);
            color: #facc15;
            padding: 10px 20px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: none;
        }

        .share-btn:hover {
            background: linear-gradient(135deg, rgba(250, 204, 21, 0.3), rgba(168, 85, 247, 0.3));
            box-shadow: 0 0 12px rgba(250, 204, 21, 0.4);
            transform: translateY(-2px);
        }

        .share-link-input {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(250, 204, 21, 0.3);
            color: #e6e6eb;
            padding: 10px 15px;
            border-radius: 6px;
            font-size: 14px;
            font-family: monospace;
            min-width: 300px;
            display: none;
        }

        .copy-btn {
            background: rgba(250, 204, 21, 0.3);
            border: 1px solid rgba(250, 204, 21, 0.5);
            color: #facc15;
            padding: 10px 15px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: none;
            white-space: nowrap;
        }

        .copy-btn:hover {
            background: rgba(250, 204, 21, 0.5);
            box-shadow: 0 0 8px rgba(250, 204, 21, 0.3);
        }

        .share-feedback {
            color: #4ade80;
            font-size: 14px;
            display: none;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <Sidebar />

    <div class="container">
        <h1>My Heroes</h1>

        <div class="share-section">
            <button id="shareBtn" class="share-btn">Share Setup</button>
            <input id="shareLink" class="share-link-input" type="text" readonly />
            <button id="copyBtn" class="copy-btn">Copy Link</button>
            <span id="shareFeedback" class="share-feedback">✓ Copied!</span>
        </div>

        <div id="authWarning" class="auth-warning" style="display: none;">
            You are not logged in. <a href="/login">Sign in</a> to save your heroes.
        </div>

        <div id="errorMessage" class="error-message" style="display: none;"></div>

        <h2>All Heroes</h2>
        <div id="loadingMessage" class="loading">Loading heroes...</div>
        <div id="heroesContainer"></div>
    </div>

    <script define:vars={{ allHeroes: allHeroesData }}>
        let authToken = localStorage.getItem('authToken');
        let userHeroes = [];
        const API_BASE = 'http://localhost:3001';
        
        // allHeroes ist ein Objekt mit Hero-IDs als Keys, konvertiere zu Array
        const allHeroesList = Object.values(allHeroes);

        // Evolution Levels Mapping (1-15)
        const EVOLUTION_LEVELS = {
            1: 'Elite',
            2: 'Elite+',
            3: 'Epic',
            4: 'Epic+',
            5: 'Legendary',
            6: 'Legendary+',
            7: 'Exalted',
            8: 'Exalted+',
            9: 'Mythic',
            10: 'Divine',
            11: 'Divine I',
            12: 'Divine II',
            13: 'Divine III',
            14: 'Divine IV',
            15: 'Divine V'
        };

        // Hero portrait framing (adjust per hero if head is cut off)
        // Format: heroId: 'x% y%'
        const HERO_BG_POSITION_OVERRIDES = {
            // Example:
            // zeus: '50% 10%',
            // anubis: '50% 8%'
            canopicjar: '50% 50%',
            treant: '50% 50%',
            wenshen: '50% 30%',
            ratatoskr: '50% 50%',
            kraken: '50% 50%',
            jinchan: '50% 50%',
        };

        const HERO_BG_DEFAULT_POSITION = '50% 30%';
        const HERO_BG_GLOBAL_Y_ADJUST = -10;

        function getAdjustedHeroBgPosition(heroId) {
            const raw = HERO_BG_POSITION_OVERRIDES[heroId] || HERO_BG_DEFAULT_POSITION;
            const match = raw.match(/^\s*([\d.]+)%\s+([\d.]+)%\s*$/);

            if (!match) {
                return HERO_BG_DEFAULT_POSITION;
            }

            const x = Number(match[1]);
            const y = Number(match[2]);
            const adjustedY = Math.max(0, Math.min(100, y + HERO_BG_GLOBAL_Y_ADJUST));

            return `${x}% ${adjustedY}%`;
        }

        // Auth-Check
        function checkAuth() {
            if (!authToken) {
                document.getElementById('authWarning').style.display = 'block';
                document.getElementById('heroesContainer').innerHTML = '<div class="empty-message">Please log in to use this feature.</div>';
                document.getElementById('shareBtn').style.display = 'none';
                return false;
            }

            document.getElementById('shareBtn').style.display = 'inline-block';
            return true;
        }

        // Heroes von API laden
        async function loadUserHeroes() {
            if (!authToken) return;

            try {
                const response = await fetch(`${API_BASE}/api/user/heroes`, {
                    headers: {
                        'Authorization': `Bearer ${authToken}`
                    }
                });

                if (!response.ok) {
                    if (response.status === 401) {
                        localStorage.removeItem('authToken');
                        location.href = '/login';
                        return;
                    }
                    throw new Error('Fehler beim Laden der Heroes');
                }

                userHeroes = await response.json();
                
                // Normalize evolution values and migrate old string values in database
                const migratePromises = [];
                userHeroes.forEach(hero => {
                    const oldEvolution = hero.evolution;
                    
                    if (typeof hero.evolution === 'string') {
                        hero.evolution = 1; // Default string values to 1
                    }
                    hero.evolution = Math.max(1, Math.min(15, parseInt(hero.evolution) || 1));
                    
                    // If we had to normalize, update the database
                    if (oldEvolution !== hero.evolution && typeof oldEvolution === 'string') {
                        migratePromises.push(
                            fetch(`${API_BASE}/api/user/heroes/${hero.hero_id}`, {
                                method: 'PATCH',
                                headers: {
                                    'Authorization': `Bearer ${authToken}`,
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ evolution: hero.evolution })
                            }).catch(err => console.error('Migration error:', err))
                        );
                    }
                });
                
                // Wait for all migrations to complete
                if (migratePromises.length > 0) {
                    await Promise.all(migratePromises);
                }
                
                renderHeroes();
            } catch (error) {
                console.error('Error loading heroes:', error);
                document.getElementById('errorMessage').textContent = 'Fehler beim Laden der Helden: ' + error.message;
                document.getElementById('errorMessage').style.display = 'block';
            }
        }

        // Heroes rendern (gruppiert nach Faction)
        function renderHeroes() {
            const container = document.getElementById('heroesContainer');
            container.innerHTML = '';

            // Alle Heroes nach Faction gruppieren
            const factionMap = {};
            allHeroesList.forEach(hero => {
                if (!factionMap[hero.faction]) {
                    factionMap[hero.faction] = [];
                }
                factionMap[hero.faction].push(hero);
            });

            // Alle Heroes nach Faction anzeigen
            Object.keys(factionMap).sort().forEach(faction => {
                const section = document.createElement('div');
                section.className = 'faction-section';

                const title = document.createElement('div');
                title.className = 'faction-title';
                
                const icon = document.createElement('img');
                icon.className = 'faction-icon';
                icon.src = `/icons/factions/${faction.toLowerCase()}.webp`;
                icon.alt = faction;
                title.appendChild(icon);
                
                const factionName = document.createElement('span');
                factionName.textContent = faction;
                title.appendChild(factionName);
                
                section.appendChild(title);

                const grid = document.createElement('div');
                grid.className = 'heroes-grid';

                factionMap[faction].forEach(hero => {
                    const userHero = userHeroes.find(h => h.hero_id === hero.id);
                    grid.appendChild(createHeroCard(hero, userHero));
                });

                section.appendChild(grid);
                container.appendChild(section);
            });

            document.getElementById('loadingMessage').style.display = 'none';
        }

        // Hero-Card Element erstellen
        function createHeroCard(hero, userHeroData) {
            const card = document.createElement('div');
            card.className = 'hero-card';
            if (userHeroData) {
                card.classList.add('selected');
            }
            card.dataset.heroId = hero.id;
            
            // Bild als Background
            card.style.backgroundImage = `url('${hero.image || '/heroes/default.webp'}')`;
            card.style.setProperty(
                '--hero-bg-position',
                getAdjustedHeroBgPosition(hero.id)
            );

            const info = document.createElement('div');
            info.className = 'hero-info';

            const name = document.createElement('div');
            name.className = 'hero-name';
            name.textContent = hero.name;

            // Evolution Counter (nur bei selektierten Helden)
            const evolutionDiv = document.createElement('div');
            evolutionDiv.className = 'hero-evolution';
            if (!userHeroData) {
                evolutionDiv.classList.add('hidden');
            }
            
            // Normalize evolution to number (handle old string values like 'Common')
            let currentEvolution = userHeroData?.evolution || 1;
            if (typeof currentEvolution === 'string') {
                currentEvolution = 1; // Default old string values to 1
            }
            currentEvolution = Math.max(1, Math.min(15, parseInt(currentEvolution) || 1));
            
            const decrementBtn = document.createElement('span');
            decrementBtn.className = 'evo-btn';
            decrementBtn.textContent = '◀';
            decrementBtn.title = 'Evolution verringern';
            
            const evoNumber = document.createElement('span');
            evoNumber.className = 'evo-number';
            evoNumber.textContent = EVOLUTION_LEVELS[currentEvolution];
            evoNumber.dataset.level = currentEvolution;
            evoNumber.title = `Level ${currentEvolution}: ${EVOLUTION_LEVELS[currentEvolution]}`;
            
            const incrementBtn = document.createElement('span');
            incrementBtn.className = 'evo-btn';
            incrementBtn.textContent = '▶';
            incrementBtn.title = 'Evolution erhöhen';
            
            evolutionDiv.appendChild(decrementBtn);
            evolutionDiv.appendChild(evoNumber);
            evolutionDiv.appendChild(incrementBtn);

            info.appendChild(name);
            info.appendChild(evolutionDiv);

            card.appendChild(info);

            // Evolution Update Handlers
            decrementBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const current = parseInt(evoNumber.dataset.level) || 1;
                const newEvo = Math.max(1, current - 1);
                if (newEvo !== current) {
                    updateEvolution(hero.id, newEvo, evoNumber, userHeroData);
                }
            });

            incrementBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const current = parseInt(evoNumber.dataset.level) || 1;
                const newEvo = Math.min(15, current + 1);
                if (newEvo !== current) {
                    updateEvolution(hero.id, newEvo, evoNumber, userHeroData);
                }
            });

            // Click Handler
            card.addEventListener('click', (e) => {
                e.preventDefault();
                toggleHero(hero.id, card, evolutionDiv);
            });

            return card;
        }

        // Hero hinzufügen/entfernen
        async function toggleHero(heroId, card, evolutionDiv) {
            if (!authToken) return;

            const userHero = userHeroes.find(h => h.hero_id === heroId);

            try {
                if (userHero) {
                    // Entfernen
                    const response = await fetch(`${API_BASE}/api/user/heroes/${heroId}`, {
                        method: 'DELETE',
                        headers: {
                            'Authorization': `Bearer ${authToken}`
                        }
                    });

                    if (response.ok) {
                        userHeroes = userHeroes.filter(h => h.hero_id !== heroId);
                        card.classList.remove('selected');
                        if (evolutionDiv) evolutionDiv.classList.add('hidden');
                    }
                } else {
                    // Hinzufügen
                    const response = await fetch(`${API_BASE}/api/user/heroes`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${authToken}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ heroId })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        userHeroes.push(data.hero);
                        card.classList.add('selected');
                        if (evolutionDiv) evolutionDiv.classList.remove('hidden');
                    }
                }
            } catch (error) {
                console.error('Error toggling hero:', error);
                alert('Fehler: ' + error.message);
            }
        }

        // Evolution aktualisieren
        async function updateEvolution(heroId, newEvolution, evoNumberElement, userHeroData) {
            if (!authToken || !userHeroData) return;

            try {
                const response = await fetch(`${API_BASE}/api/user/heroes/${heroId}`, {
                    method: 'PATCH',
                    headers: {
                        'Authorization': `Bearer ${authToken}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ evolution: newEvolution })
                });

                if (response.ok) {
                    const data = await response.json();
                    userHeroData.evolution = data.hero.evolution;
                    evoNumberElement.textContent = EVOLUTION_LEVELS[data.hero.evolution];
                    evoNumberElement.dataset.level = data.hero.evolution;
                    evoNumberElement.title = `Level ${data.hero.evolution}: ${EVOLUTION_LEVELS[data.hero.evolution]}`;
                }
            } catch (error) {
                console.error('Error updating evolution:', error);
            }
        }

        // Share functionality
        async function shareSetup() {
            if (!authToken) {
                alert('Please log in to share');
                return;
            }

            const shareBtn = document.getElementById('shareBtn');
            const originalText = shareBtn.textContent;
            shareBtn.textContent = 'Creating share link...';
            shareBtn.disabled = true;

            try {
                const response = await fetch(`${API_BASE}/api/user/heroes/share`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${authToken}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Failed to create share link');
                }

                const data = await response.json();
                const shareLink = document.getElementById('shareLink');
                const copyBtn = document.getElementById('copyBtn');
                
                shareLink.value = data.shareUrl;
                shareLink.style.display = 'inline-block';
                copyBtn.style.display = 'inline-block';
                shareBtn.style.display = 'none';
            } catch (error) {
                console.error('Share error:', error);
                alert('Error: ' + error.message);
            } finally {
                shareBtn.textContent = originalText;
                shareBtn.disabled = false;
            }
        }

        function copyShareLink() {
            const shareLink = document.getElementById('shareLink');
            shareLink.select();
            document.execCommand('copy');
            
            const feedback = document.getElementById('shareFeedback');
            feedback.style.display = 'inline-block';
            setTimeout(() => {
                feedback.style.display = 'none';
            }, 2000);
        }

        // Add event listeners
        document.getElementById('shareBtn')?.addEventListener('click', shareSetup);
        document.getElementById('copyBtn')?.addEventListener('click', copyShareLink);

        // Debug helper - test API connectivity
        window.testAPI = async function() {
            console.log('Testing API connectivity...');
            try {
                const healthRes = await fetch(`${API_BASE}/health`);
                console.log('Health check:', await healthRes.json());
                
                const pingRes = await fetch(`${API_BASE}/api/debug/ping`, { method: 'POST' });
                console.log('Debug ping:', await pingRes.json());
                
                return true;
            } catch (err) {
                console.error('API test failed:', err);
                return false;
            }
        };
        if (checkAuth()) {
            loadUserHeroes();
        }
    </script>

    <Footer />
</body>
</html>
