---
export const prerender = true;
import GameLayout from "../../../layouts/GameLayout.astro";
import heroes from "../../../data/gameBalance.json";
import { skinHeroes } from "../../../game/td/skin.js";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const assetBase = import.meta.env.DEV ? "/r2" : R2_BASE;
const roster = skinHeroes(heroes, assetBase) as any[];
const byName = new Map<string, any>(roster.map((hero: any) => [hero.name, hero]));

const performance = [
  { name: "Boreas", damage: "25k", share: 39, boss: "8.6k", kills: 21, support: "", note: "Winter at the Open Door" },
  { name: "Odin", damage: "20k", share: 32, boss: "7.1k", kills: 7, support: "", note: "Reader of Unfinished Roads" },
  { name: "Hephaestus", damage: "5.3k", share: 8, boss: "—", kills: 6, support: "", note: "Smith of the Refuge Gate" },
  { name: "Nott", damage: "5.2k", share: 8, boss: "877", kills: 9, support: "", note: "Rider Between Watchfires" },
  { name: "Fenrir", damage: "3.3k", share: 5, boss: "—", kills: 2, support: "", note: "The Unfastened Jaw" },
  { name: "Gaia", damage: "3.1k", share: 5, boss: "2.7k", kills: 1, support: "2.6k", note: "Ground Beneath the Refuge" },
].map((entry) => ({ ...entry, hero: byName.get(entry.name) }));

const mvp = byName.get("Boreas");
---

<GameLayout
  title="Stage Clear Redesign Review | The Last Crossing"
  description="Standalone visual review for the proposed tower defense result screen."
>
  <main class="td-shell rr-page" aria-label="Stage clear redesign review">
    <div class="rr-backdrop" aria-hidden="true">
      <img src="/td/maps/moonlit-terrain-v1.png" alt="" />
    </div>

    <section class="rr-result" data-review-current="rewards" aria-labelledby="rr-title" aria-live="polite">
      <header class="rr-hero" data-sequence-view="victory">
        <div class="rr-outcome">
          <div class="rr-kicker"><span class="rr-kicker-mark">✦</span> Victory</div>
          <h1 id="rr-title">Moonlit Pass secured</h1>
          <p class="rr-context">Normal difficulty</p>

          <div class="rr-score-row">
            <div class="rr-score">
              <span>Final score</span>
              <strong>62,165</strong>
              <small>New personal best</small>
            </div>
            <div class="rr-outcome-facts" aria-label="Run outcome">
              <div><strong>14</strong><span>Lives left</span></div>
              <div><strong>12</strong><span>Leaks</span></div>
              <div><strong>4m 7s</strong><span>Duration</span></div>
            </div>
          </div>

          <div class="rr-victory-marks" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
        </div>

        <div class="rr-mvp" aria-label="Most valuable hero: Boreas">
          <div class="rr-mvp-glow" aria-hidden="true"></div>
          {mvp && <img src={mvp.portrait} alt="Boreas" />}
          <div class="rr-mvp-copy">
            <span>MVP</span>
            <strong>Boreas</strong>
            <small>25k damage · 21 kills</small>
          </div>
        </div>
      </header>

      <div class="rr-content">
        <section class="rr-panel rr-summary" data-sequence-view="rewards" aria-labelledby="rr-rewards-title">
          <div class="rr-section-head">
            <div>
              <span class="td-label">Victory · Moonlit Pass</span>
              <h2 id="rr-rewards-title">Rewards received</h2>
            </div>
            <span class="rr-earned">Clear reward</span>
          </div>

          <div class="rr-rewards">
            <div class="rr-reward rr-reward--favor">
              <span class="rr-reward-icon">✦</span>
              <div><strong>+195</strong><small>Divine Favor</small></div>
            </div>
            <div class="rr-reward">
              <img src="/td/icons/items/gold-v1.webp" alt="" />
              <div><strong>+315</strong><small>Hero Gold</small></div>
            </div>
            <div class="rr-reward">
              <img src="/td/icons/items/hero-xp-v1.webp" alt="" />
              <div><strong>+160</strong><small>Hero XP</small></div>
            </div>
          </div>

        </section>

        <section class="rr-panel rr-performance" data-sequence-view="performance" aria-labelledby="rr-performance-title">
          <div class="rr-section-head">
            <div>
              <span class="td-label">Victory · 62,165 points</span>
              <h2 id="rr-performance-title">Hero contribution</h2>
            </div>
            <span class="rr-total">64.4k total damage</span>
          </div>

          <div class="rr-legend" aria-hidden="true"><span>Hero</span><span>Damage</span><span>Boss</span><span>Kills</span></div>
          <ol class="rr-rankings">
            {performance.map((entry, index) => (
              <li class:list={["rr-ranking", { "is-mvp": index === 0 }]}>
                <span class="rr-rank">{index + 1}</span>
                <span class="rr-avatar">{entry.hero && <img src={entry.hero.image} alt="" />}</span>
                <span class="rr-hero-name"><strong>{entry.name}</strong><small>{entry.note}</small></span>
                <span class="rr-damage">
                  <span><strong>{entry.damage}</strong><small>{entry.share}%</small></span>
                  <i style={`--rr-share:${entry.share}%`}></i>
                </span>
                <span class="rr-number"><strong>{entry.boss}</strong><small>Boss</small></span>
                <span class="rr-number"><strong>{entry.kills}</strong><small>Kills</small></span>
                {entry.support && <span class="rr-support">+{entry.support} support</span>}
              </li>
            ))}
          </ol>
        </section>
      </div>

      <footer class="rr-actions" data-sequence-final hidden>
        <div class="rr-final-actions">
          <a class="action-button action-button--quiet" href="/games/tower-defense">Back to Camp</a>
          <button class="action-button action-button--quiet" type="button">Stats</button>
          <button class="action-button action-button--quiet" type="button">Spend Favor <span>403</span></button>
          <button class="action-button action-button--primary" type="button">Retry Moonlit Pass</button>
        </div>
      </footer>
    </section>
  </main>
</GameLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-review-current]")!;
  const steps = ["rewards", "victory", "performance"];
  const finalActions = document.querySelector<HTMLElement>("[data-sequence-final]")!;
  let current = 0;
  let advanceTimer: number | undefined;

  function showStep(index: number) {
    window.clearTimeout(advanceTimer);
    current = Math.max(0, Math.min(steps.length - 1, index));
    const id = steps[current];
    root.dataset.reviewCurrent = id;
    finalActions.hidden = current !== steps.length - 1;
    if (current < steps.length - 1) {
      advanceTimer = window.setTimeout(() => showStep(current + 1), 2000);
    }
  }

  showStep(0);
</script>

<style>
  .rr-page {
    --rr-accent: var(--accent-gold);
    min-height: 100dvh;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg-base);
  }
  .rr-backdrop { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .rr-backdrop img { width: 100%; height: 100%; object-fit: cover; opacity: .3; filter: saturate(.7) blur(3px); transform: scale(1.03); }
  .rr-backdrop::after { content: ""; position: absolute; inset: 0; background:
    radial-gradient(ellipse 70% 45% at 76% 8%, color-mix(in srgb, var(--rr-accent) 15%, transparent), transparent 68%),
    linear-gradient(180deg, color-mix(in srgb, var(--bg-base) 66%, transparent), var(--bg-base) 88%); }
  .rr-result { width: min(1400px, 100%); height: min(900px, 100dvh); display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; overflow: hidden; box-sizing: border-box; background: color-mix(in srgb, var(--bg-base) 76%, transparent); backdrop-filter: blur(14px); }

  .rr-hero { position: relative; min-height: 300px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 40%); overflow: hidden; border-bottom: 1px solid color-mix(in srgb, var(--rr-accent) 24%, var(--border-subtle)); }
  .rr-hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(110deg, color-mix(in srgb, var(--bg-raised) 96%, transparent) 0 53%, color-mix(in srgb, var(--rr-accent) 10%, var(--bg-surface)) 78%, transparent); }
  .rr-outcome { align-self: center; display: grid; gap: var(--space-1); padding: var(--space-8) var(--space-10); }
  .rr-kicker { display: flex; align-items: center; gap: var(--space-2); color: var(--rr-accent); font-size: var(--td-fs-label); font-weight: var(--weight-bold); letter-spacing: var(--tracking-widest); text-transform: uppercase; }
  .rr-kicker-mark { display: grid; place-items: center; width: 24px; height: 24px; border: 1px solid color-mix(in srgb, var(--rr-accent) 55%, transparent); border-radius: var(--radius-full); background: var(--accent-gold-dim); }
  .rr-outcome h1 { margin: var(--space-1) 0 0; color: var(--text-bright); font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl)); line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); }
  .rr-context { margin: 0; color: var(--text-secondary); font-size: var(--text-sm); }
  .rr-score-row { display: flex; align-items: end; gap: var(--space-8); margin-top: var(--space-5); }
  .rr-score { display: grid; }
  .rr-score > span { color: var(--text-muted); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-widest); text-transform: uppercase; }
  .rr-score strong { color: var(--rr-accent); font-size: clamp(var(--text-4xl), 5vw, 48px); font-weight: var(--weight-black); line-height: 1; font-variant-numeric: tabular-nums; }
  .rr-score small { margin-top: var(--space-1); color: var(--rr-accent); font-size: var(--text-xs); font-weight: var(--weight-semibold); }
  .rr-outcome-facts { display: flex; gap: var(--space-6); padding-bottom: var(--space-1); }
  .rr-outcome-facts div { display: grid; gap: 2px; }
  .rr-outcome-facts strong { color: var(--text-bright); font-size: var(--text-lg); font-variant-numeric: tabular-nums; }
  .rr-outcome-facts span { color: var(--text-muted); font-size: var(--text-xs); }
  .rr-record { display: flex; align-items: center; gap: var(--space-2); margin: var(--space-4) 0 0; color: var(--text-secondary); font-size: var(--text-sm); }
  .rr-record span { color: var(--rr-accent); font-weight: var(--weight-bold); }
  .rr-victory-marks { display: flex; align-items: center; gap: var(--space-5); height: 96px; margin-top: var(--space-4); padding-inline: var(--space-4); overflow: hidden; background: linear-gradient(90deg, color-mix(in srgb, var(--bg-base) 45%, transparent), transparent); }
  .rr-victory-marks i { width: 48px; height: 48px; border: 4px dotted color-mix(in srgb, var(--rr-accent) 80%, transparent); border-radius: 50%; filter: drop-shadow(0 0 7px color-mix(in srgb, var(--rr-accent) 45%, transparent)); animation: rr-mark-reveal 900ms var(--ease-out) both; }
  .rr-victory-marks i:nth-child(2) { opacity: .45; animation-delay: 160ms; }
  .rr-victory-marks i:nth-child(3) { opacity: .18; animation-delay: 320ms; }

  .rr-mvp { position: relative; min-width: 0; overflow: hidden; isolation: isolate; }
  .rr-mvp::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--bg-raised), transparent 30%), linear-gradient(0deg, color-mix(in srgb, var(--bg-base) 94%, transparent), transparent 58%); }
  .rr-mvp-glow { position: absolute; left: 48%; bottom: -35%; z-index: -2; width: 360px; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--rr-accent) 24%, transparent), transparent 68%); transform: translateX(-50%); }
  .rr-mvp > img { position: absolute; right: 4%; bottom: -4%; width: min(390px, 95%); height: 112%; object-fit: contain; object-position: center bottom; filter: drop-shadow(0 18px 30px color-mix(in srgb, var(--bg-base) 80%, transparent)); }
  .rr-mvp-copy { position: absolute; left: var(--space-6); bottom: var(--space-6); display: grid; gap: 2px; z-index: 2; }
  .rr-mvp-copy span { width: max-content; padding: 2px var(--space-2); border-radius: var(--radius-full); background: var(--rr-accent); color: var(--bg-base); font-size: var(--text-xs); font-weight: var(--weight-black); letter-spacing: var(--tracking-widest); }
  .rr-mvp-copy strong { color: var(--text-bright); font-size: var(--text-2xl); }
  .rr-mvp-copy small { color: var(--text-secondary); font-size: var(--text-sm); }

  .rr-tabs { display: none; }
  .rr-content { min-height: 0; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: var(--space-8); padding: var(--space-6) var(--space-10); overflow-y: auto; }
  .rr-panel { min-width: 0; align-content: start; }
  .rr-summary { display: grid; gap: var(--space-4); }
  .rr-performance { display: grid; gap: var(--space-3); }
  .rr-section-head { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); }
  .rr-section-head h2 { margin: var(--space-1) 0 0; color: var(--text-bright); font-size: var(--text-xl); }
  .rr-earned, .rr-total { color: var(--text-muted); font-size: var(--text-xs); white-space: nowrap; }
  .rr-earned { padding: 3px var(--space-2); border: 1px solid color-mix(in srgb, var(--rr-accent) 40%, transparent); border-radius: var(--radius-full); color: var(--rr-accent); }

  .rr-rewards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
  .rr-reward { min-width: 0; display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-tint); }
  .rr-reward--favor { border-color: color-mix(in srgb, var(--rr-accent) 38%, var(--border-subtle)); background: color-mix(in srgb, var(--rr-accent) 7%, var(--bg-surface)); }
  .rr-reward img, .rr-reward-icon { width: 30px; height: 30px; flex: 0 0 auto; object-fit: contain; }
  .rr-reward-icon { display: grid; place-items: center; color: var(--rr-accent); font-size: var(--text-xl); }
  .rr-reward div { display: grid; min-width: 0; }
  .rr-reward strong { color: var(--text-bright); font-size: var(--text-lg); font-variant-numeric: tabular-nums; }
  .rr-reward--favor strong { color: var(--rr-accent); }
  .rr-reward small { overflow: hidden; color: var(--text-muted); font-size: var(--text-xs); white-space: nowrap; text-overflow: ellipsis; }
  .rr-details { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--border-subtle); }
  .rr-detail { min-width: 0; display: grid; gap: 2px; padding: var(--space-4) var(--space-3); }
  .rr-detail + .rr-detail { border-left: 1px solid var(--border-subtle); }
  .rr-detail span { color: var(--text-muted); font-size: var(--text-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .rr-detail strong { overflow: hidden; color: var(--text-bright); font-size: var(--text-sm); white-space: nowrap; text-overflow: ellipsis; }
  .rr-detail small { color: var(--text-muted); font-size: var(--text-xs); }
  .rr-achievement { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-3); border-radius: var(--radius-md); background: color-mix(in srgb, var(--rr-accent) 8%, var(--bg-surface)); }
  .rr-achievement-mark { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--radius-full); background: var(--accent-gold-dim); color: var(--rr-accent); }
  .rr-achievement div { display: grid; gap: 2px; }
  .rr-achievement strong { color: var(--text-bright); font-size: var(--text-sm); }
  .rr-achievement small { color: var(--text-secondary); font-size: var(--text-xs); }
  .rr-achievement-new { color: var(--rr-accent); font-size: var(--text-xs); font-weight: var(--weight-bold); text-transform: uppercase; }

  .rr-legend { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(120px, .75fr) 64px 48px; gap: var(--space-3); padding: 0 var(--space-3) 0 68px; color: var(--text-muted); font-size: var(--text-xs); }
  .rr-legend span:not(:first-child) { text-align: right; }
  .rr-rankings { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .rr-ranking { position: relative; display: grid; grid-template-columns: 22px 38px minmax(120px, 1fr) minmax(120px, .75fr) 64px 48px; align-items: center; gap: var(--space-2); min-width: 0; min-height: 50px; padding: var(--space-1) var(--space-3); border-radius: var(--radius-md); background: var(--surface-tint); }
  .rr-ranking.is-mvp { background: linear-gradient(90deg, color-mix(in srgb, var(--rr-accent) 13%, var(--bg-surface)), var(--surface-tint)); }
  .rr-rank { color: var(--text-muted); font-size: var(--text-xs); font-variant-numeric: tabular-nums; text-align: center; }
  .rr-ranking.is-mvp .rr-rank { color: var(--rr-accent); font-weight: var(--weight-bold); }
  .rr-avatar { width: 36px; height: 40px; overflow: hidden; border-radius: var(--radius-sm); background: var(--bg-raised); }
  .rr-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .rr-hero-name { display: grid; min-width: 0; }
  .rr-hero-name strong { color: var(--text-bright); font-size: var(--text-sm); }
  .rr-hero-name small { overflow: hidden; color: var(--text-muted); font-size: var(--text-xs); white-space: nowrap; text-overflow: ellipsis; }
  .rr-damage { display: grid; gap: var(--space-1); min-width: 0; }
  .rr-damage > span { display: flex; justify-content: space-between; gap: var(--space-2); }
  .rr-damage strong, .rr-number strong { color: var(--text-bright); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .rr-damage small, .rr-number small { color: var(--text-muted); font-size: var(--text-xs); }
  .rr-damage i { display: block; height: 4px; overflow: hidden; border-radius: var(--radius-full); background: var(--border-subtle); }
  .rr-damage i::after { content: ""; display: block; width: var(--rr-share); height: 100%; border-radius: inherit; background: var(--rr-accent); opacity: .75; }
  .rr-number { display: grid; justify-items: end; }
  .rr-support { position: absolute; right: var(--space-3); bottom: 2px; color: var(--td-heal); font-size: var(--text-2xs); }

  .rr-actions { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-2); padding: var(--space-3) var(--space-10) max(var(--space-3), env(safe-area-inset-bottom)); border-top: 1px solid var(--border-subtle); background: color-mix(in srgb, var(--bg-raised) 94%, transparent); }
  .rr-actions[hidden] { display: none; }
  .rr-actions .action-button { min-width: 180px; }
  .rr-actions .action-button:first-child { margin-right: auto; }
  .rr-actions span { color: var(--rr-accent); }

  @media (max-width: 900px) {
    .rr-result { width: 100%; }
    .rr-hero { grid-template-columns: minmax(0, 1fr) 300px; min-height: 270px; }
    .rr-outcome { padding-inline: var(--space-6); }
    .rr-content, .rr-actions { padding-inline: var(--space-6); }
    .rr-content { gap: var(--space-5); }
    .rr-outcome-facts { gap: var(--space-4); }
    .rr-ranking { grid-template-columns: 18px 34px minmax(100px, 1fr) minmax(92px, .7fr) 48px; }
    .rr-ranking .rr-number:nth-last-of-type(2), .rr-legend span:nth-child(3) { display: none; }
    .rr-legend { grid-template-columns: minmax(150px, 1fr) minmax(92px, .7fr) 48px; padding-left: 64px; }
  }

  @media (max-width: 720px) {
    .rr-page { overflow: auto; place-items: stretch; }
    .rr-result { min-height: 100dvh; height: auto; }
    .rr-hero { min-height: 340px; grid-template-columns: 1fr; }
    .rr-outcome { position: relative; z-index: 2; align-self: end; padding: var(--space-6) var(--space-4); background: linear-gradient(90deg, color-mix(in srgb, var(--bg-base) 94%, transparent), color-mix(in srgb, var(--bg-base) 72%, transparent)); }
    .rr-mvp { position: absolute; inset: 0 0 0 42%; z-index: 0; }
    .rr-mvp-copy { display: none; }
    .rr-score-row { align-items: start; gap: var(--space-5); }
    .rr-outcome-facts { display: grid; grid-template-columns: repeat(2, auto); gap: var(--space-2) var(--space-4); }
    .rr-outcome-facts div:last-child { grid-column: 1 / -1; }
    .rr-tabs { display: flex; padding-inline: var(--space-4); border-bottom: 1px solid var(--border-subtle); }
    .rr-tab { min-height: 44px; padding: 0 var(--space-4); border: 0; border-bottom: 2px solid transparent; background: none; color: var(--text-muted); font: inherit; font-size: var(--text-sm); font-weight: var(--weight-semibold); }
    .rr-tab.is-active { border-bottom-color: var(--rr-accent); color: var(--text-bright); }
    .rr-content { display: block; padding: var(--space-5) var(--space-4); overflow: visible; }
    .rr-panel { display: none; }
    .rr-panel.is-active { display: grid; }
    .rr-actions { position: sticky; bottom: 0; z-index: 5; display: grid; grid-template-columns: 1fr 1fr; padding-inline: var(--space-4); }
    .rr-actions .action-button { min-width: 0; }
    .rr-actions .action-button:first-child { margin-right: 0; }
    .rr-actions .action-button--primary { grid-column: 1 / -1; grid-row: 1; }
  }

  @media (max-width: 480px) {
    .rr-hero { min-height: 370px; }
    .rr-mvp { left: 28%; }
    .rr-outcome h1 { max-width: 11ch; font-size: var(--text-3xl); }
    .rr-score strong { font-size: var(--text-4xl); }
    .rr-rewards { grid-template-columns: 1fr; }
    .rr-details { grid-template-columns: 1fr; }
    .rr-detail + .rr-detail { border-left: 0; border-top: 1px solid var(--border-subtle); }
    .rr-ranking { grid-template-columns: 18px 34px minmax(88px, 1fr) 74px 36px; padding-inline: var(--space-2); }
    .rr-hero-name small, .rr-number small, .rr-legend { display: none; }
  }

  @media (max-height: 680px) and (min-width: 721px) {
    .rr-result { height: 100dvh; }
    .rr-hero { min-height: 190px; }
    .rr-outcome { padding-block: var(--space-4); }
    .rr-score-row { margin-top: var(--space-3); }
    .rr-mvp-copy { bottom: var(--space-4); }
    .rr-content { padding-block: var(--space-4); }
  }

  /* The game is designed around a phone held sideways. At this height the report becomes
