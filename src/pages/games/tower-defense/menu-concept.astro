---
export const prerender = true;
import GameLayout from "../../../layouts/GameLayout.astro";

const modes = [
  { id: "campaign", label: "Campaign", note: "Continue 2-2", icon: "flag", badge: "" },
  { id: "daily", label: "Daily Trial", note: "New challenge", icon: "hourglass", badge: "1" },
  { id: "expedition", label: "Expedition", note: "Not started", icon: "compass", badge: "" },
  { id: "free", label: "Free Play", note: "Best 155,868", icon: "swords", badge: "" },
];

const dockItems = [
  { label: "Heroes", icon: "helmet", badge: "" },
  { label: "Summon", icon: "spark", badge: "1" },
  { label: "Blessings", icon: "star", badge: "" },
  { label: "Armory", icon: "shield", badge: "" },
  { label: "Bestiary", icon: "book", badge: "" },
  { label: "How to play", icon: "help", badge: "" },
];

const paths: Record<string, string> = {
  flag: "M6 21V3m0 2h11l-2.5 4L17 13H6",
  hourglass: "M6 3h12M6 21h12M7 3c0 5 10 5 10 9s-10 4-10 9M17 3c0 5-10 5-10 9s10 4 10 9",
  compass: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm3.5 5.5-2 5-5 2 2-5 5-2Z",
  swords: "M4 4l10 10m0 0-2 2m2-2 2-2m.5 4.5 3 3M20 4 10 14m0 0 2 2m-2-2-2-2m-.5 4.5-3 3",
  helmet: "M5 18v-6a7 7 0 0 1 14 0v6m-14-3h4v6m10-6h-4v6M9 9h6",
  spark: "m12 3 2.2 6.3 6.3 2.7-6.3 2.7L12 21l-2.2-6.3L3.5 12l6.3-2.7L12 3Z",
  star: "m12 3 2.2 6.3 6.3 2.7-6.3 2.7L12 21l-2.2-6.3L3.5 12l6.3-2.7L12 3Z",
  shield: "M12 3 5 6v5c0 4.7 2.8 8 7 10 4.2-2 7-5.3 7-10V6l-7-3Zm0 4v10",
  book: "M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4Zm0 13a3 3 0 0 1 3-3h10",
  help: "M9.5 9.5a2.5 2.5 0 1 1 4 2c-1 .7-1.5 1.2-1.5 2.5M12 17h.01M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z",
};
---

<GameLayout
  title="War Camp Menu Concept | Tower Defense"
  description="Standalone review prototype for an immersive tower-defense home screen."
  image="/td/concepts/camp-menu-bg-v1.png"
>
  <main class="camp-concept" data-camp-concept>
    <div class="camp-concept__scene" aria-hidden="true"></div>
    <div class="camp-concept__shade" aria-hidden="true"></div>

    <header class="camp-topbar">
      <a class="camp-profile" href="/games/tower-defense" aria-label="Return to the current Tower Defense menu">
        <span class="camp-profile__crest">LC</span>
        <span class="camp-profile__copy">
          <small>Commander · Lv. 27</small>
          <strong>The Last Crossing</strong>
        </span>
      </a>

      <div class="camp-wallet" aria-label="Resources">
        <span><i class="camp-gem camp-gem--favor"></i><b>403</b></span>
        <span><i class="camp-gem camp-gem--seal"></i><b>1,545</b></span>
        <button type="button" aria-label="Open inventory">+</button>
      </div>

      <div class="camp-tools">
        <span class="camp-review-chip">Review concept</span>
        <button class="camp-round-button" type="button" aria-label="Messages">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H8l-4 4V5Z" /></svg>
          <i></i>
        </button>
        <button class="camp-round-button" type="button" aria-label="Settings">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9m4 0h3M4 17h3m4 0h9M15 5v4M9 15v4" /></svg>
        </button>
      </div>
    </header>

    <aside class="camp-quest" aria-label="Current objective">
      <small>Current objective</small>
      <strong>Hold the Sunscar Gate</strong>
      <span>Campaign · Stage 2-2</span>
      <div class="camp-quest__progress"><i></i></div>
    </aside>

    <button class="camp-play" type="button" data-concept-action data-label="Continue campaign" data-note="Stage 2-2 · Sunscar Gate">
      <span class="camp-play__ring">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 9 6-9 6V6Z" /></svg>
      </span>
      <span class="camp-play__copy"><small>Stage 2-2</small><strong>Play</strong></span>
    </button>

    <nav class="camp-modes" aria-label="Game modes">
      {modes.map((mode, index) => (
        <button
          class:list={["camp-mode", { "is-active": index === 0 }]}
          type="button"
          data-concept-action
          data-label={mode.label}
          data-note={mode.note}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <span class="camp-mode__medallion">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={paths[mode.icon]} /></svg>
            {mode.badge && <i>{mode.badge}</i>}
          </span>
          <span class="camp-mode__copy"><strong>{mode.label}</strong><small>{mode.note}</small></span>
        </button>
      ))}
    </nav>

    <div class="camp-selection" aria-live="polite">
      <small>Selected</small>
      <strong data-selection-label>Campaign</strong>
      <span data-selection-note>Continue 2-2</span>
    </div>

    <nav class="camp-dock" aria-label="Collection and progression">
      {dockItems.map((item) => (
        <button class="camp-dock__item" type="button" data-concept-action data-label={item.label} data-note="Opens its own screen">
          <span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={paths[item.icon]} /></svg>
            {item.badge && <i>{item.badge}</i>}
          </span>
          <strong>{item.label}</strong>
        </button>
      ))}
    </nav>

    <a class="camp-exit" href="/games/tower-defense">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5m4-11 4 4-4 4m4-4H9" /></svg>
      Current menu
    </a>

    <div class="camp-rotate" role="note">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm3 13h4" /></svg>
      <strong>Turn your device</strong>
      <span>This menu concept is designed for landscape play.</span>
    </div>
  </main>
</GameLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-camp-concept]");
  const label = root?.querySelector<HTMLElement>("[data-selection-label]");
  const note = root?.querySelector<HTMLElement>("[data-selection-note]");
  const modeButtons = [...(root?.querySelectorAll<HTMLButtonElement>(".camp-mode") ?? [])];

  root?.querySelectorAll<HTMLButtonElement>("[data-concept-action]").forEach((button) => {
    button.addEventListener("click", () => {
      if (label) label.textContent = button.dataset.label ?? "Menu item";
      if (note) note.textContent = button.dataset.note ?? "Prototype interaction";
      if (button.classList.contains("camp-mode")) {
        modeButtons.forEach((mode) => {
          const active = mode === button;
          mode.classList.toggle("is-active", active);
          mode.setAttribute("aria-pressed", String(active));
        });
      }
    });
  });
</script>

<style>
  :global(.game-body) { background: #06080d; }

  .camp-concept {
    --camp-gold: #efc66b;
    --camp-gold-bright: #ffe3a1;
    --camp-blue: #55aaf7;
    position: relative;
    height: 100dvh;
    min-height: 360px;
    overflow: hidden;
    color: #f5f1e8;
    font-family: Inter, system-ui, sans-serif;
    isolation: isolate;
  }

  .camp-concept__scene,
  .camp-concept__shade { position: absolute; inset: 0; pointer-events: none; }
  .camp-concept__scene {
    z-index: -3;
    background: #111927 url("/td/concepts/camp-menu-bg-v1.png") center / cover no-repeat;
    transform: scale(1.012);
  }
  .camp-concept__shade {
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(2, 5, 11, .84), transparent 15%, transparent 72%, rgba(2, 4, 9, .92)),
      linear-gradient(90deg, rgba(2, 4, 9, .72), transparent 18%, transparent 78%, rgba(2, 4, 9, .68));
  }

  button, a { -webkit-tap-highlight-color: transparent; }
  button { font: inherit; }
  svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .camp-topbar {
    position: absolute;
    z-index: 5;
    inset: 0 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 78px;
    padding: 10px clamp(14px, 2.2vw, 34px);
    box-sizing: border-box;
    border-bottom: 1px solid rgba(239, 198, 107, .2);
    background: linear-gradient(180deg, rgba(4, 7, 13, .95), rgba(4, 7, 13, .58));
    backdrop-filter: blur(8px);
  }

  .camp-profile { display: flex; align-items: center; gap: 11px; width: max-content; color: inherit; text-decoration: none; }
  .camp-profile__crest {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(239, 198, 107, .7);
    clip-path: polygon(50% 0, 94% 18%, 87% 77%, 50% 100%, 13% 77%, 6% 18%);
    background: linear-gradient(145deg, #765822, #211b16 72%);
    color: var(--camp-gold-bright);
    font-family: Georgia, serif;
    font-weight: 800;
  }
  .camp-profile__copy { display: grid; gap: 2px; }
  .camp-profile__copy small { color: #b9b3a7; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
  .camp-profile__copy strong { font-family: Georgia, serif; font-size: clamp(15px, 1.35vw, 20px); letter-spacing: .025em; }

  .camp-wallet {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    min-height: 44px;
    padding: 0 7px 0 20px;
    border: 1px solid rgba(239, 198, 107, .45);
    border-radius: 99px;
    background: rgba(10, 10, 13, .72);
    box-shadow: 0 8px 24px rgba(0, 0, 0, .28);
  }
  .camp-wallet > span { display: inline-flex; align-items: center; gap: 8px; }
  .camp-wallet b { font-size: 14px; font-variant-numeric: tabular-nums; }
  .camp-wallet button { width: 30px; height: 30px; border: 0; border-radius: 50%; background: var(--camp-gold); color: #171005; font-weight: 900; cursor: pointer; }
  .camp-gem { width: 15px; height: 15px; transform: rotate(45deg); background: var(--camp-gold); box-shadow: 0 0 12px rgba(239, 198, 107, .45); }
  .camp-gem--seal { border-radius: 50%; background: #70bfff; box-shadow: 0 0 12px rgba(85, 170, 247, .5); }

  .camp-tools { justify-self: end; display: flex; align-items: center; gap: 8px; }
  .camp-review-chip { padding: 5px 9px; border: 1px solid rgba(112, 191, 255, .38); border-radius: 99px; background: rgba(9, 25, 39, .72); color: #a8d7ff; font-size: 9px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .camp-round-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(239, 198, 107, .28);
    border-radius: 50%;
    background: rgba(5, 8, 14, .75);
    color: #d7d2c8;
    cursor: pointer;
  }
  .camp-round-button svg { width: 20px; height: 20px; }
  .camp-round-button i { position: absolute; top: 2px; right: 1px; width: 8px; height: 8px; border: 2px solid #11151c; border-radius: 50%; background: #ef5f4c; }

  .camp-quest {
    position: absolute;
    z-index: 2;
    top: 102px;
    left: clamp(16px, 2.4vw, 38px);
    display: grid;
    gap: 3px;
    width: min(240px, 27vw);
    padding: 13px 16px;
    border-left: 2px solid var(--camp-gold);
    background: linear-gradient(90deg, rgba(4, 7, 12, .84), rgba(4, 7, 12, .18));
    text-shadow: 0 2px 8px #000;
  }
  .camp-quest small { color: var(--camp-gold); font-size: 9px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .camp-quest strong { font-family: Georgia, serif; font-size: clamp(15px, 1.5vw, 20px); }
  .camp-quest span { color: #c0bbb1; font-size: 11px; }
  .camp-quest__progress { height: 3px; margin-top: 6px; background: rgba(255, 255, 255, .16); }
  .camp-quest__progress i { display: block; width: 38%; height: 100%; background: var(--camp-gold); box-shadow: 0 0 8px rgba(239, 198, 107, .7); }

  .camp-play {
    position: absolute;
    z-index: 3;
    right: clamp(170px, 15vw, 230px);
    bottom: clamp(94px, 15vh, 140px);
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 0;
    border: 0;
    background: none;
    color: white;
    text-align: left;
    cursor: pointer;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, .8));
  }
  .camp-play__ring {
    display: grid;
    place-items: center;
    width: clamp(58px, 6vw, 82px);
    aspect-ratio: 1;
    border: 2px solid #9fd8ff;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(64, 176, 255, .72), rgba(10, 52, 94, .84) 58%, rgba(3, 12, 23, .9));
    box-shadow: 0 0 12px #48aef5, 0 0 34px rgba(55, 166, 255, .72), inset 0 0 20px rgba(192, 231, 255, .45);
    animation: camp-pulse 2.4s ease-in-out infinite;
  }
  .camp-play__ring svg { width: 38%; height: 38%; fill: currentColor; stroke: none; transform: translateX(2px); }
  .camp-play__copy { display: grid; gap: 0; text-transform: uppercase; }
  .camp-play__copy small { color: #aad8fb; font-size: 9px; font-weight: 700; letter-spacing: .14em; }
  .camp-play__copy strong { font-family: Georgia, serif; font-size: clamp(18px, 2vw, 28px); letter-spacing: .09em; }

  .camp-modes {
    position: absolute;
    z-index: 4;
    top: 104px;
    right: clamp(12px, 1.8vw, 28px);
    display: grid;
    gap: 8px;
  }
  .camp-mode {
    display: grid;
    grid-template-columns: 0fr 54px;
    align-items: center;
    gap: 0;
    min-width: 54px;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: none;
    color: #d8d3c9;
    text-align: left;
    cursor: pointer;
    transition: grid-template-columns .2s ease, color .2s ease;
  }
  .camp-mode:hover,
  .camp-mode:focus-visible,
  .camp-mode.is-active { grid-template-columns: 118px 54px; color: var(--camp-gold-bright); }
  .camp-mode:focus-visible { outline: none; }
  .camp-mode__medallion {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border: 1px solid rgba(239, 198, 107, .38);
    border-radius: 13px;
    background: linear-gradient(145deg, rgba(42, 35, 26, .94), rgba(6, 9, 15, .94));
    box-shadow: 0 7px 22px rgba(0, 0, 0, .48);
  }
  .camp-mode.is-active .camp-mode__medallion { border-color: var(--camp-gold); box-shadow: 0 0 0 1px rgba(239, 198, 107, .22), 0 0 20px rgba(239, 198, 107, .22); }
  .camp-mode__medallion svg { width: 25px; height: 25px; }
  .camp-mode__medallion i,
  .camp-dock__item i { position: absolute; top: -4px; right: -4px; display: grid; place-items: center; min-width: 17px; height: 17px; padding: 0 2px; border: 2px solid #11151c; border-radius: 99px; background: #e45745; color: white; font-size: 9px; font-style: normal; font-weight: 800; }
  .camp-mode__copy { grid-column: 1; grid-row: 1; min-width: 0; padding: 0; overflow: hidden; border-radius: 8px 0 0 8px; background: rgba(5, 8, 13, .78); opacity: 0; white-space: nowrap; transition: opacity .15s ease; }
  .camp-mode:hover .camp-mode__copy,
  .camp-mode:focus-visible .camp-mode__copy,
  .camp-mode.is-active .camp-mode__copy { padding: 7px 10px; opacity: 1; }
  .camp-mode__copy strong,
  .camp-mode__copy small { display: block; }
  .camp-mode__copy strong { font-size: 12px; }
  .camp-mode__copy small { margin-top: 2px; color: #9e9a92; font-size: 9px; }

  .camp-selection {
    position: absolute;
    z-index: 2;
    left: clamp(16px, 2.4vw, 38px);
    bottom: clamp(88px, 13vh, 118px);
    display: grid;
    min-width: 150px;
    padding: 9px 13px;
    border-radius: 4px;
    background: rgba(4, 7, 12, .64);
    backdrop-filter: blur(5px);
  }
  .camp-selection small { color: var(--camp-gold); font-size: 8px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .camp-selection strong { margin-top: 2px; font-family: Georgia, serif; font-size: 16px; }
  .camp-selection span { color: #aaa69f; font-size: 9px; }

  .camp-dock {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: 10px;
    display: flex;
    gap: clamp(3px, .7vw, 10px);
    padding: 7px 10px;
    border: 1px solid rgba(239, 198, 107, .2);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(22, 21, 21, .88), rgba(5, 8, 13, .96));
    box-shadow: 0 16px 36px rgba(0, 0, 0, .55);
    transform: translateX(-50%);
    backdrop-filter: blur(9px);
  }
  .camp-dock__item {
    display: grid;
    justify-items: center;
    gap: 3px;
    min-width: clamp(55px, 6vw, 78px);
    padding: 0 4px;
    border: 0;
    background: none;
    color: #aaa69d;
    cursor: pointer;
  }
  .camp-dock__item > span { position: relative; display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid rgba(239, 198, 107, .26); border-radius: 50%; background: radial-gradient(circle at 45% 35%, #4c4332, #151515 68%); transition: border-color .18s ease, transform .18s ease; }
  .camp-dock__item svg { width: 21px; height: 21px; }
  .camp-dock__item strong { max-width: 72px; overflow: hidden; font-size: 9px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .camp-dock__item:hover,
  .camp-dock__item:focus-visible { color: var(--camp-gold-bright); outline: none; }
  .camp-dock__item:hover > span,
  .camp-dock__item:focus-visible > span { border-color: var(--camp-gold); transform: translateY(-3px); }

  .camp-exit {
    position: absolute;
    z-index: 5;
    right: clamp(16px, 2.2vw, 34px);
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #aaa69f;
    font-size: 10px;
    font-weight: 600;
    text-decoration: none;
  }
  .camp-exit svg { width: 18px; height: 18px; }
  .camp-exit:hover { color: var(--camp-gold-bright); }

  .camp-rotate { display: none; }

  @keyframes camp-pulse {
    50% { box-shadow: 0 0 18px #63bfff, 0 0 46px rgba(55, 166, 255, .85), inset 0 0 25px rgba(192, 231, 255, .55); transform: scale(1.04); }
  }

  @media (max-height: 560px) {
    .camp-topbar { min-height: 58px; padding-block: 5px; }
    .camp-profile__crest { width: 39px; height: 39px; font-size: 13px; }
    .camp-profile__copy small { display: none; }
    .camp-wallet { min-height: 38px; }
    .camp-round-button { width: 38px; height: 38px; }
    .camp-quest { top: 70px; padding-block: 9px; }
    .camp-modes { top: 67px; gap: 4px; }
    .camp-mode { grid-template-columns: 0fr 46px; }
    .camp-mode:hover,
    .camp-mode:focus-visible,
    .camp-mode.is-active { grid-template-columns: 110px 46px; }
    .camp-mode__medallion { width: 42px; height: 42px; border-radius: 10px; }
    .camp-play { right: 165px; bottom: 84px; }
    .camp-selection { bottom: 76px; }
    .camp-dock { bottom: 5px; padding-block: 4px; }
    .camp-dock__item { gap: 2px; }
    .camp-dock__item > span { width: 34px; height: 34px; }
    .camp-dock__item svg { width: 18px; height: 18px; }
    .camp-dock__item strong { font-size: 8px; line-height: 1; }
    .camp-exit { bottom: 16px; }
  }

  @media (max-width: 760px) {
    .camp-review-chip,
    .camp-selection { display: none; }
    .camp-profile__copy strong { font-size: 14px; }
    .camp-wallet { gap: 10px; padding-left: 12px; }
    .camp-quest { width: 200px; }
    .camp-modes { right: 8px; }
    .camp-exit { display: none; }
    .camp-dock__item { min-width: 52px; }
  }

  @media (orientation: portrait) and (max-width: 700px) {
    .camp-concept > :not(.camp-concept__scene):not(.camp-concept__shade):not(.camp-rotate) { display: none; }
    .camp-concept__scene { filter: blur(4px) brightness(.35); transform: scale(1.08); }
    .camp-rotate { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 10px; padding: 24px; text-align: center; }
    .camp-rotate svg { width: 54px; height: 54px; color: var(--camp-gold); transform: rotate(90deg); }
    .camp-rotate strong { font-family: Georgia, serif; font-size: 24px; }
    .camp-rotate span { max-width: 28ch; color: #bbb6ad; font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .camp-play__ring { animation: none; }
    .camp-mode,
    .camp-dock__item > span { transition: none; }
  }
</style>
