---
export const prerender = true;
import GameLayout from "../../layouts/GameLayout.astro";
import TowerDefensePage from "../../components/pages/TowerDefensePage.astro";
import heroes from "../../data/gameBalance.json";
import tuning from "../../data/gameBalance.tuning.json";
import maps from "../../data/tdMaps.json";
import waves from "../../data/tdWaves.json";
import bosses from "../../data/bosses.json";
import tdBosses from "../../data/tdBosses.json";
import campaign from "../../data/tdCampaign.json";
import { skinHeroes, skinTuning } from "../../game/td/skin.js";

const R2_BASE = 'https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev';
const isDev = import.meta.env.DEV;
// In dev, proxy R2 images through Vite to avoid CORS blocks on PixiJS WebGL texture upload
const assetBase = isDev ? "/r2" : R2_BASE;
// Hero skin (M24 white label): the game's own names, art, sounds and ultimate names.
const heroesForGame = skinHeroes(heroes, assetBase);
const tuningForGame = skinTuning(tuning);
// Final boss per map (tdMaps.json "boss", default Baphomet), keyed by boss id.
// Campaign stages may name their own boss (stage.boss), replacing their map's.
const stageBosses = campaign.chapters.flatMap((chapter: any) => chapter.stages.map((stage: any) => stage.boss).filter(Boolean));
const bossIds = new Set([...maps.map((map: any) => map.boss ?? "baphomet"), ...stageBosses]);
const bossesForGame = Object.fromEntries(bosses.bosses
  .filter((boss: any) => bossIds.has(boss.id))
  // Only name and rules data: the game shows its own AI boss sprites, never database art.
  .map(({ image: _image, faction: _faction, ...boss }: any) => [boss.id, boss])
  // TD-original bosses (tdBosses.json) join by the same id.
  .concat(tdBosses.bosses.filter((boss: any) => bossIds.has(boss.id)).map((boss: any) => [boss.id, boss])));
---

<GameLayout
  title="The Last Crossing | Tower Defense"
  description="Hold the last crossing with gods and heroes of Greek and Norse myth: a free browser tower defense game with 10 waves, 20 waves or endless."
>
  <Fragment slot="head">
    <script type="importmap" is:inline>{
      "imports": {
        "pixi.js": "https://cdn.jsdelivr.net/npm/pixi.js@8/dist/pixi.mjs",
        "@pixi/filter-glow": "https://cdn.jsdelivr.net/npm/@pixi/filter-glow@5/dist/filter-glow.mjs"
      }
    }</script>
  </Fragment>
  <TowerDefensePage assetBase={assetBase} heroes={heroesForGame} tuning={tuningForGame} maps={maps} waves={waves} bosses={bossesForGame} />
</GameLayout>
