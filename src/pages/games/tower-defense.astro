---
export const prerender = true;
import GameLayout from "../../layouts/GameLayout.astro";
import TowerDefensePage from "../../components/pages/TowerDefensePage.astro";
import heroes from "../../data/gameBalance.json";
import tuning from "../../data/gameBalance.tuning.json";
import maps from "../../data/tdMaps.json";
import waves from "../../data/tdWaves.json";
import bosses from "../../data/bosses.json";

const R2_BASE = 'https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev';
const isDev = import.meta.env.DEV;
// In dev, proxy R2 images through Vite to avoid CORS blocks on PixiJS WebGL texture upload
const heroesForGame = isDev
  ? heroes.map((h: any) => ({ ...h, image: h.image.startsWith(R2_BASE) ? h.image.replace(R2_BASE, '/r2') : h.image }))
  : heroes;
// Final boss per map (tdMaps.json "boss", default Baphomet), keyed by boss id.
const bossIds = new Set(maps.map((map: any) => map.boss ?? "baphomet"));
const bossesForGame = Object.fromEntries(bosses.bosses
  .filter((boss: any) => bossIds.has(boss.id))
  .map((boss: any) => [boss.id, isDev && boss.image?.startsWith(R2_BASE) ? { ...boss, image: boss.image.replace(R2_BASE, '/r2') } : boss]));
---

<GameLayout
  title="Tower Defense | Motto Immortal"
  description="Command Motto Immortal heroes in a compact, ten-wave browser tower defense challenge."
>
  <Fragment slot="head">
    <script type="importmap" is:inline>{
      "imports": {
        "pixi.js": "https://cdn.jsdelivr.net/npm/pixi.js@8/dist/pixi.mjs",
        "@pixi/filter-glow": "https://cdn.jsdelivr.net/npm/@pixi/filter-glow@5/dist/filter-glow.mjs"
      }
    }</script>
  </Fragment>
  <TowerDefensePage assetBase={isDev ? "/r2" : R2_BASE} heroes={heroesForGame} tuning={tuning} maps={maps} waves={waves} bosses={bossesForGame} />
</GameLayout>
