---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import LevelGapDamageCalculator from "../components/LevelGapDamageCalculator.astro";
---

<Base
  title="Level Gap Damage Calculator | Motto Immortal"
  description="Interactive level-gap calculator for Motto Immortal: compare different level-gap mechanics and see outgoing damage and incoming damage taken changes."
>
  <PageHero
    tag="Tools"
    headline="Level Gap Damage Calculator"
    subtitle="Compare different level-gap mechanics and see how your outgoing damage and incoming damage taken can change."
  />

  <div class="page-wrapper">
    <main class="main-content">
      <LevelGapDamageCalculator />
    </main>
  </div>
</Base>
