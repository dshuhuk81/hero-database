---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import allHeroes from "../data/all_heroes_db.json";
import { heroes as heroPages } from "../data/heroes/withRatings";
import { summonSchedule as schedule, type PullQuality, type ScheduleEntry } from "../data/summonSchedule";

const PULL_QUALITY_META: Record<PullQuality, { label: string; className: string }> = {
  "pull":   { label: "Pull",   className: "pull-must" },
  "optional":    { label: "Optional",    className: "pull-optional" },
  "unsure":      { label: "Unsure", className: "pull-optional"},
  "whales-only": { label: "Whales Only", className: "pull-whales" },
  "skip":        { label: "Skip",        className: "pull-skip" },
};

const heroMap = new Map(Object.values(allHeroes as Record<string, any>).map((h: any) => [h.id, h]));
const heroPageIds = new Set((heroPages as any[]).map((h) => h.id));
const ratedHeroMap = new Map((heroPages as any[]).map((hero) => [hero.id, hero]));

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const HERO_PLACEHOLDER = `${R2_BASE}/heroes/placeholder.png`;
const HERO_IMAGE_VERSION = "2026-06-08-portrait";
const SPOTLIGHT_IMAGE_SIZES = "(max-width: 400px) calc(100vw - 40px), (max-width: 600px) calc((100vw - 56px) / 2), 220px";

function heroImg(id: string): string {
  return `${R2_BASE}/heroes/${encodeURIComponent(id)}.webp`;
}

function heroCardImg(id: string, width = 360): string {
  return `${R2_BASE}/heroes/cards/${encodeURIComponent(id)}-${width}.webp?v=${HERO_IMAGE_VERSION}`;
}

function heroCardSrcset(id: string): string {
  const encodedId = encodeURIComponent(id);
  return [240, 360, 480]
    .map((width) => `${R2_BASE}/heroes/cards/${encodedId}-${width}.webp?v=${HERO_IMAGE_VERSION} ${width}w`)
    .join(", ");
}

function heroThumbImg(id: string): string {
  return `${R2_BASE}/heroes/thumbs/${encodeURIComponent(id)}-96.webp?v=${HERO_IMAGE_VERSION}`;
}

const iconUrl = (type: string, value: string) =>
  value ? `${R2_BASE}/icons/${type}/${value.toLowerCase()}.webp` : null;

const RELEASE_DATE_PLACEHOLDERS = new Set(["tbd", "tba", "unknown", "n/a", "na", "none", "-", "—", "?", "placeholder"]);

function visibleReleaseDate(value?: string): string | null {
  const date = value?.trim();
  return date && !RELEASE_DATE_PLACEHOLDERS.has(date.toLowerCase()) ? date : null;
}

function resolveEntry(entry: ScheduleEntry) {
  const h = heroMap.get(entry.id) || {};
  const r = ratedHeroMap.get(entry.id)?.ratings ?? {};
  const faction = h.faction || "";
  const heroClass = h.class || "";
  const role = h.role || "";
  return {
    id: entry.id,
    displayName: entry.displayName || h.name || entry.id,
    faction,
    heroClass,
    role,
    classIconUrl: heroClass ? iconUrl("classes", heroClass) : null,
    factionIconUrl: faction ? iconUrl("factions", faction) : null,
    roleIconUrl: role ? iconUrl("roles", role) : null,
    rarity: h.rarity || "Legendary",
    overallRating: r.overall || "?",
    pvpRating: r.pvpendgame || "?",
    pveRating: r.pveendgame || "?",
    status: entry.status,
    order: entry.order,
    releaseDate: visibleReleaseDate(entry.releaseDate),
    hasDetailPage: heroPageIds.has(entry.id),
    pullQuality: entry.pullQuality ? PULL_QUALITY_META[entry.pullQuality] : null,
  };
}

const upcoming = schedule.filter(e => e.status === "upcoming").map(resolveEntry);
const released = schedule.filter(e => e.status === "released").map(resolveEntry);

---

<Base
  title="Hero Roadmap - Motto Immortal"
  description="Track upcoming hero releases for Motto Immortal. See what heroes are coming soon based on extracted game data."
>
  <PageHero
    id="summon-calendar"
    tag="Summoning Tools"
    headline="Hero Roadmap"
    subtitle="Plan your resources around the most likely upcoming hero releases."
  />

  <main class="page-wrapper page-wrap page-content">
    <section class="calendar-intro">
      <div>
        <span class="section-label">Release forecast</span>
        <h2>What should you save for next?</h2>
        <p>The closest releases matter most. Later entries are useful planning signals, but their order can still change. Dates are guessed.</p>
      </div>
    </section>

    <!-- COMING SOON SPOTLIGHT -->
    <section class="section">
      <div class="calendar-section-heading">
        <div>
          <span class="section-label">Highest relevance</span>
          <h2>Upcoming Heroes</h2>
        </div>
        <span>{upcoming.length} projected releases</span>
      </div>
      <div class="spotlight-grid">
        {upcoming.map((hero, i) => (
          <a href={`/heroes/${hero.id}`} class="spotlight-card">
            <div class="spotlight-order">{hero.order}</div>
            {hero.pullQuality && (
              <div class={`pull-badge pull-badge-corner ${hero.pullQuality.className}`}>{hero.pullQuality.label}</div>
            )}
            <div class="spotlight-img-wrap">
              <img
                class="spotlight-img"
                src={heroCardImg(hero.id)}
                srcset={heroCardSrcset(hero.id)}
                sizes={SPOTLIGHT_IMAGE_SIZES}
                alt={hero.displayName}
                width="360"
                height="360"
                decoding="async"
                fetchpriority={i === 0 ? "high" : "low"}
                onerror={`this.onerror=()=>{this.onerror=null;this.src='${HERO_PLACEHOLDER}';this.parentElement.classList.add('img-missing')};this.srcset='';this.src='${heroImg(hero.id)}'`}
              />
              <div class="spotlight-img-fade"></div>
            </div>
            <div class="spotlight-body">
              <div class="hero-meta-row">
                {hero.classIconUrl ? <img src={hero.classIconUrl} alt={hero.heroClass} class="meta-icon" title={hero.heroClass} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.heroClass}>?</span>}
                {hero.factionIconUrl ? <img src={hero.factionIconUrl} alt={hero.faction} class="meta-icon" title={hero.faction} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.faction}>?</span>}
                {hero.roleIconUrl ? <img src={hero.roleIconUrl} alt={hero.role} class="meta-icon" title={hero.role} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.role}>?</span>}
              </div>
              <h3 class="spotlight-name">{hero.displayName}</h3>
              <div class="hero-detail-row">
                <p class="hero-role">{hero.role}</p>
                {hero.releaseDate && <time class="hero-release-date">{hero.releaseDate}</time>}
              </div>
            </div>

          </a>
        ))}
      </div>
    </section>

    <!-- FULL TIMELINE -->
    <section class="section">
      <div class="calendar-section-heading">
        <div>
          <span class="section-label">Complete sequence</span>
          <h2>Release Timeline</h2>
        </div>
        <span>{schedule.length} heroes tracked</span>
      </div>
      <div class="timeline">
       
        <!-- released group -->
        <div class="timeline-group-label">
          <span class="tgl-dot released-dot"></span>
          Already Released
        </div>
        {released.map((hero) => (
          <a href={`/heroes/${hero.id}`} class="timeline-row released-row">
            <div class="tl-order">{hero.order}</div>
            <img class="tl-portrait" src={heroThumbImg(hero.id)} alt={hero.displayName} width="44" height="44" loading="lazy" decoding="async" onerror={`this.onerror=()=>{this.style.display='none';this.insertAdjacentHTML('afterend','<div class=\\'tl-portrait tl-portrait-missing\\'>?</div>')};this.src='${heroImg(hero.id)}'`} />
            <div class="tl-info">
              <span class="tl-name">{hero.displayName}</span>
              <span class="tl-sub">
                {hero.role}
                {hero.releaseDate && <><span aria-hidden="true"> · </span><time class="tl-release-date">{hero.releaseDate}</time></>}
              </span>
            </div>
            <div class="tl-faction">{hero.factionIconUrl ? <img src={hero.factionIconUrl} alt={hero.faction} class="tl-icon" /> : null}</div>
            <div class="tl-ratings"><span class="tl-pill" data-tier={hero.overallRating}>{hero.overallRating}</span></div>
            <div class="tl-status-badge released-badge">Released</div>
          </a>
        ))}

      </div>
    </section>

  </main>
</Base>

<style>
  .page-wrap {
    width: 100%;
    max-width: var(--page-max-width);
    padding: var(--page-content-start) var(--page-gutter) var(--space-20);
  }

  .calendar-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .calendar-intro > div:first-child {
    max-width: 720px;
  }

  .calendar-intro h2,
  .calendar-section-heading h2 {
    margin: var(--space-2) 0 0;
    color: var(--text-bright);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    line-height: var(--leading-tight);
  }

  .calendar-intro p {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-loose);
  }

  .forecast-key {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .forecast-key span {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .forecast-key i {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
  }

  .soon-key {
    background: var(--accent-gold);
  }

  .future-key {
    background: var(--accent-purple);
  }

  .calendar-section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .calendar-section-heading > span {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* ---- Header ---- */
  .page-header {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 28px 28px 20px;
    margin-bottom: 40px;
    overflow: hidden;
  }

  .header-deco {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 0%, rgba(250, 204, 21, 0.07) 0%, transparent 60%),
                radial-gradient(ellipse at 20% 100%, rgba(168, 85, 247, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .header-content {
    display: flex;
    align-items: center;
    gap: 18px;
    position: relative;
  }

  .header-icon {
    width: 52px;
    height: 52px;
    background: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--accent-gold);
  }

  .header-icon svg {
    width: 26px;
    height: 26px;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-bright);
    margin: 0 0 4px;
    letter-spacing: -0.01em;
  }

  .page-subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .disclaimer {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    padding: 9px 14px;
    background: rgba(250, 204, 21, 0.05);
    border: 1px solid rgba(250, 204, 21, 0.12);
    border-radius: 8px;
    font-size: 0.78rem;
    color: rgba(250, 204, 21, 0.7);
    position: relative;
  }

  /* ---- Section ---- */
  .section {
    margin-bottom: 48px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-bright);
    margin: 0 0 20px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .section-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-soon {
    background: #facc15;
    box-shadow: 0 0 8px rgba(250, 204, 21, 0.6);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .dot-future { background: #a855f7; }
  .dot-all    { background: var(--text-muted); }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(250, 204, 21, 0.6); }
    50%       { opacity: 0.6; box-shadow: 0 0 4px rgba(250, 204, 21, 0.2); }
  }

  /* ---- Spotlight Grid ---- */
  .spotlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }

  .spotlight-card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
    border-color: rgba(var(--faction-color-rgb, 250, 204, 21), 0.2);
    box-shadow: 0 0 0 0 transparent;
  }

  .spotlight-card:hover {
    transform: translateY(-4px);
    border-color: var(--faction-color);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), 0 0 20px rgba(var(--faction-color-rgb, 250, 204, 21), 0.12);
  }

  .future-card {
    opacity: 0.65;
    filter: saturate(0.5);
  }

  .future-card:hover {
    opacity: 0.9;
    filter: saturate(1);
  }

  .spotlight-card.is-disabled {
    cursor: default;
  }

  .spotlight-card.is-disabled:hover {
    transform: none;
    border-color: rgba(var(--faction-color-rgb, 250, 204, 21), 0.2);
    box-shadow: none;
    opacity: 0.65;
    filter: saturate(0.5);
  }

  .spotlight-order {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 3;
    width: 26px;
    height: 26px;
    background: rgba(7, 6, 12, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-secondary);
    backdrop-filter: blur(4px);
  }

  .spotlight-img-wrap {
    position: relative;
    width: 100%;
    padding-top: 100%;
    overflow: hidden;
    background-color: #0d1624;
    background-image: url(https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/hall.webp);
    background-size: cover;
    background-position: center top;
  }

  .spotlight-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.35s ease;
  }

  .spotlight-img-wrap.img-missing::after {
    content: "?";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .spotlight-card:hover .spotlight-img {
    transform: scale(1.06);
  }

  .spotlight-img-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, var(--bg-surface), transparent);
    pointer-events: none;
  }

  .spotlight-body {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .meta-icon {
    width: 22px;
    height: 22px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .icon-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 4px;
    background: linear-gradient(135deg, #6b7280, #374151);
    font-size: 0.65rem;
    font-weight: 800;
    color: #f3f4f6;
    flex-shrink: 0;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .spotlight-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-bright);
    margin: 0;
    line-height: 1.2;
  }

  .hero-role {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }

  .hero-detail-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .hero-release-date {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--accent-gold);
    white-space: nowrap;
  }

  .hero-note {
    font-size: 0.7rem;
    color: rgba(168, 85, 247, 0.8);
    margin: 0;
    font-style: italic;
    background: rgba(168, 85, 247, 0.06);
    border-radius: 4px;
    padding: 3px 6px;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .rating-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rating-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 22px;
    padding: 0 7px;
    border-radius: 5px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .rating-pill.small {
    min-width: 26px;
    height: 18px;
    font-size: 0.68rem;
  }

  /* ---- Timeline ---- */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .timeline-group-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    padding: 16px 0 6px;
    border-bottom: 1px solid var(--border-faint);
    margin-bottom: 2px;
  }

  .tgl-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .released-dot   { background: #6b7280; }
  .soon-dot       { background: #facc15; box-shadow: 0 0 6px rgba(250, 204, 21, 0.5); }
  .future-tgl-dot { background: #a855f7; }

  .timeline-row {
    display: grid;
    grid-template-columns: 32px 48px 1fr auto auto auto;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s ease;
    border: 1px solid transparent;
  }

  .timeline-row:hover {
    background: var(--bg-raised);
    border-color: var(--border-subtle);
  }

  .released-row { opacity: 0.6; }
  .released-row:hover { opacity: 1; }

  .future-row { opacity: 0.45; filter: saturate(0.4); }
  .future-row:hover { opacity: 0.85; filter: saturate(1); }
  .timeline-row.is-disabled { cursor: default; }
  .timeline-row.is-disabled:hover { background: transparent; border-color: transparent; opacity: 0.45; filter: saturate(0.4); }

  .tl-order {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-align: center;
  }

  .tl-portrait {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    object-position: center top;
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .tl-portrait-missing {
    display: flex !important;
    align-items: center;
    justify-content: center;
    background: var(--bg-raised);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .future-portrait {
    filter: grayscale(0.5);
  }

  .tl-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .tl-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tl-sub {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
  }

  .tl-release-date {
    color: var(--accent-gold);
  }

  .tl-faction {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tl-icon {
    width: 20px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .tl-ratings {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .tl-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 20px;
    padding: 0 5px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .tl-status-badge {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .released-badge {
    background: rgba(107, 114, 128, 0.15);
    color: #9ca3af;
    border: 1px solid rgba(107, 114, 128, 0.2);
  }

  .soon-badge {
    background: rgba(250, 204, 21, 0.12);
    color: #facc15;
    border: 1px solid rgba(250, 204, 21, 0.25);
