---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import allHeroes from "../data/all_heroes_db.json";
import heroRatings from "../data/ratings/hero-ratings.json";
import { heroes as heroPages } from "../data/heroes/withRatings";

type Status = "released" | "coming-soon" | "far-future";
type PullQuality = "pull" | "optional" | "whales-only" | "skip" | "unsure";

interface ScheduleEntry {
  id: string;
  displayName?: string;
  status: Status;
  order: number;
  pullQuality?: PullQuality;
}

const PULL_QUALITY_META: Record<PullQuality, { label: string; className: string }> = {
  "pull":   { label: "Pull",   className: "pull-must" },
  "optional":    { label: "Optional",    className: "pull-optional" },
  "unsure":      { label: "Unsure", className: "pull-optional"},
  "whales-only": { label: "Whales Only", className: "pull-whales" },
  "skip":        { label: "Skip",        className: "pull-skip" },
};

const schedule: ScheduleEntry[] = [
  { id: "hladgunnr",     status: "released",    order: 1 },
  { id: "nezha",         status: "released",    order: 2 },
  { id: "tefnut",        status: "released",    order: 3 },
  { id: "heracles",      status: "released",    order: 4 },
  { id: "nuba",          status: "released",    order: 5 },
  { id: "mengpo",        status: "released",    order: 6 },
  { id: "skadi",         status: "released",    order: 7 },
  { id: "cronus",        status: "released",    order: 8 },
  { id: "wenshen",       status: "released",    order: 9 },
  { id: "meret",         status: "released",    order: 10 },
  { id: "hephaestus",    status: "released", order: 11 },
  { id: "serket",        status: "released", order: 12 },
  { id: "hera",          status: "released", order: 13 },
  { id: "eris",          status: "released", order: 14 },
  { id: "nut",          status: "released", order: 15 },
  { id: "xuannv",       status: "released", order: 16 },
  { id: "nephtys",          status: "released", order: 17 },
  { id: "idunn",     status: "released", order: 18 },
  { id: "hades",      status: "released", order: 19, pullQuality: "whales-only" },
  { id: "audhumla",         status: "coming-soon", order: 20, pullQuality: "unsure"},
  { id: "hebo",         status: "coming-soon", order: 21, pullQuality: "skip" },
  { id: "heket",         status: "coming-soon", order: 22, pullQuality: "optional" },
  { id: "zaojun",         status: "coming-soon", order: 23, pullQuality: "pull" },
  { id: "yaoji",         status: "far-future", order: 24, pullQuality: "pull" },
  { id: "mazu",         status: "far-future", order: 25, pullQuality: "optional" },
  { id: "gaiya",         status: "far-future", order: 26, pullQuality: "whales-only" },
  { id: "charon",         status: "far-future", order: 27, pullQuality: "skip" },
  { id: "ananke",         status: "far-future", order: 28, pullQuality: "skip" },
  
];

const heroMap = new Map(Object.values(allHeroes as Record<string, any>).map((h: any) => [h.id, h]));
const heroPageIds = new Set((heroPages as any[]).map((h) => h.id));

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const HERO_PLACEHOLDER = `${R2_BASE}/heroes/placeholder.png`;
const HERO_IMAGE_VERSION = "2026-06-08-portrait";
const SPOTLIGHT_IMAGE_SIZES = "(max-width: 400px) calc(100vw - 40px), (max-width: 600px) calc((100vw - 56px) / 2), 220px";

function heroImg(id: string): string {
  return `${R2_BASE}/heroes/${encodeURIComponent(id)}.webp`;
}

function heroCardImg(id: string, width = 360): string {
  return `${R2_BASE}/heroes/cards/${encodeURIComponent(id)}-${width}.webp?v=${HERO_IMAGE_VERSION}`;
}

function heroCardSrcset(id: string): string {
  const encodedId = encodeURIComponent(id);
  return [240, 360, 480]
    .map((width) => `${R2_BASE}/heroes/cards/${encodedId}-${width}.webp?v=${HERO_IMAGE_VERSION} ${width}w`)
    .join(", ");
}

function heroThumbImg(id: string): string {
  return `${R2_BASE}/heroes/thumbs/${encodeURIComponent(id)}-96.webp?v=${HERO_IMAGE_VERSION}`;
}

const iconUrl = (type: string, value: string) =>
  value ? `${R2_BASE}/icons/${type}/${value.toLowerCase()}.webp` : null;

function resolveEntry(entry: ScheduleEntry) {
  const h = heroMap.get(entry.id) || {};
  const r = (heroRatings as Record<string, any>)?.[entry.id] ?? {};
  const faction = h.faction || "";
  const heroClass = h.class || "";
  const role = h.role || "";
  return {
    id: entry.id,
    displayName: entry.displayName || h.name || entry.id,
    faction,
    heroClass,
    role,
    classIconUrl: heroClass ? iconUrl("classes", heroClass) : null,
    factionIconUrl: faction ? iconUrl("factions", faction) : null,
    roleIconUrl: role ? iconUrl("roles", role) : null,
    rarity: h.rarity || "Legendary",
    overallRating: r.overall || "?",
    pvpRating: r.pvp || "?",
    pveRating: r.pve || "?",
    status: entry.status,
    order: entry.order,
    hasDetailPage: heroPageIds.has(entry.id),
    pullQuality: entry.pullQuality ? PULL_QUALITY_META[entry.pullQuality] : null,
  };
}

const released = schedule.filter(e => e.status === "released").map(resolveEntry);
const comingSoon = schedule.filter(e => e.status === "coming-soon").map(resolveEntry);
const farFuture = schedule.filter(e => e.status === "far-future").map(resolveEntry);

---

<Base
  title="Summon Calendar - Motto Immortal"
  description="Track upcoming hero releases for Motto Immortal. See what heroes are coming soon based on extracted game data."
>
  <PageHero
    id="summon-calendar"
    tag="Summoning Tools"
    headline="Summon Calendar"
    subtitle="Plan your resources around the most likely upcoming hero releases."
  />

  <main class="page-wrapper page-wrap page-content">
    <section class="calendar-intro">
      <div>
        <span class="section-label">Release forecast</span>
        <h2>What should you save for next?</h2>
        <p>The closest releases matter most. Later entries are useful planning signals, but their order can still change.</p>
      </div>
      <div class="forecast-key" aria-label="Forecast confidence">
        <span><i class="soon-key"></i> Coming next</span>
        <span><i class="future-key"></i> More speculative</span>
      </div>
    </section>

    <!-- COMING SOON SPOTLIGHT -->
    <section class="section">
      <div class="calendar-section-heading">
        <div>
          <span class="section-label">Highest relevance</span>
          <h2>Coming Next</h2>
        </div>
        <span>{comingSoon.length} projected releases</span>
      </div>
      <div class="spotlight-grid">
        {comingSoon.map((hero, i) => (
          <a href={`/heroes/${hero.id}`} class="spotlight-card">
            <div class="spotlight-order">{hero.order}</div>
            {hero.pullQuality && (
              <div class={`pull-badge pull-badge-corner ${hero.pullQuality.className}`}>{hero.pullQuality.label}</div>
            )}
            <div class="spotlight-img-wrap">
              <img
                class="spotlight-img"
                src={heroCardImg(hero.id)}
                srcset={heroCardSrcset(hero.id)}
                sizes={SPOTLIGHT_IMAGE_SIZES}
                alt={hero.displayName}
                width="360"
                height="360"
                decoding="async"
                fetchpriority={i === 0 ? "high" : "low"}
                onerror={`this.onerror=()=>{this.onerror=null;this.src='${HERO_PLACEHOLDER}';this.parentElement.classList.add('img-missing')};this.srcset='';this.src='${heroImg(hero.id)}'`}
              />
              <div class="spotlight-img-fade"></div>
            </div>
            <div class="spotlight-body">
              <div class="hero-meta-row">
                {hero.classIconUrl ? <img src={hero.classIconUrl} alt={hero.heroClass} class="meta-icon" title={hero.heroClass} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.heroClass}>?</span>}
                {hero.factionIconUrl ? <img src={hero.factionIconUrl} alt={hero.faction} class="meta-icon" title={hero.faction} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.faction}>?</span>}
                {hero.roleIconUrl ? <img src={hero.roleIconUrl} alt={hero.role} class="meta-icon" title={hero.role} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.role}>?</span>}
              </div>
              <h3 class="spotlight-name">{hero.displayName}</h3>
              <p class="hero-role">{hero.role}</p>
            </div>

          </a>
        ))}
      </div>
    </section>

    <!-- FULL TIMELINE -->
    <section class="section">
      <div class="calendar-section-heading">
        <div>
          <span class="section-label">Complete sequence</span>
          <h2>Release Timeline</h2>
        </div>
        <span>{schedule.length} heroes tracked</span>
      </div>
      <div class="timeline">
        <!-- released group -->
        <div class="timeline-group-label">
          <span class="tgl-dot released-dot"></span>
          Already Released
        </div>
        {released.map((hero) => (
          <a href={`/heroes/${hero.id}`} class="timeline-row released-row">
            <div class="tl-order">{hero.order}</div>
            <img
              class="tl-portrait"
              src={heroThumbImg(hero.id)}
              alt={hero.displayName}
              width="44"
              height="44"
              loading="lazy"
              decoding="async"
              onerror={`this.onerror=()=>{this.style.display='none';this.insertAdjacentHTML('afterend','<div class=\\'tl-portrait tl-portrait-missing\\'>?</div>')};this.src='${heroImg(hero.id)}'`}
            />
            <div class="tl-info">
              <span class="tl-name">{hero.displayName}</span>
              <span class="tl-sub">
                {hero.classIconUrl ? <img src={hero.classIconUrl} alt={hero.heroClass} class="tl-icon" title={hero.heroClass} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.heroClass}>?</span>}
                {hero.roleIconUrl ? <img src={hero.roleIconUrl} alt={hero.role} class="tl-icon" title={hero.role} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.role}>?</span>}
              </span>
            </div>
            <div class="tl-faction">
              {hero.factionIconUrl ? <img src={hero.factionIconUrl} alt={hero.faction} class="tl-icon" title={hero.faction} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.faction}>?</span>}
            </div>
            <div class="tl-ratings">
              <span class="tl-pill" data-tier={hero.overallRating}>{hero.overallRating}</span>
            </div>
            <div class="tl-status-badge released-badge">Released</div>
          </a>
        ))}

        <!-- coming soon group -->
        <div class="timeline-group-label">
          <span class="tgl-dot soon-dot"></span>
          Coming Soon
        </div>
	        {comingSoon.map((hero) => (
	          <a href={`/heroes/${hero.id}`} class="timeline-row soon-row">
	            <div class="tl-order">{hero.order}</div>
	            <img
                class="tl-portrait"
                src={heroThumbImg(hero.id)}
                alt={hero.displayName}
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
                onerror={`this.onerror=()=>{this.onerror=null;this.src='${HERO_PLACEHOLDER}'};this.src='${heroImg(hero.id)}'`}
              />
            <div class="tl-info">
              <span class="tl-name">{hero.displayName}</span>
              <span class="tl-sub">
                {hero.classIconUrl ? <img src={hero.classIconUrl} alt={hero.heroClass} class="tl-icon" title={hero.heroClass} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.heroClass}>?</span>}
                {hero.roleIconUrl ? <img src={hero.roleIconUrl} alt={hero.role} class="tl-icon" title={hero.role} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.role}>?</span>}
              </span>
            </div>
            <div class="tl-faction">
              {hero.factionIconUrl ? <img src={hero.factionIconUrl} alt={hero.faction} class="tl-icon" title={hero.faction} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.faction}>?</span>}
            </div>
            <div class="tl-ratings" aria-hidden={hero.pullQuality ? undefined : "true"}>
              {hero.pullQuality && (
                <span class={`pull-badge ${hero.pullQuality.className}`}>{hero.pullQuality.label}</span>
              )}
            </div>
            <div class="tl-status-badge soon-badge">Soon</div>
          </a>
        ))}

        <!-- far future group -->
        {farFuture.length > 0 && (
          <>
            <div class="timeline-group-label">
              <span class="tgl-dot future-tgl-dot"></span>
              Far Future
            </div>
            {farFuture.map((hero) => (
              hero.hasDetailPage ? (
                <a href={`/heroes/${hero.id}`} class="timeline-row future-row">
                  <div class="tl-order">{hero.order}</div>
                  <img
                    class="tl-portrait future-portrait"
                    src={heroThumbImg(hero.id)}
                    alt={hero.displayName}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                    onerror={`this.onerror=()=>{this.onerror=null;this.src='${HERO_PLACEHOLDER}'};this.src='${heroImg(hero.id)}'`}
                  />
                  <div class="tl-info">
                    <span class="tl-name">{hero.displayName}</span>
                    <span class="tl-sub">
                      {hero.classIconUrl ? <img src={hero.classIconUrl} alt={hero.heroClass} class="tl-icon" title={hero.heroClass} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.heroClass}>?</span>}
                      {hero.roleIconUrl ? <img src={hero.roleIconUrl} alt={hero.role} class="tl-icon" title={hero.role} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.role}>?</span>}
                    </span>
                  </div>
                  <div class="tl-faction">
                    {hero.factionIconUrl ? <img src={hero.factionIconUrl} alt={hero.faction} class="tl-icon" title={hero.faction} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.faction}>?</span>}
                  </div>
                  <div class="tl-ratings" aria-hidden={hero.pullQuality ? undefined : "true"}>
                    {hero.pullQuality && (
                      <span class={`pull-badge ${hero.pullQuality.className}`}>{hero.pullQuality.label}</span>
                    )}
                  </div>
                  <div class="tl-status-badge future-badge-tl">Far Future</div>
                </a>
              ) : (
                <div class="timeline-row future-row is-disabled" aria-disabled="true" title="No hero detail page yet">
                  <div class="tl-order">{hero.order}</div>
                  <img
                    class="tl-portrait future-portrait"
                    src={heroThumbImg(hero.id)}
                    alt={hero.displayName}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                    onerror={`this.onerror=()=>{this.onerror=null;this.src='${HERO_PLACEHOLDER}'};this.src='${heroImg(hero.id)}'`}
                  />
                  <div class="tl-info">
                    <span class="tl-name">{hero.displayName}</span>
                    <span class="tl-sub">
                      {hero.classIconUrl ? <img src={hero.classIconUrl} alt={hero.heroClass} class="tl-icon" title={hero.heroClass} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.heroClass}>?</span>}
                      {hero.roleIconUrl ? <img src={hero.roleIconUrl} alt={hero.role} class="tl-icon" title={hero.role} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.role}>?</span>}
                    </span>
                  </div>
                  <div class="tl-faction">
                    {hero.factionIconUrl ? <img src={hero.factionIconUrl} alt={hero.faction} class="tl-icon" title={hero.faction} onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'icon-fallback\'>?</span>')" /> : <span class="icon-fallback" title={hero.faction}>?</span>}
                  </div>
                  <div class="tl-ratings" aria-hidden={hero.pullQuality ? undefined : "true"}>
                    {hero.pullQuality && (
                      <span class={`pull-badge ${hero.pullQuality.className}`}>{hero.pullQuality.label}</span>
                    )}
                  </div>
                  <div class="tl-status-badge future-badge-tl">Far Future</div>
                </div>
              )
            ))}
          </>
        )}
      </div>
    </section>

  </main>
</Base>

<style>
  .page-wrap {
    width: 100%;
    max-width: var(--page-max-width);
    padding: 0 var(--page-gutter) var(--space-20);
  }

  .calendar-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .calendar-intro > div:first-child {
    max-width: 720px;
  }

  .calendar-intro h2,
  .calendar-section-heading h2 {
    margin: var(--space-2) 0 0;
    color: var(--text-bright);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    line-height: var(--leading-tight);
  }

  .calendar-intro p {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-loose);
  }

  .forecast-key {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .forecast-key span {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .forecast-key i {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
  }

  .soon-key {
    background: var(--accent-gold);
  }

  .future-key {
    background: var(--accent-purple);
  }

  .calendar-section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .calendar-section-heading > span {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* ---- Header ---- */
  .page-header {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 28px 28px 20px;
    margin-bottom: 40px;
    overflow: hidden;
  }

  .header-deco {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 0%, rgba(250, 204, 21, 0.07) 0%, transparent 60%),
                radial-gradient(ellipse at 20% 100%, rgba(168, 85, 247, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .header-content {
    display: flex;
    align-items: center;
    gap: 18px;
    position: relative;
  }

  .header-icon {
    width: 52px;
    height: 52px;
    background: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--accent-gold);
  }

  .header-icon svg {
    width: 26px;
    height: 26px;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-bright);
    margin: 0 0 4px;
    letter-spacing: -0.01em;
  }

  .page-subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .disclaimer {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    padding: 9px 14px;
    background: rgba(250, 204, 21, 0.05);
    border: 1px solid rgba(250, 204, 21, 0.12);
    border-radius: 8px;
    font-size: 0.78rem;
    color: rgba(250, 204, 21, 0.7);
    position: relative;
  }

  /* ---- Section ---- */
  .section {
    margin-bottom: 48px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-bright);
    margin: 0 0 20px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .section-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-soon {
    background: #facc15;
    box-shadow: 0 0 8px rgba(250, 204, 21, 0.6);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .dot-future { background: #a855f7; }
  .dot-all    { background: var(--text-muted); }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(250, 204, 21, 0.6); }
    50%       { opacity: 0.6; box-shadow: 0 0 4px rgba(250, 204, 21, 0.2); }
  }

  /* ---- Spotlight Grid ---- */
  .spotlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }

  .spotlight-grid .spotlight-card:first-child {
    display: grid;
    grid-column: span 2;
    grid-template-columns: minmax(220px, 0.9fr) minmax(0, 1.1fr);
  }

  .spotlight-grid .spotlight-card:first-child .spotlight-img-wrap {
    min-height: 300px;
    padding-top: 0;
  }

  .spotlight-grid .spotlight-card:first-child .spotlight-body {
    justify-content: center;
    padding: var(--space-8);
  }

  .spotlight-grid .spotlight-card:first-child .spotlight-name {
    font-size: var(--text-3xl);
  }

  .spotlight-card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
