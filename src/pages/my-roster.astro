---
import Base from "../layouts/Base.astro";
import allHeroesDb from "../data/all_heroes_db.json";

const heroList = Object.values(allHeroesDb as Record<string, any>)
  .map((h: any) => ({ id: h.id, name: h.name, image: h.image }))
  .sort((a: any, b: any) => a.name.localeCompare(b.name));
---

<Base title="My Roster | Motto Immortal" description="My Motto Immortal hero roster.">

<div class="page-wrapper">
  <div class="main-content">

    <div class="roster-header">
      <div class="page-header">
        <h1 class="page-title">My Roster</h1>
        <p class="page-subtitle" id="rosterSubtitle">Loading...</p>
      </div>
      <div class="roster-actions" id="editActions">
        <div class="roster-level-wrap">
          <label class="roster-level-label" for="globalLevel">Hero Level</label>
          <input
            type="number"
            class="roster-input roster-level-input"
            id="globalLevel"
            min="1"
            max="300"
            value="300"
          />
        </div>
        <div class="roster-picker-wrap">
          <input
            type="text"
            class="roster-picker-input"
            id="heroSearch"
            placeholder="Add hero..."
            autocomplete="off"
          />
          <div class="roster-dropdown" id="heroDropdown" hidden></div>
        </div>
        <button class="btn btn-primary" id="shareBtn">Copy Share Link</button>
        <button class="btn btn-ghost" id="clearBtn">Clear All</button>
      </div>
      <div class="roster-actions" id="viewActions" hidden>
        <span class="roster-mode-badge is-view">Shared Roster</span>
      </div>
    </div>

    <div id="viewInfo" hidden class="roster-view-info">
      <div class="roster-view-title">Hero Roster</div>
      <div class="roster-view-sub" id="viewHeroCount"></div>
    </div>

    <div class="roster-grid" id="rosterGrid">
      <div class="roster-empty">No heroes added yet.</div>
    </div>

  </div>
</div>

<div class="roster-share-toast" id="shareToast">Link copied!</div>

<script define:vars={{ heroList }}>
  const EVOLUTIONS = [
    "None",
    "Epic", "Epic+",
    "Legendary", "Legendary+",
    "Exalted", "Exalted+",
    "Mythic",
    "Divine", "Divine I", "Divine II", "Divine III", "Divine IV", "Divine V"
  ];
  const STORAGE_KEY = "hero-roster-v1";

  const heroes = heroList;
  // rosterData shape: { level: number, heroes: [{id, relic, evolution}] }
  var rosterData = { level: 300, heroes: [] };
  var isViewMode = false;

  // --- normalize old array format or new object format ---
  function normalizeRosterData(raw) {
    if (Array.isArray(raw)) {
      var lvl = (raw.length > 0 && raw[0].level) ? raw[0].level : 300;
      return {
        level: lvl,
        heroes: raw.map(function(h) {
          return { id: h.id, relic: h.relic != null ? h.relic : 30, evolution: h.evolution || "None" };
        })
      };
    }
    if (raw && typeof raw === "object" && Array.isArray(raw.heroes)) {
      return raw;
    }
    return { level: 300, heroes: [] };
  }

  function encodeRoster(data) {
    return btoa(unescape(encodeURIComponent(JSON.stringify(data))));
  }

  function decodeRoster(str) {
    try {
      return JSON.parse(decodeURIComponent(escape(atob(str))));
    } catch (_) {
      return null;
    }
  }

  function saveRoster() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(rosterData));
  }

  function loadRoster() {
    try {
      var raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
      return normalizeRosterData(raw);
    } catch (_) {
      return { level: 300, heroes: [] };
    }
  }

  function heroById(id) {
    return heroes.find(function(h) { return h.id === id; });
  }

  function applyBgImages(container) {
    container.querySelectorAll(".roster-card-img[data-img]").forEach(function(el) {
      el.style.backgroundImage = "url('" + el.dataset.img + "')";
    });
    container.querySelectorAll(".roster-dropdown-thumb[data-img]").forEach(function(el) {
      el.style.backgroundImage = "url('" + el.dataset.img + "')";
    });
  }

  function cardHtml(entry) {
    var hero = heroById(entry.id);
    if (!hero) return "";
    var evo = entry.evolution || "None";
    var evoBadgeClass = evo === "None" ? "roster-evolution-badge evo-none" : "roster-evolution-badge";

    if (isViewMode) {
      return '<div class="roster-card">'
        + '<div class="roster-card-img" data-img="' + hero.image + '"></div>'
        + '<div class="roster-card-body">'
        + '<div class="roster-card-name">' + hero.name + '</div>'
        + '<div><span class="' + evoBadgeClass + '">' + evo + '</span></div>'
        + '<div class="roster-card-stats">'
        + '<span class="roster-stat-label">Relic</span><span class="roster-stat-value">' + entry.relic + '</span>'
        + '</div>'
        + '</div>'
        + '</div>';
    }

    var evoOptions = EVOLUTIONS.map(function(e) {
      return '<option value="' + e + '"' + (e === evo ? ' selected' : '') + '>' + e + '</option>';
    }).join("");

    return '<div class="roster-card" data-hero-id="' + entry.id + '">'
      + '<div class="roster-card-img" data-img="' + hero.image + '"></div>'
      + '<button class="roster-remove-btn" data-remove="' + entry.id + '" title="Remove">x</button>'
      + '<div class="roster-card-body">'
      + '<div class="roster-card-name">' + hero.name + '</div>'
      + '<div class="roster-card-inputs">'
      + '<div class="roster-input-row">'
      + '<span class="roster-input-label">Relic</span>'
      + '<input class="roster-input" type="number" min="0" max="30" value="' + entry.relic + '" data-field="relic" data-hero="' + entry.id + '" />'
      + '</div>'
      + '<div class="roster-input-row">'
      + '<span class="roster-input-label">Evo</span>'
      + '<select class="roster-input" data-field="evolution" data-hero="' + entry.id + '">' + evoOptions + '</select>'
      + '</div>'
      + '</div>'
      + '</div>'
      + '</div>';
  }

  function renderGrid() {
    var grid = document.getElementById("rosterGrid");
    if (rosterData.heroes.length === 0) {
      grid.innerHTML = '<div class="roster-empty">No heroes added yet.</div>';
      return;
    }
    grid.innerHTML = rosterData.heroes.map(cardHtml).join("");
    applyBgImages(grid);

    if (!isViewMode) {
      grid.querySelectorAll("[data-remove]").forEach(function(btn) {
        btn.addEventListener("click", function() {
          var id = btn.dataset.remove;
          rosterData.heroes = rosterData.heroes.filter(function(e) { return e.id !== id; });
          saveRoster();
          renderGrid();
          updateSubtitle();
        });
      });

      grid.querySelectorAll("[data-field]").forEach(function(input) {
        input.addEventListener("change", function() {
          var id = input.dataset.hero;
          var field = input.dataset.field;
          var entry = rosterData.heroes.find(function(e) { return e.id === id; });
          if (entry) {
            if (field === "evolution") {
              entry[field] = input.value;
            } else {
              entry[field] = parseInt(input.value, 10) || 0;
            }
            saveRoster();
          }
        });
      });
    }
  }

  function updateSubtitle() {
    var el = document.getElementById("rosterSubtitle");
    var n = rosterData.heroes.length;
    el.textContent = n === 0 ? "No heroes added" : (n + " hero" + (n === 1 ? "" : "s") + " - Lv " + rosterData.level);
  }

  function buildDropdown(filter) {
    var dropdown = document.getElementById("heroDropdown");
    var addedIds = {};
    rosterData.heroes.forEach(function(e) { addedIds[e.id] = true; });

    var filtered = heroes.filter(function(h) {
      return h.name.toLowerCase().indexOf(filter.toLowerCase()) !== -1;
    }).slice(0, 20);

    if (filtered.length === 0) {
      dropdown.innerHTML = '<div class="roster-dropdown-item is-added">No matches</div>';
    } else {
      dropdown.innerHTML = filtered.map(function(h) {
        var added = !!addedIds[h.id];
        return '<div class="roster-dropdown-item' + (added ? ' is-added' : '') + '" data-pick="' + h.id + '">'
          + '<div class="roster-dropdown-thumb" data-img="' + h.image + '"></div>'
          + '<span>' + h.name + (added ? ' (added)' : '') + '</span>'
          + '</div>';
      }).join("");

      applyBgImages(dropdown);

      dropdown.querySelectorAll("[data-pick]").forEach(function(item) {
        item.addEventListener("mousedown", function(e) {
          e.preventDefault();
          addHero(item.dataset.pick);
        });
      });
    }

    dropdown.hidden = false;
  }

  function addHero(id) {
    if (rosterData.heroes.find(function(e) { return e.id === id; })) return;
    rosterData.heroes.push({ id: id, relic: 30, evolution: "None" });
    saveRoster();
    renderGrid();
    updateSubtitle();
    var search = document.getElementById("heroSearch");
    var dropdown = document.getElementById("heroDropdown");
    search.value = "";
    dropdown.hidden = true;
    search.focus();
  }

  function showToast(msg) {
    var toast = document.getElementById("shareToast");
    toast.textContent = msg;
    toast.classList.add("show");
    setTimeout(function() { toast.classList.remove("show"); }, 2500);
  }

  function initEditMode() {
    rosterData = loadRoster();

    var levelInput = document.getElementById("globalLevel");
    levelInput.value = rosterData.level;

    levelInput.addEventListener("change", function() {
      rosterData.level = parseInt(levelInput.value, 10) || 300;
      saveRoster();
      updateSubtitle();
    });

    renderGrid();
    updateSubtitle();

    var search = document.getElementById("heroSearch");
    var dropdown = document.getElementById("heroDropdown");

    search.addEventListener("input", function() {
      var val = search.value.trim();
      if (val) {
        buildDropdown(val);
      } else {
        dropdown.hidden = true;
      }
    });

    search.addEventListener("focus", function() {
      buildDropdown(search.value.trim() || "");
    });

    search.addEventListener("blur", function() {
      setTimeout(function() { dropdown.hidden = true; }, 160);
    });

    document.getElementById("shareBtn").addEventListener("click", function() {
      if (rosterData.heroes.length === 0) { showToast("Add heroes first!"); return; }
      var encoded = encodeRoster(rosterData);
      var url = location.origin + location.pathname + "?r=" + encoded;
      navigator.clipboard.writeText(url).then(function() {
        showToast("Link copied to clipboard!");
      }).catch(function() {
        prompt("Copy this link:", url);
      });
    });

    document.getElementById("clearBtn").addEventListener("click", function() {
      if (!confirm("Clear all heroes from roster?")) return;
      rosterData.heroes = [];
      saveRoster();
      renderGrid();
      updateSubtitle();
    });
  }

  function initViewMode(encoded) {
    isViewMode = true;
    var raw = decodeRoster(encoded);
    if (!raw) {
      document.getElementById("rosterGrid").innerHTML = '<div class="roster-empty">Invalid roster link.</div>';
      document.getElementById("rosterSubtitle").textContent = "Invalid link";
      return;
    }
    rosterData = normalizeRosterData(raw);

    document.getElementById("editActions").hidden = true;
    document.getElementById("viewActions").hidden = false;
    document.getElementById("viewInfo").hidden = false;
    var n = rosterData.heroes.length;
    var countStr = n + " hero" + (n === 1 ? "" : "s") + " - Lv " + rosterData.level;
    document.getElementById("viewHeroCount").textContent = countStr;
    document.getElementById("rosterSubtitle").textContent = n + " hero" + (n === 1 ? "" : "s");

    renderGrid();
  }

  var params = new URLSearchParams(location.search);
  var rParam = params.get("r");
  if (rParam) {
    initViewMode(rParam);
  } else {
    initEditMode();
  }
</script>

</Base>
