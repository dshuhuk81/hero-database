---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { heroes } from "../data/heroes/withRatings";
import { getCnHeroes, getCnOverview, formatCnValue } from "../utils/cnDiff.js";

const allCnHeroes = getCnHeroes(heroes as any[]);
const cnHeroes = allCnHeroes.filter((h) => h.summary.hasChanges);
const overview = getCnOverview(allCnHeroes);

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const HERO_PLACEHOLDER = `${R2_BASE}/heroes/placeholder.png`;
function heroImg(id: string): string {
  return `${R2_BASE}/heroes/${encodeURIComponent(id)}.webp`;
}

const CHANGE_LABEL: Record<string, string> = {
  buff: "Buff",
  nerf: "Nerf",
  diff: "Different",
  neutral: "Same",
};
---

<Base
  title="CN vs Global - Motto Immortal"
  description="Compare every hero's skills between the original Chinese base and the Global build of Motto Immortal. See where Global diverges from CN - the source version - to anticipate pending balance fixes and reworks."
>
  <PageHero
    id="cn-preview"
    tag="Hero Database"
    headline="CN vs Global"
    subtitle="Compare original Chinese skills with the Global build to spot balance differences, data gaps, and likely future changes."
  />

  <main class="page-wrap page-content">
    <div class="content-heading">
      <div class="content-heading-copy">
        <p class="content-heading-kicker">Balance forecast</p>
        <h2 class="content-heading-title">What could change next</h2>
        <p class="content-heading-description">CN is the source version of the game. Differences can reveal likely Global balance changes, but should guide decisions rather than guarantee them.</p>
      </div>
    </div>

    <section class="section cn-overview-panel surface-panel" aria-label="Comparison overview">
      <div class="cn-overview">
        <div class="cn-stat">
          <span class="cn-stat-num">{overview.changedHeroes}</span>
          <span class="cn-stat-lbl">With differences</span>
        </div>
        <div class="cn-stat cn-stat-buff">
          <span class="cn-stat-num">{overview.buff}</span>
          <span class="cn-stat-lbl">Buffs</span>
        </div>
        <div class="cn-stat cn-stat-nerf">
          <span class="cn-stat-num">{overview.nerf}</span>
          <span class="cn-stat-lbl">Nerfs</span>
        </div>
        <div class="cn-stat cn-stat-diff">
          <span class="cn-stat-num">{overview.diff}</span>
          <span class="cn-stat-lbl">Other diffs</span>
        </div>
        {overview.latestCaptured && (
          <div class="cn-stat">
            <span class="cn-stat-num cn-stat-date">{overview.latestCaptured}</span>
            <span class="cn-stat-lbl">CN snapshot</span>
          </div>
        )}
      </div>
    </section>

    <div class="disclaimer">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><path d="M12 8h.01"/><path d="M11 12h1v4h1"/>
      </svg>
      CN data is manually read from the Chinese client. Numbers are language-agnostic; structural and damage-type differences are flagged and may instead be Global data errors. Treat as a forecast, not a guarantee.
    </div>

    {cnHeroes.length === 0 && (
      <section class="section">
        <p class="cn-empty">No CN comparison data yet. Add a <code>cn</code> block to a hero JSON to populate this page.</p>
      </section>
    )}

    <section class="section">
      <div class="cn-list-heading">
        <div>
          <p class="content-heading-kicker">Changed heroes</p>
          <h2>Compare the values</h2>
        </div>
        <span>{cnHeroes.length} heroes</span>
      </div>
      <div class="cn-hero-list">
        {cnHeroes.map((hero) => (
          <article class="cn-hero-card">
            <a href={`/heroes/${hero.id}#section-cn`} class="cn-hero-head">
              <img
                class="cn-hero-img"
                src={heroImg(hero.id)}
                alt={hero.name}
                loading="lazy"
                onerror={`this.onerror=null;this.src='${HERO_PLACEHOLDER}'`}
              />
              <div class="cn-hero-id">
                <h2 class="cn-hero-name">{hero.name}</h2>
                <p class="cn-hero-meta">{hero.class} &middot; {hero.role} &middot; {hero.faction}</p>
              </div>
              <div class="cn-hero-badges">
                {hero.summary.totals.buff > 0 && <span class="cn-badge cn-badge-buff">{hero.summary.totals.buff} Buff</span>}
                {hero.summary.totals.nerf > 0 && <span class="cn-badge cn-badge-nerf">{hero.summary.totals.nerf} Nerf</span>}
                {hero.summary.totals.diff > 0 && <span class="cn-badge cn-badge-diff">{hero.summary.totals.diff} Diff</span>}
              </div>
            </a>

            <div class="cn-table-wrap">
              <table class="cn-table cn-compare-table">
                <colgroup>
                  <col class="cn-col-skill" />
                  <col class="cn-col-value" />
                  <col class="cn-col-global" />
                  <col class="cn-col-cn" />
                  <col class="cn-col-change" />
                </colgroup>
                <thead>
                  <tr>
                    <th class="cn-cell-skill">Skill</th>
                    <th class="cn-cell-value">Value</th>
                    <th class="cn-cell-global">Global</th>
                    <th class="cn-cell-cn">CN</th>
                    <th class="cn-cell-change">Change</th>
                  </tr>
                </thead>
                <tbody>
                  {hero.summary.skills.flatMap((skill: any) =>
                    skill.changedRows.map((row: any) => (
                      <tr>
                        <td class="cn-cell-skill cn-td-skill" data-label="Skill">{skill.name}</td>
                        <td class="cn-cell-value" data-label="Value">{row.label}</td>
                        <td class="cn-cell-global cn-td-global" data-label="Global">{formatCnValue(row.global, row.unit)}</td>
                        <td class="cn-cell-cn cn-td-cn" data-label="CN">{formatCnValue(row.cn, row.unit)}</td>
                        <td class="cn-cell-change" data-label="Change">
                          <span class={`cn-tag cn-tag-${row.change}`}>{CHANGE_LABEL[row.change] || row.change}</span>
                          {row.movement && (
                            <span class={`cn-move cn-move-${row.movement.direction}`} title={`Global is ${row.movement.label} vs CN`}>
                              <svg viewBox="0 0 24 24" aria-hidden="true">
                                {row.movement.direction === "up" ? (
                                  <><path d="M3 17l6-6 4 4 7-7"/><path d="M14 8h6v6"/></>
                                ) : (
                                  <><path d="M3 7l6 6 4-4 7 7"/><path d="M14 16h6v-6"/></>
                                )}
                              </svg>
                              <span>{row.movement.label}</span>
                            </span>
                          )}
                          {row.verified === false && <span class="cn-tag cn-tag-unverified">Unconfirmed</span>}
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>

            {hero.summary.skills.some((s: any) => s.notes.length > 0) && (
              <ul class="cn-notes">
                {hero.summary.skills.flatMap((s: any) =>
                  s.notes.map((n: string) => <li><strong>{s.name}:</strong> {n}</li>)
                )}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

  </main>
</Base>

<style>
  .page-wrap {
    width: 100%;
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--page-gutter) var(--space-20);
  }

  .disclaimer {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-3) var(--space-4);
    color: var(--accent-gold-light);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    background: var(--accent-gold-dim);
    border: 1px solid color-mix(in srgb, var(--accent-gold) 24%, transparent);
    border-radius: var(--radius-md);
  }

  .disclaimer svg {
    flex: 0 0 14px;
    margin-top: 2px;
  }

  .section {
    margin-bottom: var(--space-8);
  }

  .cn-overview-panel { padding: var(--space-4); }
  .cn-overview-panel .cn-stat { border: 0; background: transparent; }
  .cn-list-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-6); }
  .cn-list-heading h2 { margin: var(--space-2) 0 0; color: var(--text-bright); font-size: var(--text-2xl); }
  .cn-list-heading > span { color: var(--text-muted); font-size: var(--text-sm); white-space: nowrap; }
  .cn-hero-card { border-top-color: var(--border-medium); }

  .cn-compare-table {
    --cn-table-skill: 16%;
    --cn-table-value: 34%;
    --cn-table-global: 15%;
    --cn-table-cn: 15%;
    --cn-table-change: 20%;

    min-width: 880px;
    table-layout: fixed;
  }

  .cn-col-skill,
  .cn-cell-skill { width: var(--cn-table-skill); }

  .cn-col-value,
  .cn-cell-value { width: var(--cn-table-value); }

  .cn-col-global,
  .cn-cell-global { width: var(--cn-table-global); }

  .cn-col-cn,
  .cn-cell-cn { width: var(--cn-table-cn); }

  .cn-col-change,
  .cn-cell-change { width: var(--cn-table-change); }

  .cn-compare-table th,
  .cn-compare-table td {
    overflow-wrap: anywhere;
    white-space: normal;
    word-break: normal;
  }

  .cn-compare-table .cn-td-global,
  .cn-compare-table .cn-td-cn {
    overflow-wrap: break-word;
  }

  @media (max-width: 768px) {
    .page-wrap {
      padding: var(--space-5) var(--space-4) var(--space-16);
    }

    .cn-overview-panel { padding: var(--space-3); }
    .cn-compare-table { min-width: 0; }
    .cn-compare-table thead { display: none; }
    .cn-compare-table,
    .cn-compare-table tbody,
    .cn-compare-table tr,
    .cn-compare-table td { display: block; width: 100%; }
    .cn-compare-table tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: var(--space-4); border-bottom: 1px solid var(--border-subtle); }
    .cn-compare-table tr:last-child { border-bottom: 0; }
    .cn-compare-table td { padding: var(--space-2) 0; border: 0; white-space: normal; }
    .cn-compare-table td::before { display: block; margin-bottom: var(--space-1); color: var(--text-muted); content: attr(data-label); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
    .cn-compare-table .cn-cell-skill,
    .cn-compare-table .cn-cell-value { grid-column: 1 / -1; }
    .cn-compare-table .cn-cell-change { grid-column: 1 / -1; }
  }

  @media (max-width: 520px) {
    .page-wrap {
      padding-right: var(--space-3);
      padding-left: var(--space-3);
    }

    .cn-hero-head {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .cn-hero-badges {
      flex-basis: 100%;
      justify-content: flex-start;
      padding-left: 68px;
    }
  }
</style>
