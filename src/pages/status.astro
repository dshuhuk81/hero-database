---
export const prerender = true;

import Base from "../layouts/Base.astro";
import { getProjectStatus } from "../utils/projectStatus.js";

const status = getProjectStatus();
const generatedDate = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeStyle: "short",
}).format(new Date(status.generatedAt));

const formatNumber = (value) => new Intl.NumberFormat("en").format(value);
const maxDistributionValue = (segments) => Math.max(...segments.map((segment) => segment.value), 1);

const kpis = [
  {
    label: "Heroes",
    value: status.totals.heroes,
    detail: `${status.totals.released} released / ${status.totals.unreleased} unreleased`,
    tone: "neutral",
  },
  {
    label: "Missing ratings",
    value: status.totals.missingRatings,
    detail: `${status.totals.partialRatings} partial rating sets`,
    tone: status.totals.missingRatings ? "critical" : "ok",
  },
  {
    label: "Pages",
    value: status.totals.staticRoutes,
    detail: `${status.totals.navPages} nav / ${status.totals.unlinkedPublicRoutes} unlinked`,
    tone: status.totals.unlinkedPublicRoutes ? "warning" : "ok",
  },
  {
    label: "Bosses",
    value: status.totals.bosses,
    detail: `${status.totals.tags} mechanic and synergy tags`,
    tone: "neutral",
  },
  {
    label: "Integrity issues",
    value: status.totals.orphanRatings + status.totals.stalePageUpdates,
    detail: `${status.totals.orphanRatings} rating IDs / ${status.totals.stalePageUpdates} page update keys`,
    tone: status.totals.orphanRatings + status.totals.stalePageUpdates ? "critical" : "ok",
  },
  {
    label: "Editorial backlog",
    value: status.totals.missingStrengthWeakness,
    detail: `${status.totals.strengthWeaknessComplete} enriched / ${status.totals.newHeroes} marked as new`,
    tone: "neutral",
  },
];
---

<Base
  title="Project Status | Motto Immortal Database"
  description="Internal project status dashboard for content inventory, hero coverage and data maintenance."
>
  <main class="status-shell">
    <header class="status-header">
      <div>
        <span class="status-kicker">Project dashboard</span>
        <h1>Content Status</h1>
        <p>Inventory, coverage and maintenance signals for the hero database.</p>
        <p class="admin-hint">Editing uses the local admin server. Start it with <code>npm run tag-manager</code>.</p>
      </div>
      <div class="health-panel" aria-label="Project health score">
        <span class="health-label">Health score</span>
        <strong>{status.healthScore}%</strong>
        <span class="health-caption">Generated {generatedDate}</span>
      </div>
    </header>

    <section class="kpi-grid" aria-label="Key metrics">
      {kpis.map((item) => (
        <article class="kpi-card" data-tone={item.tone}>
          <span class="kpi-label">{item.label}</span>
          <strong>{formatNumber(item.value)}</strong>
          <span class="kpi-detail">{item.detail}</span>
        </article>
      ))}
    </section>

    <section class="dashboard-grid">
      <article class="panel panel-wide">
        <div class="panel-heading">
          <div>
            <span class="panel-kicker">Coverage</span>
            <h2>Content completeness</h2>
          </div>
        </div>

        <div class="coverage-list">
          {status.coverage.map((item) => (
            <div class="coverage-row">
              <div class="coverage-copy">
                <strong>{item.label}</strong>
                <span>{item.detail}</span>
              </div>
              <div class="coverage-meter" aria-label={`${item.label}: ${item.value}%`}>
                <span style={`width: ${item.value}%`}></span>
              </div>
              <span class="coverage-value">{item.value}%</span>
            </div>
          ))}
        </div>
      </article>

      <article class="panel">
        <div class="panel-heading">
          <div>
            <span class="panel-kicker">Queue</span>
            <h2>Next actions</h2>
          </div>
        </div>

        <div class="action-list">
          {status.actionQueue.map((item) => (
            <div class="action-item" data-severity={item.severity}>
              <span class="action-count">{item.count}</span>
              <div>
                <strong>{item.label}</strong>
                <span>{item.detail || "No open items"}</span>
              </div>
            </div>
          ))}
        </div>
      </article>
    </section>

    <section class="page-inventory-grid" aria-label="Page inventory">
      <article class="panel">
        <div class="panel-heading compact">
          <div>
            <span class="panel-kicker">Pages</span>
            <h2>Route inventory</h2>
          </div>
        </div>
        <div class="route-stats">
          <div><strong>{status.totals.routes}</strong><span>Total Astro routes</span></div>
          <div><strong>{status.totals.dynamicRoutes}</strong><span>Dynamic routes</span></div>
          <div><strong>{status.totals.internalRoutes}</strong><span>Internal routes</span></div>
          <div><strong>{status.totals.unlinkedPublicRoutes}</strong><span>Unlinked public</span></div>
        </div>
      </article>

      <article class="panel">
        <div class="panel-heading compact">
          <div>
            <span class="panel-kicker">Navigation</span>
            <h2>Unlinked public routes</h2>
          </div>
        </div>
        <div class="route-list">
          {status.pages.unlinkedPublicRoutes.length
            ? status.pages.unlinkedPublicRoutes.map((route) => <span>{route}</span>)
            : <span class="route-ok">No unlinked public pages</span>
          }
        </div>
      </article>

      <article class="panel">
        <div class="panel-heading compact">
          <div>
            <span class="panel-kicker">Internal</span>
            <h2>Kept outside navigation</h2>
          </div>
        </div>
        <div class="route-list">
          {status.pages.internalRoutes.map((route) => <span>{route}</span>)}
        </div>
      </article>
    </section>

    <section class="distribution-grid" aria-label="Hero distribution">
      {[
        ["Faction", status.distributions.faction],
        ["Class", status.distributions.class],
        ["Role", status.distributions.role],
        ["Rating", status.ratings],
      ].map(([title, segments]) => (
        <article class="panel distribution-panel">
          <div class="panel-heading compact">
            <div>
              <span class="panel-kicker">Distribution</span>
              <h2>{title}</h2>
            </div>
          </div>
          <div class="distribution-list">
            {segments.map((segment) => (
              <div class="distribution-row">
                <span>{segment.label}</span>
                <div class="distribution-bar" aria-hidden="true">
                  <span style={`width: ${(segment.value / maxDistributionValue(segments)) * 100}%`}></span>
                </div>
                <strong>{segment.value}</strong>
              </div>
            ))}
          </div>
        </article>
      ))}
    </section>

    <section class="panel inventory-panel">
      <div class="inventory-top">
        <div>
          <span class="panel-kicker">Hero inventory</span>
          <h2>Maintenance table</h2>
        </div>
        <div class="inventory-tools">
          <label class="search-field">
            <span class="sr-only">Search heroes</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5"></path>
            </svg>
            <input id="statusSearch" type="search" placeholder="Search hero, class, faction" />
          </label>
          <div class="filter-tabs" role="group" aria-label="Inventory filters">
            <button class="filter-tab active" type="button" data-filter="all">All</button>
            <button class="filter-tab" type="button" data-filter="critical">Needs data</button>
            <button class="filter-tab" type="button" data-filter="warning">Needs content</button>
            <button class="filter-tab" type="button" data-filter="unreleased">Unreleased</button>
          </div>
        </div>
      </div>

      <div class="table-wrap">
        <table class="inventory-table">
          <thead>
            <tr>
              <th>Hero</th>
              <th>Status</th>
              <th>Release</th>
              <th>Class</th>
              <th>Faction</th>
              <th>Role</th>
              <th>Overall</th>
              <th>Coverage</th>
              <th>Enrichment</th>
              <th>Missing</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="inventoryBody">
            {status.heroStatuses.map((hero) => (
              <tr
                data-row
                data-severity={hero.severity}
                data-release={hero.release ? "released" : "unreleased"}
                data-search={`${hero.name} ${hero.id} ${hero.class} ${hero.faction} ${hero.role}`.toLowerCase()}
              >
                <td>
                  <a class="hero-link" href={`/heroes/${hero.id}`}>
                    <img
                      src={`https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/${hero.id}.webp`}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{hero.name}</span>
                  </a>
                </td>
                <td><span class="status-pill" data-severity={hero.severity}>{hero.statusLabel}</span></td>
                <td>{hero.release ? "Released" : "Unreleased"}</td>
                <td>{hero.class}</td>
                <td>{hero.faction}</td>
                <td>{hero.role}</td>
                <td>
                  {hero.ratings?.overall
                    ? <span class="rating-badge compact-rating" data-rating-cell data-tier={hero.ratings.overall}>{hero.ratings.overall}</span>
                    : <span class="empty-value" data-rating-cell>Missing</span>
                  }
                </td>
                <td>
                  <div class="mini-meter" aria-label={`${hero.completenessPercent}% complete`}>
                    <span style={`width: ${hero.completenessPercent}%`}></span>
                  </div>
                  <span class="mini-meter-value">{hero.completenessPercent}%</span>
                </td>
                <td data-enrichment-cell>
                  <span class="enrichment-pill" data-complete={String(hero.hasStrengthWeakness)}>
                    {hero.hasStrengthWeakness ? "S&W complete" : "S&W missing"}
                  </span>
                </td>
                <td class="missing-cell">{hero.missingChecks.slice(0, 4).join(", ") || "None"}</td>
                <td>
                  <button class="table-action-btn" type="button" data-edit-hero={hero.id}>Edit</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="edit-backdrop" id="editBackdrop" hidden></div>
    <aside class="edit-drawer" id="editDrawer" aria-hidden="true" aria-labelledby="editDrawerTitle">
      <div class="edit-drawer-head">
        <div>
          <span class="panel-kicker">Admin edit</span>
          <h2 id="editDrawerTitle">Hero content</h2>
          <p id="editDrawerMeta">Local JSON editor</p>
        </div>
        <button class="icon-close-btn" type="button" id="editClose" aria-label="Close editor">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <form class="edit-form" id="heroEditForm">
        <input type="hidden" name="id" />

        <section class="edit-section">
          <h3>Basics</h3>
          <label class="toggle-row">
            <input type="checkbox" name="release" />
            <span>Released</span>
          </label>
          <label class="toggle-row">
            <input type="checkbox" name="newHero" />
            <span>New hero badge</span>
          </label>
          <label>
            <span>Description</span>
            <textarea name="description" rows="3" placeholder="Short hero description"></textarea>
          </label>
          <label>
            <span>Core mechanic</span>
            <textarea name="coreMechanicSummary" rows="3" placeholder="Optional mechanic summary"></textarea>
          </label>
          <div class="two-field-grid">
            <label>
              <span>Mechanic depth</span>
              <select name="coreMechanicDepth">
                <option value="">Unset</option>
                <option value="low">Low</option>
                <option value="mid">Mid</option>
                <option value="high">High</option>
              </select>
            </label>
            <label class="toggle-row mechanic-toggle">
              <input type="checkbox" name="coreMechanicMisunderstood" />
              <span>Often misunderstood</span>
            </label>
          </div>
        </section>

        <section class="edit-section">
          <h3>Ratings</h3>
          <div class="rating-grid">
            {["overall", "pvp", "pve", "pveEarly", "pveLate"].map((field) => (
              <label>
                <span>{field}</span>
                <select name={field}>
                  <option value="">Missing</option>
                  <option value="S+">S+</option>
                  <option value="S">S</option>
                  <option value="A+">A+</option>
                  <option value="A">A</option>
                  <option value="B+">B+</option>
                  <option value="B">B</option>
                  <option value="C">C</option>
                  <option value="D">D</option>
                </select>
              </label>
            ))}
          </div>
        </section>

        <section class="edit-section">
          <div class="section-title-row">
            <div>
              <h3>Strengths &amp; weaknesses</h3>
              <p>Add concise editorial guidance for the public hero detail page.</p>
            </div>
          </div>
          <div class="editorial-list-grid">
            <div class="editorial-list-block">
              <div class="editorial-list-head">
                <h4>Strengths</h4>
                <button class="list-add-btn" type="button" data-add-editorial="strengths">Add</button>
              </div>
              <div class="editorial-list" id="strengthList"></div>
            </div>
            <div class="editorial-list-block">
              <div class="editorial-list-head">
                <h4>Weaknesses</h4>
                <button class="list-add-btn" type="button" data-add-editorial="weaknesses">Add</button>
              </div>
              <div class="editorial-list" id="weaknessList"></div>
            </div>
          </div>
        </section>

        <section class="edit-section">
          <div class="section-title-row">
            <div>
              <h3>Synergy tags</h3>
              <p>Select mechanic tags used by filtering, team logic and hero comparisons.</p>
            </div>
            <span class="selection-pill" id="synergyCount">0 selected</span>
          </div>
          <div class="tag-toolbar">
            <div class="tag-search-field">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M20 20l-3.5-3.5"></path>
              </svg>
              <input id="tagSearch" type="search" placeholder="Search mechanic tags" />
            </div>
            <button class="tag-clear-btn" type="button" id="clearSynergyTags">Clear</button>
          </div>
          <div class="selected-tag-summary" id="selectedTagSummary">No tags selected</div>
          <div class="tag-picker" id="tagPicker" aria-live="polite">
            <span class="tag-picker-empty">Start the local admin server to load tags.</span>
          </div>
        </section>

        <section class="edit-section">
          <h3>Investment</h3>
          <div class="two-field-grid">
            <label>
              <span>Relic recommendation</span>
              <input name="relicRecommendation" type="text" placeholder="30, 30-50, Early 10..." />
            </label>
            <label>
              <span>Used in</span>
              <input name="usedIn" type="text" placeholder="PvP / Odyssey / Spire" />
            </label>
          </div>
          <label>
            <span>F2P investment</span>
            <input name="investmentF2p" type="text" placeholder="Base dupe, Divine, tbd..." />
          </label>
          <label>
            <span>Investment explanation</span>
            <textarea name="investmentExplanation" rows="4" placeholder="Why and when to invest"></textarea>
          </label>
        </section>

        <div class="edit-status" id="editStatus" role="status"></div>

        <div class="edit-actions">
          <button class="secondary-action" type="button" id="editCancel">Cancel</button>
          <button class="primary-action" type="submit">Save changes</button>
        </div>
      </form>
    </aside>

    <section class="panel versions-panel">
      <div class="panel-heading compact">
        <div>
          <span class="panel-kicker">Versions</span>
          <h2>Page update map</h2>
        </div>
      </div>
      <div class="version-list">
        {status.pageUpdates.map((item) => (
          <div class="version-item">
            <span>{item.area}</span>
            <strong>{item.version}</strong>
          </div>
        ))}
      </div>
    </section>
  </main>

  <script>
    const ADMIN_API = "http://localhost:3000";
    const search = document.getElementById("statusSearch");
    const tabs = [...document.querySelectorAll(".filter-tab")];
    const rows = [...document.querySelectorAll("[data-row]")];
    let activeFilter = "all";

    function matchesFilter(row) {
      if (activeFilter === "all") return true;
      if (activeFilter === "unreleased") return row.dataset.release === "unreleased";
      return row.dataset.severity === activeFilter;
    }

    function applyFilters() {
      const query = (search?.value || "").trim().toLowerCase();
      rows.forEach((row) => {
        const matchesSearch = !query || row.dataset.search.includes(query);
        row.hidden = !(matchesSearch && matchesFilter(row));
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        activeFilter = tab.dataset.filter || "all";
        tabs.forEach((item) => item.classList.toggle("active", item === tab));
        applyFilters();
      });
    });

    search?.addEventListener("input", applyFilters);

    const editDrawer = document.getElementById("editDrawer");
    const editBackdrop = document.getElementById("editBackdrop");
    const editForm = document.getElementById("heroEditForm");
    const editClose = document.getElementById("editClose");
    const editCancel = document.getElementById("editCancel");
    const editStatus = document.getElementById("editStatus");
    const editTitle = document.getElementById("editDrawerTitle");
    const editMeta = document.getElementById("editDrawerMeta");
    const editButtons = [...document.querySelectorAll("[data-edit-hero]")];
    const tagPicker = document.getElementById("tagPicker");
    const tagSearch = document.getElementById("tagSearch");
    const synergyCount = document.getElementById("synergyCount");
    const selectedTagSummary = document.getElementById("selectedTagSummary");
    const clearSynergyTags = document.getElementById("clearSynergyTags");
    const strengthList = document.getElementById("strengthList");
    const weaknessList = document.getElementById("weaknessList");
    let tagGroups = [];
    let selectedSynergies = new Set();
    let editorialLists = { strengths: [], weaknesses: [] };

    function setEditStatus(message, tone = "neutral") {
      if (!editStatus) return;
      editStatus.classList.remove("has-details");
      editStatus.textContent = message;
      editStatus.dataset.tone = tone;
    }

    function uniqueList(items) {
      return [...new Set(items.filter(Boolean))];
    }

    function addTextElement(parent, tagName, className, text) {
      const element = document.createElement(tagName);
      element.className = className;
      element.textContent = text;
      parent.append(element);
      return element;
    }

    function renderSaveSummary(changedFiles, validation) {
      if (!editStatus) return;
      editStatus.textContent = "";
      editStatus.classList.add("has-details");
      editStatus.dataset.tone = validation?.ok ? "ok" : "critical";

      addTextElement(editStatus, "strong", "save-summary-title", validation?.ok ? "Saved and validated" : "Saved, validation needs review");

      const changedWrap = document.createElement("div");
      changedWrap.className = "save-summary-section";
      addTextElement(changedWrap, "span", "save-summary-label", "Changed files");

      const changedList = document.createElement("ul");
      changedList.className = "changed-file-list";
      const files = changedFiles.length ? changedFiles : ["No file writes were needed"];
      for (const file of files) {
        addTextElement(changedList, "li", "", file);
      }
      changedWrap.append(changedList);
      editStatus.append(changedWrap);

      const validationWrap = document.createElement("div");
      validationWrap.className = "save-summary-section";
      addTextElement(validationWrap, "span", "save-summary-label", "Validation");

      const validationList = document.createElement("div");
      validationList.className = "validation-result-list";
      for (const result of validation?.results || []) {
        const row = document.createElement("details");
        row.className = `validation-result ${result.ok ? "ok" : "failed"}`;
        row.open = !result.ok;

        const summary = document.createElement("summary");
        summary.textContent = `${result.ok ? "Pass" : "Fail"}: ${result.label} (${Math.round(result.durationMs / 100) / 10}s)`;
        row.append(summary);

        if (result.output) {
          addTextElement(row, "pre", "validation-output", result.output);
        }
        validationList.append(row);
      }
      validationWrap.append(validationList);
      editStatus.append(validationWrap);
    }

    function openDrawer() {
      editBackdrop.hidden = false;
      editDrawer.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => {
        editBackdrop.classList.add("open");
        editDrawer.classList.add("open");
      });
    }

    function closeDrawer() {
      editBackdrop.classList.remove("open");
      editDrawer.classList.remove("open");
      editDrawer.setAttribute("aria-hidden", "true");
      window.setTimeout(() => {
        editBackdrop.hidden = true;
      }, 180);
    }

    function setField(name, value) {
      const field = editForm?.elements.namedItem(name);
      if (!field) return;
      if (field.type === "checkbox") {
        field.checked = Boolean(value);
      } else {
        field.value = value ?? "";
      }
    }

    function getField(name) {
      const field = editForm?.elements.namedItem(name);
      if (!field) return "";
      if (field.type === "checkbox") return field.checked;
      return field.value;
    }

    async function apiFetch(path, options = {}) {
      const response = await fetch(`${ADMIN_API}${path}`, {
        headers: { "Content-Type": "application/json", ...(options.headers || {}) },
        ...options,
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(payload.error || `Request failed with ${response.status}`);
      }
      return payload;
    }

    async function loadTagGroups() {
      if (tagGroups.length) return tagGroups;
      tagGroups = await apiFetch("/api/tag-categories");
      return tagGroups;
    }

    function updateSynergyCount() {
      if (!synergyCount) return;
      synergyCount.textContent = `${selectedSynergies.size} selected`;

      if (!selectedTagSummary) return;
      if (!selectedSynergies.size) {
        selectedTagSummary.textContent = "No tags selected";
        selectedTagSummary.dataset.empty = "true";
        return;
      }

      const selectedLabels = [...selectedSynergies]
        .sort()
        .map(formatTagLabel)
        .slice(0, 8);
      const remaining = Math.max(0, selectedSynergies.size - selectedLabels.length);
      selectedTagSummary.dataset.empty = "false";
      selectedTagSummary.textContent = `${selectedLabels.join(", ")}${remaining ? ` +${remaining} more` : ""}`;
    }

    function formatTagLabel(tag) {
      return String(tag)
        .toLowerCase()
        .split("_")
        .filter(Boolean)
        .map((part) => {
          const known = {
            atk: "ATK",
            aoe: "AoE",
            cc: "CC",
            cdr: "CDR",
            dmg: "DMG",
            hp: "HP",
            pve: "PvE",
            pvp: "PvP",
          };
          return known[part] || part.charAt(0).toUpperCase() + part.slice(1);
        })
        .join(" ");
    }

    function coreMechanicFromHero(hero) {
      const mechanic = hero.coreMechanic;
      if (!mechanic) {
        return { summary: "", depthRating: "", commonlyMisunderstood: false };
      }
      if (typeof mechanic === "string") {
        return {
          summary: mechanic === "[object Object]" ? "" : mechanic,
          depthRating: "",
          commonlyMisunderstood: false,
        };
      }
      return {
        summary: mechanic.summary || "",
        depthRating: mechanic.depthRating || "",
        commonlyMisunderstood: Boolean(mechanic.commonlyMisunderstood),
      };
    }

    function renderEditorialList(type) {
      const container = type === "strengths" ? strengthList : weaknessList;
      if (!container) return;
      container.innerHTML = "";

      const items = editorialLists[type];
      if (!items.length) {
        addTextElement(container, "span", "editorial-list-empty", `No ${type} listed yet.`);
        return;
      }

      for (const [index, value] of items.entries()) {
        const row = document.createElement("div");
        row.className = "editorial-list-row";

        const textarea = document.createElement("textarea");
        textarea.rows = 2;
        textarea.value = value;
        textarea.placeholder = type === "strengths" ? "Add a concrete strength" : "Add a concrete weakness";
        textarea.setAttribute("aria-label", `${type} item ${index + 1}`);
        textarea.addEventListener("input", () => {
          editorialLists[type][index] = textarea.value;
        });

        const remove = document.createElement("button");
        remove.className = "list-remove-btn";
        remove.type = "button";
        remove.textContent = "Remove";
        remove.setAttribute("aria-label", `Remove ${type} item ${index + 1}`);
        remove.addEventListener("click", () => {
          editorialLists[type].splice(index, 1);
          renderEditorialList(type);
        });

        row.append(textarea, remove);
        container.append(row);
      }
    }

    function setEditorialLists(hero) {
      editorialLists = {
        strengths: [...(hero.strengths || [])],
        weaknesses: [...(hero.weaknesses || [])],
      };
      renderEditorialList("strengths");
      renderEditorialList("weaknesses");
    }

    function getEditorialList(type) {
      return editorialLists[type].map((item) => item.trim()).filter(Boolean);
    }

    function renderTagPicker(filter = "") {
      if (!tagPicker) return;
      const query = filter.trim().toLowerCase();
      tagPicker.innerHTML = "";

      if (!tagGroups.length) {
        const empty = document.createElement("span");
        empty.className = "tag-picker-empty";
        empty.textContent = "Start the local admin server to load tags.";
        tagPicker.append(empty);
        updateSynergyCount();
        return;
      }

      let visibleCount = 0;
      for (const group of tagGroups) {
        const tags = (group.tags || []).filter((tag) => !query || tag.toLowerCase().includes(query));
        if (!tags.length) continue;
        visibleCount += tags.length;

        const groupEl = document.createElement("div");
        groupEl.className = "tag-group";

        const groupHead = document.createElement("div");
        groupHead.className = "tag-group-head";

        const heading = document.createElement("strong");
        heading.textContent = group.label || group.id || "Tags";

        const count = document.createElement("span");
        count.textContent = `${tags.length} tag${tags.length === 1 ? "" : "s"}`;

        groupHead.append(heading, count);
        groupEl.append(groupHead);

        const chips = document.createElement("div");
        chips.className = "tag-chip-list";

        for (const tag of tags) {
          const label = document.createElement("label");
          label.className = "tag-chip";
          label.title = tag;

          const input = document.createElement("input");
          input.type = "checkbox";
          input.value = tag;
          input.checked = selectedSynergies.has(tag);
          input.addEventListener("change", () => {
            if (input.checked) {
              selectedSynergies.add(tag);
            } else {
              selectedSynergies.delete(tag);
            }
            label.classList.toggle("selected", input.checked);
            updateSynergyCount();
          });

          const checkmark = document.createElement("span");
          checkmark.className = "tag-chip-check";

          const span = document.createElement("span");
          span.className = "tag-chip-label";
          span.textContent = formatTagLabel(tag);

          const code = document.createElement("small");
          code.textContent = tag;

          label.classList.toggle("selected", input.checked);
          label.append(input, checkmark, span, code);
          chips.append(label);
        }

        groupEl.append(chips);
        tagPicker.append(groupEl);
      }

      if (!visibleCount) {
        const empty = document.createElement("span");
        empty.className = "tag-picker-empty";
        empty.textContent = "No matching tags.";
        tagPicker.append(empty);
      }

      updateSynergyCount();
    }

    function fillEditForm(payload) {
      const { hero, ratings, investment } = payload;
      editTitle.textContent = hero.name || hero.id;
      editMeta.textContent = `${hero.id} · ${hero.faction || "Missing faction"} · ${hero.class || "Missing class"}`;

      setField("id", hero.id);
      setField("release", hero.release !== false);
      setField("newHero", Boolean(hero.newHero));
      setField("description", hero.description || "");
      const coreMechanic = coreMechanicFromHero(hero);
      setField("coreMechanicSummary", coreMechanic.summary);
      setField("coreMechanicDepth", coreMechanic.depthRating);
      setField("coreMechanicMisunderstood", coreMechanic.commonlyMisunderstood);
      selectedSynergies = new Set(hero.synergies || []);
      setEditorialLists(hero);

      for (const field of ["overall", "pvp", "pve", "pveEarly", "pveLate"]) {
        setField(field, ratings?.[field] || "");
      }

      setField("relicRecommendation", investment?.relicRecommendation || "");
      setField("usedIn", investment?.usedIn || "");
      setField("investmentF2p", investment?.f2pInvestment || "");
      setField("investmentExplanation", investment?.explanation || "");
      renderTagPicker(tagSearch?.value || "");
    }

    async function openEditor(heroId) {
      openDrawer();
      editForm.reset();
      selectedSynergies = new Set();
      editorialLists = { strengths: [], weaknesses: [] };
      renderEditorialList("strengths");
      renderEditorialList("weaknesses");
      if (tagSearch) tagSearch.value = "";
      renderTagPicker();
      setEditStatus("Loading hero content...");
      try {
        await loadTagGroups();
        const payload = await apiFetch(`/api/admin/heroes/${heroId}`);
        fillEditForm(payload);
        setEditStatus("Ready. Changes are written to local JSON files.", "ok");
      } catch (error) {
        setEditStatus(`Cannot reach local admin server: ${error.message}. Start npm run tag-manager.`, "critical");
      }
    }

    function updateVisibleRow(heroId) {
      const row = rows.find((item) => item.querySelector(`[data-edit-hero="${heroId}"]`));
      if (!row) return;
      const release = getField("release");
      const overall = getField("overall");
      const releaseCell = row.children[2];
      const ratingCell = row.querySelector("[data-rating-cell]");
      const enrichmentCell = row.querySelector("[data-enrichment-cell]");

      row.dataset.release = release ? "released" : "unreleased";
      if (releaseCell) releaseCell.textContent = release ? "Released" : "Unreleased";
      if (ratingCell) {
        ratingCell.textContent = overall || "Missing";
        if (overall) {
          ratingCell.className = "rating-badge compact-rating";
          ratingCell.dataset.tier = overall;
        } else {
          ratingCell.className = "empty-value";
          delete ratingCell.dataset.tier;
        }
        ratingCell.dataset.ratingCell = "";
      }
      if (enrichmentCell) {
        const complete = getEditorialList("strengths").length > 0 && getEditorialList("weaknesses").length > 0;
        enrichmentCell.innerHTML = "";
        const pill = document.createElement("span");
        pill.className = "enrichment-pill";
        pill.dataset.complete = String(complete);
        pill.textContent = complete ? "S&W complete" : "S&W missing";
        enrichmentCell.append(pill);
      }
    }

    editButtons.forEach((button) => {
      button.addEventListener("click", () => openEditor(button.dataset.editHero));
    });

    tagSearch?.addEventListener("input", () => renderTagPicker(tagSearch.value));
    clearSynergyTags?.addEventListener("click", () => {
      selectedSynergies = new Set();
      renderTagPicker(tagSearch?.value || "");
    });
    document.querySelectorAll("[data-add-editorial]").forEach((button) => {
      button.addEventListener("click", () => {
        const type = button.dataset.addEditorial;
        editorialLists[type].push("");
        renderEditorialList(type);
      });
    });

    editClose?.addEventListener("click", closeDrawer);
    editCancel?.addEventListener("click", closeDrawer);
    editBackdrop?.addEventListener("click", closeDrawer);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && editDrawer?.classList.contains("open")) closeDrawer();
    });

    editForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const heroId = getField("id");
      setEditStatus("Saving changes...");

      try {
        const saveResponses = [];

        saveResponses.push(await apiFetch(`/api/admin/heroes/${heroId}`, {
          method: "PATCH",
          body: JSON.stringify({
            release: getField("release"),
            newHero: getField("newHero"),
            description: getField("description"),
            coreMechanic: {
              summary: getField("coreMechanicSummary"),
              depthRating: getField("coreMechanicDepth"),
              commonlyMisunderstood: getField("coreMechanicMisunderstood"),
            },
            strengths: getEditorialList("strengths"),
            weaknesses: getEditorialList("weaknesses"),
          }),
        }));

        saveResponses.push(await apiFetch(`/api/admin/ratings/${heroId}`, {
          method: "PATCH",
          body: JSON.stringify({
            overall: getField("overall"),
            pvp: getField("pvp"),
            pve: getField("pve"),
            pveEarly: getField("pveEarly"),
            pveLate: getField("pveLate"),
          }),
        }));

        saveResponses.push(await apiFetch(`/api/admin/invest/${heroId}`, {
          method: "PATCH",
          body: JSON.stringify({
            relicRecommendation: getField("relicRecommendation"),
            usedIn: getField("usedIn"),
            f2pInvestment: getField("investmentF2p"),
            explanation: getField("investmentExplanation"),
          }),
        }));

        saveResponses.push(await apiFetch(`/api/heroes/${heroId}/synergies`, {
          method: "POST",
          body: JSON.stringify({
            synergies: [...selectedSynergies].sort(),
          }),
        }));

        updateVisibleRow(heroId);
        const changedFiles = uniqueList(saveResponses.flatMap((response) => response.changedFiles || []));
        setEditStatus("Saved. Running validation...");
        const validation = await apiFetch("/api/admin/validate", {
          method: "POST",
          body: JSON.stringify({ checks: ["tags"] }),
        });
        renderSaveSummary(changedFiles, validation);
      } catch (error) {
        setEditStatus(`Save failed: ${error.message}`, "critical");
      }
    });
  </script>
</Base>

