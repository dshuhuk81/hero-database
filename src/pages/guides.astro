        <!-- RATINGS -->
        <section class="section" id="skadi-ratings">
          <div class="section-title">Mode Ratings (Theoretical)</div>
          <div class="rating-grid">
            <div class="rating-card">
              <div class="rating-mode">PVE / Campaign</div>
              <div class="rating-cell"><span class="rating-badge rating-ss">SS</span></div>
              <div class="rating-desc">Multi-target scaling and sustained control loops make her dominant in prolonged PVE content</div>
