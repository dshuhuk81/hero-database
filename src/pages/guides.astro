  </main>
</div>

  <script>
    const accordionPanels = document.querySelectorAll('[data-accordion-instance="guides"] [data-accordion-tab]');
    const heroGuideSlides = document.querySelectorAll('.guide-slide');

    accordionPanels.forEach(panel => {
      panel.addEventListener('click', () => {
        const tabId = (panel as HTMLElement).getAttribute('data-tab');
        if (!tabId) return;
        accordionPanels.forEach(p => p.classList.remove('is-active'));
        heroGuideSlides.forEach(s => s.classList.remove('is-active'));
        panel.classList.add('is-active');
        const slide = document.getElementById(tabId);
        if (slide) slide.classList.add('is-active');
      });
    });
  </script>
