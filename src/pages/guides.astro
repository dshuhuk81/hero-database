---
export const prerender = true;
import Base from "../layouts/Base.astro";
import { getHeroById } from "../data/heroes";
import Accordion from "../components/Accordion.astro";
import RatingTiles from "../components/RatingTiles.astro";
import heroGuidesData from "../data/hero-guides.json";
import heroRatings from "../data/ratings/hero-ratings.json";

import guideHephaestus from "../data/guides/hephaestus.json";
import guideMeret from "../data/guides/meret.json";
import guideCronus from "../data/guides/cronus.json";
import guideJiutian from "../data/guides/jiutian-xuannv.json";
import guideHera from "../data/guides/hera.json";
import guideSkadi from "../data/guides/skadi.json";
import guideMengpo from "../data/guides/mengpo.json";
import guideNuba from "../data/guides/nuba.json";
import guideWenshen from "../data/guides/wenshen.json";

const guides = heroGuidesData.guides;
const heroRatingsById = heroRatings as Record<string, { overall?: string; pvp?: string; pve?: string }>;

const guideDataMap: Record<string, any> = {
  hephaestus: guideHephaestus,
  meret: guideMeret,
  cronus: guideCronus,
  "jiutian-xuannv": guideJiutian,
  hera: guideHera,
  skadi: guideSkadi,
  mengpo: guideMengpo,
  nuba: guideNuba,
  wenshen: guideWenshen,
};

const SKILL_BASE_URL = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/skills/";

function heroName(id: string) {
  const hero = getHeroById(id);
  if (hero?.name) return hero.name;
  return `${id.slice(0, 1).toUpperCase()}${id.slice(1)}`;
}

function heroImage(id: string) {
  const hero = getHeroById(id);
  const img = hero?.image || `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/${id}.webp`;
  if (img.startsWith("http://") || img.startsWith("https://")) return img;
  return img.startsWith("/") ? img : `/${img}`;
}

function tagClass(tag: string): string {
  if (tag.includes("Faction")) return "tag-faction";
  if (["Warrior", "Mage", "Archer", "Support", "Tank"].includes(tag)) return "tag-class";
  if (["Legendary", "Epic"].includes(tag)) return "tag-rarity";
  if (tag === "Unreleased") return "tag-unreleased";
  return "tag-misc";
}

function skillCardClass(badge: string): string {
  if (badge === "Ultimate") return "skill-card ultimate";
  if (badge === "Relic") return "skill-card relic";
  return "skill-card";
}

function skillBadgeClass(badge: string): string {
  if (badge === "Ultimate") return "skill-badge badge-ultimate";
  if (badge === "Relic") return "skill-badge badge-relic";
  return "skill-badge badge-skill";
}

const releasedGuides = guides.filter((g) => import.meta.env.DEV || getHeroById(g.id)?.release === true);
---

<Base title="Guides | Motto Immortal">

  <!-- GUIDE HEADER: PageHero + Accordion side-by-side -->
  <div class="guide-header-row">
    <div class="guide-header-text">
      <span class="guide-header-tag" data-i18n="guides_tag">Hero Guides</span>
      <h1 class="guide-header-headline" data-i18n="guides_headline">Hero Guides</h1>
      <p class="guide-header-sub" data-i18n="guides_sub">In-depth hero guides with skills, team comps and strategy</p>
    </div>
    <div class="hero-accordion">
      <Accordion
        instanceId="guides"
        items={releasedGuides.map(g => ({
          id: g.id,
          label: g.label,
          image: g.heroImage,
          imgPos: g.imgPos,
          imgPosActive: g.imgPosActive,
          badge: g.badge,
        }))}
      />
    </div>
  </div>

<div class="page-wrapper">
  <main class="guides-main">

  {releasedGuides.map((g, idx) => {
    const data = guideDataMap[g.id];
    if (!data) return null;
    const id = g.id;
    const ratings = heroRatingsById[id] ?? {};
    return (
      <div class={`guide-slide${idx === 0 ? ' is-active' : ''}`} id={id}>
        <div class="guide-container">

          <header class="hero-header">
            <div class="epithet">Motto Immortal - Hero Guide</div>
            <img class="hero-portrait" src={g.heroImage} alt={`${g.label} portrait`} loading="lazy" />
            <h1 class="char-name">{g.label}</h1>
            <p class="hero-quote">{g.quote}</p>
            <div class="tags">
              {g.tags.map((tag: string) => <span class={`tag ${tagClass(tag)}`}>{tag}</span>)}
            </div>
          </header>

          <nav class="jump-nav">
            <div class="jump-nav-title">Quick Navigation</div>
            <div class="jump-nav-links">
              <a href={`#${id}-overview`}>Overview</a>
              {data.lore && <a href={`#${id}-lore`}>Lore</a>}
              {data.factionSynergy && <a href={`#${id}-faction`}>Faction Synergy</a>}
              <a href={`#${id}-mechanic`}>Core Mechanic</a>
              <a href={`#${id}-skills`}>Skills</a>
              <a href={`#${id}-ratings`}>Ratings</a>
              <a href={`#${id}-positioning`}>Positioning</a>
              {g.comps?.length > 0 && <a href={`#${id}-comps`}>Comps</a>}
              <a href={`#${id}-strengths`}>Strengths</a>
              <a href={`#${id}-synergy`}>Synergy</a>
              <a href={`#${id}-playstyle`}>Playstyle</a>
            </div>
          </nav>

          <div class="print-bar">
            <button class="print-btn" onclick="window.print()">Save as PDF</button>
          </div>

          <section class="section" id={`${id}-overview`}>
            <div class="section-title">Overview</div>
            <div class="overview-card">
              {data.overview.map((p: string) => <p set:html={p} />)}
            </div>
          </section>

          {data.lore && (
            <section class="section" id={`${id}-lore`}>
              <div class="section-title">Lore &amp; Background</div>
              <div class="mechanic-box">
                <div class="mechanic-label">{data.lore.label}</div>
                <p style="font-size:14px; color:var(--text-muted); margin-bottom:14px; line-height:1.5;" set:html={data.lore.intro} />
                <ul class="mechanic-list">
                  {data.lore.bullets.map((b: string) => <li set:html={b} />)}
                </ul>
              </div>
            </section>
          )}

          {data.factionSynergy && (
            <section class="section" id={`${id}-faction`}>
              <div class="section-title">{data.factionSynergy.label}</div>
              <div class="mechanic-box" style="border-color: rgba(64,106,95,0.35); background: linear-gradient(135deg, rgba(64,106,95,0.07), rgba(64,106,95,0.05));">
                <div class="mechanic-label" style="color: var(--accent-gold-light);">{data.factionSynergy.label}</div>
                <p style="font-size:14px; color:var(--text-muted); margin-bottom:14px;" set:html={data.factionSynergy.intro} />
                <ul class="mechanic-list">
                  {data.factionSynergy.items.map((item: any) => (
                    <li><strong style="color:var(--accent-gold-light);">{item.label}</strong> <span set:html={item.text} /></li>
                  ))}
                </ul>
                {data.factionSynergy.note && (
                  <p style="font-size:13px; color:var(--text-muted); margin-top:14px; font-style:italic;" set:html={data.factionSynergy.note} />
                )}
              </div>
            </section>
          )}

          <section class="section" id={`${id}-mechanic`}>
            <div class="section-title">{data.coreMechanic.sectionTitle}</div>
            <div class="mechanic-box">
              <div class="mechanic-label">{data.coreMechanic.label}</div>
              <ul class="mechanic-list">
                {data.coreMechanic.bullets.map((b: string) => <li set:html={b} />)}
              </ul>
              {data.coreMechanic.subsections?.map((sub: any) => (
                <div style="margin-top:16px;">
                  <div class="mechanic-label" style="font-size:13px; margin-bottom:8px;">{sub.label}</div>
                  {sub.bullets ? (
                    <ul class="mechanic-list">
                      {sub.bullets.map((b: string) => <li set:html={b} />)}
                    </ul>
                  ) : (
                    <p style="font-size:13px; color:var(--text-muted); line-height:1.7; font-family: monospace;" set:html={sub.content?.replace(/\n/g, '<br/>')} />
                  )}
                </div>
              ))}
            </div>
            {data.coreMechanic.highlightBox && (
              <div class="mechanic-box" style="margin-top:16px; border-color: rgba(180,130,80,0.25); background: linear-gradient(135deg, rgba(180,130,80,0.06), rgba(180,130,80,0.04));">
                <div class="mechanic-label" style="color: var(--accent-gold-light);">{data.coreMechanic.highlightBox.label}</div>
                <ul class="mechanic-list">
                  {data.coreMechanic.highlightBox.bullets.map((b: string) => <li set:html={b} />)}
                </ul>
              </div>
            )}
          </section>

          <section class="section" id={`${id}-skills`}>
            <div class="section-title">Skill Breakdown</div>
            <div class="skills-grid">
              {data.skills.map((skill: any) => (
                <div class={skillCardClass(skill.badge)}>
                  <div class="skill-header">
                    <img class="skill-icon" src={`${SKILL_BASE_URL}${skill.icon}`} alt={skill.name} />
                    <span class="skill-name">{skill.name}</span>
                    <span class={skillBadgeClass(skill.badge)}>{skill.badge}</span>
                  </div>
                  <p class="skill-desc" set:html={skill.description} />
                  {skill.upgrades.length > 0 && (
                    <div class="skill-upgrade-block">
                      {skill.upgrades.map((u: any) => (
                        <div class="upgrade-row">
                          <span class="skill-upgrade-level">{u.level}</span>
                          <span class="upgrade-text" set:html={u.text} />
                        </div>
                      ))}
                    </div>
                  )}
                  <div class="skill-note">{skill.note}</div>
                </div>
              ))}
            </div>
            <div class="mechanic-box" style="margin-top: 20px;">
              <div class="mechanic-label">Skill Upgrade Priority</div>
              <ul class="mechanic-list">
                {data.skillUpgradePriority.map((p: string) => <li set:html={p} />)}
              </ul>
            </div>
          </section>

          <section class="section" id={`${id}-ratings`}>
            <div class="section-title">Meta Ratings</div>
            <RatingTiles ratings={ratings} />
          </section>

          <section class="section" id={`${id}-positioning`}>
            <div class="section-title">Recommended Positioning</div>
            <div class="pos-grid">
              {data.positioning.map((pos: any) => (
                <div class="pos-card">
                  <div class="pos-mode">{pos.mode}</div>
                  {pos.paragraphs.map((p: string) => <p set:html={p} />)}
                </div>
              ))}
            </div>
          </section>

          {g.comps?.length > 0 && (
            <section class="section" id={`${id}-comps`}>
              <div class="section-title">Suggested Comps</div>
              <div class="comp-list">
                {g.comps.map((comp: any) => (
                  <div class="comp-entry">
                    <div class="comp-entry-header">
                      <span class="comp-label">{comp.label}</span>
                      <p class="comp-reason">{comp.reason}</p>
                    </div>
                    <div class="comp-hero-row">
                      {comp.heroes.map((hid: string) => (
                        <a href={`/heroes/${hid}`} class="hero-card-chip" style={`--hero-img: url(${heroImage(hid)})`}>
                          <div class="hero-card-chip-portrait" aria-hidden="true"></div>
                          <span class="hero-card-chip-name">{heroName(hid)}</span>
                        </a>
                      ))}
                    </div>
                    {comp.notes?.length > 0 && (
                      <ul class="comp-notes">
                        {comp.notes.map((n: string) => <li>{n}</li>)}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          <section class="section" id={`${id}-strengths`}>
            <div class="section-title">Strengths &amp; Weaknesses</div>
            <div class="sw-grid">
              <div class="sw-card strengths">
                <div class="sw-title">Strengths</div>
                <ul class="sw-list">
                  {data.strengths.map((s: string) => <li set:html={s} />)}
                </ul>
              </div>
              <div class="sw-card weaknesses">
                <div class="sw-title">Weaknesses</div>
                <ul class="sw-list">
                  {data.weaknesses.map((w: string) => <li set:html={w} />)}
                </ul>
              </div>
            </div>
          </section>

          <section class="section" id={`${id}-synergy`}>
            <div class="section-title">Synergy Considerations</div>
            {data.synergy.type === 'list' ? (
              <div class="synergy-list">
                {data.synergy.entries.map((entry: any) => (
                  <div class="synergy-entry">
                    <div class="synergy-hero-name">{entry.name}</div>
                    <p class="synergy-body" set:html={entry.text} />
                  </div>
                ))}
              </div>
            ) : (
              <div class="synergy-note">
                {data.synergy.paragraphs.map((p: string) => <p set:html={p} />)}
              </div>
            )}
          </section>

          <div class="divider-ornament">&#10022; &#10022; &#10022;</div>

          <section class="section" id={`${id}-playstyle`}>
            <div class="section-title">Playstyle Summary</div>
            <div class="overview-card">
              {data.playstyle.map((p: string) => <p set:html={p} />)}
            </div>
          </section>

        </div>
      </div>
    );
  })}

  </main>
</div>

  <script>
    const accordionPanels = document.querySelectorAll('[data-accordion-instance="guides"] [data-accordion-tab]');
    const heroGuideSlides = document.querySelectorAll('.guide-slide');

    accordionPanels.forEach(panel => {
      panel.addEventListener('click', () => {
        const tabId = (panel as HTMLElement).getAttribute('data-tab');
        if (!tabId) return;
        accordionPanels.forEach(p => p.classList.remove('is-active'));
        heroGuideSlides.forEach(s => s.classList.remove('is-active'));
        panel.classList.add('is-active');
        const slide = document.getElementById(tabId);
        if (slide) slide.classList.add('is-active');
      });
    });
  </script>
</Base>


<style>

  /* ── GUIDE HEADER ROW ── */
  .guide-header-row {
    position: relative;
    height: 480px;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }

  .guide-header-text {
    height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px;
    background:
      linear-gradient(135deg, rgba(120,90,200,0.18), rgba(7,6,12,0.95)),
      url("https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/bg_neutral.webp") center top / cover no-repeat;
    position: relative;
  }

  .guide-header-text::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom,
      rgba(8,10,16,0.15) 0%,
      rgba(8,10,16,0.5) 50%,
      rgba(8,10,16,0.92) 100%
    );
  }

  .guide-header-tag {
    position: relative;
    font-size: 0.68rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: rgba(230,230,235,0.55);
    margin-bottom: 8px;
  }

  .guide-header-headline {
    position: relative;
    margin: 0 0 8px;
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text-bright);
    line-height: 1.1;
  }

  .guide-header-sub {
    position: relative;
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgba(230,230,235,0.7);
  }

  /* ── HERO ACCORDION WRAPPER ── */
  .hero-accordion {
    display: flex;
    flex: 1;
    overflow: hidden;
    background:
      radial-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.85)),
      url("https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/bg_halle.webp");
    background-size: cover;
    background-position: top;
  }

  /* ── SLIDES ── */
  .guides-main {
    flex: 1;
    width: 100%;
  }

  .guide-slide {
    display: none;
  }

  .guide-slide.is-active {
    display: block;
    animation: fadeIn 160ms ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .guide-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 24px 60px;
    position: relative;
  }

  /* ── HERO HEADER ── */
  .hero-header {
    text-align: center;
    padding: 60px 0 40px;
  }

  .hero-portrait {
    width: 128px;
    height: 128px;
    border-radius: var(--radius-full);
    object-fit: cover;
    margin: 0 auto 18px;
    display: block;
    border: 1px solid rgba(250, 234, 121, 0.45);
    box-shadow:
      0 0 0 4px rgb(255, 228, 122),
      0 0 28px rgba(250, 204, 21, 0.32),
      0 0 64px rgba(250, 234, 121, 0.2),
      0 18px 40px rgba(0, 0, 0, 0.45);
    object-position: center 14%;
  }

  .epithet {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--accent-gold);
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: var(--space-6);
  }

  .char-name {
    font-size: clamp(52px, 10vw, 88px);
    font-weight: 700;
    color: var(--text);
    line-height: 1;
    text-shadow: 0 0 40px rgba(130,75,162,0.8), 0 0 80px rgba(130,75,162,0.4), 0 2px 4px rgba(0,0,0,0.8);
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }

  .hero-quote {
    font-style: italic;
    color: var(--text-muted);
    font-size: 14px;
    max-width: 420px;
    margin: 0 auto 20px;
    opacity: 0.85;
  }

  .tags {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .tag {
    font-size: 10px;
    letter-spacing: 0.2em;
    padding: 5px 16px;
    border: 1px solid;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tag-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
    filter: brightness(1.1);
  }

  .tag-faction, .tag-class {
    border-color: var(--accent-teal);
    color: var(--accent-teal);
    background: rgba(255,255,255,0.95);
  }

  /* ── JUMP NAVIGATION ── */
  .jump-nav {
    background: rgba(13, 11, 20, 0.85);
    border: 1px solid rgba(64, 106, 95, 0.4);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    margin: 36px 0 48px;
    backdrop-filter: blur(4px);
  }

  .jump-nav-title {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--accent-gold-light);
    margin-bottom: var(--space-3);
    opacity: 0.9;
  }

  .jump-nav-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-3);
  }

  .jump-nav-links a {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-primary);
    text-decoration: none;
    border: 1px solid var(--accent-teal-dim);
    border-color: rgba(64, 106, 95, 0.5);
    border-radius: var(--radius-sm);
    background: var(--accent-teal-dim);
    transition: var(--transition-colors);
    display: block;
    text-align: center;
  }

  .jump-nav-links a:hover {
    background: rgba(64, 106, 95, 0.35);
    border-color: var(--accent-teal);
    color: var(--accent-gold-light);
  }

  /* ── SECTION HEADERS ── */
  .section {
    margin-top: 48px;
    scroll-margin-top: 80px;
  }

  .section-title {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--accent-gold);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .section-title::before, .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(64,106,95,0.4));
  }

  .section-title::before { background: linear-gradient(90deg, rgba(64,106,95,0.4), transparent); }

  /* ── VERDICT STRIP ── */
  .verdict-strip {
    background: var(--bg-surface);
    border: 1px solid rgba(64,106,95,0.3);
    padding: 22px 28px;
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
  }
  .verdict-role {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--accent-teal);
    margin-bottom: var(--space-2);
  }
  .verdict-line {
    font-size: var(--text-base);
    color: var(--text-primary);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-4) 0;
  }
  .verdict-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .verdict-meta-item {
    background: var(--accent-teal-dim);
    border: 1px solid rgba(64,106,95,0.25);
    border-radius: var(--radius-md);
    padding: 5px var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .verdict-meta-item strong { color: var(--text-primary); }

  /* ── OVERVIEW CARD ── */
  .overview-card {
    background: var(--bg-surface);
    border: 1px solid rgba(64,106,95,0.3);
    border-top: 2px solid var(--accent-teal);
    padding: var(--space-6) var(--space-8);
    position: relative;
    border-radius: var(--radius-2xl);
    line-height: var(--leading-normal);
  }

  .overview-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent-teal-dim) 0%, transparent 50%);
    pointer-events: none;
    border-radius: var(--radius-2xl);
  }

  .overview-card p {
    color: var(--text-primary);
    opacity: 0.9;
    margin-bottom: var(--space-3);
  }

  .overview-card p:last-child { margin-bottom: 0; }

