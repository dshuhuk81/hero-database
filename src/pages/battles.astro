---
import Sidebar from "../components/Sidebar.astro";

const title = "Battle Analysis";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      font-family: "Spectral", "Roboto", system-ui, sans-serif;
      background:
        radial-gradient(ellipse at 30% -10%, rgba(120,90,200,0.15), transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(255,215,100,0.08), transparent 55%),
        linear-gradient(to bottom, #0d0b10, #07060c);
      color: #e6e6eb;
      min-height: 100vh;
    }

    body { margin-left: 48px; }

    .main-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 32px 80px;
    }

    @media (max-width: 768px) {
      body { margin-left: 0; }
      .main-content { padding: 20px 16px; }
    }

    .page-header { margin-bottom: 28px; }
    .page-title { font-size: 2rem; font-weight: 700; color: #e6e6eb; letter-spacing: 0.01em; }
    .separator { width: 100%; height: 2px; background: rgba(250,204,21,0.4); margin: 10px 0 20px; }
    .page-subtitle { color: rgba(230,230,235,0.5); font-size: 0.875rem; margin-top: 4px; }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 28px; }

    .card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(168,85,247,0.25);
      border-radius: 12px;
      padding: 20px;
      transition: border-color 0.2s;
    }

    .card:hover { border-color: rgba(168,85,247,0.4); }

    .card h3 {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(250,204,21,0.6);
      margin-bottom: 12px;
    }

    .metric {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1;
      margin-bottom: 4px;
    }

    .metric-label { font-size: 0.68rem; color: rgba(230,230,235,0.4); }

    .table-container {
      overflow-x: auto;
      border: 1px solid rgba(168,85,247,0.25);
      border-radius: 12px;
      background: rgba(255,255,255,0.02);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.78rem;
    }

    th {
      padding: 12px 14px;
      text-align: left;
      background: rgba(250,204,21,0.06);
      border-bottom: 1px solid rgba(168,85,247,0.15);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(250,204,21,0.7);
    }

    td {
      padding: 10px 14px;
      border-bottom: 1px solid rgba(168,85,247,0.08);
    }

    tr:last-child td { border-bottom: none; }

    .status-correct { color: #86efac; }
    .status-wrong { color: #f87171; }

    .empty-state {
      text-align: center;
      padding: 40px 20px;
      color: rgba(230,230,235,0.4);
    }

    .empty-state p { font-size: 0.95rem; margin: 10px 0; }
    .empty-state a { color: #facc15; text-decoration: none; }
    .empty-state a:hover { text-decoration: underline; }

    .chart {
      margin-top: 16px;
      height: 2px;
      background: rgba(100,150,200,0.2);
      border-radius: 1px;
      overflow: hidden;
    }

    .chart-bar {
      height: 100%;
      border-radius: 1px;
      background: linear-gradient(90deg, rgba(250,204,21,0.8), rgba(250,204,21,1));
    }

    .chart-label {
      font-size: 0.68rem;
      color: rgba(230,230,235,0.6);
      margin-top: 4px;
    }

    .accuracy-high { color: #86efac; }
    .accuracy-low { color: #f87171; }
    .accuracy-mid { color: #facc15; }
  </style>
</head>
<body>
  <Sidebar />

  <main class="main-content">
    <div class="page-header">
      <h1 class="page-title">Battle Analysis</h1>
      <div class="separator"></div>
      <p class="page-subtitle">Track your fight predictions and analyze model accuracy over time.</p>
    </div>

    <div class="grid">
      <div class="card">
        <h3>Total Fights</h3>
        <div class="metric" id="metric-total">--</div>
        <div class="metric-label">recorded outcomes</div>
      </div>
      <div class="card">
        <h3>Prediction Accuracy</h3>
        <div class="metric" id="metric-accuracy">--</div>
        <div class="metric-label">correct predictions</div>
      </div>
      <div class="card">
        <h3>Player Wins</h3>
        <div class="metric" id="metric-wins">--</div>
        <div class="metric-label">times you won</div>
      </div>
    </div>

    <h2 style="font-size: 1.3rem; margin-top: 32px; margin-bottom: 16px; color: #e6e6eb;">Fight History</h2>
    <div class="table-container">
      <table id="fights-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Predicted</th>
            <th>Outcome</th>
            <th>BP Ratio</th>
            <th>Accuracy</th>
          </tr>
        </thead>
        <tbody id="fights-tbody">
          <tr><td colspan="5" style="text-align: center; padding: 20px;">Loading...</td></tr>
        </tbody>
      </table>
    </div>

    <div id="empty-state" style="display: none;">
      <div class="empty-state">
        <p style="font-size: 1.1rem;">No battles recorded yet.</p>
        <p>Go to <a href="/battle-sim">Battle Simulator</a> to start building comp predictions.</p>
        <p style="font-size: 0.85rem; margin-top: 20px;">After each fight, submit the outcome to train the prediction model.</p>
      </div>
    </div>
  </main>

  <script>
    async function loadFights() {
      try {
        const authToken = localStorage.getItem('authToken');
        if (!authToken) {
          document.getElementById('empty-state').style.display = 'block';
          document.getElementById('fights-table').style.display = 'none';
          return;
        }

        const response = await fetch('/api/user/battles', {
          method: 'GET',
          headers: {
            'Authorization': 'Bearer ' + authToken,
          },
        });

        if (!response.ok) {
          throw new Error('Failed to load fights');
        }

        const data = await response.json();
        const fights = data.fights || [];

        if (fights.length === 0) {
          document.getElementById('empty-state').style.display = 'block';
          document.getElementById('fights-table').style.display = 'none';
          updateMetrics({ fights: [] });
          return;
        }

        // Populate table
        const tbody = document.getElementById('fights-tbody');
        tbody.innerHTML = '';
        fights.forEach(f => {
          const date = new Date(f.created_at);
          const dateStr = date.toLocaleDateString() + ' ' + date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          const isWin = f.winner === 'player';
          const isPredictionCorrect =
            (f.predicted_win_rate > 50 && isWin) ||
            (f.predicted_win_rate <= 50 && !isWin);
          const accuracy = isPredictionCorrect ? 'Correct' : 'Wrong';
          const accuracyClass = isPredictionCorrect ? 'status-correct' : 'status-wrong';

          const bpRatio = f.bp_player > 0 ? (f.bp_enemy / f.bp_player).toFixed(2) : '1.00';

          const row = `
            <tr>
              <td>${dateStr}</td>
              <td>${f.predicted_win_rate.toFixed(0)}%</td>
              <td style="color: ${isWin ? '#86efac' : '#f87171'}">${isWin ? 'Win' : 'Loss'}</td>
              <td>${bpRatio}x</td>
              <td class="${accuracyClass}">${accuracy}</td>
            </tr>
          `;
          tbody.innerHTML += row;
        });

        document.getElementById('empty-state').style.display = 'none';
        document.getElementById('fights-table').style.display = 'table';
        updateMetrics({ fights });
      } catch (error) {
        console.error('Error loading fights:', error);
        document.getElementById('empty-state').style.display = 'block';
        document.getElementById('fights-table').style.display = 'none';
      }
    }

    function updateMetrics(data) {
      const fights = data.fights || [];
      const total = fights.length;
      
      let correct = 0;
      let wins = 0;

      fights.forEach(f => {
        if (f.predicted_win_rate !== null) {
          const isWin = f.winner === 'player';
          const isPredictionCorrect =
            (f.predicted_win_rate > 50 && isWin) ||
            (f.predicted_win_rate <= 50 && !isWin);
          if (isPredictionCorrect) correct++;
        }
        if (f.winner === 'player') wins++;
      });

      const accuracy = total > 0 ? ((correct / total) * 100).toFixed(1) : '--';

      document.getElementById('metric-total').textContent = total;
      document.getElementById('metric-accuracy').textContent = accuracy + '%';
      document.getElementById('metric-wins').textContent = wins;
    }

    // Load fights on page load
    loadFights();
  </script>
</body>
</html>
