---
export const prerender = true;
import { heroes, getHeroById, statMaxima } from "../../data/heroes";
import Base from "../../layouts/Base.astro";
import HeroCompositions from '../../components/HeroCompositions.astro';
/* STATIC PATHS */
export function getStaticPaths() {
  return heroes.map((hero) => ({
    params: { id: hero.id },
  }));
}

const { id } = Astro.params;
const hero = getHeroById(id);
const heroIndex = heroes.findIndex((entry) => entry.id === id);
const heroTeamComps = (hero as any)?.teamComps;
const hasComps = heroTeamComps && Object.values(heroTeamComps).some((arr) => Array.isArray(arr) && arr.length > 0);
const prevHero = heroIndex > 0 ? heroes[heroIndex - 1] : null;
const nextHero = heroIndex >= 0 && heroIndex < heroes.length - 1 ? heroes[heroIndex + 1] : null;

if (!hero) {
  throw new Error(`Hero with id "${id}" not found`);
}

const PERCENT_STATS = new Set([
  "dodgeRate", "hitBonus", "critRate", "critRes", "critDmgBonus", "critDmgRed",
  "cooldownHaste", "atkSpdBonus", "pDmgBonus", "pDmgRed", "mDmgBonus", "mDmgRed",
  "healEff", "rechargeEff", "lifestealEff", "reflectEff", "effectRes", "effectHit",
  "controlRes", "controlBonus", "normalSkillPWR", "ultimatePWR"
]);

const STAT_LABELS: Record<string, string> = {
  might: "Might", hp: "HP", atk: "ATK", armor: "Armor", magicRes: "M-Res",
  dodgeRate: "Dodge", hitBonus: "Hit", critRate: "Crit Rate", critRes: "Crit RES",
  critDmgBonus: "Crit DMG", critDmgRed: "Crit Red", energy: "Energy",
  cooldownHaste: "Cooldown Haste", atkSpdBonus: "ATK SPD Bonus",
  pDmgBonus: "Physical DMG Bonus", pDmgRed: "Physical DMG Reduction",
  mDmgBonus: "Magical DMG Bonus", mDmgRed: "Magical DMG Reduction",
  healEff: "Heal Efficiency", rechargeEff: "Recharge Efficiency",
  lifestealEff: "Lifesteal Efficiency", reflectEff: "Reflect Efficiency",
  effectRes: "Effect Resistance", effectHit: "Effect Hit",
  controlRes: "Control Resistance", controlBonus: "Control Bonus",
  normalSkillPWR: "Normal Skill PWR", ultimatePWR: "Ultimate PWR"
};

// Stat grouping
const OFFENSIVE_STATS = ["atk", "critRate", "critDmgBonus", "atkSpdBonus", "pDmgBonus", "mDmgBonus", "normalSkillPWR", "ultimatePWR"];
const DEFENSIVE_STATS = ["hp", "armor", "magicRes", "dodgeRate", "critRes", "critDmgRed", "pDmgRed", "mDmgRed", "controlRes"];
const UTILITY_STATS = ["hitBonus", "energy", "cooldownHaste", "healEff", "rechargeEff", "lifestealEff", "reflectEff", "effectRes", "effectHit", "controlBonus"];

// Key stats for the at-a-glance strip
const KEY_STATS = ["might", "atk", "hp", "armor", "magicRes", "critRate"];

// Faction color mapping
const FACTION_COLORS: Record<string, { a: string; b: string; glow: string }> = {
  "Starglint": { a: "#5b9cf6", b: "#facc15", glow: "rgba(91,156,246,0.18)" },
  "Wildfire":  { a: "#f97316", b: "#dc2626", glow: "rgba(249,115,22,0.18)" },
  "Deepwater": { a: "#22d3ee", b: "#0ea5e9", glow: "rgba(34,211,238,0.18)" },
  "Spades":    { a: "#a78bfa", b: "#7c3aed", glow: "rgba(167,139,250,0.18)" },
};
const factionColor = FACTION_COLORS[hero.faction] ?? { a: "#a8844a", b: "#7c6e4a", glow: "rgba(168,132,74,0.18)" };

function formatStatVal(key: string, val: number): string {
  if (val === 0) return "0";
  if (PERCENT_STATS.has(key)) return val + "%";
  if (val >= 1_000_000) return (val / 1_000_000).toFixed(2) + "M";
  if (val >= 1_000) return (val / 1_000).toFixed(1) + "K";
  return String(val);
}

function statBarWidth(key: string, val: number): number {
  const max = (statMaxima as Record<string, number>)[key];
  if (!max || val === 0) return 0;
  return Math.min((val / max) * 100, 100);
}

// Tag label display: SNAKE_CASE -> Title Case
function tagLabel(tag: unknown): string {
  const s = String(tag ?? "");
  return s.replace(/_/g, " ").toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
}

const ratingCategories = [
  { key: "overall", label: "Overall" },
  { key: "pvp",     label: "PvP" },
  { key: "pve",     label: "PvE" },
];
const scenarioCategories = [
  { key: "grimSurge",         label: "Grim Surge" },
  { key: "delusionsDen",      label: "Delusions Den" },
  { key: "torrentRift",       label: "Torrent Rift" },
  { key: "forgottenLabyrinth",label: "Forgotten Labyrinth" },
];

const ratingsMap: Record<string, string> = hero.ratings as any ?? {};

// Dot nav sections
const dotSections = [
  { id: "section-profile",    label: "Profile" },
  { id: "section-skills",     label: "Skills" },
  { id: "section-ratings",    label: "Ratings" },
  { id: "section-stats",      label: "Stats" },
  { id: "section-synergies",  label: "Synergies" },
  ...(hasComps ? [{ id: "section-comps", label: "Compositions" }] : []),
  ...((hero as any).relicBreakpoints?.length ? [{ id: "section-investment", label: "Investment" }] : []),
  ...((hero as any)["content-creator"]?.length ? [{ id: "section-videos", label: "Videos" }] : []),
];
---

<Base
  title={hero ? `${hero.name} - Stats, Skills & Tier List | Motto Immortal` : "Hero | Motto Immortal"}
  description={hero ? `${hero.name} is a ${hero.class} (${hero.role}) hero in Motto Immortal. View stats, skills, ratings (${hero.ratings?.overall ?? ""}), team comps and synergies.` : undefined}
>
<div
  class="hero-page"
  data-faction={hero.faction}
  style={`--faction-a:${factionColor.a};--faction-b:${factionColor.b};--faction-glow:${factionColor.glow};`}
>

  <!-- ===================== STICKY THIN HEADER ===================== -->
  <header class="hero-page-header">
    <a href="/heros" class="page-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Heroes
    </a>
    <span class="page-hero-name">{hero.name}</span>
    <div class="hero-page-header-right">
      {hero.ratings?.overall && hero.ratings.overall !== "" && (
        <span class={`hdr-rating rating-${(hero.ratings.overall ?? "").toLowerCase()}`}>{hero.ratings.overall}</span>
      )}
      <a href={`/calculator?hero=${hero.id}`} class="hdr-calc-link">Calculator</a>
    </div>
  </header>

  <!-- ===================== CINEMATIC SHOWCASE ===================== -->
  <section class="showcase" aria-label="Hero showcase">
    <div
      class="showcase-art"
      style={`background-image:url(${hero.image});`}
      role="img"
      aria-label={hero.name}
    ></div>
    <div class="showcase-overlay"></div>

    <!-- Prev / Next arrows on image -->
    {prevHero ? (
      <a class="showcase-nav prev" href={`/heroes/${prevHero.id}`} aria-label={`Previous: ${prevHero.name}`} title={prevHero.name}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
    ) : (
      <span class="showcase-nav prev disabled" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </span>
    )}
    {nextHero ? (
      <a class="showcase-nav next" href={`/heroes/${nextHero.id}`} aria-label={`Next: ${nextHero.name}`} title={nextHero.name}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    ) : (
      <span class="showcase-nav next disabled" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </span>
    )}

    <!-- Bottom identity block -->
    <div class="showcase-identity">
      <h1 class="showcase-name">{hero.name}</h1>
      <div class="showcase-badges">
        <span class="id-badge">
          <img src={`https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/factions/${hero.faction.toLowerCase()}.webp`} alt={hero.faction} class="id-badge-icon" />
          {hero.faction}
        </span>
        <span class="id-badge">
          <img src={`https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/classes/${hero.class.toLowerCase()}.webp`} alt={hero.class} class="id-badge-icon" />
          {hero.class}
        </span>
        <span class="id-badge">
          <img src={`https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/icons/roles/${hero.role.toLowerCase()}.webp`} alt={hero.role} class="id-badge-icon" />
          {hero.role}
        </span>
        <span class="id-badge rarity-badge">{hero.rarity}</span>
      </div>
      {hero.synergies && hero.synergies.length > 0 && (
        <div class="showcase-tags">
          {hero.synergies.map((tag: string) => (
            <span class="showcase-tag">{tagLabel(tag)}</span>
          ))}
        </div>
      )}
    </div>

    <div class="showcase-scroll-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </section>

  <!-- ===================== FLOATING DOT NAV (desktop) ===================== -->
  <nav class="dot-nav" aria-label="Page sections">
    {dotSections.map((s) => (
      <a class="dot-nav-item" href={`#${s.id}`} data-section={s.id} title={s.label} aria-label={s.label}>
        <span class="dot"></span>
        <span class="dot-label">{s.label}</span>
      </a>
    ))}
  </nav>

  <!-- ===================== MAIN SCROLL CONTENT ===================== -->
  <main class="scroll-content">

    <!-- BUG BANNER (if active) -->
    {hero.activeBug && (
      <div class="bug-banner">
        <svg class="bug-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
        <div class="bug-text">
          <strong>Known Bug</strong>
          <span>{hero.activeBugNotes}</span>
        </div>
      </div>
    )}

    <!-- ── SECTION 1: PROFILE ── -->
    <section class="content-section" id="section-profile">
      <div class="section-label">Profile</div>

      <div class="profile-grid">
        <!-- Description + Core Mechanic -->
        <div class="profile-left">
          {hero.description && (
            <p class="hero-description">{hero.description}</p>
          )}
          {(hero as any).coreMechanic && (
            <div class="mechanic-card">
              <div class="mechanic-header">
                <span class="mechanic-title">Core Mechanic</span>
                <span class={`depth-badge depth-${(hero as any).coreMechanic.depthRating}`}>
                  {(hero as any).coreMechanic.depthRating} depth
                </span>
                {(hero as any).coreMechanic.commonlyMisunderstood && (
                  <span class="misunderstood-badge">Commonly Misunderstood</span>
                )}
              </div>
              <p class="mechanic-summary">{(hero as any).coreMechanic.summary}</p>
            </div>
          )}
        </div>

        <!-- Key stats at a glance -->
        <div class="profile-right">
          <div class="key-stats-label">At a Glance  <span class="key-stats-sub">(Lv. {hero.level}, {hero.evolution})</span></div>
          <div class="key-stats-grid">
            {KEY_STATS.map(key => {
              const val = Number((hero.stats as any)[key] ?? 0);
              return (
                <div class="key-stat-block">
                  <span class="key-stat-value">{formatStatVal(key, val)}</span>
                  <span class="key-stat-label">{STAT_LABELS[key]}</span>
                  <div class="key-stat-bar">
                    <div class="key-stat-bar-fill" style={`width:${statBarWidth(key, val)}%`}></div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <!-- ── SECTION 2: SKILLS ── -->
    <section class="content-section" id="section-skills">
      <div class="section-label">Skills &amp; Abilities</div>

      <!-- Skill tab strip -->
      <div class="skill-tabs" role="tablist">
        {hero.skills && hero.skills.map((skill: any, i: number) => (
          <button
            class={`skill-tab${i === 0 ? " active" : ""}${skill.isUltimate ? " is-ultimate" : ""}`}
            data-skill-tab={i}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
          >
            <div class="skill-tab-icon" style={`background-image:url(${skill.image || `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/skills/${hero.id}_skill_${i+1}.webp`})`}></div>
            <span class="skill-tab-label">{skill.isUltimate ? "Ultimate" : `Skill ${i+1}`}</span>
            {skill.damageType && (
              <span class={`dmg-type-chip dmg-${(skill.damageType as string).toLowerCase()}`}>{skill.damageType}</span>
            )}
          </button>
        ))}
        {hero.relic && (
          <button class="skill-tab is-relic" data-skill-tab="relic" role="tab" aria-selected="false">
            <div class="skill-tab-icon" style={`background-image:url(${hero.relic.image || `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/skills/${hero.id}_relic.webp`})`}></div>
            <span class="skill-tab-label">Relic</span>
          </button>
        )}
      </div>

      <!-- Skill panels -->
      <div class="skill-panels">
        {hero.skills && hero.skills.map((skill: any, i: number) => (
          <div class={`skill-panel${i === 0 ? " active" : ""}`} data-skill-panel={i} role="tabpanel">
            <div class="skill-panel-inner">
              <div class={skill.video ? "skill-body skill-body--has-video" : "skill-body"}>
                <div class="skill-text">
                  <div class="skill-panel-header">
                    <div class="skill-panel-icon" style={`background-image:url(${skill.image || `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/skills/${hero.id}_skill_${i+1}.webp`})`}></div>
                    <div class="skill-panel-meta">
                      <h3 class="skill-panel-name">{skill.name}</h3>
                      <div class="skill-panel-badges">
                        <span class="skill-panel-type">{skill.isUltimate ? "Ultimate" : `Skill ${i+1}`}</span>
                        {skill.damageType && (
                          <span class={`dmg-badge dmg-${(skill.damageType as string).toLowerCase()}`}>{skill.damageType}</span>
                        )}
                      </div>
                    </div>
                  </div>
                  <p class="skill-panel-desc">{skill.description}</p>
                  {(skill.upgrades?.level2 || skill.upgrades?.level3 || skill.upgrades?.level4) && (
                    <div class="skill-upgrades">
                      {skill.upgrades.level2 && <div class="upgrade-row"><span class="upgrade-lv">Lv 2</span><span class="upgrade-text">{skill.upgrades.level2}</span></div>}
                      {skill.upgrades.level3 && <div class="upgrade-row"><span class="upgrade-lv">Lv 3</span><span class="upgrade-text">{skill.upgrades.level3}</span></div>}
                      {skill.upgrades.level4 && <div class="upgrade-row"><span class="upgrade-lv">Lv 4</span><span class="upgrade-text">{skill.upgrades.level4}</span></div>}
                    </div>
                  )}
                </div>
                {skill.video && (
                  <div class="skill-video-wrap">
                    <video
                      class="skill-video"
                      data-video-src={`/skills/${skill.video}`}
                      autoplay
                      loop
                      muted
                      playsinline
                    ></video>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
        {hero.relic && (
          <div class="skill-panel is-relic-panel" data-skill-panel="relic" role="tabpanel">
            <div class="skill-panel-inner">
              <div class="skill-panel-header">
                <div class="skill-panel-icon is-relic-icon" style={`background-image:url(${hero.relic.image || `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/skills/${hero.id}_relic.webp`})`}></div>
                <div class="skill-panel-meta">
                  <h3 class="skill-panel-name">{hero.relic.name}</h3>
                  <div class="skill-panel-badges">
                    <span class="skill-panel-type">Relic</span>
                    {(hero as any).recommendedRelicLevel !== undefined && (
                      <span class={`relic-lv-badge rlv-${(hero as any).recommendedRelicLevel}`}>Lv. {(hero as any).recommendedRelicLevel}</span>
                    )}
                  </div>
                </div>
              </div>
              <p class="skill-panel-desc">{hero.relic.description}</p>
              {(hero.relic.upgrades?.level2 || hero.relic.upgrades?.level3 || hero.relic.upgrades?.level4) && (
                <div class="skill-upgrades">
                  {hero.relic.upgrades.level2 && <div class="upgrade-row"><span class="upgrade-lv">Lv 2</span><span class="upgrade-text">{hero.relic.upgrades.level2}</span></div>}
                  {hero.relic.upgrades.level3 && <div class="upgrade-row"><span class="upgrade-lv">Lv 3</span><span class="upgrade-text">{hero.relic.upgrades.level3}</span></div>}
                  {hero.relic.upgrades.level4 && <div class="upgrade-row"><span class="upgrade-lv">Lv 4</span><span class="upgrade-text">{hero.relic.upgrades.level4}</span></div>}
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- ── SECTION 3: RATINGS ── -->
    <section class="content-section" id="section-ratings">
      <div class="section-label">Meta Ratings</div>

      <!-- Big 3 rating tiles -->
      <div class="big-rating-tiles">
        {ratingCategories.map(cat => {
          const val = ratingsMap[cat.key] || "";
          return (
            <div class={`big-rating-tile rating-tile-${(val || "na").toLowerCase()}`}>
              <span class="big-rating-val">{val || "N/A"}</span>
              <span class="big-rating-label">{cat.label}</span>
            </div>
          );
        })}
      </div>

      <!-- Scenario ratings -->
      {scenarioCategories.some(c => ratingsMap[c.key] && ratingsMap[c.key] !== "") && (
        <div class="scenario-block">
          <div class="scenario-block-label">Game Modes</div>
          <div class="scenario-grid">
            {scenarioCategories.map(cat => {
              const val = ratingsMap[cat.key];
              if (!val) return null;
              return (
                <div class={`scenario-tile rating-tile-${(val || "na").toLowerCase()}`}>
                  <span class="scenario-val">{val}</span>
                  <span class="scenario-name">{cat.label}</span>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- Community sources -->
      {(hero as any).metaSources && (
        <div class="community-block">
          <div class="community-block-label">
            Community Sources
            {(hero as any).metaSources.lastVerified && (
              <span class="verified-tag">Verified {(hero as any).metaSources.lastVerified}</span>
            )}
          </div>
          <div class="community-grid">
            {(hero as any).metaSources.excelTier && (
              <div class="community-tile">
                <span class="community-source">Excel Tier List</span>
                <span class="community-val">{(hero as any).metaSources.excelTier}</span>
              </div>
            )}
            {(hero as any).metaSources.cnTier && (
              <div class="community-tile">
                <span class="community-source">CN Community</span>
                <span class="community-val">{(hero as any).metaSources.cnTier}</span>
              </div>
            )}
            {(hero as any).metaSources.egTier && (
              <div class="community-tile">
                <span class="community-source">EG Community</span>
                <span class="community-val">{(hero as any).metaSources.egTier}</span>
              </div>
            )}
            {(hero as any).metaSources.consensus && (
              <div class="community-tile">
                <span class="community-source">Consensus</span>
                <span class={`consensus-badge consensus-${(hero as any).metaSources.consensus}`}>{(hero as any).metaSources.consensus}</span>
              </div>
            )}
          </div>
          <p class="community-note">Community tiers use T0/T1/T2 notation -- independent of site ratings above.</p>
        </div>
      )}
    </section>

    <!-- ── SECTION 4: STATS ── -->
    <section class="content-section" id="section-stats">
      <div class="section-label">Combat Statistics <span class="section-sub">Lv. {hero.level} &middot; {hero.evolution}</span></div>

      <div class="stat-columns">
        <!-- Offensive -->
        <div class="stat-column">
          <div class="stat-col-header offensive-hdr">Offensive</div>
          {OFFENSIVE_STATS.map(key => {
            const val = Number((hero.stats as any)[key] ?? 0);
            return (
              <div class="stat-entry">
                <span class="stat-entry-label">{STAT_LABELS[key]}</span>
                <div class="stat-entry-right">
                  <span class="stat-entry-val">{formatStatVal(key, val)}</span>
                  <div class="stat-entry-bar">
                    <div class="stat-entry-fill offensive-fill" style={`width:${statBarWidth(key, val)}%`}></div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Defensive -->
        <div class="stat-column">
          <div class="stat-col-header defensive-hdr">Defensive</div>
          {DEFENSIVE_STATS.map(key => {
            const val = Number((hero.stats as any)[key] ?? 0);
            return (
              <div class="stat-entry">
                <span class="stat-entry-label">{STAT_LABELS[key]}</span>
                <div class="stat-entry-right">
                  <span class="stat-entry-val">{formatStatVal(key, val)}</span>
                  <div class="stat-entry-bar">
                    <div class="stat-entry-fill defensive-fill" style={`width:${statBarWidth(key, val)}%`}></div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Utility -->
        <div class="stat-column">
          <div class="stat-col-header utility-hdr">Utility</div>
          {UTILITY_STATS.map(key => {
            const val = Number((hero.stats as any)[key] ?? 0);
            return (
              <div class="stat-entry">
                <span class="stat-entry-label">{STAT_LABELS[key]}</span>
                <div class="stat-entry-right">
                  <span class="stat-entry-val">{formatStatVal(key, val)}</span>
                  <div class="stat-entry-bar">
                    <div class="stat-entry-fill utility-fill" style={`width:${statBarWidth(key, val)}%`}></div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ── SECTION 5: SYNERGIES ── -->
    <section class="content-section" id="section-synergies">
      <div class="section-label">Synergy Network</div>

      <!-- Hero synergy links -->
      {(hero as any).synergyLinks && (hero as any).synergyLinks.length > 0 && (
        <div class="syn-links-grid">
          {(hero as any).synergyLinks.map((link: { heroId: string; type: string; description: string }) => (
            <a href={`/heroes/${link.heroId}`} class={`syn-link-card syn-${link.type}`}>
              <div class="syn-link-portrait" style={`background-image:url(https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/${link.heroId}.webp)`} role="img" aria-label={link.heroId}></div>
              <div class="syn-link-body">
                <div class="syn-link-row">
                  <span class="syn-link-name">{link.heroId}</span>
                  <span class={`syn-link-badge syn-badge-${link.type}`}>{link.type}</span>
                </div>
                <p class="syn-link-desc">{link.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}

      <!-- Tag chips -->
      {hero.synergies && hero.synergies.length > 0 && (
        <div class="tag-cloud">
          <div class="tag-cloud-label">Ability Tags</div>
          <div class="tag-chips">
            {hero.synergies.map((tag: string) => (
              <span class="tag-chip">{tagLabel(tag)}</span>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- ── SECTION 6: COMPOSITIONS ── -->
    {hasComps && (
      <section class="content-section" id="section-comps">
        <div class="section-label">Team Compositions</div>

        <div class="comp-mode-tabs" role="tablist">
          <button class="comp-mode-tab active" data-comp-mode="general" role="tab">General</button>
          <button class="comp-mode-tab" data-comp-mode="pve" role="tab">PvE</button>
          <button class="comp-mode-tab" data-comp-mode="pvp" role="tab">PvP</button>
        </div>

        <div class="comp-panels">
          <div class="comp-panel active" data-comp-panel="general">
            <HeroCompositions heroId={id} mode="general" />
          </div>
          <div class="comp-panel" data-comp-panel="pve" style="display:none">
            <HeroCompositions heroId={id} mode="pve" />
          </div>
          <div class="comp-panel" data-comp-panel="pvp" style="display:none">
            <HeroCompositions heroId={id} mode="pvp" />
          </div>
        </div>
      </section>
    )}

    <!-- ── SECTION 7: INVESTMENT GUIDE ── -->
    {(hero as any).relicBreakpoints && (hero as any).relicBreakpoints.length > 0 && (
      <section class="content-section" id="section-investment">
        <div class="section-label">Investment Guide</div>

        <div class="investment-grid">
          <div class="relic-timeline">
            {(hero as any).relicBreakpoints.map((bp: { level: number; type: string; effect: string }, i: number) => (
              <div class="relic-bp-row">
                <div class="relic-bp-left">
                  <div class="relic-bp-dot"></div>
                  {i < (hero as any).relicBreakpoints.length - 1 && <div class="relic-bp-line"></div>}
                </div>
                <div class="relic-bp-content">
                  <div class="relic-bp-header">
                    <span class="relic-bp-lv">Relic {bp.level}</span>
                    <span class={`relic-bp-badge bp-${bp.type}`}>
                      {bp.type === "Mid Game" ? "Mid Game" : bp.type === "mandatory" ? "Mandatory" : bp.type === "recommended" ? "Recommended" : bp.type === "Early game" ? "Early game" : bp.type === "Late game" ? "Late game" : "High Spender"}
                    </span>
                  </div>
                  <p class="relic-bp-effect">{bp.effect}</p>
                </div>
              </div>
            ))}
          </div>

          {(hero as any).f2pInvestment && (
            <div class="f2p-card">
              <div class="f2p-header">F2P Recommendation</div>
              <div class="f2p-body">
                <span class="f2p-rec">{(hero as any).f2pInvestment.recommendation}</span>
                {(hero as any).f2pInvestment.notes && (
                  <p class="f2p-notes">{(hero as any).f2pInvestment.notes}</p>
                )}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ── SECTION 8: VIDEO GUIDES ── -->
    {(hero as any)["content-creator"] && (hero as any)["content-creator"].length > 0 && (
      <section class="content-section" id="section-videos">
        <div class="section-label">Video Guides</div>
        <div class="video-grid">
          {(hero as any)["content-creator"].map((guide: { titel: string; autor: string; videoId: string }) => (
            <div class="video-card">
              <div class="video-wrapper">
                <iframe
                  src={`https://www.youtube.com/embed/${guide.videoId}`}
                  title={guide.titel}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  style="border:none;"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>
              <div class="video-info">
                <h3 class="video-title">{guide.titel}</h3>
                <p class="video-author">by {guide.autor}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

  </main>
</div>
</Base>

<style>
/* =============================================
   CSS CUSTOM PROPERTIES & RESET
   ============================================= */
.hero-page {
  --faction-a: #a8844a;
  --faction-b: #7c6e4a;
  --faction-glow: rgba(168,132,74,0.15);
