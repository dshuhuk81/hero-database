    <script>
      // Skill master-detail switching.
      const buttons = Array.from(document.querySelectorAll("[data-skill-btn]"));
      const panels = Array.from(document.querySelectorAll("[data-skill]"));

      for (const button of buttons) {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-skill-btn");
          for (const other of buttons) other.classList.toggle("is-active", other === button);
          for (const panel of panels) {
            panel.classList.toggle("is-active", panel.getAttribute("data-skill") === id);
          }
        });
      }

      // Tab scrollspy. Highlights whichever section is nearest the sticky bar.
      const tabs = Array.from(document.querySelectorAll(".lt-tab"));
      const targets = tabs
        .map((tab) => {
          const id = tab.getAttribute("data-target");
          const el = id ? document.getElementById(id) : null;
          return el ? { tab, el } : null;
        })
        .filter((entry) => entry !== null);

      if (targets.length > 0) {
        let queued = false;
        const sync = () => {
          queued = false;
          const line = window.scrollY + 140;
          let current = targets[0];
          for (const entry of targets) {
            if (entry.el.offsetTop <= line) current = entry;
          }
          for (const entry of targets) {
            entry.tab.classList.toggle("is-active", entry === current);
          }
        };
        window.addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(sync);
          },
          { passive: true }
        );
        sync();
      }
    </script>
