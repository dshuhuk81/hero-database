---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import HeroDivineThrone from "../../components/HeroDivineThrone.astro";
import { heroes, getHeroById } from "../../data/heroes/withRatings";
import { localizeHeroData } from "../../data/heroes/localize";
import { getLocaleFromPathname, localizePath, type Locale } from "../../i18n/config";
import { pickLang } from "../../i18n/helpers";
import ratings from "../../data/ratings/hero-ratings.json";
import invest from "../../data/ratings/invest.json";
import divineThroneData from "../../data/divine-throne.json";
import allVirtues from "../../data/virtues.json";
import db from "../../data/all_heroes_db.json";

const R2 = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const VIRTUE_RARITY_SUFFIX: Record<string, string> = {
  blue: "_rare",
  purple: "_epic",
  gold: "_elite",
  red: "_legendary",
};

export function getStaticPaths() {
  return heroes
    .filter((entry) => import.meta.env.DEV || (entry as any).release !== false)
    .map((entry) => ({ params: { id: entry.id } }));
}

interface Props {
  id?: string;
  locale?: Locale;
}

const { id: propId, locale = getLocaleFromPathname(Astro.url.pathname) } = Astro.props as Props;
const routeId = propId ?? Astro.params.id;
const hero = localizeHeroData(getHeroById(routeId) as any, locale);

if (!hero) {
  throw new Error(`Hero with id "${routeId}" not found`);
}

const rating = (ratings as any)[hero.id] ?? {};
const heroInvest = (invest as any)[hero.id] ?? null;
const f2pInvestmentLabel = heroInvest?.f2pInvestment
  ? pickLang(heroInvest.f2pInvestment, locale)
  : "";
const divineThroneEntry =
  (divineThroneData as any).heroes.find((entry: any) => entry.heroId === hero.id) ?? null;

// ---------------------------------------------------------------- stat ranking
// The reference page shows "#9/40" next to each stat. We can do the same for
// real: rank within the comparable roster (exclude the level-20 Common pets and
// unreleased heroes that still have null stats - both are a different scale).
const allHeroes: any[] = Array.isArray(db) ? db : ((db as any).heroes ?? Object.values(db as any));
const roster = allHeroes.filter((h) => h && h.rarity !== "Common" && h.stats && h.stats.hp);

function rankOf(key: string, value: number): { rank: number; total: number; pct: number } | null {
  const values = roster.map((h) => Number(h.stats?.[key]) || 0);
  const nonZero = values.filter((v) => v > 0);
  if (!value || nonZero.length < 5) return null;
  const sorted = [...nonZero].sort((a, b) => b - a);
  const rank = sorted.findIndex((v) => v <= value) + 1;
  const max = sorted[0];
  return { rank, total: nonZero.length, pct: max > 0 ? value / max : 0 };
}

const STAT_LABELS: Record<string, string> = {
  might: "Might", hp: "Health", atk: "Attack", armor: "Armor", magicRes: "Magic Res",
  dodgeRate: "Dodge Rate", hitBonus: "Hit Bonus", critRate: "Crit Rate", critRes: "Crit Res",
  critDmgBonus: "Crit DMG Bonus", critDmgRed: "Crit DMG Reduction", energy: "Energy",
  cooldownHaste: "Cooldown Haste", atkSpdBonus: "ATK Speed Bonus", pDmgBonus: "P.DMG Bonus",
  pDmgRed: "P.DMG Reduction", mDmgBonus: "M.DMG Bonus", mDmgRed: "M.DMG Reduction",
  healEff: "Healing Effect", rechargeEff: "Recharge Effect", lifestealEff: "Lifesteal",
  reflectEff: "Reflect", effectRes: "Effect Res", effectHit: "Effect Hit",
  controlRes: "Control Res", controlBonus: "Control Bonus",
  normalSkillPWR: "Normal Skill PWR", ultimatePWR: "Ultimate PWR",
};
const PERCENT_STATS = new Set([
  "dodgeRate", "hitBonus", "critRate", "critRes", "critDmgBonus", "critDmgRed",
  "cooldownHaste", "atkSpdBonus", "pDmgBonus", "pDmgRed", "mDmgBonus", "mDmgRed",
  "healEff", "rechargeEff", "lifestealEff", "reflectEff", "effectRes", "effectHit",
  "controlRes", "controlBonus", "normalSkillPWR", "ultimatePWR",
]);
const statEntries = Object.entries(hero.stats ?? {}).map(([key, raw]) => {
  const value = Number(raw) || 0;
  return {
    key,
    label: STAT_LABELS[key] ?? key,
    value,
    display: PERCENT_STATS.has(key) ? `${value}%` : value.toLocaleString("en-US"),
    percent: PERCENT_STATS.has(key),
    rank: rankOf(key, value),
  };
});
const activeStats = statEntries.filter((s) => s.value > 0);

// ---------------------------------------------------------------------- ratings
// Render only grades that exist in hero-ratings.json rather than inventing
// unsupported mode-specific categories.
const RATING_FIELDS: Array<{ key: string; label: string }> = [
  { key: "pvp", label: "PvP" },
  { key: "pve", label: "PvE" },
  { key: "pveEarly", label: "PvE Early" },
  { key: "pveLate", label: "PvE Late" },
];
const subRatings = RATING_FIELDS
  .filter((f) => rating[f.key])
  .map((f) => ({ ...f, grade: String(rating[f.key]) }));

const RATING_GROUPS = [
  {
    title: "Grim Surge",
    modes: [
      { key: "grimSurgeBoss1", label: "Spirit of the Night Hag" },
      { key: "grimSurgeBoss2", label: "Epica" },
    ],
  },
  {
    title: "Others",
    modes: [
      { key: "odyssey", label: "Odyssey" },
      { key: "spire", label: "Spire" },
      { key: "delusionsDen", label: "Delusions Den" },
      { key: "realmRover", label: "Realm Rover" },
    ],
  },
  {
    title: "Torment Rift",
    modes: [
      { key: "tormentRiftBaphomet", label: "Baphomet" },
      { key: "tormentRiftLilith", label: "Lilith" },
      { key: "tormentRiftBoss3", label: "Isthar IV" },
    ],
  },
].map((group) => ({
  ...group,
  modes: group.modes.map((mode) => ({
    ...mode,
    grade: rating[mode.key] ? String(rating[mode.key]) : "",
  })),
}));

// ----------------------------------------------------------------------- skills
function escapeHtml(text: string): string {
  return String(text)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}
// The reference highlights every number inside skill text. Escape first, then
// wrap - the source is our own JSON, but escaping keeps the injection honest.
function highlightNumbers(text: string): string {
  return escapeHtml(text).replace(/(\d+(?:[.,]\d+)?%?)/g, '<span class="num">$1</span>');
}

const skillCards = [
  ...(hero.skills ?? [])
    .map((s: any, i: number) => ({
      id: s.id ?? `skill_${i + 1}`,
      name: s.name,
      kind: s.isUltimate ? "Ultimate" : "",
      description: s.description ?? "",
      upgrades: Object.entries(s.upgrades ?? {}) as Array<[string, string]>,
      icon: s.image || `${R2}/skills/${hero.id}_${s.id ?? `skill_${i + 1}`}.webp`,
      originalIndex: i,
      isUltimate: Boolean(s.isUltimate),
    }))
    .sort((a: any, b: any) => Number(b.isUltimate) - Number(a.isUltimate) || a.originalIndex - b.originalIndex),
  ...(hero.relic
    ? [{
        id: "relic",
        name: hero.relic.name,
        kind: "Relic",
        description: hero.relic.description ?? "",
        upgrades: Object.entries(hero.relic.upgrades ?? {}) as Array<[string, string]>,
        icon: hero.relic.image || `${R2}/skills/${hero.id}_relic.webp`,
      }]
    : []),
];

// ------------------------------------------------------------------- misc chips
function prettyTag(tag: string): string {
  return tag.replace(/^(TEAM|SELF|ENEMY|PLAYSTYLE)_/, "").replace(/_/g, " ")
    .toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
}

function virtueAssetUrl(name: string, rarity?: string): string {
  const compact = name.replace(/\s+/g, "").replace(/[^a-zA-Z0-9]/g, "");
  if (!compact) return "";
  const baseName = compact.charAt(0).toLowerCase() + compact.slice(1);
  const suffix = VIRTUE_RARITY_SUFFIX[rarity ?? "gold"] ?? VIRTUE_RARITY_SUFFIX.gold;
  return `${R2}/images/virtues/${baseName}${suffix}.png`;
}
// Dedupe: TEAM_HEAL and SELF_HEAL both flatten to "Heal", so the raw list
// renders the same chip twice.
const tagChips = [...new Set(((hero.synergies ?? []) as string[]).map(prettyTag))].slice(0, 6);

const partners = (hero.synergyPartners ?? []).map((p: any) => ({
  id: p.heroId,
  name: localizeHeroData(getHeroById(p.heroId) as any, locale)?.name
    ?? allHeroes.find((h) => h.id === p.heroId)?.name
    ?? p.heroId,
  image: `${R2}/heroes/thumbs/${p.heroId}-96.webp`,
}));

const virtueSets = (hero.virtueSets ?? []).map((set: any) => ({
  ...set,
  virtues: (set.virtues ?? [])
    .map((virtueId: string) => (allVirtues as any[]).find((virtue) => virtue.id === virtueId))
    .filter(Boolean),
}));

const tabs = [
  { id: "sec-overview", label: "Ratings" },
  { id: "sec-stats", label: "Stats" },
  { id: "sec-skills", label: "Skills" },
  ...(divineThroneEntry ? [{ id: "sec-divine-throne", label: "Divine Throne" }] : []),
  ...(virtueSets.length ? [{ id: "sec-virtues", label: "Virtues" }] : []),
  ...(partners.length ? [{ id: "sec-synergy", label: "Synergy" }] : []),
  ...(heroInvest ? [{ id: "sec-invest", label: "Investment" }] : []),
];
---

<Base
  title={`${hero.name} | Motto Immortal Hero Database`}
  description={`${hero.name} hero details, ratings, stats, skills, virtues, synergies, Divine Throne, and investment recommendations.`}
  image={`${R2}/heroes/${hero.id}.webp`}
  locale={locale}
>
    <div class="lt-page">
      <!-- ============================================================ BANNER -->
      <header class="lt-banner">
        <div class="lt-banner-art" style={`background-image:url(${R2}/heroes/${hero.id}.webp)`}></div>
        <div class="lt-banner-veil"></div>

        <a class="lt-back" href={localizePath("/heroes", locale)}>&larr; All Heroes</a>

        <div class="lt-banner-inner">
          <div class="lt-portrait">
            <img
              src={`${R2}/heroes/cards/${hero.id}-480.webp`}
              alt={hero.name}
              width="480"
              height="480"
              loading="eager"
            />
          </div>

          <div class="lt-ident">
            <h1 class="lt-name">{hero.name}</h1>

            <div class="lt-headline">
              <span class="lt-grade" data-tier={String(rating.overall || "N/A")}>
                {rating.overall || "N/A"}
              </span>
              <span class="lt-might">
                {Number(hero.stats?.might ?? 0).toLocaleString("en-US")}
                <em>Might</em>
              </span>
            </div>

            <div class="lt-hero-meta" aria-label="Hero information">
              <span class="lt-meta-chip">
                <img src={`${R2}/icons/factions/${hero.faction.toLowerCase()}.webp`} alt="" width="18" height="18" />
                {hero.faction}
              </span>
              <span class="lt-meta-chip">
                <img src={`${R2}/icons/classes/${hero.class.toLowerCase()}.webp`} alt="" width="18" height="18" />
                {hero.class}
              </span>
              <span class="lt-meta-chip">
                <img src={`${R2}/icons/roles/${hero.role.toLowerCase()}.webp`} alt="" width="18" height="18" />
                {hero.role}
              </span>
              <span class="lt-meta-chip">{hero.rarity}</span>
              <span class="lt-meta-chip">{hero.evolution}</span>
              <span class="lt-meta-chip">Lv. {hero.level}</span>
            </div>

            <div class="lt-chips">
              {tagChips.map((tag: string) => <span class="lt-chip">{tag}</span>)}
            </div>
          </div>
        </div>
      </header>

      <!-- ============================================================== TABS -->
      <nav class="lt-tabs" id="lt-tabs">
        <div class="lt-tabs-inner">
          {tabs.map((tab, i) => (
            <a class={`lt-tab${i === 0 ? " is-active" : ""}`} href={`#${tab.id}`} data-target={tab.id}>
              {tab.label}
            </a>
          ))}
        </div>
      </nav>

      <main class="lt-main">
        <!-- =============================================== RATINGS + STATS -->
        <div class="lt-duo" id="sec-overview">
          <section class="lt-col">
            <h2 class="lt-h2">Tier Ratings</h2>
            <div class="lt-flourish"></div>

            <div class="lt-panel">
              <div class="lt-overall">
                <span class="lt-overall-label">Overall</span>
                <span class="lt-grade" data-tier={String(rating.overall || "N/A")}>
                  {rating.overall || "N/A"}
                </span>
              </div>

              <h3 class="lt-rating-group-title">Modes</h3>
              <div class="lt-grade-grid">
                {subRatings.map((r) => (
                  <div class="lt-grade-tile">
                    <span class="lt-grade-tile-label">{r.label}</span>
                    <span class="lt-grade-tile-value" data-tier={r.grade}>{r.grade}</span>
                  </div>
                ))}
              </div>

              <div class="lt-rating-groups">
                {RATING_GROUPS.map((group) => (
                  <section class="lt-rating-group" aria-label={group.title}>
                    <h3 class="lt-rating-group-title">{group.title}</h3>
                    <div class="lt-grade-grid">
                      {group.modes.map((mode) => (
                        <div class={`lt-grade-tile${mode.grade ? "" : " is-placeholder"}`}>
                          <span class="lt-grade-tile-label">{mode.label}</span>
                          <span class="lt-grade-tile-value" data-tier={mode.grade || "N/A"}>
                            {mode.grade || "N/A"}
                          </span>
                        </div>
                      ))}
                    </div>
                  </section>
                ))}
              </div>

            </div>

            {hero.coreMechanic?.summary && (
              <div class="lt-panel lt-panel-quiet">
                <p class="lt-sublabel">Core Mechanic</p>
                <p class="lt-body" set:html={highlightNumbers(hero.coreMechanic.summary)}></p>
              </div>
            )}
          </section>

          <section class="lt-col" id="sec-stats">
            <h2 class="lt-h2">Stats</h2>
            <div class="lt-flourish"></div>

            <div class="lt-panel lt-panel-tight">
              {activeStats.map((s) => (
                <div class="lt-stat">
                  <div class="lt-stat-row">
                    <span class="lt-stat-label">{s.label}</span>
                    {s.rank && (
                      <span class="lt-rank">#{s.rank.rank}<em>/{s.rank.total}</em></span>
                    )}
                    <span class="lt-stat-value">{s.display}</span>
                  </div>
                  <div class="lt-stat-body">
                    {s.rank && (
                      <div class="lt-bar">
                        <span class="lt-bar-fill" style={`width:${Math.round(s.rank.pct * 100)}%`}></span>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>

          </section>
        </div>

        <!-- ============================================================ SKILLS -->
        <section class="lt-section" id="sec-skills">
          <h2 class="lt-h2 lt-h2-center">Skills</h2>
          <div class="lt-flourish lt-flourish-center"></div>

          <div class="lt-skills">
            <div class="lt-skill-detail">
              {skillCards.map((s, i) => (
                <article class={`lt-skill-panel${i === 0 ? " is-active" : ""}`} data-skill={s.id}>
                  <header class="lt-skill-head">
                    <div>
                      <h3 class="lt-skill-name">{s.name}</h3>
                      {s.kind && (
                        <div class="lt-skill-tags">
                          <span class={`lt-tag lt-tag-${s.kind.toLowerCase()}`}>{s.kind}</span>
                        </div>
                      )}
                    </div>
                    <img class="lt-skill-icon-lg" src={s.icon} alt="" width="72" height="72" loading="lazy" />
                  </header>

                  <p class="lt-skill-text" set:html={highlightNumbers(s.description)}></p>

                  {s.upgrades.length > 0 && (
                    <div class="lt-upgrades">
                      <p class="lt-sublabel">Upgrades</p>
                      {s.upgrades.map(([level, text]: [string, string]) => (
                        <div class="lt-upgrade">
                          <span class="lt-upgrade-lvl">{level.replace("level", "Lv ")}</span>
                          <span class="lt-upgrade-text" set:html={highlightNumbers(text)}></span>
                        </div>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>

            <ol class="lt-skill-list">
              {skillCards.map((s, i) => (
                <li>
                  <button class={`lt-skill-item${i === 0 ? " is-active" : ""}`} data-skill-btn={s.id} type="button">
                    <img src={s.icon} alt="" width="44" height="44" loading="lazy" />
                    <span class="lt-skill-item-body">
                      <span class="lt-skill-item-name">{s.name}</span>
                      {s.kind && (
                        <span class="lt-skill-tags">
                          <span class={`lt-tag lt-tag-${s.kind.toLowerCase()}`}>{s.kind}</span>
                        </span>
                      )}
                    </span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <!-- ===================================================== DIVINE THRONE -->
        {divineThroneEntry && (
          <section class="lt-section" id="sec-divine-throne">
            <h2 class="lt-h2 lt-h2-center">Divine Throne</h2>
            <div class="lt-flourish lt-flourish-center"></div>
            <HeroDivineThrone entry={divineThroneEntry} heroName={hero.name} locale={locale} />
          </section>
        )}

        <!-- =========================================================== VIRTUES -->
        {virtueSets.length > 0 && (
          <section class="lt-section" id="sec-virtues">
            <h2 class="lt-h2 lt-h2-center">Recommended Virtues</h2>
            <div class="lt-flourish lt-flourish-center"></div>
            <div class="lt-virtues">
              {virtueSets.map((set: any) => (
                <div class="lt-panel lt-virtue">
                  <h3 class="lt-virtue-label">{set.label}</h3>
                  <div class="lt-virtue-pieces">
                    {(set.virtues ?? []).map((virtue: any) => (
                      <div class={`lt-virtue-card virtue-rarity-${virtue.rarity ?? "blue"}`}>
                        <img
                          class="lt-virtue-image"
                          src={virtueAssetUrl(virtue.name, virtue.rarity)}
                          alt={`${virtue.name} virtue`}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="lt-virtue-name">{virtue.name}</span>
                      </div>
                    ))}
                  </div>
                  {set.comment && <p class="lt-body">{set.comment}</p>}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- =========================================================== SYNERGY -->
        {partners.length > 0 && (
          <section class="lt-section" id="sec-synergy">
            <h2 class="lt-h2 lt-h2-center">Synergy Partners</h2>
            <div class="lt-flourish lt-flourish-center"></div>
            <div class="lt-partners">
              {partners.map((p: any) => (
                <div class="lt-partner">
                  <img src={p.image} alt="" width="56" height="56" loading="lazy" />
                  <span class="lt-partner-name">{p.name}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- ======================================================== INVESTMENT -->
        {heroInvest && (
          <section class="lt-section" id="sec-invest">
            <h2 class="lt-h2 lt-h2-center">Investment</h2>
            <div class="lt-flourish lt-flourish-center"></div>
            <div class="lt-invest">
              {heroInvest.relicRecommendation && (
                <div class="lt-panel lt-invest-cell">
                  <p class="lt-sublabel">Relic</p>
                  <p class="lt-invest-value">{heroInvest.relicRecommendation}</p>
                </div>
              )}
              {heroInvest.f2pInvestment && (
                <div class="lt-panel lt-invest-cell">
                  <p class="lt-sublabel">F2P Target</p>
                  <p class="lt-invest-value">{f2pInvestmentLabel}</p>
                </div>
              )}
            </div>
          </section>
        )}

      </main>
    </div>

    <style is:global>
      /* Global scope is required because skill text is injected with
         set:html, so those spans never receive Astro's scoping attribute. With a
         scoped block the `.num` rule compiles to `.num[data-astro-cid-...]` and
         silently fails to match, killing the number highlighting. All visual
         values below come from the application's global token layer. */

      .lt-page {
        --faction-a: var(--accent-gold);
        --faction-b: var(--accent-purple);
        min-height: 100vh;
        background:
          radial-gradient(1200px 600px at 50% -10%, var(--accent-purple-dim), transparent 70%),
          var(--bg-base);
        color: var(--text-primary);
        font-family: var(--font-base);
      }

      /* ------------------------------------------------------------- banner */
      .lt-banner {
        position: relative;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        border-bottom: 1px solid var(--border-subtle);
      }
      /* The reference has bespoke scene art behind each hero. We only have a
         transparent character cutout, so blurring it alone yields near-black.
         A faction-tinted wash carries the banner instead, with the blurred
         cutout layered on top for colour bleed. */
      .lt-banner-art {
        position: absolute;
        inset: -40px;
        background-size: cover;
        background-position: 50% 30%;
        filter: blur(56px) saturate(1.4) brightness(0.55);
        opacity: 0.75;
        transform: scale(1.2);
      }
      .lt-banner-veil {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(760px 460px at 30% 46%, rgba(190, 60, 48, 0.2), transparent 68%),
          radial-gradient(680px 420px at 78% 30%, rgba(150, 106, 34, 0.22), transparent 70%),
          linear-gradient(to top, var(--bg-base) 1%, rgba(8, 7, 11, 0.42) 46%, rgba(8, 7, 11, 0.66) 100%);
      }
      .lt-back {
        position: absolute;
        top: var(--space-6);
        left: var(--space-6);
        z-index: var(--z-raised);
        color: var(--text-secondary);
        text-decoration: none;
        font-size: var(--text-sm);
        font-weight: var(--weight-semibold);
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-full);
        background: color-mix(in srgb, var(--bg-base) 72%, transparent);
        backdrop-filter: blur(12px);
        transition: var(--transition-colors);
      }
      .lt-back:hover { color: var(--accent-gold-light); border-color: var(--accent-gold-dim); }

      .lt-banner-inner {
        position: relative;
        z-index: 3;
        width: 100%;
        max-width: var(--page-max-width);
        margin: 0 auto;
        padding: var(--space-24) var(--space-8) var(--space-6);
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        align-items: end;
        gap: var(--space-3);
      }
      .lt-portrait { display: flex; justify-content: center; }
      .lt-portrait img {
        width: auto;
        max-width: 640px;
        height: auto;
        display: block;
        margin-bottom: -18px;
        filter: drop-shadow(0 26px 46px rgba(0, 0, 0, 0.72));
        position: absolute;
        top: 0;
      }

