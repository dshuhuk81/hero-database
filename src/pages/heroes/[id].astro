</style>

<script>
  // ── Skill tab switching ──
  const skillTabs = document.querySelectorAll('.skill-tab');
  const skillPanels = document.querySelectorAll('.skill-panel');

  function loadPanelVideo(panel: Element | null) {
    if (!panel) return;
    const video = panel.querySelector<HTMLVideoElement>('.skill-video');
    if (!video) return;
    const src = video.getAttribute('data-video-src');
    if (src && !video.src) {
      video.src = src;
      video.load();
      video.play().catch(() => {});
    } else if (video.src && video.paused) {
      video.play().catch(() => {});
    }
  }

  skillTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = tab.getAttribute('data-skill-tab');
      skillTabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
      skillPanels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      tab.setAttribute('aria-selected','true');
      const panel = document.querySelector(`.skill-panel[data-skill-panel="${idx}"]`);
      if (panel) panel.classList.add('active');
      loadPanelVideo(panel);
    });
  });

  // Load video for initially active panel (skill 1)
  loadPanelVideo(document.querySelector('.skill-panel.active'));

  // Arrow key cycling through skill tabs
  document.addEventListener('keydown', (e) => {
    const active = document.querySelector('.skill-tab.active');
    if (!active) return;
    const tabs = Array.from(skillTabs) as HTMLElement[];
    const i = tabs.indexOf(active as HTMLElement);
    if (e.key === 'ArrowRight' && i < tabs.length - 1) tabs[i+1].click();
    if (e.key === 'ArrowLeft'  && i > 0)               tabs[i-1].click();
  });

  // ── Composition mode tabs ──
  const compTabs = document.querySelectorAll('.comp-mode-tab');
  const compPanels = document.querySelectorAll('.comp-panel');

  function setCompMode(mode: string) {
    compTabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-comp-mode') === mode));
    compPanels.forEach(p => {
      const isMatch = p.getAttribute('data-comp-panel') === mode;
      (p as HTMLElement).style.display = isMatch ? 'block' : 'none';
      p.classList.toggle('active', isMatch);
    });
    try { localStorage.setItem('heroCompMode', mode); } catch {}
  }

  // Restore from localStorage
  let initMode = 'general';
  try {
    const saved = localStorage.getItem('heroCompMode');
    if (saved && ['general','pve','pvp'].includes(saved)) initMode = saved;
  } catch {}
  setCompMode(initMode);

  compTabs.forEach(tab => {
    tab.addEventListener('click', () => setCompMode(tab.getAttribute('data-comp-mode') ?? 'general'));
  });

  // ── Dot nav: IntersectionObserver ──
  const dotItems = document.querySelectorAll('.dot-nav-item');
  const sections = document.querySelectorAll('.content-section[id]');

  if (dotItems.length > 0 && sections.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          dotItems.forEach(d => d.classList.toggle('active', d.getAttribute('data-section') === id));
        }
      });
    }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });

    sections.forEach(s => observer.observe(s));
  }

  // Smooth scroll for dot nav
  dotItems.forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = item.getAttribute('data-section') ?? '';
      const target = document.getElementById(targetId);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
<script>
  function initVideos(container: Element | Document = document) {
    container.querySelectorAll<HTMLVideoElement>('video[data-video-src]').forEach(video => {
      if (!video.src) {
        video.src = video.dataset.videoSrc!;
        video.load();
      }
    });
  }

  // Init videos in the initially active panel
  initVideos();

  // When switching tabs, init + play video in the newly active panel
  document.querySelectorAll('[data-skill-tab]').forEach(tab => {
    tab.addEventListener('click', () => {
      const panel = document.querySelector('.skill-panel.active');
      if (panel) {
        initVideos(panel);
        panel.querySelectorAll<HTMLVideoElement>('video').forEach(v => v.play());
      }
    });
  });
</script>
