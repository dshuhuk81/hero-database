}

.showcase-scroll-hint {
  position: absolute;
  bottom: 16px;
  right: 40px;
  z-index: 10;
  animation: bounce 2s ease-in-out infinite;
  color: rgba(255,255,255,0.35);
}
.showcase-scroll-hint svg { width: 20px; height: 20px; }
@keyframes bounce {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

/* =============================================
   FLOATING DOT NAV
   ============================================= */
.dot-nav {
  position: fixed;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 150;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dot-nav-item {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  flex-direction: row-reverse;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 1px solid rgba(255,255,255,0.25);
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.dot-label {
  font-size: 0.72rem;
  font-weight: 600;
  color: rgba(255,255,255,0.55);
  background: rgba(0,0,0,0.7);
  padding: 3px 8px;
  border-radius: 6px;
  white-space: nowrap;
  opacity: 0;
  transform: translateX(8px);
  transition: opacity 0.2s, transform 0.2s;
  pointer-events: none;
}

.dot-nav-item:hover .dot-label,
.dot-nav-item.active .dot-label {
  opacity: 1;
  transform: translateX(0);
}

.dot-nav-item:hover .dot,
.dot-nav-item.active .dot {
  background: var(--faction-a);
  border-color: var(--faction-a);
  box-shadow: 0 0 8px var(--faction-a);
}

@media (max-width: 1100px) {
  .dot-nav { display: none; }
}

/* =============================================
   SCROLL CONTENT
   ============================================= */
.scroll-content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px 100px;
}

/* =============================================
