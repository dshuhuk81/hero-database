  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 600;
  color: #fff;
  backdrop-filter: blur(8px);
}
.id-badge-icon {
  width: 16px;
  height: 16px;
  object-fit: contain;
}
.rarity-badge {
  border-color: var(--faction-a);
  color: var(--faction-a);
}

.showcase-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.showcase-tag {
  padding: 3px 10px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 999px;
  font-size: 0.7rem;
