  color: var(--text-primary, #e0dff0);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

/* =============================================
   HERO PAGE HEADER (sticky, 52px)
   ============================================= */
.hero-page-header {
  position: sticky;
  top: 0;
  z-index: 200;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  background: rgba(7, 6, 12, 0.82);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.07);
}

.page-back {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  font-weight: 600;
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  transition: color 0.2s;
  flex-shrink: 0;
}
.page-back svg { width: 16px; height: 16px; }
.page-back:hover { color: rgba(255,255,255,0.9); }

.page-hero-name {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-bright, #fff);
  text-align: center;
  flex: 1;
  padding: 0 16px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-page-header-right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.hdr-rating {
  padding: 3px 10px;
  border-radius: 6px;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.03em;
}
/* tier colors reuse token approach */
.hdr-rating.rating-sss { background: linear-gradient(135deg, var(--tier-sss-from,#ff4d4d), var(--tier-sss-to,#b91c1c)); color: #fff; }
.hdr-rating.rating-ss  { background: linear-gradient(135deg, var(--tier-ss-from,#ffe066), var(--tier-ss-to,#facc15)); color: #1a1a1a; }
.hdr-rating.rating-s   { background: linear-gradient(135deg, var(--tier-s-from,#fde68a), var(--tier-s-to,#fbbf24)); color: #1a1a1a; }
.hdr-rating.rating-a   { background: linear-gradient(135deg, #fdba74, #fb923c); color: #1a1a1a; }
.hdr-rating.rating-b   { background: linear-gradient(135deg, #c4b5fd, #8b5cf6); color: #fff; }
.hdr-rating.rating-c   { background: linear-gradient(135deg, #93c5fd, #3b82f6); color: #fff; }

.hdr-calc-link {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--faction-a);
  text-decoration: none;
  padding: 4px 10px;
  border: 1px solid var(--faction-a);
  border-radius: 6px;
  opacity: 0.85;
  transition: opacity 0.2s, background 0.2s;
}
.hdr-calc-link:hover { opacity: 1; background: rgba(255,255,255,0.05); }

/* =============================================
   CINEMATIC SHOWCASE
   ============================================= */
.showcase {
  position: relative;
  width: 100%;
  height: 88vh;
  min-height: 520px;
  max-height: 900px;
  overflow: hidden;
}

.showcase-art {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center var(--hero-img-y, 30%);
  background-repeat: no-repeat;
  transform: scale(1.04);
  transition: transform 8s ease-out;
}
.showcase:hover .showcase-art { transform: scale(1); }

.showcase-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, rgba(7,6,12,0.25) 0%, transparent 30%, transparent 50%, rgba(7,6,12,0.92) 85%, rgba(7,6,12,1) 100%),
    linear-gradient(to right, rgba(7,6,12,0.35) 0%, transparent 40%);
}

/* Prev / Next arrows */
.showcase-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(7,6,12,0.55);
  border: 1px solid rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  color: rgba(255,255,255,0.8);
  text-decoration: none;
  transition: all 0.2s ease;
  pointer-events: auto;
}
.showcase-nav svg { width: 20px; height: 20px; }
.showcase-nav.prev { left: 20px; }
.showcase-nav.next { right: 20px; }
.showcase-nav:hover { background: rgba(30,30,40,0.85); border-color: var(--faction-a); color: var(--faction-a); transform: translateY(-50%) scale(1.08); }
.showcase-nav.disabled { opacity: 0.2; pointer-events: none; }

/* Identity block at bottom of showcase */
.showcase-identity {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 0 40px 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.showcase-name {
  font-size: clamp(2.8rem, 6vw, 5.5rem);
  font-weight: 800;
  line-height: 1.0;
  color: #fff;
  margin: 0 0 14px;
  text-shadow: 0 4px 32px rgba(0,0,0,0.6);
