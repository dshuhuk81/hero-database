---
export const prerender = true;
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { heroes } from "../data/heroes";
import accountBonusesConfig from "../data/accountBonuses.json";
import Analytics from '@vercel/analytics/astro';

const sortedHeroes = [...heroes].sort((a, b) =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base" })
);

const defaultHeroA = sortedHeroes.find((hero) => hero.id === "nuba") || sortedHeroes[0];
const defaultHeroB = sortedHeroes.find((hero) => hero.id !== defaultHeroA.id) || sortedHeroes[0];

const bonusPresets = accountBonusesConfig.presets;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Skill Value Comparator</title>
  <Analytics />
</head>
<body>
  <Sidebar />


<main class="main-content">
  <h1 class="title">Skill Value Comparator</h1>
  <p class="subtitle">Select one hero first. Add a second hero only if you want side-by-side comparison.</p>

  <div class="content-wrapper">
    <div class="toolbar">
      <div class="toolbar-main">
        <div class="toolbar-field">
          <label for="hero-a-select">Primary Hero</label>
          <select id="hero-a-select">
            {sortedHeroes.map((hero) => (
              <option value={hero.id} selected={hero.id === defaultHeroA.id}>{hero.name}</option>
            ))}
          </select>
        </div>
        <div class="toolbar-field hidden" id="hero-b-controls">
          <label for="hero-b-select">Comparison</label>
          <div class="toolbar-field-row">
            <select id="hero-b-select">
              {sortedHeroes.map((hero) => (
                <option value={hero.id} selected={hero.id === defaultHeroB.id}>{hero.name}</option>
              ))}
            </select>
            <button id="remove-hero-btn" type="button" class="ghost-btn" title="Remove comparison">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>
        <button class="add-slot" id="add-hero-btn" type="button">+ Compare</button>
      </div>
      <div class="toolbar-options">
        <div class="toolbar-field compact">
          <label for="bonus-preset">Account Bonuses</label>
          <select id="bonus-preset">
            {Object.entries(bonusPresets).map(([key, preset]) => (
              <option value={key} selected={key === "none"}>{preset.label}</option>
            ))}
          </select>
        </div>
        <button type="button" class="advanced-toggle" id="advanced-toggle">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Advanced
        </button>
      </div>
    </div>

    <div class="advanced-panel hidden" id="advanced-panel">
      <p class="advanced-hint">Estimated = Raw damage after armor mitigation and optional extra physical reduction (items/buffs).</p>
      <div class="control-row">
        <div class="control-group">
          <label for="model-select">Mitigation Model</label>
          <select id="model-select">
            <option value="A" selected>Model A (Armor/(Armor+K))</option>
            <option value="B">Model B (ATK/(ATK+Armor*C))</option>
          </select>
        </div>
        <div class="control-group">
          <label for="k-preset">K Preset</label>
          <select id="k-preset">
            <option value="balanced" selected>Balanced (52000)</option>
            <option value="low">Low (100000)</option>
            <option value="high">High (28600)</option>
            <option value="custom">Custom</option>
          </select>
        </div>
        <div class="control-group hidden" id="k-custom-group">
          <label for="k-custom">K Custom</label>
          <input id="k-custom" type="number" min="0" step="1000" value="52000" />
        </div>
        <div class="control-group hidden" id="c-input-group">
          <label for="c-input">Model B -- C Factor</label>
          <input id="c-input" type="number" min="0" step="0.1" value="1" />
        </div>
        <div class="control-group">
          <label for="extra-phys-red">Extra Physical Reduction</label>
          <div class="slider-row">
            <input id="extra-phys-red" type="range" min="0" max="60" step="1" value="0" />
            <span id="extra-phys-red-value">0%</span>
          </div>
        </div>
      </div>
    </div>

    <section class="compare-layout" id="compare-layout">
      <div class="hero-slot" id="hero-a-slot"></div>

      <div class="hero-slot secondary hidden" id="hero-b-container">
        <div id="hero-b-slot"></div>
      </div>
    </section>
  </div>
</main>

<Footer />

<script define:vars={{ heroes: sortedHeroes, bonusPresets: bonusPresets }}>
  function formatNumber(value) {
    return Math.round(value).toLocaleString();
  }

  function applyBonusesToHero(hero, presetKey) {
    if (!presetKey || presetKey === 'none') return hero;
    const preset = bonusPresets[presetKey];
    if (!preset || !preset.stats) return hero;
    const updated = { ...hero, stats: { ...hero.stats } };
    for (const [stat, value] of Object.entries(preset.stats)) {
      if (stat in updated.stats) {
        updated.stats[stat] = Number(value || 0);
      }
    }
    return updated;
  }

  const BASE_CRIT_MULTIPLIER = 1.5;

  function getCritMultiplier(hero) {
    return BASE_CRIT_MULTIPLIER + Number(hero.stats?.critDmgBonus || 0) / 100;
  }

  function getImpactLabel(hpPercent) {
    if (hpPercent >= 50) return { label: 'LETHAL', cls: 'impact-lethal' };
    if (hpPercent >= 30) return { label: 'DEVASTATING', cls: 'impact-devastating' };
    if (hpPercent >= 15) return { label: 'HEAVY', cls: 'impact-heavy' };
    if (hpPercent >= 5) return { label: 'SOLID', cls: 'impact-solid' };
    return { label: 'LIGHT', cls: 'impact-light' };
  }

  function computeEHP(hero, config) {
    const hp = Number(hero.stats?.hp || 0);
    const armor = Number(hero.stats?.armor || 0);
    const magicRes = Number(hero.stats?.magicRes || 0);
    const physDR = armor / (armor + config.kValue);
    const physEHP = physDR < 1 ? hp / (1 - physDR) : hp;
    const magicDR = magicRes / (magicRes + config.kValue);
    const magicEHP = magicDR < 1 ? hp / (1 - magicDR) : hp;
    return { physEHP, magicEHP, physDR: physDR * 100, magicDR: magicDR * 100 };
  }

  function extractHitCount(text) {
    if (!text) return 1;
    const patterns = [
      /(\d+)\s*times?,?\s*each\s+dealing/i,
      /(?:strikes?|hits?|striking)\s+(?:all\s+)?(?:units?\s+|enemies?\s+)?(\d+)\s*times?/i,
    ];
    for (const pattern of patterns) {
      const match = text.match(pattern);
      if (match) return parseInt(match[1] || match[2]);
    }
    return 1;
  }

  function replaceStatBoundPercents(text, sourceHero, targetHero) {
    if (!text) return "";

    let output = text;

    output = output.replace(/(\d+(?:\.\d+)?)%\s*(?:of\s+)?(?:(?:her|his|its|their)\s+|\w+'s\s+)?ATK/gi, (_, percentRaw) => {
      const percent = parseFloat(percentRaw);
      const value = (percent / 100) * sourceHero.stats.atk;
      return `${percentRaw}% ATK (${formatNumber(value)} raw)`;
    });

    output = output.replace(/(\d+(?:\.\d+)?)%\s*of\s+(?:their\s+)?max\s+HP/gi, (_, percentRaw) => {
      const percent = parseFloat(percentRaw);
      if (!targetHero) {
        return `${percent}% of target Max HP (select comparison hero)`;
      }
      const value = (percent / 100) * targetHero.stats.hp;
      return `${percentRaw}% Max HP (${formatNumber(value)} raw)`;
    });

    output = output.replace(/(\d+(?:\.\d+)?)%\s*of\s+(?:their\s+)?current\s+HP/gi, (_, percentRaw) => {
      const percent = parseFloat(percentRaw);
      if (!targetHero) {
        return `${percent}% of target Current HP (select comparison hero)`;
      }
      const value = (percent / 100) * targetHero.stats.hp;
      return `${percentRaw}% Current HP (up to ${formatNumber(value)} raw at full HP)`;
    });

    output = output.replace(/capped\s+at\s+(\d+(?:\.\d+)?)%\s*(?:of\s+)?(?:(?:her|his|its|their)\s+|\w+'s\s+)?ATK/gi, (_, percentRaw) => {
      const percent = parseFloat(percentRaw);
      const value = (percent / 100) * sourceHero.stats.atk;
      return `capped at ${percentRaw}% ATK (${formatNumber(value)} raw)`;
    });

    output = output.replace(/(\d+(?:\.\d+)?)%\s*of\s+(?:Nuba's|her|his|its)\s+Max\s+HP/gi, (_, percentRaw) => {
      const percent = parseFloat(percentRaw);
      const value = (percent / 100) * sourceHero.stats.hp;
      return `${formatNumber(value)} HP`;
    });

    output = output.replace(/(\d+(?:\.\d+)?)%\s*of\s+Max\s+HP/gi, (_, percentRaw) => {
      const percent = parseFloat(percentRaw);
      const value = (percent / 100) * sourceHero.stats.hp;
      return `${formatNumber(value)} HP`;
    });

    return output;
  }

  const K_PRESETS = {
    low: 100000,
    balanced: 52000,
    high: 28600,
  };

  function getMitigationConfig() {
    const model = document.getElementById("model-select")?.value || "A";
    const kPreset = document.getElementById("k-preset")?.value || "balanced";
    const kCustomInput = document.getElementById("k-custom");
    const cInput = document.getElementById("c-input");
    const extraRedInput = document.getElementById("extra-phys-red");
    const extraRedValue = document.getElementById("extra-phys-red-value");

    const presetValue = K_PRESETS[kPreset] ?? K_PRESETS.balanced;
    const kCustom = parseFloat(kCustomInput?.value || presetValue);
    const kValue = kPreset === "custom" ? kCustom : presetValue;
    const cValue = parseFloat(cInput?.value || "1");
    const extraPhysRed = parseFloat(extraRedInput?.value || "0");

    if (kCustomInput) kCustomInput.disabled = kPreset !== "custom";
    if (cInput) cInput.disabled = model !== "B";
    if (extraRedValue) extraRedValue.textContent = `${extraPhysRed}%`;

    // Show/hide advanced control groups based on selections
    const kCustomGroup = document.getElementById("k-custom-group");
    const cInputGroup = document.getElementById("c-input-group");
    if (kCustomGroup) kCustomGroup.classList.toggle("hidden", kPreset !== "custom");
    if (cInputGroup) cInputGroup.classList.toggle("hidden", model !== "B");

    return { model, kValue, cValue, extraPhysRed, durationSeconds: 10 };
  }

  function applyMitigation(raw, attacker, target, config, damageType) {
    if (!target) return null;
    // True damage bypasses all mitigation
    const dt = (damageType || '').toLowerCase();
    if (dt === 'true') return raw;
    // Pick defense stat: Magical -> magicRes, Physical/default -> armor
    const defStat = dt === 'magical'
      ? Number(target.stats?.magicRes || 0)
      : Number(target.stats?.armor || 0);
    let mitigated;
    if (config.model === 'B') {
      const atk = Number(attacker.stats?.atk || 0);
      const denom = atk + defStat * config.cValue;
      mitigated = denom > 0 ? raw * (atk / denom) : raw;
    } else {
      const denom = defStat + config.kValue;
      const dr = denom > 0 ? defStat / denom : 0;
      mitigated = raw * (1 - dr);
    }
    // Extra physical reduction only applies to physical damage
    if (dt !== 'magical') {
      mitigated = mitigated * (1 - config.extraPhysRed / 100);
    }
    return mitigated;
  }

  function extractConditionalLabel(text) {
    const match = text?.match(/If\s+([^.,;]+?),?\s*this instead deals/i);
    return match ? match[1].trim() : "Conditional";
  }

  function extractCapPercent(text) {
    const match = text?.match(/capped\s+at\s+(\d+(?:\.\d+)?)%\s*(?:of\s+)?(?:(?:her|his|its|their)\s+|\w+'s\s+)?ATK/i);
    return match ? parseFloat(match[1]) : null;
  }

  function extractCurrentHpPercent(text) {
    const match = text?.match(/(\d+(?:\.\d+)?)%\s*of\s+(?:their\s+)?current\s+HP/i);
    return match ? parseFloat(match[1]) : null;
  }

  function extractIntervalSeconds(text) {
    const match = text?.match(/Every\s*(\d+(?:\.\d+)?)\s*s/i);
    return match ? parseFloat(match[1]) : null;
  }

  function extractAtkPercents(skill) {
    const description = skill.description || "";
    const upgrades = skill.upgrades || {};
    const upgradeText = Object.values(upgrades).join(" ");

    const conditionalMatch = description.match(/instead deals\s+(\d+(?:\.\d+)?)%\s*(?:of\s+)?(?:(?:her|his|its|their)\s+|\w+'s\s+)?ATK/i);
    const descriptionAtkMatch = description.match(/(\d+(?:\.\d+)?)%\s*(?:of\s+)?(?:(?:her|his|its|their)\s+|\w+'s\s+)?ATK/i);
    let normalPct = descriptionAtkMatch ? parseFloat(descriptionAtkMatch[1]) : null;
    let conditionalPct = conditionalMatch ? parseFloat(conditionalMatch[1]) : null;

    const upgradeDualMatch = upgradeText.match(/Increases\s+DMG\s+dealt\s+to\s+(\d+(?:\.\d+)?)%\s*(?:of\s+)?(?:(?:her|his|its|their)\s+|\w+'s\s+)?ATK\s+and\s+(\d+(?:\.\d+)?)%\s*(?:of\s+)?(?:(?:her|his|its|their)\s+|\w+'s\s+)?ATK/i);
    if (upgradeDualMatch) {
      normalPct = parseFloat(upgradeDualMatch[1]);
      conditionalPct = parseFloat(upgradeDualMatch[2]);
    }

    const upgradeSingleMatch = upgradeText.match(/(Active\s+DMG\s+increases\s+to|Increases\s+DMG\s+dealt\s+to|DMG\s+increases\s+to)\s+(\d+(?:\.\d+)?)%\s*(?:of\s+)?(?:(?:her|his|its|their)\s+|\w+'s\s+)?ATK/i);
    if (upgradeSingleMatch) {
      normalPct = parseFloat(upgradeSingleMatch[2]);
    }

    return { normalPct, conditionalPct };
  }

  function renderSkillNumbers(skill, sourceHero, targetHero, config) {
    const description = skill.description || "";
    const damageType = skill.damageType || '';
    const capPct = extractCapPercent(description);
    const currentHpPct = extractCurrentHpPercent(description);
    const intervalSeconds = extractIntervalSeconds(description);
    const conditionLabel = extractConditionalLabel(description);
    const { normalPct, conditionalPct } = extractAtkPercents(skill);
    const hitCount = extractHitCount(description);

    const rows = [];

    if (normalPct) {
      const raw = (normalPct / 100) * sourceHero.stats.atk;
      const cappedRaw = capPct ? Math.min(raw, (capPct / 100) * sourceHero.stats.atk) : raw;
      const estimated = applyMitigation(cappedRaw, sourceHero, targetHero, config, damageType);
      rows.push({
        label: hitCount > 1
          ? `Per Hit (${normalPct}% ATK${capPct ? `, cap ${capPct}%` : ""})`
          : `Normal (${normalPct}% ATK${capPct ? `, cap ${capPct}%` : ""})`,
        raw: cappedRaw,
        estimated,
      });
      if (hitCount > 1) {
        rows.push({
          label: `Total (x${hitCount} hits)`,
          raw: cappedRaw * hitCount,
          estimated: estimated !== null ? estimated * hitCount : null,
          isMultiHitTotal: true,
        });
      }
    }

    if (conditionalPct) {
      const raw = (conditionalPct / 100) * sourceHero.stats.atk;
      const cappedRaw = capPct ? Math.min(raw, (capPct / 100) * sourceHero.stats.atk) : raw;
      const estimated = applyMitigation(cappedRaw, sourceHero, targetHero, config, damageType);
      rows.push({
        label: hitCount > 1
          ? `${conditionLabel} Per Hit (${conditionalPct}% ATK${capPct ? `, cap ${capPct}%` : ""})`
          : `${conditionLabel} (${conditionalPct}% ATK${capPct ? `, cap ${capPct}%` : ""})`,
        raw: cappedRaw,
        estimated,
      });
      if (hitCount > 1) {
        rows.push({
          label: `${conditionLabel} Total (x${hitCount})`,
          raw: cappedRaw * hitCount,
          estimated: estimated !== null ? estimated * hitCount : null,
          isMultiHitTotal: true,
        });
      }
    }

    if (currentHpPct && targetHero) {
      const firstTickRaw = Math.min(
        (currentHpPct / 100) * targetHero.stats.hp,
        capPct ? (capPct / 100) * sourceHero.stats.atk : Infinity
      );
      const ticks = intervalSeconds ? Math.floor(config.durationSeconds / intervalSeconds) : 1;
      const firstTickEst = applyMitigation(firstTickRaw, sourceHero, targetHero, config, damageType);

      // Geometric simulation: HP decreases after each mitigated tick
      let currentHp = targetHero.stats.hp;
      let totalRaw = 0;
      let totalEstimated = 0;
      for (let i = 0; i < ticks; i++) {
        const tickRaw = Math.min(
          (currentHpPct / 100) * currentHp,
          capPct ? (capPct / 100) * sourceHero.stats.atk : Infinity
        );
        const tickEst = applyMitigation(tickRaw, sourceHero, targetHero, config, damageType);
        totalRaw += tickRaw;
        if (tickEst !== null) totalEstimated += tickEst;
        currentHp = Math.max(0, currentHp - (tickEst !== null ? tickEst : tickRaw));
      }

      rows.push({
        label: `First tick (${currentHpPct}% Current HP${intervalSeconds ? ` every ${intervalSeconds}s` : ""})`,
        raw: firstTickRaw,
        estimated: firstTickEst,
      });
      rows.push({
        label: `${config.durationSeconds}s total (${ticks} ticks, HP decays)`,
        raw: totalRaw,
        estimated: totalEstimated > 0 ? totalEstimated : null,
      });
    } else if (currentHpPct && !targetHero) {
      rows.push({
        label: `Current HP tick (${currentHpPct}%)`,
        raw: null,
        estimated: null,
        note: "Select comparison hero to estimate",
      });
    }

    if (!rows.length) return "";

    const targetHp = targetHero ? Number(targetHero.stats?.hp || 0) : 0;

    const rowsHtml = rows
      .map((row) => {
        const rawText = row.raw !== null ? `Raw ${formatNumber(row.raw)}` : "";
        const estimatedText = row.estimated !== null
          ? `Estimated ${formatNumber(row.estimated)}`
          : row.note || (targetHero ? "" : "Select comparison hero to estimate");
        const joiner = rawText && estimatedText ? ' <span class="sep-dot"></span> ' : "";

        // HP% impact bar
        let hpImpactHtml = '';
        if (row.estimated !== null && targetHero && targetHp > 0) {
          const hpPercent = (row.estimated / targetHp) * 100;
          const impact = getImpactLabel(hpPercent);
          hpImpactHtml = `
            <div class="hp-impact-row">
              <div class="hp-impact-bar-track">
                <div class="hp-impact-bar-fill ${impact.cls}" style="width: ${Math.min(hpPercent, 100)}%"></div>
              </div>
              <span class="hp-impact-text">${hpPercent.toFixed(1)}% of HP</span>
              <span class="impact-label ${impact.cls}">${impact.label}</span>
            </div>
          `;
        }

        return `
          <div class="numbers-row${row.isMultiHitTotal ? ' multi-hit-total' : ''}">
            <span class="numbers-label">${row.label}</span>
            <span class="numbers-values">${rawText}${joiner}${estimatedText}</span>
          </div>
          ${hpImpactHtml}
        `;
      })
      .join("");

    const infoPill = !targetHero
      ? `<div class="numbers-info-pill">+ Add Comparison Hero to see HP% impact and estimated damage</div>`
      : "";

    return `<div class="skill-numbers">${rowsHtml}${infoPill}</div>`;
  }

  function getDamageTypeBadge(damageType) {
    if (!damageType) return '';
    const dt = damageType.toLowerCase();
    if (dt === 'physical') return '<span class="dmg-badge dmg-physical">Physical</span>';
    if (dt === 'magical') return '<span class="dmg-badge dmg-magical">Magical</span>';
    if (dt === 'true') return '<span class="dmg-badge dmg-true">True</span>';
    return '';
  }

  function renderSkillBlock(skill, sourceHero, targetHero, skillIndex, config) {
    const upgraded = skill.upgrades || {};
    // Construct image path: use explicit path if provided, otherwise infer from hero ID and skill index
    const icon = skill.image || `/skills/${sourceHero.id}_skill_${skillIndex}.webp`;
    const level2 = upgraded.level2
      ? `<div class="upgrade-row"><span class="upgrade-label">LvL. 2</span><span class="upgrade-text">${replaceStatBoundPercents(upgraded.level2, sourceHero, targetHero)}</span></div>`
      : "";
    const level3 = upgraded.level3
      ? `<div class="upgrade-row"><span class="upgrade-label">LvL. 3</span><span class="upgrade-text">${replaceStatBoundPercents(upgraded.level3, sourceHero, targetHero)}</span></div>`
      : "";
    const level4 = upgraded.level4
      ? `<div class="upgrade-row"><span class="upgrade-label">LvL. 4</span><span class="upgrade-text">${replaceStatBoundPercents(upgraded.level4, sourceHero, targetHero)}</span></div>`
      : "";

    const upgradeHtml = (level2 || level3 || level4)
      ? `<div class="skill-upgrades">${level2}${level3}${level4}</div>`
      : "";

    return `
      <div class="skill-card">
        <div class="skill-header">
          <div class="skill-left">
            <img src="${icon}" alt="${skill.name}" class="skill-icon" />
            <div class="skill-info">
              <h3 class="skill-name">${skill.name}</h3>
              <div class="skill-tags">
                <span class="skill-type">Skill</span>
                ${getDamageTypeBadge(skill.damageType)}
              </div>
            </div>
          </div>
        </div>
        <p class="skill-description">${replaceStatBoundPercents(skill.description, sourceHero, targetHero)}</p>
        ${renderSkillNumbers(skill, sourceHero, targetHero, config)}
        ${upgradeHtml}
      </div>
    `;
  }

  function computeSkillBurstData(skills, sourceHero, targetHero, config) {
    const skillData = [];
    (skills || []).slice(0, 4).forEach((skill) => {
      const description = skill.description || "";
      const damageType = skill.damageType || '';
      const { normalPct, conditionalPct } = extractAtkPercents(skill);
      const capPct = extractCapPercent(description);
      const hitCount = extractHitCount(description);

      // Use best variant (higher damage) per skill
      let bestPct = normalPct;
      if (conditionalPct && (!normalPct || conditionalPct > normalPct)) {
        bestPct = conditionalPct;
      }

      if (bestPct) {
        const perHitRaw = (bestPct / 100) * sourceHero.stats.atk;
        const cappedPerHit = capPct ? Math.min(perHitRaw, (capPct / 100) * sourceHero.stats.atk) : perHitRaw;
        const totalRaw = cappedPerHit * hitCount;
        const totalEstimated = targetHero ? applyMitigation(totalRaw, sourceHero, targetHero, config, damageType) : null;

        skillData.push({
          skillName: skill.name,
          totalRaw,
          totalEstimated,
          hitCount,
          pct: bestPct,
        });
      }
    });
    return skillData;
  }

  function renderBurstSummary(skills, sourceHero, targetHero, config) {
    const burstData = computeSkillBurstData(skills, sourceHero, targetHero, config);
    if (!burstData.length) return '';

    const critMult = getCritMultiplier(sourceHero);
    const critRate = Number(sourceHero.stats?.critRate || 0);
    const targetHp = targetHero ? Number(targetHero.stats?.hp || 0) : 0;

    const totalRaw = burstData.reduce((sum, d) => sum + d.totalRaw, 0);
    const totalEstimated = targetHero ? burstData.reduce((sum, d) => sum + (d.totalEstimated || 0), 0) : null;
    const totalCritRaw = totalRaw * critMult;
    const totalCritEstimated = totalEstimated !== null ? totalEstimated * critMult : null;

    const hpPercentNormal = (targetHp > 0 && totalEstimated) ? (totalEstimated / targetHp * 100) : null;
    const hpPercentCrit = (targetHp > 0 && totalCritEstimated) ? (totalCritEstimated / targetHp * 100) : null;

    // Average damage factoring crit rate
    const avgEstimated = (totalEstimated && critRate > 0)
      ? totalEstimated * (1 - critRate / 100) + totalCritEstimated * (critRate / 100)
      : totalEstimated;
    const rotationsToKill = (targetHp > 0 && totalEstimated > 0) ? Math.ceil(targetHp / totalEstimated) : null;
    const rotationsToKillAvg = (targetHp > 0 && avgEstimated > 0) ? Math.ceil(targetHp / avgEstimated) : null;

    // EHP
    const ehp = computeEHP(sourceHero, config);

    // Build per-skill breakdown
    const breakdownHtml = burstData.map(d => {
      const estText = d.totalEstimated !== null ? formatNumber(d.totalEstimated) : '-';
      const hpPct = (targetHp > 0 && d.totalEstimated) ? (d.totalEstimated / targetHp * 100).toFixed(1) + '%' : '';
      return `<div class="burst-breakdown-row">
        <span class="burst-skill-name">${d.skillName}${d.hitCount > 1 ? ` (x${d.hitCount})` : ''}</span>
        <span class="burst-skill-dmg">${estText}${hpPct ? ` <span class="burst-skill-hp">${hpPct}</span>` : ''}</span>
      </div>`;
    }).join('');

    let html = `<div class="burst-summary">`;
    html += `<div class="burst-header">`;
    html += `<h3 class="burst-title">Full Rotation Burst</h3>`;
    html += `<span class="burst-subtitle">Best-variant damage from all skills combined</span>`;
    html += `</div>`;

    // Per-skill breakdown
    html += `<div class="burst-breakdown">${breakdownHtml}</div>`;

    // Normal burst total
    html += `<div class="burst-totals">`;
    html += `<div class="burst-row">`;
    html += `<span class="burst-label">Normal</span>`;
    html += `<span class="burst-values">Raw ${formatNumber(totalRaw)}${totalEstimated !== null ? ` <span class="sep-dot"></span> Est. ${formatNumber(totalEstimated)}` : ''}</span>`;
    html += `</div>`;

    // Crit burst total
    html += `<div class="burst-row crit-accent">`;
    html += `<span class="burst-label">All-Crit (${(critMult * 100).toFixed(0)}%)</span>`;
    html += `<span class="burst-values burst-crit-val">Raw ${formatNumber(totalCritRaw)}${totalCritEstimated !== null ? ` <span class="sep-dot"></span> Est. ${formatNumber(totalCritEstimated)}` : ''}</span>`;
    html += `</div>`;
    html += `</div>`;

    // HP% Impact bars
    if (hpPercentNormal !== null) {
      const impactNormal = getImpactLabel(hpPercentNormal);
      html += `<div class="burst-hp-section">`;
      html += `<div class="hp-impact-row">`;
      html += `<div class="hp-impact-bar-track"><div class="hp-impact-bar-fill ${impactNormal.cls}" style="width: ${Math.min(hpPercentNormal, 100)}%"></div></div>`;
      html += `<span class="hp-impact-text">${hpPercentNormal.toFixed(1)}% of HP</span>`;
      html += `<span class="impact-label ${impactNormal.cls}">${impactNormal.label}</span>`;
      html += `</div>`;
      if (hpPercentCrit !== null) {
        const impactCrit = getImpactLabel(hpPercentCrit);
        html += `<div class="hp-impact-row crit-accent">`;
        html += `<div class="hp-impact-bar-track"><div class="hp-impact-bar-fill ${impactCrit.cls}" style="width: ${Math.min(hpPercentCrit, 100)}%"></div></div>`;
        html += `<span class="hp-impact-text">${hpPercentCrit.toFixed(1)}% if all crit</span>`;
        html += `<span class="impact-label ${impactCrit.cls}">${impactCrit.label}</span>`;
        html += `</div>`;
      }
      html += `</div>`;
    }

    // Rotations to Kill
    if (rotationsToKill !== null) {
      const killText = rotationsToKill === 1 ? '1 rotation -- One-Shot Combo!' : `${rotationsToKill} rotations`;
      const avgText = (rotationsToKillAvg && rotationsToKillAvg !== rotationsToKill)
        ? ` <span class="sep-dot"></span> Avg w/ ${critRate}% crit: ${rotationsToKillAvg}`
        : '';
      html += `<div class="burst-kills">`;
      const killSvg = rotationsToKill === 1
        ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="7"/><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/><path d="M9 10h.01M15 10h.01"/></svg>'
        : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 17.5L3 6V3h3l11.5 11.5"/><path d="M13 19l6-6"/><path d="M16 16l4 4"/><path d="M19 21l2-2"/><path d="M9.5 6.5L21 18v3h-3L6.5 9.5"/><path d="M11 5L5 11"/><path d="M8 8L4 4"/><path d="M5 3L3 5"/></svg>';
      html += `<span class="kills-icon">${killSvg}</span>`;
      html += `<span class="kills-text">${killText}${avgText}</span>`;
      html += `</div>`;
    }

    html += `</div>`; // .burst-summary

    // EHP Card
    html += `<div class="ehp-card">`;
    html += `<h3 class="burst-title">Effective HP</h3>`;
    html += `<div class="ehp-grid">`;
    html += `<div class="ehp-item">`;
    html += `<span class="ehp-label">vs Physical</span>`;
    html += `<span class="ehp-value">${formatNumber(ehp.physEHP)}</span>`;
    html += `<span class="ehp-dr">${ehp.physDR.toFixed(1)}% damage reduction</span>`;
    html += `</div>`;
    html += `<div class="ehp-item">`;
    html += `<span class="ehp-label">vs Magical</span>`;
    html += `<span class="ehp-value">${formatNumber(ehp.magicEHP)}</span>`;
    html += `<span class="ehp-dr">${ehp.magicDR.toFixed(1)}% damage reduction</span>`;
    html += `</div>`;
    html += `</div>`;
    html += `</div>`; // .ehp-card

    return html;
  }

  function renderHeroPanel(mountId, hero, targetHero, label, config) {
    const mount = document.getElementById(mountId);
    if (!mount || !hero) return;

    const skillsHtml = (hero.skills || [])
      .slice(0, 4)
      .map((skill, index) => renderSkillBlock(skill, hero, targetHero, index + 1, config))
      .join("");

    const relicHtml = hero.relic
      ? `
        <div class="skill-card">
          <div class="skill-header">
            <div class="skill-left">
              <img src="${hero.relic.image || `/skills/${hero.id}_relic.webp`}" alt="${hero.relic.name}" class="skill-icon" />
              <div class="skill-info">
                <h3 class="skill-name">${hero.relic.name}</h3>
                <span class="skill-type">Relic</span>
              </div>
            </div>
          </div>
          <p class="skill-description">${replaceStatBoundPercents(hero.relic.description, hero, targetHero)}</p>
          ${(() => {
            const upgrades = hero.relic.upgrades || {};
            const level2 = upgrades.level2
              ? `<div class="upgrade-row"><span class="upgrade-label">LvL. 2</span><span class="upgrade-text">${replaceStatBoundPercents(upgrades.level2, hero, targetHero)}</span></div>`
              : "";
            const level3 = upgrades.level3
              ? `<div class="upgrade-row"><span class="upgrade-label">LvL. 3</span><span class="upgrade-text">${replaceStatBoundPercents(upgrades.level3, hero, targetHero)}</span></div>`
              : "";
            const level4 = upgrades.level4
              ? `<div class="upgrade-row"><span class="upgrade-label">LvL. 4</span><span class="upgrade-text">${replaceStatBoundPercents(upgrades.level4, hero, targetHero)}</span></div>`
              : "";

            return (level2 || level3 || level4)
              ? `<div class="skill-upgrades">${level2}${level3}${level4}</div>`
              : "";
          })()}
        </div>
      `
      : "";

    const heroImage = hero.image || `/heroes/${hero.id}.webp`;
    const burstSummaryHtml = renderBurstSummary(hero.skills, hero, targetHero, config);

    mount.innerHTML = `
      <div class="hero-panel">
        <div class="hero-meta">
          <img src="${heroImage}" alt="${hero.name}" class="hero-portrait" />
          <div class="hero-meta-details"><h2 class="hero-name">${hero.name}</h2>
            <div class="hero-stats-grid">
              <div class="hero-stat"><h4>ATK</h4><span>${formatNumber(hero.stats.atk)}</span></div>
              <div class="hero-stat"><h4>HP</h4><span>${formatNumber(hero.stats.hp)}</span></div>
              <div class="hero-stat"><h4>Armor</h4><span>${formatNumber(hero.stats.armor)}</span></div>
              <div class="hero-stat"><h4>M-Res</h4><span>${formatNumber(hero.stats.magicRes)}</span></div>
              <div class="hero-stat"><h4>Crit Rate</h4><span>${Number(hero.stats.critRate || 0)}%</span></div>
              <div class="hero-stat"><h4>Crit DMG</h4><span>${(getCritMultiplier(hero) * 100).toFixed(0)}%</span></div>
            </div>
            <div class="hero-identity-cards">
              <div class="identity-card">
                <h4>Class</h4>
                <div class="identity-content">
                  <img
                    class="identity-icons"
                    src="/icons/classes/${String(hero.class || "").toLowerCase()}.webp"
                    alt="${hero.class}"
                  />
                  <span>${hero.class}</span>
                </div>
              </div>
              <div class="identity-card">
                <h4>Role</h4>
                <div class="identity-content">
                  <img
                    class="identity-icons"
                    src="/icons/roles/${String(hero.role || "").toLowerCase()}.webp"
                    alt="${hero.role}"
                  />
                  <span>${hero.role}</span>
                </div>
              </div>
              <div class="identity-card">
                <h4>Faction</h4>
                <div class="identity-content">
                  <img
                    class="identity-icons"
                    src="/icons/factions/${String(hero.faction || "").toLowerCase()}.webp"
                    alt="${hero.faction}"
                  />
                  <span>${hero.faction}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="skills-stack">
          ${skillsHtml}
          ${relicHtml}
        </div>

        ${burstSummaryHtml}
      </div>
    `;
  }

  function renderPage() {
    const config = getMitigationConfig();
    const heroAId = document.getElementById("hero-a-select")?.value;
    const heroBContainer = document.getElementById("hero-b-container");
    const hasComparison = !heroBContainer.classList.contains("hidden");
    const heroBId = document.getElementById("hero-b-select")?.value;

    const presetKey = document.getElementById("bonus-preset")?.value || 'none';
    const rawHeroA = heroes.find((hero) => hero.id === heroAId);
    const rawHeroB = hasComparison ? heroes.find((hero) => hero.id === heroBId) : null;
    const heroA = applyBonusesToHero(rawHeroA, presetKey);
    const heroB = rawHeroB ? applyBonusesToHero(rawHeroB, presetKey) : null;
    const compareLayout = document.getElementById("compare-layout");

    if (compareLayout) {
      compareLayout.classList.toggle("has-comparison", !!(hasComparison && heroB));
    }

    renderHeroPanel("hero-a-slot", heroA, heroB, "Primary", config);

    if (hasComparison && heroB) {
      renderHeroPanel("hero-b-slot", heroB, heroA, "Comparison", config);
    }
  }

  const addButton = document.getElementById("add-hero-btn");
  const removeButton = document.getElementById("remove-hero-btn");
  const heroBContainer = document.getElementById("hero-b-container");
  const heroBControls = document.getElementById("hero-b-controls");
  const modelSelect = document.getElementById("model-select");
  const kPresetSelect = document.getElementById("k-preset");
  const kCustomInput = document.getElementById("k-custom");
  const cInput = document.getElementById("c-input");
  const extraRedInput = document.getElementById("extra-phys-red");
  const bonusPresetSelect = document.getElementById("bonus-preset");
  const bonusDescEl = document.getElementById("bonus-desc");
  const advancedToggle = document.getElementById("advanced-toggle");
  const advancedPanel = document.getElementById("advanced-panel");

  advancedToggle.addEventListener("click", () => {
    const isOpen = !advancedPanel.classList.contains("hidden");
    advancedPanel.classList.toggle("hidden", isOpen);
    advancedToggle.classList.toggle("is-active", !isOpen);
  });

  bonusPresetSelect.addEventListener("change", () => {
    const key = bonusPresetSelect.value;
    if (bonusDescEl && bonusPresets[key]) {
      bonusDescEl.textContent = bonusPresets[key].description;
    }
    renderPage();
  });

  addButton.addEventListener("click", () => {
    heroBContainer.classList.remove("hidden");
    heroBControls.classList.remove("hidden");
    addButton.classList.add("hidden");
    renderPage();
  });

  removeButton.addEventListener("click", () => {
    heroBContainer.classList.add("hidden");
    heroBControls.classList.add("hidden");
    addButton.classList.remove("hidden");
    renderPage();
  });

  document.getElementById("hero-a-select").addEventListener("change", renderPage);
  document.getElementById("hero-b-select").addEventListener("change", renderPage);
  modelSelect.addEventListener("change", renderPage);
  kPresetSelect.addEventListener("change", renderPage);
  kCustomInput.addEventListener("input", renderPage);
  cInput.addEventListener("input", renderPage);
  extraRedInput.addEventListener("input", renderPage);

  renderPage();
</script>

