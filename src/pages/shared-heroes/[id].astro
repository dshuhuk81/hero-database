---
export const prerender = false;

import Sidebar from '../../components/Sidebar.astro';
import Footer from '../../components/Footer.astro';
import allHeroesData from '../../data/all_heroes_db.json';

interface Props {
  params: {
    id: string;
  };
}

const { id } = Astro.params;
let shareData: any = null;
let heroesMap: any = {};
let error = '';

// Convert allHeroesData to map for lookup
Object.values(allHeroesData).forEach((hero: any) => {
  heroesMap[hero.id] = hero;
});

try {
  const response = await fetch(`http://localhost:3001/api/shared-heroes/${id}`);
  if (!response.ok) {
    error = 'Setup not found';
  } else {
    shareData = await response.json();
  }
} catch (err) {
  error = 'Failed to load setup';
}

// Group heroes by faction
const factionMap: Record<string, any[]> = {};
if (shareData?.heroesData) {
  shareData.heroesData.forEach((item: any) => {
    const hero = heroesMap[item.hero_id];
    if (hero) {
      if (!factionMap[hero.faction]) {
        factionMap[hero.faction] = [];
      }
      factionMap[hero.faction].push({
        ...hero,
        evolution: item.evolution,
      });
    }
  });
}

const EVOLUTION_LEVELS: Record<number, string> = {
  1: 'Elite',
  2: 'Elite+',
  3: 'Epic',
  4: 'Epic+',
  5: 'Legendary',
  6: 'Legendary+',
  7: 'Exalted',
  8: 'Exalted+',
  9: 'Mythic',
  10: 'Divine',
  11: 'Divine I',
  12: 'Divine II',
  13: 'Divine III',
  14: 'Divine IV',
  15: 'Divine V',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shared Hero Setup - Hero Database</title>
  <style is:global>
    body {
      font-family: "Spectral", "Roboto", system-ui, sans-serif;
      background:
        radial-gradient(ellipse at 30% -10%, rgba(120,90,200,0.15), transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(255,215,100,0.08), transparent 55%),
        linear-gradient(to bottom, #0d0b10, #07060c);
      color: #e6e6eb;
      margin-left: 80px;
      min-height: 100vh;
    }

    @media (max-width: 768px) {
      body {
        margin-left: 0;
        margin-bottom: 60px;
      }
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 20px;
    }

    h1 {
      color: #e6e6eb;
      margin-bottom: 10px;
      font-size: 32px;
      text-align: center;
      font-weight: 600;
    }

    .header-info {
      text-align: center;
      color: #999;
      margin-bottom: 30px;
      font-size: 14px;
    }

    h2 {
      color: #e6e6eb;
      margin-top: 40px;
      margin-bottom: 20px;
      font-size: 24px;
      border-bottom: 2px solid rgba(250, 204, 21, 0.4);
      padding-bottom: 10px;
      font-weight: 500;
    }

    .faction-section {
      margin-bottom: 40px;
    }

    .faction-title {
      color: #facc15;
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 15px;
      padding-left: 10px;
      border-left: 4px solid #facc15;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .faction-icon {
      width: 28px;
      height: 28px;
      object-fit: contain;
      filter: drop-shadow(0 0 6px rgba(250, 204, 21, 0.3));
    }

    .heroes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(120px, 120px));
      gap: 15px;
      margin-bottom: 20px;
    }

    .hero-card {
      position: relative;
      border-radius: 8px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.03);
      border: 2px solid #facc15;
      box-shadow: 0 0 15px rgba(250, 204, 21, 0.4);
      width: 120px;
      height: 120px;
      max-width: 120px;
      max-height: 120px;
      background-size: cover;
      background-position: var(--hero-bg-position, 50% 10%);
      transition: all 0.3s ease;
    }

    .hero-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(250, 204, 21, 0.5);
    }

    .hero-info {
      padding: 6px;
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.9));
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 4px;
    }

    .hero-name {
      font-weight: 600;
      color: #e6e6eb;
      font-size: 10px;
      text-align: center;
    }

    .hero-evolution {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      background: rgba(0, 0, 0, 0.5);
      border-radius: 4px;
      padding: 3px 6px;
      font-size: 9px;
      min-width: 80px;
      color: #facc15;
      font-weight: 600;
    }

    .error-message {
      background: rgba(220, 53, 69, 0.1);
      border: 1px solid rgba(220, 53, 69, 0.3);
      color: #ff6b6b;
      padding: 20px;
      border-radius: 8px;
      text-align: center;
      margin-top: 40px;
    }

    .empty-message {
      text-align: center;
      color: #999;
      padding: 40px;
      font-size: 18px;
    }
  </style>
</head>
<body>
  <Sidebar />

  <div class="container">
    {error ? (
      <>
        <h1>Shared Hero Setup</h1>
        <div class="error-message">{error}</div>
      </>
    ) : (
      <>
        <h1>Shared Hero Setup</h1>
        {shareData && (
          <div class="header-info">
            Created {new Date(shareData.createdAt).toLocaleDateString()}
          </div>
        )}

        {Object.keys(factionMap).length === 0 ? (
          <div class="empty-message">No heroes in this setup</div>
        ) : (
          Object.keys(factionMap).sort().map((faction) => (
            <div class="faction-section">
              <div class="faction-title">
                <img class="faction-icon" src={`/icons/factions/${faction.toLowerCase()}.webp`} alt={faction} />
                <span>{faction}</span>
              </div>
              <div class="heroes-grid">
                {factionMap[faction].map((hero: any) => (
                  <a href={`/heroes/${hero.id}`} class="hero-card" style={`--hero-bg-position: 50% 10%; background-image: url('${hero.image}')`}>
                    <div class="hero-info">
                      <div class="hero-name">{hero.name}</div>
                      <div class="hero-evolution">
                        {EVOLUTION_LEVELS[hero.evolution] || `Level ${hero.evolution}`}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))
        )}
      </>
    )}
  </div>

  <Footer />
</body>
</html>
