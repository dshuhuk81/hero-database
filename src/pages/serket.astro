---
export const prerender = true;
import Base from "../layouts/Base.astro";

const heroId    = "serket";
const heroName  = "Serket";
const heroFaction = "Diamonds";
const heroClass = "Warrior";
const heroRole  = "Nimble";
const heroRarity = "Legendary";
const heroRating = "A";
const heroImage = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/serket.webp";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";

// Diamonds faction uses bright gold/amber tones (no specific map entry)
const factionA   = "#e2b858";
const factionB   = "#b8963a";
const factionGlow = "rgba(226,184,88,0.18)";

const sections = [
  { id: "section-identity",     label: "Identity" },
  { id: "section-summons",      label: "Summons" },
  { id: "section-survivability", label: "Survivability" },
  { id: "section-playstyle",    label: "Playstyle" },
  { id: "section-synergies",    label: "Synergies" },
  { id: "section-teams",        label: "Teams" },
  { id: "section-modes",        label: "Game Modes" },
  { id: "section-pvp",          label: "PvP + Counters" },
  { id: "section-build",        label: "Build Guide" },
  { id: "section-verdict",      label: "Verdict" },
];
---

<Base
  title="Serket Guide -- Bruiser Summoner Deep Dive | Motto Immortal"
  description="In-depth guide for Serket in Motto Immortal. Summon mechanics, survivability, team compositions, build priorities, counters, and tier placement."
>
<div
  class="hero-page"
  data-faction={heroFaction}
  style={`--faction-a:${factionA};--faction-b:${factionB};--faction-glow:${factionGlow};`}
>

  <!-- ===================== STICKY THIN HEADER ===================== -->
  <header class="hero-page-header">
    <a href={`/heroes/${heroId}`} class="page-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7-7"/></svg>
      <span>{heroName}</span>
    </a>
    <span class="page-hero-name">{heroName} -- Guide</span>
    <div class="hero-page-header-right">
      <span class="hdr-rating" data-tier={heroRating}>{heroRating}</span>
    </div>
  </header>

  <!-- ===================== CINEMATIC SHOWCASE ===================== -->
  <section class="showcase" aria-label="Serket hero showcase">
    <div class="showcase-bg"></div>
    <div
      class="showcase-art"
      style={`background-image:url(${heroImage});`}
      role="img"
      aria-label={heroName}
    ></div>
    <div class="showcase-overlay"></div>

    <div class="showcase-identity">
      <div class="guide-kicker">Hero Guide</div>
      <h1 class="showcase-name">{heroName}</h1>
      <div class="showcase-badges">
        <span class="id-badge">
          <img src={`${R2_BASE}/icons/factions/${heroFaction.toLowerCase()}.webp`} alt={heroFaction} class="id-badge-icon" />
          {heroFaction}
        </span>
        <span class="id-badge">
          <img src={`${R2_BASE}/icons/classes/${heroClass.toLowerCase()}.webp`} alt={heroClass} class="id-badge-icon" />
          {heroClass}
        </span>
        <span class="id-badge">
          <img src={`${R2_BASE}/icons/roles/${heroRole.toLowerCase()}.webp`} alt={heroRole} class="id-badge-icon" />
          {heroRole}
        </span>
        <span class="id-badge rarity-badge">{heroRarity}</span>
      </div>
      <p class="guide-showcase-tagline">
        Summon death as a damage event. Scorpions that fight on their own AI. Five simultaneous value layers.
      </p>
    </div>

    <div class="showcase-scroll-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </section>

  <!-- ===================== FLOATING DOT NAV ===================== -->
  <nav class="dot-nav" aria-label="Page sections">
    {sections.map((s) => (
      <a class="dot-nav-item" href={`#${s.id}`} data-section={s.id} title={s.label} aria-label={s.label}>
        <span class="dot"></span>
        <span class="dot-label">{s.label}</span>
      </a>
    ))}
  </nav>

  <!-- ===================== MAIN SCROLL CONTENT ===================== -->
  <main class="scroll-content">

    <!-- ========================================================
         SECTION 1: WHAT MAKES HER UNIQUE
         ======================================================== -->
    <section class="content-section" id="section-identity">
      <div class="section-label">What Makes Her Unique</div>

      <p class="guide-prose">
        Other summoners in the roster -- Nuwa with her figurines, Gemini with Castor, Zeus with his Echoes -- also produce persistent stat-inheriting allied units. What separates Serket is two properties no other summoner shares: her scorpions explode on death for AoE + ATK-Down (no other summoner has a death-value trigger), and her scorpions autonomously use her active skill on their own AI at Ult Lv.4. Zeus's Echoes are the closest comparison but only fire when Zeus himself casts -- that is a coupled multi-cast, not autonomous summon behavior. Summon death is a loss event for every other summoner. For Serket it is a damage event.
      </p>

      <p class="guide-prose">
        She is also the only Diamonds Warrior with the Nimble subtype and the only one whose core mechanic physically removes her from the battlefield via burrowing before re-engaging. Most divers operate with a single value layer. Serket runs five simultaneously from a single ultimate cast.
      </p>

      <div class="value-layers-grid">
        <div class="value-layer-card">
          <div class="value-layer-num">1</div>
          <div class="value-layer-body">
            <div class="value-layer-title">Underground Dive</div>
            <p class="value-layer-desc">Serket burrows to the farthest enemy, dealing damage along the entire path and knocking down enemies on emerge.</p>
          </div>
        </div>
        <div class="value-layer-card">
          <div class="value-layer-num">2</div>
          <div class="value-layer-body">
            <div class="value-layer-title">Three Scorpions</div>
            <p class="value-layer-desc">Each scorpion inherits 100% of Serket's base stats and, at Ult Lv.4, can independently use Burrowing Pierce themselves.</p>
          </div>
        </div>
        <div class="value-layer-card">
          <div class="value-layer-num">3</div>
          <div class="value-layer-body">
            <div class="value-layer-title">Board-Wide Relic AoE</div>
            <p class="value-layer-desc">At Relic Lv.3, each scorpion independently ticks AoE damage, adding up to 240% ATK/sec additional sustained board damage.</p>
          </div>
        </div>
        <div class="value-layer-card">
          <div class="value-layer-num">4</div>
          <div class="value-layer-body">
            <div class="value-layer-title">Death Explosions</div>
            <p class="value-layer-desc">Every scorpion that dies detonates for 200% ATK AoE in a 3m radius and applies a 10-second ATK-Down debuff to all hit enemies.</p>
          </div>
        </div>
        <div class="value-layer-card">
          <div class="value-layer-num">5</div>
          <div class="value-layer-body">
            <div class="value-layer-title">Underground Heal + HP Threshold</div>
            <p class="value-layer-desc">While underground at any point, she heals 60% ATK/sec. When HP first falls below 40%, she auto-burrows and permanently gains +30% max HP.</p>
          </div>
        </div>
      </div>

      <div class="mechanic-card guide-identity-card">
        <div class="mechanic-header">
          <span class="mechanic-title">What Actually Makes Her Different</span>
        </div>
        <p class="mechanic-summary">
          The SUMMON tag is currently only assigned to Serket in the DB, but Nuwa, Gemini, and Zeus also summon persistent stat-inheriting units -- a DB tag inconsistency, not real mechanical exclusivity. Her two verified unique properties: (1) scorpion death generates offensive value (200% ATK AoE + ATK-Down) -- every other summoner treats death as a neutral loss; (2) scorpions autonomously use her active skill on their own AI (Ult Lv.4). Zeus's Echoes only fire when Zeus himself casts -- that is a coupled multi-cast, not autonomous summon behavior.
        </p>
      </div>

      <!-- Serket vs Nuwa -->
      <div class="guide-section-sub">Serket vs. Nuwa -- Same Family, Different Axes</div>
      <p class="guide-prose">
        Since Nuwa is the top confirmed synergy partner, the obvious question is whether they compete. They do not. They operate on entirely different combat axes: Nuwa is a team enabler whose figurines buff and protect allied heroes; Serket is a self-completer whose scorpions are extensions of her own threat, not team utility. Running them together gives front/back coverage the enemy cannot address simultaneously -- Nuwa anchors the frontline with her Bulwark barrier while Serket dives the backline.
      </p>
      <div class="nuwa-compare-grid">
        <div class="nuwa-compare-header"></div>
        <div class="nuwa-compare-header">Serket</div>
        <div class="nuwa-compare-header">Nuwa</div>

        <div class="nuwa-compare-label">Class / Role</div>
        <div class="nuwa-compare-cell">Warrior / Nimble</div>
        <div class="nuwa-compare-cell">Tank / Hefty</div>

        <div class="nuwa-compare-label">Summon count</div>
        <div class="nuwa-compare-cell">3 simultaneous (via Ult)</div>
        <div class="nuwa-compare-cell">Up to 3 (1 per skill, on-demand)</div>

        <div class="nuwa-compare-label">Stat inheritance</div>
        <div class="nuwa-compare-cell">100% base stats (uniform across all 3)</div>
        <div class="nuwa-compare-cell">Asymmetric: 100-200% HP, 100-150% ATK per figurine type</div>

        <div class="nuwa-compare-label">Summon refresh</div>
        <div class="nuwa-compare-cell">Wait for ult cooldown</div>
        <div class="nuwa-compare-cell nuwa-compare-cell--highlight">Recasting heals existing figurine to full + adds new effect</div>

        <div class="nuwa-compare-label">Summon behavior</div>
        <div class="nuwa-compare-cell">All 3 deal AoE relic + dive farthest (Lv.4)</div>
        <div class="nuwa-compare-cell">Bulwark charges/stuns, Greataxe AoE, Support heals</div>

        <div class="nuwa-compare-label">Summon on death</div>
        <div class="nuwa-compare-cell nuwa-compare-cell--highlight">Explodes -- AoE + ATK-Down</div>
        <div class="nuwa-compare-cell">Disappears silently</div>

        <div class="nuwa-compare-label">Replicates controller's active</div>
        <div class="nuwa-compare-cell nuwa-compare-cell--highlight">Yes -- autonomous AI (Ult Lv.4)</div>
        <div class="nuwa-compare-cell">No</div>

        <div class="nuwa-compare-label">Team-facing value</div>
        <div class="nuwa-compare-cell">Self-completing pressure unit</div>
        <div class="nuwa-compare-cell">Team CC, shields, healing, damage-sharing</div>
      </div>
      <div class="guide-verdict-box guide-verdict-box--spaced">
        <span class="guide-verdict-label">When to pick which</span>
        Have a strong carry that needs an enabler? Nuwa. Have a control-heavy team that needs a self-sufficient backline pressure unit? Serket. Have both? Run them together.
      </div>
    </section>

    <!-- ========================================================
         SECTION 2: SUMMON MECHANICS
         ======================================================== -->
    <section class="content-section" id="section-summons">
      <div class="section-label">Summon Mechanics</div>

      <p class="guide-prose">
        When Serket activates Thousand Sand Shadows, she burrows underground and three scorpions spawn at her position. Each scorpion inherits 100% of her base stats -- ATK, HP, Armor, Magic Resistance -- but takes increased damage as a built-in balancing tax. At base, they last 10 seconds. Ult Lv.2 extends their duration.
      </p>

      <div class="milestone-strip">
        <div class="milestone-node">
          <div class="milestone-badge milestone-base">Base</div>
          <div class="milestone-label">Relic AoE on Serket. Functional baseline but modest output.</div>
        </div>
        <div class="milestone-connector"></div>
        <div class="milestone-node">
          <div class="milestone-badge milestone-lv2">Lv.2</div>
          <div class="milestone-label">Serket gains a personal damage-immunity proc once per 12 seconds. First major defensive spike.</div>
        </div>
        <div class="milestone-connector"></div>
        <div class="milestone-node">
          <div class="milestone-badge milestone-lv3">Lv.3</div>
          <div class="milestone-label">Each scorpion also deals AoE damage every second. Three scorpions = 240% ATK/sec board-wide. Major damage spike.</div>
        </div>
        <div class="milestone-connector"></div>
        <div class="milestone-node">
          <div class="milestone-badge milestone-lv4">Lv.4</div>
          <div class="milestone-label">Each scorpion gains its own immunity proc (once per 12s each). Three independent saves make clean removal extremely difficult.</div>
        </div>
      </div>

      <p class="guide-prose">
        At Ult Lv.4, scorpions can also use Burrowing Pierce independently, letting each one dive to the farthest enemy. This is the single biggest power spike in the kit -- it turns the ultimate from three stat-inheriting units into three micro-Serkets capable of simultaneous backline assault.
      </p>

      <div class="guide-section-sub">Scorpion Death: Punishing Both Answers</div>
      <p class="guide-prose">
        When any scorpion dies or expires, it triggers Venomblast Demise: a 200% ATK AoE explosion in a 3m radius, plus a 10-second ATK-Down debuff applied to all enemies in range. This means the enemy is penalized both for letting scorpions live and for killing them. Scorpion death is not a loss event -- it is a damage event.
      </p>

      <div class="scenario-cards-grid">
        <div class="scenario-action-card">
          <div class="scenario-action">Enemy AoE-clears all three scorpions</div>
          <div class="scenario-result">Three simultaneous explosions -- 600% ATK AoE total -- plus three stacked ATK-Down debuffs applied to the whole enemy team.</div>
        </div>
        <div class="scenario-action-card">
          <div class="scenario-action">Enemy ignores the scorpions</div>
          <div class="scenario-result">240% ATK/sec sustained board-wide AoE at Relic Lv.3, plus three independent Burrowing Pierce dives to the backline at Ult Lv.4.</div>
        </div>
        <div class="scenario-action-card">
          <div class="scenario-action">Enemy single-targets scorpions</div>
          <div class="scenario-result">At Relic Lv.4, each scorpion has its own immunity proc. Single-targeting one at a time absorbs three consecutive save windows before they go down.</div>
        </div>
        <div class="scenario-action-card">
          <div class="scenario-action">Fight extends, ultimate recharges</div>
          <div class="scenario-result">A new set of three scorpions arrives while previous explosions are still landing. Board pressure compounds across multiple rotations.</div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         SECTION 3: SURVIVABILITY
         ======================================================== -->
    <section class="content-section" id="section-survivability">
      <div class="section-label">Survivability</div>

      <p class="guide-prose">
        Serket has two fully independent survival systems, each capable of absorbing a lethal hit or resetting her from a low-HP position. They sequence into each other naturally during combat.
      </p>

      <div class="sustain-layers">
        <div class="sustain-layer sustain-layer--relic">
          <div class="sustain-layer-header">
            <span class="sustain-layer-name">Relic -- Venomous Domain Lv.2</span>
            <span class="sustain-trigger-label">Triggers once per 12 seconds</span>
          </div>
          <p class="sustain-layer-desc">
            When a single hit exceeds a percentage of her max HP, she becomes immune to that hit and takes reduced damage for the following window. This resets on a 12-second cooldown throughout the entire fight -- not just once.
          </p>
        </div>
        <div class="sustain-layer sustain-layer--passive">
          <div class="sustain-layer-header">
            <span class="sustain-layer-name">Burrowing Rebirth -- HP Threshold</span>
            <span class="sustain-trigger-label">Once per battle</span>
          </div>
          <p class="sustain-layer-desc">
            The first time her HP drops below 40%, she automatically burrows underground for 3 seconds and permanently increases her max HP by 30%. While underground at any point -- from this trigger, from her active, or during her ultimate -- she heals at 60% ATK per second.
          </p>
        </div>
        <div class="sustain-layer sustain-layer--emerge">
          <div class="sustain-layer-header">
            <span class="sustain-layer-name">Underground Pierce -- Emerge Shield</span>
            <span class="sustain-trigger-label">Skill Lv.3, on every active cast</span>
          </div>
          <p class="sustain-layer-desc">
            When Serket emerges from the ground after using Burrowing Pierce, she gains a shield. This compounds with the relic immunity and threshold heal to provide overlapping protection windows throughout a fight.
          </p>
        </div>
        <div class="sustain-layer sustain-layer--scorpion">
          <div class="sustain-layer-header">
            <span class="sustain-layer-name">Scorpion Immunity -- Relic Lv.4</span>
            <span class="sustain-trigger-label">Once per 12 seconds per scorpion</span>
          </div>
          <p class="sustain-layer-desc">
            Each of the three scorpions independently gains the same damage-immunity proc from the Lv.4 relic upgrade. Three sequential immunity windows spread across the scorpion pool make committing a burst rotation to clear them impractical.
          </p>
        </div>
      </div>

      <div class="guide-comparison-row">
        <div class="guide-compare-card">
          <div class="guide-compare-label">Aries</div>
          <div class="guide-compare-value">1 invincibility trigger on lethal hit</div>
        </div>
        <div class="guide-compare-card">
          <div class="guide-compare-label">Anubis</div>
          <div class="guide-compare-value">1 untargetable phase on cumulative HP loss</div>
        </div>
        <div class="guide-compare-card guide-compare-card--highlight">
          <div class="guide-compare-label">Serket</div>
          <div class="guide-compare-value">2 save cycles + permanent HP buff + repeating relic immunity + ongoing underground heal</div>
        </div>
      </div>

      <div class="mechanic-card" style="">
        <div class="mechanic-header">
          <span class="mechanic-title">How the Interlock Works</span>
        </div>
        <p class="mechanic-summary">
          Enemy bursts through her HP -- relic absorbs the hit, DR window activates. Sustained pressure bleeds her to 40% -- auto-burrow for 3 seconds, continuous heal, permanent HP increase takes effect. She emerges with a shield and the relic immunity has reset. Two independent save cycles before the enemy has applied full pressure.
        </p>
      </div>
    </section>

    <!-- ========================================================
         SECTION 4: PLAYSTYLE
         ======================================================== -->
    <section class="content-section" id="section-playstyle">
      <div class="section-label">Playstyle and Archetype</div>

      <p class="guide-prose">
        Serket is a bruiser-summoner with disruption tools. She is not a backline assassin in the sense of Nyx or Bastet -- she does not delete targets on contact, she does not arrive in the backline at combat start, and she has no execute mechanic. She arrives when her active is available, dives to the farthest enemy, applies a knockdown on emerge, and generates sustained pressure through her scorpion pool.
      </p>

      <div class="archetype-grid">
        <div class="archetype-card archetype-partial">
          <div class="archetype-match-label">Partial</div>
          <div class="archetype-name">Pure Bruiser</div>
          <p class="archetype-note">Strong sustain and survivability, but does not hold aggro or taunt. Leaves the frontline to dive.</p>
        </div>
        <div class="archetype-card archetype-no">
          <div class="archetype-match-label">No</div>
          <div class="archetype-name">Assassin</div>
          <p class="archetype-note">No execute, no untargetable traversal phase, no combat-start opener. She is a disruptor, not a deleter.</p>
        </div>
        <div class="archetype-card archetype-partial">
          <div class="archetype-match-label">Partial</div>
          <div class="archetype-name">Summon Carry</div>
          <p class="archetype-note">Scorpions are her highest-scaling damage source but not her only one. She also contributes direct damage and disruption.</p>
        </div>
        <div class="archetype-card archetype-partial">
          <div class="archetype-match-label">Partial</div>
          <div class="archetype-name">Disruption / Control</div>
          <p class="archetype-note">Knockdown on emerge and ATK-Down from death explosions, but no hard CC chain or team-wide stun.</p>
        </div>
      </div>

      <div class="guide-verdict-box">
        <span class="guide-verdict-label">Clean Description</span>
        A bruiser whose damage is partially externalized into three summons, with disruption as a side product.
      </div>

      <p class="guide-prose">
        Her job in a fight is to create a targeting problem the enemy cannot cleanly solve. Focusing her means scorpions run free. Focusing scorpions means absorbing explosions and triggering her threshold heal. Ignoring both means sustained AoE and backline pressure from four simultaneous sources. She makes the enemy uncomfortable; she does not surgically remove them.
      </p>
    </section>

    <!-- ========================================================
         SECTION 5: SYNERGIES
         ======================================================== -->
    <section class="content-section" id="section-synergies">
      <div class="section-label">Synergies</div>

      <div class="synergy-tier-block">
        <div class="synergy-tier-header synergy-tier-header--confirmed">
          <span class="synergy-tier-name">Confirmed Partners</span>
          <span class="synergy-tier-note">Directly validated in live play</span>
        </div>
        <div class="synergy-partner-list">
          <div class="synergy-partner-card">
            <div class="synergy-partner-portrait" style={`background-image:url(${R2_BASE}/heroes/nuwa.webp)`} role="img" aria-label="Nuwa"></div>
            <div class="synergy-partner-body">
              <div class="synergy-partner-name">Nuwa</div>
              <p class="synergy-partner-desc">Serket's DR aura helps keep Nuwa alive at the frontline. Nuwa's passive triggers from Serket's positioning. They hold the frontline together, with Serket absorbing burst that would otherwise delete Nuwa.</p>
            </div>
          </div>
          <div class="synergy-partner-card">
            <div class="synergy-partner-portrait" style={`background-image:url(${R2_BASE}/heroes/nuba.webp)`} role="img" aria-label="Nuba"></div>
            <div class="synergy-partner-body">
              <div class="synergy-partner-name">Nuba</div>
              <p class="synergy-partner-desc">Directly compatible with Serket's frontline bruiser role. Both apply sustained frontline pressure and compound well without competing for the same role.</p>
            </div>
          </div>
          <div class="synergy-partner-card synergy-partner-card--energy">
            <div class="synergy-partner-portrait synergy-partner-portrait--energy" role="img" aria-label="Energy Recovery Support"></div>
            <div class="synergy-partner-body">
              <div class="synergy-partner-name">Energy-Recovery Support</div>
              <p class="synergy-partner-desc">Serket's entire kit depends on her ultimate cycle. Without energy generation support, scorpion uptime drops and her pressure window shrinks. An energy-recovery support (e.g. Caishen) is effectively mandatory.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="synergy-tier-block">
        <div class="synergy-tier-header synergy-tier-header--strong">
          <span class="synergy-tier-name">Strong Kit-Based Synergies</span>
          <span class="synergy-tier-note">Logical mechanical interactions with high expected impact</span>
        </div>
        <div class="synergy-partner-list">
          <div class="synergy-partner-card">
            <div class="synergy-partner-portrait" style={`background-image:url(${R2_BASE}/heroes/cronus.webp)`} role="img" aria-label="Cronus"></div>
            <div class="synergy-partner-body">
              <div class="synergy-partner-name">Cronus</div>
              <p class="synergy-partner-desc">Time Traveler double-casts the highest-CDR ally's active. Double-casting Burrowing Pierce doubles dive damage, the emerge shield, and potentially synchronizes scorpion dive timing. High impact if it works as described.</p>
            </div>
          </div>
          <div class="synergy-partner-card">
            <div class="synergy-partner-portrait" style={`background-image:url(${R2_BASE}/heroes/set.webp)`} role="img" aria-label="Set"></div>
            <div class="synergy-partner-body">
              <div class="synergy-partner-name">Set</div>
              <p class="synergy-partner-desc">Set's lifesteal aura affects Serket and all three scorpions simultaneously. His armor shred amplifies physical output from Serket, the scorpions, and their explosions. Diamond faction bonus is available when running both.</p>
            </div>
          </div>
          <div class="synergy-partner-card">
            <div class="synergy-partner-portrait" style={`background-image:url(${R2_BASE}/heroes/athena.webp)`} role="img" aria-label="Athena"></div>
            <div class="synergy-partner-body">
              <div class="synergy-partner-name">Athena</div>
              <p class="synergy-partner-desc">DR aura extends Serket's time on the surface. ATK speed buff scales the inherited stats of all three scorpions, directly increasing their DPS output.</p>
            </div>
          </div>
          <div class="synergy-partner-card">
            <div class="synergy-partner-portrait" style={`background-image:url(${R2_BASE}/heroes/momus.webp)`} role="img" aria-label="Momus"></div>
            <div class="synergy-partner-body">
              <div class="synergy-partner-name">Momus</div>
