  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-faint);
}

.page-back {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
  text-decoration: none;
  transition: var(--transition-colors);
  flex-shrink: 0;
}
.page-back svg { width: 16px; height: 16px; }
.page-back:hover { color: var(--text-primary); }

.page-hero-name {
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  color: var(--text-bright);
  text-align: center;
  flex: 1;
  padding: 0 var(--space-4);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-page-header-right {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-shrink: 0;
}

.hdr-rating {
  padding: 3px var(--space-3);
  border-radius: var(--radius-md);
  font-size: 0.78rem;
  font-weight: var(--weight-black);
  letter-spacing: var(--tracking-wide);
}

.hdr-calc-link {
  font-size: 0.78rem;
  font-weight: var(--weight-semibold);
  color: var(--faction-a);
  text-decoration: none;
  padding: var(--space-1) var(--space-3);
  border: 1px solid var(--faction-a);
  border-radius: var(--radius-md);
  opacity: 0.85;
  transition: var(--transition-colors);
}
.hdr-calc-link:hover { opacity: 1; background: var(--bg-raised); }

/* =============================================
   SHOWCASE
   ============================================= */
.showcase {
  position: relative;
  width: 100%;
  height: 88vh;
  min-height: 520px;
  max-height: 900px;
  overflow: hidden;
}

.showcase-bg {
  position: absolute;
  inset: 0;
  background-image: url(https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/hall.webp);
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
}

.showcase-art {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center 14%;
  background-repeat: no-repeat;
  transform: scale(1.04);
  transition: transform 8s ease-out;
}
.showcase:hover .showcase-art { transform: scale(1); }

.showcase-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, rgba(7,6,12,0.25) 0%, transparent 30%, transparent 50%, rgba(7,6,12,0.92) 85%, rgba(7,6,12,1) 100%),
    linear-gradient(to right, rgba(7,6,12,0.35) 0%, transparent 40%);
}

.showcase-identity {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 0 var(--space-10) var(--space-10);
  max-width: var(--page-max-width);
  margin: 0 auto;
}

.guide-kicker {
  font-size: 0.7rem;
  font-weight: var(--weight-black);
  text-transform: uppercase;
  letter-spacing: var(--tracking-widest);
  color: var(--faction-a);
  margin-bottom: var(--space-2);
  opacity: 0.8;
}

.showcase-name {
  font-size: clamp(2.8rem, 6vw, 5.5rem);
  font-weight: var(--weight-black);
  line-height: 1.0;
  color: var(--text-bright);
  margin: 0 0 var(--space-4);
  text-shadow: 0 4px 32px rgba(0,0,0,0.6);
  letter-spacing: -0.02em;
}

.showcase-badges {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.id-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1) var(--space-3);
  background: rgba(0,0,0,0.45);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-full);
  font-size: 0.78rem;
  font-weight: var(--weight-semibold);
  color: var(--text-bright);
  backdrop-filter: blur(8px);
}
.id-badge-icon {
  width: 16px;
  height: 16px;
  object-fit: contain;
}
.rarity-badge {
  border-color: var(--faction-a);
  color: var(--faction-a);
}

.guide-showcase-tagline {
  font-size: 1.05rem;
  color: var(--text-secondary);
  margin: var(--space-3) 0 0;
  max-width: 520px;
  line-height: 1.5;
  font-style: italic;
}

.showcase-scroll-hint {
  position: absolute;
  bottom: var(--space-4);
  right: var(--space-10);
  z-index: 10;
  animation: bounce 2s ease-in-out infinite;
  color: var(--text-disabled);
}
.showcase-scroll-hint svg { width: 20px; height: 20px; }
@keyframes bounce {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

/* =============================================
   FLOATING DOT NAV
   ============================================= */
.dot-nav {
  position: fixed;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  z-index: var(--z-sticky);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.dot-nav-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  text-decoration: none;
  flex-direction: row-reverse;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
  background: var(--border-medium);
  border: 1px solid var(--border-subtle);
  transition: all var(--duration-fast) ease;
  flex-shrink: 0;
}

.dot-label {
  font-size: 0.72rem;
  font-weight: var(--weight-semibold);
  color: var(--text-muted);
  background: rgba(0,0,0,0.7);
  padding: 3px var(--space-2);
  border-radius: var(--radius-md);
  white-space: nowrap;
  opacity: 0;
  transform: translateX(8px);
  transition: opacity var(--duration-fast), transform var(--duration-fast);
  pointer-events: none;
}

.dot-nav-item:hover .dot-label,
.dot-nav-item.active .dot-label { opacity: 1; transform: translateX(0); }
.dot-nav-item:hover .dot,
.dot-nav-item.active .dot {
  background: var(--faction-a);
  border-color: var(--faction-a);
  box-shadow: 0 0 8px var(--faction-a);
}

@media (max-width: 1100px) { .dot-nav { display: none; } }

/* =============================================
   SCROLL CONTENT + SECTIONS
   ============================================= */
.scroll-content {
  max-width: var(--page-max-width);
  margin: 0 auto;
  padding: 0 var(--space-6) 100px;
}

.content-section {
  scroll-margin-top: 72px;
  padding: 64px 0 var(--space-4);
  border-bottom: 1px solid var(--border-faint);
}
.content-section:last-child { border-bottom: none; }

.section-label {
  font-size: 0.7rem;
  font-weight: var(--weight-black);
  text-transform: uppercase;
  letter-spacing: var(--tracking-widest);
  color: var(--faction-a);
  margin-bottom: var(--space-7);
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.section-label::after {
  content: "";
  flex: 1;
  height: 1px;
  background: linear-gradient(to right, var(--faction-a), transparent);
  opacity: 0.35;
}

/* =============================================
   GUIDE PROSE
   ============================================= */
.guide-prose {
  font-size: 0.94rem;
  line-height: 1.72;
  color: var(--text-secondary);
  margin: 0 0 var(--space-6);
  max-width: 72ch;
}

.guide-section-sub {
  font-size: 0.75rem;
  font-weight: var(--weight-black);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
  color: var(--text-muted);
  margin: var(--space-8) 0 var(--space-4);
}

/* =============================================
   SECTION 1: VALUE LAYERS
   ============================================= */
.value-layers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-8);
}

.value-layer-card {
  display: flex;
  gap: var(--space-4);
  align-items: flex-start;
  padding: var(--space-5);
  background: var(--bg-raised);
  border: 1px solid var(--border-faint);
  border-radius: var(--radius-lg);
  transition: border-color var(--duration-fast);
}
.value-layer-card:hover { border-color: var(--border-subtle); }

.value-layer-num {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--faction-a), var(--faction-b));
  color: #1a1a1a;
  font-size: 0.85rem;
  font-weight: var(--weight-black);
  display: flex;
  align-items: center;
  justify-content: center;
}

.value-layer-body { display: flex; flex-direction: column; gap: var(--space-1); }

.value-layer-title {
  font-size: 0.82rem;
  font-weight: var(--weight-bold);
  color: var(--text-bright);
  letter-spacing: 0.01em;
}

.value-layer-desc {
  font-size: 0.82rem;
  line-height: 1.55;
  color: var(--text-muted);
  margin: 0;
}

.guide-identity-card {
  border-color: var(--border-subtle);
  border-left-width: 3px;
  border-left-color: var(--faction-a);
}

/* mechanic-card already defined in components.css */
.mechanic-card {
  background: var(--bg-raised);
  border: 1px solid var(--border-subtle);
  border-left: 3px solid var(--faction-a);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  margin-bottom: var(--space-6);
}
.mechanic-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
  flex-wrap: wrap;
}
.mechanic-title {
  font-size: 0.72rem;
  font-weight: var(--weight-black);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
  color: var(--faction-a);
}
.mechanic-summary {
  margin: 0;
  font-size: 0.87rem;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* =============================================
   SECTION 2: SUMMONS -- RELIC MILESTONE STRIP
   ============================================= */
.milestone-strip {
  display: flex;
  align-items: flex-start;
  gap: 0;
  margin: 0 0 var(--space-8);
  overflow-x: auto;
  padding-bottom: var(--space-2);
}

.milestone-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  flex: 1;
  min-width: 120px;
  text-align: center;
  padding: 0 var(--space-2);
}

.milestone-badge {
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-wide);
  white-space: nowrap;
}
.milestone-base { background: var(--bg-overlay); border: 1px solid var(--border-medium); color: var(--text-muted); }
.milestone-lv2  { background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.35); color: #34d399; }
.milestone-lv3  { background: rgba(226,184,88,0.15); border: 1px solid rgba(226,184,88,0.35); color: var(--faction-a); }
.milestone-lv4  { background: rgba(168,85,247,0.15); border: 1px solid rgba(168,85,247,0.35); color: #d8b4fe; }

.milestone-label {
  font-size: 0.75rem;
  line-height: 1.45;
  color: var(--text-muted);
}

.milestone-connector {
  flex-shrink: 0;
  width: 32px;
  height: 2px;
  background: var(--border-subtle);
  margin-top: 18px;
  align-self: flex-start;
}

/* Scenario Cards */
.scenario-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.scenario-action-card {
  padding: var(--space-5);
  background: var(--bg-raised);
  border: 1px solid var(--border-faint);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  transition: border-color var(--duration-fast);
}
.scenario-action-card:hover { border-color: rgba(226,184,88,0.25); }

.scenario-action {
  font-size: 0.8rem;
  font-weight: var(--weight-bold);
  color: var(--faction-a);
  line-height: 1.3;
}

.scenario-result {
  font-size: 0.82rem;
  line-height: 1.55;
  color: var(--text-secondary);
  margin: 0;
}

/* =============================================
   SECTION 3: SURVIVABILITY
   ============================================= */
.sustain-layers {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-8);
}

.sustain-layer {
  padding: var(--space-5);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-faint);
  background: var(--bg-raised);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.sustain-layer--relic   { border-left: 3px solid #34d399; }
.sustain-layer--passive { border-left: 3px solid var(--faction-a); }
.sustain-layer--emerge  { border-left: 3px solid #60a5fa; }
.sustain-layer--scorpion { border-left: 3px solid #a78bfa; }

.sustain-layer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.sustain-layer-name {
  font-size: 0.82rem;
  font-weight: var(--weight-bold);
  color: var(--text-bright);
}

.sustain-trigger-label {
  font-size: 0.68rem;
  font-weight: var(--weight-medium);
  color: var(--text-disabled);
  font-style: italic;
}

.sustain-layer-desc {
  font-size: 0.84rem;
  line-height: 1.6;
  color: var(--text-secondary);
  margin: 0;
}

.guide-comparison-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
  margin-bottom: var(--space-8);
}

.guide-compare-card {
  padding: var(--space-4);
  background: var(--bg-raised);
  border: 1px solid var(--border-faint);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.guide-compare-card--highlight {
  border-color: rgba(226,184,88,0.35);
  background: rgba(226,184,88,0.04);
}

.guide-compare-label {
  font-size: 0.72rem;
  font-weight: var(--weight-black);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
  color: var(--text-muted);
}
.guide-compare-card--highlight .guide-compare-label { color: var(--faction-a); }

.guide-compare-value {
  font-size: 0.82rem;
  line-height: 1.5;
  color: var(--text-secondary);
}

/* =============================================
   SECTION 4: ARCHETYPE
   ============================================= */
.archetype-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-7);
}

.archetype-card {
  padding: var(--space-5);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-faint);
  background: var(--bg-raised);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.archetype-partial { border-top: 2px solid rgba(226,184,88,0.45); }
.archetype-no      { border-top: 2px solid rgba(107,114,128,0.35); }

.archetype-match-label {
  font-size: 0.65rem;
  font-weight: var(--weight-black);
  text-transform: uppercase;
  letter-spacing: var(--tracking-widest);
  color: var(--text-disabled);
}
.archetype-partial .archetype-match-label { color: var(--faction-a); }

.archetype-name {
  font-size: 0.92rem;
  font-weight: var(--weight-bold);
  color: var(--text-bright);
}

.archetype-note {
  font-size: 0.78rem;
  line-height: 1.5;
  color: var(--text-muted);
  margin: 0;
}

.guide-verdict-box {
  padding: var(--space-5) var(--space-6);
  background: rgba(226,184,88,0.06);
  border: 1px solid rgba(226,184,88,0.28);
  border-radius: var(--radius-lg);
  font-size: 0.92rem;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: var(--space-6);
}

.guide-verdict-label {
  display: block;
  font-size: 0.65rem;
  font-weight: var(--weight-black);
  text-transform: uppercase;
  letter-spacing: var(--tracking-widest);
  color: var(--faction-a);
  margin-bottom: var(--space-2);
}

/* =============================================
   SECTION 5: SYNERGIES
   ============================================= */
.synergy-tier-block {
  margin-bottom: var(--space-10);
}

.synergy-tier-header {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--border-faint);
}

.synergy-tier-name {
  font-size: 0.82rem;
  font-weight: var(--weight-bold);
  color: var(--text-bright);
}

.synergy-tier-note {
  font-size: 0.72rem;
  color: var(--text-disabled);
  font-style: italic;
}

.synergy-tier-header--confirmed .synergy-tier-name { color: #34d399; }
.synergy-tier-header--strong .synergy-tier-name { color: var(--faction-a); }
.synergy-tier-header--plausible .synergy-tier-name { color: var(--text-secondary); }

/* === Nuwa comparison grid === */
.guide-section-sub {
  font-size: 0.78rem;
  font-weight: var(--weight-bold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--faction-a);
  margin: var(--space-8) 0 var(--space-4);
}

.nuwa-compare-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1px;
  background: var(--border-faint);
  border: 1px solid var(--border-faint);
  border-radius: var(--radius-lg);
  overflow: hidden;
  font-size: 0.82rem;
}

.nuwa-compare-header {
  background: var(--bg-overlay);
  padding: var(--space-3) var(--space-4);
  font-weight: var(--weight-bold);
  color: var(--text-bright);
  text-align: center;
}

.nuwa-compare-header:first-child {
  background: var(--bg-elevated);
}

.nuwa-compare-label {
  background: var(--bg-raised);
  padding: var(--space-3) var(--space-4);
  font-weight: var(--weight-semibold);
  color: var(--text-secondary);
  font-size: 0.78rem;
}

.nuwa-compare-cell {
  background: var(--bg-base);
  padding: var(--space-3) var(--space-4);
  color: var(--text-muted);
  text-align: center;
}

.nuwa-compare-cell--highlight {
  color: var(--faction-a);
  font-weight: var(--weight-semibold);
}

/* === Verdict callout box === */
.guide-verdict-box {
  padding: var(--space-5) var(--space-6);
  background: var(--bg-raised);
  border-left: 3px solid var(--faction-a);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--text-muted);
}

.guide-verdict-box--spaced {
  margin-top: var(--space-5);
}

.guide-verdict-label {
  display: block;
  font-size: 0.72rem;
  font-weight: var(--weight-bold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--faction-a);
  margin-bottom: var(--space-2);
}

.synergy-partner-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.synergy-partner-card {
  display: flex;
  gap: var(--space-5);
  align-items: flex-start;
  padding: var(--space-5);
  background: var(--bg-raised);
  border: 1px solid var(--border-faint);
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: border-color var(--duration-fast);
}
.synergy-partner-card:hover { border-color: var(--border-subtle); }

.synergy-partner-portrait {
  flex-shrink: 0;
  width: 52px;
  height: 52px;
  border-radius: var(--radius-full);
  background-size: cover;
  background-position: center top;
  border: 2px solid var(--border-medium);
  background-color: var(--bg-overlay);
}

.synergy-partner-portrait--energy {
  background-image: none;
  background: linear-gradient(135deg, var(--bg-overlay), var(--border-faint));
}

.synergy-partner-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.synergy-partner-name {
  font-size: 0.88rem;
  font-weight: var(--weight-bold);
  color: var(--text-bright);
}

.synergy-partner-desc {
  font-size: 0.82rem;
  line-height: 1.55;
  color: var(--text-muted);
  margin: 0;
}

/* =============================================
   SECTION 6: TEAM COMPS
   ============================================= */
.team-comp-cards {
  display: flex;
  flex-direction: column;
  gap: var(--space-7);
}

.team-comp-card {
  padding: var(--space-6);
  background: var(--bg-raised);
  border: 1px solid var(--border-faint);
  border-radius: var(--radius-lg);
}

.team-comp-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.team-comp-name {
  font-size: 1rem;
  font-weight: var(--weight-bold);
  color: var(--text-bright);
}

.team-comp-badge {
  padding: 2px var(--space-3);
  border-radius: var(--radius-full);
  font-size: 0.65rem;
  font-weight: var(--weight-bold);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
}
.team-comp-badge--recommended { background: rgba(52,211,153,0.15); border: 1px solid rgba(52,211,153,0.35); color: #34d399; }
