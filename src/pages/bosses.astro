---
export const prerender = true;
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SupportStrip from '../components/SupportStrip.astro';
import BossArtwork from '../components/bosses/BossArtwork.astro';
import { visibleBosses, identityFacts, rewardModes, type BossFact } from '../data/bosses';
import '../styles/bosses.css';

const tiles = visibleBosses.map(boss => {
  const modes = boss.rewards.map(entry => rewardModes[entry.mode]?.name).filter(Boolean);
  return {
    boss,
    kicker: [modes.length ? modes.join(' · ') : boss.mode, `${boss.skills.length} skills`].join(' · '),
    // Faction and class icons first, then up to two mode facts.
    facts: [...identityFacts(boss), ...boss.facts].slice(0, 4) as BossFact[],
  };
});
---

<Base title="Boss Encounters | Motto Immortal" description="Boss strategies, recommended teams, mechanics, skills and rewards for Motto Immortal.">
  <PageHero id="bosses" headline="Boss Encounters" subtitle="Know the fight. Pick your team." />
  <main class="encounter-directory page-content">
    <div class="encounter-directory-intro">
      <p>Strategies, team compositions, skills and rewards for every encounter below.</p>
      <span>{visibleBosses.length} boss guides</span>
    </div>
    <div class="encounter-list">
      {tiles.map(({ boss, kicker, facts }, index) => (
        <a class="encounter-tile" id={boss.id} href={`/bosses/${boss.id}`}>
          <BossArtwork boss={boss} eager={index === 0} />
          <div class="encounter-tile-copy">
            <span class="section-label">{kicker}</span>
            <h2>{boss.name}</h2>
            <p class="encounter-summary">{boss.summary.match(/^.*?[.!?](?:\s|$)/)?.[0].trim() || boss.summary}</p>
            <dl class="encounter-facts-strip">
              {facts.map(fact => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>
                    {fact.badge && <img class="encounter-fact-badge" src={fact.badge} alt="" width="32" height="32" loading="lazy" decoding="async" />}
                    {fact.icon && <img src={`/items/bosses/${fact.icon}.webp`} alt="" width="24" height="24" />}
                    {fact.value}
                  </dd>
                </div>
              ))}
            </dl>
            <span class="encounter-open">Open the guide <span aria-hidden="true">&rarr;</span><span class="sr-only"> for {boss.name}</span></span>
          </div>
        </a>
      ))}
    </div>
    <SupportStrip />
  </main>
</Base>
