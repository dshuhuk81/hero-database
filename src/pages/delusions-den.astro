---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ddData from "../data/delusions-den.json";

const { blessings, buffs } = ddData;

function hp(id: string) {
  return `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/${id}.webp`;
}

function parseUpgrade(s: string) {
  const m = s.match(/Level\s+(\d+)[^:]*:\s*(.+)/s);
  return m ? { level: m[1], text: m[2].trim() } : { level: "?", text: s };
}

const TAG_META: Record<string, { short: string; cls: string }> = {
  normal_attack: { short: "ATK",  cls: "tag-blue"   },
  crit:          { short: "CRIT", cls: "tag-gold"   },
  ultimate:      { short: "ULT",  cls: "tag-purple" },
  energy:        { short: "NRG",  cls: "tag-orange" },
  survival:      { short: "DEF",  cls: "tag-green"  },
  damage:        { short: "DMG",  cls: "tag-red"    },
  defense_pen:   { short: "PEN",  cls: "tag-cyan"   },
  healing:       { short: "HEAL", cls: "tag-pink"   },
  speed:         { short: "SPD",  cls: "tag-sky"    },
  cc:            { short: "CC",   cls: "tag-violet" },
};

const BLESSING_KEYS = ["mask_of_sorrow", "divine_nectar", "megafungus", "ripper"] as const;
const BLESSING_SHORT: Record<string, string> = {
  mask_of_sorrow: "MoS",
  divine_nectar:  "DN",
  megafungus:     "MF",
  ripper:         "RP",
};
const PRIO_CLS: Record<string, string> = {
  "1":    "prio-1",
  "2":    "prio-2",
  "3":    "prio-3",
  "skip": "prio-skip",
};

type AnyRecord = { [k: string]: number | string };
function getBuffPrio(buff: (typeof buffs)[number], key: string): string {
  const p = buff.priority as unknown as AnyRecord;
  return String(p[key] ?? "?");
}

const DD_COMPS = [
  {
    id: "mask-basic-attack",
    label: "Mask of Sorrow - Basic Attack Core",
    source: "Video guide (GBH)",
    blessing: "Mask of Sorrow",
    heroes: [
      { id: "phoenix",  name: "Phoenix",  note: "DPS" },
      { id: "isis",     name: "Isis",     note: "DPS" },
      { id: "nuba",     name: "Nuba",     note: "DPS/Tank" },
      { id: "dionysus", name: "Dionysus", note: "Middle Back (passive only)" },
      { id: "yuelao",   name: "Yuelao",   note: "Support" },
    ],
    reason:
      "Built around the Mask of Sorrow blessing which grants 100% attack speed and reduces skill cooldowns to all heroes except the middle backline slot. Dionysus fills the invalidated middle-back position so his passive buffs the team while his normal attacks are suppressed. Phoenix, Isis, and Artemis deliver the damage payload through accelerated basic attacks. Yuelao provides healing and stat support to keep the attackers alive through later waves. The Keystones of Wonders bonus activates with all 5 suits, adding 30% damage dealt and 30% damage reduction.",
    notes: [
      "Dionysus must occupy the middle backline slot. His passive buffs still apply even though his normal attacks are invalidated.",
      "The entire buff selection strategy is built around normal attacks. Ignore ultimate damage buffs unless no alternative is offered.",
      "Against Ares in wave 2, temporarily replace Yuelao with Heracles. Swap back before wave 3 begins.",
      "Phoenix at Exalted and Isis at Divine 2+ are the damage backbone. Lower investment reduces the comp's ceiling significantly.",
      "Activate all 5 faction suits for the Keystones of Wonders bonus: 30% damage and 30% damage reduction.",
    ],
    waveSwaps: [
      { wave: 2, action: "Swap Yuelao out for Heracles to survive the Ares encounter. Restore Yuelao before wave 3." },
    ],
    buffPriority: [
      "Normal attack speed",
      "Normal attack damage",
      "Crit rate (normal attack)",
      "Crit damage",
      "Crit execution (execute enemies below 25% HP)",
      "Energy on kill",
      "Defense drain on normal attack",
      "Normal attack knockback",
      "Shield on normal attack",
    ],
    buffAvoid: [
      "Ultimate damage",
      "HP regeneration on ultimate",
      "Energy regeneration on ultimate",
    ],
  },

  {
    id: "placeholder",
    label: "Community Comp (Placeholder)",
    source: "CN community reports - to be verified",
    blessing: "Mask of Sorrow",
    heroes: [
      { id: "poseidon", name: "Poseidon", note: "CC / Tank" },
      { id: "skadi",    name: "Skadi",    note: "DPS / CC" },
      { id: "caishen",  name: "Caishen",  note: "Middle Back (passive only)" },
      { id: "dionysus", name: "Dionysus", note: "Support" },
      { id: "iris",     name: "Iris",     note: "Utility (unconfirmed)" },
    ],
    reason:
      "Reported by CN community as a high-score variation using CC-based heroes. Poseidon's AoE crowd control groups enemies and enables Skadi's Realm of Frost passive to generate bonus damage and energy. Caishen fills the invalidated middle-back slot so his passive energy acceleration still applies. Dionysus provides attack speed and energy support. The fifth slot is unconfirmed - Iris is listed as a placeholder. This comp prioritizes control uptime over raw basic-attack output. Details are not fully verified - treat as a starting point rather than a confirmed guide.",
    notes: [
      "This is a community-reported comp. Hero identities for the 5th slot are unconfirmed.",
      "Replace Iris with a verified pick once the comp is tested. Strong candidates: Heracles, Yuelao, Hecate.",
      "Caishen in the middle-back slot keeps his energy passive active despite Mask of Sorrow's attack invalidation.",
      "Skadi's Realm of Frost triggers on every CC applied - Poseidon's AoE makes this highly consistent.",
      "This comp has not been independently verified by this site. Use the Mask of Sorrow basic-attack comp as the primary reference.",
    ],
    waveSwaps: [],
    buffPriority: [
      "Normal attack speed",
      "Crit rate",
      "Energy on kill / Energy regeneration on crit",
      "Normal attack damage",
      "Crit damage",
    ],
    buffAvoid: [
      "Ultimate damage (unconfirmed for this comp)",
    ],
  },

  {
    id: "megafungus-skadi",
    label: "Megafungus - Skadi Carry",
    source: "Video guide (GB Streams) - 232-233 score",
    blessing: "Megafungus",
    heroes: [
      { id: "skadi",    name: "Skadi",    note: "Main Carry (grows in size)" },
      { id: "poseidon", name: "Poseidon", note: "CC / DPS" },
      { id: "dionysus", name: "Dionysus", note: "ATK Speed / Support" },
      { id: "caishen",  name: "Caishen",  note: "Energy Support" },
      { id: "yuelao",   name: "Yuelao",   note: "Healer / Support" },
    ],
    reason:
      "Skadi naturally has the highest ATK and becomes the Megafungus carrier - growing in size, gaining CC immunity, and inheriting 50% of every ally's ATK and HP at blessing level 5. This means buffing supports' ATK directly scales Skadi's damage. Caishen and Dionysus feed energy and ATK buffs to the whole team which Skadi absorbs. Poseidon's crowd control creates consistent windows for Skadi's ultimate and enables her Realm of Frost passive. Yuelao sustains the team through extended waves. Focus buff selection entirely on ultimate damage, energy generation, and crit.",
    notes: [
      "Buff all heroes' ATK - Skadi inherits 50% of every ally's ATK stat at max blessing level.",
      "Starting Energy (+1000) is the highest-priority pickup whenever it appears.",
      "Shield on Ultimate + Energy Regen on Shield form a strong energy loop - take both if offered.",
      "Against Ares in wave 2, consider swapping in a tank temporarily.",
      "The guide reached 232-233 with this comp at high investment. RNG on buff draws affects the final score.",
    ],
    waveSwaps: [
      { wave: 2, action: "Consider swapping in Heracles or another tank vs Ares if team investment is lower." },
    ],
    buffPriority: [
      "Ultimate Damage",
      "Energy on Kill",
      "Energy Regen upon Crit",
      "Ultimate Attack Speed",
      "Starting Energy (+1000 at battle start)",
      "Crit Rate on Normal Attack",
      "Attack (buffs Skadi via 50% inheritance)",
      "Shield on Ultimate + Energy Regen on Shield (take both if available)",
      "Defense Ignore on Crit",
      "Crit Damage",
    ],
    buffAvoid: [
      "Normal attack speed (less relevant - damage comes from ultimates)",
      "Normal attack defense drain",
      "Normal attack knockback",
    ],
  },
];
---

<Base
  title="Delusions Den Guide | Motto Immortal"
  description="Complete guide for Delusions Den (Mang Nian Chao Xue) in Motto Immortal. Mechanics, best hero compositions, blessing choices, and buff priority for top scores."
>

  <PageHero
    tag="Game Mode Guide"
    headline="Delusions Den"
    subtitle="Wave-based roguelite challenge mode. Pick a blessing, draft buffs between waves, and push for top score."
    bgImage="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/delusiondenbg.webp"
  />

  <div class="page-wrapper">
    <main class="dd-main">

      <!-- ================================================================
           SECTION 1: WHAT IS DELUSIONS DEN
           ================================================================ -->
      <div class="dd-card dd-intro-card">
        <h2>What is Delusions Den?</h2>
        <p>
          Delusions Den is a repeating wave-based challenge mode where you run a 5-hero team
          through 7 progressive waves, selecting buffs between each wave to build toward a final scoring stage.
          Top players on a server reach 230-236 points in the scoring stage. The mode resets periodically
          and tracks server leaderboards.
        </p>

        <div class="dd-callout">
          <strong>Core Loop:</strong> Select a starting blessing, fight through 7 waves, pick one buff after
          each wave, and maximize enemy kills in the final scoring stage.
        </div>

        <h3>Rewards for ranks</h3>
        <div class="dd-reward-grid">
          <div class="dd-reward-card">
            <div class="dd-reward-img-wrap">
              <img src="/delusionden/frame.webp" alt="Avatar Frame" class="dd-reward-img" />
            </div>
            <div class="dd-reward-title">Avatar Frame</div>
            <div class="dd-reward-name">Profane Gaze</div>
            <div class="dd-reward-desc">Cosmetic frame awarded to top-ranking players on your server.</div>
          </div>
          <div class="dd-reward-card">
            <div class="dd-reward-img-wrap">
              <img src="/delusionden/token.webp" alt="Oculus Token" class="dd-reward-img" />
            </div>
            <div class="dd-reward-title">Oculus Tokens</div>
            <div class="dd-reward-name">Shop Currency</div>
            <div class="dd-reward-desc">Spent in the Den Shop to purchase items.</div>
          </div>
        </div>

        <h3>Wave Structure</h3>
        <div class="dd-wave-table">
          <div class="dd-wave-row dd-wave-header">
            <span>Wave</span>
            <span>Type</span>
            <span>Notes</span>
          </div>
          <div class="dd-wave-row">
            <span class="dd-wave-num">1</span>
            <span class="dd-wave-type">Combat</span>
            <span>First buff selection after. Aim for 3-4 crit symbols early.</span>
          </div>
          <div class="dd-wave-row">
            <span class="dd-wave-num">2</span>
            <span class="dd-wave-type">Combat</span>
            <span>Notable enemy: Ares. Consider swapping in a tank (Heracles) for this wave.</span>
          </div>
          <div class="dd-wave-row dd-wave-break">
            <span class="dd-wave-num">3</span>
            <span class="dd-wave-type">Fixed Break</span>
            <span>Cannot control buff rewards at this checkpoint. Secure "crit ignores 100% defense" before this.</span>
          </div>
          <div class="dd-wave-row">
            <span class="dd-wave-num">4</span>
            <span class="dd-wave-type">Combat</span>
            <span>Stack additional crit symbols. Target 10 total for execution threshold.</span>
          </div>
          <div class="dd-wave-row">
            <span class="dd-wave-num">5</span>
            <span class="dd-wave-type">Combat</span>
            <span>Notable enemy: Ares. Dangerous burst - apply shields or knockback buffs.</span>
          </div>
          <div class="dd-wave-row dd-wave-break">
            <span class="dd-wave-num">6</span>
            <span class="dd-wave-type">Fixed Break</span>
            <span>Second fixed checkpoint. No buff manipulation possible.</span>
          </div>
          <div class="dd-wave-row dd-wave-final">
            <span class="dd-wave-num">7</span>
            <span class="dd-wave-type">Scoring Stage</span>
            <span>Timed kill-count stage. More enemies killed = higher score. Top players reach 230+ points.</span>
          </div>
        </div>

        <div class="dd-keybox">
          <div class="dd-keybox-title">Notable Enemies to Watch For</div>
          <ul>
            <li><strong>Ares</strong> - High durability; bring Heracles or another tank for wave 2.</li>
            <li><strong>Nuwa</strong> - Final-wave boss; her minions deal coordinated burst. Energy recovery and shielding help here.</li>
            <li><strong>Pan</strong> - AoE silence disrupts your team's skill rotations in later waves.</li>
          </ul>
        </div>
      </div>

      <!-- ================================================================
           SECTION 2: BLESSINGS
           ================================================================ -->
      <div class="dd-card">
        <h2>Blessings</h2>
        <p>
          Choose one blessing before combat begins. Your choice determines the entire team-building
          and buff-selection strategy for the run. Blessings scale as your Total Genre Level increases.
        </p>

        <div class="bl-grid">
          {blessings.map(b => (
            <div class={`bl-card ${b.recommended ? "bl-card-rec" : ""}`}>
              <div class="bl-header">
                <span class="bl-name">{b.name}</span>
                <span class={`bl-badge ${b.recommended ? "bl-badge-rec" : "bl-badge-alt"}`}>
                  {b.recommended ? "Recommended" : "Alternative"}
                </span>
              </div>

              <p class="bl-effect">{b.effect}</p>

              {b.upgrades.length > 0 && (
                <div class="bl-upgrades">
                  {b.upgrades.map(u => {
                    const p = parseUpgrade(u);
                    return (
                      <div class="upgrade-row">
                        <span class="upgrade-lv">Lv {p.level}</span>
                        <span class="upgrade-text">{p.text}</span>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- ================================================================
           SECTION 3: BUFFS
           ================================================================ -->
      <div class="dd-card">
        <h2>Buffs</h2>
        <p>
          One buff is offered after each combat wave. The priority badges at the bottom of each card
          show how valuable that buff is for each blessing:
          <span class="prio-inline prio-1">1</span> = top priority,
          <span class="prio-inline prio-2">2</span> = strong pick,
          <span class="prio-inline prio-3">3</span> = situational,
          <span class="prio-inline prio-skip">skip</span> = avoid.
          Unconfirmed buff names are marked with an asterisk (*).
        </p>

        <div class="buff-grid">
          {buffs.map(b => (
            <div class="buff-card">
              <div class="buff-hexes">
                {b.tags.slice(0, 2).map(tag => {
                  const meta = TAG_META[tag];
                  return meta ? (
                    <div class={`buff-hex ${meta.cls}`}>{meta.short}</div>
                  ) : null;
                })}
              </div>

              <div class="buff-name">{b.name}{!b.confirmed ? " *" : ""}</div>
              <div class="buff-effect">{b.effect}</div>

              {b.note && (
                <div class="buff-note">{b.note}</div>
              )}

              <div class="buff-prio-row">
                {BLESSING_KEYS.map(key => {
                  const val = getBuffPrio(b, key);
                  return (
                    <div class={`buff-prio ${PRIO_CLS[val] ?? ""}`}>
                      <span class="prio-blessing">{BLESSING_SHORT[key]}</span>
                      <span class="prio-val">{val}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ================================================================
           SECTION 4: HERO COMPOSITIONS
           ================================================================ -->
      <div class="dd-card">
        <h2>Hero Compositions</h2>
        <p>
          Comps that work well in Delusions Den. The right choice depends on your roster depth and hero investment.
        </p>

        <div class="dd-comp-list">
          {DD_COMPS.map(comp => (
            <div class="dd-comp-card">
              <div class="dd-comp-card-header">
                <span class="dd-comp-card-title">{comp.label}</span>
                <span class="dd-comp-blessing-tag">Blessing: <strong>{comp.blessing}</strong></span>
              </div>

              <div class="dd-hero-grid">
                {comp.heroes.map(hero => (
                  <a href={`/heroes/${hero.id}`} class="dd-hero-card">
                    <div class="dd-hero-portrait" style={`background-image:url('${hp(hero.id)}')`}></div>
                    <span class="dd-hero-role">{hero.note}</span>
                    <span class="dd-hero-name">{hero.name}</span>
                  </a>
                ))}
              </div>

              {comp.notes.length > 0 && (
                <ul class="dd-comp-notes-list">
                  {comp.notes.map(note => <li>{note}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- ================================================================
           SECTION 5: TIPS
           ================================================================ -->
      <div class="dd-card">
        <h2>Reaching Top Score</h2>
        <p>
          The final wave (scoring stage) is a timed kill-count challenge. Your team's accumulated
          buffs and hero investment determine how many enemies you can clear before time expires.
          Top server scores sit at 230-236 points. Here is how to maximize:
        </p>

        <div class="dd-tip-list">
          <div class="dd-tip">
            <div class="dd-tip-num">1</div>
            <div class="dd-tip-body">
              <strong>Stack crit execution early.</strong> Crit execution at 25% HP threshold dramatically
              speeds up kill time in the scoring stage. Aim to have this unlocked by wave 4 at the latest.
              Target 10 crit symbols total before the scoring stage begins.
            </div>
          </div>
          <div class="dd-tip">
            <div class="dd-tip-num">2</div>
            <div class="dd-tip-body">
              <strong>Maintain normal attack momentum.</strong> Do not invest in ultimate-dependent buffs
              during the run. Your damage in the scoring stage comes from sustained basic attacks, not
              occasional ultimates.
            </div>
          </div>
          <div class="dd-tip">
            <div class="dd-tip-num">3</div>
            <div class="dd-tip-body">
              <strong>Survive waves 5-6 to keep buffs.</strong> If your team collapses in wave 5 or 6,
              you lose the scoring run. Prioritize at least one survivability buff (shield on normal attack,
              armor/magic resistance) before the fixed wave 6 break.
            </div>
          </div>
          <div class="dd-tip">
            <div class="dd-tip-num">4</div>
            <div class="dd-tip-body">
              <strong>Investment matters.</strong> Higher evolution on your carry heroes directly translates
              to faster clears in the scoring stage. Phoenix and Isis at lower evolution hit a ceiling faster
              than at Divine+.
            </div>
          </div>
          <div class="dd-tip">
            <div class="dd-tip-num">5</div>
            <div class="dd-tip-body">
              <strong>Use the Keystones of Wonders bonus.</strong> Activating all 5 faction suits grants
              30% bonus damage dealt and 30% damage reduction. Build your team with this in mind even if
              it means a slightly weaker individual hero.
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

</Base>


<style>
  /* Layout */
  .page-wrapper {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  .dd-main {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Section card */
  .dd-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 36px 32px;
  }

  .dd-intro-card {
    border-color: rgba(250, 204, 21, 0.12);
    background: rgba(250, 204, 21, 0.03);
  }

  .dd-card h2 {
    margin: 0 0 16px;
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-bright, #f0f0f5);
    letter-spacing: 0.01em;
  }

  .dd-card h3 {
    margin: 28px 0 12px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(230, 230, 235, 0.85);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .dd-card p {
    margin: 0 0 12px;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(230, 230, 235, 0.78);
  }

  /* Callout */
  .dd-callout {
    background: rgba(250, 204, 21, 0.07);
    border: 1px solid rgba(250, 204, 21, 0.18);
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(230, 230, 235, 0.85);
    margin: 16px 0;
  }

  /* Key box */
  .dd-keybox {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 16px 20px;
    margin-top: 20px;
  }

  .dd-keybox-title {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(250, 204, 21, 0.8);
    margin-bottom: 10px;
  }

  .dd-keybox ul {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dd-keybox li {
    font-size: 0.875rem;
    color: rgba(230, 230, 235, 0.78);
    line-height: 1.5;
  }

  /* Reward grid */
  .dd-reward-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 12px 0 24px;
  }

  .dd-reward-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 16px;
  }

  .dd-reward-img-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 10px;
  }

  .dd-reward-img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    border-radius: 8px;
  }

  .dd-reward-title {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(250, 204, 21, 0.7);
    margin-bottom: 4px;
  }

  .dd-reward-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-bright, #f0f0f5);
    margin-bottom: 6px;
  }

  .dd-reward-desc {
    font-size: 0.82rem;
    color: rgba(230, 230, 235, 0.6);
    line-height: 1.5;
  }

  /* Wave table */
  .dd-wave-table {
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    overflow: hidden;
    margin: 12px 0;
  }

  .dd-wave-row {
    display: grid;
    grid-template-columns: 80px 160px 1fr;
    gap: 0;
    padding: 11px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.85rem;
    color: rgba(230, 230, 235, 0.75);
    align-items: center;
  }

  .dd-wave-row:last-child { border-bottom: none; }

  .dd-wave-header {
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(230, 230, 235, 0.45);
    font-weight: 600;
  }

  .dd-wave-break {
    background: rgba(120, 90, 200, 0.06);
    border-left: 3px solid rgba(120, 90, 200, 0.4);
  }

  .dd-wave-final {
    background: rgba(250, 204, 21, 0.05);
    border-left: 3px solid rgba(250, 204, 21, 0.4);
    color: rgba(230, 230, 235, 0.88);
  }

  .dd-wave-num {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-bright, #f0f0f5);
  }

  .dd-wave-type {
    font-weight: 600;
    color: rgba(230, 230, 235, 0.85);
  }

  /* ================================================================
     BLESSINGS
     ================================================================ */
  .bl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
