---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ddData from "../data/delusions-den.json";

const { blessings } = ddData;
const buffs = [...ddData.buffs].sort((a, b) => a.name.localeCompare(b.name));

function hp(id: string) {
  return `https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/${id}.webp`;
}

function parseUpgrade(s: string) {
  const m = s.match(/Level\s+(\d+)[^:]*:\s*(.+)/s);
  return m ? { level: m[1], text: m[2].trim() } : { level: "?", text: s };
}

const TAG_META: Record<string, { short: string; cls: string }> = {
  normal_attack: { short: "ATK",  cls: "tag-blue"   },
  crit:          { short: "CRIT", cls: "tag-gold"   },
  ultimate:      { short: "ULT",  cls: "tag-purple" },
  energy:        { short: "NRG",  cls: "tag-orange" },
  survival:      { short: "DEF",  cls: "tag-green"  },
  damage:        { short: "DMG",  cls: "tag-red"    },
  defense_pen:   { short: "PEN",  cls: "tag-cyan"   },
  healing:       { short: "HEAL", cls: "tag-pink"   },
  speed:         { short: "SPD",  cls: "tag-sky"    },
  cc:            { short: "CC",   cls: "tag-violet" },
};

const DD_R2 = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/delusionden";
const BLESSING_IMG: Record<string, string> = {
  "mask-of-sorrow": `${DD_R2}/mask.webp`,
  "divine-nectar":  `${DD_R2}/nectar.webp`,
  "horn-of-doom":   `${DD_R2}/horn.webp`,
  "megafungus":     `${DD_R2}/fungus.webp`,
  "ripper":         `${DD_R2}/ripper.webp`,
};

const BLESSING_KEYS = ["mask_of_sorrow", "divine_nectar", "megafungus", "ripper", "horn_of_doom"] as const;
const BLESSING_SHORT: Record<string, string> = {
  mask_of_sorrow: "MoS",
  divine_nectar:  "DN",
  megafungus:     "MF",
  ripper:         "RP",
  horn_of_doom:   "HoD",
};
const PRIO_CLS: Record<string, string> = {
  "1":    "prio-1",
  "2":    "prio-2",
  "3":    "prio-3",
  "skip": "prio-skip",
};

type AnyRecord = { [k: string]: number | string };
function getBuffPrio(buff: (typeof buffs)[number], key: string): string {
  const p = buff.priority as unknown as AnyRecord;
  return String(p[key] ?? "?");
}

const DD_COMPS = [
  {
    id: "megafungus-phoenix",
    label: "Megafungus - Phoenix Carry",
    blessing: "Megafungus",
    heroes: [
      { id: "yuelao",   name: "Yuelao",   note: "Healer / Support" },
      { id: "nuba",     name: "Nuba",     note: "Tank / Support" },
      { id: "isis",     name: "Isis",     note: "DPS" },
      { id: "phoenix",  name: "Phoenix",  note: "Main Carry" },
      { id: "dionysus", name: "Dionysus", note: "ATK Speed / Support" },
    ],
    notes: [
      "Focus on ATK buffs for all heroes - the carrier inherits 50% of every ally's ATK at max level.",
      "Also go for all Crit buffs you can get - DEF Ignore on Crit is especially valuable.",
      "If Starting Energy +1000 appears, take it.",
      "Ares Boss: Can replace Yuelao with Momus if needed.",
      "Shield on Ultimate + Energy Regen on Shield form a strong energy loop - take both if offered.",
    ],
  },

  {
    id: "mask-basic-attack",
    label: "Mask of Sorrow - Basic Attack Core",
    blessing: "Mask of Sorrow",
    heroes: [
      { id: "yuelao",   name: "Yuelao",   note: "Healer / Support" },
      { id: "caishen",  name: "Caishen",  note: "Middle Back (passive only)" },
      { id: "skadi",    name: "Skadi",    note: "DPS / CC" },
      { id: "dionysus", name: "Dionysus", note: "ATK Speed / Support" },
      { id: "poseidon", name: "Poseidon", note: "CC / DPS" },
    ],
    notes: [
      "Dionysus must occupy the middle backline slot. Focus only on normal attack buffs.",
      "Ares Boss: Can replace Yuelao with Heracles and swap back again after the stage.",
      "Use Keystone of Wonders as totem.",
    ],
  },

  {
    id: "divine-nectar-skadi",
    label: "Divine Nectar - Skadi Control",
    blessing: "Divine Nectar",
    heroes: [
      { id: "zeus",     name: "Zeus",     note: "Damage Dealer" },
      { id: "caishen",  name: "Caishen",  note: "Energy / ATK Support" },
      { id: "skadi",    name: "Skadi",    note: "Control / DPS" },
      { id: "hecate",   name: "Hecate",   note: "Support / Crowd Control" },
      { id: "poseidon", name: "Poseidon", note: "CC / Primary DPS" },
    ],
    notes: [
      "Energy generation is critical - prioritize all energy buffs whenever they appear.",
      "Focus entirely on ultimate damage, energy regeneration, and cooldown reduction.",
      "Ares Boss: Can replace Yuelao with Momus if needed.",
      "Shield on Ultimate + Energy Regen on Shield form a strong energy loop - take both if offered.",
    ],
  },

  {
    id: "divine-nectar-hladgunnr",
    label: "Divine Nectar - Hladgunnr Carry",
    blessing: "Divine Nectar",
    heroes: [
      { id: "hladgunnr", name: "Hladgunnr", note: "Primary Carry" },
      { id: "caishen",   name: "Caishen",   note: "Energy / ATK Support" },
      { id: "fengyi",    name: "Fengyi",    note: "Damage / Support Hybrid" },
      { id: "hecate",    name: "Hecate",    note: "Control / Debuffs" },
      { id: "dionysus",  name: "Dionysus",  note: "ATK Speed / Energy Support" },
    ],
    notes: [
      "Energy generation is critical - prioritize all energy buffs whenever they appear.",
      "Focus entirely on ultimate damage, energy regeneration, and cooldown reduction.",
      "Ares Boss: Can replace Yuelao with Momus if needed.",
      "Shield on Ultimate + Energy Regen on Shield form a strong energy loop - take both if offered.",
    ],
  },

  {
    id: "horn-of-doom-hladgunnr",
    label: "Horn of Doom - Beginner Setup",
    blessing: "Horn of Doom",
    heroes: [
      { id: "yuelao",    name: "Yuelao",    note: "Healer / Support" },
      { id: "hladgunnr", name: "Hladgunnr", note: "Main Carry" },
      { id: "isis",      name: "Isis",      note: "DPS" },
      { id: "freya",     name: "Freya",     note: "Support" },
      { id: "dionysus",  name: "Dionysus",  note: "ATK Speed / Support" },
    ],
    notes: [
      "If you struggle as a beginner to even pass this stage, try using Horn of Doom with a Tank / DPS / Healer setup. You may not reach high scores at the end but that should not be the focus at this point.",
      "Dionysus at base copy is fine here.",
      "Swap out Hladgunnr for a tank if you don't have her (Momus, Geb, Ares, Khepri) - or any other melee fighter.",
      "Focus on ATK buffs, or go for all Crit buffs you can get - DEF Ignore on Crit is very valuable.",
      "If Starting Energy +1000 pops up, take it.",
    ],
  },

  {
    id: "megafungus-skadi",
    label: "Megafungus - Skadi Carry",
    blessing: "Megafungus",
    heroes: [
      { id: "yuelao",   name: "Yuelao",   note: "Healer / Support" },
      { id: "caishen",  name: "Caishen",  note: "Energy Support" },
      { id: "skadi",    name: "Skadi",    note: "Main Carry (grows in size)" },
      { id: "dionysus", name: "Dionysus", note: "ATK Speed / Support" },
      { id: "poseidon", name: "Poseidon", note: "CC / DPS" },
    ],
    notes: [
      "Focus on ATK buffs for all heroes - Skadi inherits 50% of every ally's ATK at max blessing level.",
      "Also go for all Crit buffs you can get - DEF Ignore on Crit is especially valuable.",
      "If Starting Energy +1000 appears, take it.",
      "Ares Boss: Can replace Yuelao with Momus if needed.",
      "Shield on Ultimate + Energy Regen on Shield form a strong energy loop - take both if offered.",
    ],
  },
];
---

<Base
  title="Delusions Den Guide | Motto Immortal"
  description="Complete guide for Delusions Den (Mang Nian Chao Xue) in Motto Immortal. Mechanics, best hero compositions, blessing choices, and buff priority for top scores."
>

  <PageHero
    tag="Game Mode Guide"
    headline="Delusions Den"
    subtitle="Wave-based roguelite challenge mode. Pick a blessing, draft buffs between waves, and push for top score."
    bgImage="https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/delusiondenbg.webp"
  />

  <div class="page-wrapper">
    <main class="dd-main">

      <!-- ================================================================
           SECTION 1: WHAT IS DELUSIONS DEN
           ================================================================ -->
      <div class="dd-card dd-intro-card">
        <h2>What is Delusions Den?</h2>
        <p>
          Delusions Den is a repeating wave-based challenge mode where you run a 5-hero team
          through 7 progressive waves, selecting buffs between each wave to build toward a final scoring stage.
          Top players on a server reach 230-236 points in the scoring stage. The mode resets periodically
          and tracks server leaderboards.
        </p>

        <div class="dd-callout">
          <strong>Core Loop:</strong> Select a starting blessing, fight through 7 waves, pick one buff after
          each wave, and maximize enemy kills in the final scoring stage.
        </div>

        <div class="dd-callout dd-callout-req">
          <strong>Requirements:</strong> Delusions Den unlocks after completing Chapter 31.
          Maximum difficulty is Level 6. The mode resets periodically and tracks server leaderboards.
        </div>

        <h3>Rewards for ranks</h3>
        <div class="dd-reward-grid">
          <div class="dd-reward-card">
            <div class="dd-reward-img-wrap">
              <img src={`${DD_R2}/frame.webp`} alt="Avatar Frame" class="dd-reward-img" />
            </div>
            <div class="dd-reward-title">Avatar Frame</div>
            <div class="dd-reward-name">Profane Gaze</div>
            <div class="dd-reward-desc">Cosmetic frame awarded to top-ranking players on your server.</div>
          </div>
          <div class="dd-reward-card">
            <div class="dd-reward-img-wrap">
              <img src={`${DD_R2}/token.webp`} alt="Oculus Token" class="dd-reward-img" />
            </div>
            <div class="dd-reward-title">Oculus Tokens</div>
            <div class="dd-reward-name">Shop Currency</div>
            <div class="dd-reward-desc">Spent in the Den Shop to purchase items.</div>
          </div>
        </div>
       

      </div><!-- /dd-intro-card -->

      <!-- ================================================================
           SECTION 2: RUN FLOW
           ================================================================ -->
      <div class="dd-card dd-flow-card">
        <h2>How a Run Works</h2>

        <div class="flow-row">

          <!-- Blessing -->
          <div class="fr-node fr-node-blessing">
            <svg width="20" height="20" viewBox="0 0 18 18" fill="none">
              <path d="M9 1 L10.8 6.5 L16.5 6.5 L11.9 9.9 L13.7 15.4 L9 12 L4.3 15.4 L6.1 9.9 L1.5 6.5 L7.2 6.5 Z" fill="rgba(216,180,254,0.9)"/>
            </svg>
            <span class="fr-label">Blessing</span>
          </div>

          <div class="fr-arrow"></div>

          <!-- Stages 1-6 -->
          {(
            [
              { stage: 1, levels: "1-6",   waves: 6 },
              { stage: 2, levels: "7",     waves: 1 },
              { stage: 3, levels: "8-11",  waves: 3 },
              { stage: 4, levels: "12-14", waves: 2 },
              { stage: 5, levels: "15-17", waves: 2 },
              { stage: 6, levels: "18",    waves: 1 },
            ] as { stage: number; levels: string; waves: number }[]
          ).map(({ stage, levels, waves }, i, arr) => (
            <>
              <div class="fr-node fr-node-stage">
                <span class="fr-stage-num">Stage {stage}</span>
                <span class="fr-label">Lvl {levels}</span>
                <span class="fr-waves">{waves === 1 ? "1 wave" : `${waves} waves`}</span>
              </div>
              {i < arr.length - 1 && <div class="fr-arrow"></div>}
            </>
          ))}

          <div class="fr-arrow fr-arrow-gold"></div>

          <!-- Stage 7 -->
          <div class="fr-node fr-node-final">
            <span class="fr-timer">45s</span>
            <span class="fr-label">S7 Scoring</span>
            <span class="fr-waves" style="color:rgba(250,204,21,0.35)">Lvl 18-20</span>
          </div>

        </div><!-- /flow-row -->

        <div class="flow-hint">Pick one blessing before the run. Clear all waves in a stage to earn a buff pick. Stage 7 is a 45s timed kill challenge.</div>

      </div><!-- /dd-flow-card -->

      <!-- ================================================================
           SECTION 3: BLESSINGS
           ================================================================ -->
      <div class="dd-card dd-blessings-card">
        <h2>Blessings</h2>
        <p>
          Choose one blessing before combat begins. Your choice determines the entire team-building
          and buff-selection strategy for the run. Blessings scale as your Total Genre Level increases.
        </p>

        <div class="bl-strip">
          {blessings.map(b => (
            <div class={`bl-row ${b.recommended ? "bl-row-rec" : ""}`}>

              <div class="bl-row-left">
                {BLESSING_IMG[b.id] ? (
                  <div class="bl-row-img-wrap">
                    <img src={BLESSING_IMG[b.id]} alt={b.name} class="bl-row-img" />
                  </div>
                ) : (
                  <div class="bl-row-img-wrap bl-row-img-placeholder"></div>
                )}
                <div class="bl-row-identity">
                  <div class="bl-row-name-line">
                    <span class="bl-row-name">{b.name}</span>
                    <span class={`bl-badge ${b.recommended ? "bl-badge-rec" : "bl-badge-alt"}`}>
                      {b.recommended ? "Recommended" : "Alternative"}
                    </span>
                  </div>
                  <p class="bl-row-effect">{b.effect}</p>
                </div>
              </div>

              <div class="bl-row-right">
                {b.why && (
                  <div class="bl-why-block">
                    <span class="bl-why-label">Why this works</span>
                    <p class="bl-why-text">{b.why}</p>
                  </div>
                )}

                {b.tips && b.tips.length > 0 && (
                  <ul class="bl-tips-list">
                    {b.tips.map(tip => <li>{tip}</li>)}
                  </ul>
                )}

                {b.upgrades.length > 0 && (
                  <div class="bl-upgrades-inline">
                    {b.upgrades.map(u => {
                      const p = parseUpgrade(u);
                      return (
                        <div class="upgrade-row">
                          <span class="upgrade-lv">Lv {p.level}</span>
                          <span class="upgrade-text">{p.text}</span>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>

            </div>
          ))}
        </div>
      </div>

      <!-- ================================================================
           SECTION 3: BUFFS
           ================================================================ -->
      <div class="dd-card">
        <div class="buff-header-row">
          <h2>Buffs</h2>
          <span class="buff-count">{buffs.length} buffs</span>
        </div>
        <div class="dd-callout">
          <strong>Buff Levels:</strong> Each buff card has its own level that increases each time you pick it.
          A buff evolves once at level 5, then again every 10 levels, and is fully evolved at level 15.
          The five genre icons at the top of the screen track progress across your buff categories.
        </div>

        <p>
          One buff is offered after each combat wave. The priority badges at the bottom of each card
          show how valuable that buff is for each blessing:
          <span class="prio-inline prio-1">1</span> = top priority,
          <span class="prio-inline prio-2">2</span> = strong pick,
          <span class="prio-inline prio-3">3</span> = situational,
          <span class="prio-inline prio-skip">skip</span> = avoid.
          Unconfirmed buff names are marked with an asterisk (*).
        </p>

        <div class="buff-list">
          <div class="buff-list-header">
            <span class="buff-col-name sortable-header" data-sort-key="name">
              Buff
              <span class="sort-arrow"></span>
            </span>
            <span class="buff-col-effect">Effect</span>
            <div class="buff-col-prios" id="buff-sort-container">
              {BLESSING_KEYS.map(key => (
                <span class="prio-col-label sortable-header" data-sort-key={key}>
                  {BLESSING_SHORT[key]}
                  <span class="sort-arrow"></span>
                </span>
              ))}
            </div>
          </div>

          {buffs.map(b => {
            const prioData = BLESSING_KEYS.map(key => {
              const p = b.priority as unknown as AnyRecord;
              const val = p[key] ?? "?";
              return val === "skip" ? 99 : (typeof val === "number" ? val : 99);
            }).join(",");
            return (
              <div class="buff-row" data-prios={prioData}>
                <div class="buff-col-name">
                  <div class="buff-hexes">
                    {b.tags.slice(0, 1).map(tag => {
                      const meta = TAG_META[tag];
                      return meta ? (
                        <div class={`buff-hex ${meta.cls}`}>{meta.short}</div>
                      ) : null;
                    })}
                  </div>
                  <span class="buff-name">{b.name}{!b.confirmed ? " *" : ""}</span>
                </div>

                <div class="buff-col-effect">
                  <span class="buff-effect">{b.effect}</span>
                  {b.note && <span class="buff-note">{b.note}</span>}
                </div>

                <div class="buff-col-prios">
                  {BLESSING_KEYS.map(key => {
                    const val = getBuffPrio(b, key);
                    return (
                      <div class={`buff-prio ${PRIO_CLS[val] ?? ""}`}>
                        <span class="prio-val">{val}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- ================================================================
           SECTION 4: HERO COMPOSITIONS
           ================================================================ -->
      <div class="dd-card">
        <h2>Hero Compositions</h2>
        <p>
          Comps that work well in Delusions Den. The right choice depends on your roster depth and hero investment.
        </p>

        <div class="dd-comp-list">
          {DD_COMPS.map(comp => (
            <div class="dd-comp-card">
              <div class="dd-comp-card-header">
                <span class="dd-comp-card-title">{comp.label}</span>
                <span class="dd-comp-blessing-tag">Blessing: <strong>{comp.blessing}</strong></span>
              </div>

              <div class="dd-hero-grid">
                {comp.heroes.map(hero => (
                  <a href={`/heroes/${hero.id}`} class="dd-hero-card">
                    <div class="dd-hero-portrait" style={`background-image:url('${hp(hero.id)}')`}></div>
                    <span class="dd-hero-role">{hero.note}</span>
                    <span class="dd-hero-name">{hero.name}</span>
                  </a>
                ))}
              </div>

              {comp.notes.length > 0 && (
                <ul class="dd-comp-notes-list">
                  {comp.notes.map(note => <li>{note}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- ================================================================
           SECTION 5: TIPS
           ================================================================ -->
      <div class="dd-card">
        <h2>Reaching Top Score</h2>
        <p>
          The final wave (scoring stage) is a timed kill-count challenge. Your team's accumulated
          buffs and hero investment determine how many enemies you can clear before time expires.
          Top server scores sit at 230-236 points. Here is how to maximize:
        </p>

        <div class="dd-tip-list">
          <div class="dd-tip">
            <div class="dd-tip-num">1</div>
            <div class="dd-tip-body">
              <strong>Pick a blessing before you start.</strong> Your choice will guide how you build
              your team and choose buffs during the run. The effects of blessings get stronger as your
              Total Genre Level goes up.
            </div>
          </div>
          <div class="dd-tip">
            <div class="dd-tip-num">2</div>
            <div class="dd-tip-body">
              <strong>Stack the right buffs for your blessing.</strong> Only pick buffs that match your
              strategy. If you clear all the waves in a stage, you get a chest of random buffs. In Stage 7
              you have 45 seconds to complete a timed kill challenge - so be prepared with good buffs and
              a strategy.
            </div>
          </div>
          <div class="dd-tip">
            <div class="dd-tip-num">3</div>
            <div class="dd-tip-body">
              <strong>Buff levels matter.</strong> Each buff card has its own level that increases each
              time you pick it. A buff evolves once at level 5, then again every 10 levels, and is fully
              evolved at level 15. The five genre icons at the top of the screen track progress across
              your buff categories.
            </div>
          </div>
          <div class="dd-tip">
            <div class="dd-tip-num">4</div>
            <div class="dd-tip-body">
              <strong>Prioritize healing or shield buffs for Horn of Doom.</strong> This ability deals
              damage to all enemies over time based on a percentage of their health - helpful for new
              players. Keep in mind your team will take a bit of damage each turn, so bring some healing
              or ways to keep your heroes alive.
            </div>
          </div>
          <div class="dd-tip">
            <div class="dd-tip-num">5</div>
            <div class="dd-tip-body">
              <strong>Use the Keystone of Wonders totem.</strong> Activating all 5 faction suits grants
              bonus damage dealt and damage reduction. Build your team with this in mind even if it means
              a slightly weaker individual hero.
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

</Base>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const buffList = document.querySelector(".buff-list") as HTMLElement | null;
    const headers = document.querySelectorAll(".sortable-header");
    let currentSort: { key: string | null; direction: "asc" | "desc" } = { key: null, direction: "asc" };

    if (!buffList) return;

    headers.forEach((header) => {
      const headerEl = header as HTMLElement;
      headerEl.style.cursor = "pointer";
      const sortKey = headerEl.dataset.sortKey;

      headerEl.addEventListener("click", () => {
        const isCurrentSort = currentSort.key === sortKey;
        currentSort.direction = isCurrentSort && currentSort.direction === "asc" ? "desc" : "asc";
        currentSort.key = sortKey || null;

        const rows = Array.from(buffList.querySelectorAll(".buff-row")) as HTMLElement[];

        if (sortKey === "name") {
          rows.sort((a, b) => {
            const nameA = a.querySelector(".buff-name")?.textContent?.trim() || "";
            const nameB = b.querySelector(".buff-name")?.textContent?.trim() || "";
            const comparison = nameA.localeCompare(nameB);
            return currentSort.direction === "asc" ? comparison : -comparison;
          });
        } else {
          const blessing_keys = ["mask_of_sorrow", "divine_nectar", "megafungus", "ripper", "horn_of_doom"];
          const columnIndex = blessing_keys.indexOf(sortKey as string);

          rows.sort((a, b) => {
            const prioStr = (a as HTMLElement & { dataset: { prios: string } }).dataset.prios;
            const priosA = prioStr ? prioStr.split(",").map(Number) : [];
            const prioStrB = (b as HTMLElement & { dataset: { prios: string } }).dataset.prios;
            const priosB = prioStrB ? prioStrB.split(",").map(Number) : [];
            const valA = priosA[columnIndex] || 99;
            const valB = priosB[columnIndex] || 99;
            return currentSort.direction === "asc" ? valA - valB : valB - valA;
          });
        }

        headers.forEach(h => {
          const arrow = h.querySelector(".sort-arrow");
          if (arrow) arrow.textContent = "";
          h.classList.remove("sort-active");
        });

        headerEl.classList.add("sort-active");
        const arrow = headerEl.querySelector(".sort-arrow");
        if (arrow) arrow.textContent = currentSort.direction === "asc" ? " ▲" : " ▼";

        buffList.querySelectorAll(".buff-row").forEach(row => row.remove());
        rows.forEach(row => buffList.appendChild(row));
      });
    });
  });
</script>

<style>
  /* Layout */
  .page-wrapper {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  .dd-main {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Section card */
  .dd-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 36px 32px;
  }

  .dd-intro-card {
    border-color: rgba(250, 204, 21, 0.12);
    background: rgba(250, 204, 21, 0.03);
  }

  .dd-card h2 {
    margin: 0 0 16px;
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-bright, #f0f0f5);
    letter-spacing: 0.01em;
  }

  .dd-card h3 {
    margin: 28px 0 12px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(230, 230, 235, 0.85);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .dd-card p {
    margin: 0 0 12px;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(230, 230, 235, 0.78);
  }

  /* Callout */
  .dd-callout {
    background: rgba(250, 204, 21, 0.07);
    border: 1px solid rgba(250, 204, 21, 0.18);
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(230, 230, 235, 0.85);
    margin: 16px 0;
  }

  .dd-callout-req {
    background: rgba(56, 189, 248, 0.06);
    border-color: rgba(56, 189, 248, 0.18);
    margin-top: 0;
  }

  /* Key box */
  .dd-keybox {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 16px 20px;
    margin-top: 20px;
  }

  .dd-keybox-title {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(250, 204, 21, 0.8);
    margin-bottom: 10px;
  }

  .dd-keybox ul {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dd-keybox li {
    font-size: 0.875rem;
    color: rgba(230, 230, 235, 0.78);
    line-height: 1.5;
  }

  /* Reward grid */
  .dd-reward-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 12px 0 24px;
  }

  .dd-reward-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 16px;
  }

  .dd-reward-img-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 10px;
  }

  .dd-reward-img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    border-radius: 8px;
  }

  .dd-reward-title {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(250, 204, 21, 0.7);
    margin-bottom: 4px;
  }

  .dd-reward-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-bright, #f0f0f5);
    margin-bottom: 6px;
  }

  .dd-reward-desc {
    font-size: 0.82rem;
    color: rgba(230, 230, 235, 0.6);
    line-height: 1.5;
  }

  /* Wave table */
  .dd-wave-table {
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    overflow: hidden;
    margin: 12px 0;
  }

  .dd-wave-row {
    display: grid;
    grid-template-columns: 80px 160px 1fr;
    gap: 0;
    padding: 11px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.85rem;
    color: rgba(230, 230, 235, 0.75);
    align-items: center;
  }

  .dd-wave-row:last-child { border-bottom: none; }

  .dd-wave-header {
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(230, 230, 235, 0.45);
    font-weight: 600;
  }

  .dd-wave-break {
    background: rgba(120, 90, 200, 0.06);
    border-left: 3px solid rgba(120, 90, 200, 0.4);
  }

  .dd-wave-final {
    background: rgba(250, 204, 21, 0.05);
    border-left: 3px solid rgba(250, 204, 21, 0.4);
    color: rgba(230, 230, 235, 0.88);
  }

  .dd-wave-num {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-bright, #f0f0f5);
  }

  .dd-wave-type {
    font-weight: 600;
    color: rgba(230, 230, 235, 0.85);
  }

  /* ================================================================
     RUN FLOW
     ================================================================ */
  .dd-flow-card {
    border-color: rgba(255, 255, 255, 0.07);
  }

  .dd-flow-card h2 {
    margin-bottom: 20px;
  }

  /* Horizontal row of nodes + arrows */
  .flow-row {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex-wrap: wrap;
    row-gap: 10px;
  }

  /* Arrow connector */
  .fr-arrow {
    flex-shrink: 0;
    align-self: center;
    width: 20px;
    height: 2px;
    background: rgba(56, 189, 248, 0.2);
    position: relative;
  }

  .fr-arrow::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -3px;
    border-left: 5px solid rgba(56, 189, 248, 0.3);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
  }

  .fr-arrow-gold {
    background: linear-gradient(to right, rgba(56, 189, 248, 0.18), rgba(250, 204, 21, 0.35));
  }

  .fr-arrow-gold::after {
    border-left-color: rgba(250, 204, 21, 0.5);
  }

  /* Node base */
  .fr-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 10px 14px;
    border-radius: 10px;
    flex-shrink: 0;
    height: 72px;
    box-sizing: border-box;
  }

  .fr-node-blessing {
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .fr-node-stage {
    background: rgba(56, 189, 248, 0.07);
    border: 1px solid rgba(56, 189, 248, 0.22);
    min-width: 58px;
  }

  .fr-node-final {
    background: rgba(250, 204, 21, 0.08);
    border: 1px solid rgba(250, 204, 21, 0.3);
  }

  .fr-stage-num {
    font-size: 1rem;
    font-weight: 800;
    color: rgba(186, 230, 253, 0.9);
    line-height: 1;
  }

  .fr-label {
    font-size: 0.62rem;
    font-weight: 600;
    color: rgba(230, 230, 235, 0.4);
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .fr-node-blessing .fr-label {
    color: rgba(216, 180, 254, 0.7);
  }

  .fr-node-final .fr-label {
    color: rgba(253, 230, 138, 0.6);
  }

  .fr-waves {
    font-size: 0.62rem;
    font-weight: 600;
    color: rgba(56, 189, 248, 0.38);
    letter-spacing: 0.02em;
  }

  .fr-timer {
    font-size: 1.1rem;
    font-weight: 800;
    color: rgba(250, 204, 21, 0.9);
    line-height: 1;
  }

  .flow-hint {
    margin-top: 16px;
    font-size: 0.78rem;
    color: rgba(230, 230, 235, 0.4);
    line-height: 1.5;
  }

  /* ================================================================
     BLESSINGS - horizontal strip layout
     ================================================================ */
  .dd-blessings-card {
    border-color: rgba(168, 85, 247, 0.1);
  }

  .bl-strip {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 20px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    overflow: hidden;
  }

  .bl-row {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .bl-row:last-child {
    border-bottom: none;
  }

  .bl-row-rec {
    background: rgba(168, 85, 247, 0.04);
  }

  .bl-row-left {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px 20px 20px 20px;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }

  .bl-row-rec .bl-row-left {
    border-right-color: rgba(168, 85, 247, 0.15);
  }

  .bl-row-img-wrap {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 10px;
    background: radial-gradient(circle at center, rgba(168, 85, 247, 0.2) 0%, rgba(168, 85, 247, 0.05) 70%, transparent 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bl-row-img-placeholder {
    background: rgba(255, 255, 255, 0.04);
    border: 1px dashed rgba(255, 255, 255, 0.1);
  }

  .bl-row-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    border-radius: 10px;
  }

  .bl-row-identity {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bl-row-name-line {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .bl-row-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-bright, #f0f0f5);
  }

  .bl-badge {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 4px;
    padding: 2px 7px;
  }

  .bl-badge-rec {
    background: rgba(168, 85, 247, 0.18);
    color: rgba(216, 180, 254, 0.95);
    border: 1px solid rgba(168, 85, 247, 0.35);
  }

  .bl-badge-alt {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(230, 230, 235, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }

  .bl-row-effect {
    font-size: 0.82rem;
    line-height: 1.55;
    color: rgba(230, 230, 235, 0.65);
    margin: 0;
  }

  .bl-row-right {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bl-why-block {
    background: rgba(168, 85, 247, 0.06);
    border: 1px solid rgba(168, 85, 247, 0.15);
    border-radius: 8px;
    padding: 12px 14px;
  }

  .bl-why-label {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(216, 180, 254, 0.7);
    margin-bottom: 6px;
  }

  .bl-why-text {
    font-size: 0.84rem;
    line-height: 1.6;
    color: rgba(230, 230, 235, 0.82);
    margin: 0;
  }

  .bl-tips-list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bl-tips-list li {
    font-size: 0.8rem;
    line-height: 1.5;
    color: rgba(230, 230, 235, 0.6);
  }

  .bl-upgrades-inline {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .upgrade-row {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 7px 10px;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .upgrade-lv {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 7px;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.25);
    color: rgba(216, 180, 254, 0.85);
    border-radius: 4px;
    white-space: nowrap;
    align-self: flex-start;
  }

  .upgrade-text {
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgba(230, 230, 235, 0.65);
  }

  /* ================================================================
     BUFFS
     ================================================================ */
  .buff-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
  }

  .buff-header-row h2 {
    margin: 0;
  }

  .buff-count {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(250, 204, 21, 0.12);
    border: 1px solid rgba(250, 204, 21, 0.25);
    color: rgba(250, 204, 21, 0.85);
    border-radius: 20px;
    padding: 4px 12px;
    white-space: nowrap;
  }

  .buff-list {
    margin-top: 20px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    overflow: hidden;
  }

  .buff-list-header,
  .buff-row {
    display: grid;
    grid-template-columns: 220px 1fr 150px;
    gap: 0;
    align-items: center;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .buff-list-header {
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(230, 230, 235, 0.4);
  }

  .buff-row:last-child { border-bottom: none; }

  .buff-row:nth-child(even) { background: rgba(255, 255, 255, 0.015); }

  .buff-col-name {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-right: 16px;
  }

  .buff-col-name.sortable-header {
    cursor: pointer;
    user-select: none;
  }

  .buff-col-name.sortable-header:hover {
    color: rgba(250, 204, 21, 0.9);
  }

  .buff-col-effect {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-right: 16px;
  }

  .buff-col-prios {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }

  /* Hexagon tag icons */
  .buff-hexes {
    flex-shrink: 0;
  }

  .buff-hex {
    width: 34px;
    height: 30px;
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.46rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .tag-blue   { background: rgba(56, 189, 248, 0.25);  color: rgba(186, 230, 253, 0.95); }
  .tag-gold   { background: rgba(250, 204, 21, 0.25);  color: rgba(253, 230, 138, 0.95); }
  .tag-purple { background: rgba(168, 85, 247, 0.25);  color: rgba(216, 180, 254, 0.95); }
  .tag-orange { background: rgba(251, 146, 60, 0.25);  color: rgba(253, 186, 116, 0.95); }
  .tag-green  { background: rgba(74, 222, 128, 0.25);  color: rgba(134, 239, 172, 0.95); }
  .tag-red    { background: rgba(248, 113, 113, 0.25); color: rgba(252, 165, 165, 0.95); }
  .tag-cyan   { background: rgba(34, 211, 238, 0.25);  color: rgba(103, 232, 249, 0.95); }
  .tag-pink   { background: rgba(244, 114, 182, 0.25); color: rgba(249, 168, 212, 0.95); }
  .tag-sky    { background: rgba(125, 211, 252, 0.25); color: rgba(186, 230, 253, 0.95); }
  .tag-violet { background: rgba(167, 139, 250, 0.25); color: rgba(196, 181, 253, 0.95); }

  .buff-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-bright, #f0f0f5);
    line-height: 1.3;
  }

  .buff-effect {
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgba(134, 239, 172, 0.85);
  }

  .buff-note {
    font-size: 0.72rem;
    line-height: 1.4;
    color: rgba(230, 230, 235, 0.45);
    font-style: italic;
  }

  /* Priority badges */
  .prio-col-label {
    width: 26px;
    text-align: center;
    position: relative;
    user-select: none;
  }

  .prio-col-label.sortable-header {
    cursor: pointer;
  }

  .prio-col-label.sortable-header:hover {
    color: rgba(250, 204, 21, 0.9);
  }

  .sort-arrow {
    font-size: 0.6rem;
    opacity: 0;
    transition: opacity 0.2s;
    margin-left: 2px;
  }

  .prio-col-label.sort-active .sort-arrow {
    opacity: 1;
  }

  .buff-prio {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
  }

  .prio-val {
    font-size: 0.68rem;
    font-weight: 700;
  }

  .prio-1 { background: rgba(250, 204, 21, 0.14); }
  .prio-1 .prio-val { color: rgba(250, 204, 21, 0.95); }

  .prio-2 { background: rgba(74, 222, 128, 0.12); }
  .prio-2 .prio-val { color: rgba(74, 222, 128, 0.9); }

  .prio-3 { background: rgba(255, 255, 255, 0.04); }
  .prio-3 .prio-val { color: rgba(230, 230, 235, 0.4); }

  .prio-skip { background: rgba(248, 113, 113, 0.1); }
  .prio-skip .prio-val { color: rgba(248, 113, 113, 0.8); font-size: 0.58rem; }

  /* Inline prio badges in intro text */
  .prio-inline {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .prio-inline.prio-1 { background: rgba(250, 204, 21, 0.15); color: rgba(250, 204, 21, 0.95); }
  .prio-inline.prio-2 { background: rgba(74, 222, 128, 0.12); color: rgba(74, 222, 128, 0.9); }
  .prio-inline.prio-3 { background: rgba(255, 255, 255, 0.06); color: rgba(230, 230, 235, 0.55); }
  .prio-inline.prio-skip { background: rgba(248, 113, 113, 0.1); color: rgba(248, 113, 113, 0.85); }

  /* ================================================================
     COMPS
     ================================================================ */
  .dd-comp-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
  }

  .dd-comp-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 22px 20px;
  }

  .dd-comp-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .dd-comp-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-bright, #f0f0f5);
  }

  .dd-comp-blessing-tag {
    font-size: 0.75rem;
    color: rgba(230, 230, 235, 0.5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 10px;
  }

  .dd-comp-blessing-tag strong { color: rgba(250, 204, 21, 0.9); }

  /* Hero grid */
  .dd-hero-grid {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .dd-hero-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    width: 100px;
    transition: opacity 0.15s;
  }

  .dd-hero-card:hover { opacity: 0.85; }

  .dd-hero-portrait {
    width: 100px;
    height: 100px;
    border-radius: 10px;
    background-size: cover;
    background-position: center 30%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.04);
  }

  .dd-hero-role {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(250, 204, 21, 0.7);
    font-weight: 600;
    text-align: center;
    line-height: 1.3;
  }

  .dd-hero-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(230, 230, 235, 0.85);
    text-align: center;
  }

  .dd-comp-notes-list {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dd-comp-notes-list li {
    font-size: 0.85rem;
    color: rgba(230, 230, 235, 0.68);
    line-height: 1.5;
  }

  /* ================================================================
     TIPS
     ================================================================ */
  .dd-tip-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 16px;
  }

  .dd-tip {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .dd-tip-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(250, 204, 21, 0.12);
    border: 1px solid rgba(250, 204, 21, 0.25);
    color: rgba(250, 204, 21, 0.85);
    font-size: 0.78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .dd-tip-body {
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(230, 230, 235, 0.75);
  }

  .dd-tip-body strong { color: rgba(230, 230, 235, 0.92); }

  /* ================================================================
     RESPONSIVE
     ================================================================ */
  @media (max-width: 700px) {
    .dd-card { padding: 24px 18px; }

    .dd-wave-row {
      grid-template-columns: 50px 110px 1fr;
      font-size: 0.78rem;
      padding: 10px 12px;
    }

