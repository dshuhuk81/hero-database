---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import TipsMechanics from "../components/tips/TipsMechanics.astro";
import TipsEarly from "../components/tips/TipsEarly.astro";
import TipsMidLate from "../components/tips/TipsMidLate.astro";
import TipsTeams from "../components/tips/TipsTeams.astro";
import "../styles/tips.css";
import { defaultLocale, type Locale } from "../i18n/config";
import { pickLang, type LocalizedString } from "../i18n/helpers";
import { t } from "../i18n/ui";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props as Props;

const startCopy = {
  kicker: {
    en: "Start here",
    de: "Hier starten",
    es: "Empieza aquí",
    ru: "Начни здесь",
  },
  title: {
    en: "Your F2P start plan",
    de: "Dein F2P-Startplan",
    es: "Tu plan inicial F2P",
    ru: "Твой стартовый F2P-план",
  },
  intro: {
    en: "Progress comes from focus, not from building everything at once. These three decisions give a new account the strongest start.",
    de: "Fortschritt entsteht durch Fokus, nicht dadurch, alles gleichzeitig auszubauen. Diese drei Entscheidungen geben einem neuen Account den stärksten Start.",
    es: "El progreso viene de concentrarse, no de mejorar todo a la vez. Estas tres decisiones dan a una cuenta nueva el mejor comienzo.",
    ru: "Прогресс приходит благодаря фокусу, а не попыткам развивать всё сразу. Эти три решения дадут новому аккаунту лучший старт.",
  },
  teamTitle: {
    en: "Build one team",
    de: "Baue ein Team",
    es: "Construye un equipo",
    ru: "Собери одну команду",
  },
  teamBody: {
    en: "Choose 1–2 damage carries and use the rest of the team to keep them alive, funded and casting.",
    de: "Wähle 1–2 Schadens-Carrys und nutze den Rest des Teams, um sie am Leben, versorgt und aktiv zu halten.",
    es: "Elige 1–2 carries de daño y usa el resto del equipo para mantenerlos vivos, con energía y lanzando habilidades.",
    ru: "Выбери 1–2 основных дамагеров, а остальной командой поддерживай их жизнь, энергию и частое применение навыков.",
  },
  unlockTitle: {
    en: "Push key unlocks",
    de: "Wichtige Inhalte freischalten",
    es: "Avanza hasta los desbloqueos clave",
    ru: "Открывай ключевые режимы",
  },
  unlockBody: {
    en: "Advance Odyssey until you are stuck and complete Torment Rift every week. Account-wide systems matter more than side projects.",
    de: "Treibe Odyssey voran, bis du festhängst, und schließe Torment Rift jede Woche ab. Accountweite Systeme sind wichtiger als Nebenprojekte.",
    es: "Avanza en Odyssey hasta atascarte y completa Torment Rift cada semana. Los sistemas de toda la cuenta importan más que los proyectos secundarios.",
    ru: "Продвигайся в Odyssey до упора и закрывай Torment Rift каждую неделю. Общие усиления аккаунта важнее побочных целей.",
  },
  spendTitle: {
    en: "Spend with purpose",
    de: "Investiere mit Ziel",
    es: "Gasta con intención",
    ru: "Трать ресурсы осознанно",
  },
  spendBody: {
    en: "Use early summons to establish a roster, set the Wish List quickly, then save premium resources for meaningful targets.",
    de: "Nutze frühe Beschwörungen für dein Roster, stelle die Wish List schnell ein und spare Premium-Ressourcen danach für wichtige Ziele.",
    es: "Usa las primeras invocaciones para formar tu plantel, configura pronto la Wish List y después guarda los recursos premium para objetivos importantes.",
    ru: "Ранними призывами собери основу ростера, быстро настрой Wish List, а затем копи премиальные ресурсы на важные цели.",
  },
  warning: {
    en: "The most common early mistake is splitting investment across too many heroes. Finish the core of one team before funding a second.",
    de: "Der häufigste frühe Fehler ist, Investitionen auf zu viele Helden zu verteilen. Stelle den Kern eines Teams fertig, bevor du ein zweites finanzierst.",
    es: "El error inicial más común es repartir la inversión entre demasiados héroes. Termina el núcleo de un equipo antes de financiar un segundo.",
    ru: "Самая частая ошибка в начале — распределять ресурсы между слишком многими героями. Сначала закончи основу одной команды.",
  },
  readGuide: {
    en: "Read the guide",
    de: "Guide lesen",
    es: "Leer la guía",
    ru: "Читать раздел",
  },
} satisfies Record<string, LocalizedString>;
---

<Base title={t(locale, "tips", "metaTitle")} description={t(locale, "tips", "metaDescription")} locale={locale}>
  <PageHero
    tag={t(locale, "tips", "tag")}
    headline={t(locale, "tips", "headline")}
    subtitle={t(locale, "tips", "subtitle")}
    locale={locale}
  />
  <div class="page-wrapper tips-page page-content">
    <section class="tips-start" aria-labelledby="tips-start-title">
      <div class="tips-start-heading">
        <div>
          <p class="tips-start-kicker">{pickLang(startCopy.kicker, locale)}</p>
          <h2 id="tips-start-title">{pickLang(startCopy.title, locale)}</h2>
          <p class="tips-start-intro">{pickLang(startCopy.intro, locale)}</p>
        </div>
        <p class="tips-last-updated">{t(locale, "tips", "lastUpdated")}: 2026-06-25</p>
      </div>

      <div class="tips-start-grid">
        <a class="tips-start-step" href="#section-first">
          <span class="tips-start-number">01</span>
          <span class="tips-start-copy">
            <strong>{pickLang(startCopy.teamTitle, locale)}</strong>
            <span>{pickLang(startCopy.teamBody, locale)}</span>
            <em>{pickLang(startCopy.readGuide, locale)} →</em>
          </span>
        </a>
        <a class="tips-start-step" href="#section-odyssey">
          <span class="tips-start-number">02</span>
          <span class="tips-start-copy">
            <strong>{pickLang(startCopy.unlockTitle, locale)}</strong>
            <span>{pickLang(startCopy.unlockBody, locale)}</span>
            <em>{pickLang(startCopy.readGuide, locale)} →</em>
          </span>
        </a>
        <a class="tips-start-step" href="#section-summons">
          <span class="tips-start-number">03</span>
          <span class="tips-start-copy">
            <strong>{pickLang(startCopy.spendTitle, locale)}</strong>
            <span>{pickLang(startCopy.spendBody, locale)}</span>
            <em>{pickLang(startCopy.readGuide, locale)} →</em>
          </span>
        </a>
      </div>

      <p class="tips-start-warning">{pickLang(startCopy.warning, locale)}</p>
    </section>

    <div class="tips-content">
      <div class="tips-subnav" role="tablist" aria-label={t(locale, "tips", "headline")}>
        <button id="subtab-btn-early" class="tips-subnav-btn is-active" data-subtab="early" role="tab" aria-controls="subtab-early" aria-selected="true">{t(locale, "tips", "subnavEarly")}</button>
        <button id="subtab-btn-midlate" class="tips-subnav-btn" data-subtab="midlate" role="tab" aria-controls="subtab-midlate" aria-selected="false" tabindex="-1">{t(locale, "tips", "subnavMidLate")}</button>
        <button id="subtab-btn-teams" class="tips-subnav-btn" data-subtab="teams" role="tab" aria-controls="subtab-teams" aria-selected="false" tabindex="-1">{t(locale, "tips", "subnavTeams")}</button>
        <button id="subtab-btn-mechanics" class="tips-subnav-btn" data-subtab="mechanics" role="tab" aria-controls="subtab-mechanics" aria-selected="false" tabindex="-1">{t(locale, "tips", "subnavMechanics")}</button>
      </div>

      <TipsEarly locale={locale} />
      <TipsMidLate locale={locale} />
      <TipsTeams locale={locale} />
      <TipsMechanics locale={locale} />
    </div>

    <script>
      function setupRovingTabs(tabs: NodeListOf<Element>, getId: (el: Element) => string | undefined, activate: (id: string) => void) {
        const list = Array.from(tabs) as HTMLElement[];
        list.forEach((tabEl, idx) => {
          tabEl.addEventListener('keydown', (e: KeyboardEvent) => {
            const key = e.key;
            const horizontalNext = key === 'ArrowRight' || key === 'ArrowDown';
            const horizontalPrev = key === 'ArrowLeft' || key === 'ArrowUp';
            if (horizontalNext || horizontalPrev || key === 'Home' || key === 'End') {
              e.preventDefault();
              const nextIdx = key === 'Home'
                ? 0
                : key === 'End'
                  ? list.length - 1
                  : (idx + (horizontalNext ? 1 : -1) + list.length) % list.length;
              list[nextIdx]?.focus();
              return;
            }

            if (key === 'Enter' || key === ' ') {
              e.preventDefault();
              const id = getId(tabEl);
              if (id) activate(id);
            }
          });
        });
      }

      function getHashId() {
        return decodeURIComponent((location.hash || '').replace('#', ''));
      }

      function showForTargetId(targetId: string) {
        if (!targetId) return false;

        if (['mechanics', 'early', 'midlate', 'teams'].includes(targetId)) {
          switchSubTab(targetId);
          return true;
        }

        const target = document.getElementById(targetId);
        if (!target) return false;

        const panel = target.closest('.tips-panel') as HTMLElement | null;
        if (panel?.id?.startsWith('subtab-')) {
          const subtabId = panel.id.replace('subtab-', '');
          if (subtabId) switchSubTab(subtabId);
        }

        target.scrollIntoView({ block: 'start' });
        return true;
      }

      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
        if (!a) return;
        const href = a.getAttribute('href');
        if (!href) return;
        const targetId = decodeURIComponent(href.replace('#', ''));
        if (!targetId) return;
        if (!document.getElementById(targetId)) return;
        e.preventDefault();
        history.replaceState(null, '', '#' + targetId);
        showForTargetId(targetId);
      });

      const subTabs = document.querySelectorAll('.tips-subnav-btn');
      const subPanels = document.querySelectorAll('.tips-panel');

      function switchSubTab(subtabId: string) {
        subTabs.forEach(t => {
          const isActive = (t as HTMLElement).dataset.subtab === subtabId;
          (t as HTMLElement).classList.toggle('is-active', isActive);
          (t as HTMLElement).setAttribute('aria-selected', String(isActive));
          (t as HTMLElement).setAttribute('tabindex', isActive ? '0' : '-1');
        });
        subPanels.forEach(p => {
          const shouldShow = (p as HTMLElement).id === 'subtab-' + subtabId;
          (p as HTMLElement).classList.toggle('is-active', shouldShow);
          (p as HTMLElement).toggleAttribute('hidden', !shouldShow);
        });
      }

      subTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const id = (tab as HTMLElement).dataset.subtab;
          if (id) switchSubTab(id);
        });
      });

      setupRovingTabs(subTabs, (el) => (el as HTMLElement).dataset.subtab, (id) => switchSubTab(id));
      showForTargetId(getHashId());
      window.addEventListener('hashchange', () => showForTargetId(getHashId()));

      function setupJumpbars() {
        const jumpbars = document.querySelectorAll('.tips-jumpbar');
        jumpbars.forEach((jumpbar) => {
          const links = Array.from(jumpbar.querySelectorAll('a[href^="#"]')) as HTMLAnchorElement[];
          const targets = links
            .map((a) => decodeURIComponent((a.getAttribute('href') || '').replace('#', '')))
            .map((id) => ({ id, el: id ? document.getElementById(id) : null }))
            .filter((t) => t.el);

          if (!targets.length) return;

          const panel = (jumpbar as HTMLElement).closest('.tips-panel');
          let activeId: string | null = null;

          function setActive(id: string) {
            if (activeId === id) return;
            activeId = id;
            links.forEach((a) => {
              const linkId = decodeURIComponent((a.getAttribute('href') || '').replace('#', ''));
              a.classList.toggle('is-active', linkId === id);
            });
          }

          const observer = new IntersectionObserver((entries) => {
            if (panel && !panel.classList.contains('is-active')) return;
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => (a.boundingClientRect.top - b.boundingClientRect.top));
            const best = visible[0]?.target as HTMLElement | undefined;
            if (best?.id) setActive(best.id);
          }, { root: null, rootMargin: '-20% 0px -75% 0px', threshold: [0, 0.1, 0.25] });

          targets.forEach((t) => observer.observe(t.el as Element));
          const initial = targets.find((t) => t.id === getHashId())?.id || targets[0].id;
          if (initial) setActive(initial);
        });
      }

      setupJumpbars();
    </script>
  </div>
</Base>
