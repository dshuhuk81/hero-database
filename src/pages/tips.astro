  <script>
    // - TAB SWITCHING
    const mainTabs = document.querySelectorAll('.main-tab');
    const mainPanels = document.querySelectorAll('.main-tab-panel');

    function switchMainTab(tabId: string) {
      mainTabs.forEach(t => (t as HTMLElement).classList.toggle('is-active', (t as HTMLElement).dataset.tab === tabId));
      mainPanels.forEach(p => { (p as HTMLElement).style.display = (p as HTMLElement).id === 'tab-' + tabId ? '' : 'none'; });
      history.replaceState(null, '', '#' + tabId);
    }

    mainTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = (tab as HTMLElement).dataset.tab;
        if (id) switchMainTab(id);
      });
    });

    // Handle URL hash on load
    const outerHash = (location.hash || '').replace('#', '');
    const validOuter = ['beginner', 'shrine'];
    if (outerHash && validOuter.includes(outerHash)) switchMainTab(outerHash);

    // - SHRINE SPARKS ANIMATION
    function initializeSparkles() {
      const canvases = document.querySelectorAll('.shrine-spark-canvas');
      canvases.forEach((canvas: any) => {
        const ctx = canvas.getContext('2d');
        function resize() { canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight; }
        resize();
        function spawnSpark() {
          const w = canvas.width, h = canvas.height;
          return {
            x: w * 0.35 + Math.random() * (w * 0.3),
            y: h * 0.55 + Math.random() * (h * 0.4),
            vx: (Math.random() - 0.5) * 0.6,
            vy: -(0.6 + Math.random() * 1.4),
            size: 1.2 + Math.random() * 3.5,
            alpha: 0, life: 0,
            lifeSpeed: 0.004 + Math.random() * 0.006,
            twinkle: Math.random() * Math.PI * 2,
            color: `hsl(${200 + Math.random() * 40}, 100%, ${75 + Math.random() * 25}%)`,
          };
        }
        const sparks: any[] = [];
        for (let i = 0; i < 60; i++) { const s = spawnSpark(); (s as any).life = Math.random(); sparks.push(s); }
        function drawStar(x: number, y: number, size: number, alpha: number, color: string, twinkle: number, time: number) {
          const shimmer = 0.7 + 0.3 * Math.sin(time * 6 + twinkle);
          const a = alpha * shimmer;
          if (a <= 0) return;
          ctx.save(); ctx.globalAlpha = a; ctx.translate(x, y);
          const glow = ctx.createRadialGradient(0,0,0,0,0,size*5);
          glow.addColorStop(0,'rgba(120,220,255,0.35)'); glow.addColorStop(1,'rgba(30,100,255,0)');
          ctx.fillStyle = glow; ctx.beginPath(); ctx.arc(0,0,size*5,0,Math.PI*2); ctx.fill();
          const long = size*4.5, short_ = size*2.5, thin = size*0.25;
          function drawBeam(angle: number, len: number) {
            ctx.save(); ctx.rotate(angle);
            const grad = ctx.createLinearGradient(-len,0,len,0);
            grad.addColorStop(0,'rgba(255,255,255,0)'); grad.addColorStop(0.5,color); grad.addColorStop(1,'rgba(255,255,255,0)');
            ctx.fillStyle = grad; ctx.beginPath(); ctx.ellipse(0,0,len,thin,0,0,Math.PI*2); ctx.fill(); ctx.restore();
          }
          drawBeam(0,long); drawBeam(Math.PI/2,long); drawBeam(Math.PI/4,short_); drawBeam(-Math.PI/4,short_);
          const core = ctx.createRadialGradient(0,0,0,0,0,size);
          core.addColorStop(0,'white'); core.addColorStop(1,'rgba(120,220,255,0)');
          ctx.fillStyle = core; ctx.beginPath(); ctx.arc(0,0,size,0,Math.PI*2); ctx.fill(); ctx.restore();
        }
        let t = 0;
        function tick() {
          ctx.clearRect(0,0,canvas.width,canvas.height); t += 0.016;
          for (const s of sparks) {
            s.life += s.lifeSpeed;
            s.alpha = s.life < 0.2 ? s.life/0.2 : s.life < 0.75 ? 1 : 1-(s.life-0.75)/0.25;
            s.alpha = Math.max(0, Math.min(1, s.alpha));
            s.x += s.vx + Math.sin(t*1.5+s.twinkle)*0.15; s.y += s.vy;
            drawStar(s.x, s.y, s.size, s.alpha, s.color, s.twinkle, t);
            if (s.life >= 1) Object.assign(s, spawnSpark());
          }
          requestAnimationFrame(tick);
        }
        tick();
      });
    }

    // Initialize sparkles when shrine tab is shown
    document.querySelectorAll('.main-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        if ((tab as HTMLElement).dataset.tab === 'shrine') {
          setTimeout(initializeSparkles, 50);
        }
      });
    });

  </script>
</Base>

