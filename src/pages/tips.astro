---
export const prerender = true;
import Base from "../layouts/Base.astro";
import { defaultLocale, localizePath, type Locale } from "../i18n/config";
import { pickLang, type LocalizedString } from "../i18n/helpers";
import { t } from "../i18n/ui";
import { navEntries } from "../data/nav";
import "../styles/tips.css";

interface Props { locale?: Locale; }
const { locale = defaultLocale } = Astro.props as Props;
const pick = (value: LocalizedString) => pickLang(value, locale);
const link = (path: string) => localizePath(path, locale);

const copy = {
  eyebrow: { en: "Beginner guide", de: "Einsteiger-Guide" },
  title: { en: "Start strong. Waste less.", de: "Stark starten. Weniger verschwenden." },
  intro: { en: "A practical route through your first weeks: what to build, what to save, and what to change when progress stops.", de: "Ein klarer Weg durch deine ersten Wochen: Was du ausbaust, was du sparst und was du änderst, wenn der Fortschritt stoppt." },
  checked: { en: "Advice reviewed", de: "Empfehlungen geprüft" },
  startCta: { en: "Start checklist", de: "Zur Start-Checkliste" },
  stuckCta: { en: "I am stuck", de: "Ich stecke fest" },
  rulesLabel: { en: "The five rules", de: "Die fünf Regeln" },
  checklistLabel: { en: "Your route", de: "Dein Fahrplan" },
  checklistTitle: { en: "Do these things first", de: "Das solltest du zuerst tun" },
  checklistIntro: { en: "Progress in order. You do not need to optimize every system on day one.", de: "Gehe der Reihe nach vor. Du musst nicht jedes System am ersten Tag optimieren." },
  now: { en: "Right now", de: "Sofort" }, unlocked: { en: "As they unlock", de: "Sobald freigeschaltet" }, later: { en: "Leave for later", de: "Später angehen" },
  teamLabel: { en: "First team", de: "Erstes Team" },
  teamTitle: { en: "Build functions, not five tier-list ranks", de: "Baue Funktionen, nicht fünf Tier-List-Plätze" },
  teamIntro: { en: "One supported carry usually progresses faster than five heroes competing for the same resources.", de: "Ein gut unterstützter Carry bringt dich meist weiter als fünf Helden, die um dieselben Ressourcen konkurrieren." },
  pullRuleTitle: { en: "Use what you pull", de: "Spiele mit dem, was du ziehst" },
  pullRuleBody: { en: "Meta heroes are goals, not entry requirements. Hladgunnr and Isis can carry early chapters. Use them, but keep rare long-term resources flexible.", de: "Meta-Helden sind Ziele, keine Eintrittskarte. Hladgunnr und Isis können frühe Kapitel tragen. Nutze sie, aber halte seltene Langzeitressourcen flexibel." },
  tierCta: { en: "Compare heroes", de: "Helden vergleichen" }, wishlistCta: { en: "Open Wishlist", de: "Wishlist öffnen" },
  investLabel: { en: "Resources", de: "Ressourcen" }, investTitle: { en: "Invest without regret", de: "Investieren ohne Reue" },
  investIntro: { en: "Early power comes from concentration. Put replaceable resources into progress and protect the scarce ones.", de: "Frühe Stärke entsteht durch Fokus. Nutze ersetzbare Ressourcen für Fortschritt und schütze die seltenen." },
  doTitle: { en: "Do", de: "Tun" }, avoidTitle: { en: "Avoid", de: "Vermeiden" },
  relicTitle: { en: "Build relic power in the right order", de: "Reliktstärke in der richtigen Reihenfolge aufbauen" },
  relicIntro: { en: "Carries to R20 → supports to R10 → your main carry to R30", de: "Carries auf R20 → Supports auf R10 → deinen Haupt-Carry auf R30" },
  relicTargets: { en: "Strong first Relic 20 targets", de: "Starke erste Relikt-20-Ziele" },
  eventsLabel: { en: "Weekly selection events", de: "Wöchentliche Auswahl-Events" },
  eventsTitle: { en: "Single pulls protect your best reward", de: "Einzelzüge schützen deine beste Belohnung" },
  eventsBody: { en: "Select the red relic elixirs (Apotheosis Elixir), pull one at a time, and stop when you get the target. Ten-pulls spend attempts clearing rewards you do not need.", de: "Wähle die roten Relikt-Elixiere (Apotheosis Elixir), ziehe einzeln und stoppe nach dem Ziel. 10er-Züge verbrauchen Versuche für Belohnungen, die du nicht brauchst." },
  eventsExamples: { en: "Examples: Votive Festival · Golden Arcanum · Benevolent Feast", de: "Beispiele: Votive Festival · Golden Arcanum · Benevolent Feast" },
  summonsLabel: { en: "Summons", de: "Beschwörungen" }, summonsTitle: { en: "Wishlist in 60 seconds", de: "Wishlist in 60 Sekunden" },
  summonsIntro: { en: "Build toward these heroes, but do not wait for a perfect account before playing.", de: "Arbeite auf diese Helden hin, aber warte nicht auf den perfekten Account, bevor du spielst." },
  carries: { en: "Carry core", de: "Carry-Kern" }, supports: { en: "Support core", de: "Support-Kern" }, situational: { en: "Useful context", de: "Wichtiger Kontext" },
  summonRule1: { en: "Fill the Wishlist as soon as it unlocks.", de: "Fülle die Wishlist, sobald sie freigeschaltet wird." },
  summonRule2: { en: "Stabilize your core before starting another project.", de: "Stabilisiere deinen Kern, bevor du ein neues Projekt beginnst." },
  summonRule3: { en: "Rate-up does not automatically mean must-pull.", de: "Rate-up bedeutet nicht automatisch Must-pull." },
  poseidon: { en: "Especially useful at Relic 10.", de: "Besonders mit Relikt 10 interessant." },
  caishen: { en: "Excellent, but early events and shops can supply him.", de: "Stark, kann aber früh über Events und Shops kommen." },
  calendarCta: { en: "Hero roadmap", de: "Hero Roadmap" }, calculatorCta: { en: "Summon calculator", de: "Summon Calculator" },
  stuckLabel: { en: "Troubleshooting", de: "Problemlösung" }, stuckTitle: { en: "Stuck? Diagnose before spending", de: "Festgefahren? Erst prüfen, dann investieren" },
  stuckIntro: { en: "Most walls are solved by one focused change, not by upgrading everything.", de: "Die meisten Hürden löst eine gezielte Änderung – nicht das Aufwerten von allem." },
  problem: { en: "What happens", de: "Was passiert" }, check: { en: "Check first", de: "Zuerst prüfen" },
  stuckRule: { en: "Change formation or one support slot first. Spend resources only after you understand the failure.", de: "Ändere zuerst die Formation oder einen Support-Slot. Investiere erst, wenn du die Ursache verstanden hast." },
  combatLabel: { en: "Combat", de: "Kampf" }, combatTitle: { en: "Three mechanics that change decisions", de: "Drei Mechaniken, die Entscheidungen verändern" },
  combatIntro: { en: "You do not need an encyclopedia. These three ideas win fights.", de: "Du brauchst kein Lexikon. Diese drei Ideen entscheiden Kämpfe." },
  accountLabel: { en: "Account choices", de: "Account-Entscheidungen" }, accountTitle: { en: "Two choices, no guesswork", de: "Zwei Entscheidungen, kein Rätselraten" },
  cancerTitle: { en: "Choose Cancer", de: "Wähle Cancer" }, cancerBody: { en: "Cancer is the default Destined Zodiac recommendation for a new account.", de: "Cancer ist die klare Destined-Zodiac-Empfehlung für einen neuen Account." },
  mindseaTitle: { en: "Join an active Mindsea", de: "Tritt einer aktiven Mindsea bei" }, mindseaBody: { en: "Prioritize Zeus copies in the shop. A first Dionysus copy is also a good pickup.", de: "Priorisiere Zeus-Kopien im Shop. Eine erste Dionysus-Kopie ist ebenfalls sinnvoll." },
  nextLabel: { en: "Keep going", de: "Weiter geht’s" }, nextTitle: { en: "Use the right guide for the next decision", de: "Nutze den passenden Guide für die nächste Entscheidung" },
  nextIntro: { en: "The beginner route ends here. These pages handle the details without bloating this guide.", de: "Der Einsteigerpfad endet hier. Diese Seiten erklären die Details, ohne diesen Guide aufzublähen." },
  openGuide: { en: "Open guide", de: "Guide öffnen" }, navStart: { en: "Start", de: "Start" }, navTeam: { en: "Team", de: "Team" }, navInvest: { en: "Invest", de: "Investieren" }, navSummons: { en: "Wishlist", de: "Wishlist" }, navStuck: { en: "Stuck?", de: "Festgefahren?" }, navCombat: { en: "Combat", de: "Kampf" },
} satisfies Record<string, LocalizedString>;

const rules = [
  [{ en: "Push Odyssey", de: "Odyssey vorantreiben" }, { en: "Advance until the game stops you. It unlocks the systems that make the account stronger.", de: "Spiele weiter, bis das Spiel dich stoppt. So schaltest du die Systeme frei, die deinen Account stärken." }, "#start"],
  [{ en: "Build one core", de: "Einen Kern bauen" }, { en: "Start with one functional team and one or two damage dealers.", de: "Beginne mit einem funktionierenden Team und ein bis zwei Damage Dealern." }, "#team"],
  [{ en: "Level only five", de: "Nur fünf leveln" }, { en: "Your Resonating Altar shares the fifth hero's level with the rest.", de: "Der Resonating Altar überträgt das Level des fünften Helden auf den Rest." }, "#invest"],
  [{ en: "Set the Wishlist", de: "Wishlist setzen" }, { en: "Fill it early and pull with a plan instead of chasing every banner.", de: "Fülle sie früh und beschwöre mit Plan, statt jedem Banner zu folgen." }, "#summons"],
  [{ en: "Fund damage first", de: "Schaden zuerst" }, { en: "Relics are a major power source. Concentrate rare materials on your carries first.", de: "Relikte sind eine zentrale Stärkequelle. Konzentriere seltene Materialien zuerst auf deine Carries." }, "#relics"],
] as const;

const checklist = [
  { tone: "now", number: "01", title: copy.now, items: [{ en: "Finish the tutorial and claim mail and launch rewards.", de: "Schließe das Tutorial ab und hole Post- sowie Startbelohnungen ab." }, { en: "Push Odyssey until you are blocked.", de: "Treibe Odyssey voran, bis du festhängst." }, { en: "Check the official community for active codes.", de: "Prüfe die offizielle Community auf aktive Codes." }] },
  { tone: "soon", number: "02", title: copy.unlocked, items: [{ en: "Fill the Wishlist and choose Cancer as your Zodiac.", de: "Fülle die Wishlist und wähle Cancer als Zodiac." }, { en: "Join an active Mindsea and use the Resonating Altar.", de: "Tritt einer aktiven Mindsea bei und nutze den Resonating Altar." }, { en: "Complete the weekly Torment Rift.", de: "Schließe den wöchentlichen Torment Rift ab." }] },
  { tone: "later", number: "03", title: copy.later, items: [{ en: "Multiple full teams and competitive PvP.", de: "Mehrere vollständige Teams und kompetitives PvP." }, { en: "Artifact ascension — level them, but save ascension for later.", de: "Artifact-Ascension – leveln ja, Ascension später." }, { en: "Spending rare materials without a defined target.", de: "Seltene Materialien ohne klares Ziel ausgeben." }] },
];

const roles = [
  ["DPS", { en: "Main carry", de: "Haupt-Carry" }, { en: "Primary damage and first investment target.", de: "Hauptschaden und erstes Investitionsziel." }, "carry"],
  ["FRONT", { en: "Frontliner", de: "Frontliner" }, { en: "Absorbs pressure or controls the opening.", de: "Fängt Druck ab oder kontrolliert den Kampfbeginn." }, "front"],
  ["SUSTAIN", { en: "Sustain", de: "Sustain" }, { en: "Healing, shields or damage reduction.", de: "Heilung, Schilde oder Schadensreduktion." }, "sustain"],
  ["TEMPO", { en: "Tempo / control", de: "Tempo / Control" }, { en: "Energy, buffs, debuffs or crowd control.", de: "Energie, Buffs, Debuffs oder Crowd Control." }, "tempo"],
  ["FLEX", { en: "Flex slot", de: "Flex-Slot" }, { en: "Second DPS or answer to the current mode.", de: "Zweiter DPS oder Antwort auf den aktuellen Modus." }, "flex"],
] as const;

const doItems: LocalizedString[] = [{ en: "Level five heroes; synchronize the rest through the Altar.", de: "Levele fünf Helden; synchronisiere den Rest über den Altar." }, { en: "Raise one or two damage dealers high enough to unlock relics.", de: "Bringe ein bis zwei Damage Dealer hoch genug für den Reliktzugang." }, { en: "Keep currency in reserve for future core heroes.", de: "Halte Währung für zukünftige Kernhelden zurück." }, { en: "Test new heroes before committing rare materials.", de: "Teste neue Helden, bevor du seltene Materialien bindest." }];
const avoidItems: LocalizedString[] = [{ en: "Spreading levels, gear and copies across every hero.", de: "Level, Ausrüstung und Kopien auf alle Helden verteilen." }, { en: "Using valuable named-hero copies as fodder too early.", de: "Wertvolle Named-Hero-Kopien zu früh als Fodder verwenden." }, { en: "Splitting red relic materials evenly across the roster.", de: "Rote Reliktmaterialien gleichmäßig im Roster verteilen." }, { en: "Treating popularity as a universal tier list.", de: "Popularity als allgemeingültige Tier List behandeln." }];
const relicSteps = [["R20", { en: "Carries first", de: "Carries zuerst" }, { en: "Bring the damage core to its first major breakpoint.", de: "Bringe deinen Schadenskern an den ersten großen Breakpoint." }], ["R10", { en: "Enable supports", de: "Supports aktivieren" }, { en: "Unlock effects that accelerate or protect the carry.", de: "Aktiviere Effekte, die deinen Carry beschleunigen oder schützen." }], ["R30", { en: "Finish the carry", de: "Carry abschließen" }, { en: "Then push the most important carry to the premium breakpoint.", de: "Danach geht dein wichtigster Carry an den Premium-Breakpoint." }]] as const;

const heroBase = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/thumbs";
const carries = ["xuannv", "nut", "skadi", "zaojun", "bastet"];
const supports = ["hephaestus", "yuelao", "mengpo", "meret"];
const displayName: Record<string, string> = { xuannv: "Xuannv", nut: "Nut", skadi: "Skadi", zaojun: "Zaojun", bastet: "Bastet", hephaestus: "Hephaestus", yuelao: "Yuelao", mengpo: "Mengpo", meret: "Meret" };

const problems = [
  ["01", { en: "Frontline dies instantly", de: "Frontline stirbt sofort" }, { en: "Formation, tank or sustain, enemy opening burst", de: "Formation, Tank oder Sustain, gegnerischer Burst" }],
  ["02", { en: "The timer runs out", de: "Die Zeit läuft ab" }, { en: "Carry investment, energy support, automatic ultimate cycle", de: "Carry-Investment, Energie-Support, automatischer Ultimate-Zyklus" }],
  ["03", { en: "Backline gets deleted", de: "Backline wird gelöscht" }, { en: "Swap positions and control the diver or assassin", de: "Positionen tauschen und Diver oder Assassin kontrollieren" }],
  ["04", { en: "Enemy heals too much", de: "Gegner heilt zu viel" }, { en: "Burst window, heal reduction or target priority", de: "Burst-Fenster, Heal Reduction oder Zielpriorität" }],
  ["05", { en: "Power is far too low", de: "Kampfkraft ist deutlich zu niedrig" }, { en: "AFK resources, Altar and account-wide upgrades", de: "AFK-Ressourcen, Altar und accountweite Upgrades" }],
  ["06", { en: "Only one mode fails", de: "Nur ein Modus klappt nicht" }, { en: "Use a mode-specific team instead of forcing one lineup", de: "Modusspezifisches Team statt eine Aufstellung zu erzwingen" }],
] as const;
const mechanics = [["01", { en: "Front and back", de: "Front und Back" }, { en: "Put durable heroes in the path of the first hit. Protect the carry from dives and line attacks.", de: "Stelle robuste Helden in den ersten Treffer. Schütze den Carry vor Dives und Linienangriffen." }], ["02", { en: "Energy and control", de: "Energie und Control" }, { en: "A faster, well-timed ultimate can matter more than another small stat increase.", de: "Eine schnellere, gut getimte Ultimate kann wichtiger sein als ein kleiner weiterer Stat-Bonus." }], ["03", { en: "Faction context", de: "Fraktions-Kontext" }, { en: "Use faction synergy when it fits, but do not sacrifice essential roles just for a bonus.", de: "Nutze Fraktionssynergie, wenn sie passt, aber opfere dafür keine wichtige Rolle." }]] as const;
const nextGuides = [["/hero-evolution", { en: "Hero Evolution", de: "Hero Evolution" }, { en: "Copies and ascension steps", de: "Kopien und Aufstiegsstufen" }], ["/relic-investment", { en: "Relic Investment", de: "Relikt-Investition" }, { en: "Breakpoints by hero", de: "Breakpoints je Held" }], ["/virtues", { en: "Virtues", de: "Virtues" }, { en: "Sets, grids and farming", de: "Sets, Grids und Farming" }], ["/totems", { en: "Totems", de: "Totems" }, { en: "Effects, tags and ratings", de: "Effekte, Tags und Bewertungen" }], ["/guides", { en: "All Guides", de: "Alle Guides" }, { en: "Heroes and game modes", de: "Helden und Spielmodi" }]] as const;
const guideIcons = Object.fromEntries(navEntries.map((entry) => [entry.href, entry.icon]));
---

<Base title={t(locale, "tips", "metaTitle")} description={t(locale, "tips", "metaDescription")} locale={locale}>
  <header class="tips-hero" id="top">
    <div class="tips-hero-glow" aria-hidden="true"></div>
    <div class="tips-hero-inner">
      <div class="tips-hero-copy">
        <p class="tips-kicker">{pick(copy.eyebrow)}</p><h1>{pick(copy.title)}</h1><p class="tips-hero-intro">{pick(copy.intro)}</p>
        <div class="tips-hero-actions"><a class="action-button action-button--primary" href="#start">{pick(copy.startCta)} <span aria-hidden="true">↓</span></a><a class="action-button action-button--quiet" href="#stuck">{pick(copy.stuckCta)} <span aria-hidden="true">→</span></a></div>
        <p class="tips-reviewed"><span aria-hidden="true"></span>{pick(copy.checked)} · 17.09.2026</p>
      </div>
      <div class="tips-hero-route" aria-label={pick(copy.rulesLabel)}>
        {rules.map((rule, index) => <a class="tips-route-item" href={rule[2]}><span class="tips-route-number">0{index + 1}</span><span class="tips-route-copy"><strong>{pick(rule[0])}</strong><span>{pick(rule[1])}</span></span></a>)}
      </div>
    </div>
  </header>

  <nav class="tips-anchor-nav" aria-label={pick(copy.rulesLabel)}><div class="tips-anchor-nav-inner"><a href="#start">{pick(copy.navStart)}</a><a href="#team">{pick(copy.navTeam)}</a><a href="#invest">{pick(copy.navInvest)}</a><a href="#summons">{pick(copy.navSummons)}</a><a href="#stuck">{pick(copy.navStuck)}</a><a href="#combat">{pick(copy.navCombat)}</a></div></nav>

  <main class="tips-onepage">
    <section class="tips-section" id="start" aria-labelledby="start-title">
      <header class="tips-section-heading"><p>{pick(copy.checklistLabel)}</p><h2 id="start-title">{pick(copy.checklistTitle)}</h2><span>{pick(copy.checklistIntro)}</span></header>
      <div class="tips-roadmap">{checklist.map((phase) => <article class:list={["tips-roadmap-step", `is-${phase.tone}`]}><div class="tips-roadmap-marker"><span>{phase.number}</span></div><div class="tips-roadmap-body"><h3>{pick(phase.title)}</h3><ul>{phase.items.map((item) => <li>{pick(item)}</li>)}</ul></div></article>)}</div>
    </section>

    <section class="tips-section tips-section--wide" id="team" aria-labelledby="team-title">
      <header class="tips-section-heading"><p>{pick(copy.teamLabel)}</p><h2 id="team-title">{pick(copy.teamTitle)}</h2><span>{pick(copy.teamIntro)}</span></header>
      <div class="tips-formation" aria-label={pick(copy.teamTitle)}><div class="tips-field-label tips-field-label--front">FRONT</div><div class="tips-field-label tips-field-label--back">BACK</div>{roles.map((role, index) => <article class:list={["tips-role", `tips-role--${role[3]}`]} style={`--role-index:${index}`}><span class="tips-role-symbol" aria-hidden="true">{role[0]}</span><div><h3>{pick(role[1])}</h3><p>{pick(role[2])}</p></div></article>)}</div>
      <div class="tips-insight-row"><div class="tips-insight-icon" aria-hidden="true">↻</div><div><strong>{pick(copy.pullRuleTitle)}</strong><p>{pick(copy.pullRuleBody)}</p></div><div class="tips-inline-actions"><a href={link("/tierlist")}>{pick(copy.tierCta)} →</a><a href={link("/wishlisht")}>{pick(copy.wishlistCta)} →</a></div></div>
    </section>

    <section class="tips-section" id="invest" aria-labelledby="invest-title">
      <header class="tips-section-heading"><p>{pick(copy.investLabel)}</p><h2 id="invest-title">{pick(copy.investTitle)}</h2><span>{pick(copy.investIntro)}</span></header>
      <div class="tips-do-dont"><article class="tips-list-panel tips-list-panel--do"><h3><span aria-hidden="true">✓</span>{pick(copy.doTitle)}</h3><ul>{doItems.map((item) => <li>{pick(item)}</li>)}</ul></article><article class="tips-list-panel tips-list-panel--avoid"><h3><span aria-hidden="true">×</span>{pick(copy.avoidTitle)}</h3><ul>{avoidItems.map((item) => <li>{pick(item)}</li>)}</ul></article></div>
      <div class="tips-relic-block" id="relics"><div class="tips-relic-heading"><div><h3>{pick(copy.relicTitle)}</h3><span>{pick(copy.relicIntro)}</span></div><a href={link("/relic-investment")}>{pick(copy.openGuide)} →</a></div><div class="tips-relic-path">{relicSteps.map((step, index) => <article class="tips-relic-step"><div class="tips-relic-level">{step[0]}</div><span class="tips-relic-index">0{index + 1}</span><h4>{pick(step[1])}</h4><p>{pick(step[2])}</p></article>)}</div><div class="tips-target-strip"><div><span>{pick(copy.relicTargets)}</span><strong>Bastet · Xuannv · Nut · Zaojun · Skadi</strong></div></div></div>
      <aside class="tips-event-tip" aria-labelledby="event-tip-title"><div class="tips-event-visual"><img class="tips-potion-image" src="/items/apotheosis-elixir.png" alt="" loading="lazy" /><span class="tips-pull-count" aria-hidden="true">×1</span></div><div class="tips-event-copy"><p>{pick(copy.eventsLabel)}</p><h3 id="event-tip-title">{pick(copy.eventsTitle)}</h3><span>{pick(copy.eventsBody)}</span><small>{pick(copy.eventsExamples)}</small></div><div class="tips-event-warning"><span aria-hidden="true">×10</span><strong>{pick(copy.avoidTitle)}</strong></div></aside>
    </section>

    <section class="tips-section tips-section--wide" id="summons" aria-labelledby="summons-title">
      <header class="tips-section-heading tips-section-heading--split"><div><p>{pick(copy.summonsLabel)}</p><h2 id="summons-title">{pick(copy.summonsTitle)}</h2><span>{pick(copy.summonsIntro)}</span></div><ul class="tips-mini-rules"><li>{pick(copy.summonRule1)}</li><li>{pick(copy.summonRule2)}</li><li>{pick(copy.summonRule3)}</li></ul></header>
      <div class="tips-wishlist-grid"><article class="tips-wishlist-group"><div class="tips-wishlist-group-title"><span>DPS</span><h3>{pick(copy.carries)}</h3></div><div class="tips-portrait-row">{carries.map((id) => <a class="tips-portrait" href={link(`/heroes/${id}`)}><img src={`${heroBase}/${id}-96.webp`} alt="" loading="lazy" /><span>{displayName[id]}</span></a>)}</div></article><article class="tips-wishlist-group"><div class="tips-wishlist-group-title"><span>SUP</span><h3>{pick(copy.supports)}</h3></div><div class="tips-portrait-row">{supports.map((id) => <a class="tips-portrait" href={link(`/heroes/${id}`)}><img src={`${heroBase}/${id}-96.webp`} alt="" loading="lazy" /><span>{displayName[id]}</span></a>)}</div></article><article class="tips-wishlist-context"><h3>{pick(copy.situational)}</h3><p><strong>Poseidon R10</strong> — {pick(copy.poseidon)}</p><p><strong>Caishen</strong> — {pick(copy.caishen)}</p></article></div>
      <div class="tips-tool-links"><a href={link("/wishlisht")}><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={guideIcons["/wishlisht"]}></svg></span><strong>{pick(copy.wishlistCta)}</strong><small>{pick(copy.openGuide)} →</small></a><a href={link("/summon-calendar")}><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={guideIcons["/summon-calendar"]}></svg></span><strong>{pick(copy.calendarCta)}</strong><small>{pick(copy.openGuide)} →</small></a><a href={link("/summon-calculator")}><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={guideIcons["/summon-calculator"]}></svg></span><strong>{pick(copy.calculatorCta)}</strong><small>{pick(copy.openGuide)} →</small></a></div>
    </section>

