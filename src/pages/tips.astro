---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import shrineSetups from "../data/shrineSetups.json";
const visibleSetups = ["Setup B"];
const shrineSetupGroups = shrineSetups.filter((setup: any) => visibleSetups.includes(setup.label));
---

<Base title="Tips | Motto Immortal">

  <PageHero
    tag="Tips"
    headline="Tips"
    subtitle="Beginner tips and shrine system breakdowns"
  />
<div class="page-wrapper">
  <!-- TAB BAR -->
  <div class="main-tabs">
    <button class="main-tab is-active" data-tab="beginner">Beginner</button>
    <button class="main-tab" data-tab="shrine">Shrine</button>
  </div>

  <!-- ====================================================
       TAB: BEGINNER (default)
       ==================================================== -->
  <div id="tab-beginner" class="main-tab-panel">
    <main class="eg-main-content">

      <!-- F2P NOTE -->
      <div class="eg-content-card eg-note-card">
        <p>
          This guide is written from a <strong>F2P and low-spender perspective</strong>.
          If you are a whale or have heavily starred heroes, you can replace
          the suggested heroes below with your own star picks.
        </p>
      </div>

      <!-- GAME PHASES -->
      <div class="eg-content-card">
        <h2>What Phase Are You In?</h2>
        <p>Know your phase so you invest resources in the right place:</p>
        <div class="phase-grid">
          <div class="phase-card phase-early">
            <div class="phase-label">Early</div>
            <div class="phase-desc">1 team - focus on building one strong core before spreading resources.</div>
          </div>
          <div class="phase-card phase-mid">
            <div class="phase-label">Mid</div>
            <div class="phase-desc">2 to 3 teams - start specializing for PvE bosses, Odyssey, and PvP.</div>
          </div>
          <div class="phase-card phase-late">
            <div class="phase-label">Late</div>
            <div class="phase-desc">4 to 5 teams - optimized rosters, relic breakpoints, and event-driven upgrades.</div>
          </div>
        </div>
        <div class="eg-team-example">
          <p><strong>Key idea:</strong> Build a strong PvE core first. PvE unlocks the resources that make everything else easier.</p>
        </div>
      </div>

      <!-- EARLY GAME PRIORITIES -->
      <div class="eg-content-card">
        <h2>Early Game Priorities</h2>
        <h3>1 - Push Odyssey (Campaign) for Undying Flame</h3>
        <p><strong>Undying Flame</strong> is the most important early progression item - it upgrades your Shrine, which increases long-term account power and farming efficiency.</p>
        <h3>2 - Compete in Torment Rift for Calamity Tier</h3>
        <p><strong>Calamity Tier</strong> rewards upgrade your <strong>Beacon Tree</strong>, granting account-wide stat bonuses to all heroes. Beacon bonuses apply in every game mode and never become wasted investment.</p>
        <h3>3 - Focus Gear on Your Top Two DPS</h3>
        <p>Put your best gear on your two primary damage dealers first. Spreading gear evenly across six heroes is one of the most common early mistakes.</p>
      </div>

      <!-- STAR HEROES -->
      <div class="eg-content-card">
        <h2>Star Heroes - Who to Prioritize at 1 Copy?</h2>
        <p>Some legendary heroes deliver immediate value at base copy (no extra copies needed), while others need heavy duplication investment before they contribute meaningfully.</p>
        <div class="star-split">
          <div class="star-box star-good">
            <div class="star-box-title">Good at Base Copy</div>
            <p class="star-box-note">Provide immediate value and do not require extra copies to contribute.</p>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/nuwa">
                <div class="hero-pic-img" style="background-image:url('/heroes/nuwa.webp')"></div>
                <span class="hero-pic-name">Nuwa</span>
              </a>
              <a class="hero-pic" href="/heroes/amunra">
                <div class="hero-pic-img" style="background-image:url('/heroes/amunra.webp')"></div>
                <span class="hero-pic-name">Amun Ra</span>
              </a>
              <a class="hero-pic" href="/heroes/nyx">
                <div class="hero-pic-img" style="background-image:url('/heroes/nyx.webp')"></div>
                <span class="hero-pic-name">Nyx</span>
              </a>
              <a class="hero-pic" href="/heroes/dionysus">
                <div class="hero-pic-img" style="background-image:url('/heroes/dionysus.webp')"></div>
                <span class="hero-pic-name">Dionysus</span>
              </a>
              <a class="hero-pic" href="/heroes/cronus">
                <div class="hero-pic-img" style="background-image:url('/heroes/cronus.webp')"></div>
                <span class="hero-pic-name">Chronos</span>
              </a>
            </div>
          </div>
          <div class="star-box star-invest">
            <div class="star-box-title">Need Heavy Investment</div>
            <p class="star-box-note">Hold off until you have the resources to fully build them.</p>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/zeus">
                <div class="hero-pic-img" style="background-image:url('/heroes/zeus.webp')"></div>
                <span class="hero-pic-name">Zeus</span>
              </a>
              <a class="hero-pic" href="/heroes/nezha">
                <div class="hero-pic-img" style="background-image:url('/heroes/nezha.webp')"></div>
                <span class="hero-pic-name">Nezha</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- FRONTLINERS -->
      <div class="eg-content-card" id="frontliners">
        <h2>Frontliners to Build First</h2>
        <p>Frontliners are usually Tank and Warrior class heroes. Some Supports like Caishen and Mengpo can also serve as frontliners depending on your comp.</p>
        <h3>Core Frontliners</h3>
        <div class="hero-pic-grid">
          <a class="hero-pic pic-highlight" href="/heroes/heracles">
            <div class="hero-pic-img" style="background-image:url('/heroes/heracles.webp')"></div>
            <span class="hero-pic-name">Heracles</span>
          </a>
          <a class="hero-pic pic-highlight" href="/heroes/poseidon">
            <div class="hero-pic-img" style="background-image:url('/heroes/poseidon.webp')"></div>
            <span class="hero-pic-name">Poseidon</span>
          </a>
          <a class="hero-pic pic-highlight" href="/heroes/momus">
            <div class="hero-pic-img" style="background-image:url('/heroes/momus.webp')"></div>
            <span class="hero-pic-name">Momus</span>
          </a>
        </div>
        <h3>Strong Frontliners</h3>
        <div class="hero-pic-grid">
          <a class="hero-pic" href="/heroes/hladgunnr">
            <div class="hero-pic-img" style="background-image:url('/heroes/hladgunnr.webp')"></div>
            <span class="hero-pic-name">Hladgunnr</span>
          </a>
          <a class="hero-pic" href="/heroes/nuba">
            <div class="hero-pic-img" style="background-image:url('/heroes/nuba.webp')"></div>
            <span class="hero-pic-name">Nuba</span>
          </a>
          <a class="hero-pic" href="/heroes/bastet">
            <div class="hero-pic-img" style="background-image:url('/heroes/bastet.webp')"></div>
            <span class="hero-pic-name">Bastet</span>
          </a>
          <a class="hero-pic" href="/heroes/khepri">
            <div class="hero-pic-img" style="background-image:url('/heroes/khepri.webp')"></div>
            <span class="hero-pic-name">Khepri</span>
          </a>
          <a class="hero-pic" href="/heroes/set">
            <div class="hero-pic-img" style="background-image:url('/heroes/set.webp')"></div>
            <span class="hero-pic-name">Set</span>
          </a>
        </div>
        <h3>Situational Frontliners</h3>
        <div class="hero-pic-grid">
          <a class="hero-pic" href="/heroes/prometheus">
            <div class="hero-pic-img" style="background-image:url('/heroes/prometheus.webp')"></div>
            <span class="hero-pic-name">Prometheus</span>
          </a>
          <a class="hero-pic" href="/heroes/jormungandr">
            <div class="hero-pic-img" style="background-image:url('/heroes/jormungandr.webp')"></div>
            <span class="hero-pic-name">Jormungandr</span>
          </a>
        </div>
        <div class="eg-team-example">
          <p>Warrior heroes like Nezha and Hladgunnr can also function as damage dealers depending on your team composition.</p>
        </div>
      </div>

      <!-- DAMAGE DEALERS -->
      <div class="eg-content-card" id="damage-dealers">
        <h2>Damage Dealers to Build First</h2>
        <p>Damage dealers (DDs) are usually Archer, Assassin, and Mage class heroes. Warriors like Nezha and Hladgunnr can also fill the DD role.</p>
        <div class="phase-row-grid">
          <div class="phase-row">
            <div class="phase-row-label early-label">Early to Mid</div>
            <div class="hero-pic-grid">
              <a class="hero-pic pic-highlight" href="/heroes/isis">
                <div class="hero-pic-img" style="background-image:url('/heroes/isis.webp')"></div>
                <span class="hero-pic-name">Isis</span>
              </a>
              <a class="hero-pic pic-highlight" href="/heroes/fengyi">
                <div class="hero-pic-img" style="background-image:url('/heroes/fengyi.webp')"></div>
                <span class="hero-pic-name">Fengyi</span>
              </a>
              <a class="hero-pic pic-highlight" href="/heroes/nemesis">
                <div class="hero-pic-img" style="background-image:url('/heroes/nemesis.webp')"></div>
                <span class="hero-pic-name">Nemesis</span>
              </a>
            </div>
          </div>
          <div class="phase-row">
            <div class="phase-row-label late-label">Mid to Late</div>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/skadi">
                <div class="hero-pic-img" style="background-image:url('/heroes/skadi.webp')"></div>
                <span class="hero-pic-name">Skadi</span>
              </a>
              <a class="hero-pic" href="/heroes/hecate">
                <div class="hero-pic-img" style="background-image:url('/heroes/hecate.webp')"></div>
                <span class="hero-pic-name">Hecate</span>
              </a>
              <a class="hero-pic" href="/heroes/anubis">
                <div class="hero-pic-img" style="background-image:url('/heroes/anubis.webp')"></div>
                <span class="hero-pic-name">Anubis</span>
              </a>
              <a class="hero-pic" href="/heroes/bastet">
                <div class="hero-pic-img" style="background-image:url('/heroes/bastet.webp')"></div>
                <span class="hero-pic-name">Bastet</span>
              </a>
              <a class="hero-pic" href="/heroes/phoenix">
                <div class="hero-pic-img" style="background-image:url('/heroes/phoenix.webp')"></div>
                <span class="hero-pic-name">Phoenix</span>
              </a>
              <a class="hero-pic" href="/heroes/jingwei">
                <div class="hero-pic-img" style="background-image:url('/heroes/jingwei.webp')"></div>
                <span class="hero-pic-name">Jingwei</span>
              </a>
              <a class="hero-pic" href="/heroes/hela">
                <div class="hero-pic-img" style="background-image:url('/heroes/hela.webp')"></div>
                <span class="hero-pic-name">Hela</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- SUPPORT HEROES -->
      <div class="eg-content-card" id="supports">
        <h2>Support Heroes to Build First</h2>
        <p>Support heroes are usually the Support class, but heroes from other classes like Set and Diana can fill support roles effectively.</p>
        <div class="support-tiers">
          <div class="support-tier">
            <div class="support-tier-label">Priority 1</div>
            <div class="hero-pic-grid">
              <a class="hero-pic pic-highlight" href="/heroes/mengpo">
                <div class="hero-pic-img" style="background-image:url('/heroes/mengpo.webp')"></div>
                <span class="hero-pic-name">Mengpo</span>
              </a>
              <a class="hero-pic pic-highlight" href="/heroes/cashien">
                <div class="hero-pic-img" style="background-image:url('/heroes/cashien.webp')"></div>
                <span class="hero-pic-name">Caishen</span>
              </a>
              <a class="hero-pic pic-highlight" href="/heroes/yuelao">
                <div class="hero-pic-img" style="background-image:url('/heroes/yuelao.webp')"></div>
                <span class="hero-pic-name">Yuelao</span>
              </a>
            </div>
          </div>
          <div class="support-tier">
            <div class="support-tier-label">Priority 2</div>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/tefnut">
                <div class="hero-pic-img" style="background-image:url('/heroes/tefnut.webp')"></div>
                <span class="hero-pic-name">Tefnut</span>
              </a>
              <a class="hero-pic" href="/heroes/pan">
                <div class="hero-pic-img" style="background-image:url('/heroes/pan.webp')"></div>
                <span class="hero-pic-name">Pan</span>
              </a>
              <a class="hero-pic" href="/heroes/cancer">
                <div class="hero-pic-img" style="background-image:url('/heroes/cancer.webp')"></div>
                <span class="hero-pic-name">Cancer</span>
              </a>
            </div>
          </div>
          <div class="support-tier">
            <div class="support-tier-label">Priority 3</div>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/athena">
                <div class="hero-pic-img" style="background-image:url('/heroes/athena.webp')"></div>
                <span class="hero-pic-name">Athena</span>
              </a>
              <a class="hero-pic" href="/heroes/set">
                <div class="hero-pic-img" style="background-image:url('/heroes/set.webp')"></div>
                <span class="hero-pic-name">Set</span>
              </a>
              <a class="hero-pic" href="/heroes/diana">
                <div class="hero-pic-img" style="background-image:url('/heroes/diana.webp')"></div>
                <span class="hero-pic-name">Diana</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- TEAM COMPOSITIONS -->
      <div class="eg-content-card" id="team-comps">
        <h2>Team Compositions</h2>
        <p>These are solid starting compositions to build toward. Mix and match based on which heroes you have available.</p>
        <div class="comp-list">

          <div class="comp-card">
            <div class="comp-title">Carry + Energy Core</div>
            <div class="hero-pic-grid">
              <a class="hero-pic pic-highlight" href="/heroes/isis">
                <div class="hero-pic-img" style="background-image:url('/heroes/isis.webp')"></div>
                <span class="hero-pic-name">Isis</span>
              </a>
              <span class="pic-divider">or</span>
              <a class="hero-pic pic-highlight" href="/heroes/jingwei">
                <div class="hero-pic-img" style="background-image:url('/heroes/jingwei.webp')"></div>
                <span class="hero-pic-name">Jingwei</span>
              </a>
              <a class="hero-pic" href="/heroes/cashien">
                <div class="hero-pic-img" style="background-image:url('/heroes/cashien.webp')"></div>
                <span class="hero-pic-name">Caishen</span>
              </a>
              <a class="hero-pic" href="/heroes/poseidon">
                <div class="hero-pic-img" style="background-image:url('/heroes/poseidon.webp')"></div>
                <span class="hero-pic-name">Poseidon</span>
              </a>
            </div>
            <p class="comp-note">A versatile early-mid comp. Poseidon anchors the frontline with early CC, Caishen accelerates energy rotation, and Isis or Jingwei delivers the damage payload.</p>
          </div>

          <div class="comp-card">
            <div class="comp-title">Control + Debuff</div>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/momus">
                <div class="hero-pic-img" style="background-image:url('/heroes/momus.webp')"></div>
                <span class="hero-pic-name">Momus</span>
              </a>
              <a class="hero-pic" href="/heroes/yuelao">
                <div class="hero-pic-img" style="background-image:url('/heroes/yuelao.webp')"></div>
                <span class="hero-pic-name">Yuelao</span>
              </a>
              <a class="hero-pic pic-highlight" href="/heroes/hecate">
                <div class="hero-pic-img" style="background-image:url('/heroes/hecate.webp')"></div>
                <span class="hero-pic-name">Hecate</span>
              </a>
              <a class="hero-pic" href="/heroes/tefnut">
                <div class="hero-pic-img" style="background-image:url('/heroes/tefnut.webp')"></div>
                <span class="hero-pic-name">Tefnut</span>
              </a>
            </div>
            <p class="comp-note">Momus taunts to protect the backline, Yuelao layers healing, and Tefnut supports Hecate's sustained magical damage output.</p>
          </div>

          <div class="comp-card">
            <div class="comp-title">Bruiser + Sustain</div>
            <div class="hero-pic-grid">
              <a class="hero-pic pic-highlight" href="/heroes/heracles">
                <div class="hero-pic-img" style="background-image:url('/heroes/heracles.webp')"></div>
                <span class="hero-pic-name">Heracles</span>
              </a>
              <a class="hero-pic" href="/heroes/bastet">
                <div class="hero-pic-img" style="background-image:url('/heroes/bastet.webp')"></div>
                <span class="hero-pic-name">Bastet</span>
              </a>
              <a class="hero-pic" href="/heroes/phoenix">
                <div class="hero-pic-img" style="background-image:url('/heroes/phoenix.webp')"></div>
                <span class="hero-pic-name">Phoenix</span>
              </a>
              <a class="hero-pic" href="/heroes/mengpo">
                <div class="hero-pic-img" style="background-image:url('/heroes/mengpo.webp')"></div>
                <span class="hero-pic-name">Mengpo</span>
              </a>
            </div>
            <p class="comp-note">Heracles soaks damage upfront while Bastet and Phoenix pressure high-value targets. Mengpo provides revival insurance for a second life on key heroes.</p>
          </div>

          <div class="comp-card">
            <div class="comp-title">Attrition + Pressure</div>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/nuba">
                <div class="hero-pic-img" style="background-image:url('/heroes/nuba.webp')"></div>
                <span class="hero-pic-name">Nuba</span>
              </a>
              <a class="hero-pic" href="/heroes/nuwa">
                <div class="hero-pic-img" style="background-image:url('/heroes/nuwa.webp')"></div>
                <span class="hero-pic-name">Nuwa</span>
              </a>
              <a class="hero-pic" href="/heroes/anubis">
                <div class="hero-pic-img" style="background-image:url('/heroes/anubis.webp')"></div>
                <span class="hero-pic-name">Anubis</span>
              </a>
              <a class="hero-pic" href="/heroes/pan">
                <div class="hero-pic-img" style="background-image:url('/heroes/pan.webp')"></div>
                <span class="hero-pic-name">Pan</span>
              </a>
              <div class="pic-flex-slot">
                <div class="pic-flex-img">?</div>
                <span class="pic-flex-label">Any DD</span>
              </div>
            </div>
            <p class="comp-note">Nuba and Pan layer CC and debuffs while Anubis locks down priority targets. Nuwa adds legendary-tier support. Bring your strongest DD as the damage anchor.</p>
          </div>

          <div class="comp-card">
            <div class="comp-title">Control Engine</div>
            <div class="hero-pic-grid">
              <a class="hero-pic pic-highlight" href="/heroes/skadi">
                <div class="hero-pic-img" style="background-image:url('/heroes/skadi.webp')"></div>
                <span class="hero-pic-name">Skadi</span>
              </a>
              <a class="hero-pic" href="/heroes/khepri">
                <div class="hero-pic-img" style="background-image:url('/heroes/khepri.webp')"></div>
                <span class="hero-pic-name">Khepri</span>
              </a>
              <a class="hero-pic" href="/heroes/poseidon">
                <div class="hero-pic-img" style="background-image:url('/heroes/poseidon.webp')"></div>
                <span class="hero-pic-name">Poseidon</span>
              </a>
              <a class="hero-pic" href="/heroes/iris">
                <div class="hero-pic-img" style="background-image:url('/heroes/iris.webp')"></div>
                <span class="hero-pic-name">Iris</span>
              </a>
              <div class="pic-flex-slot">
                <div class="pic-flex-img">?</div>
                <span class="pic-flex-label">Any hero</span>
              </div>
            </div>
            <p class="comp-note">The classic Skadi control loop. Poseidon opens with AoE CC, Khepri dives the backline, and every controlled enemy triggers Skadi's passive for bonus damage and energy.</p>
          </div>

          <div class="comp-card">
            <div class="comp-title">Front Pressure</div>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/bastet">
                <div class="hero-pic-img" style="background-image:url('/heroes/bastet.webp')"></div>
                <span class="hero-pic-name">Bastet</span>
              </a>
              <a class="hero-pic" href="/heroes/heracles">
                <div class="hero-pic-img" style="background-image:url('/heroes/heracles.webp')"></div>
                <span class="hero-pic-name">Heracles</span>
              </a>
              <a class="hero-pic" href="/heroes/phoenix">
                <div class="hero-pic-img" style="background-image:url('/heroes/phoenix.webp')"></div>
                <span class="hero-pic-name">Phoenix</span>
              </a>
              <a class="hero-pic" href="/heroes/set">
                <div class="hero-pic-img" style="background-image:url('/heroes/set.webp')"></div>
                <span class="hero-pic-name">Set</span>
              </a>
              <a class="hero-pic" href="/heroes/athena">
                <div class="hero-pic-img" style="background-image:url('/heroes/athena.webp')"></div>
                <span class="hero-pic-name">Athena</span>
              </a>
              <span class="pic-divider">or</span>
              <a class="hero-pic" href="/heroes/diana">
                <div class="hero-pic-img" style="background-image:url('/heroes/diana.webp')"></div>
                <span class="hero-pic-name">Diana</span>
              </a>
            </div>
            <p class="comp-note">Bastet and Heracles anchor the frontline. Set adds disruption, Phoenix targets high-value backline heroes, and Athena or Diana provides protection or healing depending on what you need.</p>
          </div>

          <div class="comp-card">
            <div class="comp-title">Warrior Blitz</div>
            <div class="hero-pic-grid">
              <a class="hero-pic" href="/heroes/hladgunnr">
                <div class="hero-pic-img" style="background-image:url('/heroes/hladgunnr.webp')"></div>
                <span class="hero-pic-name">Hladgunnr</span>
              </a>
              <a class="hero-pic pic-highlight" href="/heroes/hecate">
                <div class="hero-pic-img" style="background-image:url('/heroes/hecate.webp')"></div>
                <span class="hero-pic-name">Hecate</span>
              </a>
              <a class="hero-pic" href="/heroes/heracles">
                <div class="hero-pic-img" style="background-image:url('/heroes/heracles.webp')"></div>
                <span class="hero-pic-name">Heracles</span>
              </a>
              <a class="hero-pic" href="/heroes/jingwei">
                <div class="hero-pic-img" style="background-image:url('/heroes/jingwei.webp')"></div>
                <span class="hero-pic-name">Jingwei</span>
              </a>
              <a class="hero-pic" href="/heroes/skadi">
                <div class="hero-pic-img" style="background-image:url('/heroes/skadi.webp')"></div>
                <span class="hero-pic-name">Skadi</span>
