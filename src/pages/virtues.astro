---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import allVirtues from "../data/virtues.json";

const virtues = allVirtues as any[];
const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";

const bySet: Record<string, any[]> = {};

for (const v of virtues) {
  if (v.type !== "singular") {
    const key = v.set ?? "Unknown";
    if (!bySet[key]) bySet[key] = [];
    bySet[key].push(v);
  }
}

function rarityLabel(r: string) {
  const map: Record<string, string> = {
    blue: "Common", purple: "Rare", gold: "Epic", red: "Legendary"
  };
  return map[r] ?? r;
}

const raritySuffixMap: Record<string, string> = {
  blue: "_rare",
  purple: "_epic",
  gold: "_elite",
  red: "_legendary"
};

function virtueAssetBaseName(name: string) {
  const compact = name.replace(/\s+/g, "").replace(/[^a-zA-Z0-9]/g, "");
  return compact ? compact.charAt(0).toLowerCase() + compact.slice(1) : "";
}

function virtueAssetUrl(name: string, rarity?: string) {
  const baseName = virtueAssetBaseName(name);
  const suffix = raritySuffixMap[rarity ?? "gold"] ?? raritySuffixMap.gold;
  return baseName ? `${R2_BASE}/images/virtues/${baseName}${suffix}.png` : "";
}
---

<Base
  title="Virtues | Motto Immortal"
  description="Complete guide to the Virtue system in Motto Immortal. Learn how to farm, summon, and equip Virtues via Realm Rover and the cube summon system."
>
<PageHero
  tag="Equipment"
  headline="Virtues"
  subtitle="Tetris-style upgrade pieces with set bonuses - farmed via Realm Rover and cube summons"
/>

<div class="page-wrapper page-content">
  <div class="content-wrapper">

    <!-- ── GUIDE SECTION ── -->
    <section class="guide-section">

      <div class="virtue-verdict">
        <div class="virtue-verdict-copy">
          <span class="section-label">F2P priority</span>
          <h2>Build useful 2-piece bonuses first</h2>
          <p>Complete effects matter more than filling every grid cell. Save Epic and Legendary pieces, target Fervor II + III for energy carries, and only chase 4-piece sets when the hero has enough space.</p>
        </div>
        <div class="virtue-verdict-rules" aria-label="Essential Virtue rules">
          <span><strong>2 pieces</strong> first useful breakpoint</span>
          <span><strong>Free</strong> to unequip anytime</span>
          <span><strong>Never feed</strong> Epic or Legendary pieces</span>
        </div>
      </div>

      <!-- TABS -->
      <div class="gtabs">
        <div class="gtab-bar" role="tablist" aria-label="Virtue guide topics">
          <button class="gtab-btn is-active" type="button" role="tab" aria-selected="true" aria-controls="gtab-farming" data-gtab="farming">Farming</button>
          <button class="gtab-btn" type="button" role="tab" aria-selected="false" aria-controls="gtab-sets" data-gtab="sets">Set Rules</button>
          <button class="gtab-btn" type="button" role="tab" aria-selected="false" aria-controls="gtab-rover" data-gtab="rover">Realm Rover</button>
        </div>

        <!-- TAB: FARMING -->
        <div class="gtab-panel is-active" id="gtab-farming" role="tabpanel">
          <div class="farming-layout">

            <div class="farming-sources">
              <div class="fsource fsource--blue">
                <div class="fsource-header">
                  <span class="fsource-cube rarity-blue">Blue Cube</span>
                  <span class="fsource-cost">300 Gems</span>
                </div>
                <p class="fsource-desc">The repeatable gem purchase and your main source of summon progress. Purple and Gold cubes arrive through its pity track.</p>
              </div>
              <div class="fsource fsource--red">
                <div class="fsource-header">
                  <span class="fsource-cube rarity-red">Red Cube</span>
                  <span class="fsource-cost">1 per 10 summons</span>
                </div>
                <p class="fsource-desc">Guaranteed every 10 summons, with an 80% Epic and 20% Legendary result.</p>
              </div>
            </div>

            <div class="farming-right">
              <div class="pity-block">
                <div class="pity-title">Pity Track</div>
                <div class="pity-sub">Every summon adds points. At 200 the bar resets and repeats.</div>
                <div class="pity-track">
                  <div class="pt-node pt-blue">
                    <span class="pt-label">Start</span>
                    <span class="pt-cube rarity-blue">Blue</span>
                  </div>
                  <div class="pt-line"></div>
                  <div class="pt-node">
                    <span class="pt-label">~40 pts</span>
                    <span class="pt-cube rarity-purple">Purple</span>
                  </div>
                  <div class="pt-line"></div>
                  <div class="pt-node">
                    <span class="pt-label">~80 pts</span>
                    <span class="pt-cube rarity-gold">Gold</span>
                  </div>
                  <div class="pt-line"></div>
                  <div class="pt-node">
                    <span class="pt-label">~120 pts</span>
                    <span class="pt-cube rarity-purple">Purple</span>
                  </div>
                  <div class="pt-line"></div>
                  <div class="pt-node">
                    <span class="pt-label">~160 pts</span>
                    <span class="pt-cube rarity-gold">Gold</span>
                  </div>
                  <div class="pt-line"></div>
                  <div class="pt-node pt-red">
                    <span class="pt-label">200 pts</span>
                    <span class="pt-cube rarity-red">Red</span>
                  </div>
                </div>
              </div>

              <div class="shards-block">
                <div class="shards-title">Shards &amp; Crafting</div>
                <div class="shards-formula">
                  <span class="sf-num">5</span>
                  <span class="sf-unit">Shards</span>
                  <svg class="sf-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  <span class="sf-num">1</span>
                  <span class="sf-unit">Virtue</span>
                </div>
                <p class="shards-note">Craft in Bag - Virtue Shards tab. Drops can be whole pieces or shards depending on cube tier.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- TAB: SETS & UPGRADING -->
        <div class="gtab-panel" id="gtab-sets" role="tabpanel">
          <div class="sets-layout">

            <div class="set-rules-block">
              <div class="srb-title">Set Threshold Rules</div>
              <div class="set-threshold-grid">
                <div class="sth-row">
                  <span class="sth-rarity rarity-purple">Rare (Purple)</span>
                  <div class="sth-badges">
                    <span class="sth-badge sth-active">2-Piece</span>
                    <span class="sth-badge sth-inactive">4-Piece (none)</span>
                  </div>
                </div>
                <div class="sth-row">
                  <span class="sth-rarity rarity-gold">Epic (Gold)</span>
                  <div class="sth-badges">
                    <span class="sth-badge sth-active">2-Piece</span>
                    <span class="sth-badge sth-active">4-Piece</span>
                  </div>
                </div>
                <div class="sth-row">
                  <span class="sth-rarity rarity-red">Legendary (Red)</span>
                  <div class="sth-badges">
                    <span class="sth-badge sth-active">2-Piece</span>
                    <span class="sth-badge sth-active">4-Piece</span>
                  </div>
                </div>
              </div>
              <div class="set-rules-notes">
                <div class="srn-row">
                  <span class="srn-icon srn-no">x</span>
                  No 3-piece sets exist
                </div>
                <div class="srn-row">
                  <span class="srn-icon srn-no">x</span>
                  No duplicate pieces on one hero (e.g. two Sacrifice I)
                </div>
                <div class="srn-row">
                  <span class="srn-icon srn-no">x</span>
                  No duplicate Singulars per hero
                </div>
                <div class="srn-row">
                  <span class="srn-icon srn-yes">v</span>
                  Set bonus beats Singular once 2-piece threshold is reached
                </div>
                <div class="srn-row">
                  <span class="srn-icon srn-yes">v</span>
                  Divine V heroes benefit most from full 4-piece sets
                </div>
              </div>
            </div>

            <div class="upgrade-block">
              <div class="upg-title">Upgrade only what you will keep</div>
              <div class="upgrade-summary">
                <span class="upgrade-summary-value">40</span>
                <span><strong>Maximum level</strong> at 5 stars. Each star adds four levels above the initial level-20 cap.</span>
              </div>
              <div class="upg-rules">
                <div class="ur-row ur-good">Enhance with Shards or low-rarity Virtues as material</div>
                <div class="ur-row ur-bad">Never use Gold or Red Virtues as Enhance material</div>
              </div>
            </div>

          </div>
        </div>

        <!-- TAB: REALM ROVER -->
        <div class="gtab-panel" id="gtab-rover" role="tabpanel">
          <div class="rover-layout">

            <div class="rover-info">
              <div class="rover-unlock">
                <span class="ru-badge">Unlock Requirement</span>
                <span class="ru-value">Odyssey Stage 25-3</span>
                <span class="ru-loc">Access via Wilds - flying ship</span>
              </div>
              <div class="rover-facts">
                <div class="rf-item">
                  <span class="rf-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                  </span>
                  <div class="rf-text">
                    <span class="rf-label">Rewards</span>
                    <span class="rf-val">Lost Coins, Virtues, Totem Summon Keys</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="rover-target">
              <div class="target-card">
                <div class="tc-label">Target Rank</div>
                <div class="tc-value">Top 20%</div>
                <div class="tc-reason">Rewards are nearly identical to Top 5%. Overinvesting yields minimal gain.</div>
              </div>
              <div class="rover-warn">
                <svg class="rw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Popular Heroes tab shows playtime, not hero strength. Do not blindly copy it.</span>
              </div>
              <div class="lost-coins-block">
                <div class="lcb-title">Lost Coins Shop</div>
                <div class="lcb-priority">
                  <span class="lcp-label">Priority 1</span>
                  <span class="lcp-name">Fervor II + III</span>
                  <span class="lcp-effect">+10% Energy Regen at combat start</span>
                </div>
                <div class="lcb-priority lcb-priority--2">
                  <span class="lcp-label">Priority 2</span>
                  <span class="lcp-name">Gold Virtues</span>
                  <span class="lcp-effect">Situational - buy when a specific missing piece is in stock</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </section>

    <!-- ── VIRTUE DATABASE ── -->
    <section class="virtue-db-section">
      <div class="virtue-db-heading">
        <div>
          <span class="section-label">Set reference</span>
          <h2 class="guide-heading">Find the effect you need</h2>
          <p class="guide-text guide-text--muted">Browse set bonuses here; hero-specific recommendations remain on each hero detail page. Singular stat fillers are intentionally omitted.</p>
        </div>
        <span class="virtue-set-count">{Object.keys(bySet).length} sets</span>
      </div>

      <label class="virtue-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <span class="sr-only">Search Virtue sets</span>
        <input id="virtue-search" type="search" placeholder="Search by set name or effect..." autocomplete="off" />
      </label>

      <!-- Sets -->
      {Object.keys(bySet).length > 0 && (
        <div class="set-groups">
          {Object.entries(bySet).map(([setName, pieces]) => {
            const sample = pieces[0];
            const bonus2 = sample?.setBonuses?.["2"] ?? "";
            const bonus4 = sample?.setBonuses?.["4"] ?? "";
            return (
              <div class="set-group" data-virtue-set data-search={`${setName} ${bonus2} ${bonus4}`.toLowerCase()}>
                <div class="set-group-header">
                  <span class="set-group-name">{setName}</span>
                  <span class={`set-rarity-badge rarity-${sample?.rarity ?? "blue"}`}>{rarityLabel(sample?.rarity ?? "blue")}</span>
                  <span class="set-piece-count">{pieces.length} pieces</span>
                </div>
                {(bonus2 || bonus4) && (
                  <div class="set-bonuses">
                    {bonus2 && (
                      <div class="set-bonus-row">
                        <span class="set-bonus-label">2-Piece</span>
                        <span class="set-bonus-text">{bonus2}</span>
                      </div>
                    )}
                    {bonus4 && (
                      <div class="set-bonus-row">
                        <span class="set-bonus-label">4-Piece</span>
                        <span class="set-bonus-text">{bonus4}</span>
                      </div>
                    )}
                  </div>
                )}
                <div class="set-pieces-row">
                  {pieces.map((v: any) => (
                    <div class={`virtue-pill rarity-${v.rarity ?? "blue"}`}>
                      <div class="virtue-pill-media-wrap">
                        {virtueAssetUrl(v.name, v.rarity) ? (
                          <img
                            class="virtue-pill-media"
                            src={virtueAssetUrl(v.name, v.rarity)}
                            alt={`${v.name} virtue asset`}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <div class="virtue-pill-media virtue-pill-media--missing" aria-hidden="true">
                            <span>No asset</span>
                          </div>
                        )}
                      </div>
                      <span class="virtue-pill-name">{v.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      )}

      <p class="virtue-empty" id="virtue-empty" hidden>No sets match that search.</p>

      {virtues.length === 0 && (
        <p class="guide-text guide-text--muted">No Virtues added yet. Data will appear here once the database is populated.</p>
      )}
    </section>

  </div>
</div>
</Base>

<style>
.page-wrapper {
  width: 100%;
  max-width: var(--page-max-width);
  margin: 0 auto;
  padding: 0 var(--page-gutter) var(--space-20);
}
.content-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-16);
}

/* ── GUIDE ── */
.guide-section,
.virtue-db-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}
.guide-text { font-size: var(--text-base); line-height: var(--leading-loose); color: var(--text-secondary); margin: 0; max-width: 780px; }
.guide-text--muted { color: var(--text-muted); }
.guide-heading { font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl)); font-weight: var(--weight-bold); color: var(--text-bright); margin: var(--space-2) 0 0; }

.virtue-verdict {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
  gap: var(--space-8);
  padding: var(--space-8);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  background:
    radial-gradient(circle at 10% 0, var(--accent-purple-dim), transparent 42%),
    var(--bg-surface);
}
.virtue-verdict h2 {
  margin: var(--space-2) 0 0;
  color: var(--text-bright);
  font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
  line-height: var(--leading-tight);
}
.virtue-verdict p {
  max-width: 720px;
  margin: var(--space-4) 0 0;
  color: var(--text-secondary);
  font-size: var(--text-base);
  line-height: var(--leading-loose);
}
.virtue-verdict-rules {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.virtue-verdict-rules span {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  padding: var(--space-4) 0;
  border-bottom: 1px solid var(--border-faint);
  color: var(--text-muted);
  font-size: var(--text-sm);
}
.virtue-verdict-rules span:last-child { border-bottom: 0; }
.virtue-verdict-rules strong { color: var(--accent-purple); font-size: var(--text-base); }

/* ── QUICK GLANCE ── */
.quick-glance {
  display: flex;
  align-items: center;
  gap: 0;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 18px 24px;
  flex-wrap: wrap;
}
.qg-pill {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 180px;
  padding: 4px 16px 4px 0;
}
.qg-icon {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  color: rgba(255,255,255,0.35);
}
.qg-icon--green { color: #4ade80; }
.qg-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.qg-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: #e0dff0;
}
.qg-value {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.42);
}
.qg-divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.08);
  flex-shrink: 0;
  margin: 0 16px 0 0;
}

/* ── RARITY STRIP ── */
.rarity-strip {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.rarity-strip-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  flex-shrink: 0;
}
.rarity-strip-items {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.rs-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border-radius: 10px;
  border: 1px solid transparent;
}
.rs-virtue-thumb {
  width: 20px;
  height: 26px;
  object-fit: contain;
  flex-shrink: 0;
  filter: drop-shadow(0 3px 6px rgba(0,0,0,0.35));
}
.rs-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.rs-item.rs-blue  { background: rgba(96,165,250,0.08);  border-color: rgba(96,165,250,0.2); }
.rs-item.rs-blue .rs-dot { background: #60a5fa; }
.rs-item.rs-purple { background: rgba(167,139,250,0.08); border-color: rgba(167,139,250,0.2); }
.rs-item.rs-purple .rs-dot { background: #a78bfa; }
.rs-item.rs-gold  { background: rgba(234,179,8,0.08);   border-color: rgba(234,179,8,0.2); }
.rs-item.rs-gold .rs-dot { background: #eab308; }
.rs-item.rs-red   { background: rgba(239,68,68,0.08);   border-color: rgba(239,68,68,0.2); }
.rs-item.rs-red .rs-dot { background: #ef4444; }
.rs-info { display: flex; flex-direction: column; gap: 1px; }
.rs-name { font-size: 0.78rem; font-weight: 700; color: #e0dff0; }
.rs-sub  { font-size: 0.68rem; color: rgba(255,255,255,0.38); }
.rs-arrow { width: 16px; height: 16px; color: rgba(255,255,255,0.2); flex-shrink: 0; }

/* ── TABS ── */
.gtabs {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.gtab-bar {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  margin-bottom: 20px;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.gtab-bar::-webkit-scrollbar { display: none; }
.gtab-btn {
  flex-shrink: 0;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  padding: 10px 18px;
  font-size: 0.85rem;
  font-weight: 600;
  color: rgba(255,255,255,0.45);
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s;
  letter-spacing: 0.02em;
}
.gtab-btn:hover { color: rgba(255,255,255,0.7); }
.gtab-btn.is-active { color: #e0dff0; border-bottom-color: #a78bfa; }
.gtab-panel { display: none; }
.gtab-panel.is-active { display: block; }

/* ── FARMING TAB ── */
.farming-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.farming-sources {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.fsource {
  padding: 12px 16px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.07);
  background: rgba(255,255,255,0.03);
}
.fsource-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.fsource-cube {
  font-size: 0.78rem;
  font-weight: 700;
  padding: 2px 10px;
  border-radius: 20px;
}
.fsource-cost {
  font-size: 0.7rem;
  color: rgba(255,255,255,0.35);
}
.fsource-desc {
  font-size: 0.78rem;
  line-height: 1.5;
  color: rgba(255,255,255,0.55);
  margin: 0;
}
.fsource--blue  { border-color: rgba(96,165,250,0.15); }
.fsource--purple { border-color: rgba(167,139,250,0.15); }
.fsource--gold  { border-color: rgba(234,179,8,0.15); }
.fsource--red   { border-color: rgba(239,68,68,0.15); }

.farming-right {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Pity Track */
.pity-block {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 16px 18px;
}
.pity-title {
  font-size: 0.82rem;
  font-weight: 700;
  color: #e0dff0;
  margin-bottom: 4px;
}
.pity-sub {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.4);
  margin-bottom: 14px;
}
.pity-track {
  display: flex;
  align-items: center;
  gap: 0;
  flex-wrap: wrap;
  gap: 4px;
}
.pt-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.pt-label {
  font-size: 0.62rem;
  color: rgba(255,255,255,0.35);
