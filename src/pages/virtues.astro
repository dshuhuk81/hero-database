---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import allVirtues from "../data/virtues.json";

const virtues = allVirtues as any[];
const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";

const bySet: Record<string, any[]> = {};

for (const v of virtues) {
  if (v.type !== "singular") {
    const key = v.set ?? "Unknown";
    if (!bySet[key]) bySet[key] = [];
    bySet[key].push(v);
  }
}

function rarityLabel(r: string) {
  const map: Record<string, string> = {
    blue: "Common", purple: "Rare", gold: "Epic", red: "Legendary"
  };
  return map[r] ?? r;
}

const raritySuffixMap: Record<string, string> = {
  blue: "_rare",
  purple: "_epic",
  gold: "_elite",
  red: "_legendary"
};

function virtueAssetBaseName(name: string) {
  const compact = name.replace(/\s+/g, "").replace(/[^a-zA-Z0-9]/g, "");
  return compact ? compact.charAt(0).toLowerCase() + compact.slice(1) : "";
}

function virtueAssetUrl(name: string, rarity?: string) {
  const baseName = virtueAssetBaseName(name);
  const suffix = raritySuffixMap[rarity ?? "gold"] ?? raritySuffixMap.gold;
  return baseName ? `${R2_BASE}/images/virtues/${baseName}${suffix}.png` : "";
}
---

<Base
  title="Virtue List | Motto Immortal"
  description="Complete guide to the Virtue system in Motto Immortal. Learn how to farm, summon, and equip Virtues via Realm Rover and the cube summon system."
>
<PageHero
  tag="Equipment"
  headline="Virtue List"
  subtitle="Tetris-style upgrade pieces with set bonuses - farmed via Realm Rover and cube summons"
/>

<div class="page-wrapper page-content">
  <div class="content-wrapper">

    <!-- ── GUIDE SECTION ── -->
    <section class="guide-section">

      <div class="virtue-verdict">
        <div class="virtue-verdict-copy">
          <span class="section-label">F2P priority</span>
          <h2>Build useful 2-piece bonuses first</h2>
          <p>Complete effects matter more than filling every grid cell. Save Epic and Legendary pieces, target Fervor II + III for energy carries, and only chase 4-piece sets when the hero has enough space.</p>
        </div>
        <div class="virtue-verdict-rules" aria-label="Essential Virtue rules">
          <span><strong>2 pieces</strong> first useful breakpoint</span>
          <span><strong>Free</strong> to unequip anytime</span>
          <span><strong>Never feed</strong> Epic or Legendary pieces</span>
        </div>
      </div>

    </section>

    <!-- ── VIRTUE DATABASE ── -->
    <section class="virtue-db-section">
      <div class="virtue-db-heading">
        <div>
          <span class="section-label">Set reference</span>
          <h2 class="guide-heading">Find the effect you need</h2>
          <p class="guide-text guide-text--muted">Browse set bonuses here; hero-specific recommendations remain on each hero detail page. Singular stat fillers are intentionally omitted.</p>
        </div>
        <span class="virtue-set-count">{Object.keys(bySet).length} sets</span>
      </div>

      <label class="virtue-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <span class="sr-only">Search Virtue sets</span>
        <input id="virtue-search" type="search" placeholder="Search by set name or effect..." autocomplete="off" />
      </label>

      <!-- Sets -->
      {Object.keys(bySet).length > 0 && (
        <div class="set-groups">
          {Object.entries(bySet).map(([setName, pieces]) => {
            const sample = pieces[0];
            const bonus2 = sample?.setBonuses?.["2"] ?? "";
            const bonus4 = sample?.setBonuses?.["4"] ?? "";
            return (
              <div class="set-group" data-virtue-set data-search={`${setName} ${bonus2} ${bonus4}`.toLowerCase()}>
                <div class="set-group-header">
                  <span class="set-group-name">{setName}</span>
                  <span class={`set-rarity-badge rarity-${sample?.rarity ?? "blue"}`}>{rarityLabel(sample?.rarity ?? "blue")}</span>
                  <span class="set-piece-count">{pieces.length} pieces</span>
                </div>
                {(bonus2 || bonus4) && (
                  <div class="set-bonuses">
                    {bonus2 && (
                      <div class="set-bonus-row">
                        <span class="set-bonus-label">2-Piece</span>
                        <span class="set-bonus-text">{bonus2}</span>
                      </div>
                    )}
                    {bonus4 && (
                      <div class="set-bonus-row">
                        <span class="set-bonus-label">4-Piece</span>
                        <span class="set-bonus-text">{bonus4}</span>
                      </div>
                    )}
                  </div>
                )}
                <div class="set-pieces-row">
                  {pieces.map((v: any) => (
                    <div class={`virtue-pill rarity-${v.rarity ?? "blue"}`}>
                      <div class="virtue-pill-media-wrap">
                        {virtueAssetUrl(v.name, v.rarity) ? (
                          <img
                            class="virtue-pill-media"
                            src={virtueAssetUrl(v.name, v.rarity)}
                            alt={`${v.name} virtue asset`}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <div class="virtue-pill-media virtue-pill-media--missing" aria-hidden="true">
                            <span>No asset</span>
                          </div>
                        )}
                      </div>
                      <span class="virtue-pill-name">{v.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      )}

      <p class="virtue-empty" id="virtue-empty" hidden>No sets match that search.</p>

      {virtues.length === 0 && (
        <p class="guide-text guide-text--muted">No Virtues added yet. Data will appear here once the database is populated.</p>
      )}
    </section>

  </div>
</div>
</Base>

<style>
.page-wrapper {
  width: 100%;
  max-width: var(--page-max-width);
  margin: 0 auto;
  padding: 0 var(--page-gutter) var(--space-20);
}
.content-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-16);
}

/* ── GUIDE ── */
.guide-section,
.virtue-db-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}
.guide-text { font-size: var(--text-base); line-height: var(--leading-loose); color: var(--text-secondary); margin: 0; max-width: 780px; }
.guide-text--muted { color: var(--text-muted); }
.guide-heading { font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl)); font-weight: var(--weight-bold); color: var(--text-bright); margin: var(--space-2) 0 0; }

.virtue-verdict {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
  gap: var(--space-8);
  padding: var(--space-8);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  background:
    radial-gradient(circle at 10% 0, var(--accent-purple-dim), transparent 42%),
    var(--bg-surface);
}
.virtue-verdict h2 {
  margin: var(--space-2) 0 0;
  color: var(--text-bright);
  font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
  line-height: var(--leading-tight);
}
.virtue-verdict p {
  max-width: 720px;
  margin: var(--space-4) 0 0;
  color: var(--text-secondary);
  font-size: var(--text-base);
  line-height: var(--leading-loose);
}
.virtue-verdict-rules {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.virtue-verdict-rules span {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  padding: var(--space-4) 0;
  border-bottom: 1px solid var(--border-faint);
  color: var(--text-muted);
  font-size: var(--text-sm);
}
.virtue-verdict-rules span:last-child { border-bottom: 0; }
.virtue-verdict-rules strong { color: var(--accent-purple); font-size: var(--text-base); }

/* ── QUICK GLANCE ── */
.quick-glance {
  display: flex;
  align-items: center;
  gap: 0;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 18px 24px;
  flex-wrap: wrap;
}
.qg-pill {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 180px;
  padding: 4px 16px 4px 0;
}
.qg-icon {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  color: rgba(255,255,255,0.35);
}
.qg-icon--green { color: #4ade80; }
.qg-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.qg-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: #e0dff0;
}
.qg-value {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.42);
}
.qg-divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.08);
  flex-shrink: 0;
  margin: 0 16px 0 0;
}

/* ── RARITY STRIP ── */
.rarity-strip {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.rarity-strip-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  flex-shrink: 0;
}
.rarity-strip-items {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.rs-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border-radius: 10px;
  border: 1px solid transparent;
}
.rs-virtue-thumb {
  width: 20px;
  height: 26px;
  object-fit: contain;
  flex-shrink: 0;
  filter: drop-shadow(0 3px 6px rgba(0,0,0,0.35));
}
.rs-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.rs-item.rs-blue  { background: rgba(96,165,250,0.08);  border-color: rgba(96,165,250,0.2); }
.rs-item.rs-blue .rs-dot { background: #60a5fa; }
.rs-item.rs-purple { background: rgba(167,139,250,0.08); border-color: rgba(167,139,250,0.2); }
.rs-item.rs-purple .rs-dot { background: #a78bfa; }
.rs-item.rs-gold  { background: rgba(234,179,8,0.08);   border-color: rgba(234,179,8,0.2); }
.rs-item.rs-gold .rs-dot { background: #eab308; }
.rs-item.rs-red   { background: rgba(239,68,68,0.08);   border-color: rgba(239,68,68,0.2); }
.rs-item.rs-red .rs-dot { background: #ef4444; }
.rs-info { display: flex; flex-direction: column; gap: 1px; }
.rs-name { font-size: 0.78rem; font-weight: 700; color: #e0dff0; }
.rs-sub  { font-size: 0.68rem; color: rgba(255,255,255,0.38); }
.rs-arrow { width: 16px; height: 16px; color: rgba(255,255,255,0.2); flex-shrink: 0; }

/* ── VIRTUE DB ── */
.virtue-db-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-6);
}
.virtue-set-count {
  flex: 0 0 auto;
  color: var(--text-muted);
  font-size: var(--text-sm);
}
.virtue-search {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  width: min(100%, 620px);
  min-height: 48px;
  padding: 0 var(--space-4);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  background: var(--bg-surface);
}
.virtue-search:focus-within {
  border-color: var(--accent-purple);
  outline: 2px solid var(--accent-purple-dim);
}
.virtue-search svg {
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
  fill: none;
  stroke: var(--text-muted);
  stroke-width: 1.8;
}
.virtue-search input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text-bright);
  font: inherit;
  font-size: var(--text-sm);
}
.virtue-search input::placeholder { color: var(--text-muted); }
.virtue-empty {
  margin: 0;
  padding: var(--space-8);
  border: 1px dashed var(--border-subtle);
  border-radius: var(--radius-lg);
  color: var(--text-muted);
  text-align: center;
}
.set-groups {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.set-group {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.set-group[hidden] {
  display: none;
}
.set-group-header {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.set-group-name {
  font-size: 1rem;
  font-weight: 800;
  color: #e0dff0;
}
.set-piece-count {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.35);
}
.set-rarity-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 20px;
  letter-spacing: 0.04em;
}
.rarity-blue   { background: rgba(96,165,250,0.15);  color: #60a5fa; }
.rarity-purple { background: rgba(167,139,250,0.15); color: #a78bfa; }
.rarity-gold   { background: rgba(234,179,8,0.15);   color: #eab308; }
.rarity-red    { background: rgba(239,68,68,0.15);   color: #ef4444; }

.set-bonuses {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 12px;
  background: rgba(255,255,255,0.03);
  border-radius: 8px;
}
.set-bonus-row {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}
.set-bonus-label {
  flex-shrink: 0;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 6px;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.55);
  margin-top: 1px;
}
.set-bonus-text {
  font-size: 0.82rem;
  line-height: 1.5;
  color: rgba(255,255,255,0.65);
}

.set-pieces-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(112px, 1fr));
  gap: var(--space-2);
}

/* Virtue pill (used in set rows and singulars grid) */
.virtue-pill {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 10px 14px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.04);
  min-width: 0;
  align-items: center;
  text-align: center;
}
.virtue-pill-media-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 6px;
}
.virtue-pill-media {
  width: 72px;
  height: 92px;
  object-fit: contain;
  filter: drop-shadow(0 10px 18px rgba(0,0,0,0.28));
}
.virtue-pill-media--missing {
  border: 1px dashed rgba(255,255,255,0.12);
  border-radius: 10px;
  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
  display: flex;
  align-items: center;
  justify-content: center;
}
.virtue-pill-media--missing span {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.28);
}
.virtue-pill.rarity-blue   { border-color: rgba(96,165,250,0.2); }
.virtue-pill.rarity-purple { border-color: rgba(167,139,250,0.25); }
.virtue-pill.rarity-gold   { border-color: rgba(234,179,8,0.25); }
.virtue-pill.rarity-red    { border-color: rgba(239,68,68,0.3); }
.virtue-pill-name {
  font-size: 0.82rem;
  font-weight: 700;
  color: #e0dff0;
  line-height: var(--leading-snug);
}
.virtue-pill.rarity-blue   .virtue-pill-name { color: #60a5fa; }
.virtue-pill.rarity-purple .virtue-pill-name { color: #a78bfa; }
.virtue-pill.rarity-gold   .virtue-pill-name { color: #eab308; }
.virtue-pill.rarity-red    .virtue-pill-name { color: #ef4444; }
.virtue-pill-bp,
.virtue-pill-stat {
  font-size: 0.74rem;
  color: rgba(255,255,255,0.5);
}

/* Singulars */
.singulars-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.singulars-header {
  font-size: 0.88rem;
  font-weight: 700;
  color: rgba(255,255,255,0.45);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.singulars-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

@media (max-width: 768px) {
  .virtue-verdict { grid-template-columns: 1fr; padding: var(--space-6); }
  .virtue-db-heading { align-items: flex-start; }
  .quick-glance { gap: 8px; }
  .qg-divider { display: none; }
}
@media (max-width: 640px) {
  .set-pieces-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rarity-strip { flex-direction: column; align-items: flex-start; gap: 8px; }
  .rarity-strip-items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
  }
  .rs-arrow { display: none; }
}
</style>

<script>
  const virtueSearch = document.getElementById("virtue-search") as HTMLInputElement | null;
  const virtueSets = Array.from(document.querySelectorAll<HTMLElement>("[data-virtue-set]"));
  const virtueEmpty = document.getElementById("virtue-empty");

  virtueSearch?.addEventListener("input", () => {
    const query = virtueSearch.value.trim().toLowerCase();
    let visible = 0;
    for (const set of virtueSets) {
      const matches = !query || (set.dataset.search ?? "").includes(query);
      set.hidden = !matches;
      if (matches) visible++;
    }
    if (virtueEmpty) virtueEmpty.hidden = visible > 0;
  });
</script>
