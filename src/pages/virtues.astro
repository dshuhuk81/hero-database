---
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import allVirtues from "../data/virtues.json";
import { readdirSync } from "node:fs";
import { fileURLToPath } from "node:url";

const virtues = allVirtues as any[];
const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";

const bySet: Record<string, any[]> = {};
const singulars: any[] = [];

for (const v of virtues) {
  if (v.type === "singular") {
    singulars.push(v);
  } else {
    const key = v.set ?? "Unknown";
    if (!bySet[key]) bySet[key] = [];
    bySet[key].push(v);
  }
}

const STAT_LABELS: Record<string, string> = {
  hp: "HP", atk: "ATK", armor: "Armor", magicRes: "M-Res",
  dodgeRate: "Dodge", critRate: "Crit Rate", critDmgBonus: "Crit DMG",
  critRes: "Crit RES", critDmgRed: "Crit Red", energy: "Energy",
  cooldownHaste: "Cooldown Haste", atkSpdBonus: "ATK SPD",
  pDmgBonus: "Phys DMG Bonus", pDmgRed: "Phys DMG Red",
  mDmgBonus: "Magic DMG Bonus", mDmgRed: "Magic DMG Red",
  healEff: "Heal Eff", rechargeEff: "Recharge Eff",
  lifestealEff: "Lifesteal", reflectEff: "Reflect Eff",
  effectRes: "Effect RES", effectHit: "Effect Hit",
  controlRes: "Control RES", controlBonus: "Control Bonus",
  normalSkillPWR: "Normal Skill PWR", ultimatePWR: "Ultimate PWR",
};

function rarityLabel(r: string) {
  const map: Record<string, string> = {
    blue: "Common", purple: "Rare", gold: "Epic", red: "Legendary"
  };
  return map[r] ?? r;
}

function normalizeAssetKey(value: string) {
  return value.toLowerCase().replace(/[^a-z0-9]/g, "");
}

const virtueAssetsDir = fileURLToPath(new URL("../../public/images/virtues", import.meta.url));

const allAssetFiles = readdirSync(virtueAssetsDir)
  .filter((fileName) => /\.png$/i.test(fileName));

const virtueAssetsByKey: Record<string, string> = {};

// Map rarity suffixes to JSON rarity values
const rarityMap: Record<string, string> = {
  "_elite": "gold",
  "_rare": "blue",
  "_epic": "purple",
  "_legendary": "red"
};

for (const fileName of allAssetFiles) {
  const baseName = fileName.replace(/\.png$/i, "");
  
  // Check for rarity suffix and extract base name
  let normalized = normalizeAssetKey(baseName);
  let rarity = "gold"; // default
  
  for (const [suffix, rarityValue] of Object.entries(rarityMap)) {
    if (baseName.endsWith(suffix)) {
      const baseWithoutSuffix = baseName.slice(0, -suffix.length);
      normalized = normalizeAssetKey(baseWithoutSuffix);
      rarity = rarityValue;
      break;
    }
  }
  
  // Create key: virtue name normalized + rarity suffix if not gold
  const key = rarity === "gold" ? normalized : (normalized + "_" + rarity);
  virtueAssetsByKey[key] = `${R2_BASE}/images/virtues/${fileName}`;
}

function virtueAssetUrl(name: string, rarity?: string) {
  const normalized = normalizeAssetKey(name);
  // Only add rarity suffix if not gold (elite)
  const key = rarity && rarity !== "gold" ? (normalized + "_" + rarity) : normalized;
  return virtueAssetsByKey[key] ?? "";
}
---

