<script>
  document.querySelectorAll(".gtab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const target = (btn as HTMLElement).dataset.gtab;
      document.querySelectorAll(".gtab-btn").forEach(b => b.classList.remove("is-active"));
      document.querySelectorAll(".gtab-panel").forEach(p => p.classList.remove("is-active"));
      btn.classList.add("is-active");
      const panel = document.getElementById("gtab-" + target);
      if (panel) panel.classList.add("is-active");
    });
  });
</script>
