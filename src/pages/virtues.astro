<script>
  document.querySelectorAll(".gtab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const target = (btn as HTMLElement).dataset.gtab;
      document.querySelectorAll(".gtab-btn").forEach(b => {
        b.classList.remove("is-active");
        b.setAttribute("aria-selected", "false");
      });
      document.querySelectorAll(".gtab-panel").forEach(p => p.classList.remove("is-active"));
      btn.classList.add("is-active");
      btn.setAttribute("aria-selected", "true");
      const panel = document.getElementById("gtab-" + target);
      if (panel) panel.classList.add("is-active");
    });
  });

  const virtueSearch = document.getElementById("virtue-search") as HTMLInputElement | null;
  const virtueSets = Array.from(document.querySelectorAll<HTMLElement>("[data-virtue-set]"));
  const virtueEmpty = document.getElementById("virtue-empty");

  virtueSearch?.addEventListener("input", () => {
    const query = virtueSearch.value.trim().toLowerCase();
    let visible = 0;
    for (const set of virtueSets) {
      const matches = !query || (set.dataset.search ?? "").includes(query);
      set.hidden = !matches;
      if (matches) visible++;
    }
    if (virtueEmpty) virtueEmpty.hidden = visible > 0;
  });
</script>
