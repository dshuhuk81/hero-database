---
export const prerender = true;
import data from "../data/totems.json";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { getPageUpdate } from "../utils/getPageUpdate";

const pageUpdate = getPageUpdate("totems");
const totems = data?.totems ?? [];

function ratingColor(rating) {
  const map = {
    SSS: "rating-sss",
    SS: "rating-ss",
    S: "rating-s",
    A: "rating-a",
    B: "rating-b",
    C: "rating-c"
  };
  return map[rating] ?? "";
}
---

<Base title="Totems | Motto Immortal">
<PageHero
  tag="Equipment"
  headline="Totems"
  subtitle="All totems with effects & ratings"
  pageUpdate={pageUpdate}
/>

<div class="page-wrapper">
  <div class="content-wrapper">
  <!-- RESULTS -->
  <div class="resultcontent">
    <div class="totem-grid">
      {totems.map(totem => (
        <article class="totem-card">
          <img src={totem.image} alt={totem.name} class="totem-image" />

          <h2>{totem.name}</h2>

          {totem.rating ? (
            <div class={`rating-badge ${ratingColor(totem.rating)}`}>
              {totem.rating}
            </div>
          ) : null}

          {totem.summary ? <p class="totem-summary">{totem.summary}</p> : null}

          <div class="totem-effects">
            {(totem.effects ?? []).map(e => (
              <p>{e.description}</p>
            ))}
          </div>

          <div class="totem-tags">
            {(totem.tags ?? []).map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
  </div>
</div>

</Base>

<style>
  /* TOTEM HEADER */
  .totem-header {
    height: 360px;
    background-image: url("/bg.jpg");
    background-size: cover;
    background-position: center 150%;
    background-attachment: fixed;
    position: relative;
  }

  .totem-header::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(0,0,0,0) 40%, rgba(0,0,0,0.35)),
      linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.45));
  }

  /* TITLE */
  .title {
    text-align: center;
    margin: 32px 0;
    font-weight: 600;
  }


  .resultcontent {
    margin-bottom: 24px;
    margin-top: 40px;
  }

  .totem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    justify-content: center;
  }

  .totem-card {
    background: #111;
    padding: 18px;
    border-radius: var(--radius-lg);
    position: relative;
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .totem-image {
    width: 100%;
    height: 120px;
    object-fit: contain;
  }

  .rating-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 12px;
  }

  .rating-sss { background: linear-gradient(135deg, var(--tier-sss-from), var(--tier-sss-to)); color: var(--tier-sss-text); }
  .rating-ss { background: linear-gradient(135deg, var(--tier-ss-from), var(--tier-ss-to)); color: var(--tier-ss-text); }
  .rating-s { background: linear-gradient(135deg, var(--tier-s-from), var(--tier-s-to)); color: var(--tier-s-text); }
  .rating-a { background: linear-gradient(135deg, var(--tier-a-from), var(--tier-a-to)); color: var(--tier-a-text); }
  .rating-b { background: linear-gradient(135deg, var(--tier-b-from), var(--tier-b-to)); color: var(--tier-b-text); }
  .rating-c { background: linear-gradient(135deg, var(--tier-c-from), var(--tier-c-to)); color: var(--tier-c-text); }

  .tag {
    display: inline-block;
    background: rgba(168, 85, 247, 0.2);
    padding: 4px 8px;
    margin: 4px 4px 0 0;
    border-radius: 6px;
    font-size: 12px;
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .totem-summary {
    font-size: 14px;
    margin: 8px 0;
    color: #b0b0b0;
  }

  .totem-effects {
    font-size: 13px;
    margin: 8px 0;
    line-height: 1.4;
  }

  .totem-effects p {
    margin: 4px 0;
  }
</style>