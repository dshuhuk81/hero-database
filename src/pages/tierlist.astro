---
export const prerender = true;

import HeroCard from "../components/HeroCard.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { heroes } from "../data/heroes/withRatings";

const isSharedPreview = Astro.url.pathname.replace(/\/+$/, "") === "/previews/tierlist";

const compareNewFirst = (a, b) => {
  if (a.newHero === b.newHero) return 0;
  return a.newHero ? -1 : 1;
};

const hasCompletePveRatings = (hero: (typeof heroes)[number]) => [
  hero.ratings?.pveearly,
  hero.ratings?.pvemidgame,
  hero.ratings?.pveendgame,
].every(Boolean);

const hasCompletePvpRatings = (hero: (typeof heroes)[number]) => [
  hero.ratings?.pvpearly,
  hero.ratings?.pvpmidgame,
  hero.ratings?.pvpendgame,
].every(Boolean);

const eligibleHeroes = heroes.filter(hero => import.meta.env.DEV || hero.release !== false);
const missingPveCount = eligibleHeroes.filter(hero => !hasCompletePveRatings(hero)).length;
const missingPvpCount = eligibleHeroes.filter(hero => !hasCompletePvpRatings(hero)).length;

const sortedHeroes = [...eligibleHeroes]
  .filter(hasCompletePveRatings)
  .sort((a, b) => compareNewFirst(a, b) || a.name.localeCompare(b.name, "en", { sensitivity: "base" }));

const tierOrder = ["S", "A", "B", "C", "D", "N/A"];
const tierGroups = tierOrder.map((tier, rank) => ({
    tier,
    rank,
    heroes: sortedHeroes.filter(hero => (hero.ratings?.pveearly || "N/A") === tier),
  }));

const ratingFields = [
  { key: "pveearly", label: "Early Game" },
  { key: "pvemidgame", label: "Mid Game" },
  { key: "pveendgame", label: "Late Game" },
];

const tierClasses = [
  { value: "carry", label: "Carry" },
  { value: "utility", label: "Utility" },
  { value: "supports", label: "Support" },
  { value: "tanks", label: "Tank" },
  { value: "other", label: "Other" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Motto Immortal Hero Tier List",
  numberOfItems: sortedHeroes.length,
  itemListElement: sortedHeroes.map((hero, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: hero.name,
    url: new URL(`/heroes/${hero.id}/`, Astro.site).href,
  })),
};
---

<Base
  title="Hero Tier List | Motto Immortal Database"
  description="Compare Motto Immortal heroes by PvE ratings across early, mid and endgame progression."
  jsonLd={jsonLd}
  robots={isSharedPreview ? "noindex, nofollow" : undefined}
>
  <PageHero
    id="tierlist"
    tag="Hero Rankings"
    headline="Hero tier list"
    subtitle="Compare heroes by mode and stage of progression"
  />

  <div class="page-wrapper heros-page-wrapper page-content">
    <div class="resultcontent">

      <div class="tl-accordions">
        <details class="tl-accordion">
          <summary>
            <span>Tierlist Definitions</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="tl-accordion-body">
            <h3>Character categories</h3>
            <ul>
              <li><strong>Carry</strong> - Characters that focus on dealing damage, have a key role and that carry you through Odyssey stages.</li>
              <li><strong>Other</strong> - This can be characters with multiple roles, most of them can be like dps or a mixture of roles.</li>
              <li><strong>Supports</strong> - Characters that focus on healing their allies or providing them with buffs (or both at the same time),</li>
              <li><strong>Tanks</strong> - Characters that are the vanguard of the team and focus on keeping their allies safe by standing in front of them.</li>
              <li><strong>Utility</strong> - Characters that bring niche or specific buffs that could add a new game mechanic or gameplay strategy on the board but they do not buff only the whole team</li>
            </ul>
            <h3>Our ratings explained</h3>
            <ul>
              <li><strong>S</strong> - a great and versatile character that has barely any flaws,</li>
              <li><strong>A</strong> - a good character that has a few little flaws,</li>
              <li><strong>B</strong> - a good character that has some flaws,</li>
              <li><strong>C</strong> - a decent character that has a few big flaws holding them back,</li>
              <li><strong>D</strong> - underwhelming character.</li>
            </ul>
          </div>
        </details>
      </div>

      <nav class="tl-tabs" aria-label="Ranking filter">
        <div class="tl-tabs-inner">
          {ratingFields.map((field, i) => (
            <button
              type="button"
              class={`tl-tab${i === 0 ? " is-active" : ""}`}
              data-rating={field.key}
            >
              {field.label}
            </button>
          ))}
        </div>
      </nav>

      <div class="sort-bar">
        <div>
          <p class="ranking-kicker"><span id="rankingTitle">PvE · Early</span> ranking</p>
          <p class="ranking-relic-range" id="rankingRelicRange">Relic Level 0-10</p>
        </div>
      </div>

      <div class="tier-list" id="tierList">
        <div class="tier-class-headings" aria-hidden="true">
          <span></span>
          {tierClasses.map(tierClass => (
            <span class={`tier-class-heading tier-class-${tierClass.value}`}>{tierClass.label}</span>
          ))}
        </div>

        {tierGroups.map(group => (
          <section class="tier-row" data-tier-section data-rank={group.rank} hidden={group.heroes.length === 0}>
            <header class="tier-label" data-tier={group.tier}>
              <span class="tier-name">{group.tier}</span>
            </header>
            <div class="tier-class-columns">
              {tierClasses.map(tierClass => {
                const classHeroes = group.heroes.filter(hero => hero.tierClass.toLowerCase() === tierClass.value);
                return (
                  <section
                    class={`tier-class-column tier-class-${tierClass.value}${classHeroes.length === 0 ? " is-empty" : ""}`}
                    data-tier-class-column={tierClass.value}
                  >
                    <h3 class="tier-class-title">{tierClass.label}</h3>
                    <div class="tier-class-heroes">
                      {classHeroes.map(hero => (
                        <div
                          class={`hero-wrapper rarity-${hero.rarity.toLowerCase()}`}
                          data-sort-order={sortedHeroes.indexOf(hero)}
                          data-name={hero.name.toLowerCase()}
                          data-class={hero.class.toLowerCase()}
                          data-role={hero.role.toLowerCase()}
                          data-tier-class={hero.tierClass.toLowerCase()}
                          data-faction={hero.faction.toLowerCase()}
                          data-rarity={hero.rarity.toLowerCase()}
                          data-tags={hero.synergies?.join("|").toLowerCase() || ""}
                          data-rating-overall={hero.ratings?.overall || "N/A"}
                          data-rating-pveearly={hero.ratings?.pveearly || "N/A"}
                          data-rating-pvemidgame={hero.ratings?.pvemidgame || "N/A"}
                          data-rating-pveendgame={hero.ratings?.pveendgame || "N/A"}
                          data-rating-pvpearly={hero.ratings?.pvpearly || "N/A"}
                          data-rating-pvpmidgame={hero.ratings?.pvpmidgame || "N/A"}
                          data-rating-pvpendgame={hero.ratings?.pvpendgame || "N/A"}
                        >
                          <HeroCard hero={hero} showRating={false} showNewBadge={false} showFactionIcon={true} />
                        </div>
                      ))}
                    </div>
                  </section>
                );
              })}
            </div>
          </section>
        ))}
      </div>
       <div class="tl-accordions">
               <details class="tl-accordion">
          <summary>
            <span>Changelog</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="tl-accordion-body">
            <ul class="tl-changelog">
              <li>
                <time datetime="2026-09-21">2026-09-21</time>
                <span>Added hero roles and define ratings for early-, mid-, and late game.</span>
              </li>
            </ul>
          </div>
        </details>
       </div>

    </div>
  </div>
</Base>

<style>
  .resultcontent {
    width: 100%;
  }

  .tl-accordions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .tl-accordion {
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--bg-surface) 88%, transparent);
  }

  .tl-accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    cursor: pointer;
    color: var(--text-bright);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    list-style: none;
  }

  .tl-accordion summary::-webkit-details-marker {
    display: none;
  }

  .tl-accordion summary:hover {
    color: var(--accent-gold);
  }

  .tl-accordion summary:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
    border-radius: var(--radius-xl);
  }

  .tl-accordion summary svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--duration-fast);
  }

  .tl-accordion[open] summary svg {
    transform: rotate(180deg);
  }

  .tl-accordion-body {
    padding: 0 var(--space-6) var(--space-6);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .tl-accordion-body h3 {
    margin: var(--space-4) 0 var(--space-2);
    color: var(--text-bright);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .tl-accordion-body h3:first-child {
    margin-top: 0;
  }

  .tl-accordion-body ul {
    margin: 0;
    padding-left: var(--space-5);
  }

  .tl-accordion-body li + li {
    margin-top: var(--space-1);
  }

  .tl-accordion-body strong {
    color: var(--text-bright);
    font-weight: var(--weight-semibold);
  }

  .tl-changelog {
    list-style: none;
    padding-left: 0;
  }

  .tl-changelog li {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: var(--space-3);
  }

  .tl-changelog time {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .tl-tabs {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    margin-top: var(--space-6);
    background: color-mix(in srgb, var(--bg-surface) 88%, transparent);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(20px);
  }

  .tl-tabs-inner {
    display: flex;
    justify-content: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0 12px;
  }

  .tl-tabs-inner::-webkit-scrollbar { display: none; }

  .tl-tab {
    flex: 0 0 auto;
    padding: 16px 20px 14px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    cursor: pointer;
    font-family: var(--font-base);
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .tl-tab:hover { color: var(--text-bright); }

  .tl-tab:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
  }

  .tl-tab.is-active {
    color: var(--accent-gold);
    border-bottom-color: var(--accent-gold);
  }

  .sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: var(--space-8) 0 var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .ranking-kicker {
    margin: 0;
    color: var(--text-bright);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .ranking-relic-range {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .tier-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tier-class-headings {
    display: grid;
    grid-template-columns: 64px repeat(5, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
  }

  .tier-class-heading {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border-left: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-align: center;
    text-transform: uppercase;
  }

  .tier-class-carry { --tier-class-color: #ff4d5f; }
  .tier-class-utility { --tier-class-color: #c66af4; }
  .tier-class-supports { --tier-class-color: #7be49b; }
  .tier-class-tanks { --tier-class-color: #ffc21c; }
  .tier-class-other { --tier-class-color: var(--text-secondary); }

  .tier-class-heading,
  .tier-class-title {
    color: var(--tier-class-color);
  }

  .tier-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    min-height: 154px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--bg-surface) 82%, transparent);
  }

  .tier-row[hidden] {
    display: none;
  }

  .tier-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--input-bg);
  }

  .tier-class-columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    min-width: 0;
  }

  .tier-class-column {
    min-width: 0;
    padding: var(--space-3);
    border-left: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-surface) 86%, transparent);
  }

  .tier-class-column:nth-child(even) {
    background: color-mix(in srgb, var(--input-bg) 78%, transparent);
  }

  .tier-class-title {
    display: none;
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .tier-label[data-tier="S+"] { background: linear-gradient(145deg, var(--tier-splus-from), var(--tier-splus-to)); }
  .tier-label[data-tier="S"] { background: linear-gradient(145deg, var(--tier-s-from), var(--tier-s-to)); }
  .tier-label[data-tier="A"] { background: linear-gradient(145deg, var(--tier-a-from), var(--tier-a-to)); }
  .tier-label[data-tier="B"] { background: linear-gradient(145deg, var(--tier-b-from), var(--tier-b-to)); }
  .tier-label[data-tier="C"] { background: linear-gradient(145deg, var(--tier-c-from), var(--tier-c-to)); }
  .tier-label[data-tier="D"] { background: linear-gradient(145deg, var(--tier-d-from), var(--tier-d-to)); }
  .tier-label[data-tier="N/A"] { background: var(--input-bg); }

  .tier-name {
    color: white;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: var(--weight-bold);
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .tier-class-heroes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(91px, 110px));
    justify-content: start;
    gap: var(--space-2);
  }

  .hero-wrapper {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    min-width: 0;
  }

  .hero-wrapper :global(.hero-card) {
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    clip-path: inset(0 round var(--radius-md));
  }

  .hero-wrapper :global(.name-overlay) {
    height: 28px;
    padding-inline: 4px;
  }

  .hero-wrapper :global(.hero-name) {
    overflow: hidden;
    font-size: 0.68rem;
    font-weight: var(--weight-semibold);
    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .tier-class-headings { display: none; }
    .tier-row { display: block; }
    .tier-label {
      min-height: 76px;
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .tier-class-columns { display: block; }
    .tier-class-column {
      padding: var(--space-4);
      border-top: 1px solid var(--border-subtle);
      border-left: 0;
    }
    .tier-class-column:first-child { border-top: 0; }
    .tier-class-column.is-empty { display: none; }
    .tier-class-title {
      display: block;
      margin-bottom: var(--space-3);
      text-align: center;
    }
    .tier-class-heroes {
      grid-template-columns: repeat(auto-fill, minmax(96px, 115px));
    }
  }

  @media (max-width: 600px) {
    .tl-accordion summary {
      padding: var(--space-3) var(--space-4);
    }

    .tl-accordion-body {
      padding: 0 var(--space-4) var(--space-4);
    }

    .tl-changelog li {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .tl-tab {
      padding: 13px 14px 11px;
      font-size: 13px;
    }

    .tier-row {
      min-height: 160px;
    }

    .tier-name { font-size: 1.65rem; }
    .tier-class-column { padding: var(--space-3); }
    .tier-class-heroes {
      grid-template-columns: repeat(auto-fill, minmax(86px, 106px));
      gap: var(--space-2);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const heroCounter = document.getElementById("heroCounter");
    const rankingTitle = document.getElementById("rankingTitle");
    const rankingRelicRange = document.getElementById("rankingRelicRange");
    const tierSections = Array.from(document.querySelectorAll<HTMLElement>("[data-tier-section]"));
    const heroCards = Array.from(document.querySelectorAll<HTMLElement>(".hero-wrapper"))
      .sort((a, b) => Number(a.dataset.sortOrder) - Number(b.dataset.sortOrder));
    const ratingTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".tl-tab[data-rating]"));
    const sectionByTier = new Map(tierSections.map(section => [section.querySelector<HTMLElement>(".tier-label")?.dataset.tier || "N/A", section]));
    const labels: Record<string, string> = {
      pveearly: "PvE · Early",
      pvemidgame: "PvE · Mid",
      pveendgame: "PvE · Lategame",
    };
    const relicRanges: Record<string, string> = {
      pveearly: "Chapters 1-39 and Relic Level 0-10",
      pvemidgame: "Chapters 40-55 and Relic Level 10-30",
      pveendgame: "Chapters 55+ and Relic Level 30+",
    };

    function applyRating(field: string) {
      heroCards.forEach(card => {
        const tier = card.getAttribute(`data-rating-${field}`) || "N/A";
        const section = sectionByTier.get(tier) ?? sectionByTier.get("N/A");
        const tierClass = card.dataset.tierClass || "other";
        section?.querySelector(`[data-tier-class-column="${tierClass}"] .tier-class-heroes`)?.appendChild(card);
      });

      let rated = 0;
      tierSections.forEach(section => {
        const count = section.querySelectorAll(".hero-wrapper").length;
        const tier = section.querySelector<HTMLElement>(".tier-label")?.dataset.tier;
        section.hidden = tier === "N/A" || count === 0;
        if (tier !== "N/A") rated += count;
        const countElement = section.querySelector("[data-tier-count]");
        if (countElement) countElement.textContent = String(count);
        section.querySelectorAll<HTMLElement>("[data-tier-class-column]").forEach(column => {
          column.classList.toggle("is-empty", !column.querySelector(".hero-wrapper"));
        });
      });

      if (rankingTitle) rankingTitle.textContent = labels[field] || "Overall";
      if (rankingRelicRange) rankingRelicRange.textContent = relicRanges[field] || "";
      if (heroCounter) {
        heroCounter.textContent = `${rated} ${rated === 1 ? "hero" : "heroes"}`;
      }

      const url = new URL(window.location.href);
      field === "pveearly" ? url.searchParams.delete("rating") : url.searchParams.set("rating", field);
      url.searchParams.delete("role");
      window.history.replaceState({}, "", url);
    }

    function selectRating(field: string) {
      ratingTabs.forEach(tab => tab.classList.toggle("is-active", tab.dataset.rating === field));
      applyRating(field);
    }

    ratingTabs.forEach(tab => tab.addEventListener("click", () => selectRating(tab.dataset.rating || "pveearly")));

    const url = new URL(window.location.href);
    const requestedField = url.searchParams.get("rating") || "pveearly";
    const initialField = ratingTabs.some(tab => tab.dataset.rating === requestedField) ? requestedField : "pveearly";
    selectRating(initialField);
  });
</script>
