---
export const prerender = true;

import HeroCard from "../components/HeroCard.astro";
import Filter from "../components/filter.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { heroes } from "../data/heroes/withRatings";

const compareNewFirst = (a, b) => {
  if (a.newHero === b.newHero) return 0;
  return a.newHero ? -1 : 1;
};

const sortedHeroes = [...heroes]
  .filter(hero => import.meta.env.DEV || hero.release !== false)
  .sort((a, b) => compareNewFirst(a, b) || a.name.localeCompare(b.name, "en", { sensitivity: "base" }));

const tierOrder = ["S+", "S", "A+", "A", "B", "C", "D"];
const tierGroups = tierOrder
  .map((tier, rank) => ({
    tier,
    rank,
    heroes: sortedHeroes.filter(hero => (hero.ratings?.overall || "N/A") === tier),
  }))
  .filter(group => group.heroes.length > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Motto Immortal Hero Tier List",
  numberOfItems: sortedHeroes.length,
  itemListElement: sortedHeroes.map((hero, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: hero.name,
    url: new URL(`/heroes/${hero.id}/`, Astro.site).href,
  })),
};
---

<Base
  title="Hero Tier List | Motto Immortal Database"
  description="Browse the Motto Immortal hero tier list. Filter heroes by class, faction, role, rarity and rating."
  jsonLd={jsonLd}
>
  <PageHero
    id="tierlist"
    tag="Hero Rankings"
    headline="Hero tier list"
    subtitle="Compare every hero by rating, class, faction & role"
  />

  <div class="page-wrapper heros-page-wrapper">
    <button class="filter-fab" id="filterFab" type="button" aria-label="Open filters">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
        <line x1="11" y1="18" x2="13" y2="18"/>
      </svg>
      Filter
      <span class="filter-fab-badge" id="filterFabBadge"></span>
    </button>

    <div class="filter-overlay-backdrop" id="filterOverlayBackdrop"></div>
    <Filter />

    <div class="resultcontent">
      <div class="sort-bar">
        <div>
          <p class="ranking-kicker">Overall ranking</p>
          <p id="heroCounter" class="hero-counter">0 Heroes shown</p>
        </div>
        <div class="sort-controls">
          <button id="rankDirection" class="rank-direction" type="button" aria-label="Show lowest rankings first">
            <span>Best first</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 5v14"/><path d="m7 14 5 5 5-5"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="tier-list" id="tierList">
        {tierGroups.map(group => (
          <section class="tier-row" data-tier-section data-rank={group.rank}>
            <header class="tier-label" data-tier={group.tier}>
              <span class="tier-name">{group.tier}</span>
              <span class="tier-count" data-tier-count>{group.heroes.length}</span>
            </header>
            <div class="tier-heroes">
              {group.heroes.map(hero => (
                <div
                  class={`hero-wrapper rarity-${hero.rarity.toLowerCase()}`}
                  data-name={hero.name.toLowerCase()}
                  data-class={hero.class.toLowerCase()}
                  data-role={hero.role.toLowerCase()}
                  data-faction={hero.faction.toLowerCase()}
                  data-rarity={hero.rarity.toLowerCase()}
                  data-tags={hero.synergies?.join("|").toLowerCase() || ""}
                >
                  <HeroCard hero={hero} showRating={false} showNewBadge={false} />
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  .sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: var(--space-8) 0 var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-counter {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .ranking-kicker {
    margin: 0;
    color: var(--text-bright);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .sort-controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .rank-direction {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--input-bg);
    color: var(--text-bright);
    padding: 9px var(--space-3);
    font: inherit;
    cursor: pointer;
  }

  .rank-direction:hover {
    background: var(--chip-bg-hover);
  }

  .rank-direction svg {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .rank-direction.reversed svg {
    transform: rotate(180deg);
  }

  .tier-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tier-row {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    min-height: 200px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--card-bg) 82%, transparent);
  }

  .tier-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--input-bg);
  }

  .tier-label[data-tier="S+"] { background: linear-gradient(145deg, var(--tier-splus-from), var(--tier-splus-to)); }
  .tier-label[data-tier="S"] { background: linear-gradient(145deg, var(--tier-s-from), var(--tier-s-to)); }
  .tier-label[data-tier="A+"] { background: linear-gradient(145deg, var(--tier-a-from), var(--tier-s-to)); }
  .tier-label[data-tier="A"] { background: linear-gradient(145deg, var(--tier-a-from), var(--tier-a-to)); }
  .tier-label[data-tier="B"] { background: linear-gradient(145deg, var(--tier-b-from), var(--tier-b-to)); }
  .tier-label[data-tier="C"] { background: linear-gradient(145deg, var(--tier-c-from), var(--tier-c-to)); }
  .tier-label[data-tier="D"] { background: linear-gradient(145deg, var(--tier-d-from), var(--tier-d-to)); }

  .tier-name {
    color: white;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: var(--weight-bold);
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .tier-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 24px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.24);
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .tier-heroes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .hero-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    min-width: 0;
  }

  .hero-wrapper.rarity-common { border: 1px solid var(--rarity-common-border); }
  .hero-wrapper.rarity-epic { border: 1px solid var(--rarity-epic-border); }
  .hero-wrapper.rarity-legendary { border: 1px solid var(--rarity-legendary-border); }

  .hero-wrapper :global(.hero-card) {
    height: 190px;
  }

  @media (max-width: 600px) {
    .tier-row {
      grid-template-columns: 58px minmax(0, 1fr);
      min-height: 160px;
    }

    .tier-name { font-size: 1.65rem; }
    .tier-heroes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
      padding: var(--space-2);
    }
    .hero-wrapper :global(.hero-card) { height: 170px; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("searchInput") as HTMLInputElement;
    const resetButton = document.getElementById("resetFilters");
    const heroCounter = document.getElementById("heroCounter");
    const tierList = document.getElementById("tierList") as HTMLElement;
    const tierSections = document.querySelectorAll<HTMLElement>("[data-tier-section]");
    const rankDirection = document.getElementById("rankDirection") as HTMLButtonElement;
    const heroCards = document.querySelectorAll<HTMLElement>(".hero-wrapper");
    const roleChips = document.querySelectorAll(".role-chip");
    const factionChips = document.querySelectorAll(".faction-chip");
    const classChips = document.querySelectorAll(".class-chip");
    const rarityChips = document.querySelectorAll(".rarity-chip");

    const activeRoles = new Set<string>();
    const activeClasses = new Set<string>();
    const activeRarities = new Set<string>();
    const activeFactions = new Set<string>();

    function matchesFilters(el: HTMLElement) {
      const query = (searchInput.value || "").toLowerCase();
      const name = el.dataset.name || "";
      const cls = el.dataset.class || "";
      const role = el.dataset.role || "";
      const rarity = el.dataset.rarity || "";
      const faction = el.dataset.faction || "";
      return (
        (!query || name.includes(query) || cls.includes(query) || role.includes(query) || faction.includes(query) || rarity.includes(query)) &&
        (activeClasses.size === 0 || activeClasses.has(cls)) &&
        (activeRoles.size === 0 || activeRoles.has(role)) &&
        (activeRarities.size === 0 || activeRarities.has(rarity)) &&
        (activeFactions.size === 0 || activeFactions.has(faction))
      );
    }

    function applyFilters() {
      let visible = 0;
      heroCards.forEach(card => {
        const show = matchesFilters(card);
        card.style.display = show ? "block" : "none";
        if (show) visible++;
      });
      tierSections.forEach(section => {
        const cards = section.querySelectorAll<HTMLElement>(".hero-wrapper");
        const shown = Array.from(cards).filter(card => card.style.display !== "none").length;
        section.hidden = shown === 0;
        const count = section.querySelector("[data-tier-count]");
        if (count) count.textContent = String(shown);
      });
      heroCounter!.textContent = `${visible} Heroes shown`;
    }

    function toggleSet(chip: Element, set: Set<string>, value: string) {
      set.has(value) ? set.delete(value) : set.add(value);
      chip.classList.toggle("active");
      applyFilters();
    }

    searchInput.addEventListener("input", applyFilters);
    let reversed = false;
    rankDirection.addEventListener("click", () => {
      reversed = !reversed;
      Array.from(tierSections)
        .sort((a, b) => {
          const difference = Number(a.dataset.rank) - Number(b.dataset.rank);
          return reversed ? -difference : difference;
        })
        .forEach(section => tierList.appendChild(section));
      rankDirection.classList.toggle("reversed", reversed);
      rankDirection.querySelector("span")!.textContent = reversed ? "Lowest first" : "Best first";
      rankDirection.setAttribute("aria-label", reversed ? "Show best rankings first" : "Show lowest rankings first");
    });
    roleChips.forEach(chip => chip.addEventListener("click", () => toggleSet(chip, activeRoles, (chip as HTMLElement).dataset.role || "")));
    classChips.forEach(chip => chip.addEventListener("click", () => toggleSet(chip, activeClasses, (chip as HTMLElement).dataset.class || "")));
    factionChips.forEach(chip => chip.addEventListener("click", () => toggleSet(chip, activeFactions, (chip as HTMLElement).dataset.faction || "")));
    rarityChips.forEach(chip => chip.addEventListener("click", () => toggleSet(chip, activeRarities, (chip as HTMLElement).dataset.rarity || "")));
    resetButton?.addEventListener("click", () => {
      searchInput.value = "";
      activeClasses.clear();
      activeRarities.clear();
      activeRoles.clear();
      activeFactions.clear();
      document.querySelectorAll(".chip.active, .role-chip.active").forEach(chip => chip.classList.remove("active"));
      applyFilters();
    });

    const searchClear = document.getElementById("searchClear") as HTMLButtonElement | null;
    const syncSearchClear = () => searchClear?.classList.toggle("visible", searchInput.value.trim().length > 0);
    searchClear?.addEventListener("click", () => {
      searchInput.value = "";
      searchInput.dispatchEvent(new Event("input"));
      searchInput.focus();
    });
    searchInput.addEventListener("input", syncSearchClear);
    syncSearchClear();

    const filterFab = document.getElementById("filterFab");
    const filterFabBadge = document.getElementById("filterFabBadge");
    const filterBar = document.getElementById("filterBar");
    const backdrop = document.getElementById("filterOverlayBackdrop");
    const closeButton = document.getElementById("filterOverlayClose");
    const closeOverlay = () => {
      filterBar?.classList.remove("filter-overlay-open");
      backdrop?.classList.remove("is-open");
      document.body.style.overflow = "";
    };
    const updateBadge = () => {
      const count = activeClasses.size + activeRoles.size + activeRarities.size + activeFactions.size + (searchInput.value.trim() ? 1 : 0);
      if (filterFabBadge) filterFabBadge.textContent = count ? String(count) : "";
    };
    filterFab?.addEventListener("click", () => {
      filterBar?.classList.add("filter-overlay-open");
      backdrop?.classList.add("is-open");
      document.body.style.overflow = "hidden";
    });
    closeButton?.addEventListener("click", closeOverlay);
    backdrop?.addEventListener("click", closeOverlay);
    document.querySelectorAll(".chip, .role-chip, .class-chip, .rarity-chip, .faction-chip").forEach(chip => chip.addEventListener("click", updateBadge));
    searchInput.addEventListener("input", updateBadge);
    resetButton?.addEventListener("click", updateBadge);

    applyFilters();
    updateBadge();
  });
</script>
