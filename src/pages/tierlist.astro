---
export const prerender = true;

import HeroCard from "../components/HeroCard.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import Filter from "../components/filter.astro";
import { heroes } from "../data/heroes/withRatings";

const compareNewFirst = (a, b) => {
  if (a.newHero === b.newHero) return 0;
  return a.newHero ? -1 : 1;
};

const hasCompletePveRatings = (hero: (typeof heroes)[number]) => [
  hero.ratings?.pveearly,
  hero.ratings?.pvemidgame,
  hero.ratings?.pveendgame,
].every(Boolean);

const hasCompletePvpRatings = (hero: (typeof heroes)[number]) => [
  hero.ratings?.pvpearly,
  hero.ratings?.pvpmidgame,
  hero.ratings?.pvpendgame,
].every(Boolean);

const eligibleHeroes = heroes.filter(hero => import.meta.env.DEV || hero.release !== false);
const missingPveCount = eligibleHeroes.filter(hero => !hasCompletePveRatings(hero)).length;
const missingPvpCount = eligibleHeroes.filter(hero => !hasCompletePvpRatings(hero)).length;

const sortedHeroes = [...eligibleHeroes]
  .filter(hasCompletePveRatings)
  .sort((a, b) => compareNewFirst(a, b) || a.name.localeCompare(b.name, "en", { sensitivity: "base" }));

const tierOrder = ["S", "A", "B", "C", "D", "N/A"];
const tierGroups = tierOrder.map((tier, rank) => ({
    tier,
    rank,
    heroes: sortedHeroes.filter(hero => (hero.ratings?.pveearly || "N/A") === tier),
  }));

const ratingFields = [
  { key: "pveearly", label: "Early Game" },
  { key: "pvemidgame", label: "Mid Game" },
  { key: "pveendgame", label: "Late Game" },
];

const tierClasses = [
  { value: "carry", label: "Carry" },
  { value: "utility", label: "Utility" },
  { value: "supports", label: "Support" },
  { value: "tanks", label: "Tank" },
  { value: "other", label: "Other" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Motto Immortal Hero Tier List",
  numberOfItems: sortedHeroes.length,
  itemListElement: sortedHeroes.map((hero, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: hero.name,
    url: new URL(`/heroes/${hero.id}/`, Astro.site).href,
  })),
};
---

<Base
  title="Hero Tier List | Motto Immortal Database"
  description="Compare Motto Immortal heroes by PvE ratings across early, mid and endgame progression."
  jsonLd={jsonLd}
>
  <PageHero
    id="tierlist"
    tag="Hero Rankings"
    headline="Hero tier list"
    subtitle="Compare heroes by mode and stage of progression"
  />

  <div class="page-wrapper heros-page-wrapper page-content">

    <div class="resultcontent">

      <div class="tl-accordions">
        <details class="tl-accordion">
          <summary>
            <span>Tierlist Definitions</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="tl-accordion-body">
            <h3>Character categories</h3>
            <ul>
              <li><strong>Carry</strong> - Characters that focus on dealing damage, have a key role and that carry you through Odyssey stages.</li>
              <li><strong>Other</strong> - This can be characters with multiple roles, most of them can be like dps or a mixture of roles.</li>
              <li><strong>Supports</strong> - Characters that focus on healing their allies or providing them with buffs (or both at the same time),</li>
              <li><strong>Tanks</strong> - Characters that are the vanguard of the team and focus on keeping their allies safe by standing in front of them.</li>
              <li><strong>Utility</strong> - Characters that bring niche or specific buffs that could add a new game mechanic or gameplay strategy on the board but they do not buff only the whole team</li>
            </ul>
            <h3>Our ratings explained</h3>
            <ul>
              <li><strong>S</strong> - a great and versatile character that has barely any flaws,</li>
              <li><strong>A</strong> - a good character that has a few little flaws,</li>
              <li><strong>B</strong> - a good character that has some flaws,</li>
              <li><strong>C</strong> - a decent character that has a few big flaws holding them back,</li>
              <li><strong>D</strong> - underwhelming character.</li>
            </ul>
          </div>
        </details>
      </div>

      <nav class="tl-tabs" aria-label="Ranking filter">
        <div class="tl-tabs-inner">
          {ratingFields.map((field, i) => (
            <button
              type="button"
              class={`tl-tab${i === 0 ? " is-active" : ""}`}
              data-rating={field.key}
            >
              {field.label}
            </button>
          ))}
        </div>
      </nav>

      <Filter />

      <div class="sort-bar">
        <div class="ranking-head">
          <div class="mode-switch" role="group" aria-label="Ranking mode">
            <button type="button" class="mode-btn is-active" data-mode="pve">PvE</button>
            <button type="button" class="mode-btn" data-mode="pvp">PvP</button>
          </div>
          <div>
            <p class="ranking-kicker" id="rankingKicker">PVE Ranking</p>
            <p class="ranking-relic-range" id="rankingRelicRange">Relic Level 0-10</p>

          </div>
        </div>
      </div>

      <div class="tier-list" id="tierList">
        <div class="tier-class-headings" aria-hidden="true">
          <span></span>
          {tierClasses.map(tierClass => (
            <span class={`tier-class-heading tier-class-${tierClass.value}`}>{tierClass.label}</span>
          ))}
        </div>

        {tierGroups.map(group => (
          <section class="tier-row" data-tier-section data-rank={group.rank} hidden={group.heroes.length === 0}>
            <header class="tier-label" data-tier={group.tier}>
              <span class="tier-name">{group.tier}</span>
            </header>
            <div class="tier-class-columns">
              {tierClasses.map(tierClass => {
                const classHeroes = group.heroes.filter(hero => hero.tierClass.toLowerCase() === tierClass.value);
                return (
                  <section
                    class={`tier-class-column tier-class-${tierClass.value}${classHeroes.length === 0 ? " is-empty" : ""}`}
                    data-tier-class-column={tierClass.value}
                  >
                    <h3 class="tier-class-title">{tierClass.label}</h3>
                    <div class="tier-class-heroes">
                      {classHeroes.map(hero => (
                        <div
                          class={`hero-wrapper rarity-${hero.rarity.toLowerCase()}`}
                          data-sort-order={sortedHeroes.indexOf(hero)}
                          data-name={hero.name.toLowerCase()}
                          data-class={hero.class.toLowerCase()}
                          data-role={hero.role.toLowerCase()}
                          data-tier-class={hero.tierClass.toLowerCase()}
                          data-faction={hero.faction.toLowerCase()}
                          data-rarity={hero.rarity.toLowerCase()}
                          data-tags={hero.synergies?.join("|").toLowerCase() || ""}
                          data-rating-overall={hero.ratings?.overall || "N/A"}
                          data-rating-pveearly={hero.ratings?.pveearly || "N/A"}
                          data-rating-pvemidgame={hero.ratings?.pvemidgame || "N/A"}
                          data-rating-pveendgame={hero.ratings?.pveendgame || "N/A"}
                          data-rating-pvpearly={hero.ratings?.pvpearly || "N/A"}
                          data-rating-pvpmidgame={hero.ratings?.pvpmidgame || "N/A"}
                          data-rating-pvpendgame={hero.ratings?.pvpendgame || "N/A"}
                        >
                          <HeroCard hero={hero} showRating={false} showNewBadge={false} showFactionIcon={true} />
                        </div>
                      ))}
                    </div>
                  </section>
                );
              })}
            </div>
          </section>
        ))}
      </div>
       <div class="tl-accordions">
               <details class="tl-accordion">
          <summary>
            <span>Changelog</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="tl-accordion-body">
            <ul class="tl-changelog">
              <li>
                <time datetime="2026-09-21">2026-09-21</time>
                <span>Added hero roles and define ratings for early-, mid-, and late game.</span>
              </li>
            </ul>
          </div>
        </details>
       </div>

    </div>
  </div>
</Base>

<style>
  .resultcontent {
    width: 100%;
  }

  .tl-accordions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .tl-accordion {
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--bg-surface) 88%, transparent);
  }

  .tl-accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    cursor: pointer;
    color: var(--text-bright);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    list-style: none;
  }

  .tl-accordion summary::-webkit-details-marker {
    display: none;
  }

  .tl-accordion summary:hover {
    color: var(--accent-gold);
  }

  .tl-accordion summary:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
    border-radius: var(--radius-xl);
  }

  .tl-accordion summary svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--duration-fast);
  }

  .tl-accordion[open] summary svg {
    transform: rotate(180deg);
  }

  .tl-accordion-body {
    padding: 0 var(--space-6) var(--space-6);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .tl-accordion-body h3 {
    margin: var(--space-4) 0 var(--space-2);
    color: var(--text-bright);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .tl-accordion-body h3:first-child {
    margin-top: 0;
  }

  .tl-accordion-body ul {
    margin: 0;
    padding-left: var(--space-5);
  }

  .tl-accordion-body li + li {
    margin-top: var(--space-1);
  }

  .tl-accordion-body strong {
    color: var(--text-bright);
    font-weight: var(--weight-semibold);
  }

  .tl-changelog {
    list-style: none;
    padding-left: 0;
  }

  .tl-changelog li {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: var(--space-3);
  }

  .tl-changelog time {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .tl-tabs {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    margin-top: var(--space-6);
    background: color-mix(in srgb, var(--bg-surface) 88%, transparent);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(20px);
  }

  .tl-tabs-inner {
    display: flex;
    justify-content: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0 12px;
  }

  .tl-tabs-inner::-webkit-scrollbar { display: none; }

  .tl-tab {
    flex: 0 0 auto;
    padding: 16px 20px 14px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    cursor: pointer;
    font-family: var(--font-base);
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .tl-tab:hover { color: var(--text-bright); }

  .tl-tab:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
  }

  .tl-tab.is-active {
    color: var(--accent-gold);
    border-bottom-color: var(--accent-gold);
  }

  .sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: var(--space-8) 0 var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .ranking-head {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .mode-switch {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    background: var(--chip-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
  }

  .mode-btn {
    border: 0;
    background: transparent;
    color: var(--text-muted);
    padding: 12px var(--space-5);
    border-radius: var(--radius-full);
    font-family: var(--font-base);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    cursor: pointer;
    transition: var(--transition-colors);
  }

  .mode-btn:hover { color: var(--text-bright); }

  .mode-btn:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .mode-btn.is-active {
    background: var(--accent-gold);
    color: var(--bg-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .mode-btn { transition: none; }
  }

  .ranking-coverage {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .ranking-kicker {
    margin: 0;
    color: var(--text-bright);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .ranking-relic-range {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .tier-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tier-class-headings {
    display: grid;
    grid-template-columns: 64px repeat(5, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
  }

  .tier-class-heading {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border-left: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-align: center;
    text-transform: uppercase;
  }

  .tier-class-carry { --tier-class-color: #ff4d5f; }
  .tier-class-utility { --tier-class-color: #c66af4; }
  .tier-class-supports { --tier-class-color: #7be49b; }
  .tier-class-tanks { --tier-class-color: #ffc21c; }
  .tier-class-other { --tier-class-color: var(--text-secondary); }

  .tier-class-heading,
  .tier-class-title {
    color: var(--tier-class-color);
  }

  .tier-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    min-height: 154px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--bg-surface) 82%, transparent);
  }

  .tier-row[hidden] {
    display: none;
  }

  .tier-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--input-bg);
  }

  .tier-class-columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    min-width: 0;
  }

  .tier-class-column {
    min-width: 0;
    padding: var(--space-3);
    border-left: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-surface) 86%, transparent);
  }

  .tier-class-column:nth-child(even) {
    background: color-mix(in srgb, var(--input-bg) 78%, transparent);
  }

  .tier-class-title {
    display: none;
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .tier-label[data-tier="S+"] { background: linear-gradient(145deg, var(--tier-splus-from), var(--tier-splus-to)); }
  .tier-label[data-tier="S"] { background: linear-gradient(145deg, var(--tier-s-from), var(--tier-s-to)); }
  .tier-label[data-tier="A"] { background: linear-gradient(145deg, var(--tier-a-from), var(--tier-a-to)); }
  .tier-label[data-tier="B"] { background: linear-gradient(145deg, var(--tier-b-from), var(--tier-b-to)); }
  .tier-label[data-tier="C"] { background: linear-gradient(145deg, var(--tier-c-from), var(--tier-c-to)); }
  .tier-label[data-tier="D"] { background: linear-gradient(145deg, var(--tier-d-from), var(--tier-d-to)); }
  .tier-label[data-tier="N/A"] { background: var(--input-bg); }

  .tier-name {
    color: white;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: var(--weight-bold);
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .tier-class-heroes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(91px, 110px));
    justify-content: start;
    gap: var(--space-2);
  }

  .hero-wrapper {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    min-width: 0;
  }

  .hero-wrapper :global(.hero-card) {
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    clip-path: inset(0 round var(--radius-md));
  }

  .hero-wrapper :global(.name-overlay) {
    height: 28px;
    padding-inline: 4px;
  }

  .hero-wrapper :global(.hero-name) {
    overflow: hidden;
    font-size: 0.68rem;
    font-weight: var(--weight-semibold);
    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .tier-class-headings { display: none; }
    .tier-row { display: block; }
    .tier-label {
      min-height: 76px;
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .tier-class-columns { display: block; }
    .tier-class-column {
      padding: var(--space-4);
      border-top: 1px solid var(--border-subtle);
      border-left: 0;
    }
    .tier-class-column:first-child { border-top: 0; }
    .tier-class-column.is-empty { display: none; }
    .tier-class-title {
      display: block;
      margin-bottom: var(--space-3);
      text-align: center;
    }
    .tier-class-heroes {
      grid-template-columns: repeat(auto-fill, minmax(96px, 115px));
    }
  }

  @media (max-width: 600px) {
    .tl-accordion summary {
      padding: var(--space-3) var(--space-4);
    }

    .tl-accordion-body {
      padding: 0 var(--space-4) var(--space-4);
    }

    .tl-changelog li {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .tl-tab {
      padding: 13px 14px 11px;
      font-size: 13px;
    }

    .tier-row {
      min-height: 160px;
    }

    .tier-name { font-size: 1.65rem; }
    .tier-class-column { padding: var(--space-3); }
    .tier-class-heroes {
      grid-template-columns: repeat(auto-fill, minmax(86px, 106px));
      gap: var(--space-2);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const rankingRelicRange = document.getElementById("rankingRelicRange");
    const tierSections = Array.from(document.querySelectorAll<HTMLElement>("[data-tier-section]"));
    const heroCards = Array.from(document.querySelectorAll<HTMLElement>(".hero-wrapper"))
      .sort((a, b) => Number(a.dataset.sortOrder) - Number(b.dataset.sortOrder));
    const ratingTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".tl-tab[data-rating]"));
    const sectionByTier = new Map(tierSections.map(section => [section.querySelector<HTMLElement>(".tier-label")?.dataset.tier || "N/A", section]));
    const rankingKicker = document.getElementById("rankingKicker");
    const rankingCoverage = document.getElementById("rankingCoverage");
    const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".mode-btn[data-mode]"));
    const relicRanges: Record<string, string> = {
      pveearly: "Chapters 1-39 and Relic Level 0-10",
      pvemidgame: "Chapters 40-55 and Relic Level 10-30",
      pveendgame: "Chapters 55+ and Relic Level 30+",
      pvpearly: "Early PVP · Relic Level 0-10",
      pvpmidgame: "Mid PVP · Relic Level 10-30",
      pvpendgame: "Late PVP · Relic Level 30+",
    };

    let currentField = "pveearly";

    function currentMode(): "pve" | "pvp" {
      return currentField.startsWith("pvp") ? "pvp" : "pve";
    }

    // ---- Filter bar (search + single-select chip clusters) ----

    const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
    const resetButton = document.getElementById("resetFilters");
    const filterFabBadge = document.getElementById("filterFabBadge");
    const searchClear = document.getElementById("searchClear") as HTMLButtonElement | null;
    const roleChips = document.querySelectorAll(".role-chip");
    const classChips = document.querySelectorAll(".class-chip");
    const factionChips = document.querySelectorAll(".faction-chip");
    const rarityChips = document.querySelectorAll(".rarity-chip");
    const allChips = document.querySelectorAll<HTMLElement>(".all-chip");

    let activeRoles = new Set<string>();
    let activeClasses = new Set<string>();
    let activeRarities = new Set<string>();
    let activeFactions = new Set<string>();

    const filterSets: Record<string, Set<string> | undefined> = {
      class: activeClasses,
      role: activeRoles,
      rarity: activeRarities,
      faction: activeFactions,
    };

    function syncAllChips() {
      allChips.forEach(chip => {
        const set = filterSets[chip.dataset.group || ""];
        chip.classList.toggle("active", !set || set.size === 0);
      });
    }

    function matchesFilters(el: HTMLElement): boolean {
      const query = ((searchInput as HTMLInputElement)?.value || "").toLowerCase();
      const name = el.dataset.name || "";
      const cls = el.dataset.class || "";
      const role = el.dataset.role || "";
      const rarity = el.dataset.rarity || "";
      const faction = el.dataset.faction || "";

      return (
        (!query || name.includes(query) || cls.includes(query) || role.includes(query) || faction.includes(query) || rarity.includes(query)) &&
        (activeClasses.size === 0 || activeClasses.has(cls)) &&
        (activeRoles.size === 0 || activeRoles.has(role)) &&
        (activeRarities.size === 0 || activeRarities.has(rarity)) &&
        (activeFactions.size === 0 || activeFactions.has(faction))
      );
    }

    function applyFilters() {
      syncAllChips();
      heroCards.forEach(card => {
        card.style.display = matchesFilters(card) ? "" : "none";
      });
      tierSections.forEach(section => {
        const visible = Array.from(section.querySelectorAll<HTMLElement>(".hero-wrapper"))
          .filter(card => card.style.display !== "none").length;
        section.hidden = section.dataset.baseHidden === "true" || visible === 0;
        section.querySelectorAll<HTMLElement>("[data-tier-class-column]").forEach(column => {
          const columnVisible = Array.from(column.querySelectorAll<HTMLElement>(".hero-wrapper"))
            .some(card => card.style.display !== "none");
          column.classList.toggle("is-empty", !columnVisible);
        });
      });
      updateFabBadge();
    }

    function updateFabBadge() {
      const count = activeClasses.size + activeRoles.size + activeRarities.size + activeFactions.size + ((searchInput as HTMLInputElement)?.value.trim() ? 1 : 0);
      if (filterFabBadge) {
        filterFabBadge.textContent = count > 0 ? String(count) : "";
      }
    }

    // Single-select within each cluster: clicking an option swaps the selection
    // to that option; clicking the active option again deselects it (back to "All").
    function bindSingleSelect(chips: NodeListOf<Element>, set: Set<string>, valueAttr: string) {
      chips.forEach(chip => {
        chip.addEventListener("click", () => {
          const value = (chip as HTMLElement).dataset[valueAttr] || "";
          if (set.has(value)) {
            set.delete(value);
            chip.classList.remove("active");
          } else {
            set.clear();
            chips.forEach(c => c.classList.remove("active"));
            set.add(value);
            chip.classList.add("active");
          }
          applyFilters();
        });
      });
    }

    bindSingleSelect(classChips, activeClasses, "class");
    bindSingleSelect(roleChips, activeRoles, "role");
    bindSingleSelect(factionChips, activeFactions, "faction");
    bindSingleSelect(rarityChips, activeRarities, "rarity");

    // "All" chips: clear the specific selection of their group
    allChips.forEach(chip => {
      chip.addEventListener("click", () => {
        const group = chip.dataset.group || "";
        const set = filterSets[group];
        if (!set || set.size === 0) return;
        set.clear();
        document.querySelectorAll(`.${group}-chip`).forEach(c => c.classList.remove("active"));
        applyFilters();
      });
    });

    searchInput?.addEventListener("input", applyFilters);

    searchClear?.addEventListener("click", () => {
      (searchInput as HTMLInputElement).value = "";
      searchInput?.dispatchEvent(new Event("input"));
      searchInput?.focus();
    });

    resetButton?.addEventListener("click", () => {
      (searchInput as HTMLInputElement).value = "";
      activeClasses.clear();
      activeRarities.clear();
      activeRoles.clear();
      activeFactions.clear();
      document.querySelectorAll(".chip.active, .role-chip.active").forEach(c => c.classList.remove("active"));
      applyRating(currentField);
    });

    function applyRating(field: string) {
      currentField = field;
      heroCards.forEach(card => {
        const tier = card.getAttribute(`data-rating-${field}`) || "N/A";
        const section = sectionByTier.get(tier) ?? sectionByTier.get("N/A");
        const tierClass = card.dataset.tierClass || "other";
        section?.querySelector(`[data-tier-class-column="${tierClass}"] .tier-class-heroes`)?.appendChild(card);
      });

      tierSections.forEach(section => {
        const count = section.querySelectorAll(".hero-wrapper").length;
        const tier = section.querySelector<HTMLElement>(".tier-label")?.dataset.tier;
        const baseHidden = tier === "N/A" || count === 0;
        section.dataset.baseHidden = String(baseHidden);
        section.hidden = baseHidden;
        section.querySelectorAll<HTMLElement>("[data-tier-class-column]").forEach(column => {
          column.classList.toggle("is-empty", !column.querySelector(".hero-wrapper"));
        });
      });

      applyFilters();

      if (rankingKicker) rankingKicker.textContent = currentMode() === "pvp" ? "PVP Ranking" : "PVE Ranking";
      if (rankingRelicRange) rankingRelicRange.textContent = relicRanges[field] || "";

      if (rankingCoverage) {
        const total = Number(rankingCoverage.dataset.total || "0");
        const missing = Number(rankingCoverage.dataset.missing || "0");
        const showCoverage = currentMode() === "pvp" && missing > 0;
        rankingCoverage.hidden = !showCoverage;
        if (showCoverage) {
          rankingCoverage.textContent = `PVP ratings available for ${total - missing} of ${total} heroes`;
        }
      }

      modeBtns.forEach(btn => btn.classList.toggle("is-active", btn.dataset.mode === currentMode()));

      const stage = field.replace(/^(pve|pvp)/, "");
      const url = new URL(window.location.href);
      currentMode() === "pve" ? url.searchParams.delete("mode") : url.searchParams.set("mode", "pvp");
      stage === "early" ? url.searchParams.delete("stage") : url.searchParams.set("stage", stage);
      url.searchParams.delete("rating");
      url.searchParams.delete("role");
      window.history.replaceState({}, "", url);
    }

    function selectRating(field: string) {
      const stage = field.replace(/^(pve|pvp)/, "");
      ratingTabs.forEach(tab => tab.classList.toggle("is-active", tab.dataset.rating === `pve${stage}`));
      applyRating(field);
    }

    ratingTabs.forEach(tab => tab.addEventListener("click", () => {
      selectRating(`${currentMode()}${(tab.dataset.rating || "pveearly").replace(/^pve|pvp/, "")}`);
    }));

    modeBtns.forEach(btn => btn.addEventListener("click", () => {
      const mode = btn.dataset.mode || "pve";
      if (mode === currentMode()) return;
      selectRating(currentField.replace(/^(pve|pvp)/, mode));
    }));

    // Initial state: ?mode=pvp&stage=midgame (legacy ?rating=pvemidgame still read)
    const url = new URL(window.location.href);
    const modeParam = url.searchParams.get("mode") === "pvp" ? "pvp" : "pve";
    const stageParam = url.searchParams.get("stage") || (url.searchParams.get("rating") || "").replace(/^(pve|pvp)/, "") || "early";
    const requestedField = modeParam + stageParam;
    const validStages = ratingTabs.map(tab => (tab.dataset.rating || "").replace(/^pve|pvp/, ""));
    const initialField = validStages.includes(stageParam) ? requestedField : `${modeParam}early`;
    selectRating(initialField);
  });
</script>
