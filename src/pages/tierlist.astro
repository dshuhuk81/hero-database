---
export const prerender = true;

import HeroCard from "../components/HeroCard.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { heroes } from "../data/heroes/withRatings";

const isSharedPreview = Astro.url.pathname.replace(/\/+$/, "") === "/previews/tierlist";

const compareNewFirst = (a, b) => {
  if (a.newHero === b.newHero) return 0;
  return a.newHero ? -1 : 1;
};

const hasCompletePveRatings = (hero: (typeof heroes)[number]) => [
  hero.ratings?.pveearly,
  hero.ratings?.pvemidgame,
  hero.ratings?.pveendgame,
].every(Boolean);

const hasCompletePvpRatings = (hero: (typeof heroes)[number]) => [
  hero.ratings?.pvpearly,
  hero.ratings?.pvpmidgame,
  hero.ratings?.pvpendgame,
].every(Boolean);

const eligibleHeroes = heroes.filter(hero => import.meta.env.DEV || hero.release !== false);
const missingPveCount = eligibleHeroes.filter(hero => !hasCompletePveRatings(hero)).length;
const missingPvpCount = eligibleHeroes.filter(hero => !hasCompletePvpRatings(hero)).length;

const sortedHeroes = [...eligibleHeroes]
  .filter(hasCompletePveRatings)
  .sort((a, b) => compareNewFirst(a, b) || a.name.localeCompare(b.name, "en", { sensitivity: "base" }));

const tierOrder = ["S+", "S", "A", "B", "C", "D", "N/A"];
const tierGroups = tierOrder.map((tier, rank) => ({
    tier,
    rank,
    heroes: sortedHeroes.filter(hero => (hero.ratings?.pveearly || "N/A") === tier),
  }));

const ratingFields = [
  { key: "pveearly", label: "Early" },
  { key: "pvemidgame", label: "Mid" },
  { key: "pveendgame", label: "Lategame" },
];

const tierClasses = [
  { value: "carry", label: "Carries" },
  { value: "supports", label: "Supports" },
  { value: "tanks", label: "Tanks" },
  { value: "utility", label: "Utility" },
  { value: "other", label: "Other" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Motto Immortal Hero Tier List",
  numberOfItems: sortedHeroes.length,
  itemListElement: sortedHeroes.map((hero, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: hero.name,
    url: new URL(`/heroes/${hero.id}/`, Astro.site).href,
  })),
};
---

<Base
  title="Hero Tier List | Motto Immortal Database"
  description="Compare Motto Immortal heroes by PvE ratings across early, mid and endgame progression."
  jsonLd={jsonLd}
  robots={isSharedPreview ? "noindex, nofollow" : undefined}
>
  <PageHero
    id="tierlist"
    tag="Hero Rankings"
    headline="Hero tier list"
    subtitle="Compare heroes by mode and stage of progression"
  />

  <div class="page-wrapper heros-page-wrapper page-content">
    <div class="resultcontent">
      <p class="rating-coverage">
        Fehlende Heldeninfos: PvE ({missingPveCount}), PvP ({missingPvpCount})
      </p>

      <section class="rating-picker" aria-label="Ranking filter">
        <fieldset class="rating-picker-group">
          <legend>Ranking</legend>
          <div class="rating-options rating-options-main">
            {ratingFields.map(field => (
              <label class="rating-option">
                <input
                  type="radio"
                  name="tier-rating"
                  value={field.key}
                  checked={field.key === "pveearly"}
                />
                <span>{field.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="rating-picker-group role-picker">
          <legend>Role</legend>
          <div class="rating-options rating-options-role">
            {tierClasses.map(tierClass => (
              <button
                class="rating-option role-option"
                type="button"
                data-tier-class={tierClass.value}
                aria-pressed="false"
              >
                <span>{tierClass.label}</span>
              </button>
            ))}
          </div>
        </fieldset>
      </section>

      <div class="sort-bar">
        <div>
          <p class="ranking-kicker"><span id="rankingTitle">PvE · Early</span> ranking</p>
          <p id="heroCounter" class="hero-counter">{sortedHeroes.length} heroes</p>
        </div>
        <div class="sort-controls">
          <button id="rankDirection" class="rank-direction" type="button" aria-label="Show lowest rankings first">
            <span>Best first</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 5v14"/><path d="m7 14 5 5 5-5"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="tier-list" id="tierList">
        {tierGroups.map(group => (
          <section class="tier-row" data-tier-section data-rank={group.rank} hidden={group.heroes.length === 0}>
            <header class="tier-label" data-tier={group.tier}>
              <span class="tier-name">{group.tier}</span>
              <span class="tier-count" data-tier-count>{group.heroes.length}</span>
            </header>
            <div class="tier-heroes">
              {group.heroes.map(hero => (
                <div
                  class={`hero-wrapper rarity-${hero.rarity.toLowerCase()}`}
                  data-sort-order={sortedHeroes.indexOf(hero)}
                  data-name={hero.name.toLowerCase()}
                  data-class={hero.class.toLowerCase()}
                  data-role={hero.role.toLowerCase()}
                  data-tier-class={hero.tierClass.toLowerCase()}
                  data-faction={hero.faction.toLowerCase()}
                  data-rarity={hero.rarity.toLowerCase()}
                  data-tags={hero.synergies?.join("|").toLowerCase() || ""}
                  data-rating-overall={hero.ratings?.overall || "N/A"}
                  data-rating-pveearly={hero.ratings?.pveearly || "N/A"}
                  data-rating-pvemidgame={hero.ratings?.pvemidgame || "N/A"}
                  data-rating-pveendgame={hero.ratings?.pveendgame || "N/A"}
                  data-rating-pvpearly={hero.ratings?.pvpearly || "N/A"}
                  data-rating-pvpmidgame={hero.ratings?.pvpmidgame || "N/A"}
                  data-rating-pvpendgame={hero.ratings?.pvpendgame || "N/A"}
                >
                  <HeroCard hero={hero} showRating={false} showNewBadge={false} />
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  .resultcontent {
    width: 100%;
  }

  .rating-coverage {
    margin: var(--space-8) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .rating-picker {
    margin-top: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--bg-surface) 88%, transparent);
  }

  .rating-picker-group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .rating-picker-group legend {
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .role-picker {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .rating-options {
    display: grid;
    gap: var(--space-2);
  }

  .rating-options-main {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .rating-options-role {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .rating-option {
    min-width: 0;
    cursor: pointer;
  }

  button.rating-option {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }

  .rating-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .rating-option span {
    display: flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--input-bg);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-align: center;
    transition: border-color var(--duration-fast), background var(--duration-fast), color var(--duration-fast);
  }

  .rating-option:hover span {
    border-color: var(--border-strong);
    color: var(--text-bright);
  }

  .rating-option input:focus-visible + span {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .role-option:focus-visible span {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .rating-option input:checked + span {
    border-color: var(--accent-gold);
    background: color-mix(in srgb, var(--accent-gold) 14%, var(--input-bg));
    color: var(--text-bright);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-gold) 28%, transparent);
  }

  .role-option[aria-pressed="true"] span {
    border-color: var(--accent-gold);
    background: color-mix(in srgb, var(--accent-gold) 14%, var(--input-bg));
    color: var(--text-bright);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-gold) 28%, transparent);
  }

  .sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: var(--space-8) 0 var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-counter {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .ranking-kicker {
    margin: 0;
    color: var(--text-bright);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .sort-controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .rank-direction {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--input-bg);
    color: var(--text-bright);
    padding: 9px var(--space-3);
    font: inherit;
    cursor: pointer;
  }

  .rank-direction:hover {
    background: var(--chip-bg-hover);
  }

  .rank-direction svg {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .rank-direction.reversed svg {
    transform: rotate(180deg);
  }

  .tier-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tier-row {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    min-height: 200px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--bg-surface) 82%, transparent);
  }

  .tier-row[hidden] {
    display: none;
  }

  .tier-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--input-bg);
  }

  .tier-label[data-tier="S+"] { background: linear-gradient(145deg, var(--tier-splus-from), var(--tier-splus-to)); }
  .tier-label[data-tier="S"] { background: linear-gradient(145deg, var(--tier-s-from), var(--tier-s-to)); }
  .tier-label[data-tier="A"] { background: linear-gradient(145deg, var(--tier-a-from), var(--tier-a-to)); }
  .tier-label[data-tier="B"] { background: linear-gradient(145deg, var(--tier-b-from), var(--tier-b-to)); }
  .tier-label[data-tier="C"] { background: linear-gradient(145deg, var(--tier-c-from), var(--tier-c-to)); }
  .tier-label[data-tier="D"] { background: linear-gradient(145deg, var(--tier-d-from), var(--tier-d-to)); }
  .tier-label[data-tier="N/A"] { background: var(--input-bg); }

  .tier-name {
    color: white;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: var(--weight-bold);
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .tier-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 24px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.24);
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .tier-heroes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .hero-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    min-width: 0;
  }

  .hero-wrapper.rarity-common { border: 1px solid var(--rarity-common-border); }
  .hero-wrapper.rarity-epic { border: 1px solid var(--rarity-epic-border); }
  .hero-wrapper.rarity-legendary { border: 1px solid var(--rarity-legendary-border); }

  .hero-wrapper :global(.hero-card) {
    height: 190px;
  }

  @media (max-width: 600px) {
    .rating-picker {
      padding: var(--space-4);
    }

    .rating-options-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rating-options-role {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tier-row {
      grid-template-columns: 58px minmax(0, 1fr);
      min-height: 160px;
    }

    .tier-name { font-size: 1.65rem; }
    .tier-heroes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
      padding: var(--space-2);
    }
    .hero-wrapper :global(.hero-card) { height: 170px; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const heroCounter = document.getElementById("heroCounter");
    const rankingTitle = document.getElementById("rankingTitle");
    const tierList = document.getElementById("tierList") as HTMLElement;
    const tierSections = Array.from(document.querySelectorAll<HTMLElement>("[data-tier-section]"));
    const rankDirection = document.getElementById("rankDirection") as HTMLButtonElement;
    const roleOptions = Array.from(document.querySelectorAll<HTMLButtonElement>(".role-option[data-tier-class]"));
    const heroCards = Array.from(document.querySelectorAll<HTMLElement>(".hero-wrapper"))
      .sort((a, b) => Number(a.dataset.sortOrder) - Number(b.dataset.sortOrder));
    const ratingInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="tier-rating"]'));
    const sectionByTier = new Map(tierSections.map(section => [section.querySelector<HTMLElement>(".tier-label")?.dataset.tier || "N/A", section]));
    const labels: Record<string, string> = {
      pveearly: "PvE · Early",
      pvemidgame: "PvE · Mid",
      pveendgame: "PvE · Lategame",
    };

    let reversed = false;
    let activeRole = "";
    let activeField = "pveearly";

    function orderSections() {
      [...tierSections]
        .sort((a, b) => {
          const aRank = Number(a.dataset.rank);
          const bRank = Number(b.dataset.rank);
          const unratedRank = tierSections.length - 1;
          if (aRank === unratedRank) return 1;
          if (bRank === unratedRank) return -1;
          const difference = aRank - bRank;
          return reversed ? -difference : difference;
        })
        .forEach(section => tierList.appendChild(section));
    }

    function applyRating(field: string) {
      activeField = field;

      heroCards.forEach(card => {
        const tier = card.getAttribute(`data-rating-${field}`) || "N/A";
        const section = sectionByTier.get(tier) ?? sectionByTier.get("N/A");
        section?.querySelector(".tier-heroes")?.appendChild(card);
        card.hidden = Boolean(activeRole) && card.dataset.tierClass !== activeRole;
      });

      let rated = 0;
      tierSections.forEach(section => {
        const count = section.querySelectorAll(".hero-wrapper:not([hidden])").length;
        const tier = section.querySelector<HTMLElement>(".tier-label")?.dataset.tier;
        section.hidden = tier === "N/A" || count === 0;
        if (tier !== "N/A") rated += count;
        const countElement = section.querySelector("[data-tier-count]");
        if (countElement) countElement.textContent = String(count);
      });

      if (rankingTitle) rankingTitle.textContent = labels[field] || "Overall";
      if (heroCounter) {
        heroCounter.textContent = `${rated} ${rated === 1 ? "hero" : "heroes"}`;
      }

      const url = new URL(window.location.href);
      field === "pveearly" ? url.searchParams.delete("rating") : url.searchParams.set("rating", field);
      if (!activeRole) url.searchParams.delete("role");
      else url.searchParams.set("role", activeRole);
      window.history.replaceState({}, "", url);
      orderSections();
    }

    rankDirection.addEventListener("click", () => {
      reversed = !reversed;
      orderSections();
      rankDirection.classList.toggle("reversed", reversed);
      rankDirection.querySelector("span")!.textContent = reversed ? "Lowest first" : "Best first";
      rankDirection.setAttribute("aria-label", reversed ? "Show best rankings first" : "Show lowest rankings first");
    });

    ratingInputs.forEach(input => input.addEventListener("change", () => applyRating(input.value)));

    roleOptions.forEach(option => {
      option.addEventListener("click", () => {
        const selectedRole = option.dataset.tierClass || "";
        activeRole = activeRole === selectedRole ? "" : selectedRole;
        roleOptions.forEach(item => item.setAttribute("aria-pressed", String(item.dataset.tierClass === activeRole)));
        applyRating(activeField);
      });
    });

    const url = new URL(window.location.href);
    const requestedField = url.searchParams.get("rating") || "pveearly";
    const initialInput = ratingInputs.find(input => input.value === requestedField) ?? ratingInputs[0];
    const requestedRole = url.searchParams.get("role") || "";
    if (roleOptions.some(option => option.dataset.tierClass === requestedRole)) {
      activeRole = requestedRole;
      roleOptions.forEach(item => item.setAttribute("aria-pressed", String(item.dataset.tierClass === activeRole)));
    }
    if (initialInput) {
      initialInput.checked = true;
      applyRating(initialInput.value);
    }
  });
</script>
