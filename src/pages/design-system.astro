---
export const prerender = true;
import Base from "../layouts/Base.astro";
import ContentState from "../components/ui/ContentState.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import SurfacePanel from "../components/ui/SurfacePanel.astro";
---

<Base title="Design System | Motto Immortal">

<div class="ds-page">

  <header class="ds-header">
    <p class="ds-kicker">INTERNAL</p>
    <h1 class="ds-title">Design System</h1>
    <p class="ds-subtitle">Tokens, patterns, and components. Use as reference when building new pages.</p>
    <nav class="ds-nav">
      <a href="#colors">Colors</a>
      <a href="#typography">Typography</a>
      <a href="#spacing">Spacing</a>
      <a href="#radii">Radii</a>
      <a href="#shadows">Shadows</a>
      <a href="#tiers">Tier Ratings</a>
      <a href="#rarity">Rarity</a>
      <a href="#experience-primitives">Experience Primitives</a>
      <a href="#css-components">CSS Components</a>
      <a href="#astro-components">Astro Components</a>
    </nav>
  </header>


  <!-- =====================================================
       COLORS
       ===================================================== -->
  <section id="colors" class="ds-section">
    <h2 class="ds-section-title">Colors</h2>

    <h3 class="ds-group-title">Backgrounds</h3>
    <div class="ds-swatch-row">
      <div class="ds-swatch" style="background:var(--bg-base)"><span>--bg-base</span><span>#07060c</span></div>
      <div class="ds-swatch" style="background:var(--bg-surface)"><span>--bg-surface</span><span>#0d0b14</span></div>
      <div class="ds-swatch" style="background:var(--bg-raised)"><span>--bg-raised</span><span>#13111c</span></div>
      <div class="ds-swatch" style="background:var(--bg-overlay)"><span>--bg-overlay</span><span>#1a1726</span></div>
    </div>

    <h3 class="ds-group-title">Text</h3>
    <div class="ds-swatch-row">
      <div class="ds-swatch ds-swatch--dark" style="background:rgba(0,0,0,0.3)"><span style="color:var(--text-bright)">--text-bright</span><span style="color:var(--text-bright)">#f4f1ff</span></div>
      <div class="ds-swatch ds-swatch--dark" style="background:rgba(0,0,0,0.3)"><span style="color:var(--text-primary)">--text-primary</span><span style="color:var(--text-primary)">#e6e6eb</span></div>
      <div class="ds-swatch ds-swatch--dark" style="background:rgba(0,0,0,0.3)"><span style="color:var(--text-secondary)">--text-secondary</span><span style="color:var(--text-secondary)">70%</span></div>
      <div class="ds-swatch ds-swatch--dark" style="background:rgba(0,0,0,0.3)"><span style="color:var(--text-muted)">--text-muted</span><span style="color:var(--text-muted)">45%</span></div>
      <div class="ds-swatch ds-swatch--dark" style="background:rgba(0,0,0,0.3)"><span style="color:var(--text-disabled)">--text-disabled</span><span style="color:var(--text-disabled)">25%</span></div>
    </div>

    <h3 class="ds-group-title">Accents</h3>
    <div class="ds-swatch-row">
      <div class="ds-swatch" style="background:var(--accent-gold)"><span style="color:#000">--accent-gold</span><span style="color:#000">#facc15</span></div>
      <div class="ds-swatch" style="background:var(--accent-gold-dim)"><span>--accent-gold-dim</span></div>
      <div class="ds-swatch" style="background:var(--accent-purple)"><span>--accent-purple</span><span>#a855f7</span></div>
      <div class="ds-swatch" style="background:var(--accent-purple-dim)"><span>--accent-purple-dim</span></div>
      <div class="ds-swatch" style="background:var(--accent-teal)"><span>--accent-teal</span><span>#406a5f</span></div>
      <div class="ds-swatch" style="background:var(--accent-new)"><span>--accent-new</span><span>#15b109</span></div>
    </div>

    <h3 class="ds-group-title">Borders</h3>
    <div class="ds-border-row">
      <div class="ds-border-demo" style="border:1px solid var(--border-faint)">--border-faint <code>5%</code></div>
      <div class="ds-border-demo" style="border:1px solid var(--border-subtle)">--border-subtle <code>8%</code></div>
      <div class="ds-border-demo" style="border:1px solid var(--border-medium)">--border-medium <code>15%</code></div>
      <div class="ds-border-demo" style="border:1px solid var(--border-strong)">--border-strong <code>28%</code></div>
    </div>
  </section>


  <!-- =====================================================
       TYPOGRAPHY
       ===================================================== -->
  <section id="typography" class="ds-section">
    <h2 class="ds-section-title">Typography</h2>

    <div class="ds-type-scale">
      <div class="ds-type-row"><span class="ds-type-label">--text-xs 11px</span><span style="font-size:11px">The quick brown fox</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--text-sm 13px</span><span style="font-size:13px">The quick brown fox</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--text-base 15px</span><span style="font-size:15px">The quick brown fox</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--text-md 16px</span><span style="font-size:16px">The quick brown fox</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--text-lg 18px</span><span style="font-size:18px">The quick brown fox</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--text-xl 20px</span><span style="font-size:20px">The quick brown fox</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--text-2xl 24px</span><span style="font-size:24px">The quick brown fox</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--text-3xl 30px</span><span style="font-size:30px">The quick brown fox</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--text-4xl 38px</span><span style="font-size:38px">The quick brown fox</span></div>
    </div>

    <h3 class="ds-group-title">Weights</h3>
    <div class="ds-type-scale">
      <div class="ds-type-row"><span class="ds-type-label">--weight-normal 400</span><span style="font-weight:400;font-size:16px">Hero Database</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--weight-medium 500</span><span style="font-weight:500;font-size:16px">Hero Database</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--weight-semibold 600</span><span style="font-weight:600;font-size:16px">Hero Database</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--weight-bold 700</span><span style="font-weight:700;font-size:16px">Hero Database</span></div>
      <div class="ds-type-row"><span class="ds-type-label">--weight-black 900</span><span style="font-weight:900;font-size:16px">Hero Database</span></div>
    </div>
  </section>


  <!-- =====================================================
       SPACING
       ===================================================== -->
  <section id="spacing" class="ds-section">
    <h2 class="ds-section-title">Spacing Scale</h2>
    <div class="ds-space-grid">
      {[
        ["--space-1","4px"],["--space-2","8px"],["--space-3","12px"],["--space-4","16px"],
        ["--space-5","20px"],["--space-6","24px"],["--space-8","32px"],["--space-10","40px"],
        ["--space-12","48px"],["--space-16","64px"],["--space-20","80px"],["--space-24","96px"],
      ].map(([token, size]) => (
        <div class="ds-space-row">
          <span class="ds-space-label">{token}<br/><small>{size}</small></span>
          <div class="ds-space-bar" style={`width:${size}; min-width:4px;`}></div>
        </div>
      ))}
    </div>
    <p class="ds-note">Named aliases: --space-xs=4px, --space-sm=8px, --space-md=16px, --space-lg=24px, --space-xl=32px, --space-2xl=48px, --space-3xl=64px</p>
  </section>


  <!-- =====================================================
       RADII
       ===================================================== -->
  <section id="radii" class="ds-section">
    <h2 class="ds-section-title">Border Radii</h2>
    <div class="ds-radii-row">
      {[
        ["--radius-sm","4px"],["--radius-md","8px"],["--radius-lg","12px"],
        ["--radius-xl","16px"],["--radius-2xl","20px"],["--radius-full","9999px"],
      ].map(([token, val]) => (
        <div class="ds-radius-demo">
          <div class="ds-radius-box" style={`border-radius:${val}`}></div>
          <span>{token}</span>
          <small>{val}</small>
        </div>
      ))}
    </div>
  </section>


  <!-- =====================================================
       SHADOWS
       ===================================================== -->
  <section id="shadows" class="ds-section">
    <h2 class="ds-section-title">Shadows</h2>
    <p class="ds-note">Use shadows only for floating elements (dropdowns, modals, tooltips). Prefer bg tints for elevation.</p>
    <div class="ds-shadow-row">
      <div class="ds-shadow-demo" style="box-shadow:var(--shadow-sm)">--shadow-sm</div>
      <div class="ds-shadow-demo" style="box-shadow:var(--shadow-md)">--shadow-md</div>
      <div class="ds-shadow-demo" style="box-shadow:var(--shadow-lg)">--shadow-lg</div>
      <div class="ds-shadow-demo" style="box-shadow:var(--shadow-xl)">--shadow-xl</div>
    </div>
  </section>


  <!-- =====================================================
       TIER RATINGS
       ===================================================== -->
  <section id="tiers" class="ds-section">
    <h2 class="ds-section-title">Tier Ratings</h2>
    <p class="ds-note">Usage: <code>&lt;span class="rating-badge" data-tier="SSS"&gt;SSS&lt;/span&gt;</code></p>
    <div class="ds-tier-row">
      <span class="rating-badge" data-tier="SSS">SSS</span>
      <span class="rating-badge" data-tier="SS">SS</span>
      <span class="rating-badge" data-tier="S">S</span>
      <span class="rating-badge" data-tier="A">A</span>
      <span class="rating-badge" data-tier="B">B</span>
      <span class="rating-badge" data-tier="C">C</span>
      <span class="rating-badge" data-tier="D">D</span>
    </div>
    <div class="ds-tier-vars">
      {[
        ["SSS","#ff4d4d","#b91c1c"],["SS","#ffe066","#facc15"],["S","#fde68a","#fbbf24"],
        ["A","#fdba74","#fb923c"],["B","#c4b5fd","#8b5cf6"],["C","#93c5fd","#3b82f6"],["D","#5eead4","#14b8a6"],
      ].map(([tier, from, to]) => (
        <div class="ds-tier-var-row">
          <span class="rating-badge" data-tier={tier}>{tier}</span>
          <code>--tier-{tier.toLowerCase()}-from: {from}</code>
          <code>--tier-{tier.toLowerCase()}-to: {to}</code>
        </div>
      ))}
    </div>
  </section>


  <!-- =====================================================
       RARITY
       ===================================================== -->
  <section id="rarity" class="ds-section">
    <h2 class="ds-section-title">Rarity</h2>
    <p class="ds-note">Used as border + glow on .hero-wrapper cards in heros.astro.</p>
    <div class="ds-rarity-row">
      <div class="ds-rarity-demo" style="border-color:var(--rarity-common-border)">Common<br/><small>--rarity-common-border</small></div>
      <div class="ds-rarity-demo" style="border-color:var(--rarity-rare-border)">Rare<br/><small>--rarity-rare-border</small></div>
      <div class="ds-rarity-demo" style="border-color:var(--rarity-epic-border)">Epic<br/><small>--rarity-epic-border</small></div>
      <div class="ds-rarity-demo" style="border-color:var(--rarity-legendary-border)">Legendary<br/><small>--rarity-legendary-border</small></div>
    </div>
  </section>

  <!-- =====================================================
       EXPERIENCE PRIMITIVES
       ===================================================== -->
  <section id="experience-primitives" class="ds-section">
    <h2 class="ds-section-title">Experience Primitives</h2>
    <p class="ds-note">Foundations for pages following <code>STYLE_GUIDELINES.md</code>. Review these before migrating individual page families.</p>

    <div class="ds-component-block">
      <h3 class="ds-component-name">Section Header</h3>
      <SectionHeader
        kicker="Hero Database"
        title="Make the next decision clear"
        description="A dominant heading, a concise explanation, and an optional action establish hierarchy without decorative clutter."
      >
        <a slot="actions" class="action-button action-button--primary" href="#experience-primitives">Primary action</a>
      </SectionHeader>
    </div>

    <div class="ds-component-block">
      <h3 class="ds-component-name">Surface Hierarchy</h3>
      <div class="ds-primitive-grid">
        <SurfacePanel>
          <p class="content-heading-kicker">Raised panel</p>
          <h3 class="ds-primitive-title">Comparable or reusable content</h3>
          <p class="ds-note">Use borders and surface contrast instead of heavy shadows.</p>
        </SurfacePanel>
        <SurfacePanel variant="quiet">
          <p class="content-heading-kicker">Quiet panel</p>
          <h3 class="ds-primitive-title">Supporting information</h3>
          <p class="ds-note">A lower-emphasis surface for secondary context.</p>
        </SurfacePanel>
      </div>
    </div>

    <div class="ds-component-block">
      <h3 class="ds-component-name">Toolbar and Tabs</h3>
      <div class="control-toolbar">
        <div class="control-toolbar-group control-toolbar-group--grow">
          <button class="action-button action-button--quiet" type="button">Filter</button>
          <button class="action-button action-button--quiet" type="button">Sort</button>
        </div>
        <p class="control-toolbar-meta">74 results</p>
      </div>
      <div class="tab-strip ds-primitive-tabs" role="tablist" aria-label="Primitive tab example">
        <button class="tab-strip-item is-active" type="button" role="tab" aria-selected="true">Overview</button>
        <button class="tab-strip-item" type="button" role="tab" aria-selected="false">Build</button>
        <button class="tab-strip-item" type="button" role="tab" aria-selected="false">Teams</button>
      </div>
    </div>

    <div class="ds-component-block">
      <h3 class="ds-component-name">Lean Content List</h3>
      <div class="content-list">
        <a class="content-list-item" href="#experience-primitives">
          <span class="content-list-item-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 18h4M4 12h9M4 6h14"/><path d="m16 15 3 3 3-3M19 10v8"/></svg>
          </span>
          <span class="content-list-item-copy">
            <span class="content-list-item-title">Hero rankings</span>
            <span class="content-list-item-description">Compare heroes without turning every destination into a large card.</span>
          </span>
          <span class="content-list-item-action" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="ds-component-block">
      <h3 class="ds-component-name">Content State</h3>
      <ContentState
        title="Nothing to show yet"
        description="Missing and future data should be stated clearly without creating a misleading empty card grid."
      >
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
        <button slot="actions" class="action-button action-button--quiet" type="button">Secondary action</button>
      </ContentState>
    </div>
  </section>


  <!-- =====================================================
       CSS COMPONENTS
       ===================================================== -->
  <section id="css-components" class="ds-section">
    <h2 class="ds-section-title">CSS Components</h2>
    <p class="ds-note">These are global classes from <code>components.css</code>. Import order: tokens -> reset -> base -> components.</p>

    <!-- page-wrapper / main-content / content-wrapper -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Layout Wrappers</h3>
      <div class="ds-component-meta">
        <div><code>.page-wrapper</code> -- max 1400px, horizontal gutter (var(--page-gutter)), defined in base.css</div>
        <div><code>.content-wrapper</code> -- full-width child inside page-wrapper</div>
        <div><code>.main-content</code> -- max 1200px centered, vertical padding --space-10/--space-20</div>
        <div><code>.page-header</code> + <code>.page-title</code> + <code>.page-subtitle</code> -- page heading block</div>
        <div><code>.separator</code> -- 2px gold horizontal rule</div>
      </div>
      <div style="background:var(--bg-raised);border-radius:var(--radius-md);padding:16px;margin-top:8px;">
        <div class="page-header">
          <p class="page-title">Page Title</p>
          <p class="page-subtitle">Subtitle goes here</p>
        </div>
        <div class="separator"></div>
      </div>
    </div>

    <!-- section-label / section-title -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Section Label + Title</h3>
      <div class="ds-component-meta">
        <div><code>.content-section</code> -- wrapper with bottom margin</div>
        <div><code>.section-label</code> -- gold uppercase kicker above heading</div>
        <div><code>.section-title</code> -- heading with decorative side bars (guides.astro goldstandard)</div>
      </div>
      <div class="content-section" style="margin-top:12px">
        <span class="section-label">SKILLS</span>
        <h3 class="section-title">Active Skills</h3>
      </div>
    </div>

    <!-- hero-chip -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Hero Chip</h3>
      <div class="ds-component-meta">
        <code>.hero-chip</code> + <code>.hero-chip-portrait</code> -- pill with portrait thumbnail and name.<br/>
        Usage: <code>&lt;a class="hero-chip"&gt;&lt;div class="hero-chip-portrait" style="background-image:url(...)"&gt;&lt;/div&gt;Name&lt;/a&gt;</code>
      </div>
      <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
        <a class="hero-chip" href="#">
          <div class="hero-chip-portrait" style="background-image:url(https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/zeus.webp)"></div>
          Zeus
        </a>
        <a class="hero-chip" href="#">
          <div class="hero-chip-portrait" style="background-image:url(https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/eris.webp)"></div>
          Eris
        </a>
      </div>
    </div>

    <!-- comp-entry -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Comp Entry</h3>
      <div class="ds-component-meta">
        <code>.comp-entry</code> -- team composition block. Children: <code>.comp-entry-header</code>, <code>.comp-label</code>, <code>.comp-reason</code>, <code>.comp-hero-row</code>, <code>.comp-notes</code>
      </div>
      <div class="comp-entry" style="margin-top:12px;max-width:480px">
        <div class="comp-entry-header">
          <span class="comp-label">Meta Comp</span>
          <p class="comp-reason">Best all-around lineup for boss content.</p>
        </div>
        <div class="comp-hero-row">
          <a class="hero-chip" href="#"><div class="hero-chip-portrait" style="background-image:url(https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/zeus.webp)"></div>Zeus</a>
          <a class="hero-chip" href="#"><div class="hero-chip-portrait" style="background-image:url(https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/heroes/eris.webp)"></div>Eris</a>
        </div>
        <ul class="comp-notes">
          <li>Requires Zeus at Mythic or higher.</li>
        </ul>
      </div>
    </div>

    <!-- rating-badge -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Rating Badge</h3>
      <div class="ds-component-meta">
        <code>.rating-badge</code> with <code>data-tier="SSS|SS|S|A|B|C|D"</code>. Gradients driven by tier tokens.
      </div>
      <div style="margin-top:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <span class="rating-badge" data-tier="SSS">SSS</span>
        <span class="rating-badge" data-tier="SS">SS</span>
        <span class="rating-badge" data-tier="S">S</span>
        <span class="rating-badge" data-tier="A">A</span>
        <span class="rating-badge" data-tier="B">B</span>
        <span class="rating-badge" data-tier="C">C</span>
      </div>
    </div>

    <!-- mechanic-box -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Mechanic Box</h3>
      <div class="ds-component-meta">
        <code>.mechanic-box</code> with optional <code>data-type="warning|phase|danger"</code>. Use <code>.mechanic-box-label</code> for the kicker.
      </div>
      <div style="margin-top:12px;display:flex;flex-direction:column;gap:8px;max-width:480px;">
        <div class="mechanic-box"><span class="mechanic-box-label">MECHANIC</span>Default teal style for general mechanics.</div>
        <div class="mechanic-box" data-type="warning"><span class="mechanic-box-label">WARNING</span>Gold style for important warnings.</div>
        <div class="mechanic-box" data-type="phase"><span class="mechanic-box-label">PHASE</span>Purple style for phase transitions.</div>
        <div class="mechanic-box" data-type="danger"><span class="mechanic-box-label">DANGER</span>Red style for wipe conditions.</div>
      </div>
    </div>

    <!-- stat-entry -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Stat Bar</h3>
      <div class="ds-component-meta">
        <code>.stat-entry</code> with <code>data-category="offense|defense|utility"</code>. Children: <code>.stat-label</code>, <code>.stat-bar-track &gt; .stat-bar-fill</code>, <code>.stat-value</code>
      </div>
      <div style="margin-top:12px;max-width:480px;">
        <div class="stat-entry" data-category="offense">
          <span class="stat-label">ATK</span>
          <div class="stat-bar-track"><div class="stat-bar-fill" style="width:80%"></div></div>
          <span class="stat-value">24,350</span>
        </div>
        <div class="stat-entry" data-category="defense">
          <span class="stat-label">Armor</span>
          <div class="stat-bar-track"><div class="stat-bar-fill" style="width:55%"></div></div>
          <span class="stat-value">14,200</span>
        </div>
        <div class="stat-entry" data-category="utility">
          <span class="stat-label">Crit Rate</span>
          <div class="stat-bar-track"><div class="stat-bar-fill" style="width:40%"></div></div>
          <span class="stat-value">18.5%</span>
        </div>
      </div>
    </div>

    <!-- sticky-page-header -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Sticky Page Header</h3>
      <div class="ds-component-meta">
        <code>.sticky-page-header</code> -- glassmorphism bar, position:sticky top:0, z-index var(--z-overlay). Used on detail pages like heroes/[id].astro.<br/>
        Note: avoid putting this inside a parent with <code>overflow:hidden</code> -- sticky will break.
      </div>
      <div style="position:relative;height:64px;border-radius:var(--radius-md);overflow:hidden;">
        <header class="sticky-page-header" style="position:absolute;">
          &larr; Back &nbsp;&nbsp; <strong>Hero Name</strong>
        </header>
      </div>
    </div>

    <!-- pill-tabbar -->
    <div class="ds-component-block">
      <h3 class="ds-component-name">Pill Tab Bar</h3>
      <div class="ds-component-meta">
