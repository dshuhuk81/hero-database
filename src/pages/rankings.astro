---
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { heroes } from "../data/heroes";
import { computeScore, computeScoreForScenario } from "../utils/rankingScore.js";
import { synergyPotentialForHero } from "../utils/synergyTags.js";
import { rateHeroSkills } from "../utils/skillAnalyzer.js";
import Analytics from '@vercel/analytics/astro';

const heroById = new Map(heroes.map((hero) => [hero.id, hero]));
const heroOptions = [...heroes].sort((a, b) => a.name.localeCompare(b.name));

const rows = await Promise.all(
  [...heroes].map(async (hero) => {
    const s = hero.stats ?? {};

    const score = await computeScore(hero);
    const scoreBoss = await computeScoreForScenario(hero, "boss");
    const scoreBossCtx = scoreBoss;
    const scoreCampaign = await computeScoreForScenario(hero, "campaign");
    const scorePvp = await computeScoreForScenario(hero, "pvp");
    const synergyPotential = await synergyPotentialForHero(hero);
    const skillPower = rateHeroSkills(hero);

    const bestScenarioLabelMap = {
      boss: "Boss",
      campaign: "Campaign",
      pvp: "PvP",
    } as const;
    const scenarioEntries = [
      ["boss", scoreBoss],
      ["campaign", scoreCampaign],
      ["pvp", scorePvp],
    ] as Array<[keyof typeof bestScenarioLabelMap, number]>;
    const [bestScenarioKey] = scenarioEntries.reduce(
      (best, current) => (current[1] > best[1] ? current : best),
      scenarioEntries[0]
    );
    const bestScenarioLabel = bestScenarioLabelMap[bestScenarioKey] || "Overall";

    return {
      hero,
      score,
      scoreBoss,
      scoreBossCtx,
      scoreCampaign,
      scorePvp,
      bestScenarioKey,
      bestScenarioLabel,
      synergyPotential,
      skillPower,
    };
  })
).then((results) =>
  results.sort((a, b) => b.score - a.score)
);

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rankings - Hero Database</title>
    <Analytics />
  </head>

  <body data-default-sort="score">
    <Sidebar />

    <!-- Maintenance Alert Dialog -->
