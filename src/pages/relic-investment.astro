---
export const prerender = true;

import { heroes } from "../data/heroes/withRatings";
import allInvest from "../data/ratings/invest.json";
import { pickLang, type LocalizedString } from "../i18n/helpers";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const investment = allInvest as Record<string, {
  relicRecommendation: LocalizedString;
  f2pInvestment?: LocalizedString;
}>;
const english = (value: LocalizedString) => pickLang(value, "en");

const rows = heroes
  .filter((hero) => (import.meta.env.DEV || hero.release !== false) && investment[hero.id])
  .map((hero) => ({ hero, investment: investment[hero.id] }))
  .sort((a, b) => a.hero.name.localeCompare(b.hero.name));
---

<Base
  title="Relic Investment | Motto Immortal Database"
  description="See the recommended relic and hero investment for every rated Motto Immortal hero."
>
  <PageHero
    id="relic-investment"
    tag="Hero Development"
    headline="Relic Investment"
    subtitle="The investment each hero needs, at a glance"
  />

  <main class="ri-page page-content">
    <div class="content-heading">
      <div class="content-heading-copy">
        <p class="content-heading-kicker">Investment guide</p>
        <h2 class="content-heading-title">Recommended targets</h2>
        <p class="content-heading-description">Prioritize the relic breakpoint that changes how a hero performs. The F2P target shows how far the hero is worth building before resources are better spent elsewhere.</p>
      </div>
    </div>

    <div class="ri-toolbar control-toolbar">
      <div class="control-toolbar-group control-toolbar-group--grow">
        <label class="ri-search-wrap">
          <span class="sr-only">Search heroes</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          <input id="riSearch" class="ri-search" type="search" placeholder="Search hero..." autocomplete="off" />
        </label>
      </div>
      <p id="riCount" class="ri-count control-toolbar-meta">{rows.length} heroes</p>
    </div>

    <div class="ri-list-head" aria-hidden="true">
      <span>Hero</span>
      <span>Relic target</span>
      <span>Hero investment</span>
    </div>

    <div id="riGrid" class="ri-list">
      {rows.map(({ hero, investment: entry }) => {
        const recommendation = english(entry.relicRecommendation);
        const heroInvestment = entry.f2pInvestment ? english(entry.f2pInvestment) : "—";
        return (
          <article
            class="ri-row"
            data-search={hero.name.toLowerCase()}
          >
            <a class="ri-hero" href={`/heroes/${hero.id}`}>
              <span class="ri-avatar" style={`background-image:url(${R2_BASE}/heroes/${hero.id}.webp)`}></span>
              <span class="ri-identity">
                <strong>{hero.name}</strong>
                <small>{hero.class} · {hero.faction}</small>
              </span>
            </a>
            <div class="ri-value ri-relic">
              <span class="ri-mobile-label">Relic target</span>
              <strong>{recommendation}</strong>
            </div>
            <div class="ri-value">
              <span class="ri-mobile-label">Hero investment</span>
              <strong>{heroInvestment}</strong>
            </div>
          </article>
        );
      })}
    </div>
    <p id="riEmpty" class="ri-empty" hidden>No heroes match your search.</p>
  </main>

  <script is:inline>
    (() => {
      const search = document.getElementById("riSearch");
      const cards = Array.from(document.querySelectorAll(".ri-row"));
      const count = document.getElementById("riCount");
      const empty = document.getElementById("riEmpty");
      if (!search) return;

      search.addEventListener("input", () => {
        const terms = search.value.toLowerCase().trim().split(/[&,;|]+/).map((term) => term.trim()).filter(Boolean);
        let shown = 0;
        cards.forEach((card) => {
          const haystack = card.getAttribute("data-search") || "";
          const match = terms.length === 0 || terms.some((term) => haystack.includes(term));
          card.hidden = !match;
          if (match) shown++;
        });
        count.textContent = shown === cards.length ? `${cards.length} heroes` : `${shown} of ${cards.length} heroes`;
        empty.hidden = shown !== 0;
      });
    })();
  </script>
</Base>

<style>
  .ri-page { width: 100%; max-width: var(--page-max-width); margin: 0 auto; padding: var(--space-8) var(--page-gutter) var(--space-12); }
  .ri-toolbar { margin-bottom: var(--space-6); }
  .ri-search-wrap { position: relative; display: block; width: min(100%, 460px); }
  .ri-search-wrap svg { position: absolute; left: 1rem; top: 50%; width: 18px; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  .ri-search { width: 100%; padding: .85rem 1rem .85rem 2.8rem; color: var(--text-primary); background: var(--bg-raised); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font: inherit; outline: none; }
  .ri-search:focus { border-color: var(--accent-gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-gold) 18%, transparent); }
  .ri-count { margin: 0; color: var(--text-muted); font-size: .85rem; white-space: nowrap; }
  .ri-list-head, .ri-row { display: grid; grid-template-columns: minmax(260px, 1.2fr) minmax(190px, .8fr) minmax(260px, 1fr); align-items: center; }
  .ri-list-head { padding: 0 var(--space-4) var(--space-2); color: var(--text-muted); font-size: .67rem; font-weight: var(--weight-bold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .ri-list { overflow: hidden; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-top-color: var(--border-medium); border-radius: var(--radius-lg); }
  .ri-row { min-height: 76px; border-bottom: 1px solid var(--border-faint); }
  .ri-row:last-child { border-bottom: 0; }
  .ri-row[hidden] { display: none; }
  .ri-row:hover { background: var(--bg-raised); }
  .ri-hero { display: flex; align-items: center; align-self: stretch; gap: var(--space-3); padding: var(--space-3) var(--space-4); color: inherit; text-decoration: none; }
  .ri-hero:hover .ri-identity strong { color: var(--accent-gold); }
  .ri-avatar { width: 50px; height: 50px; flex: 0 0 50px; border-radius: 12px; background-size: cover; background-position: center top; border: 1px solid var(--border-subtle); }
  .ri-identity { min-width: 0; display: flex; flex-direction: column; }
  .ri-identity strong { color: var(--text-primary); font-size: 1rem; transition: color .2s ease; }
  .ri-identity small { color: var(--text-muted); font-size: .72rem; margin-top: .15rem; }
  .ri-value { min-width: 0; padding: var(--space-3) var(--space-4); color: var(--text-primary); font-size: .84rem; line-height: 1.45; }
  .ri-value strong { font-weight: var(--weight-bold); }
  .ri-relic strong { display: inline-block; padding: .42rem .7rem; border-radius: 999px; background: var(--accent-gold-dim); border: 1px solid color-mix(in srgb, var(--accent-gold) 38%, transparent); color: var(--accent-gold-light); font-weight: var(--weight-black); }
  .ri-mobile-label { display: none; }
  .ri-empty { padding: var(--space-10); text-align: center; color: var(--text-muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 760px) {
    .ri-page { width: 100%; padding: var(--space-5) var(--space-4) var(--space-12); }
    .ri-toolbar { align-items: stretch; flex-direction: column; gap: var(--space-2); }
    .ri-search-wrap { width: 100%; }
    .ri-count { align-self: flex-end; }
    .ri-list-head { display: none; }
    .ri-list { display: grid; gap: var(--space-2); overflow: visible; background: transparent; border: 0; border-radius: 0; }
    .ri-row { display: grid; grid-template-columns: 1fr 1fr; min-height: 0; overflow: hidden; background: var(--bg-raised); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); }
    .ri-row:last-child { border-bottom: 1px solid var(--border-subtle); }
    .ri-hero { grid-column: 1 / -1; padding: var(--space-3); background: var(--chip-bg); border-bottom: 1px solid var(--border-faint); }
    .ri-avatar { width: 44px; height: 44px; flex-basis: 44px; border-radius: 10px; }
    .ri-value { display: flex; flex-direction: column; gap: .35rem; padding: var(--space-3); }
    .ri-value + .ri-value { border-left: 1px solid var(--border-faint); }
    .ri-mobile-label { display: block; color: var(--text-muted); font-size: .62rem; font-weight: var(--weight-bold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
    .ri-relic strong { align-self: flex-start; padding: .32rem .55rem; }
  }
  @media (max-width: 480px) {
    .ri-page { padding-right: var(--space-3); padding-left: var(--space-3); }
  }
</style>
