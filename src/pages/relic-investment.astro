---
export const prerender = true;

import { heroes } from "../data/heroes/withRatings";
import allInvest from "../data/ratings/invest.json";
import { pickLang, type LocalizedString } from "../i18n/helpers";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const investment = allInvest as Record<string, {
  relicRecommendation: LocalizedString;
  usedIn: LocalizedString;
  explanation: LocalizedString;
}>;
const english = (value: LocalizedString) => pickLang(value, "en");

const rows = heroes
  .filter((hero) => (import.meta.env.DEV || hero.release !== false) && investment[hero.id])
  .map((hero) => ({ hero, investment: investment[hero.id] }))
  .sort((a, b) => a.hero.name.localeCompare(b.hero.name));
---

<Base
  title="Relic Investment | Motto Immortal Database"
  description="Compare recommended relic investment levels for Motto Immortal heroes, including where each hero is used and why the investment matters."
>
  <PageHero
    id="relic-investment"
    tag="Hero Development"
    headline="Relic Investment"
    subtitle="Recommended relic levels for every rated hero"
  />

  <main class="ri-page">
    <div class="ri-toolbar">
      <label class="ri-search-wrap">
        <span class="sr-only">Search heroes or game modes</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input id="riSearch" class="ri-search" type="search" placeholder="Search hero or game mode..." autocomplete="off" />
      </label>
      <p id="riCount" class="ri-count">{rows.length} heroes</p>
    </div>

    <div id="riGrid" class="ri-grid">
      {rows.map(({ hero, investment: entry }) => {
        const recommendation = english(entry.relicRecommendation);
        const usedIn = english(entry.usedIn);
        const explanation = english(entry.explanation);
        return (
          <article
            class="ri-card"
            data-search={`${hero.name} ${recommendation} ${usedIn}`.toLowerCase()}
          >
            <a class="ri-card-head" href={`/heroes/${hero.id}`}>
              <span class="ri-avatar" style={`background-image:url(${R2_BASE}/heroes/${hero.id}.webp)`}></span>
              <span class="ri-identity">
                <strong>{hero.name}</strong>
                <small>{hero.class} · {hero.faction}</small>
              </span>
              <span class="ri-level">Relic {recommendation}</span>
            </a>
            <div class="ri-card-body">
              <div class="ri-usage">
                <span>Used in</span>
                <strong>{usedIn}</strong>
              </div>
              <p>{explanation}</p>
            </div>
          </article>
        );
      })}
    </div>
    <p id="riEmpty" class="ri-empty" hidden>No heroes match your search.</p>
  </main>

  <script is:inline>
    (() => {
      const search = document.getElementById("riSearch");
      const cards = Array.from(document.querySelectorAll(".ri-card"));
      const count = document.getElementById("riCount");
      const empty = document.getElementById("riEmpty");
      if (!search) return;

      search.addEventListener("input", () => {
        const terms = search.value.toLowerCase().trim().split(/[&,;|]+/).map((term) => term.trim()).filter(Boolean);
        let shown = 0;
        cards.forEach((card) => {
          const haystack = card.getAttribute("data-search") || "";
          const match = terms.length === 0 || terms.some((term) => haystack.includes(term));
          card.hidden = !match;
          if (match) shown++;
        });
        count.textContent = shown === cards.length ? `${cards.length} heroes` : `${shown} of ${cards.length} heroes`;
        empty.hidden = shown !== 0;
      });
    })();
  </script>
</Base>

<style>
  .ri-page { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: var(--space-8) 0 var(--space-12); }
  .ri-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-6); }
  .ri-search-wrap { position: relative; display: block; width: min(100%, 460px); }
  .ri-search-wrap svg { position: absolute; left: 1rem; top: 50%; width: 18px; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  .ri-search { width: 100%; padding: .85rem 1rem .85rem 2.8rem; color: var(--text-primary); background: var(--bg-raised); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font: inherit; outline: none; }
  .ri-search:focus { border-color: var(--accent-gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-gold) 18%, transparent); }
  .ri-count { margin: 0; color: var(--text-muted); font-size: .85rem; white-space: nowrap; }
  .ri-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .ri-card { overflow: hidden; background: var(--bg-raised); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .ri-card[hidden] { display: none; }
  .ri-card-head { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); color: inherit; text-decoration: none; background: var(--chip-bg); border-bottom: 1px solid var(--border-faint); }
  .ri-card-head:hover .ri-identity strong { color: var(--accent-gold); }
  .ri-avatar { width: 48px; height: 48px; flex: 0 0 48px; border-radius: 50%; background-size: cover; background-position: center top; border: 1px solid var(--border-subtle); }
  .ri-identity { min-width: 0; display: flex; flex-direction: column; }
  .ri-identity strong { color: var(--text-primary); font-size: 1rem; transition: color .2s ease; }
  .ri-identity small { color: var(--text-muted); font-size: .72rem; margin-top: .15rem; }
  .ri-level { margin-left: auto; flex-shrink: 0; max-width: 52%; padding: .42rem .65rem; border-radius: 999px; background: color-mix(in srgb, var(--faction-a) 14%, transparent); border: 1px solid color-mix(in srgb, var(--faction-a) 38%, transparent); color: var(--faction-a); font-weight: var(--weight-black); font-size: .78rem; text-align: center; }
  .ri-card-body { padding: var(--space-4); }
  .ri-usage { display: flex; gap: var(--space-3); align-items: baseline; margin-bottom: var(--space-3); }
  .ri-usage span { flex-shrink: 0; color: var(--text-muted); font-size: .66rem; font-weight: var(--weight-bold); text-transform: uppercase; letter-spacing: var(--tracking-wide); }
  .ri-usage strong { color: var(--text-primary); font-size: .84rem; }
  .ri-card-body p { margin: 0; color: var(--text-secondary); font-size: .82rem; line-height: 1.6; }
  .ri-empty { padding: var(--space-10); text-align: center; color: var(--text-muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 760px) { .ri-page { width: min(100% - 1rem, 1180px); padding-top: var(--space-5); } .ri-grid { grid-template-columns: 1fr; } .ri-toolbar { align-items: stretch; flex-direction: column; gap: var(--space-2); } .ri-search-wrap { width: 100%; } .ri-count { align-self: flex-end; } }
</style>
