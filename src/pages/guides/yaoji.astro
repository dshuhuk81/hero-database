---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import yaojiData from "../../data/heroes/yaoji.json";

const R2_BASE = "https://pub-e35e94828bf347ca93c3d2c6a50d06f6.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const HERO_IMAGE_VERSION = "2026-10-28-cutouts";
const heroCardImage = (id: string) => `${R2_BASE}/heroes/cards/${encodeURIComponent(id)}-240.webp?v=${HERO_IMAGE_VERSION}`;
const skillImage = (id: string) => `${R2_BASE}/skills/yaoji_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "Clouds and Rain of Wushan is Yaoji's pressure window. It stretches the Miasmic Field across the whole battlefield and adds a Blossom & Blight stack every 2 seconds, so every enemy starts taking more damage and burning for a percentage of her ATK. If she has no host when it is cast, she possesses the frontmost ally first, so the Ultimate never fizzles.",
  skill_2: "Twining Clouds sets up the whole fight. At battle start Yaoji possesses the frontmost ally and becomes untargetable, which turns the host's position into a team-building decision. The active cast adds another stack of Blossom & Blight, which makes it the main way to reach ten stacks faster than the Ultimate alone.",
  skill_3: "Mistborne Erosion is always on while enemies stand in the field. It cuts their ATK and the healing they receive, so it protects your team and shuts down enemy sustain at the same time. Its last upgrade raises the healing cut to 60%, which matters against teams that rely on healers.",
  skill_4: "Cloudveil Shelter is the host's survival button. Damage reduction and healing over time both land on the ally she is possessing, which keeps the field centered on a unit that can stay alive. It can only be cast while possessing, so a dead or released host removes this protection.",
};

const skills = yaojiData.skills.map((skill) => {
  const number = skill.id.replace("skill_", "");
  return {
    ...skill,
    badge: skill.isUltimate ? `Skill ${number} - Ultimate` : `Skill ${number}`,
    takeaway: takeaways[skill.id],
    upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
  };
});

const relic = {
  ...yaojiData.relic,
  badge: "Relic",
  takeaway: "Last Petals Fallen rewards finishing the stack. Once Blossom & Blight reaches ten stacks on an enemy, that enemy is hit with Blight: percent max-HP loss and a heavy cut to ATK and attack speed. Upgrades also let the host trigger extra Twining Clouds casts when it loses large chunks of HP, which speeds up stacking exactly when the team is under pressure.",
  upgrades: Object.entries(yaojiData.relic.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
};

const ultimate = skills.find((skill) => skill.isUltimate) ?? skills[0];

// Ultimate stack ladder: one stack on cast, then one every 2s (derived from skill text).
const ladder = [
  { time: "0s", stacks: 1, note: "On cast" },
  { time: "2s", stacks: 2, note: "" },
  { time: "4s", stacks: 3, note: "" },
  { time: "6s", stacks: 4, note: "" },
  { time: "8s", stacks: 5, note: "Base duration ends" },
  { time: "10s", stacks: 6, note: "Max duration ends" },
];
const MAX_STACKS = 10;

const upgradeTable = [
  { label: "Damage taken per stack", base: "+3%", max: "+5%", note: "At 10 stacks: +50% damage taken" },
  { label: "Damage per stack per second", base: "25% ATK", max: "40% ATK", note: "At 10 stacks: 400% ATK per second" },
  { label: "Ultimate duration", base: "8s", max: "10s", note: "" },
  { label: "Twining Clouds active hit", base: "150% ATK", max: "210% ATK", note: "Cooldown reduced by 30%" },
  { label: "Enemy ATK reduction", base: "15%", max: "25%", note: "Inside the Miasmic Field" },
  { label: "Enemy healing received", base: "-30%", max: "-60%", note: "Inside the Miasmic Field" },
  { label: "Host damage reduction", base: "30% / 5s", max: "40% / 6s", note: "Cloudveil Shelter" },
  { label: "Host healing", base: "3% max HP/s", max: "5% max HP/s", note: "Up to 30% max HP over 6s" },
];

const blight = [
  { label: "Max HP loss per second", base: "3%", max: "5%" },
  { label: "ATK reduction", base: "-30%", max: "-50%" },
  { label: "Attack speed reduction", base: "-30%", max: "-50%" },
];

const partners = [
  { id: "nyx", name: "Nyx", text: "Frequently recommended alongside Yaoji by players and used in high Spire floors." },
  { id: "heracles", name: "Heracles", text: "A commonly recommended partner in community guides." },
];

const sustainPartners = [
  { id: "cancer", name: "Cancer", tags: ["Damage reduction", "Cleanse", "Energy", "Heal", "Shield", "CC immunity"] },
  { id: "dionysus", name: "Dionysus", tags: ["CC immunity", "Damage reduction", "Cleanse", "Energy", "Heal", "Shield"] },
  { id: "tefnut", name: "Tefnut", tags: ["Cleanse", "Heal", "Shield", "Damage reduction"] },
  { id: "mengpo", name: "Mengpo", tags: ["Cleanse", "Heal", "Energy"] },
  { id: "meret", name: "Meret", tags: ["Damage reduction", "Heal", "Shield"] },
];

const strengths = [
  "Up to +50% damage taken on every enemy at ten Blossom & Blight stacks",
  "Field-wide coverage during the Ultimate",
  "Cuts enemy ATK by up to 25% and enemy healing by up to 60%",
  "Untargetable while possessing a host",
  "Gives the host damage reduction and healing over time",
  "Relic adds Blight: max-HP loss plus heavy ATK and attack-speed reduction",
  "Ultimate possesses the frontmost ally automatically if she has no host",
];

const weaknesses = [
  "The Ultimate alone does not reach ten stacks in a fresh fight",
  "Cloudveil Shelter and the Ultimate depend on having a host",
  "Possession lasts 12 seconds",
  "Strongest effects need enemies to stay inside the field",
  "The host is always the frontmost ally, not necessarily your carry",
  "Needs heavy investment to perform: Mythic and Relic 30 are the recommended minimum",
  "Short fights end before stacks and Blight can pay off",
];
---

<Base title="Yaoji Guide - Blossom & Blight Support | Motto Immortal" description="Yaoji guide covering Blossom & Blight stacking, possession, Miasmic Field, Last Petals Fallen relic, upgrades, positioning, team partners, strengths and weaknesses.">
  <div class="guide-banner guide-banner--heket guide-banner--clubs guide-banner--yaoji">
    <div class="guide-banner-bg" style={`background-image: url('${heroImage(yaojiData.id)}'); --guide-banner-y: 10%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg><span>Guides</span></a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">{yaojiData.name}</h1>
      <p class="guide-hero-subtitle">Possession &middot; Debuff Stacking Support</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/${yaojiData.faction.toLowerCase()}.webp`} alt={yaojiData.faction} />{yaojiData.faction}</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/${yaojiData.class.toLowerCase()}.webp`} alt={yaojiData.class} />{yaojiData.class}</span>
        <span class="guide-badge guide-badge--legendary">{yaojiData.rarity}</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--clubs guide-body--yaoji">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Yaoji at a Glance</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
        <div class="heket-verdict-main">
          <div class="heket-verdict-icon" style={`background-image: url('${skillImage(ultimate.id)}');`} role="img" aria-label={ultimate.name}></div>
          <div><span class="heket-verdict-kicker">Team-building verdict</span><h3>Make every enemy take more damage while your host stays alive.</h3><p>Yaoji possesses your frontmost ally at the start of the battle and becomes untargetable. From there she builds a Miasmic Field that weakens enemy ATK and healing, stacks Blossom & Blight to raise the damage enemies take, and shields her host with damage reduction and healing. Her value depends on how quickly she reaches ten stacks, because that is when the damage amplification peaks and her Relic applies Blight.</p></div>
        </div>
        <div class="heket-fact-strip"><div><span>Role</span><strong>Debuff and host support</strong></div><div><span>Core mechanic</span><strong>Blossom &amp; Blight stacks</strong></div><div><span>Best fit</span><strong>Teams that win longer fights</strong></div></div>
        <div class="heket-verdict-warning"><strong>Key warning</strong><span>Yaoji possesses the frontmost ally, not your strongest carry. Choose your front line with that in mind.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Blossom &amp; Blight Cycle</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-engine">
        <div class="heket-engine-flow">
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_2")}');`} role="img" aria-label="Twining Clouds"></div><span>Possess</span><strong>Take the frontmost ally</strong><p>Yaoji possesses the frontmost ally at the start of battle, becomes untargetable, and creates a 4-meter Miasmic Field around the host.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_3")}');`} role="img" aria-label="Mistborne Erosion"></div><span>Weaken</span><strong>Cut enemy ATK and healing</strong><p>Enemies inside the field deal less damage and receive less healing for as long as they stay in it.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Clouds and Rain of Wushan"></div><span>Stack</span><strong>Build Blossom &amp; Blight</strong><p>Twining Clouds and the Ultimate add stacks. Each stack increases damage taken and burns the target for a share of Yaoji's ATK.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label={relic.name}></div><span>Blight</span><strong>Finish at ten stacks</strong><p>The first time an enemy reaches ten stacks, Last Petals Fallen inflicts Blight on it.</p></div>
        </div>
        <div class="heket-engine-return"><span>Cloudveil Shelter keeps the host alive so the field keeps working</span></div>
        <div class="heket-engine-rule"><strong>Everything in Yaoji's kit points at the ten-stack mark.</strong><span>Stacks last 30 seconds, so once they are built they stay. The faster you reach ten, the longer the enemy team plays under maximum damage amplification and Blight.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Ten-Stack Goal</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="yaoji-ladder">
        <div class="yaoji-ladder-head">
          <span>Ultimate stack timeline</span>
          <h3>The Ultimate alone reaches six stacks. The rest has to come from Twining Clouds.</h3>
        </div>
        <ol class="yaoji-ladder-bars" aria-label="Blossom & Blight stacks over the Ultimate duration">
          {ladder.map((step) => (
            <li class="yaoji-ladder-col">
              <div class="yaoji-ladder-track" role="img" aria-label={`${step.stacks} of ${MAX_STACKS} stacks at ${step.time}`}>
                <div class="yaoji-ladder-fill" style={`height: ${(step.stacks / MAX_STACKS) * 100}%;`}><strong>{step.stacks}</strong></div>
                <div class="yaoji-ladder-goal"></div>
              </div>
              <span class="yaoji-ladder-time">{step.time}</span>
              <small>{step.note}</small>
            </li>
          ))}
        </ol>
        <div class="yaoji-ladder-legend"><span><i class="yaoji-ladder-key yaoji-ladder-key--fill"></i>Stacks from the Ultimate</span><span><i class="yaoji-ladder-key yaoji-ladder-key--goal"></i>Ten stacks, where Blight triggers</span></div>
      </div>
      <div class="guide-callout"><strong>How to read this:</strong> The Ultimate adds one stack on cast and one every 2 seconds. At the base 8-second duration that gives five stacks, and at the upgraded 10-second duration six. Twining Clouds casts, earlier stacks, and the Relic's extra casts supply the remaining stacks, so the Ultimate works best as the final push on top of stacks that are already running.</div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Skills: What They Mean</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}>
            <header class="guide-skill-panel-head"><div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div><img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{skill.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{skill.upgrades.map((upgrade) => <div><span>{upgrade.level}</span><p>{upgrade.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{skill.takeaway}</p>
          </article>)}
          <article class="guide-skill-panel" data-guide-skill="relic">
            <header class="guide-skill-panel-head"><div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">{relic.badge}</span><span class="guide-skill-badge guide-skill-badge--level">Defining mechanic</span></div></div><img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{relic.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{relic.upgrades.map((upgrade) => <div><span>{upgrade.level}</span><p>{upgrade.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{relic.takeaway}</p>
          </article>
        </div>
        <ol class="guide-skill-selector">
          {skills.map((skill, index) => <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><small>{skill.badge}</small></span></button></li>)}
          <li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><small>{relic.badge}</small></span></button></li>
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">What Upgrades Change</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="yaoji-compare">
        <div class="yaoji-compare-head" aria-hidden="true"><span>Mechanic</span><span>Base</span><span>Fully upgraded</span></div>
        {upgradeTable.map((row) => (
          <div class="yaoji-compare-row">
            <div class="yaoji-compare-label"><strong>{row.label}</strong>{row.note && <small>{row.note}</small>}</div>
            <div class="yaoji-compare-base"><span class="yaoji-compare-tag">Base</span>{row.base}</div>
            <div class="yaoji-compare-max"><span class="yaoji-compare-tag">Max</span>{row.max}</div>
          </div>
        ))}
      </div>
      <div class="yaoji-blight">
        <div class="yaoji-blight-head"><span>Relic effect</span><h3>Blight when an enemy first reaches ten stacks</h3><p>Lasts 5 seconds. The Relic's later upgrade makes it hit much harder.</p></div>
        <div class="yaoji-blight-grid">
          {blight.map((row) => (
            <div><span>{row.label}</span><strong><s>{row.base}</s> <em>{row.max}</em></strong></div>
          ))}
        </div>
      </div>
      <div class="guide-callout"><strong>Investment takeaway:</strong> Three upgrades change the stack game the most: the Ultimate's +5% damage taken per stack, the longer Ultimate duration, and the Relic's stronger Blight. Players commonly recommend Mythic with Relic 30 as the minimum, and Divine V if your resources allow it.</div>
    </section>

    <section class="guide-section guide-section--detail-heading"><h2 class="guide-section-title lt-h2 lt-h2-center">Strengths &amp; Weaknesses</h2><div class="lt-flourish lt-flourish-center"></div><StrengthWeakness strengths={strengths} weaknesses={weaknesses} /></section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Positioning &amp; Team Building</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Choose your host</span><h3>Whoever stands in front becomes the center of the field.</h3></div>
        <div class="heket-tactics">
          <article><div class="heket-tactic-marker">Host</div><h4>Put a durable unit in front</h4><p>Yaoji's opening possession picks the frontmost allied unit. That unit gets the Miasmic Field, Cloudveil Shelter, and the Relic's extra casts when it takes damage, so it should be able to survive focused fire.</p></article>
          <article><div class="heket-tactic-marker">Field</div><h4>Keep enemies inside the field</h4><p>The 4-meter field is where ATK and healing reductions apply. Frontline hosts that enemies walk into give the field the most value, until the Ultimate extends it across the whole battlefield.</p></article>
          <article><div class="heket-tactic-marker">Timing</div><h4>Plan for longer fights</h4><p>Stacks, Blight, and the damage amplification take time to build. Yaoji is strongest in fights that last long enough for her debuffs to reach their peak.</p></article>
        </div>
      </div>

      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Recommended partners</span><h3>Heroes players pair with Yaoji.</h3></div>
        <div class="yaoji-partners">
          {partners.map((partner) => (
            <a class="yaoji-partner" href={`/heroes/${partner.id}`}>
              <img src={heroCardImage(partner.id)} alt="" width="56" height="56" loading="lazy" decoding="async" onerror={`this.onerror=null;this.src='${heroImage(partner.id)}'`} />
              <div><strong>{partner.name}</strong><p>{partner.text}</p></div>
            </a>
          ))}
        </div>
      </div>

      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Sustain options</span><h3>Heroes that cover protection she does not.</h3></div>
        <p class="heket-hades-note">These heroes bring team-wide healing, shields, damage reduction, or cleanse. They help the host and the rest of the formation survive long enough for Blossom &amp; Blight to reach ten stacks.</p>
        <div class="yaoji-partners yaoji-partners--compact">
          {sustainPartners.map((partner) => (
            <a class="yaoji-partner" href={`/heroes/${partner.id}`}>
              <img src={heroCardImage(partner.id)} alt="" width="56" height="56" loading="lazy" decoding="async" onerror={`this.onerror=null;this.src='${heroImage(partner.id)}'`} />
              <div><strong>{partner.name}</strong><ul class="yaoji-tags">{partner.tags.map((tag) => <li>{tag}</li>)}</ul></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Counterplay</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Favorable fights</span><strong>Long fights with a surviving host</strong><p>When the host lives through the opening and enemies stay clustered in the field, stacks climb to ten and Blight lands. Damage amplification then makes the rest of your team hit harder.</p></div>
          <div class="heket-matchup-bad"><span>Difficult conditions</span><strong>Host removed before stacking</strong><p>Killing the host early stops the field, Cloudveil Shelter, and the Relic's extra casts. Short fights and enemies that avoid the field also reduce how many stacks she can build.</p></div>
        </div>
        <p class="heket-hades-note"><strong>If the team keeps losing:</strong> If the host dies early, change the frontline or add sustain. If the fight ends before stacks matter, add damage or bring more ways to stack Twining Clouds. If enemies reach ten stacks but still win, improve the team's burst while Blight and damage amplification are active.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-verdict-box"><h3 class="guide-verdict-heading">Yaoji turns a long fight into a damage amplifier for your whole team.</h3><p class="guide-verdict-text">Yaoji protects her host while weakening the whole enemy side. Blossom &amp; Blight increases damage taken by up to 50% at ten stacks, Mistborne Erosion cuts enemy ATK and healing, and the Relic finishes fully stacked enemies with Blight.<br><br>Her main practical question is how reliably she reaches ten stacks and how long the host survives. Reaching it quickly depends on Twining Clouds, the Relic's extra casts, and a front line that can take hits.<br><br>She is a heavy-investment support. Players recommend Mythic with Relic 30 at minimum and Divine V as the long-term goal, which makes her a strong pick for players ready to commit resources to a support hero.</p></div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) button.addEventListener("click", () => {
        const id = button.getAttribute("data-guide-skill-button");
        for (const other of buttons) { const active = other === button; other.classList.toggle("is-active", active); other.setAttribute("aria-pressed", String(active)); }
        for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
      });
    }
  </script>
</Base>

<style>
  /* Stack timeline: Ultimate stacks against the ten-stack goal */
  .yaoji-ladder {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    margin-bottom: var(--space-5);
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }
  .yaoji-ladder-head span {
    color: var(--guide-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }
  .yaoji-ladder-head h3 {
    margin: var(--space-2) 0 0;
    color: var(--text-bright);
    font-size: var(--text-xl);
    line-height: 1.25;
  }
  .yaoji-ladder-bars {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .yaoji-ladder-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
  }
  .yaoji-ladder-track {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
