---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const skillImage = (id: string) => `${R2_BASE}/skills/eden_${id}.webp`;
const virtueImage = (id: string, suffix: string) => `${R2_BASE}/images/virtues/${id}${suffix}.png`;

const skills = [
  {
    id: "skill_1",
    name: "Eternal Protection Vow",
    badge: "Skill 1 - Ultimate",
    isUlt: true,
    description: "Protects a front-row ally with an ATK-based Shield and reduces the damage they receive for the duration. Idun prioritizes the ally carrying Golden Apple.",
    upgrades: [
      { level: "Lv 2", text: "Extends the duration of the Shield and damage reduction." },
      { level: "Lv 3", text: "Increases the damage reduction." },
      { level: "Lv 4", text: "Increases the ATK-based Shield." },
    ],
  },
  {
    id: "skill_2",
    name: "Vitality Renewal",
    badge: "Skill 2",
    description: "Immediately heals the weakest ally using both Idun's ATK and the target's missing HP. The Golden Apple carrier receives the healing effect as an additional target.",
    upgrades: [
      { level: "Lv 2", text: "Increases the missing-HP portion of the heal." },
      { level: "Lv 3", text: "Increases the ATK-based portion of the heal." },
      { level: "Lv 4", text: "Further increases the ATK-based portion." },
    ],
  },
  {
    id: "skill_3",
    name: "Moment of Divine Protection",
    badge: "Skill 3",
    description: "When Idun is about to fall, a giant Golden Apple encloses her. During this one-time protection window, part of her max HP is converted into current HP. This prevents a death; it is not a revive.",
    upgrades: [
      { level: "Lv 2", text: "Increases the protection ratio." },
      { level: "Lv 3", text: "Reduces damage received during the protection window." },
      { level: "Lv 4", text: "Further increases the protection ratio." },
    ],
  },
  {
    id: "skill_4",
    name: "Divine Sharing",
    badge: "Skill 4",
    description: "At combat start, the allied frontline unit closest to Idun receives Golden Apple. It transfers a portion of Idun's base ATK, HP, Armor, and M-RES to that ally.",
    upgrades: [
      { level: "Lv 2", text: "Increases the transferred stat ratio." },
      { level: "Lv 3", text: "Idun receives less damage while the Apple carrier is alive." },
      { level: "Lv 4", text: "Further increases the transferred stat ratio." },
    ],
  },
];

const relic = {
  name: "Eternal Fruit",
  badge: "Relic",
  levelBadge: "Level 30",
  description: "When Idun's Ultimate protects the Golden Apple carrier, it also turns the defensive window into an offensive one by adding CRIT Rate.",
  upgrades: [
    { level: "Relic 10", text: "The Golden Apple carrier also gains CRIT DMG during the Ultimate." },
    { level: "Relic 20", text: "The Golden Apple carrier becomes immune to Crowd Control during the Ultimate." },
    { level: "Relic 30", text: "Adds a further CRIT DMG increase during the Ultimate." },
  ],
};

const strengths = [
  "Concentrates shields, damage reduction, healing, and offensive Relic buffs on one frontline carry",
  "Golden Apple shares four base stats at once: ATK, HP, Armor, and M-RES",
  "Missing-HP healing scales well with durable carries and large health pools",
  "One-time self-preservation makes her harder to remove with the first burst",
  "Relic 20 creates a protected, Crowd-Control-immune damage window for the chosen carry",
  "Core Golden Apple function works before maximum Relic investment",
];

const weaknesses = [
  "Most of her value is concentrated on one ally rather than spread across the team",
  "The wrong nearby frontline unit can intercept Golden Apple at combat start",
  "She has no hard Crowd Control, defense shred, or broad damage amplification",
  "Crowd Control can stop the protection window before Relic 20",
  "AoE pressure and backline dive can bypass the ally she is built to protect",
  "Her self-preservation triggers only once and does not protect her from renewed focus",
];

const synergies = [
  { id: "nut", name: "Nut", note: "Prime target: frontline damage backed by stats, healing, Shield, and CRIT buffs" },
  { id: "zeus", name: "Zeus", note: "Protects an aggressive damage position; verify that he is the closest frontline ally" },
  { id: "nezha", name: "Nezha", note: "Extra durability and a protected burst window for an exposed frontline carry" },
];

const counters = [
  { id: "nyx", name: "Nyx", note: "Silence and stun can delay Idun before the protection window" },
  { id: "anubis", name: "Anubis", note: "Backline pressure can ignore the protected frontline carry" },
  { id: "capricorn", name: "Capricorn", note: "Fast burst can force Idun's one-time safeguard early" },
  { id: "mengpo", name: "Mengpo", note: "Silence and Energy denial slow her most important cast" },
];

const virtues = [
  {
    name: "Sacrifice",
    rarity: "Gold",
    rarityClass: "guide-virtue-rarity--gold",
    assetId: "sacrificeI",
    assetSuffix: "_elite",
    bonuses: [
      { label: "2-Piece", text: "HP +10% at combat start" },
      { label: "4-Piece", text: "Max HP +30% at combat start; current HP remains unchanged" },
    ],
    note: "A direct way to enlarge her own health pool and strengthen the defensive side of Golden Apple's stat transfer.",
  },
  {
    name: "Stoic",
    rarity: "Gold",
    rarityClass: "guide-virtue-rarity--gold",
    assetId: "stoicI",
    assetSuffix: "_elite",
    bonuses: [
      { label: "2-Piece", text: "HP +10% at combat start" },
      { label: "4-Piece", text: "Damage received and dealt -30%" },
    ],
    note: "The damage penalty barely matters to a pure support, while the durability helps her survive long enough to cast and reach her safeguard.",
  },
  {
    name: "Defiance",
    rarity: "Red",
    rarityClass: "guide-virtue-rarity--red",
    assetId: "defianceI",
    assetSuffix: "_legendary",
    bonuses: [
      { label: "2-Piece", text: "HP +15% at combat start" },
      { label: "4-Piece", text: "At 50% HP, dispel debuffs and Control; restore 10% max HP/s for 5s once per battle" },
    ],
    note: "Adds a second survival layer and can clear the control that would otherwise keep her from protecting the Apple carrier.",
  },
];
---

<Base title="Idun Guide - Golden Apple Support | Motto Immortal" description="Complete Idun guide: Golden Apple positioning, skills, Relic breakpoints, frontline carry synergies, counters, gear stats, and virtues.">
  <div class="guide-banner guide-banner--idun">
    <div class="guide-banner-bg" style={`background-image: url('${heroImage("eden")}'); --guide-banner-y: 22%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      <span>Guides</span>
    </a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Idun</h1>
      <p class="guide-hero-subtitle">Keeper of the Golden Apple.</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/hearts.webp`} alt="Hearts" />Hearts</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/support.webp`} alt="Support" />Support</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--idun">
    <section class="guide-section">
      <h2 class="guide-section-title">Quick Overview</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Build around one golden target</h3>
        <div class="guide-overview-grid">
          <div class="guide-overview-item"><div class="guide-overview-label">Role</div><div class="guide-overview-value">Single-carry frontline support</div></div>
          <div class="guide-overview-item"><div class="guide-overview-label">Best in</div><div class="guide-overview-value">Campaign, Rift, Hearts Spire</div></div>
          <div class="guide-overview-item"><div class="guide-overview-label">Needs</div><div class="guide-overview-value">Exact positioning, durable frontline carry</div></div>
          <div class="guide-overview-item"><div class="guide-overview-label">Relic</div><div class="guide-overview-value">10 usable, 20 utility spike, 30 full offense</div></div>
        </div>
        <p class="guide-quick-verdict">Idun is a specialist, not a universal team healer. She chooses one nearby frontline ally, shares her base stats through Golden Apple, then keeps that hero alive with targeted healing, a Shield, and damage reduction. Her Relic turns the same protection window into a CRIT-powered attack window.</p>
        <div class="guide-rating-row">
          <div class="guide-rating-cell"><span class="guide-rating-category">PvP</span><span class="rating-badge" data-tier="B">B</span></div>
          <div class="guide-rating-cell"><span class="guide-rating-category">PvE</span><span class="rating-badge" data-tier="A">A</span></div>
          <div class="guide-rating-cell"><span class="guide-rating-category">Spire</span><span class="rating-badge" data-tier="S">S</span></div>
          <div class="guide-rating-cell"><span class="guide-rating-category">Boss</span><span class="rating-badge" data-tier="B">B</span></div>
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">The Golden Apple Plan</h2>
      <div class="guide-card guide-apple-card">
        <h3 class="guide-card-heading">Position first; every other effect follows</h3>
        <p class="guide-card-subheading">Golden Apple is assigned at combat start to the frontline ally closest to Idun. The formation decides who receives the entire package.</p>
        <div class="guide-apple-path">
          <div class="guide-apple-step"><span class="guide-apple-number">1</span><strong>Place Idun</strong><p>Keep her closest to the frontline carry you actually want to empower.</p></div>
          <div class="guide-apple-arrow" aria-hidden="true">&rarr;</div>
          <div class="guide-apple-step guide-apple-step--core"><span class="guide-apple-number">2</span><strong>Golden Apple</strong><p>The chosen ally inherits part of Idun's base ATK, HP, Armor, and M-RES.</p></div>
          <div class="guide-apple-arrow" aria-hidden="true">&rarr;</div>
          <div class="guide-apple-step"><span class="guide-apple-number">3</span><strong>Protect the window</strong><p>Ultimate prioritizes that ally; healing reaches them again; Relic adds CRIT and later CC immunity.</p></div>
        </div>
        <div class="guide-apple-rule"><strong>Formation rule:</strong> if another frontline ally stands closer, that ally takes Golden Apple. Treat the nearest slot as part of Idun's build, not a cosmetic choice.</div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Relic Breakpoints</h2>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint"><span>Base Kit</span><strong>Protection online</strong><p>Stat transfer, targeted Shield, damage reduction, and extra healing already function.</p></div>
        <div class="guide-apple-breakpoint"><span>Relic 10</span><strong>Efficient entry</strong><p>CRIT Rate and CRIT DMG make the protected carry dangerous during the Ultimate.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--key"><span>Relic 20</span><strong>Mechanical spike</strong><p>CC immunity lets the carry use the protection window instead of losing it to control.</p></div>
        <div class="guide-apple-breakpoint"><span>Relic 30</span><strong>Full offense</strong><p>Further CRIT DMG completes the offensive side of the Golden Apple package.</p></div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Skills</h2>
      <div class="guide-skills-grid">
        {skills.map((skill) => (
          <div class="guide-skill-card">
            <div class="guide-skill-header">
              <div class="guide-skill-icon" style={`background-image: url('${skillImage(skill.id)}');`} role="img" aria-label={skill.name}></div>
              <div class="guide-skill-meta"><div class="guide-skill-name">{skill.name}</div><span class={`guide-skill-badge${skill.isUlt ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div>
            </div>
            <p class="guide-skill-desc">{skill.description}</p>
            <div class="guide-skill-upgrades">{skill.upgrades.map((u) => <div class="guide-upgrade"><span class="guide-upgrade-chip">{u.level}</span><span class="guide-upgrade-text">{u.text}</span></div>)}</div>
          </div>
        ))}
      </div>
      <div class="guide-skill-card guide-skill-card--relic">
        <div class="guide-skill-header"><div class="guide-skill-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label={relic.name}></div><div class="guide-skill-meta"><div class="guide-skill-name">{relic.name}</div><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">{relic.badge}</span><span class="guide-skill-badge guide-skill-badge--level">{relic.levelBadge}</span></div></div></div>
        <div><p class="guide-skill-desc">{relic.description}</p><div class="guide-skill-upgrades guide-skill-upgrades--relic">{relic.upgrades.map((u) => <div class="guide-upgrade guide-upgrade--relic"><span class="guide-upgrade-chip">{u.level}</span><span class="guide-upgrade-text">{u.text}</span></div>)}</div></div>
      </div>
    </section>

    <section class="guide-section"><h2 class="guide-section-title">Strength &amp; Weaknesses</h2><StrengthWeakness strengths={strengths} weaknesses={weaknesses} /></section>

    <section class="guide-section">
      <h2 class="guide-section-title">Synergies</h2>
      <div class="guide-hero-grid">{synergies.map((hero) => <div class="guide-hero-card"><div class="guide-hero-portrait" style={`background-image: url('${heroImage(hero.id)}');`} role="img" aria-label={hero.name}></div><div class="guide-hero-card-name">{hero.name}</div><div class="guide-hero-card-note">{hero.note}</div></div>)}</div>
      <div class="guide-callout">The team shell is more important than a fixed five-hero list: frontline carry + Idun + Energy or tempo support + Control + secondary damage. Always confirm that the intended carry is Idun's closest frontline ally.</div>
    </section>

    <section class="guide-section"><h2 class="guide-section-title">Shut Down By</h2><div class="guide-hero-grid">{counters.map((hero) => <div class="guide-hero-card"><div class="guide-hero-portrait" style={`background-image: url('${heroImage(hero.id)}');`} role="img" aria-label={hero.name}></div><div class="guide-hero-card-name">{hero.name}</div><div class="guide-hero-card-note">{hero.note}</div></div>)}</div></section>

    <section class="guide-section">
      <h2 class="guide-section-title">Gear &amp; Stats</h2>
      <div class="guide-card"><h3 class="guide-card-heading">Build the stats she shares</h3><p class="guide-card-subheading">Idun's value comes from staying active and feeding a better base-stat package into Golden Apple.</p><div class="guide-stat-chain"><span class="guide-stat-pill guide-stat-pill--primary">Energy / Haste</span><span class="guide-stat-sep">&gt;</span><span class="guide-stat-pill guide-stat-pill--primary">ATK %</span><span class="guide-stat-sep">&gt;</span><span class="guide-stat-pill guide-stat-pill--primary">HP %</span><span class="guide-stat-sep">&gt;</span><span class="guide-stat-pill">Armor / M-RES</span><span class="guide-stat-sep">&gt;</span><span class="guide-stat-pill">Control Res</span></div><div class="guide-callout">ATK supports her Shield and part of her healing; HP strengthens her one-time safeguard; all four base stats feed Golden Apple. Her own CRIT and penetration do not advance her support job.</div></div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Virtues</h2>
      <div class="guide-virtue-grid">{virtues.map((v) => <div class="guide-virtue-card"><div class="guide-virtue-header"><div class="guide-virtue-icon" style={`background-image: url('${virtueImage(v.assetId, v.assetSuffix)}');`} role="img" aria-label={v.name}></div><div><div class="guide-virtue-name">{v.name}</div><span class={`guide-virtue-rarity ${v.rarityClass}`}>{v.rarity}</span></div></div><div class="guide-virtue-bonuses">{v.bonuses.map((b) => <div class="guide-virtue-bonus"><div class="guide-virtue-bonus-label">{b.label}</div><div class="guide-virtue-bonus-text">{b.text}</div></div>)}</div><p class="guide-virtue-note">{v.note}</p></div>)}</div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Verdict</h2>
      <div class="guide-verdict-box"><h3 class="guide-verdict-heading">A specialist for aggressive frontliners</h3><p class="guide-verdict-text">Idun is at her best when one exposed frontline carry decides the fight. Golden Apple gives that hero a mixed offensive and defensive foundation, while her Ultimate, healing, and Relic keep reinforcing the same target. She is less convincing when damage is spread across the whole team or when the formation cannot guarantee the correct Apple carrier. Relic 10 is the practical entry point, Relic 20 is the key utility breakpoint, and Relic 30 finishes the damage window.</p></div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
</Base>
