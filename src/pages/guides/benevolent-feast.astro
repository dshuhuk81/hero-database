---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import "../../styles/components.css";

const FEATURE_ASSET_BASE = "/features/water-game/assets";

const icon = (name: string) => `${FEATURE_ASSET_BASE}/icons/${name}`;
const ui = (name: string) => `${FEATURE_ASSET_BASE}/ui/${name}`;

const overview = [
  { label: "Play", value: "Tap to lift the tiles. Stop tapping to let them fall" },
  { label: "Cost", value: "One ticket after the shark eats a tile" },
  { label: "Best target", value: "The Reward Tile first, then Cattle" },
  { label: "Time", value: "60 seconds per attempt" },
];

const tiles = [
  {
    name: "Fish",
    art: "A_UI_WaterGame_Offerings01_Img.png",
    payout: "1 Feast Coin",
    tone: "ga-chest--worst",
    note: "The lowest-value animal. Choose it only when nothing better is in reach.",
  },
  {
    name: "Sheep",
    art: "A_UI_WaterGame_Offerings02_Img.png",
    payout: "2 Feast Coins",
    tone: "ga-chest--mid",
    note: "A useful fallback if Cattle is not in reach.",
  },
  {
    name: "Cattle",
    art: "A_UI_WaterGame_Offerings03_Img.png",
    payout: "3 Feast Coins",
    tone: "ga-chest--best",
    note: "The highest coin payout on the board and the best normal target.",
  },
];

const steps = [
  {
    img: ui("A_UI_WaterGame_Help01_Img.png"),
    title: "Tap to make wind",
    body: "A shark sits in the middle of the board with animal tiles floating around it. Each tap sends up a gust of wind that lifts the tiles, and tapping again stacks more wind and pushes them higher.",
  },
  {
    img: ui("A_UI_WaterGame_SceneObject_BigFish_Img.png"),
    title: "The shark eats one",
    body: "When a tile drifts close enough to the shark, it eats it, and that tile is your reward. You have 60 seconds to line up the bite you want.",
  },
];

const shopTiers = [
  {
    rank: 1,
    title: "Crafting materials",
    verdict: "The best value in the shop. Both elixirs feed relic and exclusive-gear upgrades, where lasting power actually comes from.",
    rows: [
      { name: "Apotheosis Elixir x50", cost: 75, gate: 150 },
      { name: "Genesis Elixir x100", cost: 60, gate: 150 },
    ],
  },
  {
    rank: 4,
    title: "Totem keys & Star Chest",
    verdict: "Totem keys drop in amount each row, so buy top down. The Star Chest is a solid one-off.",
    rows: [
      { name: "Totem Keys x10", cost: 50, gate: 200 },
      { name: "Totem Keys x8", cost: 50, gate: 200 },
      { name: "Totem Keys x7", cost: 50, gate: 200 },
      { name: "Totem Keys x5", cost: 50, gate: 200 },
      { name: "Star Chest x20", cost: 80, gate: 150 },
    ],
  },
  {
    rank: 3,
    title: "Gear upgrades",
    verdict: "Worth clearing once the tiers above are done. Awakening, refining and artifact hammers all push gear power.",
    rows: [
      { name: "Equipment Awakening Selector", cost: 100, gate: 400 },
      { name: "Yellow Refining Stone x5", cost: 100, gate: 400 },
      { name: "Hammer Artifact Enhancement Stone x10", cost: 100, gate: 400 },
      { name: "Hammer Artifact Enhancement Stone x5", cost: 100, gate: 400 },
    ],
  },
  {
    rank: 2,
    title: "Heroes & Plumes",
    verdict: "Heroes are worthwhile when they improve your roster; otherwise keep the coins for stronger materials.",
    rows: [
      { name: "Nemesis", cost: 50, gate: 100, hero: "nemesis" },
      { name: "Phoenix", cost: 50, gate: 100, hero: "phoenix" },
      { name: "Jormungandr", cost: 50, gate: 100, hero: "jormungandr" },
      { name: "Prometheus", cost: 50, gate: 100, hero: "prometheus" },
      { name: "Hero Selector Card", cost: 100, gate: 150 },
      { name: "Plumes x10", cost: 30, gate: 0 },
      { name: "Plumes x8", cost: 30, gate: 0 },
      { name: "Plumes x7", cost: 30, gate: 0 },
      { name: "Plumes x5", cost: 30, gate: 0 },
    ],
  },
  {
    rank: 5,
    title: "Everything else",
    verdict: "Cheap top-ups. Clear these with whatever coins are left at the end of the cycle.",
    rows: [
      { name: "8h Upgrade Mats Pack", cost: 10, gate: 0 },
      { name: "8h Gold Pack", cost: 10, gate: 0 },
      { name: "8h Orison EXP Pack", cost: 10, gate: 0 },
      { name: "8h Evolution Mandala", cost: 10, gate: 0 },
      { name: "2h Upgrade Mats Selector x5", cost: 5, gate: 0 },
      { name: "2h Upgrade Mats Selector x4", cost: 5, gate: 0 },
      { name: "2h Upgrade Mats Selector x3", cost: 5, gate: 0 },
      { name: "2h Upgrade Mats Selector x2", cost: 5, gate: 0 },
    ],
  },
].sort((a, b) => a.rank - b.rank);

const rankRows = [
  { rank: "1", refining: 10, totems: 40, hammer: 20, ticket: 50 },
  { rank: "2", refining: 5, totems: 20, hammer: 15, ticket: 45 },
  { rank: "3", refining: 2, totems: 16, hammer: 10, ticket: 40 },
  { rank: "4 - 10", refining: 1, totems: 14, hammer: 9, ticket: 35 },
  { rank: "11 - 20", refining: 0, totems: 12, hammer: 8, ticket: 25 },
  { rank: "21 - 50", refining: 0, totems: 8, hammer: 7, ticket: 18 },
  { rank: "51 - 100", refining: 0, totems: 4, hammer: 6, ticket: 14 },
  { rank: "101 - 200", refining: 0, totems: 0, hammer: 5, ticket: 12 },
  { rank: "201 - 500", refining: 0, totems: 0, hammer: 3, ticket: 10 },
  { rank: "501 - 1000", refining: 0, totems: 0, hammer: 1, ticket: 9 },
  { rank: "1001 - 2000", refining: 0, totems: 0, hammer: 0, ticket: "8 to 7" },
  { rank: "2001 - 5000", refining: 0, totems: 0, hammer: 0, ticket: "6 to 4" },
  { rank: "5001 - 10000", refining: 0, totems: 0, hammer: 0, ticket: "3 to 2" },
  { rank: "10001+", refining: 0, totems: 0, hammer: 0, ticket: 1 },
];
---

<Base
  title="Benevolent Feast Guide | Motto Immortal"
  description="Benevolent Feast guide for Motto Immortal: how the tap-to-wind mechanic works, how to float high-value animal tiles into the shark, and what to buy with Feast Coins."
>
  <div class="ga-parallax ga-parallax--watergame">
    <div class="ga-hero-media" aria-hidden="true">
      <div class="ga-hero-backdrop"></div>
      <img src={ui("A_UI_WaterGame_SceneObject_BigFish_Img.png")} alt="" fetchpriority="high" />
    </div>
    <div class="ga-hero-stage">
      <div class="ga-hero-text">
        <span class="ga-hero-tag">Feature Guide</span>
        <h1 class="ga-hero-headline">Benevolent Feast</h1>
        <p class="ga-hero-sub">Lift the best reward into the shark and spend your Feast Coins wisely.</p>
      </div>
    </div>

    <div class="ga-body-bg">
      <div class="guide-body guide-body--arcanum">
        <section class="guide-section">
          <h2 class="guide-section-title">Quick Read</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">What you need to know</h3>
            <p class="guide-card-subheading">
              Tap to lift the tiles toward the shark. Stop tapping to let them fall. The first tile the shark eats is your reward.
            </p>
            <div class="guide-overview-grid">
              {overview.map((item) => (
                <div class="guide-overview-item">
                  <div class="guide-overview-label">{item.label}</div>
                  <div class="guide-overview-value">{item.value}</div>
                </div>
              ))}
            </div>
            <div class="ga-verdict-split">
              <div class="ga-verdict">
                <span class="ga-verdict-who">Early game</span>
                <p>Buy a featured hero only if it improves your team. Otherwise save your coins for upgrade materials.</p>
              </div>
              <div class="ga-verdict ga-verdict--alt">
                <span class="ga-verdict-who">Everyone else</span>
                <p>Take the Reward Tile first and use its free reset. If there is no Reward Tile, choose Cattle for 3 coins.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="guide-section">
          <h2 class="guide-section-title">How A Run Works</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">Tap to rise, wait to fall</h3>
            <p class="guide-card-subheading">
              Use quick taps until your target reaches the shark. If it rises too high, stop and let it fall. Avoid long bursts of taps.
              Each collected tile uses one ticket and adds one to your craft count, which unlocks shop items.
            </p>
            <div class="ga-steps ga-steps--two">
              {steps.map((step, index) => (
                <article class="ga-step">
                  <img src={step.img} alt="" loading="lazy" />
                  <div class="ga-step-text">
                    <span class="ga-step-num">{index + 1}</span>
                    <h4>{step.title}</h4>
                    <p>{step.body}</p>
                  </div>
                </article>
              ))}
            </div>
            <div class="guide-callout">
              The Reward Tile gives a selectable reward instead of Feast Coins and unlocks a free board reset. Take it first, reset,
              and look for the next one.
            </div>
          </div>
        </section>

        <section class="guide-section">
          <h2 class="guide-section-title">The Tiles</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">Bigger animal, bigger payout</h3>
            <p class="guide-card-subheading">
              If the board has no Reward Tile, choose the highest-value animal you can reach.
            </p>
            <div class="ga-chest-grid">
              {tiles.map((tile) => (
                <article class={`ga-chest ${tile.tone}`}>
                  <img src={icon(tile.art)} alt={`${tile.name} art`} loading="lazy" />
                  <h4>{tile.name}</h4>
                  <strong>{tile.payout}</strong>
                  <p>{tile.note}</p>
                </article>
              ))}
            </div>
            <div class="guide-callout">
              Priority: Reward Tile → Cattle → Sheep → Fish.
            </div>
          </div>
        </section>

        <section class="guide-section">
          <h2 class="guide-section-title">Rank Rewards</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">Do not overspend for rank</h3>
            <p class="guide-card-subheading">
              Stop when reaching the next reward bracket would cost more tickets than the extra rewards are worth.
            </p>
            <div class="ga-zone-table-wrap">
              <table class="ga-zone-table ga-rank-table">
                <thead>
                  <tr>
                    <th>Rank</th>
                    <th>Refining Stone</th>
                    <th>Totem Keys</th>
                    <th>Hammer Stone</th>
                    <th>Feast Ticket</th>
                  </tr>
                </thead>
                <tbody>
                  {rankRows.map((row) => (
                    <tr>
                      <td class="ga-rank-pos">{row.rank}</td>
                      <td class={row.refining ? "ga-weight ga-weight--peak" : "ga-rank-none"}>{row.refining || "-"}</td>
                      <td class={row.totems ? "ga-weight" : "ga-rank-none"}>{row.totems || "-"}</td>
                      <td class={row.hammer ? "ga-weight" : "ga-rank-none"}>{row.hammer || "-"}</td>
                      <td class="ga-weight ga-rank-conch">{row.ticket}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="guide-section">
          <h2 class="guide-section-title">The Shop</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">Buy in value order, best first</h3>
            <p class="guide-card-subheading">
              New players can buy a featured hero if it improves their team. Otherwise, prioritize elixirs, Totem Keys and the Star
              Chest, then gear materials. Coins and unused tickets carry over, so you do not need to spend them immediately.
            </p>
            <div class="ga-shop">
              {shopTiers.map((tier) => (
                <section class={`ga-shop-group${tier.rank === 1 ? " ga-shop-group--top" : ""}`}>
                  <header class="ga-shop-head">
                    <span class="ga-shop-rank">{tier.rank}</span>
                    <h4>{tier.title}</h4>
                  </header>
                  <p class="ga-shop-verdict">{tier.verdict}</p>
                  <ul class="ga-shop-rows">
                    {tier.rows.map((row) => (
                      <li class="ga-shop-row">
                        <span class="ga-shop-item">
                          {row.hero ? <a href={`/heroes/${row.hero}`}>{row.name}</a> : row.name}
                        </span>
                        <span class="ga-shop-meta">
                          <span class="ga-gate">
                            {row.gate > 0 ? `${row.gate} crafts` : "no gate"}
                          </span>
                          <span class="ga-shop-cost">{row.cost}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>

            <div class="ga-trap">
              <span class="ga-trap-kicker">Simple saving rule</span>
              <h4>Save when the next useful item is out of reach</h4>
              <p>
                Feast Coins and unused tickets carry over, but your craft count resets. Save your resources for a later event if you
                cannot reach the next useful shop unlock this time.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
</Base>
