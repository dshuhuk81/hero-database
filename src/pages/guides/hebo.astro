---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import heboData from "../../data/heroes/hebo.json";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const skillImage = (id: string) => `${R2_BASE}/skills/hebo_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "Sunstrike Tide Range is the payoff, not the start of the engine. Aim it at a tightly packed group that has already been softened below half HP; its small radius makes setup more important than raw range.",
  skill_2: "This four-dash sequence replaces Hebo's normal attacks. The damage rises with each pass, and the final, strongest dash knocks enemies down. Finishing the entire cast matters far more than merely starting it.",
  skill_3: "Every damaging dash grants a stack of Overlapping Waves, building Crit Rate for the rest of the sequence. Because the kit supplies substantial Crit Rate by itself, ATK and Crit Damage are generally more valuable offensive complements than stacking Crit Rate alone.",
  skill_4: "Hebo becomes tougher while dashing, retains the protection briefly afterward, and gains a large ATK-scaling Shield at Skill Lv3—but the Shield only appears after a completed sequence.",
};

const skills = heboData.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  takeaway: takeaways[skill.id],
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
}));

const relic = {
  ...heboData.relic,
  upgrades: Object.entries(heboData.relic.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
  badge: "Exclusive Equipment",
  levelBadge: "Completion payoff",
  takeaway: "Every equipment benefit requires a full Wave-Chasing Slash. Base and Lv3 help refill Energy, but extra Energy has limited value while the bar is full and Hebo is waiting to cast. Lv2 and Lv4 add permanent offensive scaling over the first three completed cycles.",
};

const strengths = [
  "Four mobile area attacks replace basic attacks and pressure clustered formations",
  "The final dash has the highest coefficient and adds Knockdown",
  "Repeated dash hits can supply 40 percentage points of Crit Rate across a full four-hit sequence at maximum skill level",
  "Damage reduction ramps during the sequence and persists briefly after it ends",
  "A completed sequence grants a Shield equal to 400% of ATK at Skill Lv3",
  "The Ultimate gains 50% more damage against enemies below half HP at maximum level",
  "Exclusive Equipment rewards repeated completions with Energy and permanent ATK scaling",
  "Can serve as the main PvE damage source across large level gaps with sustained team support",
];

const weaknesses = [
  "An interrupted or unfinished dash cycle denies its Shield, ATK buff, and equipment rewards",
  "He performs no conventional basic attacks, sharply reducing the value of Attack Speed and basic-attack effects",
  "He needs roughly one full opening rotation before Shield, Energy, and lasting ramp become available",
  "His movement can carry him out of a protected formation and into enemy burst",
  "Both the dashes and Ultimate lose value when enemies are spread apart",
  "Concentrated burst can overwhelm his damage reduction and Shields even after completed cycles",
  "Full Energy does not guarantee an immediate Ultimate, and a late cast may arrive after supports fall",
  "More healing can extend his survival without giving him enough damage to finish dangerous enemies",
  "He provides little direct team support beyond area pressure and the final Knockdown",
];
---

<Base title="Hebo Guide - Wave-Chasing Ramp Warrior | Motto Immortal" description="Complete Hebo guide covering his four-dash rotation, completion rewards, execute Ultimate, Exclusive Equipment, builds, teams, PvE, PvP, strengths, weaknesses, and counterplay.">
  <div class="guide-banner guide-banner--heket guide-banner--spades">
    <div class="guide-banner-bg" style={`background-image: url('${heroImage("hebo")}'); --guide-banner-y: 11%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg><span>Guides</span></a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Hebo</h1>
      <p class="guide-hero-subtitle">Wave-Chasing Bruiser &middot; Ramp Carry</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/spades.webp`} alt="Spades" />Spades</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/warrior.webp`} alt="Warrior" />Warrior</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--spades">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Hebo at a Glance</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
      <div class="heket-verdict-main"><div class="heket-verdict-icon" style={`background-image: url('${skillImage("skill_2")}');`} role="img" aria-label="Wave-Chasing Slash"></div><div><span class="heket-verdict-kicker">Team-building verdict</span><h3>Protect repeated rotations and give his Ultimate valuable targets.</h3><p>Hebo, the God of the Yellow River, is a mobile Physical bruiser and supported PvE carry. Wave-Chasing Slash replaces his basic attacks, building CRIT Rate and damage reduction during its four dashes. Completing the sequence adds a Shield, an ATK buff, and Exclusive Equipment rewards. He can carry against large level gaps when allies sustain this loop and keep weakened enemies within reach of Sunstrike Tide Range. His protection remains vulnerable to concentrated burst, and losing key supports can stop him from turning strong damage into a win.</p></div></div>
        <div class="heket-fact-strip"><div><span>Role</span><strong>Ramp bruiser</strong></div><div><span>Core condition</span><strong>Complete all four dashes</strong></div><div><span>Best fit</span><strong>Protected cluster fights</strong></div></div>
        <div class="heket-verdict-warning"><strong>Key warning</strong><span>Wave-Chasing Slash replaces normal attacks. Attack Speed and effects requiring basic attacks do not improve his main loop in the usual way.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Wave-Chasing Loop</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-engine">
        <div class="heket-engine-flow">
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_2")}');`}></div><span>Enter</span><strong>Dash through the cluster</strong><p>Four passes deal rising area damage, ending in the strongest hit and Knockdown.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_3")}');`}></div><span>Ramp</span><strong>Stack Crit while moving</strong><p>Every damaging pass grants Overlapping Waves, raising CRIT Rate and making the later hits increasingly threatening.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_4")}');`}></div><span>Complete</span><strong>Gain the Shield and rewards</strong><p>Damage reduction builds during the dashes and lingers after they end. A full sequence grants the Shield and completion rewards.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_1")}');`}></div><span>Execute</span><strong>Ultimate the weakened group</strong><p>Sunstrike Tide Range rewards dense targets, with extra damage below half HP.</p></div>
        </div>
        <div class="heket-engine-return"><span>Start the next rotation stronger</span></div>
        <div class="heket-engine-rule"><strong>Completion starts the next opportunity.</strong><span>An unfinished sequence denies its Shield, ATK buff, and equipment rewards. After completion, Hebo still needs protection, living supports, and useful Ultimate targets to keep the next rotation productive.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Skills: What They Mean</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}><header class="guide-skill-panel-head"><div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div><img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" /></header><p class="guide-skill-panel-text">{skill.description}</p><div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{skill.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div><p class="guide-skill-panel-takeaway"><strong>In practice</strong>{skill.takeaway}</p></article>)}
          <article class="guide-skill-panel" data-guide-skill="relic"><header class="guide-skill-panel-head"><div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">{relic.badge}</span><span class="guide-skill-badge guide-skill-badge--level">{relic.levelBadge}</span></div></div><img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" /></header><p class="guide-skill-panel-text">{relic.description}</p><div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{relic.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div><p class="guide-skill-panel-takeaway"><strong>In practice</strong>{relic.takeaway}</p></article>
        </div>
        <ol class="guide-skill-selector">{skills.map((skill, index) => <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><small>{skill.badge}</small></span></button></li>)}<li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><small>{relic.badge}</small></span></button></li></ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Exclusive Equipment Investment</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint guide-apple-breakpoint--key"><span>Base</span><strong>Energy after every full sequence</strong><p>The engine begins feeding the next Ultimate as soon as Hebo reliably completes Wave-Chasing Slash.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv2</span><strong>Permanent ATK ramp</strong><p>Each of the first three completed sequences adds 25% ATK, rewarding long PvE fights.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv3</span><strong>50% more completion Energy</strong><p>The listed payout rises from 200 to 300 Energy. This helps refill the bar, but capped Energy or a delay before casting can limit the benefit.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--max"><span>Lv4 &middot; Premium target</span><strong>40% ATK per stack</strong><p>Three completions can build a listed total of 120% ATK, making this the long-fight ceiling.</p></div>
      </div>
      <div class="guide-callout"><strong>Investment takeaway:</strong> base equipment enables the Energy loop, and Lv2 adds permanent ATK scaling. Further upgrades are optional priorities for a dedicated Hebo carry team. Higher equipment levels do not guarantee protection from burst, uninterrupted casts, or better Ultimate coverage; invest in a team that can sustain useful rotations before chasing his long-fight ceiling.</div>
    </section>

    <section class="guide-section guide-section--detail-heading"><h2 class="guide-section-title lt-h2 lt-h2-center">Strengths &amp; Weaknesses</h2><div class="lt-flourish lt-flourish-center"></div><StrengthWeakness strengths={strengths} weaknesses={weaknesses} /></section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Team Building</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-partners">
        <article class="heket-partner-feature"><img src={heroImage("poseidon")} alt="Poseidon" /><div class="heket-partner-feature-content"><span class="heket-partner-label">Frontline archetype</span><h3>Poseidon</h3><strong>Create room for the first complete sequence</strong><p>A durable first-contact tank can absorb opening pressure and help keep enemies near one another. Poseidon fills this role alongside recovery and control that support Hebo through later rotations.</p><div class="heket-partner-tags"><span>Front anchor</span><span>Cluster control</span><span>Early protection</span></div></div></article>
        <div class="heket-partner-options">
          <article class="heket-partner-option"><img src={heroImage("tefnut")} alt="Tefnut" /><div><span class="heket-partner-label">Recovery and protection option</span><h3>Tefnut</h3><p>Healing and Shields help Hebo bridge successive damage windows. Her rain area supplies recovery and, with the relevant equipment upgrade, damage reduction; positioning matters as Hebo moves. More sustain buys time, but the team still needs to reduce dangerous enemy pressure.</p></div></article>
          <article class="heket-partner-option"><img src={heroImage("yuelao")} alt="Yuelao" /><div><span class="heket-partner-label">Linked support option</span><h3>Yuelao</h3><p>ATK, Energy, and linked protection complement Hebo's rotations. The link selects allies by ATK and HP, so check that Hebo receives the intended benefits. With Yuelao's equipment, Hebo's damage can heal the linked partner with the highest HP; this healing comes from Yuelao's link mechanic.</p></div></article>
          <article class="heket-partner-option"><img src={heroImage("hephaestus")} alt="Hephaestus" /><div><span class="heket-partner-label">Field sustain and control option</span><h3>Hephaestus</h3><p>His devices create zones that restore HP and Energy while reducing enemy ATK and Attack Speed, helping Hebo bridge repeated rotations. Artisan's Insight can also restrain a high-damage threat and reduce its Armor. Device effects can continue supporting Hebo after Hephaestus falls, but he needs time and Ultimate access to activate the full field.</p></div></article>
          <article class="heket-partner-option"><img src={heroImage("caishen")} alt="Caishen" /><div><span class="heket-partner-label">Energy and ATK option</span><h3>Caishen</h3><p>ATK improves the dashes, Ultimate, and completion Shield together. Energy support helps when Hebo is short of a full bar, but has limited value while he is already capped and waiting to cast. Prioritize protection and productive Ultimate windows.</p></div></article>
          <article class="heket-partner-option"><img src={heroImage("mengpo")} alt="Mengpo" /><div><span class="heket-partner-label">Sustain and control option</span><h3>Mengpo</h3><p>Sustain and control help protect the opening sequence and bridge later rotations. Keep support heroes alive so Hebo can continue receiving recovery as enemy pressure builds.</p></div></article>
          <article class="heket-partner-option"><img src={heroImage("geb")} alt="Geb" /><div><span class="heket-partner-label">Grouping option</span><h3>Geb</h3><p>Pulls and grouping multiply both the late Wave-Chasing Slash hits and the small-radius Ultimate. Any reliable cluster-maker can fill this role.</p></div></article>
        </div>
        <div class="heket-partner-rule"><span>Team rule</span><strong>Cover opening protection, recovery between rotations, and a way to reduce dangerous enemy pressure. Use control, grouping, or focused damage to help Hebo reach valuable targets before his supports fall.</strong></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Build, Positioning &amp; Counterplay</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Winning pattern</span><h3>Enter second, finish the sequence, execute the cluster.</h3></div>
        <div class="heket-tactics">
          <article><div class="heket-tactic-marker">Place</div><h4>Do not use him as the only tank</h4><p>Start him close enough to find a target quickly, but behind or beside a durable first-contact hero so the initial burst lands elsewhere.</p></article>
          <article><div class="heket-tactic-marker">Build</div><h4>Balance durability with ATK and Crit Damage</h4><p>ATK scales every major damage source and the Shield. His passive supplies Crit Rate, making Crit Damage a natural complement. Support these offensive stats with enough durability to finish sequences and survive the next damage window.</p></article>
          <article><div class="heket-tactic-marker">Avoid</div><h4>Do not prioritize Attack Speed</h4><p>His normal attacks are replaced by a long skill sequence. Extra Energy is most useful when the bar needs refilling; a full bar does not guarantee an immediate Ultimate.</p></article>
        </div>
        <div class="heket-matchup-row"><div class="heket-matchup-good"><span>Favorable fights</span><strong>Dense formations and manageable damage windows</strong><p>Multiple nearby non-summon targets let each dash and the Ultimate multiply their value. Reaching several weakened enemies makes each Ultimate more productive. Longer PvE waves also allow Exclusive Equipment stacks to accumulate.</p></div><div class="heket-matchup-bad"><span>Difficult matchups</span><strong>Concentrated burst, disruption, and spacing</strong><p>Control or death before the final dash can deny completion rewards. Burst can also overwhelm active Shields later in the fight, especially after supports fall. Spread formations reduce area damage and can leave an Ultimate reaching too few important targets.</p></div></div>
        <p class="heket-hades-note"><strong>Turn survival into progress:</strong> healing should buy time to weaken or eliminate dangerous enemies. Outlasting allies or supplying most of the team's damage does not ensure a clear if those threats remain active. Protect the support line and adjust control or targeting when extra recovery only delays defeat.</p>
        <p class="heket-hades-note"><strong>Against summon teams:</strong> Hebo's direct dash targeting prefers non-summons, but the surrounding area damage can still hit summoned bodies. That can create useful collateral damage, yet it may also keep him from reaching a more valuable backline target.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">PvE vs PvP</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan"><div class="heket-matchup-row"><div class="heket-matchup-good"><span>PvE</span><strong>A supported carry for grouped waves</strong><p>Hebo can supply the main damage in Tower and Odyssey across large level gaps when his team sustains repeated rotations. Enemy composition matters alongside level suppression: concentrated burst, disruption, and poor Ultimate coverage can make a similar level gap much harder. Adjust the support and targeting plan to the encounter.</p></div><div class="heket-matchup-bad"><span>PvP</span><strong>Demanding protection requirements</strong><p>Fast burst and disruption can deny the completed sequences that supply his Shield, ATK buffs, and equipment rewards. His area pressure benefits from grouping, but he needs an opening that keeps both him and his supports alive long enough to make follow-up damage decisive.</p></div></div></div>
    </section>

    <section class="guide-section guide-section--detail-heading"><h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2><div class="lt-flourish lt-flourish-center"></div><div class="guide-verdict-box"><h3 class="guide-verdict-heading">A capable PvE carry with demanding support needs</h3><p class="guide-verdict-text">Hebo combines repeated area damage, personal Shields, and growing offensive power. He can handle large level gaps when his team protects his rotations and gives his Ultimate valuable targets. Concentrated burst, disruption, and the loss of key supports make his output less reliable, even after his Shields are active.<br><br>Prioritize protection and recovery that keep successive rotations productive, then improve ATK, Crit Damage, and target coverage. Extra Energy helps when he needs to refill the bar, but cannot ensure an immediate cast or rescue a collapsing formation. He is a situational investment for rosters that can support his playstyle, with lower priority when resources are limited or more flexible carries still need development.</p></div></section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) button.addEventListener("click", () => {
        const id = button.getAttribute("data-guide-skill-button");
        for (const other of buttons) { const active = other === button; other.classList.toggle("is-active", active); other.setAttribute("aria-pressed", String(active)); }
        for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
      });
    }
  </script>
</Base>
