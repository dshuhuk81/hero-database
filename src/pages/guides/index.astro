---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import allHeroes from "../../data/all_heroes_db.json";
import { guides } from "../../data/guides";
import { activeBadge, navEntries } from "../../data/nav";
import { pickLang } from "../../i18n/helpers";
import "../../styles/components.css";

const MODE_GUIDE_HREFS = ["/guides/golden-arcanum", "/guides/votive-festival", "/guides/benevolent-feast", "/delusions-den", "/events", "/bosses", "/virtues"];
const modeCards = MODE_GUIDE_HREFS
  .map((href) => navEntries.find((entry) => entry.href === href))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry))
  .filter((entry) => import.meta.env.DEV || !entry.localOnly);
const guidesBadge = activeBadge(navEntries.find((entry) => entry.href === "/guides")!);

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const HERO_ASSET_BASE = `${R2_BASE}/heroes`;
const HERO_IMAGE_VERSION = "2026-06-08-portrait";

const heroCardImage = (id: string, width = 240) => (
  `${HERO_ASSET_BASE}/cards/${encodeURIComponent(id)}-${width}.webp?v=${HERO_IMAGE_VERSION}`
);

const cards = guides
  .filter((guide) => import.meta.env.DEV || !guide.localOnly)
  .filter((guide) => Boolean(guide.heroId))
  .map((guide) => {
    const hero = guide.heroId
      ? (allHeroes[guide.heroId as keyof typeof allHeroes] as
          | { name?: string }
          | undefined)
      : undefined;
    return {
      ...guide,
      heroName: hero?.name ?? guide.heroId ?? guide.title,
      portrait: guide.heroId ? heroCardImage(guide.heroId, 360) : guide.image ?? "",
    };
  });
---

<Base
  title="Hero Guides | Motto Immortal"
  description="Deep-dive hero guides and game mode guides for Motto Immortal"
>
  <PageHero
    id="guides"
    tag="Guides"
    headline="Guides"
    subtitle="Deep-dive hero guides and game mode guides for Motto Immortal"
  />

  <div class="page-wrapper">
    <h2 class="guides-index-section-title">Game Mode Guides</h2>
    <div class="guides-mode-grid">
      {modeCards.map((entry) => (
        <a class="guides-mode-card" href={entry.href}>
          <div class="guides-mode-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={entry.icon} />
          </div>
          <div class="guides-mode-text">
            <h3 class="guides-mode-title">{entry.label}</h3>
            {entry.description && <p class="guides-mode-hook">{pickLang(entry.description, "en")}</p>}
          </div>
        </a>
      ))}
    </div>

    <h2 class="guides-index-section-title">Hero Guides</h2>
    <div class="guides-mode-grid">
      {cards.map((card, index) => (
        <a class="guides-mode-card guides-mode-card--hero" href={card.href}>
          <div
            class="guides-mode-portrait"
            style={`background-image: url('${card.portrait}')`}
            role="img"
            aria-label={card.heroName}
          >
          </div>
          <div class="guides-mode-text">
            <h3 class="guides-mode-title">{card.title}</h3>
            <p class="guides-mode-hook">{card.hook}</p>
          </div>
          {index === 0 && guidesBadge && (
            <span
              class="guides-mode-badge"
              style={guidesBadge.color ? `background-color: ${guidesBadge.color};` : undefined}
            >
              {pickLang(guidesBadge.text, "en")}
            </span>
          )}
        </a>
      ))}
    </div>
  </div>
</Base>
