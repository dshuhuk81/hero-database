---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import allHeroes from "../../data/all_heroes_db.json";
import divineThroneData from "../../data/divine-throne.json";

const FEATURE_ASSET_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev/features/divine-throne";

const featureAsset = (name: string) => `${FEATURE_ASSET_BASE}/${name}`;
const factionOrder = ["Starglint", "Hearts", "Clubs", "Diamonds", "Spades"];
const recommendedHeroOrder = ["zeus", "dionysus", "nyx", "amunra", "bastet", "phoenix", "set", "jingwei"];
const recommendedHeroRank = new Map(recommendedHeroOrder.map((id, index) => [id, index]));
const interestingHeroIds = new Set(["fengyi"]);

const overview = [
  { label: "Unlock", value: "Clear Journey 25-3 and raise the hero to the required rank" },
  { label: "Where", value: "Deity screen, beside the Artifact slot" },
  { label: "Spend", value: "Ether items to upgrade individual heroes" },
  { label: "Payoff", value: "Stats, exclusive Divine Throne skills, and Divine Authority" },
];

const resourceCards = [
  {
    name: "Immaculate Ether",
    asset: "immaculate-ether.png",
    role: "Base upgrade material",
    note: "Used for regular Divine Throne upgrade attempts.",
  },
  {
    name: "Pure Ether",
    asset: "pure-ether.png",
    role: "Higher-tier upgrade material",
    note: "Used once the hero advances into stronger upgrade requirements.",
  },
  {
    name: "Steadfast Ether",
    asset: "steadfast-ether.png",
    role: "Downgrade protection",
    note: "Each one removes 10% of the downgrade risk. 10 in a single attempt means 0% risk. It never raises the success chance.",
  },
];

const protectionRows = [
  [0, 90, 50, 10],
  [1, 81, 45, 9],
  [2, 72, 40, 8],
  [3, 63, 35, 7],
  [4, 54, 30, 6],
  [5, 45, 25, 5],
  [6, 36, 20, 4],
  [7, 27, 15, 3],
  [8, 18, 10, 2],
  [9, 9, 5, 1],
  [10, 0, 0, 0],
] as const;

const resourceIcons = {
  "Immaculate Ether": "immaculate-ether.png",
  "Pure Ether": "pure-ether.png",
  "Steadfast Ether": "steadfast-ether.png",
} as const;

const upgradeRows = [
  [1, "Immaculate Ether", 5, 100],
  [2, "Immaculate Ether", 5, 100],
  [3, "Immaculate Ether", 10, 100],
  [4, "Immaculate Ether", 10, 100],
  [5, "Immaculate Ether", 15, 100],
  [6, "Immaculate Ether", 15, 100],
  [7, "Immaculate Ether", 20, 100],
  [8, "Immaculate Ether", 20, 100],
  [9, "Immaculate Ether", 25, 100],
  [10, "Immaculate Ether", 25, 100],
  [11, "Immaculate Ether", 30, 100],
  [12, "Immaculate Ether", 30, 100],
  [13, "Immaculate Ether", 35, 100],
  [14, "Immaculate Ether", 35, 100],
  [15, "Immaculate Ether", 40, 100],
  [16, "Immaculate Ether", 40, 100],
  [17, "Immaculate Ether", 45, 100],
  [18, "Immaculate Ether", 45, 100],
  [19, "Immaculate Ether", 50, 100],
  [20, "Immaculate Ether", 50, 100],
  [21, "Pure Ether", 5, 90],
  [22, "Pure Ether", 5, 90],
  [23, "Pure Ether", 10, 90],
  [24, "Pure Ether", 10, 90],
  [25, "Pure Ether", 15, 80],
  [26, "Pure Ether", 15, 80],
  [27, "Pure Ether", 20, 80],
  [28, "Pure Ether", 20, 80],
  [29, "Pure Ether", 25, 70],
  [30, "Pure Ether", 25, 70],
  [31, "Pure Ether", 30, 70],
  [32, "Pure Ether", 35, 70],
  [33, "Pure Ether", 40, 60],
  [34, "Pure Ether", 45, 60],
  [35, "Pure Ether", 50, 50],
  [36, "Pure Ether", 60, 50],
  [37, "Pure Ether", 70, 40],
  [38, "Pure Ether", 80, 30],
  [39, "Pure Ether", 90, 20],
  [40, "Pure Ether", 100, 10],
] as const;

const firstWaveHeroes = [
  { id: "fengyi", name: "Fengyi" },
  { id: "anubis", name: "Anubis" },
  { id: "freya", name: "Freya" },
  { id: "nemesis", name: "Nemesis" },
  { id: "demeter", name: "Demeter" },
  { id: "sekhmet", name: "Sekhmet" },
  { id: "ares", name: "Ares" },
  { id: "artemis", name: "Artemis" },
  { id: "diana", name: "Diana" },
  { id: "nuwa", name: "Nuwa" },
  { id: "phoenix", name: "Phoenix" },
  { id: "geb", name: "Geb" },
  { id: "bastet", name: "Bastet" },
  { id: "poseidon", name: "Poseidon" },
  { id: "medusa", name: "Medusa" },
  { id: "isis", name: "Isis" },
  { id: "yanluo", name: "Yanluo" },
  { id: "hecate", name: "Hecate" },
  { id: "momus", name: "Momus" },
  { id: "nyx", name: "Nyx" },
  { id: "zeus", name: "Zeus" },
  { id: "khepri", name: "Khepri" },
  { id: "caishen", name: "Caishen" },
  { id: "yuelao", name: "Yuelao" },
  { id: "jingwei", name: "Jingwei" },
  { id: "jormungandr", name: "Jormungandr" },
  { id: "prometheus", name: "Prometheus" },
  { id: "pan", name: "Pan" },
  { id: "hela", name: "Hela" },
  { id: "dionysus", name: "Dionysus" },
  { id: "set", name: "Set" },
  { id: "athena", name: "Athena" },
  { id: "horus", name: "Horus" },
  { id: "iris", name: "Iris" },
  { id: "amunra", name: "Amunra" },
  { id: "ullr", name: "Ullr" },
].map((hero) => ({
  ...hero,
  faction: allHeroes[hero.id as keyof typeof allHeroes]?.faction ?? "",
  milestones: divineThroneData.heroes.find((entry) => entry.heroId === hero.id)?.milestones ?? [],
  throneAssetId:
    divineThroneData.heroes.find((entry) => entry.heroId === hero.id)?.throneAssetId ?? hero.id,
  recommended: recommendedHeroRank.has(hero.id),
  interesting: interestingHeroIds.has(hero.id),
})).sort((a, b) => {
  const recommendationDifference =
    (recommendedHeroRank.get(a.id) ?? recommendedHeroOrder.length) -
    (recommendedHeroRank.get(b.id) ?? recommendedHeroOrder.length);
  if (recommendationDifference) return recommendationDifference;

  const factionDifference =
    (factionOrder.indexOf(a.faction) === -1 ? factionOrder.length : factionOrder.indexOf(a.faction)) -
    (factionOrder.indexOf(b.faction) === -1 ? factionOrder.length : factionOrder.indexOf(b.faction));
  return factionDifference || a.name.localeCompare(b.name);
});
---

<Base
  title="Divine Throne Guide | Motto Immortal"
  description="One-page Divine Throne guide for Motto Immortal: unlock requirements, Ether resources, exclusive skills, Divine Authority, and first-wave heroes."
>
  <div class="divine-throne-parallax">
    <div class="divine-throne-hero-media" aria-hidden="true">
      <div class="divine-throne-hero-backdrop"></div>
      <img src={featureAsset("zeus.png")} alt="" fetchpriority="high" />
    </div>
    <div class="divine-throne-hero-stage">
      <div class="divine-throne-hero-text">
        <span class="divine-throne-hero-tag">Feature Guide</span>
        <h1 class="divine-throne-hero-headline">Divine Throne</h1>
        <p class="divine-throne-hero-sub">Hero-specific upgrades, exclusive skills, and Divine Authority.</p>
      </div>
    </div>

    <div class="divine-throne-body-bg">
  <div class="guide-body guide-body--divine-throne">
    <GuideSectionNav />
    <section class="guide-section">
      <h2 class="guide-section-title">Quick Read</h2>
      <div class="guide-card divine-overview-card">
        <div class="divine-feature-lede">
          <div>
            <h3 class="guide-card-heading">What Divine Throne actually is</h3>
            <p class="guide-card-subheading">
              A long-term upgrade system for individual heroes. You spend Ether, complete stages, and unlock direct combat stats plus hero-exclusive effects.
            </p>
          </div>
        </div>
        <div class="guide-overview-grid">
          {overview.map((item) => (
            <div class="guide-overview-item">
              <div class="guide-overview-label">{item.label}</div>
              <div class="guide-overview-value">{item.value}</div>
            </div>
          ))}
        </div>
        <p class="guide-quick-verdict">
          It is not a new battle mode. Treat it like the next permanent progression layer after rank and artifacts, with the main decision being which hero deserves scarce Ether first.
        </p>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Resources</h2>
      <div class="guide-card guide-board-card">
        <h3 class="guide-card-heading">Ether is the bottleneck</h3>
        <p class="guide-card-subheading">
          Three Ether items matter for the upgrade loop. The most important detail: protection Ether does not improve your odds; it only reduces the punishment for a failed roll.
        </p>
        <div class="divine-resource-grid">
          {resourceCards.map((item) => (
            <div class="divine-resource-card">
              <img src={featureAsset(item.asset)} alt="" loading="lazy" />
              <h4>{item.name}</h4>
              <strong>{item.role}</strong>
              <p>{item.note}</p>
            </div>
          ))}
        </div>
        <div class="divine-resource-source">
          <div class="divine-resource-source-intro">
            <span class="divine-resource-source-kicker">How to get Ether</span>
            <h4>Progress through the Starseeking Journal</h4>
            <p>
              Complete Starseeking quests to earn Journal progress and unlock rewards step by step. The Journal has 100 levels, with a free reward track and an optional paid track that adds more Ether.
            </p>
          </div>
          <div class="divine-journal-grid">
            <article class="divine-journal-card">
              <div class="divine-journal-card-heading">
                <span>Free track</span>
                <strong>F2P</strong>
              </div>
              <p>Available by completing quests and reaching all 100 Journal levels.</p>
              <div class="divine-journal-rewards">
                <div>
                  <img src={featureAsset(resourceIcons["Immaculate Ether"])} alt="" loading="lazy" />
                  <span><strong>100</strong> Immaculate Ether</span>
                </div>
                <div>
                  <img src={featureAsset(resourceIcons["Pure Ether"])} alt="" loading="lazy" />
                  <span><strong>20</strong> Pure Ether</span>
                </div>
              </div>
            </article>
            <article class="divine-journal-card divine-journal-card--paid">
              <div class="divine-journal-card-heading">
                <span>Paid track</span>
                <strong>Additional rewards</strong>
              </div>
              <p>Purchase the Starseeking pack, then progress through the same 100 Journal levels.</p>
              <div class="divine-journal-rewards">
                <div>
                  <img src={featureAsset(resourceIcons["Immaculate Ether"])} alt="" loading="lazy" />
                  <span><strong>400</strong> Immaculate Ether</span>
                </div>
                <div>
                  <img src={featureAsset(resourceIcons["Pure Ether"])} alt="" loading="lazy" />
                  <span><strong>200</strong> Pure Ether</span>
                </div>
                <div>
                  <img src={featureAsset(resourceIcons["Steadfast Ether"])} alt="" loading="lazy" />
                  <span><strong>1</strong> Steadfast Ether</span>
                </div>
              </div>
            </article>
          </div>
        </div>
        <div class="guide-callout">
          Upgrade success completes the next step. Upgrade failure can lower the Divine Throne by one level. Steadfast Ether reduces downgrade risk, but it does not increase success rate. The paid Journal track grants only 1 Steadfast Ether, and a fully protected attempt needs 10.
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Upgrade Resources: Levels 1–40</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Ether required for each level</h3>
        <p class="guide-card-subheading">
          The amount shown is the cost of one upgrade attempt. Failed attempts may require additional Ether.
        </p>
        <div class="divine-upgrade-summary">
          <div>
            <img src={featureAsset(resourceIcons["Immaculate Ether"])} alt="Immaculate Ether" />
            <span class="divine-upgrade-summary-copy"><strong>Levels 1–20</strong><span>550 Immaculate Ether</span></span>
          </div>
          <div>
            <img src={featureAsset(resourceIcons["Pure Ether"])} alt="Pure Ether" />
            <span class="divine-upgrade-summary-copy"><strong>Levels 21–40</strong><span>750 Pure Ether</span></span>
          </div>
        </div>
        <div class="divine-upgrade-tables">
          {[upgradeRows.slice(0, 20), upgradeRows.slice(20)].map((rows, tableIndex) => (
            <div class="divine-upgrade-table-wrap">
              <table class="divine-upgrade-table">
                <thead>
                  <tr>
                    <th>Level {tableIndex === 0 ? "1–20" : "21–40"}</th>
                    <th>Amount</th><th>Chance</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map(([level, , amount, chance]) => (
                    <tr>
                      <td>{level}</td>
                      <td>{amount}</td><td>{chance}%</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Downgrade Protection</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">How Steadfast Ether actually works</h3>
        <p class="guide-card-subheading">
          Steadfast Ether is not a one-time save, and it is not a random chance to block a downgrade. Every piece you add lowers the downgrade risk by a flat 10% of its value, and you can add up to 10 per attempt.
        </p>
        
        <div class="guide-callout">
          Even a fully protected attempt can still fail. With 10 Steadfast Ether you cannot lose a level, but a failed roll still consumes the Ether cost and leaves you at your current level. Every upgrade up to Level 20 succeeds, so the protection slot stays disabled until the first risky attempt at 20→21.
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Hero list ({firstWaveHeroes.length})</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Heroes to upgrade</h3>
        <p class="guide-card-subheading">
          Upgrade divine throne in order to boost certain skills.
        </p>
        <div class="divine-roster-grid">
          {firstWaveHeroes.map((hero) => (
            <article class:list={["divine-roster-card", { "divine-roster-card--recommended": hero.recommended }]}>
              {(hero.recommended || hero.interesting) && (
                <div class="divine-roster-badges">
                  {hero.recommended && <span class="divine-roster-badge divine-roster-badge--recommended">Recommended</span>}
                  {hero.interesting && <span class="divine-roster-badge divine-roster-badge--interesting">Interesting</span>}
                </div>
              )}
              <a class="divine-roster-hero" href={`/heroes/${hero.id}`}>
                <img
                  class="divine-roster-throne"
                  src={`${FEATURE_ASSET_BASE}/thrones/${hero.throneAssetId}.png`}
                  alt={`${hero.name} Divine Throne`}
                  loading="lazy"
                  decoding="async"
                />
                <span>{hero.name}</span>
              </a>
              <div class="divine-roster-milestones" aria-label={`${hero.name} Divine Throne skills`}>
                {hero.milestones.map((milestone) => (
                  <div class="upgrade-row">
                    <span class="upgrade-lv">Lv {milestone.level}</span>
                    <span class="upgrade-text">{milestone.text.en}</span>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
      </div>
    </div>
  </div>

  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
</Base>

<style>
  .divine-resource-source {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-faint);
  }

  .divine-resource-source-intro { max-width: 760px; }

  .divine-resource-source-kicker {
    color: var(--accent-gold);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .divine-resource-source-intro h4 {
    margin: var(--space-2) 0;
    color: var(--text-bright);
    font-size: var(--text-lg);
  }

  .divine-resource-source-intro p,
  .divine-journal-card > p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .divine-journal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .divine-journal-card {
    padding: var(--space-5);
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
  }

  .divine-journal-card--paid {
    border-color: var(--guide-accent-line);
    background: linear-gradient(145deg, var(--guide-accent-dim), var(--bg-raised) 72%);
  }

  .divine-journal-card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .divine-journal-card-heading span {
    color: var(--text-bright);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
  }

  .divine-journal-card-heading strong {
    color: var(--accent-gold);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .divine-journal-rewards {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .divine-journal-rewards > div {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-surface) 82%, transparent);
  }

  .divine-journal-rewards img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .divine-journal-rewards span {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .divine-journal-rewards strong { color: var(--text-bright); }

  .divine-protection-formula {
    margin-bottom: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--guide-accent-line);
    border-radius: var(--radius-md);
    background: var(--guide-accent-dim);
    color: var(--text-bright);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    line-height: 1.6;
    text-align: center;
  }

  .divine-upgrade-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  @media (max-width: 640px) {
    .divine-journal-grid { grid-template-columns: 1fr; }
    .divine-journal-card-heading { align-items: flex-start; flex-direction: column; }
  }

  .divine-upgrade-summary div {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
  }

  .divine-upgrade-summary img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .divine-upgrade-summary-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .divine-upgrade-summary strong { color: var(--text-bright); }
  .divine-upgrade-summary span { color: var(--accent-gold); }
  .divine-upgrade-tables {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .divine-upgrade-table-wrap { min-width: 0; overflow-x: auto; }

  .divine-upgrade-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xs);
  }

  .divine-upgrade-table th,
  .divine-upgrade-table td {
    padding: var(--space-2) var(--space-1);
    border-bottom: 1px solid var(--border-faint);
    text-align: left;
  }

  .divine-upgrade-table th {
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .divine-upgrade-table td { color: var(--text-secondary); }
  .divine-upgrade-table td:first-child,
  .divine-upgrade-table td:last-child { font-weight: var(--weight-bold); }

  .divine-roster-grid {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  .divine-roster-card {
    position: relative;
    min-height: 0;
    align-items: stretch;
    gap: var(--space-3);
    padding: var(--space-4);
    text-align: left;
    background:
      linear-gradient(180deg, rgba(255, 208, 74, 0.06), rgba(255, 208, 74, 0) 36%),
      var(--bg-raised);
  }

  .divine-roster-card--recommended {
    border-color: rgba(255, 208, 74, 0.42);
  }

  .divine-roster-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-self: flex-start;
  }

  .divine-roster-badge {
    padding: 0.2rem 0.55rem;
    border: 1px solid;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .divine-roster-badge--recommended {
    border-color: rgba(255, 208, 74, 0.42);
    color: var(--accent-gold);
    background: rgba(255, 208, 74, 0.1);
  }

  .divine-roster-badge--interesting {
    border-color: color-mix(in srgb, var(--accent-purple) 55%, transparent);
    color: var(--accent-purple-light, var(--accent-purple));
    background: color-mix(in srgb, var(--accent-purple) 14%, transparent);
  }

  .divine-roster-hero {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-bright);
    text-decoration: none;
  }

  .divine-roster-hero:hover span { color: var(--accent-gold); }

  .divine-roster-hero .divine-roster-throne {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    object-fit: cover;
    object-position: center top;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
    object-fit: contain;
    object-position: center;
    background:
      radial-gradient(circle, rgba(255, 208, 74, 0.12), transparent 70%),
      rgba(255, 255, 255, 0.025);
