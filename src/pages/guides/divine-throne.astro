---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";

const FEATURE_ASSET_BASE = "/features/divine-throne";
const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const HERO_IMAGE_VERSION = "2026-06-08-portrait";
const HERO_THUMB_BASE = `${R2_BASE}/heroes/thumbs`;

const featureAsset = (name: string) => `${FEATURE_ASSET_BASE}/${name}`;
const heroThumb = (id: string) => `${HERO_THUMB_BASE}/${encodeURIComponent(id)}-96.webp?v=${HERO_IMAGE_VERSION}`;
const heroImage = (id: string) => `${R2_BASE}/heroes/${encodeURIComponent(id)}.webp`;

const overview = [
  { label: "Unlock", value: "Clear Journey 25-3 and raise the hero to the required rank" },
  { label: "Where", value: "Deity screen, beside the Artifact slot" },
  { label: "Spend", value: "Ether items to upgrade individual heroes" },
  { label: "Payoff", value: "Stats, exclusive Divine Throne skills, and Divine Authority" },
];

const throneLoop = [
  {
    step: "01",
    name: "Unlock the hero",
    text: "Clear Journey 25-3, then raise an eligible hero to the required rank.",
  },
  {
    step: "02",
    name: "Spend Ether",
    text: "Use the required Ether item to attempt the next Divine Throne upgrade.",
  },
  {
    step: "03",
    name: "Roll the upgrade",
    text: "Success completes the next upgrade. Failure can drop the Divine Throne by one level unless protected.",
  },
  {
    step: "04",
    name: "Finish a stage",
    text: "Complete the current stage to move into the next set of requirements.",
  },
  {
    step: "05",
    name: "Unlock power",
    text: "Milestone nodes add core stats, exclusive skill effects, and more Divine Authority.",
  },
];

const resourceCards = [
  {
    name: "Immaculate Ether",
    asset: "immaculate-ether.png",
    role: "Base upgrade material",
    note: "Used for regular Divine Throne upgrade attempts.",
  },
  {
    name: "Pure Ether",
    asset: "pure-ether.png",
    role: "Higher-tier upgrade material",
    note: "Used once the hero advances into stronger upgrade requirements.",
  },
  {
    name: "Steadfast Ether",
    asset: "steadfast-ether.png",
    role: "Downgrade protection",
    note: "Protects against level loss on failure. It does not raise upgrade success chance.",
  },
];

const gainCards = [
  {
    label: "Stats",
    title: "Core combat stats",
    text: "Each upgrade is tied to one hero and adds direct attributes to that hero.",
  },
  {
    label: "Exclusive Skills",
    title: "Kit-level upgrades",
    text: "Specific Divine Throne levels unlock exclusive skill effects, often adding damage pressure, survivability, or stronger execution windows.",
  },
  {
    label: "Divine Authority",
    title: "New confrontation stat",
    text: "A new all-mode stat that rises with Divine Throne level and affects both damage and survivability.",
  },
];

const priorityRules = [
  "Start with heroes you field everywhere. Divine Authority applies in all modes, so your PvP carry, PvE carry, or main tank gets more value than a niche bench pick.",
  "Do not spread early resources too thin. Finishing meaningful milestones beats leaving many heroes barely upgraded.",
  "Use Steadfast Ether when a downgrade would hurt. Its job is protection only; save it for levels where losing progress matters.",
  "Check the hero's exclusive skill before committing. Some thrones are raw stats, but the biggest jumps come from milestone effects that change how a hero performs.",
];

const firstWaveHeroes = [
  { id: "fengyi", name: "Fengyi" },
  { id: "anubis", name: "Anubis" },
  { id: "freya", name: "Freya" },
  { id: "nemesis", name: "Nemesis" },
  { id: "demeter", name: "Demeter" },
  { id: "sekhmet", name: "Sekhmet" },
  { id: "ares", name: "Ares" },
  { id: "artemis", name: "Artemis" },
  { id: "diana", name: "Diana" },
  { id: "nuwa", name: "Nuwa" },
  { id: "phoenix", name: "Phoenix" },
  { id: "geb", name: "Geb" },
  { id: "bastet", name: "Bastet" },
  { id: "poseidon", name: "Poseidon" },
  { id: "medusa", name: "Medusa" },
  { id: "isis", name: "Isis" },
  { id: "yanluo", name: "Yanluo" },
  { id: "hecate", name: "Hecate" },
  { id: "momus", name: "Momus" },
  { id: "nyx", name: "Nyx" },
  { id: "zeus", name: "Zeus" },
  { id: "khepri", name: "Khepri" },
  { id: "caishen", name: "Caishen" },
  { id: "yuelao", name: "Yuelao" },
  { id: "jingwei", name: "Jingwei" },
  { id: "jormungandr", name: "Jormungandr" },
  { id: "prometheus", name: "Prometheus" },
  { id: "pan", name: "Pan" },
  { id: "hela", name: "Hela" },
  { id: "dionysus", name: "Dionysus" },
  { id: "set", name: "Set" },
  { id: "athena", name: "Athena" },
  { id: "horus", name: "Horus" },
  { id: "iris", name: "Iris" },
  { id: "amunra", name: "Amunra" },
  { id: "ullr", name: "Ullr" },
];
---

<Base
  title="Divine Throne Guide | Motto Immortal"
  description="One-page Divine Throne guide for Motto Immortal: unlock requirements, Ether resources, exclusive skills, Divine Authority, and first-wave heroes."
>
  <PageHero
    id="divine-throne"
    tag="Feature Guide"
    headline="Divine Throne"
    subtitle="Hero-specific upgrades, exclusive skills, and Divine Authority."
  />

  <div class="guide-body guide-body--divine-throne">
    <section class="guide-section">
      <h2 class="guide-section-title">Quick Read</h2>
      <div class="guide-card divine-overview-card">
        <div class="divine-feature-lede">
          <div>
            <h3 class="guide-card-heading">What Divine Throne actually is</h3>
            <p class="guide-card-subheading">
              A long-term upgrade system for individual heroes. You spend Ether, complete stages, and unlock direct combat stats plus hero-exclusive effects.
            </p>
          </div>
        </div>
        <div class="guide-overview-grid">
          {overview.map((item) => (
            <div class="guide-overview-item">
              <div class="guide-overview-label">{item.label}</div>
              <div class="guide-overview-value">{item.value}</div>
            </div>
          ))}
        </div>
        <p class="guide-quick-verdict">
          It is not a new battle mode. Treat it like the next permanent progression layer after rank and artifacts, with the main decision being which hero deserves scarce Ether first.
        </p>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">How It Works</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Unlock, upgrade, repeat</h3>
        <p class="guide-card-subheading">
          Divine Throne unlocks after Journey 25-3. Each hero still needs their own required rank, then upgrades are handled from the Deity screen beside the Artifact area.
        </p>
        <div class="divine-loop-grid">
          {throneLoop.map((item) => (
            <div class="divine-loop-step">
              <div class="divine-loop-step-index">{item.step}</div>
              <h4>{item.name}</h4>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Resources</h2>
      <div class="guide-card guide-board-card">
        <h3 class="guide-card-heading">Ether is the bottleneck</h3>
        <p class="guide-card-subheading">
          Three Ether items matter for the upgrade loop. The most important detail: protection Ether does not improve your odds; it only reduces the punishment for a failed roll.
        </p>
        <div class="divine-resource-grid">
          {resourceCards.map((item) => (
            <div class="divine-resource-card">
              <img src={featureAsset(item.asset)} alt="" loading="lazy" />
              <h4>{item.name}</h4>
              <strong>{item.role}</strong>
              <p>{item.note}</p>
            </div>
          ))}
        </div>
        <div class="guide-callout">
          Upgrade success completes the next step. Upgrade failure can lower the Divine Throne by one level. Steadfast Ether reduces downgrade risk, but it does not increase success rate.
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Power and Priority</h2>
      <div class="guide-card divine-gains-card">
        <h3 class="guide-card-heading">What you get for the Ether</h3>
        <p class="guide-card-subheading">
          Divine Throne is valuable because it combines permanent stats, hero-specific skill effects, and a new all-mode confrontation stat.
        </p>
        <div class="divine-gain-grid">
          {gainCards.map((item) => (
            <div class="divine-gain-card">
              <div class="guide-board-lane-label">{item.label}</div>
              <h4>{item.title}</h4>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
        <div class="divine-authority-panel">
          <h4>Divine Authority</h4>
          <p>
            This stat works across modes and affects both damage and survival. That makes high Divine Throne investment most useful on heroes you already use often.
          </p>
        </div>
        <div class="divine-priority-list">
          {priorityRules.map((rule, index) => (
            <div class="divine-priority-item">
              <span>{index + 1}</span>
              <p>{rule}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">First Wave</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Heroes in the first unlock wave</h3>
        <p class="guide-card-subheading">
          More heroes should unlock later. These are the heroes in the first-wave list.
        </p>
        <div class="divine-roster-grid">
          {firstWaveHeroes.map((hero) => (
            <a class="divine-roster-card" href={`/heroes/${hero.id}`}>
              <img
                src={heroThumb(hero.id)}
                alt={`${hero.name} portrait`}
                loading="lazy"
                onerror={`this.onerror=null;this.src='${heroImage(hero.id)}'`}
              />
              <span>{hero.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
</Base>
