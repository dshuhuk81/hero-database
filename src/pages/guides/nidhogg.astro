---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import nidhoggData from "../../data/heroes/nidhogg.json";

const R2_BASE = "https://pub-e35e94828bf347ca93c3d2c6a50d06f6.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const skillImage = (id: string) => `${R2_BASE}/skills/nidhogg_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "His whole plan. Human Nidhogg is the preparation phase; this skill turns him into a separate dragon unit that drains Energy and ends when Energy runs out or the dragon dies. Everything strong in his kit assumes the dragon is alive.",
  skill_2: "His own armor shred. In dragon form it also leaves a burn, which at Lv4 deals up to 640% ATK over 8 seconds on top of the 300% ATK hit.",
  skill_3: "An anti-dive trigger, only in dragon form. Anything that gets within 3m is hit, terrorized and handed 3 Dragon's Wrath stacks. The cooldown is long, so it answers one approach at a time.",
  skill_4: "Knockdown plus a second damage window. At Lv3 enemies hit in dragon form take 15% more damage for 6 seconds. Whether this stacks additively or multiplicatively with Dragon's Wrath is unconfirmed.",
};

const skills = nidhoggData.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  takeaway: takeaways[skill.id],
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
}));

const relic = {
  ...nidhoggData.relic,
  upgrades: Object.entries(nidhoggData.relic.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
};

const statMap = [
  { stat: "ATK", skills: ["skill_1", "skill_2", "skill_3", "skill_4"] },
  { stat: "ATK SPD", skills: ["skill_1"] },
  { stat: "Max HP", skills: ["skill_1"] },
  { stat: "Energy", skills: ["skill_1"] },
];
const skillName = (id: string) => skills.find((skill) => skill.id === id)?.name ?? id;

const strengths = nidhoggData.strengths;
const weaknesses = nidhoggData.weaknesses;
---

<Base title="Nidhogg Guide - Dark Dragon Form & Dragon's Wrath | Motto Immortal" description="Nidhogg guide covering Dark Dragon Form, Dragon's Wrath, Relic investment, dragon uptime, and what is still untested.">
  <div class="guide-banner guide-banner--starglint">
    <div class="guide-banner-bg" style={`background-image: url('${heroImage("nidhogg")}'); --guide-banner-y: 6%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg><span>Guides</span></a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Nidhogg</h1>
      <p class="guide-hero-subtitle">World-Dooming Black Dragon &middot; Transformation Carry</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/starglint.webp`} alt="Starglint" />Starglint</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/archer.webp`} alt="Archer" />Archer</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--starglint">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Nidhogg at a Glance</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
        <div class="heket-verdict-main">
          <div class="heket-verdict-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Dragon's True Form, Nidhogg's Ultimate"></div>
          <div><span class="heket-verdict-kicker">Playstyle verdict</span><h3>Reach the dragon, keep the dragon alive.</h3><p>Nidhogg is a Physical Archer whose human form is the preparation phase. Once Energy is full he becomes the Dark Dragon: a fast AoE carry with armor shred, burn, Dragon's Wrath damage amplification and a large share of True DMG. The kit is strong on paper. How much of it you see depends on how early he transforms and how long the dragon lives.</p></div>
        </div>
        <div class="heket-fact-strip"><div><span>Role</span><strong>Physical AoE carry (transformation)</strong></div><div><span>Core resource</span><strong>Dragon uptime</strong></div><div><span>Public rating</span><strong>Lower mid-tier</strong></div></div>
        <div class="heket-verdict-warning"><strong>Key warning</strong><span>Do not treat him as a permanent carry. Short fights can end without a transform, and a dragon that dies early leaves the human exposed.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Dragon Engine</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-engine">
        <div class="heket-engine-flow">
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_2")}');`} role="img" aria-label="Worldroot Blightfire"></div><span>Prepare</span><strong>Human form builds Energy</strong><p>Armor and M-RES shred from Worldroot Blightfire already works in human form.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Dragon's True Form"></div><span>Transform</span><strong>400-600% ATK AoE and 5s Silence</strong><p>All enemies are hit and silenced. His buffs and debuffs are cleared, +40% ATK and Max HP per buff cleared, up to 3.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_3")}');`} role="img" aria-label="Doomwyrm's Dread"></div><span>Stack</span><strong>Dragon's Wrath on every hit</strong><p>Basic attacks hit a frontal fan and add Wrath, up to 10 stacks. Terror adds 3 more at once.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label="Deathless Wrathscale"></div><span>Convert</span><strong>40% True DMG, 60% with Relic Lv4</strong><p>A large share of the dragon's damage ignores Armor.</p></div>
        </div>
        <div class="heket-engine-return"><span>Energy empties or the dragon dies: human form returns</span></div>
        <div class="heket-engine-rule"><strong>The dragon is a separate unit.</strong><span>The human disappears on transform and a dragon unit appears. When it dies, the human comes back. Whether ally shields and heals target the dragon is untested.</span></div>
        <div class="heket-engine-rule"><strong>Dragon's Wrath at a glance.</strong><span>3% extra damage taken from Nidhogg per stack, 5% at Skill 1 Lv4, up to 10 stacks: +50% at the cap.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">How Dragon Form Plays Out</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint"><span>Transform timing</span><strong>About 13-16 seconds in</strong><p>Fights under roughly 12 seconds sometimes ended without a transform at all.</p></div>
        <div class="guide-apple-breakpoint"><span>Dragon lifetime</span><strong>11 to 44 seconds, or the whole fight</strong><p>Tower 721: about 11-12s. World Boss: about 44s. Some Odyssey and Alliance Boss fights: until the end.</p></div>
        <div class="guide-apple-breakpoint"><span>After the dragon dies</span><strong>Human dies 1.1-5.6s later</strong><p>Every Tower 721 loss followed this pattern. The window right after dragon death is his weakest moment.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--max"><span>Team damage share</span><strong>87-97% in good fights</strong><p>Close to irrelevant in fights without a transform or with an early dragon death. Same hero, very different results.</p></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Skills: What They Mean</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}>
            <header class="guide-skill-panel-head"><div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div><img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{skill.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{skill.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{skill.takeaway}</p>
          </article>)}
          <article class="guide-skill-panel" data-guide-skill="relic">
            <header class="guide-skill-panel-head"><div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">Relic</span><span class="guide-skill-badge guide-skill-badge--level">Survival &amp; True DMG</span></div></div><img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{relic.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{relic.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>The Relic targets his main problem, keeping the dragon alive, and then adds control and True DMG on top. It is not required to play him, but it changes how the kit feels.</p>
          </article>
        </div>
        <ol class="guide-skill-selector">
          {skills.map((skill, index) => <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><small>{skill.badge}</small></span></button></li>)}
          <li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><small>Relic</small></span></button></li>
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Relic Investment</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint"><span>Base Relic</span><strong>Shield and damage reduction</strong><p>80% Max HP shield on every Ultimate, and 40% less damage taken while it lasts. Aimed straight at keeping the dragon up.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv2</span><strong>Control immunity</strong><p>Immune to Control while the Ultimate's shield is active. Most useful in PvP and hard Tower fights.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv3</span><strong>Stun, or True DMG</strong><p>Every 3 Dragon's Wrath stacks applied: 2s stun. Against Control-immune targets: 200% ATK True DMG instead, so it does not die on bosses.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--max"><span>Lv4 &middot; Damage upgrade</span><strong>60% True DMG</strong><p>Raises the True DMG share from 40% to 60%, which is +50% relative. Armor matters even less for his dragon output.</p></div>
      </div>
      <div class="guide-callout"><strong>Investment takeaway:</strong> Playable without a high Relic. The kit feels complete at Relic Lv3 and peaks at Lv4. Public guides rate his investment efficiency as weak, so with tight resources other heroes come first. Divine rank effects are not documented yet.</div>
    </section>

    <section class="guide-section guide-section--detail-heading"><h2 class="guide-section-title lt-h2 lt-h2-center">Strengths &amp; Weaknesses</h2><div class="lt-flourish lt-flourish-center"></div><StrengthWeakness strengths={strengths} weaknesses={weaknesses} /></section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Team Building</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-function-grid">
        <article class="guide-function"><span>Function 1</span><strong>Energy support</strong><p>The transform is his breakpoint, so external Energy matters. Whether a specific support moves it earlier by a useful margin has not been tested.</p><span class="guide-evidence-chip guide-evidence-chip--nodata">No hero confirmed</span></article>
        <article class="guide-function"><span>Function 2</span><strong>Dragon protection</strong><p>Dragon lifetime lines up with his strong phase. Whether ally shields and heals target the separate dragon unit is untested.</p><span class="guide-evidence-chip guide-evidence-chip--nodata">No hero confirmed</span></article>
        <article class="guide-function"><span>Function 3</span><strong>Time before the transform</strong><p>Anything that holds enemies off or soaks burst while he builds Energy. Short fights and heavy early burst are his worst cases.</p><span class="guide-evidence-chip guide-evidence-chip--inferred">From his mechanics</span></article>
      </div>
      <p class="guide-function-note"><strong>How to read this:</strong> no hero pairing is listed because none has been confirmed. The next planned test is Energy support combined with dragon survivability.</p>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">PvE or PvP?</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Mode verdict</span><h3>Situational in PvE, unproven in PvP.</h3></div>
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Longer PvE fights</span><strong>The dragon can carry</strong><p>Many enemies in front of him, bosses without heavy burst on the dragon, and fights where AoE basics and armor shred work.</p><span class="guide-evidence-chip guide-evidence-chip--inferred">Observed</span></div>
          <div class="heket-matchup-bad"><span>Short or burst-heavy fights</span><strong>He may never transform</strong><p>Fights under about 12 seconds, burst before the transform, and enemies that kill the dragon fast.</p><span class="guide-evidence-chip guide-evidence-chip--inferred">Observed</span></div>
        </div>
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Boss encounters</span><strong>Depends on the matchup</strong><p>World Boss: dragon lived about 44s. Tower 721: about 11-12s. Same kit, different outcomes.</p><span class="guide-evidence-chip guide-evidence-chip--inferred">Observed</span></div>
          <div class="heket-matchup-bad"><span>PvP</span><strong>Tools, but no proof</strong><p>5s mass Silence, shield, Control immunity, Knockdown, Terror, stuns and True DMG look strong. If he dies before full Energy, most of it never fires.</p><span class="guide-evidence-chip guide-evidence-chip--nodata">No match data</span></div>
        </div>
        <p class="heket-hades-note"><strong>Battle takeaway:</strong> Check four things in every fight: does he transform, when, how long does the dragon live, and what happens after it dies.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Build, Battle Plan &amp; Counterplay</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Winning pattern</span><h3>Live through the build-up, transform, and hold the dragon.</h3></div>
        <div class="guide-subhead"><span>Position</span><p>Mechanically derived, not a confirmed player consensus.</p></div>
        <div class="guide-lane">
          <div class="guide-lane-step"><div class="guide-lane-icon" style={`background-image: url('${skillImage("skill_2")}');`} role="img" aria-label="Worldroot Blightfire"></div><span>Protected mid or backline</span><strong>Shred while building Energy</strong></div>
          <div class="guide-lane-step"><div class="guide-lane-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Dragon's True Form"></div><span>Energy full</span><strong>Transform, Silence all enemies</strong></div>
          <div class="guide-lane-step"><div class="guide-lane-icon" style={`background-image: url('${skillImage("skill_3")}');`} role="img" aria-label="Doomwyrm's Dread"></div><span>Enemy within 3m</span><strong>AoE, Terror and Wrath stacks</strong></div>
        </div>
        <p class="guide-lane-caption">Do not frontline him on purpose. Doomwyrm's Dread punishes dives, but his main job is living long enough to transform.</p>
        <div class="guide-subhead"><span>Damage &amp; Energy</span><p>Which stats connect to his documented skills.</p></div>
        <div class="guide-statmap">
          {statMap.map((row) => <div class="guide-statmap-row"><strong class="guide-statmap-stat">{row.stat}</strong><div class="guide-statmap-skills">{row.skills.map((id) => <span class="guide-skillchip"><img src={skillImage(id)} alt="" width="24" height="24" loading="lazy" />{skillName(id)}</span>)}</div></div>)}
        </div>
        <p class="guide-lane-caption">Armor matters less for his dragon output because 40-60% of the damage is True DMG.</p>
        <div class="guide-subhead"><span>If it goes wrong</span><p>Find the symptom, then check the cause.</p></div>
        <div class="guide-diagnose">
          <div class="guide-diagnose-row"><strong>He never transforms</strong><span aria-hidden="true">&rarr;</span><p>Fight too short, or Energy built too slowly</p></div>
          <div class="guide-diagnose-row"><strong>The dragon dies within seconds</strong><span aria-hidden="true">&rarr;</span><p>Enemy burst on the dragon; check protection</p></div>
          <div class="guide-diagnose-row"><strong>Human dies right after the dragon</strong><span aria-hidden="true">&rarr;</span><p>The post-dragon window; nothing in the kit covers it</p></div>
          <div class="guide-diagnose-row"><strong>Low damage in the report</strong><span aria-hidden="true">&rarr;</span><p>Check transform time and dragon uptime before blaming stats</p></div>
        </div>
        <div class="guide-subhead"><span>Documented interference</span><p>From his skill text.</p></div>
        <div class="guide-chip-row">
          <span class="guide-skillchip">Energy empty ends dragon form</span>
          <span class="guide-skillchip">Dragon death returns the human</span>
          <span class="guide-skillchip">Transform clears his own buffs and debuffs</span>
          <span class="guide-skillchip">Human form has no Doomwyrm's Dread</span>
        </div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-verdict-box"><h3 class="guide-verdict-heading">A very high ceiling that depends on the dragon staying alive</h3><p class="guide-verdict-text">Nidhogg combines AoE, armor shred, burn, Dragon's Wrath amplification, control and a heavy True DMG share. The bottleneck is not his damage but reaching Dark Dragon Form on time and keeping it up. A widely read TapTap guide updated on 12 August 2026 rates him lower mid-tier with few use cases, and the transform timing explains why. We give no tier here because no reliable source exists. Open questions: PvP, Divine rank effects, ally shields and heals on the dragon, whether Energy support moves the transform, and how his damage amplifiers stack.</p></div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) button.addEventListener("click", () => {
        const id = button.getAttribute("data-guide-skill-button");
        for (const other of buttons) { const active = other === button; other.classList.toggle("is-active", active); other.setAttribute("aria-pressed", String(active)); }
        for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
      });
    }
  </script>
</Base>
