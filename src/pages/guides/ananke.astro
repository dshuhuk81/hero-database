---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import SupportStrip from "../../components/SupportStrip.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import VerdictCard from "../../components/guides/VerdictCard.astro";
import ModeRow from "../../components/guides/ModeRow.astro";
import MechanicFlow from "../../components/guides/MechanicFlow.astro";
import HeroChips from "../../components/guides/HeroChips.astro";
import FightRecord from "../../components/guides/FightRecord.astro";
import ananke from "../../data/heroes/ananke.json";
import "../../styles/guide-v2.css";

// Evidence: docs/ananke-guide-evidence-2026-11-13.md (one test account, heroes level 446, Auto).
// Publication gate: counts, timings and comparisons not already on this page need an owner decision.
const R2_BASE = "https://pub-e35e94828bf347ca93c3d2c6a50d06f6.r2.dev";
const skillImage = (id: string) => `${R2_BASE}/skills/ananke_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "The opening mark picks the enemy opposite her. The Ultimate prioritizes a marked enemy, cuts their Max HP and adds damage from HP already lost, so it pays off on a target that has been hit before. The mark's extra True DMG is separate from the physical hit.",
  skill_2: "Charged damage, not an opening execution. The dash fires at 50% target HP or after 12 seconds, whichever comes first. At Lv4, a full 12 seconds adds up to 1,920% ATK on top of 400% ATK (a calculation from the text, not a measured result).",
  skill_3: "She becomes untargetable after a damage-free window and attacking ends it. Lv4 grants the state whenever she takes part in a kill. It is not permanent immunity.",
  skill_4: "An area hit that gains extra damage against the marked enemy: 800% ATK nominal at Lv4. It rewards fighting around the mark.",
};

const skills = ananke.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  takeaway: takeaways[skill.id],
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
}));

const relic = {
  ...ananke.relic,
  upgrades: Object.entries(ananke.relic.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
};
const skillName = (id: string) => skills.find((skill) => skill.id === id)?.name ?? id;

const relicSteps = [
  { lvl: "Lv1", title: "+10% True DMG", text: "On a marked target that takes damage." },
  { lvl: "Lv2", title: "Mark transfer", text: "When the mark dies, the highest-ATK enemy is marked at once." },
  { lvl: "Lv3", title: "+20% True DMG", text: "The relic's True DMG line doubles." },
  { lvl: "Lv4", title: "Kill chain: instant dash", text: "A kill she takes part in triggers a Fateweaving dash at the next mark.", peak: true },
];

const DUEL_MAX = 25;
const duels = [
  { n: 1, death: 12.7, ult: false, win: false },
  { n: 2, death: 12.0, ult: false, win: false },
  { n: 3, death: 17.9, ult: true, win: false },
  { n: 4, death: 7.8, ult: false, win: false },
  { n: 5, death: 11.7, ult: false, win: false },
  { n: 6, death: 23.7, ult: true, win: true },
];

// Owner-approved counts (2026-11-23): Odyssey 15 sub-fights, 14 won; Tower 724 won once, 725 lost ten times.
// Order inside Odyssey is not recorded, so the single loss is shown last.
const fight = (result: "win" | "loss") => ({ result, transformed: true });
const fightRecord = [
  { label: "Odyssey", fights: [...Array.from({ length: 14 }, () => fight("win")), fight("loss")] },
  { label: "Tower", fights: [fight("win"), ...Array.from({ length: 10 }, () => fight("loss"))] },
  { label: "Friendly Duel", fights: duels.map((d) => fight(d.win ? "win" : "loss")) },
];

const lineups = [
  { mode: "Odyssey", result: "High damage share for Ananke", heroes: [{ id: "cronus", name: "Cronus" }, { id: "set", name: "Set" }, { id: "athena", name: "Athena" }, { id: "idunn", name: "Idunn" }] },
  { mode: "Odyssey", result: "Ananke dealt 50-61% of team damage", heroes: [{ id: "phoenix", name: "Phoenix" }, { id: "mazu", name: "Mazu" }, { id: "meret", name: "Meret" }, { id: "zaojun", name: "Zaojun" }] },
  { mode: "Alliance Boss", result: "Ananke died early, at 16.5 s", heroes: [{ id: "heket", name: "Heqet" }, { id: "caishen", name: "Caishen" }, { id: "dionysus", name: "Dionysus" }, { id: "zeus", name: "Zeus" }] },
  { mode: "Alliance Boss", result: "Ananke lasted 48 to 50 s", heroes: [{ id: "mazu", name: "Mazu" }, { id: "meret", name: "Meret or Idunn" }, { id: "hephaestus", name: "Hephaestus" }, { id: "zeus", name: "Zeus" }] },
];

const strengths = [
  "Focused damage on one marked enemy",
  "Extra True DMG from the mark and the relic",
  "Ultimate scales with the target's lost HP",
  "Conditional Untargetable state",
  "Relic Lv4 can chain kills with an automatic dash",
];

const weaknesses = [
  "The Ultimate often needs more than 10 seconds",
  "Early deaths prevent key skill activations",
  "Large level gaps cut True DMG as well",
  "Kill-based effects need kills to actually happen",
  "No shown advantage over leading boss damage dealers",
  "Heavily dependent on fight length and survival",
];
---

<Base title="Ananke Guide - Fateweaving, Marks & Relic | Motto Immortal" description="Ananke guide: is she worth building, where she works, marks, charged dashes, Absolute Necessity relic stages, team building and what is still open.">
  <div class="guide-banner guide-banner--diamonds">
    <div class="guide-banner-bg" style={`background-image: url('${ananke.image}'); --guide-banner-y: 12%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg><span>Guides</span></a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Ananke</h1>
      <p class="guide-hero-subtitle">Mark Assassin &middot; Charged Dash</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/diamonds.webp`} alt="" />Diamonds</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/assassin.webp`} alt="" />Assassin</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
        <a class="guide-badge gx-badge-link" href="/heroes/ananke">Hero Database &rarr;</a>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--diamonds">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading" data-nav-label="Verdict">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict &amp; Investment</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="gx-question">Should I build her?</p>
      <VerdictCard
        verdict="Low priority"
        summary="Not a must-have. She can be the main damage source in some Odyssey teams, but extreme level gaps, the Alliance Boss and PvP went poorly. She needs time and survival to deliver."
        stats={[
          { value: "1 of 6", name: "Friendly Duel wins" },
          { value: "14.7 s", name: "median time to her first Ultimate" },
          { value: "50-61%", name: "of team damage in one Odyssey team" },
          { value: "Low", name: "investment priority" },
        ]}
        confidence="62 fights watched on 13 Nov 2026 on our test account: heroes at level 446, Auto battle. Observations, not a tier rating."
      />

      <div class="gx-subhead">Who should invest</div>
      <div class="guide-diagnose guide-diagnose--flush">
        <div class="guide-diagnose-row"><strong>F2P</strong><span aria-hidden="true">&rarr;</span><p>No high priority</p></div>
        <div class="guide-diagnose-row"><strong>Low spender</strong><span aria-hidden="true">&rarr;</span><p>Compare with your current damage sources first</p></div>
        <div class="guide-diagnose-row"><strong>Mid spender</strong><span aria-hidden="true">&rarr;</span><p>Wait for a confirmed benefit</p></div>
        <div class="guide-diagnose-row"><strong>Endgame</strong><span aria-hidden="true">&rarr;</span><p>Test relic Lv4 and high skill levels</p></div>
      </div>
      <p class="gx-fact-note">Resource-minded suggestions, not proven breakpoints.</p>
    </section>

    <section class="guide-section guide-section--detail-heading" data-nav-label="Modes">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Where She Works</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="gx-question">Which modes did she work in?</p>
      <FightRecord groups={fightRecord} />
      <div class="gx-modes">
        <ModeRow mode="Odyssey" verdict="works" text="Main damage source in some teams: a high share with Cronus, 50-61% with Phoenix. On stage 5115, Zaojun still out-damaged her (47% against 30%)." sample="15 sub-fights, 14 won" />
        <ModeRow mode="Tower" verdict="weak" text="Won once on Tower 724, then lost all ten tries on Tower 725. About 269 levels behind, her True DMG did not beat the level suppression." sample="11 fights" />
        <ModeRow mode="Alliance Boss" verdict="weak" text="Her runs of 90, 75 and 90 s showed no standout damage. In one run, Zeus removed about 3.8x her average boss HP despite dying at 42 s." sample="3 runs" />
        <ModeRow mode="PvP" verdict="weak" text="Friendly Duel against the same team each time: Heracles, Bastet, Phoenix, Set, Nyx. She usually died before her Ultimate." sample="6 fights" />
      </div>

      {/* Hidden until publication is approved: level suppression panel.
      To publish: move this data back into the frontmatter and uncomment the panel.
const suppression = [
  { gap: "Gap 85", normal: 35, true: 62 },
  { gap: "Gap 94", normal: 26, true: 58 },
  { gap: "Gap 105", normal: 20, true: 46 },
  { gap: "Gap 269", normal: 20, true: 10 },
];
      <div class="ananke-panel">
        <div class="ananke-panel-head"><span>Level suppression</span><h3>True DMG is not a fix for big level gaps.</h3></div>
        <div class="ananke-bars">
          {suppression.map((row) => (
            <div class="ananke-bar-row">
              <strong>{row.gap}</strong>
              <div class="ananke-bar-pair">
                <div class="ananke-bar-line"><span class="ananke-bar-label">Normal</span><div class="ananke-bar"><i class="ananke-bar-fill" style={`width: ${row.normal}%;`}></i></div><em>{row.normal}%</em></div>
                <div class="ananke-bar-line"><span class="ananke-bar-label">True</span><div class="ananke-bar"><i class="ananke-bar-fill ananke-bar-fill--true" style={`width: ${row.true}%;`}></i></div><em>{row.true}%</em></div>
              </div>
            </div>
          ))}
        </div>
        <p class="ananke-panel-note">Damage multipliers observed on one account. This is a suppression effect, not an Ananke rule.</p>
      </div>
      */}

      <div class="ananke-panel">
        <div class="ananke-panel-head"><span>Friendly Duel</span><h3>She usually died before her Ultimate.</h3></div>
        <div class="ananke-bars">
          {duels.map((duel) => (
            <div class="ananke-bar-row">
              <strong>Fight {duel.n}</strong>
              <div class="ananke-bar-pair">
                <div class="ananke-bar-line"><span class="ananke-bar-label">Death</span><div class="ananke-bar"><i class={`ananke-bar-fill${duel.win ? " ananke-bar-fill--true" : ""}`} style={`width: ${(duel.death / DUEL_MAX) * 100}%;`}></i></div><em>{duel.death.toFixed(1)} s</em></div>
              </div>
              <small>{duel.win ? "Win, with Zeus" : "Loss"} &middot; {duel.ult ? "Ultimate cast" : "No Ultimate"}</small>
            </div>
          ))}
          <div class="ananke-bar-row ananke-bar-row--axis" aria-hidden="true">
            <span></span>
            <div class="ananke-bar-line"><span></span><p class="ananke-bars-axis"><span>0 s</span><span>time of death</span><span>{DUEL_MAX} s</span></p><span></span></div>
          </div>
        </div>
        <p class="ananke-panel-note">Level 446 against level 402, about 14 million against 17 million team power (Might). Phoenix, Bastet and Nyx dealt repeated fatal hits. They are observed threats, not proven counters.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading" data-nav-label="Build">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Build &amp; Investment</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="gx-question">What do I invest, and who goes with her?</p>

      <div class="gx-subhead">Relic breakpoints</div>
      <div class="gx-step-head"><span class="gx-label">{relic.name}</span></div>
      <ol class="gx-steps">
        {relicSteps.map((s) => (
          <li class={`gx-step${s.peak ? " gx-step--peak" : ""}`}>
            <span class="gx-step-lvl">{s.lvl}</span>
            <div class="gx-step-body"><strong>{s.title}</strong><span>{s.text}</span></div>
          </li>
        ))}
      </ol>
      <p class="gx-fact-note">Lv2 and Lv4 change how she plays; Lv1 and Lv3 add True DMG. No relic level has been compared in fights yet. Lv1-Lv4 are effect stages: which relic upgrade (+10, +20 or +30) unlocks each is not known.</p>

      <div class="gx-subhead">Stats</div>
      <div class="gx-rows">
        <div class="gx-row"><span class="gx-row-ico">ATK</span><div><strong>Stack ATK</strong><span class="gx-row-text">Scales {skillName("skill_1")}, {skillName("skill_2")} and {skillName("skill_4")}.</span></div></div>
        <div class="gx-row"><span class="gx-row-ico">DMG</span><div><strong>Physical DMG Bonus</strong><span class="gx-row-text">Raises {skillName("skill_2")} and {skillName("skill_4")}.</span></div></div>
        <div class="gx-row"><span class="gx-row-ico">EN</span><div><strong>Energy</strong><span class="gx-row-text">Brings {skillName("skill_1")} (Ultimate) sooner. It does not speed up {skillName("skill_2")}'s charge.</span></div></div>
        <div class="gx-row"><span class="gx-row-ico">HP</span><div><strong>HP and defense</strong><span class="gx-row-text">Tied to {skillName("skill_3")}.</span></div></div>
      </div>
      <p class="gx-fact-note">CRIT may help her physical hits, but its effect on True DMG is unclear. No confirmed virtue set, substat order or ATK-versus-CRIT split exists.</p>

      <div class="gx-subhead">Team: give her time to charge</div>
      <div class="gx-rows">
        <div class="gx-row"><span class="gx-row-ico">DEF</span><div><strong>Protection</strong><span class="gx-row-text">She took a larger damage share in protected teams. Set shields her if she is the ally he selects; Athena's aura cuts damage taken while she stays in range.</span></div></div>
        <div class="gx-row"><span class="gx-row-ico">EN</span><div><strong>Energy</strong><span class="gx-row-text">Caishen, Dionysus and Hephaestus restore Energy. Hephaestus' team survived longer on the boss.</span></div></div>
        <div class="gx-row"><span class="gx-row-ico">DMG</span><div><strong>Damage on the mark</strong><span class="gx-row-text">An ally only helps if their targeting reaches the marked enemy. Zeus, Phoenix and Zaojun showed no proven synergy.</span></div></div>
      </div>
      <p class="gx-fact-note">A team used together is not a confirmed synergy. No Energy loop, guaranteed chain, control combination or best five-hero lineup has been shown.</p>

      <div class="gx-acc">
        <details>
          <summary><span class="gx-sum"><strong>Teams we recorded</strong><small>Four lineups with Ananke as the fifth hero</small></span></summary>
          <div class="gx-acc-body">
            {lineups.map((lineup) => (
              <div class="ananke-lineup">
                <p><strong>{lineup.mode}</strong> &middot; {lineup.result}</p>
                <HeroChips heroes={lineup.heroes} />
              </div>
            ))}
            <p>Idunn heals the weakest ally; no systematic gain with Ananke was shown.</p>
          </div>
        </details>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading" data-nav-label="Mechanic">
      <h2 class="guide-section-title lt-h2 lt-h2-center">How She Works</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="gx-question">What is the one thing to understand?</p>
      <MechanicFlow
        steps={[
          { title: "Mark", icon: skillImage("skill_1"), text: "The enemy opposite her is marked at battle start. It adds 5% True DMG when it takes damage." },
          { title: "Charge", icon: skillImage("skill_2"), text: "Fateweaving adds damage each second. The dash fires at 50% target HP or after 12 seconds." },
          { title: "Finish", icon: skillImage("skill_4"), text: "Threads of Fate and the Ultimate go hardest into the marked enemy." },
          { title: "Chain", icon: skillImage("relic"), text: "Relic Lv2 re-marks the highest-ATK enemy. Lv4 adds an instant dash." },
        ]}
        exit="A kill she takes part in makes her Untargetable (Unseen Destiny Lv4) and triggers the next dash (relic Lv4). How often full chains happen in real fights, and whether each chained dash must recharge, is untested."
      />

      <div class="gx-subhead">Skills</div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}>
            <header class="guide-skill-panel-head"><div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div><img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-takeaway guide-skill-panel-takeaway--lead"><strong>In practice</strong>{skill.takeaway}</p>
            <details class="guide-skill-fulltext">
              <summary>Full skill text and upgrades</summary>
              <p class="guide-skill-panel-text">{skill.description}</p>
              <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{skill.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div>
            </details>
          </article>)}
          <article class="guide-skill-panel" data-guide-skill="relic">
            <header class="guide-skill-panel-head"><div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">Relic</span><span class="guide-skill-badge guide-skill-badge--level">Mark transfer &amp; kill chain</span></div></div><img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-takeaway guide-skill-panel-takeaway--lead"><strong>In practice</strong>Lv2 and Lv4 change how the kit plays. Lv1 and Lv3 raise the mark's True DMG. Whether the relic percentages add to the base 5% is untested.</p>
            <details class="guide-skill-fulltext">
              <summary>Full relic text and upgrades</summary>
              <p class="guide-skill-panel-text">{relic.description}</p>
              <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{relic.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div>
            </details>
          </article>
        </div>
        <ol class="guide-skill-selector">
          {skills.map((skill, index) => <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><span class="sr-only">, </span><small>{skill.badge}</small></span></button></li>)}
          <li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><span class="sr-only">, </span><small>Relic</small></span></button></li>
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading" data-nav-label="Details">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Testing &amp; Details</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="gx-question">What is still open?</p>

      <div class="gx-acc">
        <details>
          <summary>Strengths and weaknesses</summary>
          <div class="gx-acc-body"><StrengthWeakness strengths={strengths} weaknesses={weaknesses} /></div>
        </details>
        <details>
          <summary>Mode talents</summary>
          <div class="gx-acc-body gx-diag">
            <div class="gx-diag-row"><strong>Grim Surge, Torment Rift, Nightmare Chart, Old God modes</strong><span>+10% DMG, +100 Energy, +30% ATK, +30% CRIT Rate, +20% CRIT DMG</span></div>
            <div class="gx-diag-row"><strong>Arena modes, Rival Tides, Friendly Duel</strong><span>+20% CRIT Rate, +20% ATK, +30% Hit, +30% Dodge, +200 Energy</span></div>
            <p>The effect of each bonus was not observed in isolation.</p>
          </div>
        </details>
        <details>
          <summary>Next tests: what would change this verdict</summary>
          <div class="gx-acc-body">
            <div class="gx-chips">
              <span class="gx-chip">Same stage at different relic levels</span>
              <span class="gx-chip">How often relic Lv4 chains</span>
              <span class="gx-chip">Mark changes after kills</span>
              <span class="gx-chip">Boss: Ananke against another DPS</span>
              <span class="gx-chip">PvP against several strong lineups</span>
            </div>
          </div>
        </details>
      </div>

      <h3 class="gx-bottom-title">Bottom line</h3>
      <div class="gx-rows gx-bottom">
        <div class="gx-row"><span class="gx-row-ico">Build</span><div><strong>If you run Odyssey with a protected team</strong><span class="gx-row-text">She was the main damage source in some Odyssey teams.</span></div></div>
        <div class="gx-row"><span class="gx-row-ico">Skip</span><div><strong>If you need PvP, Alliance Boss damage or Tower at large level gaps, or resources are tight</strong><span class="gx-row-text">1 of 6 duels won, no standout boss damage, repeated Tower 725 failures.</span></div></div>
        <div class="gx-row"><span class="gx-row-ico">Needs</span><div><strong>Time and survival</strong><span class="gx-row-text">Her first Ultimate came at a median of 14.7 s; early deaths stop her kit.</span></div></div>
      </div>
      <p class="gx-fact-note">One test account: heroes at level 446, Auto. Results change with level gap, investment and team.</p>

      <div class="gx-links">
        <a class="gx-link" href="/heroes/ananke">Skill texts, stats and relic &rarr; Hero Database</a>
        <a class="gx-link" href="/guides">All guides &rarr;</a>
      </div>
    </section>
  </div>
  <SupportStrip />
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) button.addEventListener("click", () => {
        const id = button.getAttribute("data-guide-skill-button");
        for (const other of buttons) { const active = other === button; other.classList.toggle("is-active", active); other.setAttribute("aria-pressed", String(active)); }
        for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
      });
    }
  </script>
