---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import ananke from "../../data/heroes/ananke.json";

const R2_BASE = "https://pub-e35e94828bf347ca93c3d2c6a50d06f6.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const skillImage = (id: string) => `${R2_BASE}/skills/ananke_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "The opening mark picks the enemy opposite her. The Ultimate prioritizes a marked enemy, cuts their Max HP and adds damage from HP already lost, so it pays off on a target that has been hit before. The mark's extra True DMG is separate from the physical hit.",
  skill_2: "Charged damage, not an opening execution. The dash fires at 50% target HP or after 12 seconds, whichever comes first. At Lv4, a full 12 seconds adds up to 1,920% ATK on top of 400% ATK (a calculation from the text, not a measured result).",
  skill_3: "She becomes untargetable after a damage-free window and attacking ends it. Lv4 grants the state on any kill participation. It is not permanent immunity.",
  skill_4: "An area hit that gains extra damage against the marked enemy: 800% ATK nominal at Lv4. It rewards fighting around the mark.",
};

const skills = ananke.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  takeaway: takeaways[skill.id],
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
}));

const relic = {
  ...ananke.relic,
  upgrades: Object.entries(ananke.relic.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
};

const statMap = [
  { stat: "ATK", skills: ["skill_1", "skill_2", "skill_4"] },
  { stat: "Physical DMG Bonus", skills: ["skill_2", "skill_4"] },
  { stat: "Energy", skills: ["skill_1"] },
  { stat: "HP / defense", skills: ["skill_3"] },
];
const skillName = (id: string) => skills.find((skill) => skill.id === id)?.name ?? id;

const suppression = [
  { gap: "Gap 85", normal: 35, true: 62 },
  { gap: "Gap 94", normal: 26, true: 58 },
  { gap: "Gap 105", normal: 20, true: 46 },
  { gap: "Gap 269", normal: 20, true: 10 },
];

const duels = [
  { n: 1, death: 12.7, ult: false, win: false },
  { n: 2, death: 12.0, ult: false, win: false },
  { n: 3, death: 17.9, ult: true, win: false },
  { n: 4, death: 7.8, ult: false, win: false },
  { n: 5, death: 11.7, ult: false, win: false },
  { n: 6, death: 23.7, ult: true, win: true },
];

const strengths = [
  "Focused damage on one marked enemy",
  "Extra True DMG from the mark and the relic",
  "Ultimate scales with the target's lost HP",
  "Conditional Untargetable state",
  "Relic Lv4 can chain kills with an automatic dash",
];

const weaknesses = [
  "The Ultimate often needs more than 10 seconds",
  "Early deaths prevent key skill activations",
  "Large level gaps cut True DMG as well",
  "Kill-based effects need kills to actually happen",
  "No shown advantage over leading boss damage dealers",
  "Heavily dependent on fight length and survival",
];
---

<Base title="Ananke Guide - Fateweaving, Marks & Relic | Motto Immortal" description="Ananke guide: marks, charged dashes, untargetability, Absolute Necessity relic stages, test results in Odyssey, Tower, boss and PvP, and investment advice.">
  <div class="guide-banner guide-banner--diamonds">
    <div class="guide-banner-bg" style={`background-image: url('${ananke.image}'); --guide-banner-y: 12%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg><span>Guides</span></a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Ananke</h1>
      <p class="guide-hero-subtitle">Mark Assassin &middot; Charged Dash</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/diamonds.webp`} alt="Diamonds" />Diamonds</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/assassin.webp`} alt="Assassin" />Assassin</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--diamonds">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Ananke at a Glance</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
        <div class="heket-verdict-main">
          <div class="heket-verdict-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Destined Demise, Ananke's Ultimate"></div>
          <div><span class="heket-verdict-kicker">Playstyle verdict</span><h3>Strong on paper, slow in practice.</h3><p>Ananke marks the enemy opposite her, charges a dash and finishes that target. She needs time and survival to deliver, and the fights we watched show she often gets neither.</p></div>
        </div>
        <div class="heket-fact-strip"><div><span>Role</span><strong>Single-target specialist</strong></div><div><span>Core mechanic</span><strong>Mark and kill chain</strong></div><div><span>Best fit</span><strong>Protected teams with moderate level gaps</strong></div></div>
        <div class="heket-verdict-warning"><strong>Key warning</strong><span>Five of six PvP fights were lost, usually after an early death before the Ultimate.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Mark Cycle</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-engine">
        <div class="heket-engine-flow">
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Destined Demise"></div><span>Mark</span><strong>Opposite enemy</strong><p>Marked at battle start. Adds 5% True DMG when it takes damage.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_2")}');`} role="img" aria-label="Fateweaving"></div><span>Charge</span><strong>Build the dash</strong><p>Fateweaving adds damage each second. It fires at 50% target HP or 12 seconds.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_4")}');`} role="img" aria-label="Threads of Fate"></div><span>Finish</span><strong>Kill the mark</strong><p>Threads of Fate and the Ultimate go hardest into the marked enemy.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label="Absolute Necessity"></div><span>Chain</span><strong>Next target</strong><p>Relic Lv2 re-marks the highest-ATK enemy. Lv4 adds an instant dash.</p></div>
        </div>
        <div class="heket-engine-return"><span>Kill participation: Untargetable at skill Lv4 &middot; Dash at relic Lv4</span></div>
        <div class="heket-engine-rule"><strong>The chain is not proven.</strong><span>How often full chains happen in real fights, and whether each chained dash must recharge, is untested.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Skills: What They Mean</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}>
            <header class="guide-skill-panel-head"><div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div><img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{skill.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{skill.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{skill.takeaway}</p>
          </article>)}
          <article class="guide-skill-panel" data-guide-skill="relic">
            <header class="guide-skill-panel-head"><div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">Relic</span><span class="guide-skill-badge guide-skill-badge--level">Mark transfer &amp; kill chain</span></div></div><img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{relic.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{relic.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>Lv2 and Lv4 change how the kit plays. Lv1 and Lv3 raise the mark's True DMG. Whether the relic percentages add to the base 5% is untested.</p>
          </article>
        </div>
        <ol class="guide-skill-selector">
          {skills.map((skill, index) => <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><small>{skill.badge}</small></span></button></li>)}
          <li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><small>Relic</small></span></button></li>
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Relic Investment</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint"><span>Lv1</span><strong>+10% True DMG</strong><p>On a marked target that takes damage.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv2</span><strong>Mark transfer</strong><p>When the mark dies, the highest-ATK enemy is marked at once.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv3</span><strong>+20% True DMG</strong><p>The relic's True DMG line doubles.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--max"><span>Lv4 &middot; Kill chain</span><strong>Instant dash</strong><p>Kill participation triggers a Fateweaving dash at the next mark.</p></div>
      </div>
      <div class="guide-callout"><strong>Investment takeaway:</strong> Lv2 and Lv4 are the real playstyle changes. No relic level has been compared yet, so whether Lv4 is a practical jump is open. Lv1-Lv4 name effect stages; their match to +10, +20 or +30 is not established.</div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">What We Observed</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="ananke-stats">
        <div><strong>62</strong><span>observed fights</span></div>
        <div><strong>Lv 446</strong><span>hero level, auto control</span></div>
        <div><strong>14.7 s</strong><span>median first Ultimate</span></div>
        <div><strong>1 / 6</strong><span>PvP wins</span></div>
      </div>
      <p class="guide-function-note"><strong>How to read this:</strong> 62 fights we watched on 13 November 2026 with one account, across Tower, Odyssey, Friendly Duel and the Alliance Boss. Damage shares and timings are more reliable than absolute totals. This is a set of observations, not a tier rating.</p>

      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>By mode</span><h3>Fine in selected teams, weak against pressure.</h3></div>
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Odyssey</span><strong>Main damage source in some teams</strong><p>Kronos team: high share. Phoenix team: 50-61%. On stage 5115, Zaojun still out-damaged her.</p><span class="guide-evidence-chip guide-evidence-chip--observed">Observed</span></div>
          <div class="heket-matchup-bad"><span>Tower, extreme gap</span><strong>Failed repeatedly</strong><p>At a gap of about 269 (Tower 725), True DMG did not beat the suppression.</p><span class="guide-evidence-chip guide-evidence-chip--observed">Observed</span></div>
        </div>
        <div class="heket-matchup-row">
          <div class="heket-matchup-bad"><span>Alliance Boss</span><strong>Below the alternatives we tried</strong><p>Her 90 / 75 / 90 second runs showed no standout damage. Zeus dealt far more despite dying at 42 seconds.</p><span class="guide-evidence-chip guide-evidence-chip--observed">Observed</span></div>
          <div class="heket-matchup-bad"><span>PvP</span><strong>5 losses in 6 fights</strong><p>Same enemy team each time: Heracles, Bastet, Phoenix, Set, Nyx.</p><span class="guide-evidence-chip guide-evidence-chip--observed">Observed</span></div>
        </div>
      </div>

      <div class="ananke-panel">
        <div class="ananke-panel-head"><span>Level suppression</span><h3>True DMG is not a fix for big level gaps.</h3></div>
        <div class="ananke-bars">
          {suppression.map((row) => (
            <div class="ananke-bar-row">
              <strong>{row.gap}</strong>
              <div class="ananke-bar-pair">
                <div class="ananke-bar-line"><span class="ananke-bar-label">Normal</span><div class="ananke-bar"><i class="ananke-bar-fill" style={`width: ${row.normal}%;`}></i></div><em>{row.normal}%</em></div>
                <div class="ananke-bar-line"><span class="ananke-bar-label">True</span><div class="ananke-bar"><i class="ananke-bar-fill ananke-bar-fill--true" style={`width: ${row.true}%;`}></i></div><em>{row.true}%</em></div>
              </div>
            </div>
          ))}
        </div>
        <p class="ananke-panel-note">Damage multipliers observed on one account. This is a suppression effect, not an Ananke rule.</p>
      </div>

      <div class="ananke-panel">
        <div class="ananke-panel-head"><span>Friendly Duel</span><h3>She usually died before her Ultimate.</h3></div>
        <div class="ananke-bars">
          {duels.map((duel) => (
            <div class="ananke-bar-row">
              <strong>Fight {duel.n}</strong>
              <div class="ananke-bar-pair">
                <div class="ananke-bar-line"><span class="ananke-bar-label">Death</span><div class="ananke-bar"><i class={`ananke-bar-fill${duel.win ? " ananke-bar-fill--true" : ""}`} style={`width: ${(duel.death / 25) * 100}%;`}></i></div><em>{duel.death} s</em></div>
              </div>
              <small>{duel.win ? "Win, with Zeus" : "Loss"} &middot; {duel.ult ? "Ultimate cast" : "No Ultimate"}</small>
            </div>
          ))}
        </div>
        <p class="ananke-panel-note">Level 446 against level 402, about 14 million against 17 million Might. Phoenix, Bastet and Nyx dealt repeated fatal hits. They are observed threats, not proven counters.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading"><h2 class="guide-section-title lt-h2 lt-h2-center">Strengths &amp; Weaknesses</h2><div class="lt-flourish lt-flourish-center"></div><StrengthWeakness strengths={strengths} weaknesses={weaknesses} /></section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Team Building</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-function-grid">
        <article class="guide-function"><span>Function 1</span><strong>Protection</strong><p>Time to charge and a damage-free window. Observed: she takes a larger damage share in protected teams.</p>
          <div class="guide-function-heroes">
            <div class="guide-function-hero"><img src={heroImage("set")} alt="" loading="lazy" /><div><strong>Set</strong><span>Shields himself and the most vulnerable ally. Ananke must be the one selected.</span></div></div>
            <div class="guide-function-hero"><img src={heroImage("athena")} alt="" loading="lazy" /><div><strong>Athena</strong><span>Aura cuts damage taken. Ananke has to stay in range.</span></div></div>
            <div class="guide-function-hero"><img src={heroImage("idunn")} alt="" loading="lazy" /><div><strong>Idunn</strong><span>Heals the weakest ally. No systematic gain shown with Ananke.</span></div></div>
          </div>
        </article>
        <article class="guide-function"><span>Function 2</span><strong>Energy</strong><p>Energy helps reach the Ultimate. It does not speed up Fateweaving's charge.</p>
          <div class="guide-function-heroes">
            <div class="guide-function-hero"><img src={heroImage("caishen")} alt="" loading="lazy" /><div><strong>Caishen</strong><span>Energy to allies in a large area. Position decides who gets it.</span></div></div>
            <div class="guide-function-hero"><img src={heroImage("dionysus")} alt="" loading="lazy" /><div><strong>Dionysus</strong><span>Team ATK, ATK SPD, Energy regeneration and shorter cooldowns.</span></div></div>
            <div class="guide-function-hero"><img src={heroImage("hephaestus")} alt="" loading="lazy" /><div><strong>Hephaestus</strong><span>Devices heal and restore Energy. Longer survival seen in the boss team that used it.</span></div></div>
          </div>
        </article>
        <article class="guide-function"><span>Function 3</span><strong>Extra damage on the mark</strong><p>Her ally's targeting must reach the marked enemy. The pairings we tried showed no proven synergy.</p>
          <div class="guide-function-heroes">
            <div class="guide-function-hero"><img src={heroImage("zeus")} alt="" loading="lazy" /><div><strong>Zeus</strong><span>Fought together. Zeus produced most damage and Ananke added none that could be shown.</span></div></div>
            <div class="guide-function-hero"><img src={heroImage("phoenix")} alt="" loading="lazy" /><div><strong>Phoenix</strong><span>Targets the farthest unit, which need not be the mark. Observed team: Ananke at 50-61%.</span></div></div>
            <div class="guide-function-hero"><img src={heroImage("zaojun")} alt="" loading="lazy" /><div><strong>Zaojun</strong><span>Out-damaged her on stage 5115 (47% against 30%). No skill interaction proven.</span></div></div>
          </div>
        </article>
      </div>
      <p class="guide-function-note"><strong>How to read this:</strong> a team used together is not a confirmed synergy. Observed lineups: Kronos, Set, Athena, Idunn; Phoenix, Mazu, Meret, Zaojun; Heqet, Caishen, Dionysus, Zeus (Ananke died early at 16.5 seconds); Mazu, Meret or Idunn, Hephaestus, Zeus (Ananke lasted 48 to 50 seconds). No Energy loop, guaranteed chain, control combination or best five-hero lineup has been shown.</p>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Build &amp; Investment</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Stats</span><h3>ATK is the clear core. The rest is open.</h3></div>
        <div class="guide-statmap">
          {statMap.map((row) => <div class="guide-statmap-row"><strong class="guide-statmap-stat">{row.stat}</strong><div class="guide-statmap-skills">{row.skills.map((id) => <span class="guide-skillchip"><img src={skillImage(id)} alt="" width="24" height="24" loading="lazy" />{skillName(id)}</span>)}</div></div>)}
        </div>
        <p class="guide-lane-caption">CRIT may help her physical hits, but its effect on True DMG is unclear. No confirmed virtue set, substat order or ATK-versus-CRIT split exists.</p>

        <div class="guide-subhead"><span>Who should invest</span><p>Resource-minded suggestions, not proven breakpoints.</p></div>
        <div class="guide-diagnose">
          <div class="guide-diagnose-row"><strong>F2P</strong><span aria-hidden="true">&rarr;</span><p>No high priority</p></div>
          <div class="guide-diagnose-row"><strong>Low spender</strong><span aria-hidden="true">&rarr;</span><p>Compare with your current damage sources first</p></div>
          <div class="guide-diagnose-row"><strong>Mid spender</strong><span aria-hidden="true">&rarr;</span><p>Wait for a confirmed benefit</p></div>
          <div class="guide-diagnose-row"><strong>Endgame</strong><span aria-hidden="true">&rarr;</span><p>Test relic Lv4 and high skill levels</p></div>
        </div>

        <div class="guide-subhead"><span>Mode talents</span><p>The effect of each bonus was not observed in isolation.</p></div>
        <div class="guide-diagnose">
          <div class="guide-diagnose-row"><strong>Grim Surge, Torment Rift, Nightmare Chart, Old God modes</strong><span aria-hidden="true">&rarr;</span><p>+10% DMG, +100 Energy, +30% ATK, +30% CRIT Rate, +20% CRIT DMG</p></div>
          <div class="guide-diagnose-row"><strong>Arena modes, Rival Tides, Friendly Duel</strong><span aria-hidden="true">&rarr;</span><p>+20% CRIT Rate, +20% ATK, +30% Hit, +30% Dodge, +200 Energy</p></div>
        </div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-verdict-box"><h3 class="guide-verdict-heading">Not a must-have. Investment priority stays low.</h3><p class="guide-verdict-text">Ananke works as the main damage source in some Odyssey teams, but extreme level gaps, the Alliance Boss and PvP all went poorly. The biggest open question is whether she lands enough kills in real endgame fights to trigger her kill-based mechanics repeatedly.</p></div>
      <div class="guide-subhead"><span>Next tests</span><p>What would change this verdict.</p></div>
      <div class="guide-chip-row">
        <span class="guide-skillchip">Same stage at different relic levels</span>
        <span class="guide-skillchip">How often relic Lv4 chains</span>
        <span class="guide-skillchip">Mark changes after kills</span>
        <span class="guide-skillchip">Boss: Ananke against another DPS</span>
        <span class="guide-skillchip">PvP against several strong lineups</span>
      </div>
      <p class="guide-function-note"><strong>Community:</strong> sources are thin. A <a href="https://www.taptap.cn/moment/844910069928691418?group_id=784460" target="_blank" rel="noopener noreferrer">guide from 12 August 2026</a> appears to suggest using her briefly and then skipping her, and a <a href="https://www.taptap.cn/moment/829599527341132963?group_id=784460" target="_blank" rel="noopener noreferrer">23 July post</a> describes a failed faction-tower attempt. Both are single opinions without level details. Updated 17 November 2026.</p>
      <div class="guide-chip-row"><a class="guide-skillchip" href="/heroes/ananke">Ananke in the Hero Database &rarr;</a><a class="guide-skillchip" href="/guides">All guides &rarr;</a></div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) button.addEventListener("click", () => {
        const id = button.getAttribute("data-guide-skill-button");
        for (const other of buttons) { const active = other === button; other.classList.toggle("is-active", active); other.setAttribute("aria-pressed", String(active)); }
        for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
      });
    }
  </script>
</Base>

