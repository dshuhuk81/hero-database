---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import heketData from "../../data/heroes/heket.json";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const skillImage = (id: string) => `${R2_BASE}/skills/heket_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "The Ultimate adds another frog to the engine. If the field is already full, the weakest frog is replaced, turning the cast into a refresh for a damaged frontline body.",
  skill_2: "This is the center of the kit. It creates frogs, shields every friendly summon—including Heket—and makes nearby enemies less accurate. Because croaks synchronize, several frogs can apply the Hit Rate debuff quickly.",
  skill_3: "Heket begins producing value immediately instead of waiting for her Ultimate. At Lv4 she starts with two durable frogs, raises the cap by two, and reduces Toad Pact's cooldown to 8 seconds.",
  skill_4: "Every living frog strengthens the summon-wide ATK bonus and periodic healing. Heket qualifies for these effects herself, so keeping frogs alive sustains both her and the rest of the summon board.",
};

const skills = heketData.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  takeaway: takeaways[skill.id],
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({
    level: level.replace("level", "Lv "),
    text,
  })),
}));

const relic = {
  ...heketData.relic,
  badge: "Relic",
  levelBadge: "Strong at base",
  takeaway: "The survival mechanic is available immediately: if a frog exists, Heket can erase one lethal damage instance and replace that frog with a large personal Shield. Later levels only increase the Shield amount.",
  upgrades: Object.entries(heketData.relic.upgrades).map(([level, text]) => ({
    level: level.replace("level", "Lv "),
    text,
  })),
};

const strengths = [
  "Each frog grants all friendly summons up to 40% ATK at Skill Lv3",
  "Ten Thousand Toads shields every allied summon for up to 400% of Heket's ATK",
  "Synchronized croaks can rapidly stack a 25% Hit Rate reduction up to five times",
  "Starts the battle with frogs and can raise the maximum number allowed on the field",
  "Provides recurring healing to herself and friendly summons while frogs remain alive",
  "Toad Pact sacrifices a frog to ignore lethal damage and grants a massive Shield",
  "Frog replacements and sacrifices can fuel allies that benefit when units fall",
];

const weaknesses = [
  "Most of her major benefits apply only to summons, not directly to allied heroes",
  "Offers limited personal damage because frogs do not perform basic attacks",
  "Losing frogs reduces the summon ATK bonus, synchronized croaks, and sacrifice options",
  "Her team value is much lower outside a summon-focused composition",
  "Toad Pact needs a frog on the field and has a cooldown, so it is not unconditional immortality",
  "Area damage and summon removal can collapse several parts of her kit at once",
];
---

<Base title="Heket Guide - Frog & Summon Support | Motto Immortal" description="Heket guide covering frogs, summon ATK buffs and Shields, synchronized croaks, Toad Pact, team fit, strengths, weaknesses, and confirmed mechanics.">
  <div class="guide-banner guide-banner--heket">
    <div class="guide-banner-bg" style={`background-image: url('${heroImage("heket")}'); --guide-banner-y: 12%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      <span>Guides</span>
    </a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Heket</h1>
      <p class="guide-hero-subtitle">Frog Summoner &middot; Summon Support</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/clubs.webp`} alt="Clubs" />Clubs</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/support.webp`} alt="Support" />Support</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Heket at a Glance</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
        <div class="heket-verdict-main">
          <div class="heket-verdict-icon" style={`background-image: url('${skillImage("skill_2")}');`} role="img" aria-label="Ten Thousand Toads"></div>
          <div>
            <span class="heket-verdict-kicker">Team-building verdict</span>
            <h3>Build Heket around persistent summons.</h3>
            <p>Her frogs turn battlefield presence into offense, sustain, disruption, and an emergency life reserve. Heket also counts as a summon, so the engine supports its creator.</p>
          </div>
        </div>
        <div class="heket-fact-strip">
          <div><span>Role</span><strong>Summon amplifier</strong></div>
          <div><span>Core resource</span><strong>Living frogs</strong></div>
          <div><span>Best fit</span><strong>Persistent summon teams</strong></div>
        </div>
        <div class="heket-verdict-warning"><strong>Specialist warning</strong><span>Without other summon units, much of her team-wide amplification has too few useful targets.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Frog Engine</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-engine">
        <div class="heket-engine-flow">
          <div class="heket-engine-step">
            <div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_3")}');`} role="img" aria-label="Primordial Molt"></div>
            <span>Establish</span>
            <strong>Create the frog line</strong>
            <p>Begin with bodies already protecting the formation.</p>
          </div>
          <div class="heket-engine-step">
            <div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_4")}');`} role="img" aria-label="Symbiotic Blessing"></div>
            <span>Amplify</span>
            <strong>Power every summon</strong>
            <p>Living frogs strengthen offense and recurring sustain.</p>
          </div>
          <div class="heket-engine-step">
            <div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_2")}');`} role="img" aria-label="Ten Thousand Toads"></div>
            <span>Disrupt</span>
            <strong>Synchronize the croaks</strong>
            <p>Nearby enemies face damage and mounting accuracy pressure.</p>
          </div>
          <div class="heket-engine-step">
            <div class="heket-engine-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label="Toad Pact"></div>
            <span>Survive</span>
            <strong>Trade a frog for life</strong>
            <p>A living frog can become Heket's emergency protection.</p>
          </div>
        </div>
        <div class="heket-engine-return"><span>Rebuild the engine</span></div>
        <div class="heket-engine-rule"><strong>Keep the board healthy.</strong><span>At the field limit, a new summon replaces the weakest frog—refreshing the formation rather than wasting the cast.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Skills: What They Mean</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => (
            <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}>
              <header class="guide-skill-panel-head">
                <div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div>
                <img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" />
              </header>
              <p class="guide-skill-panel-text">{skill.description}</p>
              <div class="guide-skill-panel-upgrades">
                <span class="guide-skill-panel-label">Upgrades</span>
                {skill.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}
              </div>
              <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{skill.takeaway}</p>
            </article>
          ))}
          <article class="guide-skill-panel" data-guide-skill="relic">
            <header class="guide-skill-panel-head">
              <div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">{relic.badge}</span><span class="guide-skill-badge guide-skill-badge--level">{relic.levelBadge}</span></div></div>
              <img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" />
            </header>
            <p class="guide-skill-panel-text">{relic.description}</p>
            <div class="guide-skill-panel-upgrades">
              <span class="guide-skill-panel-label">Upgrades</span>
              {relic.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}
            </div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{relic.takeaway}</p>
          </article>
        </div>
        <ol class="guide-skill-selector">
          {skills.map((skill, index) => (
            <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><small>{skill.badge}</small></span></button></li>
          ))}
          <li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><small>{relic.badge}</small></span></button></li>
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Relic Investment</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint guide-apple-breakpoint--key"><span>Base Relic</span><strong>The important mechanic is already active</strong><p>One frog can be sacrificed to ignore an otherwise lethal damage instance. Heket then receives a Shield equal to 500% ATK.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv2</span><strong>600% ATK Shield</strong><p>More protection after the save, but no new behavior.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv3</span><strong>700% ATK Shield</strong><p>Another survivability increase without changing how the Relic is used.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--max"><span>Lv4 &middot; Recommended</span><strong>800% ATK Shield</strong><p>The preferred survivability target. Heavy burst and damage amplification make the largest available Shield increasingly valuable after Toad Pact saves her.</p></div>
      </div>
      <div class="guide-callout"><strong>Investment takeaway:</strong> the base Relic unlocks Heket's emergency save, but the highest level is the recommended endpoint. As burst and damage amplification increase, the larger Shield is often what lets her survive the attacks that follow.</div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Strengths &amp; Weaknesses</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <StrengthWeakness strengths={strengths} weaknesses={weaknesses} />
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Team Building</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-partners">
        <article class="heket-partner-feature">
          <img src={heroImage("nuwa")} alt="Nuwa" />
          <div class="heket-partner-feature-content">
            <span class="heket-partner-label">Preferred partner</span>
            <h3>Nuwa</h3>
            <strong>The complete summon-board pairing</strong>
            <p>Her varied Figurines give Heket's offense, healing, and Shields meaningful targets throughout the fight. Nuwa can also protect newly created allied minions.</p>
            <div class="heket-partner-tags"><span>Persistent bodies</span><span>Mixed utility</span><span>Mutual protection</span></div>
          </div>
        </article>
        <div class="heket-partner-options">
          <article class="heket-partner-option">
            <img src={heroImage("eris")} alt="Eris" />
            <div><span class="heket-partner-label">Damage option</span><h3>Eris</h3><p>Puppets repeatedly attack while benefiting from Heket's summon amplification.</p></div>
          </article>
          <article class="heket-partner-option">
            <img src={heroImage("serket")} alt="Serket" />
            <div><span class="heket-partner-label">Aggressive option</span><h3>Serket</h3><p>Short-lived scorpions create immediate pressure and turn their deaths into further disruption.</p></div>
          </article>
          <article class="heket-partner-option">
            <img src={heroImage("hades")} alt="Hades" />
            <div><span class="heket-partner-label">Death-engine option</span><h3>Hades</h3><p>Frog deaths feed his soul economy, and his pull can bring distant enemies toward the frogs' croak zone.</p></div>
          </article>
        </div>
        <div class="heket-partner-rule"><span>Roster filter</span><strong>True summoners receive Heket's direct support. Death-payoff heroes such as Hades offer a separate, indirect synergy when frogs are replaced or sacrificed.</strong></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Battle Plan &amp; Counterplay</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading">
          <span>Winning pattern</span>
          <h3>Protect the engine. Let it compound.</h3>
        </div>
        <div class="heket-tactics">
          <article>
            <div class="heket-tactic-marker">Front</div>
            <h4>Let frogs make contact</h4>
            <p>They move toward nearby enemies and establish the zone for synchronized croaks.</p>
          </article>
          <article>
            <div class="heket-tactic-marker">Back</div>
            <h4>Keep Heket protected</h4>
            <p>A safer position preserves Toad Pact and gives her time to rebuild damaged summons.</p>
          </article>
          <article>
            <div class="heket-tactic-marker">Build</div>
            <h4>Scale the support engine</h4>
            <p>Combine ATK with durability and resource generation instead of chasing personal damage.</p>
          </article>
        </div>
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Favorable fight</span><strong>Extended pressure with normal hit checks</strong><p>Her recurring sustain, Shields, and accuracy reduction gain value as the fight continues.</p></div>
          <div class="heket-matchup-bad"><span>Engine breakers</span><strong>Clear the frogs, then burst again</strong><p>Area damage, summon removal, anti-heal, and unavoidable attacks weaken her core loop. Renewed pressure after Toad Pact activates is especially dangerous.</p></div>
        </div>
        <p class="heket-hades-note"><strong>With Hades:</strong> let normal frog replacement and Toad Pact feed his souls naturally. Do not throw away a healthy frog board solely to accelerate him—the lost healing, amplification, croaks, and survival stock usually cost Heket more than the extra death is worth.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-verdict-box">
        <h3 class="guide-verdict-heading">A foundation piece for summon teams</h3>
        <p class="guide-verdict-text">Heket introduces a support style based on persistent summon amplification rather than broad healing or crowd control. Living frogs scale the ATK and sustain of friendly summons, synchronize stacking accuracy debuffs, and give Heket a resource she can trade for survival. A lot of Toads also supply a substantial Shield to the summon board. Nuwa is the most complete partner on paper because her Figurines give each part of that package a useful target, while Eris and Serket offer more offensive summon pairings. Heket remains much less compelling when a team cannot keep meaningful summons on the field. In some situations she still can be a nice defensive frontline hero with debuffing ability.</p>
      </div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-guide-skill-button");
          for (const other of buttons) {
            const active = other === button;
            other.classList.toggle("is-active", active);
            other.setAttribute("aria-pressed", String(active));
          }
          for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
        });
      }
    }
  </script>
</Base>
