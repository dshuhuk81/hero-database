---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import heketData from "../../data/heroes/heket.json";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const skillImage = (id: string) => `${R2_BASE}/skills/heket_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "This is the center of the kit. It creates frogs, shields every friendly summon—including Heqet—and makes nearby enemies less accurate. Because croaks synchronize, several frogs can apply the Hit Rate debuff quickly.",
  skill_2: "This active adds another frog to the engine. If the field is already full, the weakest frog is replaced, turning the cast into a refresh for a damaged frontline body.",
  skill_3: "If a frog is available, Heqet can sacrifice it to negate one lethal damage instance and gain a large personal Shield. Shield strength increases with this skill's levels; the cooldown is improved by Nethertoad Unsealed.",
  skill_4: "Despite the skill text saying frogs, live testing shows that every friendly summon raises this counter. Heqet and all friendly summons receive the resulting ATK bonus and periodic healing.",
};

const skills = heketData.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  takeaway: takeaways[skill.id],
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({
    level: level.replace("level", "Lv "),
    text,
  })),
}));

const relic = {
  ...heketData.relic,
  badge: "Relic",
  levelBadge: "High-impact scaling",
  takeaway: "The base Relic fixes Heqet's slow opening by giving her a frog immediately and raising the cap. Later levels sharply reduce Toad Creed Crossing's cooldown, while Lv4 improves both the opening summon and maximum frog count.",
  upgrades: Object.entries(heketData.relic.upgrades).map(([level, text]) => ({
    level: level.replace("level", "Lv "),
    text,
  })),
};

const strengths = [
  "Each live friendly summon grants Heqet and all friendly summons up to 40% ATK at Skill Lv3",
  "Ruins of Myriad Plagues shields every allied minion for up to 400% of Heqet's ATK",
  "Synchronized croaks can rapidly stack a 25% Hit Rate reduction up to five times",
  "Starts the battle with frogs and can raise the maximum number allowed on the field",
  "Provides recurring healing to herself and friendly summons while any friendly summons remain alive",
  "Toad Creed Crossing, a normal passive skill, sacrifices a frog to ignore lethal damage and grants a massive Shield",
  "Frog replacements and sacrifices can fuel allies that benefit when units fall",
];

const weaknesses = [
  "Most of her major benefits apply only to summons, not directly to allied heroes",
  "Offers limited personal damage because frogs do not perform basic attacks",
  "Losing frogs reduces the summon ATK bonus, synchronized croaks, and sacrifice options",
  "Her team value is much lower outside a summon-focused composition",
  "Toad Creed Crossing needs a frog on the field and has a cooldown, so it is not unconditional immortality",
  "Area damage and summon removal can collapse several parts of her kit at once",
];
---

<Base title="Heqet Guide - Frog & Summon Support | Motto Immortal" description="Heqet guide covering frogs, summon ATK buffs and Shields, synchronized croaks, Toad Creed Crossing, team fit, strengths, weaknesses, and confirmed mechanics.">
  <div class="guide-banner guide-banner--heket guide-banner--clubs">
    <div class="guide-banner-bg" style={`background-image: url('${heroImage("heket")}'); --guide-banner-y: 15%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      <span>Guides</span>
    </a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Heqet</h1>
      <p class="guide-hero-subtitle">Frog Summoner &middot; Summon Support</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/clubs.webp`} alt="Clubs" />Clubs</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/support.webp`} alt="Support" />Support</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--clubs">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Heqet at a Glance</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
        <div class="heket-verdict-main">
          <div class="heket-verdict-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Ruins of Myriad Plagues"></div>
          <div>
            <span class="heket-verdict-kicker">Team-building verdict</span>
            <h3>Build Heqet around persistent summons.</h3>
            <p>Her frogs turn battlefield presence into offense, sustain, disruption, and an emergency life reserve. Heqet also counts as a summon, so the engine supports its creator.</p>
          </div>
        </div>
        <div class="heket-fact-strip">
          <div><span>Role</span><strong>Summon amplifier</strong></div>
          <div><span>Core resource</span><strong>Living summons</strong></div>
          <div><span>Best fit</span><strong>Persistent summon teams</strong></div>
        </div>
        <div class="heket-verdict-warning"><strong>Specialist warning</strong><span>Without other summon units, much of her team-wide amplification has too few useful targets.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Frog Engine</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-engine">
        <div class="heket-engine-flow">
          <div class="heket-engine-step">
            <div class="heket-engine-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label="Nethertoad Unsealed"></div>
            <span>Establish</span>
            <strong>Create the frog line</strong>
            <p>Begin with bodies already protecting the formation.</p>
          </div>
          <div class="heket-engine-step">
            <div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_4")}');`} role="img" aria-label="Symbiotic Blessing"></div>
            <span>Amplify</span>
            <strong>Power every summon</strong>
            <p>Every live friendly summon strengthens offense and recurring sustain.</p>
          </div>
          <div class="heket-engine-step">
            <div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Ruins of Myriad Plagues"></div>
            <span>Disrupt</span>
            <strong>Synchronize the croaks</strong>
            <p>Nearby enemies face damage and mounting accuracy pressure.</p>
          </div>
          <div class="heket-engine-step">
            <div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_3")}');`} role="img" aria-label="Toad Creed Crossing"></div>
            <span>Survive</span>
            <strong>Trade a frog for life</strong>
            <p>A living frog can become Heqet's emergency protection.</p>
          </div>
        </div>
        <div class="heket-engine-return"><span>Rebuild the engine</span></div>
        <div class="heket-engine-rule"><strong>Keep the board healthy.</strong><span>At the field limit, a new summon replaces the weakest frog—refreshing the formation rather than wasting the cast.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Skills: What They Mean</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => (
            <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}>
              <header class="guide-skill-panel-head">
                <div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div>
                <img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" />
              </header>
              <p class="guide-skill-panel-text">{skill.description}</p>
              <div class="guide-skill-panel-upgrades">
                <span class="guide-skill-panel-label">Upgrades</span>
                {skill.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}
              </div>
              <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{skill.takeaway}</p>
            </article>
          ))}
          <article class="guide-skill-panel" data-guide-skill="relic">
            <header class="guide-skill-panel-head">
              <div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">{relic.badge}</span><span class="guide-skill-badge guide-skill-badge--level">{relic.levelBadge}</span></div></div>
              <img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" />
            </header>
            <p class="guide-skill-panel-text">{relic.description}</p>
            <div class="guide-skill-panel-upgrades">
              <span class="guide-skill-panel-label">Upgrades</span>
              {relic.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}
            </div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{relic.takeaway}</p>
          </article>
        </div>
        <ol class="guide-skill-selector">
          {skills.map((skill, index) => (
            <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><small>{skill.badge}</small></span></button></li>
          ))}
          <li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><small>{relic.badge}</small></span></button></li>
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Relic Investment</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint guide-apple-breakpoint--key"><span>Base Relic</span><strong>Immediate frog and +1 Frog Limit</strong><p>Heqet starts contributing sooner and gains another body for her aura, synchronized croaks, and lethal protection.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv2</span><strong>15s survival cooldown</strong><p>Toad Creed Crossing can become available twice as often, provided Heqet still has a frog to sacrifice.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv3</span><strong>8s survival cooldown</strong><p>A major survivability breakpoint in sustained fights, though every trigger still consumes part of her frog engine.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--max"><span>Lv4</span><strong>Two stronger opening frogs and +2 Frog Limit</strong><p>The maximum level improves her opening, raises the engine's ceiling, and supplies more potential sacrifice targets.</p></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Strengths &amp; Weaknesses</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <StrengthWeakness strengths={strengths} weaknesses={weaknesses} />
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Where Heqet Actually Fits</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading">
          <span>Formation value</span>
          <h3>Self-contained by design, team-wide only with summons.</h3>
        </div>
        <div class="heket-tactics">
          <article>
            <div class="heket-tactic-marker">Solo engine</div>
            <h4>Functional without summoner allies</h4>
            <p>Her own frogs activate her amplification and healing, receive her Shields, and fuel Toad Creed Crossing. Their synchronized croaks are her main contribution to a conventional team: three frogs can rapidly apply three 25% Hit Rate reductions, creating nominal −75% Hit Rate pressure for 5 seconds on nearby enemies. This reduces accuracy rather than guaranteeing a 75% miss chance.</p>
          </article>
          <article>
            <div class="heket-tactic-marker">True audience</div>
            <h4>Allied summons become real beneficiaries</h4>
            <p>Nuwa's Figurines, Eris's puppets, Serket's scorpions, and Zeus's clone can receive Heqet's ATK amplification, recurring healing, and Ultimate Shield. Their masters do not receive those effects directly.</p>
          </article>
          <article>
            <div class="heket-tactic-marker">Best condition</div>
            <h4>Persistence matters more than the label</h4>
            <p>Adding a summoner does not guarantee an earlier start, more personal damage, or better survival. Heqet performs best when summons appear early and remain alive long enough to benefit from repeated healing, Shields, and synchronized croaks.</p>
          </article>
        </div>
        <p class="heket-hades-note"><strong>Roster verdict:</strong> Without summon allies, bring Heqet primarily when synchronized Hit Rate reduction answers the encounter; most of her remaining support stays inside her own frog engine. She becomes a strong conditional support with one reliable summon engine and a core specialist when several persistent summons can stay on the field.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Team Building</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-partners">
        <article class="heket-partner-feature">
          <img src={heroImage("nuwa")} alt="Nuwa" />
          <div class="heket-partner-feature-content">
            <span class="heket-partner-label">Preferred partner</span>
            <h3>Nuwa</h3>
            <strong>The complete summon-board pairing</strong>
            <p>Her varied Figurines give Heqet's offense, healing, and Shields meaningful targets throughout the fight. Nuwa can also protect newly created allied minions.</p>
            <div class="heket-partner-tags"><span>Persistent bodies</span><span>Mixed utility</span><span>Mutual protection</span></div>
          </div>
        </article>
        <div class="heket-partner-options">
          <article class="heket-partner-option">
            <img src={heroImage("eris")} alt="Eris" />
            <div><span class="heket-partner-label">Damage option</span><h3>Eris</h3><p>Puppets repeatedly attack while benefiting from Heqet's summon amplification.</p></div>
          </article>
          <article class="heket-partner-option">
            <img src={heroImage("serket")} alt="Serket" />
            <div><span class="heket-partner-label">Aggressive option</span><h3>Serket</h3><p>Short-lived scorpions create immediate pressure and turn their deaths into further disruption.</p></div>
          </article>
          <article class="heket-partner-option">
            <img src={heroImage("hades")} alt="Hades" />
            <div><span class="heket-partner-label">Death-engine option</span><h3>Hades</h3><p>Frog deaths feed his soul economy, and his pull can bring distant enemies toward the frogs' croak zone.</p></div>
          </article>
        </div>
        <div class="heket-partner-rule"><span>Roster filter</span><strong>True summoners receive Heqet's direct support. Death-payoff heroes such as Hades offer a separate, indirect synergy when frogs are replaced or sacrificed.</strong></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2>
      <div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-verdict-box">
        <h3 class="guide-verdict-heading">A foundation piece for summon teams</h3>
        <p class="guide-verdict-text">Heqet introduces a support style based on persistent summon amplification rather than broad healing or crowd control. Every living friendly summon scales the ATK and sustain of Heqet and the summon board; her frogs also synchronize stacking accuracy debuffs and give her a resource she can trade for survival. Ruins of Myriad Plagues supplies a substantial Shield to the summon board. Nuwa is the most complete partner on paper because her Figurines give each part of that package a useful target, while Eris and Serket offer more offensive summon pairings. Comparison testing confirms that allied summons broaden Heqet's support across the formation, but they do not guarantee an earlier start, more personal damage, or better survival. Without them, she remains functional but much less compelling. In some situations she can still be a useful defensive frontline hero with debuffing ability.<br>
          Heket is a specialized Summon support whose greatest value appears near progression breakpoints. She can significantly strengthen a functioning Summon core and may turn close losses into wins, provided its key Summoners survive long enough to benefit. Her relic also gives her exceptional personal survivability against lethal burst. However, she cannot rescue a team whose Summoners are eliminated immediately, and her higher total damage does not necessarily produce faster clears. Outside Summon-focused teams, broadly useful supports may offer more consistent value.
        </p>
      </div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-guide-skill-button");
          for (const other of buttons) {
            const active = other === button;
            other.classList.toggle("is-active", active);
            other.setAttribute("aria-pressed", String(active));
          }
          for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
        });
      }
    }
  </script>
</Base>
