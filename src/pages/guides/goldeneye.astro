---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";

const IMG = "/images/guides/goldeneye";
const R2_BASE = "https://pub-e35e94828bf347ca93c3d2c6a50d06f6.r2.dev";

const qualities = [
  { id: "green", name: "Green", range: "20-100", color: "#7cd286" },
  { id: "blue", name: "Blue", range: "100-180", color: "#9dabff" },
  { id: "purple", name: "Purple", range: "180-300", color: "#d56fef" },
  { id: "orange", name: "Orange", range: "300-460", color: "#efa56f" },
  { id: "red", name: "Red", range: "460-650", color: "#ef6f6f" },
  { id: "diamond", name: "Diamond", range: "650-900", color: "#f4f4f0" },
  { id: "rainbow", name: "Rainbow", range: "900-1200", color: "#cf4db5" },
];

const types = [
  { id: "potion", name: "Potion" },
  { id: "pill", name: "Pill" },
  { id: "ore", name: "Ore" },
  { id: "machine", name: "Machine" },
];

const collectionTiers = [
  [4, 1], [8, 2], [12, 4], [16, 8], [20, 12], [24, 16], [28, 20],
];

const rooms = [
  { name: "Room 1", unlock: "Start", ranks: [100, 50, 25, 10, 5], mix: [60, 30, 10] },
  { name: "Room 2", unlock: "10,000 EXP", ranks: [300, 150, 75, 40, 20], mix: [40, 30, 20, 10] },
  { name: "Room 3", unlock: "80,000 EXP", ranks: [1000, 500, 250, 100, 50], mix: [20, 20, 30, 20, 10] },
];

const mastery = [
  [0, 0, [20, 20, 20, 20, 20]],
  [1, 500, [15, 22, 22, 21, 20]],
  [2, 1250, [10, 24, 24, 22, 20]],
  [3, 2450, [5, 24, 26, 24, 21]],
  [4, 4250, [0, 20, 28, 30, 22]],
  [5, 6950, [0, 16, 28, 32, 24]],
  [6, 10950, [0, 8, 26, 38, 28]],
  [7, 16950, [0, 0, 20, 48, 32]],
  [8, 25950, [0, 0, 10, 50, 40]],
  [9, 39450, [0, 0, 0, 45, 55]],
  [10, 59450, [0, 0, 0, 20, 80]],
] as const;
const rollShades = ["#4a3f66", "#6b5a99", "#8f7bc7", "#c2a85a", "#f2c14e"];
const rollLabels = [20, 40, 60, 80, 100];

// Eye promotion chance per step, in percent (config weight / 10000).
const eye = [
  [1, "-", "-", [20, 10, 5, 0, 0, 0], 1],
  [2, 50, 1, [50, 20, 10, 5, 0, 0], 1],
  [3, 100, 1, [80, 50, 20, 10, 1, 0], 1],
  [4, 200, 1, [100, 75, 30, 20, 2, 0], 1],
  [5, 400, 1, [100, 100, 40, 25, 4, 0], 1],
  [6, 600, 2, [100, 100, 50, 30, 7, 1], 2],
  [7, 800, 2, [100, 100, 60, 35, 10, 2], 2],
  [8, 1000, 3, [100, 100, 80, 40, 15, 5], 3],
  [9, 1200, 3, [100, 100, 100, 60, 25, 10], 3],
  [10, 1500, 4, [100, 100, 100, 80, 50, 30], 4],
] as const;
const steps = ["G→B", "B→P", "P→O", "O→R", "R→D", "D→Rb"];

const items = [
  { id: "410001", img: "coin-1", name: "Crystal", text: "Rare drop from crafting (10% rate). Buys extra Energy and pays for every Eye upgrade." },
  { id: "410002", img: "coin-2", name: "Gold Coin", text: "Earned from room matches. Pays for Workshop, Forge, Anvil and Rest." },
  { id: "410003", img: "coin-3", name: "Gold Ingot", text: "Event shop currency." },
  { id: "410005", img: "score-doubler", name: "Score Doubler", text: "Doubles the score of your best submitted artifact. The strongest boost in the event." },
  { id: "410006", img: "score-eye", name: "Score Eye", text: "Shows the average score in the room you are in." },
  { id: "410007", img: "quality-eye", name: "Quality Eye", text: "Shows the average quality in the room you are in." },
  { id: "410004", img: "insight-lens", name: "Insight Lens", text: "For 15 minutes, shows quality and score of every Sword, Spear, Staff or Dagger artifact in all rooms. Four variants, one per weapon." },
];

const buildings = [
  {
    img: "workshop", name: "Workshop", cap: "Lv 1-5",
    text: "Gates everything else. Every other building can only reach the Workshop's level, and each level raises how many artifacts you can submit per room.",
    rows: [["Lv 1", "6 submits", "Free"], ["Lv 2", "8 submits", "1,000"], ["Lv 3", "12 submits", "3,000"], ["Lv 4", "16 submits", "10,000"], ["Lv 5", "20 submits", "20,000"]],
    head: ["Level", "Per room", "Gold Coin"],
  },
  {
    img: "rest", name: "Rest", cap: "Lv 1-5",
    text: "More Energy in the bar and faster regeneration. Level 5 is worth about 6 extra crafts per day.",
    rows: [["Lv 1", "100", "10 / h", "Free"], ["Lv 2", "120", "12 / h", "1,500"], ["Lv 3", "140", "14 / h", "4,500"], ["Lv 4", "160", "16 / h", "15,000"], ["Lv 5", "200", "20 / h", "50,000"]],
    head: ["Level", "Energy cap", "Regen", "Gold Coin"],
  },
  {
    img: "anvil", name: "Anvil", cap: "Lv 1-5",
    text: "Raises the minimum score of every craft, so bad rolls hurt less.",
    rows: [["Lv 1", "+0", "Free"], ["Lv 2", "+20", "1,000"], ["Lv 3", "+40", "5,000"], ["Lv 4", "+60", "25,000"], ["Lv 5", "+80", "150,000"]],
    head: ["Level", "Minimum score", "Gold Coin"],
  },
  {
    img: "hand", name: "Forge", cap: "Lv 1-5",
    text: "Raises the chance of the type you want. Level 5 also unlocks targeted crafting.",
    rows: [["Lv 1", "25%", "Free"], ["Lv 2", "35%", "500"], ["Lv 3", "50%", "1,000"], ["Lv 4", "65%", "1,500"], ["Lv 5", "85%", "2,000"]],
    head: ["Level", "Wanted type", "Gold Coin"],
  },
];

const strategy = [
  ["Upgrade in this order.", "Workshop, then Rest, then Anvil. Every building is capped by the Workshop's level, so raise the Workshop one level and fill that level before moving on. Take the Eye to level 4 and stop there unless you spend money."],
  ["Craft right after the daily reset.", "Energy stops regenerating at the cap, so never let it fill. The daily leaderboard is usually won with 900 points and many players end on exactly 900, so the early crafter takes the spot."],
  ["Submit one great artifact and fill the rest with weak ones.", "Your best artifact sets the base reward, and that reward is multiplied by how many of your own entries sit in the room. Add your weakest artifacts as fillers. Set auto-deploy to Highest first or Lowest first to match."],
  ["Choose a room with free slots.", "Each room holds 50 entries. Below about 35 total entries the reward drops, so aim for a room filled to roughly 27 to 42 of 50 where your entries still fit. On a tie, the artifact placed earlier wins."],
  ["Spend Crystals on Energy, not on Eye level 5.", "10 Energy costs 5 Crystals, up to 200 per day. Eye level 5 costs 400 Crystals, which is about 160 extra crafts, and it adds no Rainbow chance. Rainbow starts at Eye level 6, which is a spender's upgrade."],
  ["Time your items.", "Use Score Doubler on your best artifact just before the 5-minute countdown ends. Score Eye and Quality Eye show whether you can win the room. Insight Lens only matters when you are fighting for first place."],
  ["Finish the collection.", "All 28 artifacts give +20% score on everything after."],
];

const dailyRewards = [
  ["1st", 15, 25, 20], ["2nd", 10, 20, 20], ["3rd", 5, 20, 20],
  ["4th to 6th", "-", 20, 20], ["7th to 10th", "-", 20, 15], ["11th to 20th", "-", 20, 10],
  ["21st to 50th", "-", 20, 5], ["51st to 100th", "-", 20, "-"], ["101st to 500th", "-", 15, "-"],
  ["501st to 1000th", "-", 10, "-"], ["1001st to 9999th", "-", 5, "-"],
];
const rankLabels = ["1st", "2nd", "3rd", "4th", "5th to 50th"];
const shopOrder = [
  "Buy every limited entry you want first.",
  "Spend what is left on the unlimited entry.",
];
---

<Base title="Goldeneye Event Guide - Artifacts, Rooms & Upgrades | Motto Immortal" description="Goldeneye (Gem Creation) event guide: how crafting and arena rooms work, all 28 artifacts, building upgrades, Eye promotion chances, mastery, items, shop and the best upgrade order.">
  <div class="guide-banner guide-banner--goldeneye">
    <div class="guide-banner-bg" style={`background-image: url('${IMG}/banner.webp'); --guide-banner-y: 30%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg><span>Guides</span></a>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Goldeneye</h1>
      <p class="guide-hero-subtitle">Craft artifacts, win arena rooms. Nov 2 to Nov 13, 2026.</p>
      <div class="guide-badge-row">
        <span class="guide-badge guide-badge--legendary">Event Guide</span>
        <span class="guide-badge">28 artifacts</span>
        <span class="guide-badge">3 arena rooms</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--goldeneye">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Goldeneye at a Glance</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
        <div class="heket-verdict-main">
          <div class="heket-verdict-icon" style={`background-image: url('${IMG}/score-doubler.webp');`} role="img" aria-label="Score Doubler"></div>
          <div><h3>Craft, submit, outscore the room.</h3><p>You spend Energy to craft artifacts, then submit them into an arena room. Your best artifact sets the base reward, and the number of entries you place in the room multiplies it. Building upgrades and a growing collection make every craft score higher.</p></div>
        </div>
        <div class="heket-fact-strip"><div><span>Craft cost</span><strong>5 Energy, start with 100</strong></div><div><span>Countdown</span><strong>5 minutes per room</strong></div><div><span>Collection</span><strong>4 types x 7 qualities</strong></div></div>
        <div class="heket-verdict-warning"><strong>Key fact</strong><span>Diamond and Rainbow artifacts never come from a plain craft. They only appear through Eye promotions, so the Eye decides your ceiling.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">How a Round Works</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="ge-flow">
        <div class="ge-step"><img src={`${IMG}/type-potion.webp`} alt="" width="72" height="72" loading="lazy" /><strong>Craft</strong><p>Spend 5 Energy. You get a Potion, Pill, Ore or Machine of some quality with a score inside that quality's range.</p></div>
        <div class="ge-step"><img src={`${IMG}/quality-eye.webp`} alt="" width="72" height="72" loading="lazy" /><strong>Promote</strong><p>The Eye can lift the finished artifact one quality step higher.</p></div>
        <div class="ge-step"><img src={`${IMG}/workshop.webp`} alt="" width="72" height="72" loading="lazy" /><strong>Submit</strong><p>Enter artifacts into a room of 50 slots. Your Workshop level caps how many you can submit, and auto-deploy can send them Highest first or Lowest first.</p></div>
        <div class="ge-step"><img src={`${IMG}/coin-2.webp`} alt="" width="72" height="72" loading="lazy" /><strong>Rank</strong><p>When the countdown ends, your best artifact and your entry count decide the reward. Every match also pays Gold Coins.</p></div>
      </div>
      <div class="heket-engine-rule"><strong>Energy.</strong><span>You start with 100 and each craft costs 5. You can buy 10 Energy for 5 Crystals, up to 200 Energy per day. Rest raises the cap to 200 and regeneration to 20 per hour.</span></div>
      <div class="heket-engine-rule"><strong>Leaderboard.</strong><span>The event has three leaderboard tabs. Points from rooms are what you climb with.</span></div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The 28 Artifacts</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="ge-lead">Every type comes in seven qualities. Tap the ones you own: each 4 artifacts add a permanent score bonus, up to +20% at 28.</p>
      <div class="ge-collection" data-ge-collection>
        <div class="ge-grid-scroll">
          <div class="ge-grid" role="group" aria-label="Artifact collection">
            <div class="ge-grid-corner"></div>
            {qualities.map((q) => <div class="ge-grid-head" style={`--q:${q.color}`}><strong>{q.name}</strong><span>{q.range}</span></div>)}
            {types.map((t) => (
              <>
                <div class="ge-grid-type"><img src={`${IMG}/type-${t.id}.webp`} alt="" width="40" height="40" loading="lazy" /><strong>{t.name}</strong></div>
                {qualities.map((q, i) => (
                  <button type="button" class="ge-cell" aria-pressed="false" data-ge-cell style={`--q:${q.color}`} aria-label={`${t.name}, ${q.name}`}>
                    <img src={`${IMG}/${t.id}-${i + 1}.webp`} alt="" width="64" height="64" loading="lazy" />
                  </button>
                ))}
              </>
            ))}
          </div>
        </div>
        <div class="ge-readout" aria-live="polite">
          <div><span>Collected</span><strong><b data-ge-count>0</b> / 28</strong></div>
          <div><span>Score bonus</span><strong data-ge-bonus>+0%</strong></div>
          <div><span>Next bonus</span><strong data-ge-next>at 4 artifacts</strong></div>
          <button type="button" class="ge-reset" data-ge-reset>Reset</button>
        </div>
        <ol class="ge-tiers">
          {collectionTiers.map(([n, b]) => <li data-ge-tier={n}><strong>+{b}%</strong><span>{n} artifacts</span></li>)}
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Arena Rooms</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="ge-lead">Your event level decides which room you can enter. Level 2 needs 10,000 EXP and Level 3 needs 80,000. Without spending, expect Room 2 after about 3 to 5 days and Room 3 after about 6.</p>
      <div class="ge-rooms">
        {rooms.map((room) => (
          <article class="ge-room">
            <header><h3>{room.name}</h3><span>{room.unlock}</span></header>
            <div class="ge-table-wrap">
              <table class="ge-table">
                <thead><tr><th scope="col">Rank</th><th scope="col">Points</th></tr></thead>
                <tbody>{room.ranks.map((p, i) => <tr><th scope="row">{rankLabels[i]}</th><td>{p}</td></tr>)}</tbody>
              </table>
            </div>
            <p class="ge-room-mix-label">Craft quality chances</p>
            <div class="ge-mix" role="img" aria-label={`Quality chances: ${room.mix.map((w, i) => `${qualities[i].name} ${w}%`).join(", ")}`}>
              {room.mix.map((w, i) => <span style={`flex:${w};background:${qualities[i].color}`}>{w}%</span>)}
            </div>
          </article>
        ))}
      </div>
      <div class="ge-rules">
        <article><strong>Best artifact sets the base</strong><p>Only your strongest entry decides the base reward. The others do not add score.</p></article>
        <article><strong>Entries multiply it</strong><p>The base is multiplied by how many of your own entries are in the room, so fillers are worth submitting.</p></article>
        <article><strong>About 35 entries to be safe</strong><p>With fewer than roughly 35 entries in the room overall, the reward shrinks. A room at 27 to 42 of 50 slots is the sweet spot.</p></article>
        <article><strong>Ties go to the earlier artifact</strong><p>If two artifacts tie, the one placed first ranks higher.</p></article>
      </div>
      <p class="ge-note">These reward rules come from player testing, so exact numbers may shift.</p>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Daily Leaderboard</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="ge-lead">The daily ranking pays items 1114 and 1115 plus Crystals. Crystals stop at rank 50 and never exceed 20, so first place beats fourth mainly through item 1115.</p>
      <div class="ge-table-wrap">
        <table class="ge-table ge-table--daily">
          <thead><tr><th scope="col">Rank</th><th scope="col">Item 1115</th><th scope="col">Item 1114</th><th scope="col">Crystals</th></tr></thead>
          <tbody>
            {dailyRewards.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td class={c === "-" ? "is-zero" : ""}>{c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Buildings</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="ge-lead">Four buildings use Gold Coins and are capped by the Workshop. Total to max all four: Workshop 34,000, Rest 71,000, Anvil 181,000, Forge 5,000.</p>
      <div class="ge-buildings">
        {buildings.map((b) => (
          <article class="ge-building">
            <header><img src={`${IMG}/${b.img}.webp`} alt="" width="72" height="72" loading="lazy" /><div><h3>{b.name}</h3><span>{b.cap}</span></div></header>
            <p>{b.text}</p>
            <div class="ge-table-wrap">
              <table class="ge-table">
                <thead><tr>{b.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                <tbody>{b.rows.map((r) => <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c) => <td>{c}</td>)}</tr>)}</tbody>
              </table>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Eye</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="ge-eye-head">
        <img src={`${IMG}/eye.webp`} alt="" width="120" height="120" loading="lazy" />
        <p>The Eye gives each craft a chance to rise one quality step. It is paid in Crystals, not Gold Coins. Levels 1 to 5 only need Workshop 1, level 6 and 7 need Workshop 2, level 8 and 9 need Workshop 3, and level 10 needs Workshop 4. Total cost to level 10: 5,850 Crystals. Level 4 already gives a 100% chance for Green to Blue and 75% for Blue to Purple.</p>
      </div>
      <div class="ge-table-wrap">
        <table class="ge-table ge-table--eye">
          <thead><tr><th scope="col">Eye</th><th scope="col">Crystals</th><th scope="col">Workshop</th>{steps.map((s) => <th scope="col">{s}</th>)}</tr></thead>
          <tbody>
            {eye.map((r) => (
              <tr>
                <th scope="row">Lv {r[0]}</th><td>{r[1]}</td><td>{r[4]}</td>
                {r[3].map((c) => <td class={c === 0 ? "is-zero" : ""}>{c === 0 ? "-" : `${c}%`}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="guide-callout"><strong>Reading it:</strong> each column is the chance to rise from one quality to the next. Free-to-play players should stop at Lv 4: Lv 5 costs 400 Crystals and still gives no Rainbow chance. Rainbow only opens at Lv 6, at 1%, and reaches 30% at Lv 10.</div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Mastery</h2><div class="lt-flourish lt-flourish-center"></div>
      <p class="ge-lead">Each type has its own mastery, Lv 0 to 10. It grows with the final score of that type's artifacts. Higher mastery shifts your score rolls toward 100 and removes the weakest ones: 20-rolls are gone from Lv 4, and at Lv 10 four rolls in five are a 100. How much this changes results in practice has not been tested.</p>
      <div class="ge-mastery">
        <div class="ge-mastery-key">{rollLabels.map((l, i) => <span><i style={`background:${rollShades[i]}`}></i>{l}</span>)}</div>
        {mastery.map(([lv, exp, w]) => (
          <div class="ge-mastery-row">
            <strong>Lv {lv}</strong>
            <div class="ge-mix ge-mix--thin" role="img" aria-label={`Mastery ${lv}: ${w.map((x, i) => `roll ${rollLabels[i]} ${x}%`).join(", ")}`}>
              {w.map((x, i) => x > 0 ? <span style={`flex:${x};background:${rollShades[i]}`}>{x >= 12 ? `${x}%` : ""}</span> : null)}
            </div>
            <small>{exp.toLocaleString("en-US")} total</small>
          </div>
        ))}
      </div>
      <div class="guide-callout"><strong>Optional.</strong> Because mastery is per type, focusing on one type raises it faster. This is a side benefit, not a priority over Energy and timing.</div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Items</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="ge-items">
        {items.map((it) => (
          <article class="ge-item"><img src={`${IMG}/${it.img}.webp`} alt="" width="64" height="64" loading="lazy" /><div><h3>{it.name}</h3><p>{it.text}</p><small>Item {it.id}</small></div></article>
        ))}
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Event Shop</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="ge-shop">
        <div class="ge-shop-main">
          <img src={`${R2_BASE}/heroes/nezha.webp`} alt="Nezha" width="240" height="240" loading="lazy" />
          <div>
            <h3>Nezha bundles</h3>
            <p>The main prize. Several bundles, each costing 300 Gold Ingots and giving 40, 60, 80 or 100 of item 400701. Each bundle can be bought twice.</p>
          </div>
        </div>
        <div class="ge-shop-side">
          <div><strong>Gacha item 410008</strong><span>250 or 150 Gold Ingots each, depending on the entry.</span></div>
          <div><strong>Item range 1009 to 1115</strong><span>20 to 150 Gold Ingots each.</span></div>
          <div><strong>Currency pack</strong><span>50 currency for 5 pieces, no purchase limit.</span></div>
        </div>
      </div>
      <ol class="ge-order">{shopOrder.map((s) => <li>{s}</li>)}</ol>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Best Strategy</h2><div class="lt-flourish lt-flourish-center"></div>
      <ol class="ge-strategy">
        {strategy.map(([h, p]) => <li><div class="ge-strategy-body"><strong>{h}</strong><p>{p}</p></div></li>)}
      </ol>
      <div class="guide-callout"><strong>Gold Coins and Crystals are separate.</strong> Gold Coins go into Workshop, Rest and Anvil. Crystals are better spent on Energy than on the Eye past level 4. Crystals are a separate currency, so the Eye can start early.</div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-verdict-box"><h3 class="guide-verdict-heading">A race decided by timing and entry count</h3><p class="guide-verdict-text">Build Workshop, Rest and Anvil in that order, craft right after the reset and never waste Energy. Submit one strong artifact with weak fillers into a room that is well filled but not full, and fire Score Doubler at the end of the countdown. Crystals go into Energy, not past Eye level 4.</p></div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>

  <script>
    const key = "goldeneye-collection";
    const tiers: [number, number][] = [[4, 1], [8, 2], [12, 4], [16, 8], [20, 12], [24, 16], [28, 20]];
    for (const root of document.querySelectorAll<HTMLElement>("[data-ge-collection]")) {
      const cells = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-ge-cell]"));
      const count = root.querySelector<HTMLElement>("[data-ge-count]")!;
      const bonus = root.querySelector<HTMLElement>("[data-ge-bonus]")!;
      const next = root.querySelector<HTMLElement>("[data-ge-next]")!;
      const render = () => {
        const n = cells.filter((c) => c.getAttribute("aria-pressed") === "true").length;
        const current = [...tiers].reverse().find(([need]) => n >= need);
        const upcoming = tiers.find(([need]) => n < need);
        count.textContent = String(n);
        bonus.textContent = `+${current ? current[1] : 0}%`;
        next.textContent = upcoming ? `+${upcoming[1]}% in ${upcoming[0] - n} more` : "Maxed";
        for (const li of root.querySelectorAll<HTMLElement>("[data-ge-tier]")) li.classList.toggle("is-done", n >= Number(li.dataset.geTier));
        try { localStorage.setItem(key, JSON.stringify(cells.map((c) => c.getAttribute("aria-pressed") === "true"))); } catch {}
      };
      try {
        const saved = JSON.parse(localStorage.getItem(key) || "[]");
        if (Array.isArray(saved)) cells.forEach((c, i) => c.setAttribute("aria-pressed", String(saved[i] === true)));
      } catch {}
      for (const c of cells) c.addEventListener("click", () => { c.setAttribute("aria-pressed", String(c.getAttribute("aria-pressed") !== "true")); render(); });
      root.querySelector("[data-ge-reset]")?.addEventListener("click", () => { cells.forEach((c) => c.setAttribute("aria-pressed", "false")); render(); });
      render();
    }
  </script>
