---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import gaiyaData from "../../data/heroes/gaiya.json";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const skillImage = (id: string) => `${R2_BASE}/skills/gaiya_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "Nature's Revival is Gaiya's major stabilization tool. It does more than refill HP: it creates a defensive window in which the team becomes harder to kill, while Gaiya cannot be controlled. Tower testing repeatedly showed that established Ultimate cycles can carry a formation through incoming damage that would otherwise overwhelm it. Grace Domain is already active before her first cast, so she contributes from the start of battle.",
  skill_2: "Evaluate this skill for its protection rather than its damage. Reducing enemy ATK lowers incoming pressure, while every nearby target adds to Gaiya's own Shield. It gains defensive value when she is surrounded and helps her stay active long enough to maintain the rest of the Life Flora engine.",
  skill_3: "The continuous healing stabilizes the formation and feeds Life Flora whenever recovery received by Gaiya exceeds her missing HP. Another healer is therefore not automatically redundant: additional recovery directed to Gaiya can help create Flowers instead of disappearing as wasted healing.",
  skill_4: "This creates natural scaling in longer fights. Max HP improves Gaiya's durability and strengthens several other parts of her kit. Repeated Ultimates therefore protect the team while making Gaiya progressively harder to remove.",
};

const skills = gaiyaData.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  takeaway: takeaways[skill.id],
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
}));

const relic = {
  ...gaiyaData.relic,
  badge: "Relic",
  takeaway: "Gaiya is preparing for future damage instead of only healing damage after it happens. Relic investment strengthens this defining cycle and eventually lets repeated Flower generation contribute Energy and ATK support as well as protection.",
  upgrades: Object.entries(gaiyaData.relic.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
};

const strengths = [
  "Strong team-wide sustain",
  "Converts overhealing received by Gaiya into useful defensive resources",
  "Can protect allies from otherwise lethal damage",
  "Provides team-wide Damage Reduction and becomes immune to Control effects after her Ultimate",
  "Grace Domain is active from the beginning of battle",
  "Improves the healing and shielding received by the entire team",
  "Reduces enemy ATK and can gain substantial personal Shields against multiple enemies",
  "Scales naturally through Max HP and repeated Ultimate casts",
  "Can eventually convert her defensive engine into Energy and ATK support",
];

const weaknesses = [
  "Very low personal damage contribution",
  "Cannot compensate for insufficient team damage",
  "Cannot fix HIT, targeting, or other offensive matchup problems",
  "Some of her strongest protection depends on generating Flowers",
  "An ally can die before sufficient protection has been established",
  "Timed encounters punish excessive defensive investment",
  "Her full Life Flora utility requires Relic investment",
  "A team that already survives comfortably may gain more from another offensive slot",
];
---

<Base title="Gaiya Guide - Life Flora & Overheal Tank | Motto Immortal" description="Complete Gaiya guide covering Grace Domain, Flowers of Life, overhealing, relic investment, teams, builds, PvE use, strengths, weaknesses, and counterplay.">
  <div class="guide-banner guide-banner--heket guide-banner--starglint">
    <div class="guide-banner-bg" style={`background-image: url('${heroImage("gaiya")}'); --guide-banner-y: 8%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg><span>Guides</span></a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Gaiya</h1>
      <p class="guide-hero-subtitle">Team Protection &middot; Overheal Tank</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/starglint.webp`} alt="Starglint" />Starglint</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/tank.webp`} alt="Tank" />Tank</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--starglint">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Gaiya at a Glance</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
        <div class="heket-verdict-main">
          <div class="heket-verdict-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label="Life Flora"></div>
          <div><span class="heket-verdict-kicker">Team-building verdict</span><h3>Protect the win condition and give it time to work.</h3><p>Gaiya combines team-wide healing, Damage Reduction, Shields, protection against lethal damage, and personal Control Immunity. Unlike a conventional healer, she can turn healing received beyond her own missing HP into protection for any ally. Unlike a conventional Tank, much of her defensive value reaches the entire formation. She is at her best when the team already has enough offensive potential but cannot survive long enough to use it.</p></div>
        </div>
        <div class="heket-fact-strip"><div><span>Role</span><strong>Team protection and sustain</strong></div><div><span>Core mechanic</span><strong>Overhealing into Flowers</strong></div><div><span>Best fit</span><strong>A strong carry that needs time</strong></div></div>
        <div class="heket-verdict-warning"><strong>Key warning</strong><span>Surviving longer is only useful if your team can finish the fight.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Life Flora Engine</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-engine">
        <div class="heket-engine-flow">
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_3")}');`} role="img" aria-label="Grace Domain"></div><span>Heal</span><strong>Keep the formation healthy</strong><p>Grace Domain continuously restores allied HP, while the Ultimate supplies another large team heal.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label="Life Flora"></div><span>Overheal</span><strong>Keep Gaiya's excess recovery</strong><p>Healing received by Gaiya beyond her missing HP contributes toward Life Flora instead of automatically going to waste.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label="Flower of Life"></div><span>Grow</span><strong>Create Flowers of Life</strong><p>For every stored amount equal to half of Gaiya's Max HP, Life Flora creates a Flower that can protect any ally from a near-death hit.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Nature's Revival"></div><span>Protect</span><strong>Stop lethal damage</strong><p>A Flower can be consumed when its ally receives potentially lethal damage, restoring stored HP and keeping the engine alive.</p></div>
        </div>
        <div class="heket-engine-return"><span>Continue healing and grow the next Flower</span></div>
        <div class="heket-engine-rule"><strong>Overhealing received by Gaiya is a resource.</strong><span>Keeping Gaiya healthy can continue building protection for the whole team. At higher Relic investment, repeated Flowers also begin supporting the offense through Energy and ATK.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Skills: What They Mean</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}>
            <header class="guide-skill-panel-head"><div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div><img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{skill.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{skill.upgrades.map((upgrade) => <div><span>{upgrade.level}</span><p>{upgrade.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{skill.takeaway}</p>
          </article>)}
          <article class="guide-skill-panel" data-guide-skill="relic">
            <header class="guide-skill-panel-head"><div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">{relic.badge}</span><span class="guide-skill-badge guide-skill-badge--level">Defining mechanic</span></div></div><img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{relic.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{relic.upgrades.map((upgrade) => <div><span>{upgrade.level}</span><p>{upgrade.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{relic.takeaway}</p>
          </article>
        </div>
        <ol class="guide-skill-selector">
          {skills.map((skill, index) => <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><small>{skill.badge}</small></span></button></li>)}
          <li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><small>{relic.badge}</small></span></button></li>
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Relic Investment</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint guide-apple-breakpoint--key"><span>Base Relic</span><strong>Overhealing becomes protection</strong><p>Life Flora introduces Flowers of Life and turns excess healing into a defensive resource. This is the foundation of Gaiya's identity.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv2</span><strong>Gaiya becomes harder to break</strong><p>Protected allies inside Grace Domain contribute Damage Reduction to Gaiya, helping the source of the team's sustain remain active.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv3</span><strong>Stronger personal protection</strong><p>The Damage Reduction Gaiya receives through Life Flora increases further, improving her durability under heavy pressure.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--max"><span>Lv4 &middot; Utility upgrade</span><strong>Flowers gain offensive value</strong><p>Repeated Flower generation can create a Flower of Energy, providing Energy and a temporary ATK increase to help the protected team convert survival into pressure.</p></div>
      </div>
      <div class="guide-callout"><strong>Investment takeaway:</strong> Relic investment improves the mechanic that makes Gaiya unique. Higher investment strengthens the healing, Flower, and protection cycle and eventually lets it support the team's offense as well.</div>
    </section>

    <section class="guide-section guide-section--detail-heading"><h2 class="guide-section-title lt-h2 lt-h2-center">Strengths &amp; Weaknesses</h2><div class="lt-flourish lt-flourish-center"></div><StrengthWeakness strengths={strengths} weaknesses={weaknesses} /></section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Team Building</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Start with the win condition</span><h3>Ask who needs Gaiya to stay alive.</h3></div>
        <div class="heket-tactics">
          <article><div class="heket-tactic-marker">Carry</div><h4>Protect the damage dealer</h4><p>Gaiya works best when the team already has a reliable source of damage. Tower testing showed that extreme survival still cannot overcome a carry that lacks enough HIT or damage for the encounter. If everyone lives but the enemy does not die, improve the offensive solution.</p></article>
          <article><div class="heket-tactic-marker">Sustain</div><h4>Add healing or Shields with purpose</h4><p>Extra healing received by Gaiya can feed Life Flora, while Grace Domain improves incoming Shields for every ally. These tools can complement the engine when they create more Flowers or protect the team while Gaiya grows them.</p></article>
          <article><div class="heket-tactic-marker">Frontline</div><h4>Use a second Tank when survival is the problem</h4><p>Testing with Khepri showed that another durable frontline can create an extremely resilient formation. Every defensive slot also reduces the space available for offense, so use double Tank only when incoming damage is the reason for the loss.</p></article>
        </div>
        <div class="guide-callout"><strong>Community-tested option:</strong> Chinese player testing identifies Dance God as a mechanically compatible support. Max-HP-based shielding complements Gaiya's health pool and can help maintain the conditions needed for overhealing and Flowers. Treat this as a supported pairing rather than a mandatory composition.</div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">PvE Use Cases</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Difficult progression</span><strong>Create more time for the carry</strong><p>When enemy scaling makes survival the limiting factor, Gaiya can give the team's damage dealers substantially more time to work. Sustained pressure also gives her repeated opportunities to heal, grow Flowers, cast her Ultimate, and build Nature's Armor.</p></div>
          <div class="heket-matchup-good"><span>Heavy burst</span><strong>Survive, recover, stabilize</strong><p>Tower testing against Zeus showed that a formation able to survive the opening burst could recover and repeatedly establish Gaiya's defensive Ultimate window. If an ally is removed before enough protection exists, improve opening survival or positioning first.</p></div>
        </div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Boss Battles</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Long encounters</span><h3>Long fights give Gaiya's engine room to scale.</h3></div>
        <p class="heket-hades-note">Boss encounters are a strong use case for Gaiya when survival is part of the challenge. Grace Domain provides continuous sustain from the beginning of battle, while repeated Ultimate casts progressively increase Gaiya's Max HP through Nature's Armor. Additional healing received by Gaiya can feed Life Flora, allowing her defensive engine to continue developing throughout a long encounter.</p>
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Direct boss comparison</span><strong>Gaiya kept the formation alive</strong><p>The same core team was tested with Gaiya and Cancer as the frontline. With Cancer, the frontline collapsed roughly halfway through the fight and the remaining heroes eventually followed. With Gaiya, the formation survived the full encounter while she continued cycling her Ultimate and increasing her Max HP.</p></div>
          <div class="heket-matchup-good"><span>Higher Relic investment</span><strong>Convert the defensive cycle into offense</strong><p>Long fights can also produce Flower of Energy, providing Energy and an ATK boost to the team's highest-ATK ally. This helps turn continued survival into additional offensive pressure.</p></div>
        </div>
        <p class="heket-hades-note"><strong>The limitation remains damage:</strong> Gaiya is valuable when keeping the team alive allows your damage dealers to continue working. If the team already survives comfortably but cannot defeat the boss in time, adding more sustain does not solve the problem.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">PvP</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Opening survival</span><h3>The opening burst decides how much of Gaiya you actually get.</h3></div>
        <p class="heket-hades-note">Gaiya's PvP performance depends heavily on whether the team survives the opening burst. Grace Domain is active immediately, so she contributes sustain from the start. However, important parts of her defensive engine require time: Nature's Revival adds her stronger protection window, while repeated Ultimate casts allow Nature's Armor to increase her Max HP further.</p>
        <div class="heket-matchup-row">
          <div class="heket-matchup-bad"><span>Fast enemy burst</span><strong>The fight can end before her first Ultimate</strong><p>Against very strong teams with an early Zeus Ultimate, testing showed that fights could end before Gaiya ever reached Nature's Revival. Her stronger defensive layers never had time to become available.</p></div>
          <div class="heket-matchup-good"><span>Longer PvP fights</span><strong>Gaiya can establish her defensive cycle</strong><p>When the formation survived the opening, Gaiya was able to reach Nature's Revival and begin establishing the stronger defensive cycle seen much more consistently in PvE.</p></div>
        </div>
        <div class="guide-callout"><strong>Clear limitation:</strong> Gaiya can stabilize a fight that survives the opening burst, but she cannot reliably protect a team from an opening burst that already kills it before her stronger defensive layers become available.</div>
        <p class="heket-hades-note">The speed and strength of the opposing burst are therefore important matchup factors when using Gaiya in PvP.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Build, Battle Plan &amp; Counterplay</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Winning pattern</span><h3>Survive, heal, grow Flowers, protect, and let the carry win.</h3></div>
        <div class="heket-tactics">
          <article><div class="heket-tactic-marker">Build</div><h4>Prioritize Max HP</h4><p>Max HP connects the kit. It improves Gaiya's durability while strengthening her healing and shielding mechanics. Her value comes from the defensive engine rather than personal damage.</p></article>
          <article><div class="heket-tactic-marker">Place</div><h4>Keep Gaiya active</h4><p>She must remain alive for Grace Domain, healing, and Life Flora to support the formation. Do not expose her to maximum pressure simply because she is a Tank. Protect both Gaiya and the team's actual win condition.</p></article>
          <article><div class="heket-tactic-marker">Sustain</div><h4>Do not fear useful overhealing</h4><p>Excess recovery received by Gaiya can contribute directly to Flowers of Life. Judge healing by whether it maintains this defensive cycle without consuming too many slots that the team needs for damage.</p></article>
        </div>
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Favorable fights</span><strong>Survivable burst and sustained pressure</strong><p>Gaiya performs well when the opening can be endured and the team has time to build Flowers and repeated Ultimate windows. Long encounters also let Nature's Armor increase her durability.</p></div>
          <div class="heket-matchup-bad"><span>Difficult conditions</span><strong>Immediate kills, timers, and offensive checks</strong><p>Concentrated targeting can remove an ally before the engine is established. Gaiya also cannot solve missing HIT, poor targeting, insufficient carry investment, or a timer that already expires while everyone is alive.</p></div>
        </div>
        <p class="heket-hades-note"><strong>If the team keeps losing:</strong> If the team dies immediately, improve opening survival and formation. If one hero always dies first, inspect targeting and positioning. If everyone survives but nothing dies, improve the carry, HIT, targeting, or offensive investment. If the fight reaches the timer, trade excess sustain for offense.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-verdict-box"><h3 class="guide-verdict-heading">Gaiya protects your win condition; she is not the win condition.</h3><p class="guide-verdict-text">Gaiya turns healing received beyond her own missing HP into preparation for future damage. Grace Domain supports the formation from the beginning of battle, stored overhealing creates Flowers of Life for allies in danger, and her Ultimate supplies a stabilization window through healing, team Damage Reduction, and personal Control Immunity. Nature's Armor lets her become increasingly durable over longer fights.<br><br>She is most valuable when survival is the reason the team is losing. Give her a real damage dealer to protect, keep the defensive engine active, and let her create the time that win condition needs. When everyone already survives, solve the remaining offensive problem instead of adding more sustain.</p></div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) button.addEventListener("click", () => {
        const id = button.getAttribute("data-guide-skill-button");
        for (const other of buttons) { const active = other === button; other.classList.toggle("is-active", active); other.setAttribute("aria-pressed", String(active)); }
        for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
      });
    }
  </script>
</Base>
