---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import allHeroes from "../../data/all_heroes_db.json";
import eventsData from "../../data/events.json";
import nephtysData from "../../data/heroes/nephtys.json";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const HERO_ASSET_BASE = `${R2_BASE}/heroes`;
const VIRTUE_ASSET_BASE = `${R2_BASE}/images/virtues`;
const HERO_IMAGE_VERSION = "2026-06-08-portrait";

const heroImage = (id: string) => `${HERO_ASSET_BASE}/${id}.webp`;
const heroCardImage = (id: string, width = 240) => (
  `${HERO_ASSET_BASE}/cards/${encodeURIComponent(id)}-${width}.webp?v=${HERO_IMAGE_VERSION}`
);
const heroCardSrcset = (id: string) => [240, 360]
  .map((width) => `${heroCardImage(id, width)} ${width}w`)
  .join(", ");
const skillImage = (id: string) => `/skills/nephtys_${id}.webp`;
const relicImage = () => "/skills/nephtys_relic.webp";
const virtueImage = (assetId: string, suffix: string) => `${VIRTUE_ASSET_BASE}/${assetId}${suffix}.png`;

function getHero(heroId: string) {
  const rawId = String(heroId || "");
  const lowerId = rawId.toLowerCase();
  const compactId = lowerId.replace(/[\s_-]+/g, "");
  return allHeroes[lowerId as keyof typeof allHeroes]
    ?? allHeroes[compactId as keyof typeof allHeroes]
    ?? allHeroes[rawId as keyof typeof allHeroes];
}

const skills = nephtysData.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({
    level: level.replace("level", "Lv "),
    text,
  })),
}));

const relic = {
  ...nephtysData.relic,
  badge: "Relic",
  levelBadge: "Level 1-20",
  upgrades: Object.entries(nephtysData.relic.upgrades).map(([level, text]) => ({
    level: level.replace("level", "Lv "),
    text,
  })),
};

const strengths = [
  "Team damage amplifier: Soul Harvest adds repeated AoE bursts and up to -30% Armor and M-RES on absorbed enemies",
  "Strong extended-fight scaling: secured kills steal ATK and max HP, then heal her from the fallen enemy's max HP",
  "Good disruption for a frontline Warrior: pulls the current target and highest-ATK enemy together, then stuns on collision",
  "Ultimate is hard to stop: Wraith Entanglement restrains for 5s and gives Nephtys Super Armor during the channel",
  "Works well in messy 5v5 fights where allies keep damage flowing and kills are actually available",
  "Can become difficult to remove once the first kill starts the ATK, HP, and healing loop",
];

const weaknesses = [
  "Not a solo damage dealer: her best damage comes from team damage, defense shred, and secured kills",
  "Poor fit for pure single-target damage checks where there are no side kills to feed her snowball",
  "Delayed Demise is conditional: if she cannot secure a kill during the shroud window, she still falls",
  "Needs Relic value: without Soul Harvest, she loses a large part of her defense shred and AoE identity",
  "Melee positioning exposes her before she has stacked stolen stats or healed from a kill",
  "Can look underwhelming when the team cannot secure kills or keep pressure on a focused target",
];

const synergies = [
  { id: "hephaestus", name: "Hephaestus", note: "S fit: ATK SPD, team buff, CC, Armor reduction" },
  { id: "iris", name: "Iris", note: "A+ fit: ATK SPD, team buff, CC, vulnerability" },
  { id: "set", name: "Set", note: "A+ fit: ATK SPD, team buff, Armor reduction, CC" },
  { id: "hera", name: "Hera", note: "S+ fit: ATK SPD, team buff, CC" },
  { id: "nezha", name: "Nezha", note: "S+ fit: team buff, CC, Armor reduction" },
];

const counters = [
  { id: "nyx", name: "Nyx", note: "Silence and stun disrupt her setup" },
  { id: "mengpo", name: "Mengpo", note: "Silence and Energy denial" },
  { id: "capricorn", name: "Capricorn", note: "Burst before she ramps" },
  { id: "anubis", name: "Anubis", note: "Backline dive and untargetable pressure" },
  { id: "pan", name: "Pan", note: "Energy control slows her ultimate cycle" },
  { id: "demeter", name: "Demeter", note: "High Armor can blunt her Physical kit" },
];

const virtues = [
  {
    name: "Desire",
    rarity: "Gold",
    rarityClass: "guide-virtue-rarity--epic",
    assetId: "desireI",
    assetSuffix: "_elite",
    bonuses: [
      { label: "2-Piece", text: "ATK +10% at combat start" },
      { label: "4-Piece", text: "After 15s, ATK +20%" },
    ],
    note: "Strong ATK-scaler choice. Her ultimate, Soul Harvest caps, and kill payoff all care about ATK, so Desire raises the parts of her kit that actually convert pressure.",
  },
  {
    name: "Wildness",
    rarity: "Red",
    rarityClass: "guide-virtue-rarity--legendary",
    assetId: "wildnessI",
    assetSuffix: "_legendary",
    bonuses: [
      { label: "2-Piece", text: "HP +15% at combat start" },
      { label: "4-Piece", text: "+5% ATK every 5s, max 10 stacks" },
    ],
    note: "Strong bruiser choice. The HP helps her survive the first exchange, while the delayed ATK ramp fits the longer fights where her Soul Harvest loop matters.",
  },
];

const soulLedger = [
  {
    stage: "Seed",
    title: "Start a target problem",
    copy: "Wraithbound Pull tags the current target and the highest-ATK enemy, then drags them together. It is less about burst and more about forcing the enemy carry into a bad place.",
    payoff: "Pull + stun threat",
  },
  {
    stage: "Collect",
    title: "Turn team damage into stored pressure",
    copy: "Soul Harvest watches enemy units take damage. The more consistently your team is hitting, the faster Nephtys builds toward another AoE burst.",
    payoff: "Team damage becomes her resource",
  },
  {
    stage: "Weaken",
    title: "Make focus fire stick",
    copy: "The Relic's corpse aura cuts Armor and M-RES on absorbed enemies. That is the real team value: everyone gets a softer target.",
    payoff: "Up to -30% Armor and M-RES",
  },
  {
    stage: "Claim",
    title: "Cash out on the kill",
    copy: "Once Nephtys secures a kill, Everlasting Soul turns the result into permanent ATK and HP for the fight, plus a burst of healing.",
    payoff: "Stats stolen, HP restored",
  },
];

const winConditions = [
  {
    title: "Team is dealing steady damage",
    whenTrue: "Soul Harvest fills, bursts in 3m AoE, and keeps corpse aura relevant.",
    whenFalse: "She becomes a melee Warrior waiting on a low-value personal cycle.",
  },
  {
    title: "The team can focus one target",
    whenTrue: "Wraith Entanglement's restrain and lost-HP finisher help convert pressure into a kill.",
    whenFalse: "Damage gets spread around and her execute scaling has less to cash out on.",
  },
  {
    title: "A kill is available",
    whenTrue: "Everlasting Soul steals ATK and max HP, then heals her from the fallen enemy.",
    whenFalse: "Her scaling and sustain stay mostly theoretical.",
  },
  {
    title: "The shroud window has support",
    whenTrue: "Delayed Demise buys time for Nephtys to secure the kill that lets her return.",
    whenFalse: "It only delays the death animation. Useful time, but not a real revive.",
  },
];

const kitTruths = [
  {
    number: "5s",
    label: "Bind window",
    copy: "Long enough for allies to hit the target she has pinned.",
  },
  {
    number: "3m",
    label: "Burst area",
    copy: "Soul Harvest and the ultimate knockdown both reward grouped enemies.",
  },
  {
    number: "30%",
    label: "Defense shred",
    copy: "Relic Lv4 turns absorbed enemies into better targets for the whole team.",
  },
  {
    number: "7s",
    label: "Max shroud",
    copy: "The window to secure a kill before Delayed Demise fails.",
  },
];

const guideRatings = [
  { label: "PvP", value: "B" },
  { label: "PvE", value: "C" },
  { label: "F2P", value: "B" },
  { label: "Late", value: "C" },
];

const aresComparison = [
  {
    label: "Main job",
    nephtys: "Turns team damage into Soul Harvest bursts, defense shred, and kill-based scaling.",
    ares: "Forces a direct melee brawl with AoE damage, Armor reduction, and personal survival.",
    takeaway: "Nephtys converts team pressure. Ares creates pressure by standing in the fight.",
  },
  {
    label: "Survival window",
    nephtys: "Delayed Demise delays falling, but she needs to secure a kill during the shroud to return.",
    ares: "Unyielding Will blocks his first lethal hit and gives a fixed immunity window.",
    takeaway: "Nephtys has a conditional comeback. Ares has a simpler emergency button.",
  },
  {
    label: "Defense break",
    nephtys: "Relic Lv4 can cut Armor and M-RES by 30% on absorbed enemies.",
    ares: "Flesh Grinder cuts Armor, reaching 25% at Lv4.",
    takeaway: "Nephtys helps mixed-damage teams more. Ares is mainly Physical pressure.",
  },
  {
    label: "Kill payoff",
    nephtys: "Secured kills steal ATK and max HP, then heal her from the fallen enemy.",
    ares: "Relic can add shields on kills during Battlefield Storm, while low HP raises his ATK.",
    takeaway: "Both like kills, but Nephtys snowballs through stats while Ares stabilizes the brawl.",
  },
];

const modeFit = [
  {
    label: "Use her",
    title: "Odyssey and Arena",
    copy: "These are the places where her team-fed pressure, pull, shroud window, and kill snowball can actually matter.",
    tone: "good",
  },
  {
    label: "Investment",
    title: "Relic 1-20 is enough",
    copy: "If you build her at all, she does not look like a hero that needs to be forced past Relic 20 for the main job.",
    tone: "neutral",
  },
  {
    label: "Avoid",
    title: "Club Spire",
    copy: "She has a bad time there because Momus and Khepri already cover the kind of frontline utility you usually want.",
    tone: "bad",
  },
  {
    label: "Avoid",
    title: "Main Spire",
    copy: "Do not plan around her here. High-pressure stages can delete her before her delayed value turns on.",
    tone: "bad",
  },
];

const nephtysEvent = eventsData.campaigns.find((campaign) => campaign.id === "nephtys-event");
const eventPreviewStages = nephtysEvent?.stages.slice(0, 3).map((stage) => ({
  id: stage.id,
  name: stage.name.en,
  front: stage.composition.front.map((heroId) => getHero(heroId)).filter(Boolean),
  back: stage.composition.back.map((heroId) => getHero(heroId)).filter(Boolean),
})) ?? [];
---

<Base
  title="Nephtys Guide - Soul Harvest Bruiser | Motto Immortal"
  description="Complete hero guide for Nephtys: team-dependent bruiser role, skill breakdown, Soul Harvest engine, synergies, counters, gear stats, and virtues."
>
  <!-- BANNER -->
  <div class="guide-banner">
    <div
      class="guide-banner-bg"
      style={`background-image: url('${heroImage("nephtys")}'); background-position: center 18%;`}
    ></div>
    <div class="guide-banner-overlay"></div>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Nephtys</h1>
      <p class="guide-hero-subtitle">Soul Harvest Bruiser.</p>
      <div class="guide-badge-row">
        <span class="guide-badge">
          <img
            class="guide-badge-icon"
            src={`${R2_BASE}/icons/factions/spades.webp`}
            alt="Spades"
          />
          Spades
        </span>
        <span class="guide-badge">
          <img
            class="guide-badge-icon"
            src={`${R2_BASE}/icons/classes/warrior.webp`}
            alt="Warrior"
          />
          Warrior
        </span>
        <span class="guide-badge">{nephtysData.role}</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <!-- BODY -->
  <div class="guide-body">

    <!-- QUICK OVERVIEW -->
    <section class="guide-section">
      <h2 class="guide-section-title">Quick Overview</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">A bruiser who wins through the team</h3>
        <div class="guide-overview-grid">
          <div class="guide-overview-item">
            <div class="guide-overview-label">Role</div>
            <div class="guide-overview-value">Scaling Bruiser / Debuffer</div>
          </div>
          <div class="guide-overview-item">
            <div class="guide-overview-label">Best in</div>
            <div class="guide-overview-value">Odyssey, Arena, event fights</div>
          </div>
          <div class="guide-overview-item">
            <div class="guide-overview-label">Needs</div>
            <div class="guide-overview-value">Relic, team damage, kill pressure</div>
          </div>
          <div class="guide-overview-item">
            <div class="guide-overview-label">Avoid</div>
            <div class="guide-overview-value">Club Spire, Main Spire, high-pressure stages</div>
          </div>
        </div>
        <p class="guide-quick-verdict">
          Nephtys is not built to carry a fight by raw single-target damage. Her value comes from
          softening enemies, turning the team's damage into Soul Harvest bursts, disrupting the enemy
          carry, and snowballing when kills happen. Put simply: she wants a team that is already
          creating pressure, then she makes that pressure harder to survive.
        </p>
        <div class="nephtys-rating-grid" aria-label="Nephtys ratings">
          {guideRatings.map((rating) => (
            <div class="nephtys-rating-tile" data-rating={rating.value}>
              <span>{rating.label}</span>
              <strong>{rating.value}</strong>
            </div>
          ))}
        </div>
        <p class="guide-math-footnote">
          First-impression guide ratings based on her current project skill data and early combat notes.
        </p>
      </div>
    </section>

    <!-- MODE FIT -->
    <section class="guide-section">
      <h2 class="guide-section-title">Where to Use Her</h2>
      <div class="guide-card nephtys-mode-card">
        <h3 class="guide-card-heading">Good in selected team fights, weak as a Spire answer</h3>
        <p class="guide-card-subheading">
          Nephtys is not a general progression carry. Use her where fights give her time to convert
          team pressure into kills, and skip her where enemies open too hard or better frontline tools
          are already available.
        </p>

        <div class="nephtys-mode-grid">
          {modeFit.map((item) => (
            <div class={`nephtys-mode-item nephtys-mode-item--${item.tone}`}>
              <span>{item.label}</span>
              <strong>{item.title}</strong>
              <p>{item.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- EVENT PREVIEW -->
    <section class="guide-section">
      <h2 class="guide-section-title">Event Preview</h2>
      <div class="guide-card nephtys-event-card">
        <h3 class="guide-card-heading">First 3 playable fights</h3>
        <p class="guide-card-subheading">
          These are the event compositions currently visible from the Nephtys event page.
        </p>

        <div class="nephtys-event-grid">
          {eventPreviewStages.map((stage) => (
            <div class="nephtys-event-stage">
              <div class="nephtys-event-stage-title">{stage.name}</div>
              <div class="nephtys-event-row">
                <span>Front</span>
                <div class="nephtys-event-heroes">
                  {stage.front.map((hero) => (
                    <a class="nephtys-event-hero" href={`/heroes/${hero.id}`}>
                      <img
                        src={heroCardImage(hero.id, 240)}
                        srcset={heroCardSrcset(hero.id)}
                        sizes="(max-width: 480px) 42vw, (max-width: 768px) 28vw, 96px"
                        alt={hero.name}
                        loading="lazy"
                        decoding="async"
                      />
                      <strong>{hero.name}</strong>
                    </a>
                  ))}
                </div>
              </div>
              <div class="nephtys-event-row">
                <span>Back</span>
                <div class="nephtys-event-heroes">
                  {stage.back.map((hero) => (
                    <a class="nephtys-event-hero" href={`/heroes/${hero.id}`}>
                      <img
                        src={heroCardImage(hero.id, 240)}
                        srcset={heroCardSrcset(hero.id)}
                        sizes="(max-width: 480px) 42vw, (max-width: 768px) 28vw, 96px"
                        alt={hero.name}
                        loading="lazy"
                        decoding="async"
                      />
                      <strong>{hero.name}</strong>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SOUL LEDGER -->
    <section class="guide-section">
      <h2 class="guide-section-title">Soul Ledger</h2>
      <div class="guide-card nephtys-ledger-card">
        <div class="nephtys-ledger-intro">
          <div>
            <h3 class="guide-card-heading">She keeps account of the fight</h3>
            <p class="guide-card-subheading">Nephtys is easier to understand as a ledger than as a rotation. The team creates debt on the enemy side; she collects it through Soul Harvest, defense shred, and secured kills.</p>
          </div>
          <div class="nephtys-ledger-summary">
            <span>Core idea</span>
            <strong>Pressure in, souls out</strong>
          </div>
        </div>

        <div class="nephtys-ledger-flow">
          {soulLedger.map((item) => (
            <div class="nephtys-ledger-step">
              <div class="nephtys-ledger-stage">{item.stage}</div>
              <h4>{item.title}</h4>
              <p>{item.copy}</p>
              <div class="nephtys-ledger-payoff">{item.payoff}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WIN CONDITIONS -->
    <section class="guide-section">
      <h2 class="guide-section-title">Win Conditions</h2>
      <div class="guide-card nephtys-contract-card">
        <h3 class="guide-card-heading">Her power has conditions attached</h3>
        <p class="guide-card-subheading">This is the part that matters for team-building. Nephtys is strong when her conditions are met, and very ordinary when they are not.</p>

        <div class="nephtys-contract-grid">
          {winConditions.map((condition) => (
            <div class="nephtys-contract">
              <h4>{condition.title}</h4>
              <div class="nephtys-contract-row nephtys-contract-row--good">
                <span>When true</span>
                <p>{condition.whenTrue}</p>
              </div>
              <div class="nephtys-contract-row nephtys-contract-row--bad">
                <span>When false</span>
                <p>{condition.whenFalse}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="nephtys-truth-strip">
          {kitTruths.map((truth) => (
            <div class="nephtys-truth">
              <div class="nephtys-truth-number">{truth.number}</div>
              <div>
                <strong>{truth.label}</strong>
                <p>{truth.copy}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="nephtys-matchup-note">
          <div>
            <span>Guide takeaway</span>
            <strong>Do not ask her to be the whole damage plan.</strong>
          </div>
          <p>
            Bring her when your team can already create pressure, group enemies, or finish low targets.
            Avoid treating her as the answer to a pure single-target check, because the kit is built around
            conversion and cleanup rather than raw solo output.
          </p>
        </div>
      </div>
    </section>

    <!-- ARES LENS -->
    <section class="guide-section">
      <h2 class="guide-section-title">Ares Lens</h2>
      <div class="guide-card nephtys-compare-card">
        <div class="nephtys-compare-intro">
          <div>
            <h3 class="guide-card-heading">The closest role comparison is Ares</h3>
            <p class="guide-card-subheading">
              Nephtys and Ares share enough DNA that the comparison is useful: melee presence,
              Armor pressure, a lethal-damage safety window, and extra value when kills happen.
              The difference is where the pressure comes from.
            </p>
          </div>
          <div class="nephtys-compare-snapshot">
            <div class="nephtys-compare-hero">
              <img
                src={heroCardImage("nephtys", 240)}
                srcset={heroCardSrcset("nephtys")}
                sizes="72px"
                alt="Nephtys"
                loading="lazy"
                decoding="async"
              />
              <span>Nephtys</span>
              <strong>Team converter</strong>
            </div>
            <div class="nephtys-compare-vs">vs</div>
            <div class="nephtys-compare-hero">
              <img
                src={heroCardImage("ares", 240)}
                srcset={heroCardSrcset("ares")}
                sizes="72px"
                alt="Ares"
                loading="lazy"
                decoding="async"
              />
              <span>Ares</span>
              <strong>Self brawler</strong>
            </div>
          </div>
        </div>

        <div class="nephtys-compare-grid">
          {aresComparison.map((row) => (
            <div class="nephtys-compare-row">
              <div class="nephtys-compare-label">{row.label}</div>
              <div>
                <span>Nephtys</span>
                <p>{row.nephtys}</p>
              </div>
              <div>
                <span>Ares</span>
                <p>{row.ares}</p>
              </div>
              <strong>{row.takeaway}</strong>
            </div>
          ))}
        </div>

        <div class="nephtys-matchup-note">
          <div>
            <span>Decision point</span>
            <strong>Use the comparison to pick the job, not the winner.</strong>
          </div>
          <p>
            If the team needs a simple frontliner who brings his own brawl window, Ares is the cleaner idea.
            If the team already deals damage and needs that pressure converted into shred, control, and
            snowball value, Nephtys is the more interesting fit.
          </p>
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section class="guide-section">
      <h2 class="guide-section-title">Skills</h2>
      <div class="guide-skills-grid">
        {skills.map((skill) => (
          <div class="guide-skill-card">
            <div class="guide-skill-header">
              <div
                class="guide-skill-icon"
                style={`background-image: url('${skillImage(skill.id)}');`}
                role="img"
                aria-label={skill.name}
              ></div>
              <div class="guide-skill-meta">
                <div class="guide-skill-name">{skill.name}</div>
                <span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>
                  {skill.badge}
                </span>
              </div>
            </div>
            <p class="guide-skill-desc">{skill.description}</p>
            <div class="guide-skill-upgrades">
              {skill.upgrades.map((u) => (
                <div class="guide-upgrade">
                  <span class="guide-upgrade-chip">{u.level}</span>
                  <span class="guide-upgrade-text">{u.text}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="guide-skill-card guide-skill-card--relic">
        <div>
          <div class="guide-skill-header">
            <div
              class="guide-skill-icon"
              style={`background-image: url('${relicImage()}');`}
              role="img"
              aria-label={relic.name}
            ></div>
            <div class="guide-skill-meta">
              <div class="guide-skill-name">{relic.name}</div>
              <div class="guide-relic-badges">
                <span class="guide-skill-badge guide-skill-badge--relic">{relic.badge}</span>
                <span class="guide-skill-badge guide-skill-badge--level">{relic.levelBadge}</span>
              </div>
            </div>
          </div>
        </div>
        <div>
          <p class="guide-skill-desc">{relic.description}</p>
          <div class="guide-skill-upgrades guide-skill-upgrades--relic">
            {relic.upgrades.map((u) => (
              <div class="guide-upgrade guide-upgrade--relic">
                <span class="guide-upgrade-chip">{u.level}</span>
                <span class="guide-upgrade-text">{u.text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- STRENGTHS & WEAKNESSES -->
    <section class="guide-section">
      <h2 class="guide-section-title">Strength &amp; Weaknesses</h2>
      <StrengthWeakness strengths={strengths} weaknesses={weaknesses} />
    </section>

    <!-- SYNERGIES -->
    <section class="guide-section">
      <h2 class="guide-section-title">Synergies</h2>
      <div class="guide-hero-grid">
        {synergies.map((hero) => (
          <div class="guide-hero-card">
            <div
              class="guide-hero-portrait"
              style={`background-image: url('${heroCardImage(hero.id, 240)}');`}
              role="img"
              aria-label={hero.name}
            ></div>
            <div class="guide-hero-card-name">{hero.name}</div>
            <div class="guide-hero-card-note">{hero.note}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- SHUT DOWN BY -->
    <section class="guide-section">
      <h2 class="guide-section-title">Shut Down By</h2>
      <div class="guide-hero-grid">
        {counters.map((hero) => (
          <div class="guide-hero-card">
            <div
              class="guide-hero-portrait"
              style={`background-image: url('${heroCardImage(hero.id, 240)}');`}
              role="img"
              aria-label={hero.name}
            ></div>
            <div class="guide-hero-card-name">{hero.name}</div>
            <div class="guide-hero-card-note">{hero.note}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- GEAR & STATS -->
    <section class="guide-section">
      <h2 class="guide-section-title">Gear &amp; Stats</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Build for uptime and survival, then ATK</h3>
        <p class="guide-card-subheading">She needs to stay alive long enough for Soul Harvest, secured kills, and her shroud window to matter.</p>
        <div class="guide-stat-chain">
          <span class="guide-stat-pill guide-stat-pill--primary">Energy / Haste</span>
          <span class="guide-stat-sep">&gt;</span>
          <span class="guide-stat-pill guide-stat-pill--primary">HP%</span>
          <span class="guide-stat-sep">&gt;</span>
          <span class="guide-stat-pill guide-stat-pill--primary">ATK %</span>
          <span class="guide-stat-sep">&gt;</span>
          <span class="guide-stat-pill">Armor / M-RES</span>
          <span class="guide-stat-sep">&gt;</span>
          <span class="guide-stat-pill">Control Res</span>
          <span class="guide-stat-sep">&gt;</span>
          <span class="guide-stat-pill">Crit</span>
        </div>
        <div class="guide-callout">
          ATK is still important because many of her caps scale from it, but she should not be built like a
          pure carry. Her best fights are the ones where she gets a second and third round of value.
        </div>
      </div>
    </section>

    <!-- VIRTUES -->
    <section class="guide-section">
      <h2 class="guide-section-title">Virtues</h2>
      <div class="guide-virtue-grid">
        {virtues.map((v) => (
          <div class="guide-virtue-card">
            <div class="guide-virtue-header">
              <div
                class="guide-virtue-icon"
                style={`background-image: url('${virtueImage(v.assetId, v.assetSuffix)}');`}
                role="img"
                aria-label={v.name}
              ></div>
              <div>
                <div class="guide-virtue-name">{v.name}</div>
                <span class={`guide-virtue-rarity ${v.rarityClass}`}>{v.rarity}</span>
              </div>
            </div>
            <div class="guide-virtue-bonuses">
              {v.bonuses.map((b) => (
                <div class="guide-virtue-bonus">
                  <div class="guide-virtue-bonus-label">{b.label}</div>
                  <div class="guide-virtue-bonus-text">{b.text}</div>
                </div>
              ))}
            </div>
            <p class="guide-virtue-note">{v.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- VERDICT -->
    <section class="guide-section">
      <h2 class="guide-section-title">Verdict</h2>
      <div class="guide-verdict-box">
        <h3 class="guide-verdict-heading">Strong foundation, but not a solo carry</h3>
        <p class="guide-verdict-text">
          Nephtys is best understood as a bruiser-enabler. She brings pull disruption, a long bind,
          defense shred through Relic, team-fed AoE damage, and a kill-based snowball. That makes her
          attractive in longer team fights where pressure is constant and kills happen. The warning is
          just as important: she does not solve pure single-target damage checks on her own, and her
          revive mechanic is not automatic. Build around the team first, then let Nephtys turn that team
          pressure into a fight that is harder and harder for the enemy to stabilize.
        </p>
      </div>
    </section>

  </div>

  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
</Base>
