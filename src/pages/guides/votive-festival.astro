---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import "../../styles/components.css";
import votiveGameplay from "../../../newData/votivegameplay.png";

const FEATURE_ASSET_BASE = "/features/gold-miner/assets";

const icon = (name: string) => `${FEATURE_ASSET_BASE}/icons/${name}`;
const ui = (name: string) => `${FEATURE_ASSET_BASE}/ui/${name}`;

const overview = [
  { label: "Play", value: "Tap when the hook points at the lantern you want" },
  { label: "Cost", value: "One ticket only when you collect a lantern" },
  { label: "Best target", value: "The Reward Lantern with the paper crane" },
  { label: "Time", value: "30 seconds; a clean miss is free" },
];

const chests = [
  {
    name: "Big Lantern",
    art: "A_UI_GoldMiner_Material_Lantern01_Img.png",
    payout: "1 Festival Coin",
    tone: "ga-chest--worst",
    note: "The plain round lantern pays the fewest coins.",
  },
  {
    name: "Middle Lantern",
    art: "A_UI_GoldMiner_Material_Lantern02_Img.png",
    payout: "2 Festival Coins",
    tone: "ga-chest--mid",
    note: "The middle-value coin lantern.",
  },
  {
    name: "Small Lantern",
    art: "A_UI_GoldMiner_Material_Lantern03_Img.png",
    payout: "3 Festival Coins",
    tone: "ga-chest--good",
    note: "The ornate lantern gives the best coin payout.",
  },
  {
    name: "Reward Lantern",
    art: "A_UI_GoldMiner_Material_Lantern04_Img.png",
    payout: "Pick your reward",
    tone: "ga-chest--best",
    note: "The paper crane gives a selectable reward instead of coins.",
  },
];

const steps = [
  {
    img: votiveGameplay.src,
    focus: "launcher",
    title: "The launcher swings",
    body: "A firework hook pivots at the bottom of the board and swings like a pendulum, sweeping the same arc from one side to the other. Its angle is your aim.",
  },
  {
    img: ui("A_UI_GoldMiner_Help01_Img.png"),
    focus: "aim",
    title: "Fire on the beat",
    body: "Tap to shoot the hook straight out along whatever angle it points. The shot is fast and does not curve, so the whole skill is releasing when the line lands on the lantern you want.",
  },
  {
    img: votiveGameplay.src,
    focus: "targets",
    title: "First lantern ends it",
    body: "The hook grabs the first lantern its head touches, wanted or not, and that collection ends the run. If it touches nothing, it returns and you can fire again without losing a ticket.",
  },
];

const shopTiers = [
  {
    rank: 1,
    title: "Crafting materials",
    verdict: "The best value in the shop. Whether it opens this cycle depends on saved tickets, quests and any event-specific starting bonus.",
    rows: [
      { name: "Apotheosis Elixir x50", cost: 75, gate: 150 },
      { name: "Genesis Elixir x100", cost: 60, gate: 150 },
    ],
  },
  {
    rank: 2,
    title: "Totem keys & Star Chest",
    verdict: "Totem keys drop in amount each row, so buy top down. The Star Chest is a solid one-off.",
    rows: [
      { name: "Totem Keys x10", cost: 50, gate: 200 },
      { name: "Totem Keys x8", cost: 50, gate: 200 },
      { name: "Totem Keys x7", cost: 50, gate: 200 },
      { name: "Totem Keys x5", cost: 50, gate: 200 },
      { name: "Star Chest x20", cost: 80, gate: 150 },
    ],
  },
  {
    rank: 3,
    title: "Gear upgrades",
    verdict: "Worth clearing once the tiers above are done. Awakening, refining and artifact hammers all push gear power.",
    rows: [
      { name: "Equipment Awakening Selector", cost: 100, gate: 400 },
      { name: "Yellow Refining Stone x5", cost: 100, gate: 400 },
      { name: "Hammer Artifact Enhancement Stone x10", cost: 100, gate: 400 },
      { name: "Hammer Artifact Enhancement Stone x5", cost: 100, gate: 400 },
    ],
  },
  {
    rank: 4,
    title: "Heroes & Plumes",
    verdict: "This cycle's headline pulls. Heroes are worthwhile when they improve your roster; otherwise keep the coins for stronger materials.",
    rows: [
      { name: "Poseidon", cost: 50, gate: 100, hero: "poseidon" },
      { name: "Athena", cost: 50, gate: 100, hero: "athena" },
      { name: "Diana", cost: 50, gate: 100, hero: "diana" },
      { name: "Yanluo", cost: 50, gate: 100, hero: "yanluo" },
      { name: "Hero Selector Card", cost: 100, gate: 150 },
      { name: "Plumes x10", cost: 30, gate: 0 },
      { name: "Plumes x8", cost: 30, gate: 0 },
      { name: "Plumes x7", cost: 30, gate: 0 },
      { name: "Plumes x5", cost: 30, gate: 0 },
    ],
  },
  {
    rank: 5,
    title: "Everything else",
    verdict: "Cheap top-ups. Clear these with whatever coins are left at the end of the cycle.",
    rows: [
      { name: "8h Upgrade Mats Pack", cost: 10, gate: 0 },
      { name: "8h Gold Pack", cost: 10, gate: 0 },
      { name: "8h Orison EXP Pack", cost: 10, gate: 0 },
      { name: "8h Evolution Mandala", cost: 10, gate: 0 },
      { name: "2h Upgrade Mats Selector x5", cost: 5, gate: 0 },
      { name: "2h Upgrade Mats Selector x4", cost: 5, gate: 0 },
      { name: "2h Upgrade Mats Selector x3", cost: 5, gate: 0 },
      { name: "2h Upgrade Mats Selector x2", cost: 5, gate: 0 },
    ],
  },
];

const rankRows = [
  { rank: "1", solvent: 50, plumes: 20 },
  { rank: "2", solvent: 45, plumes: 15 },
  { rank: "3", solvent: 40, plumes: 10 },
  { rank: "4 - 10", solvent: 35, plumes: 10 },
  { rank: "11 - 20", solvent: 25, plumes: 9 },
  { rank: "21 - 50", solvent: 18, plumes: 8 },
  { rank: "51 - 100", solvent: 14, plumes: 7 },
  { rank: "101 - 200", solvent: 12, plumes: 6 },
  { rank: "201 - 500", solvent: 10, plumes: 4 },
  { rank: "501 - 1000", solvent: 9, plumes: 2 },
  { rank: "1001 - 2000", solvent: "8 to 7", plumes: 0 },
  { rank: "2001 - 5000", solvent: "6 to 4", plumes: 0 },
  { rank: "5001 - 10000", solvent: "3 to 2", plumes: 0 },
  { rank: "10001+", solvent: 1, plumes: 0 },
];

const selfSelect = [
  { item: "Eternity Elixir", qty: "x2", best: true },
  { item: "Apotheosis Elixir", qty: "x3", best: true },
  { item: "Genesis Elixir", qty: "x5", best: false },
  { item: "Epic Deity Shard", qty: "x10", best: true },
  { item: "Calamity's Tear", qty: "x20", best: false },
  { item: "Plumes", qty: "x1", best: false },
];
---

<Base
  title="Votive Festival Guide | Motto Immortal"
  description="Votive Festival guide for Motto Immortal: how the swinging firework hook works, how to collect the Reward Lantern, and what to buy with Festival Coins."
>
  <div class="ga-parallax ga-parallax--goldminer">
    <div class="ga-hero-media" aria-hidden="true">
      <div class="ga-hero-backdrop"></div>
      <img src={ui("A_UI_GoldMiner_Help01_Img.png")} alt="" fetchpriority="high" />
    </div>
    <div class="ga-hero-stage">
      <div class="ga-hero-text">
        <span class="ga-hero-tag">Feature Guide</span>
        <h1 class="ga-hero-headline">Votive Festival</h1>
        <p class="ga-hero-sub">Time the swing, collect the best lantern and spend your Festival Coins wisely.</p>
      </div>
    </div>

    <div class="ga-body-bg">
      <div class="guide-body guide-body--arcanum">
        <section class="guide-section">
          <h2 class="guide-section-title">Quick Read</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">What you need to know</h3>
            <p class="guide-card-subheading">
              Tap to fire the swinging hook. The first lantern it touches is your reward. If the hook misses everything, you can try again for free.
            </p>
            <div class="guide-overview-grid">
              {overview.map((item) => (
                <div class="guide-overview-item">
                  <div class="guide-overview-label">{item.label}</div>
                  <div class="guide-overview-value">{item.value}</div>
                </div>
              ))}
            </div>
            <div class="ga-verdict-split">
              <div class="ga-verdict">
                <span class="ga-verdict-who">Early game</span>
                <p>Buy a featured hero only if it improves your team. Otherwise save your coins for upgrade materials.</p>
              </div>
              <div class="ga-verdict ga-verdict--alt">
                <span class="ga-verdict-who">Everyone else</span>
                <p>Target the paper-crane Reward Lantern, then use its free reset to get a new board.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="guide-section">
          <h2 class="guide-section-title">How A Run Works</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">You time a swinging hook, you do not steer it</h3>
            <p class="guide-card-subheading">
              Wait until the hook points at your target, then tap. On faster boards, tap slightly early. Collecting a lantern uses one
              ticket and adds one to your craft count, which unlocks shop items.
            </p>
            <div class="ga-steps ga-steps--votive-live">
              {steps.map((step, index) => (
                <article class={`ga-step ga-step--${step.focus}`}>
                  <img src={step.img} alt="" loading="lazy" />
                  <div class="ga-step-text">
                    <span class="ga-step-num">{index + 1}</span>
                    <h4>{step.title}</h4>
                    <p>{step.body}</p>
                  </div>
                </article>
              ))}
            </div>
            <div class="guide-callout">
              The Reward Lantern has a paper crane. It gives a selectable reward instead of Festival Coins and unlocks a free board
              reset. Take it first, reset, and look for the next one.
            </div>
          </div>
        </section>

        <section class="guide-section">
          <h2 class="guide-section-title">Lanterns</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">Bigger lantern, smaller payout</h3>
            <p class="guide-card-subheading">
              Small lanterns pay the most coins. The paper-crane Reward Lantern gives a selectable reward instead.
            </p>
            <div class="ga-chest-grid">
              {chests.map((chest) => (
                <article class={`ga-chest ${chest.tone}`}>
                  <img src={icon(chest.art)} alt={`${chest.name} art`} loading="lazy" />
                  <h4>{chest.name}</h4>
                  <strong>{chest.payout}</strong>
                  <p>{chest.note}</p>
                </article>
              ))}
            </div>
            <div class="guide-callout">
              Priority: Reward Lantern → Small → Middle → Big. Use the free reset as soon as you collect the Reward Lantern.
            </div>
            <p class="ga-select-intro">
              The selectable reward offers one item. Some choices unlock as your account progresses.
            </p>
            <div class="ga-select-list">
              {selfSelect.map((entry) => (
                <div class={`ga-select-row${entry.best ? " ga-select-row--best" : ""}`}>
                  <span class="ga-select-item">{entry.item}</span>
                  <span class="ga-select-qty">{entry.qty}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="guide-section">
          <h2 class="guide-section-title">Rank Rewards</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">Do not overspend for rank</h3>
            <p class="guide-card-subheading">
              Stop when reaching the next reward bracket would cost more tickets than the extra rewards are worth.
            </p>
            <div class="ga-zone-table-wrap">
              <table class="ga-zone-table ga-rank-table">
                <thead>
                  <tr>
                    <th>Rank</th>
                    <th>Universal Solvent</th>
                    <th>Plumes</th>
                  </tr>
                </thead>
                <tbody>
                  {rankRows.map((row) => (
                    <tr>
                      <td class="ga-rank-pos">{row.rank}</td>
                      <td class="ga-weight ga-rank-conch">{row.solvent}</td>
                      <td class={row.plumes ? "ga-weight" : "ga-rank-none"}>{row.plumes || "-"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="guide-section">
          <h2 class="guide-section-title">The Shop</h2>
          <div class="guide-card">
            <h3 class="guide-card-heading">Buy in value order, best first</h3>
            <p class="guide-card-subheading">
              New players can buy a featured hero if it improves their team. Otherwise, prioritize elixirs, Totem Keys and the Star
              Chest, then gear materials. Coins and unused tickets carry over, so you do not need to spend them immediately.
            </p>
            <div class="ga-shop">
              {shopTiers.map((tier) => (
                <section class={`ga-shop-group${tier.rank === 1 ? " ga-shop-group--top" : ""}`}>
                  <header class="ga-shop-head">
                    <span class="ga-shop-rank">{tier.rank}</span>
                    <h4>{tier.title}</h4>
                  </header>
                  <p class="ga-shop-verdict">{tier.verdict}</p>
                  <ul class="ga-shop-rows">
                    {tier.rows.map((row) => (
                      <li class="ga-shop-row">
                        <span class="ga-shop-item">
                          {row.hero ? <a href={`/heroes/${row.hero}`}>{row.name}</a> : row.name}
                        </span>
                        <span class="ga-shop-meta">
                          <span class="ga-gate">
                            {row.gate > 0 ? `${row.gate} crafts` : "no gate"}
                          </span>
                          <span class="ga-shop-cost">{row.cost}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>

            <div class="ga-trap">
              <span class="ga-trap-kicker">Simple saving rule</span>
              <h4>Save when the next useful item is out of reach</h4>
              <p>
                Festival Coins and unused tickets carry over, but your craft count resets. Save your resources for a later event if
                you cannot reach the next useful shop unlock this time.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
</Base>
