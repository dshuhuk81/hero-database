---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import StrengthWeakness from "../../components/StrengthWeakness.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";
import zaojunData from "../../data/heroes/zaojun.json";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const heroImage = (id: string) => `${R2_BASE}/heroes/${id}.webp`;
const skillImage = (id: string) => `${R2_BASE}/skills/zaojun_${id}.webp`;

const takeaways: Record<string, string> = {
  skill_1: "This is her main source of damage. Whenever an ally uses Energy, Zaojun stores part of it as Hearthfires. Repeated smaller Energy costs count as well as one large cost. More Hearthfires add more hits, but a partially charged Ultimate can still pressure an entire formation. When the Ultimate begins, its Hearthfires are set aside and the storage opens again. Energy used by allies during the animation therefore starts charging her next Ultimate.",
  skill_2: "Feast of Warding heals the frontmost allied unit before ricocheting to enemy units. Its damage scales with that front-row ally's ATK and Max HP. Positioning matters: its healing recipient is not necessarily the Fire Pact partner. Treat its damage as a supplement to her Ultimate.",
  skill_3: "Zaojun never performs Normal Attacks. Instead, she regularly gains personal Energy and increases her ATK. Attack Speed and effects that require Normal Attacks therefore have very little value on her.",
  skill_4: "The allied unit with the highest HP becomes her Fire Pact partner, and summons can receive the pact. The partner gains DMG RED and continuously sacrifices their own HP to keep Zaojun's HP no lower than their own. A summon taking the pact can also keep its stronger Hearthfire benefit away from an ally who regularly uses Energy. Keep healing and protection available for the partner as well as Zaojun.",
};

const skills = zaojunData.skills.map((skill) => ({
  ...skill,
  badge: skill.isUltimate ? "Skill 1 - Ultimate" : `Skill ${skill.id.replace("skill_", "")}`,
  takeaway: takeaways[skill.id],
  upgrades: Object.entries(skill.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
}));

const relic = {
  ...zaojunData.relic,
  upgrades: Object.entries(zaojunData.relic.upgrades).map(([level, text]) => ({ level: level.replace("level", "Lv "), text })),
};

const strengths = [
  "Ultimate provides the bulk of her damage and can make her the team's main carry",
  "Turns allied Energy spending into additional Ultimate hits",
  "Can attack a full enemy formation or repeatedly pressure one persistent boss",
  "Can start charging her next Ultimate while the current one is still playing",
  "A partially charged Ultimate can still make a meaningful contribution",
  "Grants the Fire Pact-bound ally substantial DMG RED",
  "Heals the frontmost allied unit and adds ricochet damage against enemy units",
  "Relic investment turns her damage into healing for the Fire Pact-bound ally",
  "Builds personal Energy and ATK without relying on Normal Attacks",
];

const weaknesses = [
  "No Normal Attacks, making Attack Speed and Normal-Attack effects poor investments",
  "A lightly charged Ultimate has fewer attacks even though it can still be useful",
  "The allied unit with the highest HP is selected automatically, so an unintended Deity or summon may receive Fire Pact",
  "A bound summon that does not use Energy can reduce how quickly she builds Hearthfires",
  "The Fire Pact partner sacrifices their own HP to support Zaojun and can become vulnerable without sustain",
  "Focused healing may not save the Fire Pact-bound ally from concentrated burst damage",
  "Scattered enemies reduce the value of her Ultimate's area damage",
  "Energy drain, anti-heal, heavy early damage, and control can delay or prevent her most important attack",
  "Provides no team-wide Shield, Cleanse, strong disabling effect, or Energy restoration for the whole team",
];
---

<Base title="Zaojun Guide - Hearthfire Ultimate & Fire Pact | Motto Immortal" description="Complete Zaojun guide covering Hearthfires, her Ultimate, Fire Pact partner selection, relic investment, positioning, builds, strengths, weaknesses, and practical combat advice.">
  <div class="guide-banner guide-banner--hearts">
    <div class="guide-banner-bg" style={`background-image: url('${heroImage("zaojun")}'); --guide-banner-y: 12%;`}></div>
    <div class="guide-banner-overlay"></div>
    <a class="guide-back" href="/guides"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg><span>Guides</span></a>
    <p class="guide-meta-label">Motto Immortal &middot; Hero Guide</p>
    <div class="guide-banner-content">
      <h1 class="guide-hero-name">Zaojun</h1>
      <p class="guide-hero-subtitle">Hearthfire Carry &middot; Focused Support</p>
      <div class="guide-badge-row">
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/factions/hearts.webp`} alt="Hearts" />Hearts</span>
        <span class="guide-badge"><img class="guide-badge-icon" src={`${R2_BASE}/icons/classes/archer.webp`} alt="Archer" />Archer</span>
        <span class="guide-badge guide-badge--legendary">Legendary</span>
      </div>
    </div>
  </div>

  <div class="guide-body guide-body--heket guide-body--hearts">
    <GuideSectionNav />

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Zaojun at a Glance</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-verdict">
        <div class="heket-verdict-main">
          <div class="heket-verdict-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Zaojun's Ultimate"></div>
          <div><span class="heket-verdict-kicker">Team-building verdict</span><h3>Build the team to keep her fireworks coming.</h3><p>Zaojun is the Goddess of Blessings and Virtuous Reckoning, expressed in battle as a Hearts Archer who mixes heavy Ultimate damage with focused healing and protection. She turns the Energy used by her allies into Hearthfires for additional hits, grants one high-HP ally DMG RED, and receives HP support from that ally through Fire Pact. She also becomes stronger as the battle continues. Unlike a traditional Archer, she does not rely on Normal Attacks; unlike a traditional support, most of her help is focused on one ally rather than the whole team.</p></div>
        </div>
        <div class="heket-fact-strip"><div><span>Role</span><strong>Damage and focused support</strong></div><div><span>Core resource</span><strong>Hearthfires</strong></div><div><span>Best fit</span><strong>Fast-casting teams</strong></div></div>
        <div class="heket-verdict-warning"><strong>Key warning</strong><span>She cannot perform Normal Attacks. Attack Speed and effects that require Normal Attacks do not support her actual damage plan.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">The Firework Engine</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-engine">
        <div class="heket-engine-flow">
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_4")}');`} role="img" aria-label="Fire Pact"></div><span>Protect</span><strong>Form a pact with the highest-HP ally</strong><p>The allied unit with the highest HP automatically receives Fire Pact, including eligible summons. The partner gains DMG RED and sacrifices their own HP to support Zaojun's HP.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("relic")}');`} role="img" aria-label="Zaojun's Relic"></div><span>Charge</span><strong>Use Energy as a team</strong><p>Both one-time costs and repeated smaller Energy costs build Hearthfires. The bound unit can provide much more at high Relic levels.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_3")}');`} role="img" aria-label="Zaojun's passive skill"></div><span>Prepare</span><strong>Gain Energy and power</strong><p>Zaojun regularly gains Energy and increases her ATK without using Normal Attacks.</p></div>
          <div class="heket-engine-step"><div class="heket-engine-icon" style={`background-image: url('${skillImage("skill_1")}');`} role="img" aria-label="Zaojun's Ultimate"></div><span>Attack</span><strong>Pressure any formation</strong><p>Hearthfires add more hits. She can spread them across a full team or repeatedly strike one surviving boss.</p></div>
        </div>
        <div class="heket-engine-return"><span>Charge the next Ultimate</span></div>
        <div class="heket-engine-rule"><strong>Energy used during the Ultimate prepares the next one.</strong><span>When the Ultimate begins, its Hearthfires have already been set aside and the storage is empty again. Any Energy used by allies during the animation starts charging Zaojun's next Ultimate. This can lead to a rapid follow-up cast.</span></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Skills: What They Mean</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-skill-explorer" data-guide-skill-explorer>
        <div class="guide-skill-detail">
          {skills.map((skill, index) => <article class={`guide-skill-panel${index === 0 ? " is-active" : ""}`} data-guide-skill={skill.id}>
            <header class="guide-skill-panel-head"><div><h3>{skill.name}</h3><span class={`guide-skill-badge${skill.isUltimate ? " guide-skill-badge--ult" : ""}`}>{skill.badge}</span></div><img src={skillImage(skill.id)} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{skill.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{skill.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>{skill.takeaway}</p>
          </article>)}
          <article class="guide-skill-panel" data-guide-skill="relic">
            <header class="guide-skill-panel-head"><div><h3>{relic.name}</h3><div class="guide-relic-badges"><span class="guide-skill-badge guide-skill-badge--relic">Relic</span><span class="guide-skill-badge guide-skill-badge--level">High-impact scaling</span></div></div><img src={skillImage("relic")} alt="" width="72" height="72" loading="lazy" /></header>
            <p class="guide-skill-panel-text">{relic.description}</p>
            <div class="guide-skill-panel-upgrades"><span class="guide-skill-panel-label">Upgrades</span>{relic.upgrades.map((u) => <div><span>{u.level}</span><p>{u.text}</p></div>)}</div>
            <p class="guide-skill-panel-takeaway"><strong>In practice</strong>The Relic strengthens Fire Pact in both directions: Energy used by the partner gives Zaojun Hearthfires, while Zaojun's damage heals the partner. At maximum level, Zaojun stores a much larger share of that ally's Energy use. The best recipient is therefore healthy, durable, and able to use Energy regularly.</p>
          </article>
        </div>
        <ol class="guide-skill-selector">
          {skills.map((skill, index) => <li><button class={index === 0 ? "is-active" : ""} type="button" data-guide-skill-button={skill.id} aria-pressed={index === 0 ? "true" : "false"}><img src={skillImage(skill.id)} alt="" width="44" height="44" loading="lazy" /><span><strong>{skill.name}</strong><small>{skill.badge}</small></span></button></li>)}
          <li><button type="button" data-guide-skill-button="relic" aria-pressed="false"><img src={skillImage("relic")} alt="" width="44" height="44" loading="lazy" /><span><strong>{relic.name}</strong><small>Relic</small></span></button></li>
        </ol>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Relic Investment</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-apple-breakpoints">
        <div class="guide-apple-breakpoint"><span>Base Relic</span><strong>More Hearthfires from the partner</strong><p>Zaojun stores a larger share of the Energy used by her Fire Pact partner.</p></div>
        <div class="guide-apple-breakpoint"><span>Lv2</span><strong>Zaojun's damage heals the partner</strong><p>Each time Zaojun deals damage, part of that damage is returned to her Fire Pact partner as healing.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--key"><span>Lv3 &middot; Key breakpoint</span><strong>Stronger healing for the bound unit</strong><p>More of Zaojun's damage is returned as healing to the Fire Pact partner. Healing beyond the ally's missing HP is wasted, and healing modifiers can change the final amount.</p></div>
        <div class="guide-apple-breakpoint guide-apple-breakpoint--max"><span>Lv4 &middot; Energy upgrade</span><strong>Greater Hearthfire gain from the partner</strong><p>The Fire Pact partner provides much more Hearthfire than another ally using the same amount of Energy. This makes additional Ultimate hits much easier to unlock.</p></div>
      </div>
      <div class="guide-callout"><strong>Investment takeaway:</strong> Lv3 greatly improves how well Zaojun keeps her Fire Pact partner alive, helping offset the HP that partner sacrifices to support her. Lv4 improves damage potential when the partner spends Energy regularly, but its value falls if that unit rarely spends Energy or dies early. Choosing an ally who uses Energy early and often becomes especially important.</div>
    </section>

    <section class="guide-section guide-section--detail-heading"><h2 class="guide-section-title lt-h2 lt-h2-center">Strengths &amp; Weaknesses</h2><div class="lt-flourish lt-flourish-center"></div><StrengthWeakness strengths={strengths} weaknesses={weaknesses} /></section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Team Building</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-partners">
        <article class="heket-partner-feature">
          <img src={heroImage("poseidon")} alt="Poseidon" />
          <div class="heket-partner-feature-content"><span class="heket-partner-label">Durable frontline option</span><h3>Poseidon</h3><strong>Combine frontline durability with regular Energy use</strong><p>Poseidon can hold the frontline while helping charge Hearthfires. If he receives Fire Pact, his Energy use contributes much more at high Relic levels and Zaojun's damage helps heal him. Recorded battles confirmed both benefits, but concentrated enemy damage and the pact's HP sacrifice can still overwhelm the pair.</p><div class="heket-partner-tags"><span>High HP</span><span>Energy spending</span><span>Frontline value</span></div></div>
        </article>
        <div class="heket-partner-options">
          <article class="heket-partner-option"><img src={heroImage("hladgunnr")} alt="Hladgunnr" /><div><span class="heket-partner-label">Repeated Energy spending</span><h3>Hladgunnr</h3><p>Her continued Energy use can keep adding Hearthfires before and during Zaojun's attack cycle. Timing matters: those costs only help while Zaojun is still alive and able to cast.</p></div></article>
          <article class="heket-partner-option"><img src={heroImage("caishen")} alt="Caishen" /><div><span class="heket-partner-label">Energy and sustain support</span><h3>Caishen</h3><p>His own Energy spending adds Hearthfires, while his healing and shielding can help Zaojun and her Fire Pact partner survive for another cast. Against concentrated burst, pair him with another defensive option instead of expecting him to protect them alone.</p></div></article>
          <article class="heket-partner-option"><img src={heroImage("nuwa")} alt="Nuwa" /><div><span class="heket-partner-label">Conditional summon partner</span><h3>Nuwa</h3><p>Nuwa's tank summon can receive Fire Pact and absorb frontline pressure. The tradeoff is that a summon which does not use Energy can take the pact's stronger Hearthfire contribution away from an active ally. No immediate replacement appeared when the bound summon died in the recorded fight.</p></div></article>
          <article class="heket-partner-option"><img src={heroImage("nephtys")} alt="Nephtys" /><div><span class="heket-partner-label">Follow-up charge option</span><h3>Nephtys</h3><p>In one recorded fight, Nephtys used Energy during Zaojun's Ultimate and immediately began charging the next one. This is a useful timing interaction, though it is not enough evidence to call her a required partner.</p></div></article>
        </div>
        <div class="heket-partner-rule"><span>Formation rule</span><strong>The ideal Fire Pact recipient combines high HP, regular Energy use, and enough durability and sustain to absorb the pact's HP sacrifice. Eligible summons can receive the pact, while Feast of Warding targets the frontmost allied unit. Check both recipients instead of assuming one Deity receives all her support.</strong></div>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">PvE or PvP?</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Mode verdict</span><h3>Proven in PvE, still matchup-dependent in PvP.</h3></div>
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>PvE</span><strong>Strong against bosses and full formations</strong><p>Recorded battles showed repeated attacks against one persistent boss and broad coverage against five enemies. Longer fights give her more time to grow stronger and cast repeatedly, but partial early charges can also win short encounters. If the frontline collapses, improve her survival before adding more damage.</p></div>
          <div class="heket-matchup-bad"><span>PvP</span><strong>Promising, but not yet proven by controlled tests</strong><p>Her damage and focused healing should support a sturdy frontline, while the Fire Pact partner sacrifices HP to help preserve Zaojun's HP. Enemy burst, control, and direct pressure can still overwhelm that exchange and deny later casts, so both Zaojun and her partner need sufficient sustain. Treat PvP recommendations as matchup advice until controlled recordings are available.</p></div>
        </div>
        <p class="heket-hades-note"><strong>Battle takeaway:</strong> Protect Zaojun and her Fire Pact partner through the opening and, especially, after her first Ultimate. Maximum Hearthfires are not required for a useful cast. One recorded victory came from two partial attacks, while a defeat followed a nearly full attack because Zaojun did not survive to cast again.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Build, Battle Plan &amp; Counterplay</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="heket-battle-plan">
        <div class="heket-battle-heading"><span>Winning pattern</span><h3>Keep her safe, build Hearthfires, and create another chance to attack.</h3></div>
        <div class="heket-tactics">
          <article><div class="heket-tactic-marker">Place</div><h4>Keep Zaojun in the backline</h4><p>Place the intended Fire Pact partner in front of her. Check who receives Fire Pact, especially with summons present. Give both Zaojun and the partner direct healing or shielding so the pact's HP sacrifice does not exhaust the frontline.</p></article>
          <article><div class="heket-tactic-marker">Build</div><h4>Improve her Ultimate damage</h4><p>Prioritize ATK, Ultimate Power, or M-DMG Bonus. Energy and Cooldown Haste support can help her cast more often. Add enough defensive stats to keep her alive, and treat Attack Speed as the lowest priority.</p></article>
          <article><div class="heket-tactic-marker">Cast</div><h4>Balance charge with survival</h4><p>Use allies who spend Energy early and regularly, but do not require maximum Hearthfires for every cast. A partial attack can still pressure the enemy team, and Energy used during it begins preparing the next one.</p></article>
        </div>
        <div class="heket-matchup-row">
          <div class="heket-matchup-good"><span>Favorable fight</span><strong>Long bosses or grouped enemy teams</strong><p>A lone boss gives her repeated attacks one durable target, while grouped formations increase the value of each explosion. In either case, regular Energy use and a durable Fire Pact partner help her keep the attack cycle going.</p></div>
          <div class="heket-matchup-bad"><span>Difficult opponents</span><strong>Energy drain, anti-heal, control, and early burst damage</strong><p>Energy drain delays Zaojun's Ultimate and reduces the Energy her allies can use. Anti-heal weakens the healing from her Relic and makes the partner's HP sacrifice harder to sustain. Burst damage can kill Zaojun or her Fire Pact partner early, while control can delay or prevent her most important attack.</p></div>
        </div>
        <p class="heket-hades-note"><strong>If the team keeps losing:</strong> Check what happens immediately after Zaojun's first Ultimate. If the bound frontline is drained by Fire Pact or falls and leaves her exposed, add direct healing, shielding, or targeting relief before adding more damage. Also check whether a summon received Fire Pact and whether her healing reached the intended unit. Do not rely on the pact moving immediately to a replacement.</p>
      </div>
    </section>

    <section class="guide-section guide-section--detail-heading">
      <h2 class="guide-section-title lt-h2 lt-h2-center">Verdict</h2><div class="lt-flourish lt-flourish-center"></div>
      <div class="guide-verdict-box"><h3 class="guide-verdict-heading">A damage dealer whose Fire Pact partner also powers and protects her</h3><p class="guide-verdict-text">Zaojun rewards a team built to keep both her and her Fire Pact partner active. Regular allied Energy spending builds Hearthfires, while her passive gradually increases her ATK. Fire Pact gives the partner DMG RED, while that partner sacrifices HP to keep Zaojun's HP from falling below their own. Her Relic turns Zaojun's damage into focused healing for the partner, helping sustain this exchange.<br><br>Choose a durable partner who uses Energy regularly and has enough sustain for the pact's HP cost, and check whether a summon receives the pact instead. Zaojun can cover a full formation or repeatedly attack one boss, and a partial opening charge can still be useful. Prioritize survival for follow-up casts over chasing one perfect Ultimate. If she already supplies most of the damage but the team keeps losing, strengthen the protection around both pact members before adding another damage dealer.</p></div>
    </section>
  </div>
  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
  <script>
    for (const explorer of document.querySelectorAll("[data-guide-skill-explorer]")) {
      const buttons = Array.from(explorer.querySelectorAll("[data-guide-skill-button]"));
      const panels = Array.from(explorer.querySelectorAll("[data-guide-skill]"));
      for (const button of buttons) button.addEventListener("click", () => {
        const id = button.getAttribute("data-guide-skill-button");
        for (const other of buttons) { const active = other === button; other.classList.toggle("is-active", active); other.setAttribute("aria-pressed", String(active)); }
        for (const panel of panels) panel.classList.toggle("is-active", panel.getAttribute("data-guide-skill") === id);
      });
    }
  </script>
</Base>
