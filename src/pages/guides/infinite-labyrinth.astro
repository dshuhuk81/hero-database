---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import GuideSectionNav from "../../components/guides/GuideSectionNav.astro";

const R2_BASE = "https://pub-a33abfbc3135413881a1d8eb86543559.r2.dev";
const LABYRINTH_ASSETS = "/images/guides/infinite-labyrinth";

const chapters = [
  {
    number: 1,
    name: "Cold Weather",
    waves: "5",
    image: "A_UI_BagBattle_Chapter_Role10_Img.png",
    status: "Observed",
    note: "The short opening chapter and the best place to learn the merge board.",
  },
  {
    number: 2,
    name: "Four Seasons",
    waves: "8",
    image: "A_UI_BagBattle_Chapter_Role03_Img.png",
    status: "Observed",
    note: "A longer run in which early economy relics have more time to pay off.",
  },
  {
    number: 3,
    name: "Heart of Frost",
    waves: "5",
    image: "A_UI_BagBattle_Chapter_Role06_Img.png",
    status: "Current rotation",
    note: "The chapter is time-gated in the current event schedule.",
  },
  {
    number: 4,
    name: "Snow-Covered Path",
    waves: "8",
    image: "A_UI_BagBattle_Chapter_Role11_Img.png",
    status: "Current rotation",
    note: "The final chapter in the current four-part chain.",
  },
] as const;

const relicGroups = [
  {
    title: "Combat stats",
    items: [
      ["Atk4", "Piercing Dagger", "Team ATK", "+10% / +25% / +60% / +150%"],
      ["Def4", "Shield of Protection", "Team HP", "+20% / +50% / +120% / +300%"],
      ["Rage4", "Glowing Pendant", "Energy restored every 5 seconds", "+25 / +50 / +100 / +200"],
      ["UltraSkill4", "Burst Staff", "Ultimate DMG", "+15% / +35% / +90% / +225%"],
      ["AtkSpeed4", "Swift Hands", "ATK SPD", "+25% / +50% / +100% / +200%"],
      ["NormalSkill4", "Frenzy Bow", "Normal Attack and Skill DMG", "+30% / +70% / +180% / +450%"],
    ],
  },
  {
    title: "Class levels",
    items: [
      ["Tank4", "Tank Sigil", "Levels for Tank heroes", "+5 / +10 / +20 / +40"],
      ["Warrior4", "Warrior Sigil", "Levels for Warrior heroes", "+5 / +10 / +20 / +40"],
      ["Marksman4", "Archer Sigil", "Levels for Archer heroes", "+5 / +10 / +20 / +40"],
      ["Mage4", "Mage Sigil", "Levels for Mage heroes", "+5 / +10 / +20 / +40"],
      ["Subsidiary4", "Support Sigil", "Levels for Support heroes", "+5 / +10 / +20 / +40"],
      ["Assassin4", "Assassin Sigil", "Levels for Assassin heroes", "+5 / +10 / +20 / +40"],
    ],
  },
  {
    title: "Faction levels",
    items: [
      ["Club4", "Clubs Brand", "Levels for Clubs heroes", "+5 / +10 / +20 / +40"],
      ["Diamond4", "Diamonds Brand", "Levels for Diamonds heroes", "+5 / +10 / +20 / +40"],
      ["Spade4", "Spades Brand", "Levels for Spades heroes", "+5 / +10 / +20 / +40"],
      ["Heart4", "Hearts Brand", "Levels for Hearts heroes", "+5 / +10 / +20 / +40"],
    ],
  },
  {
    title: "Universal and position levels",
    items: [
      ["PowerUp4", "Dominion Brand", "Levels for all heroes", "+5 / +10 / +20 / +40"],
      ["LvUp4", "Growth Brand", "Levels for all heroes", "+1 / +2 / +4 / +8"],
      ["Melee4", "Vanguard Armaments", "Levels for frontline heroes", "+8 / +15 / +30 / +60"],
      ["Range4", "Expedition Crossbow", "Levels for backline heroes", "+5 / +10 / +20 / +40"],
    ],
  },
  {
    title: "Economy",
    items: [
      ["Reward4", "Chest of Hidden Wealth", "Extra Eternal Stones after a win", "+1 / +2 / +4 / +6"],
      ["Equipment_Terra_Thick_Grade4", "Bargainer's Badge", "Shop Refresh costs 50% less next round", "All rarities"],
    ],
  },
] as const;

const lineup = [
  { id: "taurus", name: "Taurus", faction: "Hearts", role: "Frontline tank" },
  { id: "gemini", name: "Gemini", faction: "Clubs", role: "Second frontline" },
  { id: "cancer", name: "Cancer", faction: "Hearts", role: "Healing and protection" },
  { id: "libra", name: "Libra", faction: "Hearts", role: "Control and damage" },
  { id: "sagittarius", name: "Sagittarius", faction: "Diamonds", role: "Armor break and damage" },
] as const;

const priorities = [
  ["Frozen Artifact mode", "Placement matters. An artifact freezes when it is placed next to an artifact that is already frozen, and a frozen artifact cannot be moved. Combining it with a matching artifact unfreezes the upgraded result, allowing you to reposition it."],
  ["Faction Item mode", "Keep only Brands for factions represented in your fighting lineup. If you have no Spades hero, for example, a Spades item gives no value. Remove it to make room for Hearts, Clubs or Diamonds items your heroes can actually use."],
  ["Damage priority", "Stack as much damage as possible. Direct damage bonuses are the first priority, while Ultimate DMG is also a strong pickup. Daggers and Bows should normally take priority over defensive or utility artifacts."],
] as const;
---

<Base
  title="Infinite Labyrinth Guide | Motto Immortal"
  description="Complete Infinite Labyrinth guide for Motto Immortal: chapters, Temporal Relics, Genesis Slate merging, teams, rewards and strategy."
>
  <header class="labyrinth-hero">
    <div class="labyrinth-hero-orbit labyrinth-hero-orbit--one" aria-hidden="true"></div>
    <div class="labyrinth-hero-orbit labyrinth-hero-orbit--two" aria-hidden="true"></div>
    <div class="labyrinth-hero-copy">
      <span class="labyrinth-eyebrow">Event Mode Guide</span>
      <h1>Infinite Labyrinth</h1>
      <p>Build a team, merge Temporal Relics and turn every cleared wave into a stronger run.</p>
      <div class="labyrinth-hero-tags" aria-label="Guide highlights">
        <span>4 chapters</span>
        <span>Merge board</span>
        <span>Roguelike progression</span>
      </div>
    </div>
    <div class="labyrinth-slate" aria-hidden="true">
      {Array.from({ length: 9 }).map((_, index) => (
        <span class:list={["labyrinth-slate-cell", `labyrinth-slate-cell--${index + 1}`]}></span>
      ))}
    </div>
  </header>

  <main class="guide-body guide-body--labyrinth">
    <GuideSectionNav />

    <section class="guide-section">
      <h2 class="guide-section-title">What is Infinite Labyrinth?</h2>
      <div class="guide-card labyrinth-intro-card">
        <h3 class="guide-card-heading">A wave-based roguelike event</h3>
        <p class="guide-card-text">
          Infinite Labyrinth is a limited-time combat mode built around consecutive waves. After a victory, you return to the <strong>Genesis Slate</strong>, where you place and merge <strong>Temporal Relics</strong>. Those relics raise team stats, hero levels or the amount of currency earned during the run.
        </p>
        <div class="labyrinth-loop" aria-label="Infinite Labyrinth gameplay loop">
          <span><b>1</b> Fight a wave</span>
          <i aria-hidden="true">→</i>
          <span><b>2</b> Earn Eternal Stones</span>
          <i aria-hidden="true">→</i>
          <span><b>3</b> Refresh and merge relics</span>
          <i aria-hidden="true">→</i>
          <span><b>4</b> Enter stronger</span>
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Chapters and Waves</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Current rotation</h3>
        <p class="guide-card-subheading">
          Note: The stage names could vary from time to time or active event.  
        </p>
        <div class="labyrinth-chapter-list">
          {chapters.map((chapter) => (
            <article class="labyrinth-chapter">
              <img class="labyrinth-chapter-art" src={`${LABYRINTH_ASSETS}/${chapter.image}`} alt="" loading="lazy" />
              <span class="labyrinth-chapter-number">{chapter.number}</span>
              <div>
                <div class="labyrinth-chapter-heading">
                  <h4>{chapter.name}</h4>
                  <span>{chapter.status}</span>
                </div>
                <p>{chapter.note}</p>
                <div class="labyrinth-chapter-meta">
                  <span><strong>{chapter.waves}</strong> waves</span>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="labyrinth-footnote">Only these four chapters are visible in the current event. A fifth chapter exists in generic configuration data, but it is not active in this rotation and is therefore omitted here.</p>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Temporal Relics and Merging</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">How the Genesis Slate works</h3>
        <p class="guide-card-text">
          Relics only work while placed on the slate. Drag identical relics of the same rarity together to craft the next rarity. The observed order is <span class="rarity rarity--common">Common</span>, <span class="rarity rarity--rare">Rare</span>, <span class="rarity rarity--elite">Elite</span> and <span class="rarity rarity--epic">Epic</span>. Epic is the maximum rarity.
        </p>
        <div class="labyrinth-rules">
          <span><b>Refresh</b> spends Eternal Stones to offer more relics.</span>
          <span><b>Merge</b> identical relics to increase their effect and free a slot.</span>
          <span><b>Sell</b> unwanted relics by dragging them to the sell area.</span>
        </div>
        <div class="labyrinth-relic-groups">
          {relicGroups.map((group) => (
            <section class="labyrinth-relic-group">
              <h4>{group.title}</h4>
              <div class="labyrinth-relic-grid">
                {group.items.map(([asset, name, effect, values]) => (
                  <article class="labyrinth-relic-card">
                    <img src={`${LABYRINTH_ASSETS}/${asset.startsWith("Equipment") ? `A_UI_${asset}` : `A_UI_BagBattle_${asset}`}.png`} alt="" loading="lazy" />
                    <div>
                      <strong>{name}</strong>
                      <span>{effect}</span>
                      <small>{values}</small>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
        <aside class="labyrinth-frost-card">
          <img src={`${LABYRINTH_ASSETS}/A_UI_BagBattle_Frost1.png`} alt="Heart of Frost" loading="lazy" />
          <div><strong>Heart of Frost</strong><p>This special frost engine freezes nearby items at the end of each wave. It cannot be moved, upgraded or destroyed, so every placement around it matters.</p></div>
        </aside>
        <p class="labyrinth-footnote">Values are listed as Common / Rare / Elite / Epic. Item availability depends on the active chapter and its Refresh pool.</p>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Best Team</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Best tested all-purpose lineup</h3>
        <p class="guide-card-subheading">
          The observed run used the five Destined Zodiac heroes below. It has two durable frontliners, healing, control, armor reduction and three Hearts heroes for efficient Brand scaling.
        </p>
        <div class="labyrinth-lineup">
          {lineup.map((hero, index) => (
            <a class="labyrinth-hero-card" href={`/heroes/${hero.id}`}>
              <span class="labyrinth-position">{index < 2 ? "Front" : "Back"}</span>
              <img src={`${R2_BASE}/heroes/${hero.id}.webp`} alt={hero.name} loading="lazy" />
              <div>
                <strong>{hero.name}</strong>
                <span>{hero.faction} · {hero.role}</span>
              </div>
            </a>
          ))}
        </div>
        <div class="labyrinth-team-advice">
          <article>
            <strong>Default Brand priority</strong>
            <p>Hearts → Growth → the faction of your remaining carry. A Hearts Brand improves Taurus, Cancer and Libra at once.</p>
          </article>
          <article>
            <strong>When to change the team</strong>
            <p>If your strongest available heroes share another faction, use that faction as the core. Brand coverage matters more here than forcing these exact five names.</p>
          </article>
        </div>
        <div class="guide-callout">
          Hero levels are equalized for this mode and equipment is disabled. Hero kits, faction concentration and the relic board therefore decide more of the run than normal gear progression.
        </div>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Rewards and Currencies</h2>
      <div class="labyrinth-currency-grid">
        <article class="guide-card labyrinth-currency-card">
          <span class="labyrinth-currency-icon labyrinth-currency-icon--stone"><img src={`${LABYRINTH_ASSETS}/A_UI_Props_BagBattleCoin.png`} alt="Eternal Stones" loading="lazy" /></span>
          <div>
            <h3>Eternal Stones</h3>
            <strong>Run currency</strong>
            <p>Each chapter starts you with a set amount. Most victories grant more, and Chest of Hidden Wealth increases that income. Spend Eternal Stones on Refresh to find more Temporal Relics during the chapter.</p>
          </div>
        </article>
        <article class="guide-card labyrinth-currency-card">
          <span class="labyrinth-currency-icon labyrinth-currency-icon--gem"><img src={`${LABYRINTH_ASSETS}/A_UI_Props_Active_BagBattle_Coin.png`} alt="Labyrinth Particles" loading="lazy" /></span>
          <div>
            <h3>Labyrinth Particles</h3>
            <strong>Event currency</strong>
            <p>These are the golden cubes shown on the Infinite Labyrinth screen. You earn them for completing stages inside a chapter and spend them in the event Exchange. They remain available outside the current chapter run.</p>
          </div>
        </article>
      </div>
      <div class="guide-card">
        <h3 class="guide-card-heading">What to buy in the Exchange</h3>
        <ol class="labyrinth-buy-list">
          <li><b>Limited selectors and rare progression materials</b><span>Buy the rewards that are hardest to farm elsewhere once their spending tier unlocks.</span></li>
          <li><b>Hero and account bottlenecks</b><span>Prioritize the crystal, feather, gear or artifact material currently blocking your main team.</span></li>
          <li><b>24-hour resource chests</b><span>Useful as a fallback, but usually less valuable than limited items.</span></li>
        </ol>
        <p class="labyrinth-footnote">Exchange stock and unlock thresholds are event-specific. Check the current row before spending, because progressing the shop is based on Labyrinth Particles spent.</p>
      </div>
    </section>

    <section class="guide-section">
      <h2 class="guide-section-title">Strategy</h2>
      <div class="guide-card">
        <h3 class="guide-card-heading">Adapt the plan to the active rule set</h3>
        <p class="guide-card-subheading">
          Infinite Labyrinth can use different artifact systems. Identify the current variant before committing board space or spending heavily on Refresh.
        </p>
        <div class="labyrinth-priority-list">
          {priorities.map(([phase, advice], index) => (
            <article>
              <span>{index + 1}</span>
              <div><strong>{phase}</strong><p>{advice}</p></div>
            </article>
          ))}
        </div>
        <div class="labyrinth-tips">
          <div><strong>Plan frozen placements</strong><p>Do not block important movement paths. Higher-rarity artifacts are harder to match from Refresh, so assume a highly upgraded frozen piece may remain locked for several rolls.</p></div>
          <div><strong>Use matching rolls deliberately</strong><p>If Refresh gives you the same artifact as a frozen piece, merging them is your opportunity to unfreeze and relocate that slot.</p></div>
          <div><strong>Clear unused factions</strong><p>Off-faction items dilute the board and delay useful merges. Sell or remove them as soon as the mode allows.</p></div>
          <div><strong>Convert space into damage</strong><p>Once the board is stable, favor Daggers, Bows and Ultimate DMG. Add defense only when survival is the reason a wave fails.</p></div>
        </div>
      </div>
    </section>
  </main>

  <p class="guide-page-footer">Guides &amp; More: motto-immortal-db.com</p>
</Base>

<style>
  .labyrinth-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    align-items: center;
    min-height: 520px;
    padding: clamp(4rem, 8vw, 7rem) max(var(--space-6), calc((100vw - 1080px) / 2));
    overflow: hidden;
    border-bottom: 1px solid rgba(141, 110, 255, 0.22);
    background:
      linear-gradient(90deg, rgba(9,11,22,.98) 0%, rgba(9,11,22,.82) 46%, rgba(9,11,22,.25) 100%),
      url("/images/guides/infinite-labyrinth/A_UI_BagBattle_Background_Chapter_Bg.png") center / cover,
      radial-gradient(circle at 76% 50%, rgba(117, 81, 224, 0.28), transparent 34%),
      radial-gradient(circle at 15% 15%, rgba(55, 183, 201, 0.12), transparent 36%),
      linear-gradient(145deg, #090b16 0%, #111326 55%, #090a12 100%);
  }

  .labyrinth-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to right, transparent, #000 55%, transparent);
  }

  .labyrinth-hero-copy { position: relative; z-index: 2; max-width: 620px; }
  .labyrinth-eyebrow { color: #b8a4ff; font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-widest); text-transform: uppercase; }
  .labyrinth-hero h1 { margin: var(--space-3) 0; color: #fff; font-size: clamp(3rem, 7vw, 6.2rem); font-weight: var(--weight-black); letter-spacing: -0.06em; line-height: 0.94; }
  .labyrinth-hero-copy > p { max-width: 48ch; margin: 0; color: #c4c5d3; font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.65; }
  .labyrinth-hero-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-6); }
  .labyrinth-hero-tags span { padding: .45rem .8rem; border: 1px solid rgba(184,164,255,.25); border-radius: 999px; color: #d8d0f8; background: rgba(102,72,180,.12); font-size: var(--text-xs); }

  .labyrinth-slate { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, 72px); gap: 12px; justify-self: center; padding: 42px; transform: rotate(45deg); border: 1px solid rgba(183, 161, 255, .22); border-radius: 30px; background: rgba(8, 9, 20, .58); box-shadow: 0 0 80px rgba(116, 77, 224, .22), inset 0 0 50px rgba(117, 81, 224, .08); }
  .labyrinth-slate-cell { width: 72px; aspect-ratio: 1; border: 1px solid rgba(190,174,255,.3); border-radius: 14px; background: linear-gradient(145deg, rgba(148,118,235,.2), rgba(51,45,82,.16)); box-shadow: inset 0 0 18px rgba(141,110,255,.12); }
  .labyrinth-slate-cell--1, .labyrinth-slate-cell--5, .labyrinth-slate-cell--9 { background: radial-gradient(circle, rgba(113,231,239,.62) 0 12%, rgba(75,128,174,.28) 13% 35%, rgba(51,45,82,.14) 36%); }
  .labyrinth-slate-cell--3, .labyrinth-slate-cell--7 { background: radial-gradient(circle, rgba(244,196,92,.7) 0 12%, rgba(172,103,64,.3) 13% 35%, rgba(51,45,82,.14) 36%); }
  .labyrinth-hero-orbit { position: absolute; border: 1px solid rgba(168,140,255,.1); border-radius: 50%; }
  .labyrinth-hero-orbit--one { right: -10%; width: 620px; height: 620px; }
  .labyrinth-hero-orbit--two { right: 3%; width: 410px; height: 410px; }

  .guide-body--labyrinth { --guide-accent: #b8a4ff; --guide-accent-dim: rgba(141,110,255,.12); --guide-accent-line: rgba(141,110,255,.34); position: relative; }
  .labyrinth-intro-card strong, .labyrinth-data-note strong { color: var(--text-bright); }
  .labyrinth-loop { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; align-items: center; gap: var(--space-3); margin: var(--space-6) 0; }
  .labyrinth-loop span { min-height: 86px; display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3); border: 1px solid var(--guide-accent-line); border-radius: var(--radius-md); color: var(--text-secondary); background: var(--guide-accent-dim); font-size: var(--text-xs); line-height: 1.45; }
  .labyrinth-loop b { display: grid; flex: 0 0 25px; place-items: center; width: 25px; height: 25px; border-radius: 50%; color: #0d0e18; background: #b8a4ff; }
  .labyrinth-loop i { color: #766aa5; font-style: normal; }

  .labyrinth-chapter-list { display: grid; gap: var(--space-3); }
  .labyrinth-chapter { position: relative; display: grid; grid-template-columns: 52px 1fr; gap: var(--space-4); min-height: 130px; padding: var(--space-4) 34% var(--space-4) var(--space-4); overflow: hidden; border: 1px solid var(--border-faint); border-radius: var(--radius-md); background: var(--bg-raised); }
  .labyrinth-chapter > :not(.labyrinth-chapter-art) { position: relative; z-index: 1; }
  .labyrinth-chapter-art { position: absolute; top: 0; right: 0; width: 38%; height: 100%; object-fit: cover; object-position: center 18%; opacity: .82; mask-image: linear-gradient(to right, transparent, #000 30%); }
  .labyrinth-chapter-number { display: grid; place-items: center; width: 52px; height: 52px; border: 1px solid var(--guide-accent-line); border-radius: 14px; color: #d9ceff; background: var(--guide-accent-dim); font-size: var(--text-xl); font-weight: var(--weight-black); }
  .labyrinth-chapter-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .labyrinth-chapter h4 { margin: 0; color: var(--text-bright); font-size: var(--text-base); }
  .labyrinth-chapter-heading span { color: #aa96ee; font-size: .65rem; font-weight: var(--weight-bold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .labyrinth-chapter p { margin: var(--space-1) 0 var(--space-3); color: var(--text-muted); font-size: var(--text-sm); line-height: 1.55; }
  .labyrinth-chapter-meta { display: flex; flex-wrap: wrap; gap: var(--space-4); color: var(--text-secondary); font-size: var(--text-xs); }
  .labyrinth-chapter-meta strong { color: var(--text-bright); }
  .labyrinth-data-note { margin-top: var(--space-5); padding: var(--space-4); border-left: 3px solid #8d6eff; background: var(--guide-accent-dim); }
  .labyrinth-data-note p { margin: var(--space-2) 0 0; color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.65; }

  .labyrinth-rules { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin: var(--space-5) 0; }
  .labyrinth-rules span { padding: var(--space-4); border: 1px solid var(--border-faint); border-radius: var(--radius-md); color: var(--text-muted); background: var(--bg-raised); font-size: var(--text-xs); line-height: 1.55; }
  .labyrinth-rules b { display: block; margin-bottom: var(--space-1); color: var(--text-bright); font-size: var(--text-sm); }
  .rarity { font-weight: var(--weight-bold); white-space: nowrap; }
  .rarity--common { color: #8bb48a; } .rarity--rare { color: #7fafdb; } .rarity--elite { color: #d469ef; } .rarity--epic { color: #e8ce73; }
  .labyrinth-catalog-note { margin: var(--space-5) 0; padding: var(--space-4); border-left: 3px solid #8d6eff; color: var(--text-secondary); background: var(--guide-accent-dim); font-size: var(--text-sm); line-height: 1.65; }
  .labyrinth-catalog-note strong { color: var(--text-bright); }
  .labyrinth-relic-groups { display: grid; gap: var(--space-6); }
  .labyrinth-relic-group h4 { margin: 0 0 var(--space-3); color: var(--text-bright); font-size: var(--text-base); }
  .labyrinth-relic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .labyrinth-relic-card { display: grid; grid-template-columns: 64px 1fr; gap: var(--space-3); align-items: center; padding: var(--space-3); border: 1px solid var(--border-faint); border-radius: var(--radius-md); background: var(--bg-raised); }
  .labyrinth-relic-card img { width: 64px; height: 64px; object-fit: contain; }
  .labyrinth-relic-card strong, .labyrinth-relic-card span, .labyrinth-relic-card small { display: block; }
